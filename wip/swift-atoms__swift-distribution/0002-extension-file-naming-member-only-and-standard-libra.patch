From 210c9bffef3c16a83372f045d70442c607ff192e Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 20:52:43 +0000
Subject: [PATCH 2/2] extension file naming: member-only and
 standard-library-conformance extension files merge into their type's own file
 (overnight/merge-extension-files.py); single type per file: additional types
 move to their own <Parent>.<Name>.swift inside the container's extension
 (overnight/split-types.py); parse-checked; builds pending (coenttb/work#242)

---
 Sources/Distribution/Distribution+Swift.CaseIterable.swift | 6 ------
 Sources/Distribution/Distribution.swift                    | 7 +++++++
 2 files changed, 7 insertions(+), 6 deletions(-)
 delete mode 100644 Sources/Distribution/Distribution+Swift.CaseIterable.swift

diff --git a/Sources/Distribution/Distribution+Swift.CaseIterable.swift b/Sources/Distribution/Distribution+Swift.CaseIterable.swift
deleted file mode 100644
index 5a6cde6..0000000
--- a/Sources/Distribution/Distribution+Swift.CaseIterable.swift
+++ /dev/null
@@ -1,6 +0,0 @@
-extension Distribution: Swift::CaseIterable {
-
-    public static var allCases: [Distribution] {
-        [.fill, .space(.between), .space(.around), .space(.evenly)]
-    }
-}
diff --git a/Sources/Distribution/Distribution.swift b/Sources/Distribution/Distribution.swift
index df024a4..00c7080 100644
--- a/Sources/Distribution/Distribution.swift
+++ b/Sources/Distribution/Distribution.swift
@@ -20,3 +20,10 @@ extension Distribution {
 #if !hasFeature(Embedded)
     extension Distribution: Swift::Codable {}
 #endif
+
+extension Distribution: Swift::CaseIterable {
+
+    public static var allCases: [Distribution] {
+        [.fill, .space(.between), .space(.around), .space(.evenly)]
+    }
+}
