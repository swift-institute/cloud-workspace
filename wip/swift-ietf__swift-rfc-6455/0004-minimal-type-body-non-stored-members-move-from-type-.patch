From 378403f3070e897986f8aa119704abc0d3be307a Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 22:39:55 +0000
Subject: [PATCH 4/4] minimal type body: non-stored members move from type
 bodies into an extension of the type in the same file
 (overnight/minimal-bodies.py); type-checked against the root build,
 directories that failed or couldn't be checked left out (coenttb/work#242)

---
 Sources/RFC 6455/RFC_6455.CloseCode.swift  | 178 +++++++++++----------
 Sources/RFC 6455/RFC_6455.MaskingKey.swift |  66 ++++----
 Sources/RFC 6455/RFC_6455.Opcode.swift     |  74 ++++-----
 3 files changed, 162 insertions(+), 156 deletions(-)

diff --git a/Sources/RFC 6455/RFC_6455.CloseCode.swift b/Sources/RFC 6455/RFC_6455.CloseCode.swift
index 098d733..f857436 100644
--- a/Sources/RFC 6455/RFC_6455.CloseCode.swift	
+++ b/Sources/RFC 6455/RFC_6455.CloseCode.swift	
@@ -35,101 +35,103 @@ extension RFC_6455 {
         init(__unchecked: Void, rawValue: UInt16) {
             self.rawValue = rawValue
         }
+    }
+}
 
-        /// Normal closure (1000)
-        ///
-        /// The connection successfully completed its purpose.
-        public static let normalClosure = Self(__unchecked: (), rawValue: 1000)
-
-        /// Going away (1001)
-        ///
-        /// Endpoint is going away (e.g., server shutdown, browser navigating away).
-        public static let goingAway = Self(__unchecked: (), rawValue: 1001)
-
-        /// Protocol error (1002)
-        ///
-        /// Endpoint received a message that violates the protocol.
-        public static let protocolError = Self(__unchecked: (), rawValue: 1002)
-
-        /// Unsupported data (1003)
-        ///
-        /// Endpoint received data of a type it cannot accept.
-        public static let unsupportedData = Self(__unchecked: (), rawValue: 1003)
-
-        /// No status received (1005) - Reserved
-        ///
-        /// Must not be sent in a close frame. Indicates no status was present.
-        public static let noStatusReceived = Self(__unchecked: (), rawValue: 1005)
-
-        /// Abnormal closure (1006) - Reserved
-        ///
-        /// Must not be sent in a close frame. Indicates connection closed abnormally.
-        public static let abnormalClosure = Self(__unchecked: (), rawValue: 1006)
-
-        /// Invalid frame payload data (1007)
-        ///
-        /// Endpoint received data that was not consistent with the message type
-        /// (e.g., non-UTF-8 data in a text message).
-        public static let invalidPayloadData = Self(__unchecked: (), rawValue: 1007)
-
-        /// Policy violation (1008)
-        ///
-        /// Endpoint received a message that violates its policy.
-        public static let policyViolation = Self(__unchecked: (), rawValue: 1008)
-
-        /// Message too big (1009)
-        ///
-        /// Endpoint received a message that is too big to process.
-        public static let messageTooLarge = Self(__unchecked: (), rawValue: 1009)
-
-        /// Mandatory extension (1010)
-        ///
-        /// Client expected server to negotiate one or more extensions.
-        public static let mandatoryExtension = Self(__unchecked: (), rawValue: 1010)
-
-        /// Internal server error (1011)
-        ///
-        /// Server encountered an unexpected condition.
-        public static let internalError = Self(__unchecked: (), rawValue: 1011)
-
-        /// TLS handshake failure (1015) - Reserved
-        ///
-        /// Must not be sent in a close frame. Indicates TLS handshake failed.
-        public static let tlsHandshakeFailed = Self(__unchecked: (), rawValue: 1015)
-
-        /// Whether this code is valid for use in a close frame
-        ///
-        /// Reserved codes (1005, 1006, 1015) must not be sent.
-        public var isValid: Bool {
-            switch rawValue {
-            case 1005, 1006, 1015:
-                return false
-            case 0..<1000:
-                return false
-            default:
-                return true
-            }
-        }
+extension RFC_6455.CloseCode {
+    /// Normal closure (1000)
+    ///
+    /// The connection successfully completed its purpose.
+    public static let normalClosure = Self(__unchecked: (), rawValue: 1000)
 
-        /// Whether this is a protocol-defined code
-        public var isProtocolDefined: Bool {
-            rawValue >= 1000 && rawValue < 3000
-        }
+    /// Going away (1001)
+    ///
+    /// Endpoint is going away (e.g., server shutdown, browser navigating away).
+    public static let goingAway = Self(__unchecked: (), rawValue: 1001)
 
-        /// Whether this is a library/framework code
-        public var isLibraryCode: Bool {
-            rawValue >= 3000 && rawValue < 4000
-        }
+    /// Protocol error (1002)
+    ///
+    /// Endpoint received a message that violates the protocol.
+    public static let protocolError = Self(__unchecked: (), rawValue: 1002)
 
-        /// Whether this is an application code
-        public var isApplicationCode: Bool {
-            rawValue >= 4000 && rawValue < 5000
-        }
+    /// Unsupported data (1003)
+    ///
+    /// Endpoint received data of a type it cannot accept.
+    public static let unsupportedData = Self(__unchecked: (), rawValue: 1003)
+
+    /// No status received (1005) - Reserved
+    ///
+    /// Must not be sent in a close frame. Indicates no status was present.
+    public static let noStatusReceived = Self(__unchecked: (), rawValue: 1005)
+
+    /// Abnormal closure (1006) - Reserved
+    ///
+    /// Must not be sent in a close frame. Indicates connection closed abnormally.
+    public static let abnormalClosure = Self(__unchecked: (), rawValue: 1006)
+
+    /// Invalid frame payload data (1007)
+    ///
+    /// Endpoint received data that was not consistent with the message type
+    /// (e.g., non-UTF-8 data in a text message).
+    public static let invalidPayloadData = Self(__unchecked: (), rawValue: 1007)
+
+    /// Policy violation (1008)
+    ///
+    /// Endpoint received a message that violates its policy.
+    public static let policyViolation = Self(__unchecked: (), rawValue: 1008)
 
-        public static func < (lhs: Self, rhs: Self) -> Bool {
-            lhs.rawValue < rhs.rawValue
+    /// Message too big (1009)
+    ///
+    /// Endpoint received a message that is too big to process.
+    public static let messageTooLarge = Self(__unchecked: (), rawValue: 1009)
+
+    /// Mandatory extension (1010)
+    ///
+    /// Client expected server to negotiate one or more extensions.
+    public static let mandatoryExtension = Self(__unchecked: (), rawValue: 1010)
+
+    /// Internal server error (1011)
+    ///
+    /// Server encountered an unexpected condition.
+    public static let internalError = Self(__unchecked: (), rawValue: 1011)
+
+    /// TLS handshake failure (1015) - Reserved
+    ///
+    /// Must not be sent in a close frame. Indicates TLS handshake failed.
+    public static let tlsHandshakeFailed = Self(__unchecked: (), rawValue: 1015)
+
+    /// Whether this code is valid for use in a close frame
+    ///
+    /// Reserved codes (1005, 1006, 1015) must not be sent.
+    public var isValid: Bool {
+        switch rawValue {
+        case 1005, 1006, 1015:
+            return false
+        case 0..<1000:
+            return false
+        default:
+            return true
         }
     }
+
+    /// Whether this is a protocol-defined code
+    public var isProtocolDefined: Bool {
+        rawValue >= 1000 && rawValue < 3000
+    }
+
+    /// Whether this is a library/framework code
+    public var isLibraryCode: Bool {
+        rawValue >= 3000 && rawValue < 4000
+    }
+
+    /// Whether this is an application code
+    public var isApplicationCode: Bool {
+        rawValue >= 4000 && rawValue < 5000
+    }
+
+    public static func < (lhs: Self, rhs: Self) -> Bool {
+        lhs.rawValue < rhs.rawValue
+    }
 }
 
 extension RFC_6455.CloseCode: CustomStringConvertible {
diff --git a/Sources/RFC 6455/RFC_6455.MaskingKey.swift b/Sources/RFC 6455/RFC_6455.MaskingKey.swift
index d5117f5..f636191 100644
--- a/Sources/RFC 6455/RFC_6455.MaskingKey.swift	
+++ b/Sources/RFC 6455/RFC_6455.MaskingKey.swift	
@@ -41,44 +41,46 @@ extension RFC_6455 {
                 UInt8(value & 0xFF)
             )
         }
+    }
+}
 
-        /// Returns the key byte at the given index (0-3)
-        public subscript(index: Int) -> UInt8 {
-            switch index % 4 {
-            case 0: return bytes.0
-            case 1: return bytes.1
-            case 2: return bytes.2
-            case 3: return bytes.3
-            default: fatalError("Invalid index")
-            }
+extension RFC_6455.MaskingKey {
+    /// Returns the key byte at the given index (0-3)
+    public subscript(index: Int) -> UInt8 {
+        switch index % 4 {
+        case 0: return bytes.0
+        case 1: return bytes.1
+        case 2: return bytes.2
+        case 3: return bytes.3
+        default: fatalError("Invalid index")
         }
+    }
 
-        /// Applies the mask to data in-place
-        ///
-        /// XORs each byte with the corresponding mask byte.
-        /// This operation is its own inverse.
-        ///
-        /// - Parameter data: The data to mask/unmask
-        public func apply(to data: inout [UInt8]) {
-            for i in data.indices {
-                data[i] ^= self[i]
-            }
+    /// Applies the mask to data in-place
+    ///
+    /// XORs each byte with the corresponding mask byte.
+    /// This operation is its own inverse.
+    ///
+    /// - Parameter data: The data to mask/unmask
+    public func apply(to data: inout [UInt8]) {
+        for i in data.indices {
+            data[i] ^= self[i]
         }
+    }
 
-        /// Returns masked data
-        ///
-        /// - Parameter data: The data to mask
-        /// - Returns: The masked data
-        public func applying(to data: [UInt8]) -> [UInt8] {
-            var result = data
-            apply(to: &result)
-            return result
-        }
+    /// Returns masked data
+    ///
+    /// - Parameter data: The data to mask
+    /// - Returns: The masked data
+    public func applying(to data: [UInt8]) -> [UInt8] {
+        var result = data
+        apply(to: &result)
+        return result
+    }
 
-        /// Converts to array of bytes
-        public var array: [UInt8] {
-            [bytes.0, bytes.1, bytes.2, bytes.3]
-        }
+    /// Converts to array of bytes
+    public var array: [UInt8] {
+        [bytes.0, bytes.1, bytes.2, bytes.3]
     }
 }
 
diff --git a/Sources/RFC 6455/RFC_6455.Opcode.swift b/Sources/RFC 6455/RFC_6455.Opcode.swift
index e9bb0d6..87e303c 100644
--- a/Sources/RFC 6455/RFC_6455.Opcode.swift	
+++ b/Sources/RFC 6455/RFC_6455.Opcode.swift	
@@ -25,51 +25,53 @@ extension RFC_6455 {
         init(__unchecked: Void, rawValue: UInt8) {
             self.rawValue = rawValue
         }
+    }
+}
 
-        /// Continuation frame (0x0)
-        ///
-        /// Continues a fragmented message.
-        public static let continuation = Self(__unchecked: (), rawValue: 0x0)
+extension RFC_6455.Opcode {
+    /// Continuation frame (0x0)
+    ///
+    /// Continues a fragmented message.
+    public static let continuation = Self(__unchecked: (), rawValue: 0x0)
 
-        /// Text frame (0x1)
-        ///
-        /// Payload is UTF-8 encoded text.
-        public static let text = Self(__unchecked: (), rawValue: 0x1)
+    /// Text frame (0x1)
+    ///
+    /// Payload is UTF-8 encoded text.
+    public static let text = Self(__unchecked: (), rawValue: 0x1)
 
-        /// Binary frame (0x2)
-        ///
