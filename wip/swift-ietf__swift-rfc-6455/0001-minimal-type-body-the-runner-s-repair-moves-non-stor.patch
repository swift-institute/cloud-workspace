 Sources/RFC 6455/RFC_6455.Frame.Limits.swift | 21 +++++++++++---------
 1 file changed, 12 insertions(+), 9 deletions(-)

diff --git a/Sources/RFC 6455/RFC_6455.Frame.Limits.swift b/Sources/RFC 6455/RFC_6455.Frame.Limits.swift
index 40cc31b..09a8870 100644
--- a/Sources/RFC 6455/RFC_6455.Frame.Limits.swift	
