Subject: [PATCH 3/4] compound suite name: narrative suites move into the test
 module's namespace `<File> Tests` (#239's layout), nested suites into
 extension <Path>.<Parent> (overnight/compound-suites.py); parse-checked;
 builds pending (coenttb/work#242)

---
 .../RFC_6455_Frame_UInt8 Tests.swift          | 34 +++++++++++--------
 Tests/RFC 6455 Tests/RFC_6455 Tests.swift     | 10 ++++--
 2 files changed, 27 insertions(+), 17 deletions(-)

diff --git a/Tests/RFC 6455 Standard Library Integration Tests/RFC_6455_Frame_UInt8 Tests.swift b/Tests/RFC 6455 Standard Library Integration Tests/RFC_6455_Frame_UInt8 Tests.swift
index 39e1f50..2997c4b 100644
--- a/Tests/RFC 6455 Standard Library Integration Tests/RFC_6455_Frame_UInt8 Tests.swift	
+++ b/Tests/RFC 6455 Standard Library Integration Tests/RFC_6455_Frame_UInt8 Tests.swift	
@@ -14,21 +14,25 @@ import RFC_6455
 import RFC_6455_Standard_Library_Integration
 import Testing
 
-@Suite
-struct `RFC 6455 Frame UInt8 forwarder` {
-    @Test
-    func `init forwarder accepts [UInt8] payload`() throws {
-        let uint8Payload: [UInt8] = [0x48, 0x65, 0x6C, 0x6C, 0x6F]  // "Hello"
-        let frame = try RFC_6455.Frame(opcode: .binary, payload: uint8Payload)
-        #expect(frame.opcode == .binary)
-        #expect(frame.payload.count == 5)
-    }
+enum `RFC_6455_Frame_UInt8 Tests` {}
+
+extension `RFC_6455_Frame_UInt8 Tests` {
+    @Suite
+    struct `RFC 6455 Frame UInt8 forwarder` {
+        @Test
+        func `init forwarder accepts [UInt8] payload`() throws {
+            let uint8Payload: [UInt8] = [0x48, 0x65, 0x6C, 0x6C, 0x6F]  // "Hello"
+            let frame = try RFC_6455.Frame(opcode: .binary, payload: uint8Payload)
+            #expect(frame.opcode == .binary)
+            #expect(frame.payload.count == 5)
+        }
 
-    @Test
-    func `binary forwarder accepts [UInt8] data`() throws {
-        let uint8Data: [UInt8] = [0x01, 0x02, 0x03, 0x04]
-        let frame = try RFC_6455.Frame.binary(uint8Data)
-        #expect(frame.opcode == .binary)
-        #expect(frame.payload.count == 4)
+        @Test
+        func `binary forwarder accepts [UInt8] data`() throws {
+            let uint8Data: [UInt8] = [0x01, 0x02, 0x03, 0x04]
+            let frame = try RFC_6455.Frame.binary(uint8Data)
+            #expect(frame.opcode == .binary)
+            #expect(frame.payload.count == 4)
+        }
     }
 }
