diff --git a/Sources/Stores/Registry.Error+Tree.swift b/Sources/Stores/Registry.Error+Tree.swift
new file mode 100644
index 0000000..ba5ef31
--- /dev/null
+++ b/Sources/Stores/Registry.Error+Tree.swift
@@ -0,0 +1,20 @@
+internal import Tree_Keyed
+
+extension Registry.Error {
+
+    init(_ error: __TreeKeyedError<String>) {
+        switch error {
+        case .invalidPosition:
+            self = .stale
+
+        case .rootOccupied:
+            self = .rootOccupied
+
+        case .keyOccupied(let key):
+            self = .nameOccupied(key)
+
+        case .cannotRemoveNonLeaf:
+            self = .stale
+        }
+    }
+}
