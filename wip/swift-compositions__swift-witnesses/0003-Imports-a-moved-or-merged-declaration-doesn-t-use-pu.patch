From 9590a837afff10d287c2a0ab6707fda12f85bbe2 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 21:23:55 +0000
Subject: [PATCH 3/9] Imports a moved or merged declaration doesn't use
 publicly are internal; two directories whose merges don't type-check reverted
 (coenttb/work#242)

---
 .../Witnesses/Witness.Values._Storage.swift   | 25 -------------------
 Sources/Witnesses/Witness.Values.swift        | 19 ++++++++++++++
 2 files changed, 19 insertions(+), 25 deletions(-)
 delete mode 100644 Sources/Witnesses/Witness.Values._Storage.swift

diff --git a/Sources/Witnesses/Witness.Values._Storage.swift b/Sources/Witnesses/Witness.Values._Storage.swift
deleted file mode 100644
index 34e5692..0000000
--- a/Sources/Witnesses/Witness.Values._Storage.swift
+++ /dev/null
@@ -1,25 +0,0 @@
-public import Dependency
-public import Ownership
-import Witness
-
-
-extension Witness.Values {
-    @safe
-    @usableFromInline
-    final class _Storage: @unchecked Sendable {
-        @usableFromInline
-        var dict: [ObjectIdentifier: UnsafeRawPointer]
-
-        @usableFromInline
-        init() {
-            unsafe (self.dict = [:])
-        }
-
-        deinit {
-            var iter = unsafe dict.values.makeIterator()
-            while let ptr = unsafe iter.next() {
-                unsafe Unmanaged<AnyObject>.fromOpaque(ptr).release()
-            }
-        }
-    }
-}
diff --git a/Sources/Witnesses/Witness.Values.swift b/Sources/Witnesses/Witness.Values.swift
index fbd3a3e..6907c08 100644
--- a/Sources/Witnesses/Witness.Values.swift
+++ b/Sources/Witnesses/Witness.Values.swift
@@ -27,6 +27,25 @@ extension Witness {
 }
 
 extension Witness.Values {
+
+    @safe
+    @usableFromInline
+    final class _Storage: @unchecked Sendable {
+        @usableFromInline
+        var dict: [ObjectIdentifier: UnsafeRawPointer]
+
+        @usableFromInline
+        init() {
+            unsafe (self.dict = [:])
+        }
+
+        deinit {
+            var iter = unsafe dict.values.makeIterator()
+            while let ptr = unsafe iter.next() {
+                unsafe Unmanaged<AnyObject>.fromOpaque(ptr).release()
+            }
+        }
+    }
 }
 
 extension Witness.Values {
