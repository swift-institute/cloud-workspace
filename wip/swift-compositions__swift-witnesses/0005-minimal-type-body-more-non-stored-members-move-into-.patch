From be2d34fa3da859fc852a87a79c45b958f018fe73 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 23:28:26 +0000
Subject: [PATCH 05/12] minimal type body: more non-stored members move into
 extensions of their type (overnight/minimal-bodies.py); type-checked, failing
 files left out (coenttb/work#242)

---
 Sources/Witnesses/Witness.Access.swift | 13 +++++++------
 1 file changed, 7 insertions(+), 6 deletions(-)

diff --git a/Sources/Witnesses/Witness.Access.swift b/Sources/Witnesses/Witness.Access.swift
index 7170f9d..0f43357 100644
--- a/Sources/Witnesses/Witness.Access.swift
+++ b/Sources/Witnesses/Witness.Access.swift
@@ -1,7 +1,6 @@
 import Witness
 
 extension Witness {
-
     @propertyWrapper
     public struct Access<Key: Witness.Key>: Sendable
     where Key.Value == Key, Key.Value: Copyable & Escapable {
@@ -24,11 +23,13 @@ extension Witness {
             self.fileID = fileID
             self.line = line
         }
+    }
+}
 
-        @inlinable
-        public var wrappedValue: Key.Value {
-            let merged = initialValues.merging(Witness.Context.current)
-            return merged[Key.self]
-        }
+extension Witness.Access {
+    @inlinable
+    public var wrappedValue: Key.Value {
+        let merged = initialValues.merging(Witness.Context.current)
+        return merged[Key.self]
     }
 }
