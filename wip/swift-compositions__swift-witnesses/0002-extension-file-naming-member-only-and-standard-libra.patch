From 3bb625fb355b0220fa97f64bba4ab0dd51850082 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 20:52:59 +0000
Subject: [PATCH 2/6] extension file naming: member-only and
 standard-library-conformance extension files merge into their type's own file
 (overnight/merge-extension-files.py); single type per file: additional types
 move to their own <Parent>.<Name>.swift inside the container's extension
 (overnight/split-types.py); parse-checked; builds pending (coenttb/work#242)

---
 .../Witnesses/Witness.Values._Storage.swift   | 25 +++++++++++++++++++
 Sources/Witnesses/Witness.Values.swift        | 19 --------------
 2 files changed, 25 insertions(+), 19 deletions(-)
 create mode 100644 Sources/Witnesses/Witness.Values._Storage.swift

diff --git a/Sources/Witnesses/Witness.Values._Storage.swift b/Sources/Witnesses/Witness.Values._Storage.swift
new file mode 100644
index 0000000..34e5692
--- /dev/null
+++ b/Sources/Witnesses/Witness.Values._Storage.swift
@@ -0,0 +1,25 @@
+public import Dependency
+public import Ownership
+import Witness
+
+
+extension Witness.Values {
+    @safe
+    @usableFromInline
+    final class _Storage: @unchecked Sendable {
+        @usableFromInline
+        var dict: [ObjectIdentifier: UnsafeRawPointer]
+
+        @usableFromInline
+        init() {
+            unsafe (self.dict = [:])
+        }
+
+        deinit {
+            var iter = unsafe dict.values.makeIterator()
+            while let ptr = unsafe iter.next() {
+                unsafe Unmanaged<AnyObject>.fromOpaque(ptr).release()
+            }
+        }
+    }
+}
diff --git a/Sources/Witnesses/Witness.Values.swift b/Sources/Witnesses/Witness.Values.swift
index 6907c08..fbd3a3e 100644
--- a/Sources/Witnesses/Witness.Values.swift
+++ b/Sources/Witnesses/Witness.Values.swift
@@ -27,25 +27,6 @@ extension Witness {
 }
 
 extension Witness.Values {
-
-    @safe
-    @usableFromInline
-    final class _Storage: @unchecked Sendable {
-        @usableFromInline
-        var dict: [ObjectIdentifier: UnsafeRawPointer]
-
-        @usableFromInline
-        init() {
-            unsafe (self.dict = [:])
-        }
-
-        deinit {
-            var iter = unsafe dict.values.makeIterator()
-            while let ptr = unsafe iter.next() {
-                unsafe Unmanaged<AnyObject>.fromOpaque(ptr).release()
-            }
-        }
-    }
 }
 
 extension Witness.Values {
