From 2122d7f8c704f1847f82bad14c1b40a4f3299b13 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:35:33 +0000
Subject: [PATCH 09/15] statement where expression fits: single-value if/else
 chains written as if expressions (type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 .../WitnessMacro.swift                             | 14 +++++++-------
 1 file changed, 7 insertions(+), 7 deletions(-)

diff --git a/Sources/Witnesses Macros Implementation/WitnessMacro.swift b/Sources/Witnesses Macros Implementation/WitnessMacro.swift
index 949e273..2cce1a3 100644
--- a/Sources/Witnesses Macros Implementation/WitnessMacro.swift	
+++ b/Sources/Witnesses Macros Implementation/WitnessMacro.swift	
@@ -499,12 +499,12 @@ extension ClosureProperty {
     var methodName: String { name }
 
     var throwsAnnotation: String {
-        if let throwsType {
-            return "throws(\(throwsType.trimmedDescription)) "
+        return if let throwsType {
+            "throws(\(throwsType.trimmedDescription)) "
         } else if isThrowing {
-            return "throws "
+            "throws "
         } else {
-            return ""
+            ""
         }
     }
 
@@ -1251,13 +1251,13 @@ private func generateObserveClosure(
         {
 
             let innerType: TypeSyntax
-            if let tuple = optionalWrapped.as(TupleTypeSyntax.self),
+            innerType = if let tuple = optionalWrapped.as(TupleTypeSyntax.self),
                 tuple.elements.count == 1,
                 let single = tuple.elements.first
             {
-                innerType = single.type
+                single.type
             } else {
-                innerType = optionalWrapped
+                optionalWrapped
             }
             if let attributed = innerType.as(AttributedTypeSyntax.self),
                 !attributed.attributes.contains(where: {
