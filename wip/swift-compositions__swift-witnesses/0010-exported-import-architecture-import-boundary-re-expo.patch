Subject: [PATCH 10/12] exported import, architecture import boundary:
 re-exports moved into the target's root exports.swift (re-export set
 unchanged; type-check follows; Linux x86_64, Swift 6.4.2) (coenttb/work#242)

---
 Sources/Witnesses Macros/Witness.swift | 8 ++++----
 Sources/Witnesses Macros/exports.swift | 4 ++++
 2 files changed, 8 insertions(+), 4 deletions(-)
 create mode 100644 Sources/Witnesses Macros/exports.swift

diff --git a/Sources/Witnesses Macros/Witness.swift b/Sources/Witnesses Macros/Witness.swift
index 5cd183c..350a28e 100644
--- a/Sources/Witnesses Macros/Witness.swift	
+++ b/Sources/Witnesses Macros/Witness.swift	
@@ -1,7 +1,7 @@
-@_exported public import Either
-@_exported public import Finite
-@_exported public import Optic
-@_exported public import Witness
+public import Either
+public import Finite
+public import Optic
+public import Witness
 
 extension Witness {
 
diff --git a/Sources/Witnesses Macros/exports.swift b/Sources/Witnesses Macros/exports.swift
new file mode 100644
index 0000000..d905222
--- /dev/null
+++ b/Sources/Witnesses Macros/exports.swift	
@@ -0,0 +1,4 @@
+@_exported public import Either
+@_exported public import Finite
+@_exported public import Optic
+@_exported public import Witness
