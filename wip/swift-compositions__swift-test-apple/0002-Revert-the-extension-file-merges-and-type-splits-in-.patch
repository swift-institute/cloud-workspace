From 0a713eb838707c121fdffb9b6c184c57093169ba Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 21:32:55 +0000
Subject: [PATCH 2/4] Revert the extension-file merges and type splits in
 directories the type-check can't verify (C shims, macros); institute's
 generated Ratchet+limits.swift stays its own file (coenttb/work#242)

---
 Sources/Test Apple/Test.Apple+Source.swift | 20 ++++++++++++++++++++
 Sources/Test Apple/Test.Apple.swift        | 18 ------------------
 2 files changed, 20 insertions(+), 18 deletions(-)
 create mode 100644 Sources/Test Apple/Test.Apple+Source.swift

diff --git a/Sources/Test Apple/Test.Apple+Source.swift b/Sources/Test Apple/Test.Apple+Source.swift
new file mode 100644
index 0000000..380ad31
--- /dev/null
+++ b/Sources/Test Apple/Test.Apple+Source.swift	
@@ -0,0 +1,20 @@
+internal import Cardinal
+public import Source
+internal import Tagged
+public import Test
+internal import Text
+
+public import struct Testing.SourceLocation
+
+extension Test.Apple {
+    public static func source(_ source: Source.Location) -> Testing.SourceLocation {
+        .init(
+            fileID: source.fileID,
+            filePath: source.filePath ?? source.fileID,
+            line: Int(source.line.underlying),
+            // swift-linter:disable:next raw value access
+            // REASON: Apple Testing.SourceLocation requires Int coordinates; this is the external typed-conversion boundary.
+            column: Int(source.column.underlying.rawValue)
+        )
+    }
+}
diff --git a/Sources/Test Apple/Test.Apple.swift b/Sources/Test Apple/Test.Apple.swift
index 07a78fa..7ed5cdd 100644
--- a/Sources/Test Apple/Test.Apple.swift	
+++ b/Sources/Test Apple/Test.Apple.swift	
@@ -1,23 +1,5 @@
 public import Test
-internal import Cardinal
-public import Source
-internal import Tagged
-internal import Text
-public import struct Testing.SourceLocation
 
 extension Test {
     public enum Apple {}
 }
-
-extension Test.Apple {
-    public static func source(_ source: Source.Location) -> Testing.SourceLocation {
-        .init(
-            fileID: source.fileID,
-            filePath: source.filePath ?? source.fileID,
-            line: Int(source.line.underlying),
-            // swift-linter:disable:next raw value access
-            // REASON: Apple Testing.SourceLocation requires Int coordinates; this is the external typed-conversion boundary.
-            column: Int(source.column.underlying.rawValue)
-        )
-    }
-}
