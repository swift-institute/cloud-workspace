From f2b33c348bb4cf8a5c71a673d0b3feaeaea6654b Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:17:15 +0000
Subject: [PATCH 14/15] minimal type body: more non-stored members moved into
 an extension of their type (batch 18; type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 Sources/RFC 4648/RFC_4648.Strictness.swift | 22 +++++++++++-----------
 1 file changed, 11 insertions(+), 11 deletions(-)

diff --git a/Sources/RFC 4648/RFC_4648.Strictness.swift b/Sources/RFC 4648/RFC_4648.Strictness.swift
index fa2eccb..5a450c1 100644
--- a/Sources/RFC 4648/RFC_4648.Strictness.swift	
+++ b/Sources/RFC 4648/RFC_4648.Strictness.swift	
@@ -1,7 +1,5 @@
 extension RFC_4648 {
-
     public struct Strictness: Sendable, Hashable {
-
         public var rejectWhitespace: Bool
 
         public var rejectNonzeroTrailingBits: Bool
@@ -11,15 +9,17 @@ extension RFC_4648 {
             self.rejectWhitespace = rejectWhitespace
             self.rejectNonzeroTrailingBits = rejectNonzeroTrailingBits
         }
+    }
+}
 
-        public static let lenient = Strictness(
-            rejectWhitespace: false,
-            rejectNonzeroTrailingBits: false
-        )
+extension RFC_4648.Strictness {
+    public static let lenient = Strictness(
+        rejectWhitespace: false,
+        rejectNonzeroTrailingBits: false
+    )
 
-        public static let strict = Strictness(
-            rejectWhitespace: true,
-            rejectNonzeroTrailingBits: true
-        )
-    }
+    public static let strict = Strictness(
+        rejectWhitespace: true,
+        rejectNonzeroTrailingBits: true
+    )
 }
