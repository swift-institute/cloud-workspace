Subject: [PATCH 1/2] compound suite name: narrative suites move into the test
 module's namespace `<File> Tests` (#239's layout), nested suites into
 extension <Path>.<Parent> (overnight/compound-suites.py); parse-checked;
 builds pending (coenttb/work#242)

---
 .../Sector Comparison Tests.swift             | 16 +++++++++-----
 Tests/Sector Tests/Sector Hash Tests.swift    | 14 +++++++-----
 Tests/Sector Tests/Sector Tests.swift         | 22 +++++++++++--------
 3 files changed, 32 insertions(+), 20 deletions(-)

diff --git a/Tests/Sector Tests/Sector Comparison Tests.swift b/Tests/Sector Tests/Sector Comparison Tests.swift
index 4c96fb8..b6bd57b 100644
--- a/Tests/Sector Tests/Sector Comparison Tests.swift	
+++ b/Tests/Sector Tests/Sector Comparison Tests.swift	
@@ -1,11 +1,15 @@
 import Sector
 import Testing
 
-@Suite
-struct `Sector octants compare according to their rank` {
-    @Test
-    func `sectors retain rank ordering`() {
-        #expect(Sector.Quadrant.I < .II)
-        #expect(Sector.Octant.allCases.sorted() == Sector.Octant.allCases)
+enum `Sector Comparison Tests` {}
+
+extension `Sector Comparison Tests` {
+    @Suite
+    struct `Sector octants compare according to their rank` {
+        @Test
+        func `sectors retain rank ordering`() {
+            #expect(Sector.Quadrant.I < .II)
+            #expect(Sector.Octant.allCases.sorted() == Sector.Octant.allCases)
+        }
     }
 }
diff --git a/Tests/Sector Tests/Sector Hash Tests.swift b/Tests/Sector Tests/Sector Hash Tests.swift
index 54db870..7b98565 100644
--- a/Tests/Sector Tests/Sector Hash Tests.swift	
+++ b/Tests/Sector Tests/Sector Hash Tests.swift	
@@ -1,10 +1,14 @@
 import Sector
 import Testing
 
-@Suite
-struct `Sector octants remain distinct in sets` {
-    @Test
-    func `all octants are distinct set elements`() {
-        #expect(Set(Sector.Octant.allCases).count == 8)
+enum `Sector Hash Tests` {}
+
+extension `Sector Hash Tests` {
+    @Suite
+    struct `Sector octants remain distinct in sets` {
+        @Test
+        func `all octants are distinct set elements`() {
+            #expect(Set(Sector.Octant.allCases).count == 8)
+        }
     }
 }
diff --git a/Tests/Sector Tests/Sector Tests.swift b/Tests/Sector Tests/Sector Tests.swift
index 1f4c21c..85de86c 100644
--- a/Tests/Sector Tests/Sector Tests.swift	
+++ b/Tests/Sector Tests/Sector Tests.swift	
@@ -1,15 +1,19 @@
 import Sector
 import Testing
 
-@Suite
-struct `Sector octants preserve their structure under opposition` {
-    @Test
-    func `opposites are involutive`() {
-        for quadrant in Sector.Quadrant.allCases {
-            #expect(quadrant.opposite.opposite == quadrant)
-        }
-        for octant in Sector.Octant.allCases {
-            #expect(octant.opposite.opposite == octant)
+enum `Sector Tests` {}
+
+extension `Sector Tests` {
+    @Suite
+    struct `Sector octants preserve their structure under opposition` {
+        @Test
+        func `opposites are involutive`() {
+            for quadrant in Sector.Quadrant.allCases {
+                #expect(quadrant.opposite.opposite == quadrant)
+            }
+            for octant in Sector.Octant.allCases {
+                #expect(octant.opposite.opposite == octant)
+            }
         }
     }
 }
