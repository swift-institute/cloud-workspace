From 7a439a2aae4b5a860bb3b24d5de9bdd106926946 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 18:48:56 +0000
Subject: [PATCH] compound suite name: narrative suites move into extension
 <Type> named after their test file, nested suites into extension
 <Type>.<Parent> (overnight/compound-suites.py); parse-checked; builds pending
 (coenttb/work#242)

---
 Tests/Sector Tests/Sector Tests.swift | 20 +++++++++++---------
 1 file changed, 11 insertions(+), 9 deletions(-)

diff --git a/Tests/Sector Tests/Sector Tests.swift b/Tests/Sector Tests/Sector Tests.swift
index 1f4c21c..62b042e 100644
--- a/Tests/Sector Tests/Sector Tests.swift	
+++ b/Tests/Sector Tests/Sector Tests.swift	
@@ -1,15 +1,17 @@
 import Sector
 import Testing
 
-@Suite
-struct `Sector octants preserve their structure under opposition` {
-    @Test
-    func `opposites are involutive`() {
-        for quadrant in Sector.Quadrant.allCases {
-            #expect(quadrant.opposite.opposite == quadrant)
-        }
-        for octant in Sector.Octant.allCases {
-            #expect(octant.opposite.opposite == octant)
+extension Sector {
+    @Suite
+    struct `Sector octants preserve their structure under opposition` {
+        @Test
+        func `opposites are involutive`() {
+            for quadrant in Sector.Quadrant.allCases {
+                #expect(quadrant.opposite.opposite == quadrant)
+            }
+            for octant in Sector.Octant.allCases {
+                #expect(octant.opposite.opposite == octant)
+            }
         }
     }
 }
