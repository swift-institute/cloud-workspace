 .../Darwin Kernel/POSIX.Kernel.Thread.swift   |  8 ---
 Sources/Darwin Kernel/POSIX.Kernel.swift      | 21 -------
 3 files changed, 85 deletions(-)
 delete mode 100644 Sources/Darwin Kernel/ISO_9945.Kernel.File.Flush.swift
 delete mode 100644 Sources/Darwin Kernel/POSIX.Kernel.Thread.swift
 delete mode 100644 Sources/Darwin Kernel/POSIX.Kernel.swift

diff --git a/Sources/Darwin Kernel/ISO_9945.Kernel.File.Flush.swift b/Sources/Darwin Kernel/ISO_9945.Kernel.File.Flush.swift
deleted file mode 100644
index ea8dd92..0000000
--- a/Sources/Darwin Kernel/ISO_9945.Kernel.File.Flush.swift	
+++ /dev/null
@@ -1,56 +0,0 @@
-public import ISO_9945_Kernel_File
-
-#if os(macOS) || os(iOS) || os(tvOS) || os(watchOS) || os(visionOS)
-
-    extension ISO_9945.Kernel.File.Flush {
-
-        @inlinable
-        public static func data(
-            _ descriptor: borrowing ISO_9945.Kernel.Descriptor
-        ) throws(Self.Error) {
-            while true {
-                do throws(Self.Error) {
-                    try Self.barrierFsync(descriptor)
-                    return
-                } catch  where error.code.isInterrupted {
-                    continue
-                }
-            }
-        }
-    }
-
-    extension ISO_9945.Kernel.File.Flush {
-
-        @inlinable
-        public static func full(
-            _ descriptor: borrowing ISO_9945.Kernel.Descriptor
-        ) throws(Self.Error) {
-            while true {
-                do throws(Self.Error) {
-                    try Self.fullFsync(descriptor)
-                    return
-                } catch  where error.code.isInterrupted {
-                    continue
-                }
-            }
-        }
-    }
-
-    extension ISO_9945.Kernel.File.Flush {
-
-        @inlinable
-        public static func barrier(
-            _ descriptor: borrowing ISO_9945.Kernel.Descriptor
-        ) throws(Self.Error) {
-            while true {
-                do throws(Self.Error) {
-                    try Self.barrierFsync(descriptor)
-                    return
-                } catch  where error.code.isInterrupted {
-                    continue
-                }
-            }
-        }
-    }
-
-#endif
diff --git a/Sources/Darwin Kernel/POSIX.Kernel.Thread.swift b/Sources/Darwin Kernel/POSIX.Kernel.Thread.swift
deleted file mode 100644
index 7e5a8dc..0000000
--- a/Sources/Darwin Kernel/POSIX.Kernel.Thread.swift	
+++ /dev/null
@@ -1,8 +0,0 @@
