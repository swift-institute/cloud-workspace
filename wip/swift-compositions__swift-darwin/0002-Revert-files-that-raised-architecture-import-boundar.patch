From 8fc03e62ea21a4c65ff95ff1ee4cbdd89cef4df1 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 04:03:58 +0000
Subject: [PATCH 2/4] Revert files that raised `architecture import boundary`
 over its ratchet limit (coenttb/work#242)

---
 .../Darwin.Kernel.File.Flush.swift            | 56 +++++++++++++++++++
 .../POSIX.Kernel.Thread.ID.swift              |  8 +++
 Sources/Darwin Kernel/exports.swift           | 21 +++++++
 3 files changed, 85 insertions(+)
 create mode 100644 Sources/Darwin Kernel/Darwin.Kernel.File.Flush.swift
 create mode 100644 Sources/Darwin Kernel/POSIX.Kernel.Thread.ID.swift
 create mode 100644 Sources/Darwin Kernel/exports.swift

diff --git a/Sources/Darwin Kernel/Darwin.Kernel.File.Flush.swift b/Sources/Darwin Kernel/Darwin.Kernel.File.Flush.swift
new file mode 100644
index 0000000..ea8dd92
--- /dev/null
+++ b/Sources/Darwin Kernel/Darwin.Kernel.File.Flush.swift	
@@ -0,0 +1,56 @@
+public import ISO_9945_Kernel_File
+
+#if os(macOS) || os(iOS) || os(tvOS) || os(watchOS) || os(visionOS)
+
+    extension ISO_9945.Kernel.File.Flush {
+
+        @inlinable
+        public static func data(
+            _ descriptor: borrowing ISO_9945.Kernel.Descriptor
+        ) throws(Self.Error) {
+            while true {
+                do throws(Self.Error) {
+                    try Self.barrierFsync(descriptor)
+                    return
+                } catch  where error.code.isInterrupted {
+                    continue
+                }
+            }
+        }
+    }
+
+    extension ISO_9945.Kernel.File.Flush {
+
+        @inlinable
+        public static func full(
+            _ descriptor: borrowing ISO_9945.Kernel.Descriptor
+        ) throws(Self.Error) {
+            while true {
+                do throws(Self.Error) {
+                    try Self.fullFsync(descriptor)
+                    return
+                } catch  where error.code.isInterrupted {
+                    continue
+                }
+            }
+        }
+    }
+
+    extension ISO_9945.Kernel.File.Flush {
+
+        @inlinable
+        public static func barrier(
+            _ descriptor: borrowing ISO_9945.Kernel.Descriptor
+        ) throws(Self.Error) {
+            while true {
+                do throws(Self.Error) {
+                    try Self.barrierFsync(descriptor)
+                    return
+                } catch  where error.code.isInterrupted {
+                    continue
+                }
+            }
+        }
+    }
+
+#endif
diff --git a/Sources/Darwin Kernel/POSIX.Kernel.Thread.ID.swift b/Sources/Darwin Kernel/POSIX.Kernel.Thread.ID.swift
new file mode 100644
index 0000000..7e5a8dc
--- /dev/null
+++ b/Sources/Darwin Kernel/POSIX.Kernel.Thread.ID.swift	
@@ -0,0 +1,8 @@
+#if os(macOS) || os(iOS) || os(tvOS) || os(watchOS) || os(visionOS)
+
+    extension POSIX.Kernel.Thread {
+
+        public typealias ID = ISO_9945.Kernel.Thread.ID
+    }
+
+#endif
diff --git a/Sources/Darwin Kernel/exports.swift b/Sources/Darwin Kernel/exports.swift
new file mode 100644
index 0000000..4f42464
--- /dev/null
+++ b/Sources/Darwin Kernel/exports.swift	
@@ -0,0 +1,21 @@
+@_exported public import Clock
+@_exported public import Darwin_Kernel_Event_Standard
+@_exported public import Darwin_Kernel_Standard
+@_exported public import Error
+@_exported public import ISO_9945_Core
+@_exported public import Memory
+@_exported public import POSIX_Kernel
+@_exported public import Path
+@_exported public import Random
+
+public typealias Kernel = POSIX.Kernel
+
+public typealias Darwin = Darwin_Kernel_Standard::Darwin
+
+public typealias Random = Random::Random
+
+#if os(macOS) || os(iOS) || os(tvOS) || os(watchOS) || os(visionOS)
+    extension POSIX.Kernel {
+        public typealias Kqueue = Darwin.Kernel.Event.Queue
+    }
+#endif
