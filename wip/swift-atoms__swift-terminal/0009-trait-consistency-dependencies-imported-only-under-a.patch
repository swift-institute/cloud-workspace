From 975a197e31cc78cd9262c77e440204df25e7b38f Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:24:51 +0000
Subject: [PATCH 9/9] trait consistency: dependencies imported only under a
 trait get that trait's condition (runner repair; Linux x86_64, Swift 6.4.2)
 (coenttb/work#242)

---
 Package.swift | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/Package.swift b/Package.swift
index 5917e00..56cc9e5 100644
--- a/Package.swift
+++ b/Package.swift
@@ -42,17 +42,17 @@ let package = Package(
             name: "Absorbed swift-terminal-error Tests",
             dependencies: [
                 .target(name: "Terminal"),
-                .product(name: "Error", package: "swift-error"),
+                .product(name: "Error", package: "swift-error", condition: .when(traits: ["Error"])),
             ],
             path: "Tests/Absorbed swift-terminal-error"
         ),
         .target(
             name: "Terminal",
             dependencies: [
-                .product(name: "ASCII", package: "swift-ascii"),
-                .product(name: "Byte", package: "swift-byte"),
-                .product(name: "Cursor", package: "swift-cursor"),
-                .product(name: "Error", package: "swift-error"),
+                .product(name: "ASCII", package: "swift-ascii", condition: .when(traits: ["Input"])),
+                .product(name: "Byte", package: "swift-byte", condition: .when(traits: ["Input"])),
+                .product(name: "Cursor", package: "swift-cursor", condition: .when(traits: ["Input"])),
+                .product(name: "Error", package: "swift-error", condition: .when(traits: ["Error"])),
             ],
             path: "Sources/Terminal"
         ),
-- 
