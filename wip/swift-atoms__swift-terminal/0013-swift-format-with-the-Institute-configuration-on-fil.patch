diff --git a/Sources/Terminal/Input/Terminal.Input.Parser.swift b/Sources/Terminal/Input/Terminal.Input.Parser.swift
index dca3379..d556f23 100644
--- a/Sources/Terminal/Input/Terminal.Input.Parser.swift
+++ b/Sources/Terminal/Input/Terminal.Input.Parser.swift
@@ -487,13 +487,14 @@
             let code = mapCodepointToKeyCode(codepoint)
 
             let text: Swift::String?
-            text = if let scalar = Unicode.Scalar(codepoint),
-                codepoint >= 0x20 && codepoint != 0x7F && codepoint < 0xE000
-            {
-                Swift::String(scalar)
-            } else {
-                nil
-            }
