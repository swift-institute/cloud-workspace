From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 06:08:23 +0000
Subject: [PATCH 10/13] Second round: counter loops, if expressions,
 fileprivate single-file types, extension file renames (type-check follows;
 Linux x86_64, Swift 6.4.2) (coenttb/work#242)

---
 Sources/Terminal/Input/Terminal.Input.Parser.swift | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/Sources/Terminal/Input/Terminal.Input.Parser.swift b/Sources/Terminal/Input/Terminal.Input.Parser.swift
index 1952f07..dca3379 100644
--- a/Sources/Terminal/Input/Terminal.Input.Parser.swift
+++ b/Sources/Terminal/Input/Terminal.Input.Parser.swift
@@ -487,12 +487,12 @@
             let code = mapCodepointToKeyCode(codepoint)
 
             let text: Swift::String?
-            if let scalar = Unicode.Scalar(codepoint),
+            text = if let scalar = Unicode.Scalar(codepoint),
                 codepoint >= 0x20 && codepoint != 0x7F && codepoint < 0xE000
             {
-                text = Swift::String(scalar)
+                Swift::String(scalar)
             } else {
-                text = nil
+                nil
             }
 
             return .key(Terminal.Input.Key(code: code, modifiers: modifiers, text: text, kind: kind))
