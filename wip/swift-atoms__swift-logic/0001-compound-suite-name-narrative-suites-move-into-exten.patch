Date: Sat, 7 Nov 2026 18:48:53 +0000
Subject: [PATCH] compound suite name: narrative suites move into extension
 <Type> named after their test file, nested suites into extension
 <Type>.<Parent> (overnight/compound-suites.py); parse-checked; builds pending
 (coenttb/work#242)

---
 Tests/Logic Tests/Logic.Ternary.Builder Tests.swift  |  7 ++++++-
 Tests/Logic Tests/Optional+Logic.Ternary Tests.swift | 11 ++++++++---
 2 files changed, 14 insertions(+), 4 deletions(-)

diff --git a/Tests/Logic Tests/Logic.Ternary.Builder Tests.swift b/Tests/Logic Tests/Logic.Ternary.Builder Tests.swift
index b705b01..8a6032f 100644
--- a/Tests/Logic Tests/Logic.Ternary.Builder Tests.swift	
+++ b/Tests/Logic Tests/Logic.Ternary.Builder Tests.swift	
@@ -5,8 +5,14 @@ import Testing
 
 @Suite
 struct `Ternary builders combine expressions using Strong Kleene logic` {
+
+}
+
+extension `Ternary builders combine expressions using Strong Kleene logic` {
     @Suite struct `No ternary builder unit cases are defined` {}
+
     @Suite struct `No ternary builder boundary cases are defined` {}
+
     @Suite struct `No ternary builder integration cases are defined` {}
 
     @Suite
@@ -442,5 +448,4 @@ struct `Ternary builders combine expressions using Strong Kleene logic` {
             #expect(r3 == nil)
         }
     }
-
 }
diff --git a/Tests/Logic Tests/Optional+Logic.Ternary Tests.swift b/Tests/Logic Tests/Optional+Logic.Ternary Tests.swift
index 7258d90..4b7d689 100644
--- a/Tests/Logic Tests/Optional+Logic.Ternary Tests.swift	
+++ b/Tests/Logic Tests/Optional+Logic.Ternary Tests.swift	
@@ -5,9 +5,6 @@ import Testing
 
 @Suite
 struct `Optional ternary operations preserve unknown values and explicit collapse behavior` {
-    @Suite struct `No optional ternary unit cases are defined` {}
-    @Suite struct `No optional ternary boundary cases are defined` {}
-    @Suite struct `No optional ternary integration cases are defined` {}
 
     static let values: [Bool?] = [true, false, nil]
 
@@ -45,3 +42,11 @@ struct `Optional ternary operations preserve unknown values and explicit collaps
         #expect((nil as Bool?).isUnknown)
     }
 }
+
+extension `Optional ternary operations preserve unknown values and explicit collapse behavior` {
+    @Suite struct `No optional ternary unit cases are defined` {}
+
+    @Suite struct `No optional ternary boundary cases are defined` {}
+
+    @Suite struct `No optional ternary integration cases are defined` {}
+}
