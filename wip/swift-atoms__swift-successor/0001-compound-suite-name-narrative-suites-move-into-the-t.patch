From a4cd3f233cea1d483e9ad2d9bc08eec384d432bc Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 19:34:08 +0000
Subject: [PATCH] compound suite name: narrative suites move into the test
 module's namespace `<File> Tests` (#239's layout), nested suites into
 extension <Path>.<Parent> (overnight/compound-suites.py); parse-checked;
 builds pending (coenttb/work#242)

---
 Tests/Successor Tests/Successor Tests.swift | 32 ++++++++++++---------
 1 file changed, 18 insertions(+), 14 deletions(-)

diff --git a/Tests/Successor Tests/Successor Tests.swift b/Tests/Successor Tests/Successor Tests.swift
index 03714be..57c5168 100644
--- a/Tests/Successor Tests/Successor Tests.swift	
+++ b/Tests/Successor Tests/Successor Tests.swift	
@@ -2,22 +2,26 @@ import Addition
 import Successor
 import Testing
 
-@Suite
-struct `Successor checks and saturates movement to the next value` {
+enum `Successor Tests` {}
 
-    @Test
-    func `Successor reports and throws at the greatest value`() {
-        let report = Successor.reporting(UInt.max)
-        #expect(report.value == 0)
-        #expect(report.overflow)
-        #expect(throws: Addition.Error.overflow) {
-            try Successor.exact(UInt.max)
+extension `Successor Tests` {
+    @Suite
+    struct `Successor checks and saturates movement to the next value` {
+
+        @Test
+        func `Successor reports and throws at the greatest value`() {
+            let report = Successor.reporting(UInt.max)
+            #expect(report.value == 0)
+            #expect(report.overflow)
+            #expect(throws: Addition.Error.overflow) {
+                try Successor.exact(UInt.max)
+            }
         }
-    }
 
-    @Test
-    func `Exact and saturating successor operations select the next value`() throws {
-        #expect(try Successor.exact(UInt(41)) == 42)
-        #expect(Successor.saturating(UInt.max) == UInt.max)
+        @Test
+        func `Exact and saturating successor operations select the next value`() throws {
+            #expect(try Successor.exact(UInt(41)) == 42)
+            #expect(Successor.saturating(UInt.max) == UInt.max)
+        }
     }
 }
