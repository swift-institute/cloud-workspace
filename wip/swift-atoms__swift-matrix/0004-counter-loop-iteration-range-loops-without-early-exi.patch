From 9e00524689c34ddda24c5a0f99d1812e8666ac6d Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:34:00 +0000
Subject: [PATCH 4/4] counter loop iteration: range loops without early exit
 written as forEach (type-check follows; Linux x86_64, Swift 6.4.2)
 (coenttb/work#242)

---
 Sources/Matrix/Matrix.swift                             | 6 +++---
 Tests/Matrix Rotation Tests/Matrix Rotation Tests.swift | 6 +++---
 Tests/Matrix Scale Tests/Matrix Scale Tests.swift       | 2 +-
 Tests/Matrix Shear Tests/Matrix Shear Tests.swift       | 4 ++--
 4 files changed, 9 insertions(+), 9 deletions(-)

diff --git a/Sources/Matrix/Matrix.swift b/Sources/Matrix/Matrix.swift
index 9970a07..55a773f 100644
--- a/Sources/Matrix/Matrix.swift
+++ b/Sources/Matrix/Matrix.swift
@@ -15,7 +15,7 @@ extension Matrix where Scalar: Numeric {
         Vector<Rows, Scalar>(
             InlineArray { row in
                 var result: Scalar = .zero
-                for column in 0..<Columns { result += self[row, column] * vector[column] }
+                (0..<Columns).forEach { column in result += self[row, column] * vector[column] }
                 return result
             }
         )
@@ -28,7 +28,7 @@ extension Matrix where Scalar: Numeric {
             rows: InlineArray { row in
                 InlineArray { column in
                     var result: Scalar = .zero
-                    for inner in 0..<Columns { result += self[row, inner] * other[inner, column] }
+                    (0..<Columns).forEach { inner in result += self[row, inner] * other[inner, column] }
                     return result
                 }
             }
@@ -80,7 +80,7 @@ extension Matrix: Swift::Equatable where Scalar: Swift::Equatable {
 extension Matrix: Swift::Hashable where Scalar: Swift::Hashable {
     public func hash(into hasher: inout Hasher) {
         (0..<Rows).forEach { row in
-            for column in 0..<Columns { hasher.combine(self[row, column]) }
+            (0..<Columns).forEach { column in hasher.combine(self[row, column]) }
         }
     }
 }
