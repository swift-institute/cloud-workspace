From 8ff52ffebc8c2e46acca3d8722bd8da3584578dc Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 18:24:14 +0000
Subject: [PATCH] minimal type body: the runner's repair moves non-stored
 members out of type bodies into extensions; repair applied; root and test
 builds not yet run (coenttb/work#242)

---
 Sources/Matrix/Matrix.swift | 29 ++++++++++++++++-------------
 1 file changed, 16 insertions(+), 13 deletions(-)

diff --git a/Sources/Matrix/Matrix.swift b/Sources/Matrix/Matrix.swift
index 7bf2e45..6029094 100644
--- a/Sources/Matrix/Matrix.swift
+++ b/Sources/Matrix/Matrix.swift
@@ -6,19 +6,6 @@ public struct Matrix<let Rows: Int, let Columns: Int, Scalar> {
     public init(rows: consuming InlineArray<Rows, InlineArray<Columns, Scalar>>) {
         self.rows = rows
     }
-
-    public subscript(row: Int, column: Int) -> Scalar {
-        get { rows[row][column] }
-        set { rows[row][column] = newValue }
-    }
-
-    public var transposed: Matrix<Columns, Rows, Scalar> {
-        Matrix<Columns, Rows, Scalar>(
-            rows: InlineArray { column in
-                InlineArray { row in self[row, column] }
-            }
-        )
-    }
 }
 
 extension Matrix: Swift::Sendable where Scalar: Swift::Sendable {}
@@ -54,3 +41,19 @@ extension Matrix {
         self.init(rows: InlineArray(repeating: InlineArray(repeating: value)))
     }
 }
+
+extension Matrix {
+
+    public subscript(row: Int, column: Int) -> Scalar {
+        get { rows[row][column] }
+        set { rows[row][column] = newValue }
+    }
+
+    public var transposed: Matrix<Columns, Rows, Scalar> {
+        Matrix<Columns, Rows, Scalar>(
+            rows: InlineArray { column in
+                InlineArray { row in self[row, column] }
+            }
+        )
+    }
+}
