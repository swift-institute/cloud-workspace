Subject: [PATCH 3/4] compound suite name: narrative suites moved into the test
 file's namespace or the parent suite's extension (names and test IDs kept;
 tests only; Linux x86_64, Swift 6.4.2) (coenttb/work#242)

---
 Tests/Polarity Tests/Polarity Pair Tests.swift | 10 ++++++----
 1 file changed, 6 insertions(+), 4 deletions(-)

diff --git a/Tests/Polarity Tests/Polarity Pair Tests.swift b/Tests/Polarity Tests/Polarity Pair Tests.swift
index 79084f4..12a76aa 100644
--- a/Tests/Polarity Tests/Polarity Pair Tests.swift	
+++ b/Tests/Polarity Tests/Polarity Pair Tests.swift	
@@ -1,12 +1,14 @@
 import Polarity
 import Testing
 
-@Suite
-struct `Polarity Pair Tests` {
-    @Suite struct Unit {}
+extension `Polarity Pair Tests`.`Polarity Pair Tests` {
+    @Suite
+    struct `Polarity Pair Tests` {
+        @Suite struct Unit {}
+    }
 }
 
-extension `Polarity Pair Tests`.Unit {
+extension `Polarity Pair Tests`.`Polarity Pair Tests`.Unit {
 
     @Test
     func `Polarity Value typealias resolves through Pair`() {
