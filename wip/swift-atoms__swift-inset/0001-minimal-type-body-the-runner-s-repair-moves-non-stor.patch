From e2d36f4c96dbd71cb001f550f5b6f9248d4ee198 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 18:24:14 +0000
Subject: [PATCH 1/2] minimal type body: the runner's repair moves non-stored
 members out of type bodies into extensions; repair applied; root and test
 builds not yet run (coenttb/work#242)

---
 Sources/Inset/Inset.swift | 11 +++++++----
 1 file changed, 7 insertions(+), 4 deletions(-)

diff --git a/Sources/Inset/Inset.swift b/Sources/Inset/Inset.swift
index 3beab34..7c7e05b 100644
--- a/Sources/Inset/Inset.swift
+++ b/Sources/Inset/Inset.swift
@@ -11,10 +11,6 @@ public struct Inset<let N: Int, Scalar> {
         self.lower = lower
         self.upper = upper
     }
-
-    public subscript(axis: Int) -> (lower: Scalar, upper: Scalar) {
-        (lower[axis], upper[axis])
-    }
 }
 
 extension Inset {
@@ -64,3 +60,10 @@ extension Inset where Scalar: SignedNumeric {
         value.map { -$0 }
     }
 }
+
+extension Inset {
+
+    public subscript(axis: Int) -> (lower: Scalar, upper: Scalar) {
+        (lower[axis], upper[axis])
+    }
+}
