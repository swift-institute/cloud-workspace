From 9689086244d18d863651cd78c19049df374339c2 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:27:13 +0000
Subject: [PATCH 08/12] compound suite name: narrative suites moved into the
 test file's namespace or the parent suite's extension (names and test IDs
 kept; tests only; Linux x86_64, Swift 6.4.2) (coenttb/work#242)

---
 .../SVG.Context Tests.swift                   | 36 ++++++++++---------
 .../SVG Rendering Tests/SVG.Empty Tests.swift | 22 ++++++------
 Tests/SVG Rendering Tests/SVG.Raw Tests.swift | 14 ++++----
 .../SVG Rendering Tests/SVG.Text Tests.swift  | 34 +++++++++---------
 4 files changed, 57 insertions(+), 49 deletions(-)

diff --git a/Tests/SVG Rendering Tests/SVG.Context Tests.swift b/Tests/SVG Rendering Tests/SVG.Context Tests.swift
index c026dd9..5caacf1 100644
--- a/Tests/SVG Rendering Tests/SVG.Context Tests.swift	
+++ b/Tests/SVG Rendering Tests/SVG.Context Tests.swift	
@@ -44,26 +44,28 @@ extension `SVG.Context Tests` {
                 #expect(context.attributes.isEmpty)
             }
         }
+    }
+}
 
-        @Suite struct EdgeCase {
+extension `SVG.Context Tests`.Test {
+    @Suite struct EdgeCase {
 
-            @Test
-            func `outdented at root level does not underflow`() {
-                let context = SVG.Context(.pretty)
-                let outdented = context.outdented()
-                #expect(outdented.currentIndentation.isEmpty)
-            }
+        @Test
+        func `outdented at root level does not underflow`() {
+            let context = SVG.Context(.pretty)
+            let outdented = context.outdented()
+            #expect(outdented.currentIndentation.isEmpty)
+        }
 
-            @Test
-            func `custom configuration preserves settings`() {
-                let config = SVG.Context.Configuration(
-                    indentation: "\t",
-                    newline: "\r\n"
-                )
-                let context = SVG.Context(config)
-                #expect(context.configuration.indentation == [Byte](utf8: "\t"))
-                #expect(context.configuration.newline == [Byte](utf8: "\r\n"))
-            }
+        @Test
+        func `custom configuration preserves settings`() {
+            let config = SVG.Context.Configuration(
+                indentation: "\t",
+                newline: "\r\n"
+            )
+            let context = SVG.Context(config)
+            #expect(context.configuration.indentation == [Byte](utf8: "\t"))
+            #expect(context.configuration.newline == [Byte](utf8: "\r\n"))
         }
     }
 }
diff --git a/Tests/SVG Rendering Tests/SVG.Empty Tests.swift b/Tests/SVG Rendering Tests/SVG.Empty Tests.swift
index d7262de..9de4025 100644
--- a/Tests/SVG Rendering Tests/SVG.Empty Tests.swift	
+++ b/Tests/SVG Rendering Tests/SVG.Empty Tests.swift	
@@ -22,19 +22,21 @@ extension `SVG.Empty Tests` {
                 #expect(string.isEmpty)
             }
         }
+    }
+}
 
-        @Suite struct EdgeCase {
+extension `SVG.Empty Tests`.Test {
+    @Suite struct EdgeCase {
 
-            @Test
-            func `multiple empties compose to empty`() {
-                let group = SVG.Group {
-                    SVG.Empty()
-                    SVG.Empty()
-                    SVG.Empty()
-                }
-                let bytes = [Byte](group)
-                #expect(bytes.isEmpty)
+        @Test
+        func `multiple empties compose to empty`() {
+            let group = SVG.Group {
+                SVG.Empty()
+                SVG.Empty()
+                SVG.Empty()
             }
+            let bytes = [Byte](group)
+            #expect(bytes.isEmpty)
         }
     }
 }
diff --git a/Tests/SVG Rendering Tests/SVG.Raw Tests.swift b/Tests/SVG Rendering Tests/SVG.Raw Tests.swift
index ff1ba8b..6949ca6 100644
--- a/Tests/SVG Rendering Tests/SVG.Raw Tests.swift	
+++ b/Tests/SVG Rendering Tests/SVG.Raw Tests.swift	
@@ -25,14 +25,16 @@ extension `SVG.Raw Tests` {
                 #expect(string == "<g><rect/></g>")
             }
         }
+    }
+}
 
-        @Suite struct EdgeCase {
+extension `SVG.Raw Tests`.Test {
+    @Suite struct EdgeCase {
 
-            @Test
-            func `empty raw renders empty`() {
-                let string = render(SVG.Raw(""))
-                #expect(string.isEmpty)
-            }
+        @Test
+        func `empty raw renders empty`() {
+            let string = render(SVG.Raw(""))
+            #expect(string.isEmpty)
         }
     }
 }
diff --git a/Tests/SVG Rendering Tests/SVG.Text Tests.swift b/Tests/SVG Rendering Tests/SVG.Text Tests.swift
index 5f176cd..55173be 100644
--- a/Tests/SVG Rendering Tests/SVG.Text Tests.swift	
+++ b/Tests/SVG Rendering Tests/SVG.Text Tests.swift	
@@ -62,26 +62,28 @@ extension `SVG.Text Tests` {
                 #expect(string == "Hello")
             }
         }
+    }
+}
 
-        @Suite struct EdgeCase {
+extension `SVG.Text Tests`.Test {
+    @Suite struct EdgeCase {
 
-            @Test
-            func `empty string renders empty`() {
-                let string = render(SVG.Text(""))
-                #expect(string.isEmpty)
-            }
+        @Test
+        func `empty string renders empty`() {
+            let string = render(SVG.Text(""))
+            #expect(string.isEmpty)
+        }
 
-            @Test
-            func `escapes all special characters in sequence`() {
-                let string = render(SVG.Text("<script>alert('xss')</script>"))
-                #expect(string == "&lt;script&gt;alert(&apos;xss&apos;)&lt;/script&gt;")
-            }
+        @Test
+        func `escapes all special characters in sequence`() {
+            let string = render(SVG.Text("<script>alert('xss')</script>"))
+            #expect(string == "&lt;script&gt;alert(&apos;xss&apos;)&lt;/script&gt;")
+        }
 
-            @Test
-            func `preserves non-ASCII unicode`() {
-                let string = render(SVG.Text("cafe\u{0301}"))
-                #expect(string == "cafe\u{0301}")
-            }
+        @Test
+        func `preserves non-ASCII unicode`() {
+            let string = render(SVG.Text("cafe\u{0301}"))
+            #expect(string == "cafe\u{0301}")
         }
     }
 }
