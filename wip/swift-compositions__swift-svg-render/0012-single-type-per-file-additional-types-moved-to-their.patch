From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:06:20 +0000
Subject: [PATCH 12/12] single type per file: additional types moved to their
 own files (type-check follows; Linux x86_64, Swift 6.4.2) (coenttb/work#242)

---
 .../SVG.Context.Configuration.swift           | 25 +++++++++++++++++++
 Sources/SVG Rendering/SVG.Context.swift       |  9 -------
 2 files changed, 25 insertions(+), 9 deletions(-)
 create mode 100644 Sources/SVG Rendering/SVG.Context.Configuration.swift

diff --git a/Sources/SVG Rendering/SVG.Context.Configuration.swift b/Sources/SVG Rendering/SVG.Context.Configuration.swift
new file mode 100644
index 0000000..460bf22
--- /dev/null
+++ b/Sources/SVG Rendering/SVG.Context.Configuration.swift	
@@ -0,0 +1,25 @@
+public import Byte
+public import Dictionary_Ordered
+import Renderer
+public import Buffer
+public import Buffer_Linear_Primitive
+public import Dictionary
+public import Hash_Indexed_Primitive
+public import Hash_Table_Primitive
+public import Memory
+public import Memory_Allocator
+public import Ownership_Shared_Primitive
+public import Storage
+
+
+extension SVG.Context {
+    public struct Configuration: Sendable {
+        public var indentation: [Byte]
+        public var newline: [Byte]
+
+        public init(indentation: String = "", newline: String = "") {
+            self.indentation = [Byte](utf8: indentation)
+            self.newline = [Byte](utf8: newline)
+        }
+    }
+}
diff --git a/Sources/SVG Rendering/SVG.Context.swift b/Sources/SVG Rendering/SVG.Context.swift
index 93fddd3..a3891ca 100644
--- a/Sources/SVG Rendering/SVG.Context.swift	
+++ b/Sources/SVG Rendering/SVG.Context.swift	
@@ -31,15 +31,6 @@ extension SVG.Context {
 }
 
