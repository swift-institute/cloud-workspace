From 17309c50fcc5d703c870cee30fe8e5f8bac08516 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 06:08:23 +0000
Subject: [PATCH 07/14] Second round: counter loops, if expressions,
 fileprivate single-file types, extension file renames (type-check follows;
 Linux x86_64, Swift 6.4.2) (coenttb/work#242)

---
 .../Swift.String.Builder Tests.swift                          | 4 ++--
 .../Swift.Substring.Builder Tests.swift                       | 2 +-
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/Tests/Standard Library Extensions Tests/Swift.String.Builder Tests.swift b/Tests/Standard Library Extensions Tests/Swift.String.Builder Tests.swift
index f52ce62..80bc994 100644
--- a/Tests/Standard Library Extensions Tests/Swift.String.Builder Tests.swift	
+++ b/Tests/Standard Library Extensions Tests/Swift.String.Builder Tests.swift	
@@ -127,7 +127,7 @@ struct `String.Builder Tests` {
         func `For loop string building`() {
             let result = String {
                 "Header"
-                for i in 1...3 {
+                (1...3).forEach { i in
                     "Item \(i)"
                 }
                 "Footer"
@@ -265,7 +265,7 @@ struct `String.Builder Tests` {
         func `Large string building`() {
             let result = String {
                 "Large String Test"
-                for i in 1...100 {
+                (1...100).forEach { i in
                     "Line \(i)"
                 }
                 "End of large string"
diff --git a/Tests/Standard Library Extensions Tests/Swift.Substring.Builder Tests.swift b/Tests/Standard Library Extensions Tests/Swift.Substring.Builder Tests.swift
index 186966c..afbd5a9 100644
--- a/Tests/Standard Library Extensions Tests/Swift.Substring.Builder Tests.swift	
+++ b/Tests/Standard Library Extensions Tests/Swift.Substring.Builder Tests.swift	
@@ -110,7 +110,7 @@ struct `Substring.Builder Tests` {
         @Test
         func `For loop`() {
             let result: Substring = Substring {
-                for i in 1...3 {
+                (1...3).forEach { i in
                     "Line \(i)"
                 }
             }
