 (coenttb/work#242)

---
 .../Swift.Bool.Builder Tests.swift                        | 8 +++-----
 1 file changed, 3 insertions(+), 5 deletions(-)

diff --git a/Tests/Standard Library Extensions Tests/Swift.Bool.Builder Tests.swift b/Tests/Standard Library Extensions Tests/Swift.Bool.Builder Tests.swift
index 1011cc8..d324cc8 100644
--- a/Tests/Standard Library Extensions Tests/Swift.Bool.Builder Tests.swift	
+++ b/Tests/Standard Library Extensions Tests/Swift.Bool.Builder Tests.swift	
@@ -4,9 +4,7 @@ import Testing
 
 @Suite
 struct `Bool.Builder Tests` {
-}
 
