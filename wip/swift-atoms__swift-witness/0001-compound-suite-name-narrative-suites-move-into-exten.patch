+++ b/Tests/Witness Tests/Witness Tests.swift	
@@ -7,11 +7,15 @@ enum `Witness Tests` {}
 extension `Witness Tests` {
     @Suite
     struct `Witness markers accept conformances through both protocol spellings` {
