 Tests/Witness Tests/Witness Tests.swift | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/Tests/Witness Tests/Witness Tests.swift b/Tests/Witness Tests/Witness Tests.swift
index 49c1e69..3ec2afe 100644
--- a/Tests/Witness Tests/Witness Tests.swift	
+++ b/Tests/Witness Tests/Witness Tests.swift	
@@ -7,11 +7,15 @@ enum `Witness Tests` {}
 extension `Witness Tests` {
     @Suite
     struct `Witness markers accept conformances through both protocol spellings` {
