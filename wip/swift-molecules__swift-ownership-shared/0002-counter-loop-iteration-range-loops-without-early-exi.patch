@@ -183,21 +183,21 @@ extension `Shared+Concurrency.Storm Tests` {
                     for t in 0..<6 {
                         group.addTask {
                             var mine = frozen
-                            for k in 0..<20 {
+                            (0..<20).forEach { k in
                                 mine.append(Payload(t &* 100 &+ k))
