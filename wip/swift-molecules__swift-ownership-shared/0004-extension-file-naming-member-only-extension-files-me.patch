Subject: [PATCH 4/4] extension file naming: member-only extension files merged
 into the extended type's own file (type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 .../Ownership.Shared.swift                    | 57 +++++++++++++++++++
 .../Shared+Equatable.swift                    | 25 --------
 .../Shared+Hashable.swift                     | 24 --------
 .../Shared+withUnique.swift                   | 37 ------------
 4 files changed, 57 insertions(+), 86 deletions(-)
 delete mode 100644 Sources/Ownership Shared Primitive/Shared+Equatable.swift
 delete mode 100644 Sources/Ownership Shared Primitive/Shared+Hashable.swift
 delete mode 100644 Sources/Ownership Shared Primitive/Shared+withUnique.swift

diff --git a/Sources/Ownership Shared Primitive/Ownership.Shared.swift b/Sources/Ownership Shared Primitive/Ownership.Shared.swift
index 2dda02f..498a1ec 100644
--- a/Sources/Ownership Shared Primitive/Ownership.Shared.swift	
+++ b/Sources/Ownership Shared Primitive/Ownership.Shared.swift	
@@ -12,6 +12,7 @@ import Property
 public import Storage
 import Store
 import Tagged
+import Affine
 
 extension Ownership.Shared where Element: ~Copyable, B: ~Copyable {
 
@@ -62,3 +63,59 @@ extension Ownership.Shared where Element: ~Copyable, B: ~Copyable {
         return try body(&span)
     }
 }
+
+extension Ownership.Shared: Equatable where Element: Equatable, B: ~Copyable {
+
+    @inlinable
+    public static func == (lhs: Self, rhs: Self) -> Bool {
+        guard lhs.count == rhs.count else { return false }
+        var slot: Index<Element> = .zero
+        let end = lhs.count.map(Ordinal.init)
+        while slot < end {
+            guard lhs[slot] == rhs[slot] else { return false }
+            slot += .one
+        }
+        return true
+    }
+}
+
+extension Ownership.Shared: Hashable where Element: Hashable, B: ~Copyable {
+
+    @inlinable
+    public func hash(into hasher: inout Hasher) {
+        hasher.combine(Int(bitPattern: count.underlying))
+        var slot: Index<Element> = .zero
+        let end = count.map(Ordinal.init)
+        while slot < end {
+            hasher.combine(self[slot])
+            slot += .one
+        }
+    }
+}
+
+extension Ownership.Shared where Element: ~Copyable, B: ~Copyable {
+
+    @inlinable
+    public mutating func withUnique<R: ~Copyable, Failure: Swift::Error>(
+        _ body: (inout B) throws(Failure) -> R
+    ) throws(Failure) -> R {
+        ensureUnique()
+        return try unsafe body(&box.unguarded)
+    }
+
+    @inlinable
+    public mutating func withUnique<T: ~Copyable, R: ~Copyable, Failure: Swift::Error>(
+        consuming payload: consuming T,
+        _ body: (inout B, consuming T) throws(Failure) -> R
+    ) throws(Failure) -> R {
+        ensureUnique()
+        return try unsafe body(&box.unguarded, payload)
+    }
+
+    @inlinable
+    public func withColumn<R: ~Copyable, Failure: Swift::Error>(
+        _ body: (borrowing B) throws(Failure) -> R
+    ) throws(Failure) -> R {
+        try unsafe body(box.unguarded)
+    }
+}
