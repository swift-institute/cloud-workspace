diff --git a/Sources/RFC 768/Absorbed swift-rfc-768-coder/RFC_768.Checksum.Coder.swift b/Sources/RFC 768/Absorbed swift-rfc-768-coder/RFC_768.Checksum.Coder.swift
index aa2b004..6a4c97d 100644
--- a/Sources/RFC 768/Absorbed swift-rfc-768-coder/RFC_768.Checksum.Coder.swift	
+++ b/Sources/RFC 768/Absorbed swift-rfc-768-coder/RFC_768.Checksum.Coder.swift	
@@ -7,32 +7,32 @@
     import Serializer
 
     extension RFC_768.Checksum {
-
         public struct Coder<Input: Cursor.`Protocol`<Byte, Never>, Buffer: RangeReplaceableCollection<Byte>>: Coding {
+            public init() {}
+        }
 
-            public typealias Output = RFC_768.Checksum
+        public static var coder: Coder<ArraySlice<Byte>, [Byte]> { .init() }
+    }
 
-            public typealias Failure = RFC_768.Checksum.Error
+extension RFC_768.Checksum.Coder {
+        public typealias Output = RFC_768.Checksum
 
-            public init() {}
+        public typealias Failure = RFC_768.Checksum.Error
 
-            public borrowing func parse(_ input: inout Input) throws(Failure) -> Output {
-                let start = input.checkpoint
-                guard let high = input.next() else {
-                    throw .empty
-                }
-                guard let low = input.next() else {
-                    input.seek(to: start)
-                    throw .insufficientBytes
-                }
-                return RFC_768.Checksum(rawValue: UInt16(high.bitPattern) << 8 | UInt16(low.bitPattern))
+        public borrowing func parse(_ input: inout Input) throws(Failure) -> Output {
+            let start = input.checkpoint
+            guard let high = input.next() else {
+                throw .empty
             }
-
-            public borrowing func serialize(_ output: Output, into buffer: inout Buffer) throws(Failure) {
-                RFC_768.Checksum.serialize(output, into: &buffer)
+            guard let low = input.next() else {
+                input.seek(to: start)
+                throw .insufficientBytes
             }
+            return RFC_768.Checksum(rawValue: UInt16(high.bitPattern) << 8 | UInt16(low.bitPattern))
         }
 
-        public static var coder: Coder<ArraySlice<Byte>, [Byte]> { .init() }
-    }
+        public borrowing func serialize(_ output: Output, into buffer: inout Buffer) throws(Failure) {
+            RFC_768.Checksum.serialize(output, into: &buffer)
+        }
+}
 #endif
diff --git a/Sources/RFC 768/Absorbed swift-rfc-768-coder/RFC_768.Datagram.Coder.swift b/Sources/RFC 768/Absorbed swift-rfc-768-coder/RFC_768.Datagram.Coder.swift
