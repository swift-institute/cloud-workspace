From 9de1db3b52c906d3961b3dcd381b1fea294eeaf3 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 19:34:01 +0000
Subject: [PATCH 1/3] compound suite name: narrative suites move into the test
 module's namespace `<File> Tests` (#239's layout), nested suites into
 extension <Path>.<Parent> (overnight/compound-suites.py); parse-checked;
 builds pending (coenttb/work#242)

---
 .../Foldable Macro Tests/Boundary Tests.swift | 24 +++++++++++--------
 1 file changed, 14 insertions(+), 10 deletions(-)

diff --git a/Tests/Foldable Macro Tests/Boundary Tests.swift b/Tests/Foldable Macro Tests/Boundary Tests.swift
index 430c9a4..37a98ec 100644
--- a/Tests/Foldable Macro Tests/Boundary Tests.swift	
+++ b/Tests/Foldable Macro Tests/Boundary Tests.swift	
@@ -8,16 +8,20 @@ private enum Few<Element> {
     case two(Element, Element)
 }
 
-@Suite
-struct `Foldable boundaries` {
-    @Test
-    func `a case without elements returns the initial value`() {
-        #expect(Few<String>.none.fold("start", +) == "start")
-    }
+enum `Boundary Tests` {}
+
+extension `Boundary Tests` {
+    @Suite
+    struct `Foldable boundaries` {
+        @Test
+        func `a case without elements returns the initial value`() {
+            #expect(Few<String>.none.fold("start", +) == "start")
+        }
 
-    @Test
-    func `every element of a case is folded in order`() {
-        #expect(Few.one("A").fold("", +) == "A")
-        #expect(Few.two("A", "B").fold("", +) == "AB")
+        @Test
+        func `every element of a case is folded in order`() {
+            #expect(Few.one("A").fold("", +) == "A")
+            #expect(Few.two("A", "B").fold("", +) == "AB")
+        }
     }
 }
