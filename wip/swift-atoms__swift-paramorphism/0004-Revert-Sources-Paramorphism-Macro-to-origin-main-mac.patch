From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 07:06:19 +0000
Subject: [PATCH 4/4] Revert Sources/Paramorphism Macro to origin/main: macro
 targets aren't type-checkable outside the build (coenttb/work#242)

---
 Sources/Paramorphism Macro/Paramorphism.swift | 2 +-
 Sources/Paramorphism Macro/exports.swift      | 1 -
 2 files changed, 1 insertion(+), 2 deletions(-)
 delete mode 100644 Sources/Paramorphism Macro/exports.swift

diff --git a/Sources/Paramorphism Macro/Paramorphism.swift b/Sources/Paramorphism Macro/Paramorphism.swift
index c75043f..718e959 100644
--- a/Sources/Paramorphism Macro/Paramorphism.swift	
+++ b/Sources/Paramorphism Macro/Paramorphism.swift	
@@ -1,3 +1,3 @@
-import Product
+@_exported import Product
 @attached(member, names: arbitrary)
 public macro Paramorphism() = #externalMacro(module: "Paramorphism_Macro_Plugin", type: "Macro")
diff --git a/Sources/Paramorphism Macro/exports.swift b/Sources/Paramorphism Macro/exports.swift
deleted file mode 100644
index fd3bc8d..0000000
--- a/Sources/Paramorphism Macro/exports.swift	
+++ /dev/null
@@ -1 +0,0 @@
-@_exported public import Product
