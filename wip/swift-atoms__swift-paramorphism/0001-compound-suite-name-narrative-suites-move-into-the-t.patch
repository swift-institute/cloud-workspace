Subject: [PATCH 1/4] compound suite name: narrative suites move into the test
 module's namespace `<File> Tests` (#239's layout), nested suites into
 extension <Path>.<Parent> (overnight/compound-suites.py); parse-checked;
 builds pending (coenttb/work#242)

---
 .../Boundary Tests.swift                      | 42 ++++++++++---------
 1 file changed, 23 insertions(+), 19 deletions(-)

diff --git a/Tests/Paramorphism Macro Tests/Boundary Tests.swift b/Tests/Paramorphism Macro Tests/Boundary Tests.swift
index 9da6094..4d7ede7 100644
--- a/Tests/Paramorphism Macro Tests/Boundary Tests.swift	
+++ b/Tests/Paramorphism Macro Tests/Boundary Tests.swift	
@@ -12,29 +12,33 @@ private indirect enum Count {
     case successor(Count)
 }
 
-@Suite
-struct `Paramorphism boundaries` {
-    @Test
-    func `the base case folds without a child`() {
-        let result = Count.zero.paramorphism { (layer: Count.Base<Product<Count, Int>>) -> Int in
-            switch layer {
-            case .zero: 0
-            case .successor(let child): child.values.1 + 1
+enum `Boundary Tests` {}
+
+extension `Boundary Tests` {
+    @Suite
+    struct `Paramorphism boundaries` {
+        @Test
+        func `the base case folds without a child`() {
+            let result = Count.zero.paramorphism { (layer: Count.Base<Product<Count, Int>>) -> Int in
+                switch layer {
+                case .zero: 0
+                case .successor(let child): child.values.1 + 1
+                }
             }
+            #expect(result == 0)
         }
-        #expect(result == 0)
-    }
 
-    @Test
-    func `each layer sees its original child next to the folded one`() {
-        let three = Count.successor(.successor(.successor(.zero)))
-        let childIsZero = three.paramorphism { (layer: Count.Base<Product<Count, [Bool]>>) -> [Bool] in
-            switch layer {
-            case .zero: []
-            case .successor(let child):
-                if case .zero = child.values.0 { child.values.1 + [true] } else { child.values.1 + [false] }
+        @Test
+        func `each layer sees its original child next to the folded one`() {
+            let three = Count.successor(.successor(.successor(.zero)))
+            let childIsZero = three.paramorphism { (layer: Count.Base<Product<Count, [Bool]>>) -> [Bool] in
+                switch layer {
+                case .zero: []
+                case .successor(let child):
+                    if case .zero = child.values.0 { child.values.1 + [true] } else { child.values.1 + [false] }
+                }
             }
+            #expect(childIsZero == [true, false, false])
         }
-        #expect(childIsZero == [true, false, false])
     }
 }
