Subject: [PATCH 2/3] exported import, architecture import boundary: re-exports
 moved into the target's root exports.swift (re-export set unchanged;
 type-check follows; Linux x86_64, Swift 6.4.2) (coenttb/work#242)

---
 Sources/Birecursive Macro/Birecursive.swift | 6 +++---
 Sources/Birecursive Macro/exports.swift     | 3 +++
 2 files changed, 6 insertions(+), 3 deletions(-)
 create mode 100644 Sources/Birecursive Macro/exports.swift

diff --git a/Sources/Birecursive Macro/Birecursive.swift b/Sources/Birecursive Macro/Birecursive.swift
index 98f42c6..438567d 100644
--- a/Sources/Birecursive Macro/Birecursive.swift	
+++ b/Sources/Birecursive Macro/Birecursive.swift	
@@ -1,6 +1,6 @@
-@_exported import Corecursive_Macro
-@_exported import Functor_Base_Macro
-@_exported import Recursive_Macro
+public import Corecursive_Macro
+public import Functor_Base_Macro
+public import Recursive_Macro
 
 @attached(memberAttribute)
 public macro Birecursive() = #externalMacro(module: "Birecursive_Macro_Plugin", type: "Macro")
diff --git a/Sources/Birecursive Macro/exports.swift b/Sources/Birecursive Macro/exports.swift
new file mode 100644
index 0000000..89fddd3
--- /dev/null
+++ b/Sources/Birecursive Macro/exports.swift	
@@ -0,0 +1,3 @@
+@_exported public import Corecursive_Macro
+@_exported public import Functor_Base_Macro
+@_exported public import Recursive_Macro
