Subject: [PATCH 1/3] compound suite name: narrative suites move into the test
 module's namespace `<File> Tests` (#239's layout), nested suites into
 extension <Path>.<Parent> (overnight/compound-suites.py); parse-checked;
 builds pending (coenttb/work#242)

---
 .../Boundary Tests.swift                      | 32 +++++++++++--------
 1 file changed, 18 insertions(+), 14 deletions(-)

diff --git a/Tests/Birecursive Macro Tests/Boundary Tests.swift b/Tests/Birecursive Macro Tests/Boundary Tests.swift
index 07a32cc..7a8f35b 100644
--- a/Tests/Birecursive Macro Tests/Boundary Tests.swift	
+++ b/Tests/Birecursive Macro Tests/Boundary Tests.swift	
@@ -11,22 +11,26 @@ private enum Nested {
     }
 }
 
-@Suite
-struct `Birecursive boundaries` {
-    @Test
-    func `the base case round trips through project and embed`() {
-        guard case .zero = Nested.Count.embed(Nested.Count.zero.project()) else {
-            Issue.record("Expected the base case back")
-            return
+enum `Boundary Tests` {}
+
+extension `Boundary Tests` {
+    @Suite
+    struct `Birecursive boundaries` {
+        @Test
+        func `the base case round trips through project and embed`() {
+            guard case .zero = Nested.Count.embed(Nested.Count.zero.project()) else {
+                Issue.record("Expected the base case back")
+                return
+            }
         }
-    }
 
-    @Test
-    func `a deep value keeps its outer layer through project and embed`() {
-        let deep = (0..<100).reduce(Nested.Count.zero) { value, _ in .successor(value) }
-        guard case .successor(.successor(_)) = Nested.Count.embed(deep.project()) else {
-            Issue.record("Expected the outer layers back")
-            return
+        @Test
+        func `a deep value keeps its outer layer through project and embed`() {
+            let deep = (0..<100).reduce(Nested.Count.zero) { value, _ in .successor(value) }
+            guard case .successor(.successor(_)) = Nested.Count.embed(deep.project()) else {
+                Issue.record("Expected the outer layers back")
+                return
+            }
         }
     }
 }
