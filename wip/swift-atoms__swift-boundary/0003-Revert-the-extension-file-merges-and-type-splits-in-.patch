Subject: [PATCH 3/4] Revert the extension-file merges and type splits in
 directories where a merged file brought its conditional imports mid-file
 (coenttb/work#242)

---
 Sources/Boundary/Boundary.Corner.swift        | 27 -----------------
 Sources/Boundary/Boundary.Edge.swift          | 29 -------------------
 .../Facet/Boundary.Edge+Facet.swift           | 28 ++++++++++++++++++
 .../Orthant/Boundary.Corner+Orthant.swift     | 26 +++++++++++++++++
 4 files changed, 54 insertions(+), 56 deletions(-)
 create mode 100644 Sources/Boundary/Integrations/Facet/Boundary.Edge+Facet.swift
 create mode 100644 Sources/Boundary/Integrations/Orthant/Boundary.Corner+Orthant.swift

diff --git a/Sources/Boundary/Boundary.Corner.swift b/Sources/Boundary/Boundary.Corner.swift
index 2dbace2..29a32b5 100644
--- a/Sources/Boundary/Boundary.Corner.swift
+++ b/Sources/Boundary/Boundary.Corner.swift
@@ -68,30 +68,3 @@ extension Boundary.Corner {
 #if !hasFeature(Embedded)
     extension Boundary.Corner: Swift::Codable {}
 #endif
-
-#if Orthant
-    public import Orthant
-
-    extension Boundary.Corner {
-
-        @inlinable
-        public var orthant: Orthant<2> {
-            switch self {
-            case .topLeft: Orthant { $0 == 0 ? .negative : .positive }
-            case .topRight: Orthant { _ in .positive }
-            case .bottomLeft: Orthant { _ in .negative }
-            case .bottomRight: Orthant { $0 == 0 ? .positive : .negative }
-            }
-        }
-
-        @inlinable
-        public init(orthant: Orthant<2>) {
-            switch (orthant.directions[0], orthant.directions[1]) {
-            case (.negative, .positive): self = .topLeft
-            case (.positive, .positive): self = .topRight
-            case (.negative, .negative): self = .bottomLeft
-            default: self = .bottomRight
-            }
-        }
-    }
-#endif
diff --git a/Sources/Boundary/Boundary.Edge.swift b/Sources/Boundary/Boundary.Edge.swift
index 3e2e06f..3b4364e 100644
--- a/Sources/Boundary/Boundary.Edge.swift
+++ b/Sources/Boundary/Boundary.Edge.swift
@@ -62,32 +62,3 @@ extension Boundary.Edge {
 #if !hasFeature(Embedded)
     extension Boundary.Edge: Swift::Codable {}
 #endif
-
-#if Facet
-    public import Axis
-    public import Direction
-    public import Facet
-
-    extension Boundary.Edge {
-
-        @inlinable
-        public var facet: Facet<2> {
-            switch self {
-            case .top: Facet(axis: .secondary, direction: .positive)
-            case .left: Facet(axis: .primary, direction: .negative)
-            case .bottom: Facet(axis: .secondary, direction: .negative)
-            case .right: Facet(axis: .primary, direction: .positive)
-            }
-        }
-
-        @inlinable
-        public init(facet: Facet<2>) {
-            switch (facet.axis.underlying, facet.direction) {
-            case (1, .positive): self = .top
-            case (0, .negative): self = .left
-            case (1, .negative): self = .bottom
-            default: self = .right
-            }
-        }
-    }
-#endif
diff --git a/Sources/Boundary/Integrations/Facet/Boundary.Edge+Facet.swift b/Sources/Boundary/Integrations/Facet/Boundary.Edge+Facet.swift
new file mode 100644
index 0000000..445a2f3
--- /dev/null
+++ b/Sources/Boundary/Integrations/Facet/Boundary.Edge+Facet.swift
@@ -0,0 +1,28 @@
+#if Facet
+    public import Axis
+    public import Direction
+    public import Facet
+
+    extension Boundary.Edge {
+
+        @inlinable
+        public var facet: Facet<2> {
+            switch self {
+            case .top: Facet(axis: .secondary, direction: .positive)
+            case .left: Facet(axis: .primary, direction: .negative)
+            case .bottom: Facet(axis: .secondary, direction: .negative)
+            case .right: Facet(axis: .primary, direction: .positive)
+            }
+        }
+
+        @inlinable
+        public init(facet: Facet<2>) {
+            switch (facet.axis.underlying, facet.direction) {
+            case (1, .positive): self = .top
+            case (0, .negative): self = .left
+            case (1, .negative): self = .bottom
+            default: self = .right
+            }
+        }
+    }
+#endif
diff --git a/Sources/Boundary/Integrations/Orthant/Boundary.Corner+Orthant.swift b/Sources/Boundary/Integrations/Orthant/Boundary.Corner+Orthant.swift
new file mode 100644
index 0000000..f3f36e1
--- /dev/null
+++ b/Sources/Boundary/Integrations/Orthant/Boundary.Corner+Orthant.swift
@@ -0,0 +1,26 @@
+#if Orthant
+    public import Orthant
+
+    extension Boundary.Corner {
+
+        @inlinable
+        public var orthant: Orthant<2> {
+            switch self {
+            case .topLeft: Orthant { $0 == 0 ? .negative : .positive }
+            case .topRight: Orthant { _ in .positive }
+            case .bottomLeft: Orthant { _ in .negative }
+            case .bottomRight: Orthant { $0 == 0 ? .positive : .negative }
+            }
+        }
+
+        @inlinable
+        public init(orthant: Orthant<2>) {
+            switch (orthant.directions[0], orthant.directions[1]) {
+            case (.negative, .positive): self = .topLeft
+            case (.positive, .positive): self = .topRight
+            case (.negative, .negative): self = .bottomLeft
+            default: self = .bottomRight
+            }
+        }
+    }
+#endif
