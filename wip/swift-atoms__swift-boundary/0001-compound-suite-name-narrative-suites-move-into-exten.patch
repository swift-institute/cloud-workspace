From cf0033416d6af3bcb4aff73c386f6f3a6225ed93 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 18:48:50 +0000
Subject: [PATCH] compound suite name: narrative suites move into extension
 <Type> named after their test file, nested suites into extension
 <Type>.<Parent> (overnight/compound-suites.py); parse-checked; builds pending
 (coenttb/work#242)

---
 .../Boundary.Edge+Facet Tests.swift           | 40 +++++++++--------
 .../Boundary.Corner+Orthant Tests.swift       | 44 ++++++++++---------
 Tests/Boundary Tests/Boundary Tests.swift     | 20 +++++----
 3 files changed, 55 insertions(+), 49 deletions(-)

diff --git a/Tests/Boundary Facet Tests/Boundary.Edge+Facet Tests.swift b/Tests/Boundary Facet Tests/Boundary.Edge+Facet Tests.swift
index 86665a6..b3bfba3 100644
--- a/Tests/Boundary Facet Tests/Boundary.Edge+Facet Tests.swift	
+++ b/Tests/Boundary Facet Tests/Boundary.Edge+Facet Tests.swift	
@@ -4,29 +4,31 @@
     import Direction
     import Testing
 
-    @Suite
-    struct `Boundary.Edge Facet projection` {
-        @Suite struct Unit {
-            @Test
-            func `facet maps each edge to its box face`() {
-                #expect(Boundary.Edge.top.facet == Facet<2>(axis: .secondary, direction: .positive))
-                #expect(Boundary.Edge.right.facet == Facet<2>(axis: .primary, direction: .positive))
-            }
+extension Boundary.Edge {
+        @Suite
+        struct `Boundary.Edge Facet projection` {
+            @Suite struct Unit {
+                @Test
+                func `facet maps each edge to its box face`() {
+                    #expect(Boundary.Edge.top.facet == Facet<2>(axis: .secondary, direction: .positive))
+                    #expect(Boundary.Edge.right.facet == Facet<2>(axis: .primary, direction: .positive))
+                }
 
-            @Test
-            func `projection round-trips`() {
-                for edge in Boundary.Edge.allCases {
-                    #expect(Boundary.Edge(facet: edge.facet) == edge)
+                @Test
+                func `projection round-trips`() {
+                    for edge in Boundary.Edge.allCases {
+                        #expect(Boundary.Edge(facet: edge.facet) == edge)
+                    }
                 }
-            }
 
-            @Test
-            func `opposite edge is opposite facet`() {
-                for edge in Boundary.Edge.allCases {
-                    #expect(edge.opposite.facet == edge.facet.opposite)
+                @Test
+                func `opposite edge is opposite facet`() {
+                    for edge in Boundary.Edge.allCases {
+                        #expect(edge.opposite.facet == edge.facet.opposite)
+                    }
                 }
             }
-        }
 
-    }
+        }
+}
 #endif
diff --git a/Tests/Boundary Orthant Tests/Boundary.Corner+Orthant Tests.swift b/Tests/Boundary Orthant Tests/Boundary.Corner+Orthant Tests.swift
index 3a57d14..732ddaa 100644
--- a/Tests/Boundary Orthant Tests/Boundary.Corner+Orthant Tests.swift	
+++ b/Tests/Boundary Orthant Tests/Boundary.Corner+Orthant Tests.swift	
@@ -2,31 +2,33 @@
     import Boundary
     import Testing
 
-    @Suite
-    struct `Boundary.Corner Orthant projection` {
-        @Suite struct Unit {
-            @Test
-            func `corner maps to its orthant signs`() {
-                #expect(Boundary.Corner.topRight.orthant == Orthant<2>(repeating: .positive))
-                #expect(Boundary.Corner.bottomLeft.orthant == Orthant<2>(repeating: .negative))
-                #expect(Boundary.Corner.topLeft.orthant.directions[0] == .negative)
-                #expect(Boundary.Corner.topLeft.orthant.directions[1] == .positive)
-            }
+extension Boundary.Corner {
+        @Suite
+        struct `Boundary.Corner Orthant projection` {
+            @Suite struct Unit {
+                @Test
+                func `corner maps to its orthant signs`() {
+                    #expect(Boundary.Corner.topRight.orthant == Orthant<2>(repeating: .positive))
+                    #expect(Boundary.Corner.bottomLeft.orthant == Orthant<2>(repeating: .negative))
+                    #expect(Boundary.Corner.topLeft.orthant.directions[0] == .negative)
+                    #expect(Boundary.Corner.topLeft.orthant.directions[1] == .positive)
+                }
 
-            @Test
-            func `projection round-trips`() {
-                for corner in Boundary.Corner.allCases {
-                    #expect(Boundary.Corner(orthant: corner.orthant) == corner)
+                @Test
+                func `projection round-trips`() {
+                    for corner in Boundary.Corner.allCases {
+                        #expect(Boundary.Corner(orthant: corner.orthant) == corner)
+                    }
                 }
-            }
 
-            @Test
-            func `opposite corner is opposite orthant`() {
-                for corner in Boundary.Corner.allCases {
-                    #expect(corner.opposite.orthant == corner.orthant.opposite)
+                @Test
+                func `opposite corner is opposite orthant`() {
+                    for corner in Boundary.Corner.allCases {
+                        #expect(corner.opposite.orthant == corner.orthant.opposite)
+                    }
                 }
             }
-        }
 
-    }
+        }
+}
 #endif
diff --git a/Tests/Boundary Tests/Boundary Tests.swift b/Tests/Boundary Tests/Boundary Tests.swift
index 3a7d3db..b87e4c8 100644
--- a/Tests/Boundary Tests/Boundary Tests.swift	
+++ b/Tests/Boundary Tests/Boundary Tests.swift	
@@ -1,15 +1,17 @@
 import Boundary
 import Testing
 
-@Suite
-struct `Boundary edges preserve their structure under opposition` {
-    @Test
-    func `opposites are involutive`() {
-        for edge in Boundary.Edge.allCases {
-            #expect(edge.opposite.opposite == edge)
-        }
-        for corner in Boundary.Corner.allCases {
-            #expect(corner.opposite.opposite == corner)
+extension Boundary {
+    @Suite
+    struct `Boundary edges preserve their structure under opposition` {
+        @Test
+        func `opposites are involutive`() {
+            for edge in Boundary.Edge.allCases {
+                #expect(edge.opposite.opposite == edge)
+            }
+            for corner in Boundary.Corner.allCases {
+                #expect(corner.opposite.opposite == corner)
+            }
         }
     }
 }
