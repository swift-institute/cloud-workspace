From d6b4cdf964257b6a615ccf8769fe1d066c546c75 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 23:28:21 +0000
Subject: [PATCH 5/8] minimal type body: more non-stored members move into
 extensions of their type (overnight/minimal-bodies.py); type-checked, failing
 files left out (coenttb/work#242)

---
 Sources/Orthant/Orthant.Enumeration.swift | 27 ++++++++++++-----------
 1 file changed, 14 insertions(+), 13 deletions(-)

diff --git a/Sources/Orthant/Orthant.Enumeration.swift b/Sources/Orthant/Orthant.Enumeration.swift
index 63cddf5..78042b9 100644
--- a/Sources/Orthant/Orthant.Enumeration.swift
+++ b/Sources/Orthant/Orthant.Enumeration.swift
@@ -9,19 +9,6 @@ extension Orthant {
         init(count: Cardinal) {
             self.count = count
         }
-
-        public struct Iterator: Sendable {
-            @usableFromInline
-            var current: UInt = 0
-
-            @usableFromInline
-            let end: UInt
-
-            @usableFromInline
-            init(end: UInt) {
-                self.end = end
-            }
-        }
     }
 
     @inlinable
@@ -33,7 +20,21 @@ extension Orthant {
 }
 
 extension Orthant.Enumeration {
+    public struct Iterator: Sendable {
+        @usableFromInline
+        var current: UInt = 0
+
+        @usableFromInline
+        let end: UInt
 
+        @usableFromInline
+        init(end: UInt) {
+            self.end = end
+        }
+    }
+}
+
+extension Orthant.Enumeration {
     @inlinable
     public func element(at ordinal: Ordinal) -> Orthant? {
         guard ordinal.rawValue < count.rawValue else { return nil }
-- 
