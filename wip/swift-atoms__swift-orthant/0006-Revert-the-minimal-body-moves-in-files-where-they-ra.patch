From 2aa7c1bbe65804bb2ad6828e77be22f2ebdcdba9 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 23:31:24 +0000
Subject: [PATCH 6/8] Revert the minimal-body moves in files where they raised
 a rule over its ratchet limit (coenttb/work#242)

---
 Sources/Orthant/Orthant.Enumeration.swift | 34 +++++++++++++----------
 1 file changed, 20 insertions(+), 14 deletions(-)

diff --git a/Sources/Orthant/Orthant.Enumeration.swift b/Sources/Orthant/Orthant.Enumeration.swift
index 78042b9..e94d8d8 100644
--- a/Sources/Orthant/Orthant.Enumeration.swift
+++ b/Sources/Orthant/Orthant.Enumeration.swift
@@ -9,6 +9,19 @@ extension Orthant {
         init(count: Cardinal) {
             self.count = count
         }
+
+        public struct Iterator: Sendable {
+            @usableFromInline
+            var current: UInt = 0
+
+            @usableFromInline
+            let end: UInt
+
+            @usableFromInline
+            init(end: UInt) {
+                self.end = end
+            }
+        }
     }
 
     @inlinable
@@ -20,24 +33,17 @@ extension Orthant {
 }
 
 extension Orthant.Enumeration {
-    public struct Iterator: Sendable {
-        @usableFromInline
-        var current: UInt = 0
 
-        @usableFromInline
-        let end: UInt
-
-        @usableFromInline
-        init(end: UInt) {
-            self.end = end
-        }
-    }
-}
-
-extension Orthant.Enumeration {
     @inlinable
     public func element(at ordinal: Ordinal) -> Orthant? {
         guard ordinal.rawValue < count.rawValue else { return nil }
         return Orthant(_ordinal: ordinal)
     }
 }
+
+extension Orthant.Enumeration: Swift::Sequence {
+    @inlinable
+    public func makeIterator() -> Iterator {
+        Iterator(end: count.rawValue)
+    }
+}
