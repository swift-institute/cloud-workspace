From e65f3414982a598ef696a9c24526ee0aad1f3a3e Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:27:41 +0000
Subject: [PATCH 09/12] minimal type body: more non-stored members moved into
 an extension of their type (batch 10; type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 Sources/Orthant/Orthant.Enumeration.swift | 27 ++++++++++++-----------
 1 file changed, 14 insertions(+), 13 deletions(-)

diff --git a/Sources/Orthant/Orthant.Enumeration.swift b/Sources/Orthant/Orthant.Enumeration.swift
index e94d8d8..2c30533 100644
--- a/Sources/Orthant/Orthant.Enumeration.swift
+++ b/Sources/Orthant/Orthant.Enumeration.swift
@@ -9,19 +9,6 @@ extension Orthant {
         init(count: Cardinal) {
             self.count = count
         }
-
-        public struct Iterator: Sendable {
-            @usableFromInline
-            var current: UInt = 0
-
-            @usableFromInline
-            let end: UInt
-
-            @usableFromInline
-            init(end: UInt) {
-                self.end = end
-            }
-        }
     }
 
     @inlinable
@@ -33,7 +20,21 @@ extension Orthant {
 }
 
 extension Orthant.Enumeration {
+    public struct Iterator: Sendable {
+        @usableFromInline
+        var current: UInt = 0
+
+        @usableFromInline
+        let end: UInt
 
+        @usableFromInline
+        init(end: UInt) {
+            self.end = end
+        }
+    }
+}
+
+extension Orthant.Enumeration {
     @inlinable
     public func element(at ordinal: Ordinal) -> Orthant? {
         guard ordinal.rawValue < count.rawValue else { return nil }
-- 
