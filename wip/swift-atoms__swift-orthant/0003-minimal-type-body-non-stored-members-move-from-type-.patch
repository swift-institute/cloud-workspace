From 9a6a596e68c81240f0da410f55d90bf5de7f006e Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 22:39:52 +0000
Subject: [PATCH 3/4] minimal type body: non-stored members move from type
 bodies into an extension of the type in the same file
 (overnight/minimal-bodies.py); type-checked against the root build,
 directories that failed or couldn't be checked left out (coenttb/work#242)

---
 Sources/Orthant/Orthant.Enumeration.swift | 27 ++++++++++++-----------
 1 file changed, 14 insertions(+), 13 deletions(-)

diff --git a/Sources/Orthant/Orthant.Enumeration.swift b/Sources/Orthant/Orthant.Enumeration.swift
index e94d8d8..2c30533 100644
--- a/Sources/Orthant/Orthant.Enumeration.swift
+++ b/Sources/Orthant/Orthant.Enumeration.swift
@@ -9,19 +9,6 @@ extension Orthant {
         init(count: Cardinal) {
             self.count = count
         }
-
-        public struct Iterator: Sendable {
-            @usableFromInline
-            var current: UInt = 0
-
-            @usableFromInline
-            let end: UInt
-
-            @usableFromInline
-            init(end: UInt) {
-                self.end = end
-            }
-        }
     }
 
     @inlinable
@@ -33,7 +20,21 @@ extension Orthant {
 }
 
 extension Orthant.Enumeration {
+    public struct Iterator: Sendable {
+        @usableFromInline
+        var current: UInt = 0
+
+        @usableFromInline
+        let end: UInt
 
+        @usableFromInline
+        init(end: UInt) {
+            self.end = end
+        }
+    }
+}
+
+extension Orthant.Enumeration {
     @inlinable
     public func element(at ordinal: Ordinal) -> Orthant? {
         guard ordinal.rawValue < count.rawValue else { return nil }
-- 
