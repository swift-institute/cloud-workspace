diff --git a/Sources/Orthant/Orthant+Ordinal.swift b/Sources/Orthant/Orthant+Ordinal.swift
new file mode 100644
index 0000000..b86d0ce
--- /dev/null
+++ b/Sources/Orthant/Orthant+Ordinal.swift
@@ -0,0 +1,45 @@
+public import Cardinal
+public import Direction
+public import Ordinal
+
+extension Orthant {
+    @inlinable
+    public static var count: Cardinal {
+        get throws(Error) {
+            guard N >= 0, N < UInt.bitWidth else { throw .countOverflow }
+            return Cardinal(UInt(1) << N)
+        }
+    }
+
+    @inlinable
+    public var ordinal: Ordinal {
+        get throws(Error) {
+            var bits: UInt = 0
+            for index in 0..<N where directions[index] == .negative {
+                guard index < UInt.bitWidth else { throw .ordinalOverflow }
+                bits |= UInt(1) << index
+            }
+            return Ordinal(bits)
+        }
+    }
+
+    @inlinable
+    public init(ordinal: Ordinal) throws(Error) {
+        if N < UInt.bitWidth {
+            guard ordinal.rawValue < UInt(1) << N else {
+                throw .ordinalOutOfBounds(ordinal)
+            }
+        }
+        self.init(_ordinal: ordinal)
+    }
+
+    @usableFromInline
+    init(_ordinal: Ordinal) {
+        let bits = _ordinal.rawValue
+        self.init(
+            InlineArray<N, Direction> { index in
+                index < UInt.bitWidth && bits & (UInt(1) << index) != 0 ? .negative : .positive
+            }
+        )
+    }
+}
diff --git a/Sources/Orthant/Orthant+Swift.Codable.swift b/Sources/Orthant/Orthant+Swift.Codable.swift
new file mode 100644
index 0000000..e88fe94
--- /dev/null
+++ b/Sources/Orthant/Orthant+Swift.Codable.swift
@@ -0,0 +1,23 @@
+import Direction
+
+#if !hasFeature(Embedded)
+    extension Orthant: Swift::Codable {
+        @inlinable
+        public init(from decoder: any Decoder) throws {
+            var container = try decoder.unkeyedContainer()
+            self.init(try InlineArray<N, Direction> { _ in try container.decode(Direction.self) })
+            guard container.isAtEnd else {
+                throw DecodingError.dataCorruptedError(
+                    in: container,
+                    debugDescription: "Expected exactly \(N) orthant directions"
+                )
+            }
+        }
+
+        @inlinable
+        public func encode(to encoder: any Encoder) throws {
+            var container = encoder.unkeyedContainer()
+            for index in 0..<N { try container.encode(directions[index]) }
+        }
+    }
+#endif
