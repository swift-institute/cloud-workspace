From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:06:13 +0000
Subject: [PATCH 2/2] module selector spelling: Module.Name written
 Module::Name (type-check follows; Linux x86_64, Swift 6.4.2)
 (coenttb/work#242)

---
 .../CSS HTML Layout Rendering/HTML.Layout.Grid.Lazy.swift   | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/Sources/CSS HTML Layout Rendering/HTML.Layout.Grid.Lazy.swift b/Sources/CSS HTML Layout Rendering/HTML.Layout.Grid.Lazy.swift
index d6e29df..56f1188 100644
--- a/Sources/CSS HTML Layout Rendering/HTML.Layout.Grid.Lazy.swift	
+++ b/Sources/CSS HTML Layout Rendering/HTML.Layout.Grid.Lazy.swift	
@@ -39,7 +39,7 @@ extension HTML.Layout.Grid {
             @HTML.Builder content: () -> Content
         ) {
             var dict = Breakpoints()
-            dict.set(nil as CSS_Standard.Media?, columns)
+            dict.set(nil as CSS_Standard::Media?, columns)
             self.columns = dict
             self.horizontalSpacing = horizontalSpacing
             self.verticalSpacing = verticalSpacing
@@ -57,8 +57,8 @@ extension HTML.Layout.Grid.Lazy {
 
     public typealias Breakpoints = __DictionaryOrdered<
         Ownership.Shared<
-            Hash.Entry<CSS_Standard.Media?, Columns>,
-            Hash.Indexed<Buffer<Storage<Memory.Allocator<Memory.Heap>>.Contiguous<Hash.Entry<CSS_Standard.Media?, Columns>>>.Linear>
+            Hash.Entry<CSS_Standard::Media?, Columns>,
+            Hash.Indexed<Buffer<Storage<Memory.Allocator<Memory.Heap>>.Contiguous<Hash.Entry<CSS_Standard::Media?, Columns>>>.Linear>
         >
     >
 
