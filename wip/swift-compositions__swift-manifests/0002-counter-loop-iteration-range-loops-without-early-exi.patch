From 6d4267ed4da7143aca1553236e86eeb7d01be4dc Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:34:03 +0000
Subject: [PATCH 2/3] counter loop iteration: range loops without early exit
 written as forEach (type-check follows; Linux x86_64, Swift 6.4.2)
 (coenttb/work#242)

---
 .../Manifest.Executable.Materializer.swift                  | 2 +-
 Sources/Manifest Loader/Manifest.Load.swift                 | 2 +-
 Sources/Manifest Resolver/Manifest.Resolver.swift           | 6 +++---
 3 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/Sources/Manifest Executable/Manifest.Executable.Materializer.swift b/Sources/Manifest Executable/Manifest.Executable.Materializer.swift
index 8ed3ae5..ba92d9c 100644
--- a/Sources/Manifest Executable/Manifest.Executable.Materializer.swift	
+++ b/Sources/Manifest Executable/Manifest.Executable.Materializer.swift	
@@ -276,7 +276,7 @@ extension Manifest.Executable.Materializer {
             bytes = try File(path).read.full { (span: Swift.Span<Byte>) -> [Byte] in
                 var array: [Byte] = []
                 array.reserveCapacity(span.count)
-                for i in 0..<span.count {
+                (0..<span.count).forEach { i in
                     array.append(span[i])
                 }
                 return array
diff --git a/Sources/Manifest Loader/Manifest.Load.swift b/Sources/Manifest Loader/Manifest.Load.swift
index 774e9da..4a99836 100644
--- a/Sources/Manifest Loader/Manifest.Load.swift	
+++ b/Sources/Manifest Loader/Manifest.Load.swift	
@@ -140,7 +140,7 @@ extension Manifest {
             bytes = try File(path).read.full { (span: Swift.Span<Byte>) -> [Byte] in
                 var array: [Byte] = []
                 array.reserveCapacity(span.count)
-                for i in 0..<span.count {
+                (0..<span.count).forEach { i in
                     array.append(span[i])
                 }
                 return array
diff --git a/Sources/Manifest Resolver/Manifest.Resolver.swift b/Sources/Manifest Resolver/Manifest.Resolver.swift
index 4288048..d6e5d6c 100644
--- a/Sources/Manifest Resolver/Manifest.Resolver.swift	
+++ b/Sources/Manifest Resolver/Manifest.Resolver.swift	
@@ -84,7 +84,7 @@ extension Manifest.Resolver {
                 (span: Swift.Span<Byte>) -> [Byte] in
                 var array: [Byte] = []
                 array.reserveCapacity(span.count)
-                for i in 0..<span.count { array.append(span[i]) }
+                (0..<span.count).forEach { i in array.append(span[i]) }
                 return array
             }
             return Swift.String(decoding: bytes, as: UTF8.self)
@@ -229,7 +229,7 @@ extension Manifest.Resolver {
                 (span: Swift.Span<Byte>) -> [Byte] in
                 var array: [Byte] = []
                 array.reserveCapacity(span.count)
-                for i in 0..<span.count { array.append(span[i]) }
+                (0..<span.count).forEach { i in array.append(span[i]) }
                 return array
             }
             return Swift.String(decoding: bytes, as: UTF8.self)
@@ -293,7 +293,7 @@ extension Manifest.Resolver {
                 (span: Swift.Span<Byte>) -> [Byte] in
                 var array: [Byte] = []
                 array.reserveCapacity(span.count)
-                for i in 0..<span.count { array.append(span[i]) }
+                (0..<span.count).forEach { i in array.append(span[i]) }
                 return array
             }
             content = Swift.String(decoding: bytes, as: UTF8.self)
