From 9a7d87cb8afcdbafc310ce51f3689d76b302c1bf Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 19:34:19 +0000
Subject: [PATCH] compound suite name: narrative suites move into the test
 module's namespace `<File> Tests` (#239's layout), nested suites into
 extension <Path>.<Parent> (overnight/compound-suites.py); parse-checked;
 builds pending (coenttb/work#242)

---
 ..._8824.GeneralizedTime Fraction Tests.swift | 44 ++++++------
 .../ISO_8824.ObjectIdentifier Dot Tests.swift | 34 ++++++----
 .../ISO 8824 Tests/Time Boundary Tests.swift  | 68 ++++++++++---------
 3 files changed, 79 insertions(+), 67 deletions(-)

diff --git a/Tests/ISO 8824 Tests/ISO_8824.GeneralizedTime Fraction Tests.swift b/Tests/ISO 8824 Tests/ISO_8824.GeneralizedTime Fraction Tests.swift
index 2bd2f2f..3fd9001 100644
--- a/Tests/ISO 8824 Tests/ISO_8824.GeneralizedTime Fraction Tests.swift	
+++ b/Tests/ISO 8824 Tests/ISO_8824.GeneralizedTime Fraction Tests.swift	
@@ -2,34 +2,38 @@ import Testing
 
 @testable import ISO_8824
 
-@Suite
-struct `Generalized time small fractions` {
-    @Test(arguments: [(0.00001, "00001"), (0.000015, "000015"), (0.5, "5"), (0.0001, "0001")])
-    func `a small fraction is written as plain digits`(_ fraction: Double, _ digits: String) throws {
-        let time = try ISO_8824.GeneralizedTime(
-            year: 2020,
-            month: 3,
-            day: 3,
-            hours: 3,
-            minutes: 3,
-            seconds: 3,
-            fractionalSeconds: fraction
-        )
-        #expect(String(decoding: time._rawFractionalSeconds, as: UTF8.self) == digits)
-    }
+enum `ISO_8824.GeneralizedTime Fraction Tests` {}
 
-    @Test(arguments: ["5e5", "5e-3", "+5", "5.5", "5 "])
-    func `raw fractional seconds must be digits`(_ raw: String) {
-        #expect(throws: ISO_8824.Error.self) {
-            try ISO_8824.GeneralizedTime(
+extension `ISO_8824.GeneralizedTime Fraction Tests` {
+    @Suite
+    struct `Generalized time small fractions` {
+        @Test(arguments: [(0.00001, "00001"), (0.000015, "000015"), (0.5, "5"), (0.0001, "0001")])
+        func `a small fraction is written as plain digits`(_ fraction: Double, _ digits: String) throws {
+            let time = try ISO_8824.GeneralizedTime(
                 year: 2020,
                 month: 3,
                 day: 3,
                 hours: 3,
                 minutes: 3,
                 seconds: 3,
-                rawFractionalSeconds: ArraySlice(raw.utf8)
+                fractionalSeconds: fraction
             )
+            #expect(String(decoding: time._rawFractionalSeconds, as: UTF8.self) == digits)
+        }
+
+        @Test(arguments: ["5e5", "5e-3", "+5", "5.5", "5 "])
+        func `raw fractional seconds must be digits`(_ raw: String) {
+            #expect(throws: ISO_8824.Error.self) {
+                try ISO_8824.GeneralizedTime(
+                    year: 2020,
+                    month: 3,
+                    day: 3,
+                    hours: 3,
+                    minutes: 3,
+                    seconds: 3,
+                    rawFractionalSeconds: ArraySlice(raw.utf8)
+                )
+            }
         }
     }
 }
diff --git a/Tests/ISO 8824 Tests/ISO_8824.ObjectIdentifier Dot Tests.swift b/Tests/ISO 8824 Tests/ISO_8824.ObjectIdentifier Dot Tests.swift
index be210ff..0c6e643 100644
--- a/Tests/ISO 8824 Tests/ISO_8824.ObjectIdentifier Dot Tests.swift	
+++ b/Tests/ISO 8824 Tests/ISO_8824.ObjectIdentifier Dot Tests.swift	
@@ -2,24 +2,28 @@ import Testing
 
 @testable import ISO_8824
 
-@Suite
-struct `Object identifier dot representation` {
-    @Test(arguments: ["1.+2.3", "1.2.-0", "+1.2", "1.2.+3"])
-    func `a signed arc is refused`(_ text: String) {
-        #expect(throws: ISO_8824.Error.self) {
-            try ISO_8824.ObjectIdentifier(dotRepresentation: text)
+enum `ISO_8824.ObjectIdentifier Dot Tests` {}
+
+extension `ISO_8824.ObjectIdentifier Dot Tests` {
+    @Suite
+    struct `Object identifier dot representation` {
+        @Test(arguments: ["1.+2.3", "1.2.-0", "+1.2", "1.2.+3"])
+        func `a signed arc is refused`(_ text: String) {
+            #expect(throws: ISO_8824.Error.self) {
+                try ISO_8824.ObjectIdentifier(dotRepresentation: text)
+            }
         }
-    }
 
-    @Test(arguments: ["1..2", "1.2.", ".1.2", ""])
-    func `an empty arc is refused`(_ text: String) {
-        #expect(throws: ISO_8824.Error.self) {
-            try ISO_8824.ObjectIdentifier(dotRepresentation: text)
+        @Test(arguments: ["1..2", "1.2.", ".1.2", ""])
+        func `an empty arc is refused`(_ text: String) {
+            #expect(throws: ISO_8824.Error.self) {
+                try ISO_8824.ObjectIdentifier(dotRepresentation: text)
+            }
         }
-    }
 
-    @Test
-    func `a well-formed identifier parses`() throws {
-        _ = try ISO_8824.ObjectIdentifier(dotRepresentation: "1.2.840.113549.1.1.11")
+        @Test
+        func `a well-formed identifier parses`() throws {
+            _ = try ISO_8824.ObjectIdentifier(dotRepresentation: "1.2.840.113549.1.1.11")
+        }
     }
 }
diff --git a/Tests/ISO 8824 Tests/Time Boundary Tests.swift b/Tests/ISO 8824 Tests/Time Boundary Tests.swift
index 2e73722..9d8b324 100644
--- a/Tests/ISO 8824 Tests/Time Boundary Tests.swift	
+++ b/Tests/ISO 8824 Tests/Time Boundary Tests.swift	
@@ -1,41 +1,45 @@
 import ISO_8824
 import Testing
 
-@Suite
-struct `ASN.1 time boundaries` {
-    private func utc(_ year: Int, _ month: Int = 1, _ day: Int = 1, _ h: Int = 0, _ m: Int = 0, _ s: Int = 0) throws(ISO_8824.Error) -> ISO_8824.UTCTime {
-        try ISO_8824.UTCTime(year: year, month: month, day: day, hours: h, minutes: m, seconds: s)
-    }
+enum `Time Boundary Tests` {}
 
-    private func generalized(_ year: Int, _ month: Int, _ day: Int) throws(ISO_8824.Error) -> ISO_8824.GeneralizedTime {
-        try ISO_8824.GeneralizedTime(year: year, month: month, day: day, hours: 0, minutes: 0, seconds: 0, fractionalSeconds: 0)
-    }
+extension `Time Boundary Tests` {
+    @Suite
+    struct `ASN.1 time boundaries` {
+        private func utc(_ year: Int, _ month: Int = 1, _ day: Int = 1, _ h: Int = 0, _ m: Int = 0, _ s: Int = 0) throws(ISO_8824.Error) -> ISO_8824.UTCTime {
+            try ISO_8824.UTCTime(year: year, month: month, day: day, hours: h, minutes: m, seconds: s)
+        }
 
-    @Test
-    func `UTCTime accepts exactly 1950 through 2049`() throws {
-        _ = try utc(1950)
-        _ = try utc(2049, 12, 31, 23, 59, 59)
-        #expect(throws: ISO_8824.Error.self) { try utc(1949, 12, 31, 23, 59, 59) }
-        #expect(throws: ISO_8824.Error.self) { try utc(2050) }
-    }
+        private func generalized(_ year: Int, _ month: Int, _ day: Int) throws(ISO_8824.Error) -> ISO_8824.GeneralizedTime {
+            try ISO_8824.GeneralizedTime(year: year, month: month, day: day, hours: 0, minutes: 0, seconds: 0, fractionalSeconds: 0)
+        }
 
-    @Test
-    func `February 29 follows the Gregorian leap rules`() throws {
-        _ = try generalized(2000, 2, 29)
-        _ = try generalized(2024, 2, 29)
-        #expect(throws: ISO_8824.Error.self) { try generalized(1900, 2, 29) }
-        #expect(throws: ISO_8824.Error.self) { try generalized(2100, 2, 29) }
-        #expect(throws: ISO_8824.Error.self) { try generalized(2023, 2, 29) }
-    }
+        @Test
+        func `UTCTime accepts exactly 1950 through 2049`() throws {
+            _ = try utc(1950)
+            _ = try utc(2049, 12, 31, 23, 59, 59)
+            #expect(throws: ISO_8824.Error.self) { try utc(1949, 12, 31, 23, 59, 59) }
+            #expect(throws: ISO_8824.Error.self) { try utc(2050) }
+        }
+
+        @Test
+        func `February 29 follows the Gregorian leap rules`() throws {
+            _ = try generalized(2000, 2, 29)
+            _ = try generalized(2024, 2, 29)
+            #expect(throws: ISO_8824.Error.self) { try generalized(1900, 2, 29) }
+            #expect(throws: ISO_8824.Error.self) { try generalized(2100, 2, 29) }
+            #expect(throws: ISO_8824.Error.self) { try generalized(2023, 2, 29) }
+        }
 
-    @Test
-    func `each component rejects the first value past its range`() {
-        #expect(throws: ISO_8824.Error.self) { try utc(2000, 0) }
-        #expect(throws: ISO_8824.Error.self) { try utc(2000, 13) }
-        #expect(throws: ISO_8824.Error.self) { try utc(2000, 4, 31) }
-        #expect(throws: ISO_8824.Error.self) { try utc(2000, 1, 0) }
-        #expect(throws: ISO_8824.Error.self) { try utc(2000, 1, 1, 24) }
-        #expect(throws: ISO_8824.Error.self) { try utc(2000, 1, 1, 0, 60) }
-        #expect(throws: ISO_8824.Error.self) { try utc(2000, 1, 1, 0, 0, -1) }
+        @Test
+        func `each component rejects the first value past its range`() {
+            #expect(throws: ISO_8824.Error.self) { try utc(2000, 0) }
+            #expect(throws: ISO_8824.Error.self) { try utc(2000, 13) }
+            #expect(throws: ISO_8824.Error.self) { try utc(2000, 4, 31) }
+            #expect(throws: ISO_8824.Error.self) { try utc(2000, 1, 0) }
+            #expect(throws: ISO_8824.Error.self) { try utc(2000, 1, 1, 24) }
+            #expect(throws: ISO_8824.Error.self) { try utc(2000, 1, 1, 0, 60) }
+            #expect(throws: ISO_8824.Error.self) { try utc(2000, 1, 1, 0, 0, -1) }
+        }
     }
 }
