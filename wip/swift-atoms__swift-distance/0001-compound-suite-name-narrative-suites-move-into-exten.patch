From b76d29976230cf60952f2a50fc085c27d89648b5 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 18:48:51 +0000
Subject: [PATCH] compound suite name: narrative suites move into extension
 <Type> named after their test file, nested suites into extension
 <Type>.<Parent> (overnight/compound-suites.py); parse-checked; builds pending
 (coenttb/work#242)

---
 Tests/Distance Tests/Distance Tests.swift | 34 ++++++++++++-----------
 1 file changed, 18 insertions(+), 16 deletions(-)

diff --git a/Tests/Distance Tests/Distance Tests.swift b/Tests/Distance Tests/Distance Tests.swift
index 34ef2f6..123beca 100644
--- a/Tests/Distance Tests/Distance Tests.swift	
+++ b/Tests/Distance Tests/Distance Tests.swift	
@@ -2,24 +2,26 @@ import Distance
 import Subtraction
 import Testing
 
-@Suite
-struct `Forward distance is checked and saturates for reversed bounds` {
+extension Distance {
+    @Suite
+    struct `Forward distance is checked and saturates for reversed bounds` {
 
-    @Test
-    func `forward distance is exact`() throws {
-        #expect(try Distance.exact(from: UInt(3), to: 8) == 5)
-        let report = Distance.reporting(from: UInt(3), to: 8)
-        #expect(report.value == 5)
-        #expect(!report.overflow)
-    }
+        @Test
+        func `forward distance is exact`() throws {
+            #expect(try Distance.exact(from: UInt(3), to: 8) == 5)
+            let report = Distance.reporting(from: UInt(3), to: 8)
+            #expect(report.value == 5)
+            #expect(!report.overflow)
+        }
 
-    @Test
-    func `backward distance reports and saturates`() {
-        let report = Distance.reporting(from: UInt(8), to: 3)
-        #expect(report.overflow)
-        #expect(Distance.saturating(from: UInt(8), to: 3) == .zero)
-        #expect(throws: Subtraction.Error.overflow) {
-            try Distance.exact(from: UInt(8), to: 3)
+        @Test
+        func `backward distance reports and saturates`() {
+            let report = Distance.reporting(from: UInt(8), to: 3)
+            #expect(report.overflow)
+            #expect(Distance.saturating(from: UInt(8), to: 3) == .zero)
+            #expect(throws: Subtraction.Error.overflow) {
+                try Distance.exact(from: UInt(8), to: 3)
+            }
         }
     }
 }
