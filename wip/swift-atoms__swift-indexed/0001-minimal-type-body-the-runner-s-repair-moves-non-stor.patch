From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 18:24:14 +0000
Subject: [PATCH 1/4] minimal type body: the runner's repair moves non-stored
 members out of type bodies into extensions; repair applied; root and test
 builds not yet run (coenttb/work#242)

---
 Sources/Indexed/Indexed.swift | 61 ++++++++++++++++++-----------------
 1 file changed, 32 insertions(+), 29 deletions(-)

diff --git a/Sources/Indexed/Indexed.swift b/Sources/Indexed/Indexed.swift
index 2fc9d2a..c4e2080 100644
--- a/Sources/Indexed/Indexed.swift
+++ b/Sources/Indexed/Indexed.swift
@@ -6,17 +6,6 @@ public import Tagged
 
 public struct Indexed<Bound: ~Copyable> {
 
-    public typealias Index = Index::Index<Indexed<Bound>>
-
-    public enum ForEach {}
-
-    public enum Drain {}
-
-    public enum Error: Swift::Error, Hashable, Sendable {
-
-        case invalidBounds(start: Index, end: Index)
-    }
-
     @usableFromInline
     var _start: Index
 
@@ -28,24 +17,6 @@ public struct Indexed<Bound: ~Copyable> {
     @usableFromInline
     let transform: @Sendable (Index) -> Bound
 
-    public struct Iterator: ~Copyable {
-        @usableFromInline
-        var current: Index
-
-        @usableFromInline
-        let end: Index
-
-        @usableFromInline
-        let transform: @Sendable (Index) -> Bound
-
-        @inlinable
-        package init(current: Index, end: Index, transform: @escaping @Sendable (Index) -> Bound) {
-            self.current = current
-            self.end = end
-            self.transform = transform
-        }
-    }
-
     public struct Reversed {
         @usableFromInline
         var start: Index
@@ -361,3 +332,35 @@ extension Indexed.Reversed.Iterator: Swift::Sendable where Bound: Swift::Sendabl
 extension Indexed.Iterator: Swift::Copyable where Bound: Swift::Copyable {}
 
 extension Indexed.Reversed.Iterator: Swift::Copyable where Bound: Swift::Copyable {}
+
+extension Indexed where Bound: ~Copyable {
+
+    public typealias Index = Index::Index<Indexed<Bound>>
+
+    public enum ForEach {}
+
+    public enum Drain {}
+
+    public enum Error: Swift::Error, Hashable, Sendable {
+
+        case invalidBounds(start: Index, end: Index)
+    }
+
+    public struct Iterator: ~Copyable {
+        @usableFromInline
+        var current: Index
+
+        @usableFromInline
+        let end: Index
+
+        @usableFromInline
+        let transform: @Sendable (Index) -> Bound
+
+        @inlinable
+        package init(current: Index, end: Index, transform: @escaping @Sendable (Index) -> Bound) {
+            self.current = current
+            self.end = end
+            self.transform = transform
+        }
+    }
+}
