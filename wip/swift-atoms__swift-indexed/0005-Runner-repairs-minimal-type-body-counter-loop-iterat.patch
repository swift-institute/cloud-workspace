     @usableFromInline
     var _start: Index
 
@@ -28,24 +16,6 @@ public struct Indexed<Bound: ~Copyable> {
     @usableFromInline
     let transform: @Sendable (Index) -> Bound
 
-    public struct Iterator: ~Copyable {
