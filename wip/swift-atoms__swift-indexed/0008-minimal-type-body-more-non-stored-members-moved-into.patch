From cb1ec62baf6cc1064f358a1918f7f2755de4a8f6 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:27:40 +0000
Subject: [PATCH 08/14] minimal type body: more non-stored members moved into
 an extension of their type (batch 10; type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 Sources/Indexed/Indexed.swift | 62 ++++++++++++++++-------------------
 1 file changed, 29 insertions(+), 33 deletions(-)

diff --git a/Sources/Indexed/Indexed.swift b/Sources/Indexed/Indexed.swift
index 428701d..f7887ae 100644
--- a/Sources/Indexed/Indexed.swift
+++ b/Sources/Indexed/Indexed.swift
@@ -5,18 +5,6 @@ public import Property
 public import Tagged
 
 public struct Indexed<Bound: ~Copyable> {
-
-    public typealias Index = Index::Index<Indexed<Bound>>
-
-    public enum ForEach {}
-
-    public enum Drain {}
-
-    public enum Error: Swift::Error, Hashable, Sendable {
-
-        case invalidBounds(start: Index, end: Index)
-    }
-
     @usableFromInline
     var _start: Index
 
@@ -28,24 +16,6 @@ public struct Indexed<Bound: ~Copyable> {
     @usableFromInline
     let transform: @Sendable (Index) -> Bound
 
-    public struct Iterator: ~Copyable {
-        @usableFromInline
-        var current: Index
-
-        @usableFromInline
-        let end: Index
-
-        @usableFromInline
-        let transform: @Sendable (Index) -> Bound
-
-        @inlinable
-        package init(current: Index, end: Index, transform: @escaping @Sendable (Index) -> Bound) {
-            self.current = current
-            self.end = end
-            self.transform = transform
-        }
-    }
-
     public struct Reversed {
         @usableFromInline
         var start: Index
@@ -86,7 +56,6 @@ public struct Indexed<Bound: ~Copyable> {
                     self.current = start
                     self.exhausted = true
                 } else {
-
                     do throws(Ordinal::Ordinal.Error) {
                         self.current = try end.predecessor.exact()
                         self.exhausted = false
@@ -338,7 +307,6 @@ extension Indexed.Reversed.Iterator where Bound: ~Copyable {
         if current == start {
             exhausted = true
         } else {
-
             do throws(Ordinal::Ordinal.Error) {
                 current = try current.predecessor.exact()
             } catch {
@@ -363,7 +331,35 @@ extension Indexed.Iterator: Swift::Copyable where Bound: Swift::Copyable {}
 extension Indexed.Reversed.Iterator: Swift::Copyable where Bound: Swift::Copyable {}
 
 extension Indexed: Swift::Sequence where Bound: Copyable {
-
     @inlinable
     public var underestimatedCount: Int { Int(clamping: count.underlying.rawValue) }
 }
+
+extension Indexed where Bound: ~Copyable {
+    public typealias Index = Index::Index<Indexed<Bound>>
+
+    public enum ForEach {}
+
+    public enum Drain {}
+
+    public enum Error: Swift::Error, Hashable, Sendable {
+        case invalidBounds(start: Index, end: Index)
+    }
+
+    public struct Iterator: ~Copyable {
+        @usableFromInline
+        var current: Index
+
+        @usableFromInline
+        let end: Index
+
+        @usableFromInline
+        let transform: @Sendable (Index) -> Bound
+
+        @inlinable
+        package init(current: Index, end: Index, transform: @escaping @Sendable (Index) -> Bound) {
+            self.current = current
+            self.end = end
+            self.transform = transform
+        }
+    }}
