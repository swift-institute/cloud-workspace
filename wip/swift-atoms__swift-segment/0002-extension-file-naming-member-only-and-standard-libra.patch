From 70fa4325eee0747be3af88c802f338db3813d7c1 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 20:52:48 +0000
Subject: [PATCH 2/2] extension file naming: member-only and
 standard-library-conformance extension files merge into their type's own file
 (overnight/merge-extension-files.py); single type per file: additional types
 move to their own <Parent>.<Name>.swift inside the container's extension
 (overnight/split-types.py); parse-checked; builds pending (coenttb/work#242)

---
 .../Integrations/Affine/Segment+Affine.swift  | 21 ------------------
 Sources/Segment/Segment.swift                 | 22 +++++++++++++++++++
 2 files changed, 22 insertions(+), 21 deletions(-)
 delete mode 100644 Sources/Segment/Integrations/Affine/Segment+Affine.swift

diff --git a/Sources/Segment/Integrations/Affine/Segment+Affine.swift b/Sources/Segment/Integrations/Affine/Segment+Affine.swift
deleted file mode 100644
index 7805a4f..0000000
--- a/Sources/Segment/Integrations/Affine/Segment+Affine.swift
+++ /dev/null
@@ -1,21 +0,0 @@
-#if Affine
-    public import Affine
-
-    extension Segment {
-
-        public func displacement<Displacement, Failure: Swift::Error>(
-            using affine: Affine<Point, Displacement, Failure>
-        ) throws(Failure) -> Displacement {
-            try affine.displacement(from: start, to: end)
-        }
-
-        public func translated<Displacement, Failure: Swift::Error>(
-            by displacement: Displacement,
-            using affine: Affine<Point, Displacement, Failure>
-        ) throws(Failure) -> Self {
-            try map { (point) throws(Failure) in
-                try affine.translated(point, by: displacement)
-            }
-        }
-    }
-#endif
diff --git a/Sources/Segment/Segment.swift b/Sources/Segment/Segment.swift
index cfd3f48..0693a9c 100644
--- a/Sources/Segment/Segment.swift
+++ b/Sources/Segment/Segment.swift
@@ -33,3 +33,25 @@ extension Segment {
         self.init(start: start, end: end)
     }
 }
+
+#if Affine
+    public import Affine
+
+    extension Segment {
+
+        public func displacement<Displacement, Failure: Swift::Error>(
+            using affine: Affine<Point, Displacement, Failure>
+        ) throws(Failure) -> Displacement {
+            try affine.displacement(from: start, to: end)
+        }
+
+        public func translated<Displacement, Failure: Swift::Error>(
+            by displacement: Displacement,
+            using affine: Affine<Point, Displacement, Failure>
+        ) throws(Failure) -> Self {
+            try map { (point) throws(Failure) in
+                try affine.translated(point, by: displacement)
+            }
+        }
+    }
+#endif
