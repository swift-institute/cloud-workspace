From 9cff3305d8befca5eed78df4eb3651c944a42742 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:46:12 +0000
Subject: [PATCH 18/21] extension file naming: member-only extension files
 merged into the extended type's own file (type-check follows; Linux x86_64,
 Swift 6.4.2) (coenttb/work#242)

---
 .../Parser Machine Program/Machine.Parser.swift   |  9 +++++++++
 .../Parser.Machine.Program.swift                  | 15 ---------------
 2 files changed, 9 insertions(+), 15 deletions(-)
 delete mode 100644 Sources/Parser Machine Program/Parser.Machine.Program.swift

diff --git a/Sources/Parser Machine Program/Machine.Parser.swift b/Sources/Parser Machine Program/Machine.Parser.swift
index 4e347e8..01a916e 100644
--- a/Sources/Parser Machine Program/Machine.Parser.swift	
+++ b/Sources/Parser Machine Program/Machine.Parser.swift	
@@ -55,3 +55,12 @@ extension Machine.Parser {
         return Expression(node: nodeID)
     }
 }
+
+extension Machine.Parser {
+
+    public typealias Program<
+        Input: Cursor.`Protocol` & ~Copyable,
+        Failure: Swift::Error
+    > =
+        Machine::Machine.Program<Leaf<Input, Failure>, Failure, Mode>
+}
diff --git a/Sources/Parser Machine Program/Parser.Machine.Program.swift b/Sources/Parser Machine Program/Parser.Machine.Program.swift
deleted file mode 100644
index d163a31..0000000
--- a/Sources/Parser Machine Program/Parser.Machine.Program.swift	
+++ /dev/null
@@ -1,15 +0,0 @@
-import Checkpoint
-public import Cursor
-import Iterator
-public import Machine
-import Parser
-internal import Tagged
-
-extension Machine.Parser {
-
-    public typealias Program<
-        Input: Cursor.`Protocol` & ~Copyable,
-        Failure: Swift::Error
-    > =
-        Machine::Machine.Program<Leaf<Input, Failure>, Failure, Mode>
-}
