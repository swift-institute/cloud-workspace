diff --git a/Sources/Parser Machine Compile/Machine.Parser.Compile.Witness.swift b/Sources/Parser Machine Compile/Machine.Parser.Compile.Witness.swift
new file mode 100644
index 0000000..89c107d
--- /dev/null
+++ b/Sources/Parser Machine Compile/Machine.Parser.Compile.Witness.swift	
@@ -0,0 +1,39 @@
+import Checkpoint
+public import Cursor
+import Iterator
+public import Machine
+
+
+extension Machine.Parser.Compile {
+    public struct Witness<P: Parser::Parsing & ~Copyable>
+    where
+        P.Input: Cursor.`Protocol`,
+        P.Failure: Swift::Error
+    {
+        @usableFromInline
+        let _compile:
+            (
+                consuming P,
+                inout Machine.Parser.Builder<P.Input, P.Failure>
+            ) -> Machine.Parser.Expression<P.Input, P.Failure, P.Output>
+
+        @inlinable
+        public init(
+            compile:
+                @escaping (
+                    consuming P,
+                    inout Machine.Parser.Builder<P.Input, P.Failure>
+                ) -> Machine.Parser.Expression<P.Input, P.Failure, P.Output>
+        ) {
+            self._compile = compile
+        }
+
+        @inlinable
+        public func compile(
+            _ parser: consuming P,
+            into builder: inout Machine.Parser.Builder<P.Input, P.Failure>
+        ) -> Machine.Parser.Expression<P.Input, P.Failure, P.Output> {
+            _compile(parser, &builder)
+        }
+    }
+}
diff --git a/Sources/Parser Machine Compile/Machine.Parser.Compiled.Cache.swift b/Sources/Parser Machine Compile/Machine.Parser.Compiled.Cache.swift
new file mode 100644
index 0000000..180a3b5
--- /dev/null
+++ b/Sources/Parser Machine Compile/Machine.Parser.Compiled.Cache.swift	
@@ -0,0 +1,26 @@
+import Checkpoint
+public import Cursor
+import Iterator
+public import Machine
+
+
+extension Machine.Parser.Compiled where P: ~Copyable {
+    @usableFromInline
+    final class Cache {
+        @usableFromInline
+        var compiled: Result?
+
+        @usableFromInline
+        var source: P?
+
+        @usableFromInline
+        let witness: Machine.Parser.Compile.Witness<P>
+
+        @usableFromInline
+        init(source: consuming P, witness: Machine.Parser.Compile.Witness<P>) {
+            self.compiled = nil
+            self.source = consume source
+            self.witness = witness
+        }
+    }
+}
