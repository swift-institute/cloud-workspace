From f6c2e5a5dc2b8926e7724b79017d2f67338377e5 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:24:49 +0000
Subject: [PATCH 3/3] trait consistency: dependencies imported only under a
 trait get that trait's condition (runner repair; Linux x86_64, Swift 6.4.2)
 (coenttb/work#242)

---
 Package.swift | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/Package.swift b/Package.swift
index 2f7f8e1..729412d 100644
--- a/Package.swift
+++ b/Package.swift
@@ -72,8 +72,8 @@ let package = Package(
                     package: "swift-algebra",
                     condition: .when(traits: ["BifunctorMacro"])
                 ),
-                .product(name: "SwiftSyntax", package: "swift-syntax"),
-                .product(name: "SwiftSyntaxBuilder", package: "swift-syntax"),
+                .product(name: "SwiftSyntax", package: "swift-syntax", condition: .when(traits: ["BifunctorMacro"])),
+                .product(name: "SwiftSyntaxBuilder", package: "swift-syntax", condition: .when(traits: ["BifunctorMacro"])),
             ]
         ),
         .macro(
@@ -81,7 +81,7 @@ let package = Package(
             dependencies: [
                 .target(name: "Bifunctor Macro Core"),
                 .product(name: "SwiftCompilerPlugin", package: "swift-syntax"),
-                .product(name: "SwiftSyntax", package: "swift-syntax"),
+                .product(name: "SwiftSyntax", package: "swift-syntax", condition: .when(traits: ["BifunctorMacro"])),
                 .product(name: "SwiftSyntaxMacros", package: "swift-syntax"),
             ]
         ),
-- 
