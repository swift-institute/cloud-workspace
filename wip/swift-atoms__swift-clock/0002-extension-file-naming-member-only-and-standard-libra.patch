From e841ec1c0ff380fdb68e9a24d3a316cb66f04a51 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 20:52:41 +0000
Subject: [PATCH 2/5] extension file naming: member-only and
 standard-library-conformance extension files merge into their type's own file
 (overnight/merge-extension-files.py); single type per file: additional types
 move to their own <Parent>.<Name>.swift inside the container's extension
 (overnight/split-types.py); parse-checked; builds pending (coenttb/work#242)

---
 Sources/Clock/Clock.Deadline+Coordinate.swift | 19 ------------------
 Sources/Clock/Clock.Deadline.swift            | 20 +++++++++++++++++++
 2 files changed, 20 insertions(+), 19 deletions(-)
 delete mode 100644 Sources/Clock/Clock.Deadline+Coordinate.swift

diff --git a/Sources/Clock/Clock.Deadline+Coordinate.swift b/Sources/Clock/Clock.Deadline+Coordinate.swift
deleted file mode 100644
index f5a5c35..0000000
--- a/Sources/Clock/Clock.Deadline+Coordinate.swift
+++ /dev/null
@@ -1,19 +0,0 @@
-extension Clock.Deadline {
-
-    @inlinable public static func after<Domain: ~Copyable & ~Escapable>(
-        _ duration: Swift::Duration,
-        from instant: Instant
-    ) -> Self where Instant == Clock.Instant<Domain> {
-        .at(Instant(offset: instant.offset + duration))
-    }
-
-    @inlinable public func remaining<Domain: ~Copyable & ~Escapable>(
-        at instant: Instant
-    ) -> Swift::Duration? where Instant == Clock.Instant<Domain> {
-        switch self {
-        case .at(let deadline):
-            instant.offset < deadline.offset ? deadline.offset - instant.offset : .zero
-        case .never: nil
-        }
-    }
-}
diff --git a/Sources/Clock/Clock.Deadline.swift b/Sources/Clock/Clock.Deadline.swift
index 14f6202..5ec07a9 100644
--- a/Sources/Clock/Clock.Deadline.swift
+++ b/Sources/Clock/Clock.Deadline.swift
@@ -49,3 +49,23 @@ extension Clock.Deadline where Instant: Swift::InstantProtocol {
         }
     }
 }
+
+extension Clock.Deadline {
+
+    @inlinable public static func after<Domain: ~Copyable & ~Escapable>(
+        _ duration: Swift::Duration,
+        from instant: Instant
+    ) -> Self where Instant == Clock.Instant<Domain> {
+        .at(Instant(offset: instant.offset + duration))
+    }
+
+    @inlinable public func remaining<Domain: ~Copyable & ~Escapable>(
+        at instant: Instant
+    ) -> Swift::Duration? where Instant == Clock.Instant<Domain> {
+        switch self {
+        case .at(let deadline):
+            instant.offset < deadline.offset ? deadline.offset - instant.offset : .zero
+        case .never: nil
+        }
+    }
+}
