From e0824bc7b1e3ff8faedf9c3a02346ae8e93f3346 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:46:09 +0000
Subject: [PATCH 10/11] extension file naming: member-only extension files
 merged into the extended type's own file (type-check follows; Linux x86_64,
 Swift 6.4.2) (coenttb/work#242)

---
 Sources/Clock/Clock.Instant.swift | 7 -------
 Sources/Clock/Clock.swift         | 8 ++++++++
 2 files changed, 8 insertions(+), 7 deletions(-)
 delete mode 100644 Sources/Clock/Clock.Instant.swift

diff --git a/Sources/Clock/Clock.Instant.swift b/Sources/Clock/Clock.Instant.swift
deleted file mode 100644
index b4141f5..0000000
--- a/Sources/Clock/Clock.Instant.swift
+++ /dev/null
@@ -1,7 +0,0 @@
-public import Tagged
-public import Time
-
-extension Clock {
-
-    public typealias Instant<Domain: ~Copyable & ~Escapable> = Tagged<Domain, Time.Coordinate>
-}
diff --git a/Sources/Clock/Clock.swift b/Sources/Clock/Clock.swift
index be5e104..e6e7ed4 100644
--- a/Sources/Clock/Clock.swift
+++ b/Sources/Clock/Clock.swift
@@ -1 +1,9 @@
+public import Tagged
+public import Time
+
 public enum Clock {}
+
+extension Clock {
+
+    public typealias Instant<Domain: ~Copyable & ~Escapable> = Tagged<Domain, Time.Coordinate>
+}
