Subject: [PATCH 08/21] test display name string: suite display strings dropped
 (type name kept, test IDs unchanged), test strings moved into raw-identifier
 names (tests only; Linux x86_64, Swift 6.4.2) (coenttb/work#242)

---
 .../Binary LEB128 Tests/Binary.LEB128 Tests.swift               | 2 +-
 .../Binary LEB128 Tests/Binary.LEB128.Decode Tests.swift        | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/Tests/Absorbed/swift-binary-leb128/Binary LEB128 Tests/Binary.LEB128 Tests.swift b/Tests/Absorbed/swift-binary-leb128/Binary LEB128 Tests/Binary.LEB128 Tests.swift
index 28a11a8..b1451ca 100644
--- a/Tests/Absorbed/swift-binary-leb128/Binary LEB128 Tests/Binary.LEB128 Tests.swift	
+++ b/Tests/Absorbed/swift-binary-leb128/Binary LEB128 Tests/Binary.LEB128 Tests.swift	
@@ -5,7 +5,7 @@
     import Testing
 
     extension Binary.LEB128 {
-        @Suite("Binary.LEB128") struct Test {
+        @Suite struct Test {
             @Suite struct Unit {}
             @Suite struct `Edge Case` {}
         }
diff --git a/Tests/Absorbed/swift-binary-leb128/Binary LEB128 Tests/Binary.LEB128.Decode Tests.swift b/Tests/Absorbed/swift-binary-leb128/Binary LEB128 Tests/Binary.LEB128.Decode Tests.swift
index 073ad50..07d4fe8 100644
--- a/Tests/Absorbed/swift-binary-leb128/Binary LEB128 Tests/Binary.LEB128.Decode Tests.swift	
+++ b/Tests/Absorbed/swift-binary-leb128/Binary LEB128 Tests/Binary.LEB128.Decode Tests.swift	
@@ -41,7 +41,7 @@
     }
 
     extension Binary.LEB128.Decode {
-        @Suite("Binary.LEB128.Decode") struct Test {
+        @Suite struct Test {
             @Suite struct Unit {}
             @Suite struct `Edge Case` {}
         }
