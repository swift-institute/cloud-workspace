From 1210513aff94f8b6a0833df7cee128034a84f43c Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 22:39:51 +0000
Subject: [PATCH 04/24] minimal type body: non-stored members move from type
 bodies into an extension of the type in the same file
 (overnight/minimal-bodies.py); type-checked against the root build,
 directories that failed or couldn't be checked left out (coenttb/work#242)

---
 .../Binary Base/Binary.Base.62.Alphabet.swift | 54 +++++++++----------
 1 file changed, 27 insertions(+), 27 deletions(-)

diff --git a/Sources/Binary/Absorbed/swift-binary-base/Binary Base/Binary.Base.62.Alphabet.swift b/Sources/Binary/Absorbed/swift-binary-base/Binary Base/Binary.Base.62.Alphabet.swift
index 2d635a8..d92882a 100644
--- a/Sources/Binary/Absorbed/swift-binary-base/Binary Base/Binary.Base.62.Alphabet.swift	
+++ b/Sources/Binary/Absorbed/swift-binary-base/Binary Base/Binary.Base.62.Alphabet.swift	
@@ -3,9 +3,7 @@
     internal import Property
 
     extension Binary.Base.`62` {
-
         public struct Alphabet: Sendable, Hashable {
-
             @usableFromInline internal let encodeTable: [Byte]
 
             @usableFromInline internal let decodeTable: [UInt8]
@@ -25,36 +23,38 @@
                 self.encodeTable = bytes
                 self.decodeTable = inverse
             }
+        }
+    }
 
-            @inlinable
-            public func encode(_ value: UInt8) -> Byte {
-                encodeTable[Int(value)]
-            }
+extension Binary.Base.`62`.Alphabet {
+        @inlinable
+        public func encode(_ value: UInt8) -> Byte {
+            encodeTable[Int(value)]
+        }
 
-            @inlinable
-            public func decode(_ byte: Byte) -> UInt8? {
-                let value = decodeTable[Int(byte.bitPattern)]
-                return value == 0xFF ? nil : value
-            }
+        @inlinable
+        public func decode(_ byte: Byte) -> UInt8? {
+            let value = decodeTable[Int(byte.bitPattern)]
+            return value == 0xFF ? nil : value
+        }
 
-            @inlinable
-            public func isValid(_ byte: Byte) -> Bool {
-                decodeTable[Int(byte.bitPattern)] != 0xFF
-            }
+        @inlinable
+        public func isValid(_ byte: Byte) -> Bool {
+            decodeTable[Int(byte.bitPattern)] != 0xFF
+        }
 
-            public static let standard: Alphabet = .init(
-                Property<Binary.Base.Encode, Binary.Base.`62`>.standardAlphabet
-            )
+        public static let standard: Alphabet = .init(
+            Property<Binary.Base.Encode, Binary.Base.`62`>.standardAlphabet
+        )
 
-            public static let gmp: Alphabet = .init(
-                Property<Binary.Base.Encode, Binary.Base.`62`>.gmpAlphabet
-            )
+        public static let gmp: Alphabet = .init(
+            Property<Binary.Base.Encode, Binary.Base.`62`>.gmpAlphabet
+        )
 
-            public static let inverted: Alphabet = .init(
-                Property<Binary.Base.Encode, Binary.Base.`62`>.invertedAlphabet
-            )
+        public static let inverted: Alphabet = .init(
+            Property<Binary.Base.Encode, Binary.Base.`62`>.invertedAlphabet
+        )
 
-            public static var `default`: Self { .standard }
-        }
-    }
+        public static var `default`: Self { .standard }
+}
 #endif
-- 
