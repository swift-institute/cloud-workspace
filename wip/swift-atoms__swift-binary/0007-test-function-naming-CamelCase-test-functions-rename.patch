From d2e4500f54b80c73f9c245d98f55938b98708986 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:25:26 +0000
Subject: [PATCH 07/21] test function naming: CamelCase test functions renamed
 to backticked sentences (tests only; type-checked, not run; Linux x86_64,
 Swift 6.4.2) (coenttb/work#242)

---
 .../Binary.LEB128 Tests.swift                        |  8 ++++----
 .../Binary.LEB128.Decode Tests.swift                 | 12 ++++++------
 2 files changed, 10 insertions(+), 10 deletions(-)

diff --git a/Tests/Absorbed/swift-binary-leb128/Binary LEB128 Parser Tests/Binary.LEB128 Tests.swift b/Tests/Absorbed/swift-binary-leb128/Binary LEB128 Parser Tests/Binary.LEB128 Tests.swift
index 57bfab6..e04d399 100644
--- a/Tests/Absorbed/swift-binary-leb128/Binary LEB128 Parser Tests/Binary.LEB128 Tests.swift	
+++ b/Tests/Absorbed/swift-binary-leb128/Binary LEB128 Parser Tests/Binary.LEB128 Tests.swift	
@@ -255,7 +255,7 @@
     }
 
     extension `Binary.LEB128.Unsigned Tests`.Integration {
-        @Test func redundantEncodingAndNonzeroSlicePreserveRemainder() throws {
+        @Test func `redundant encoding and nonzero slice preserve remainder`() throws {
             let storage = Array(bytes(0xFF, 0x83, 0x00, 0xAA))
             var input = storage.dropFirst()
             #expect(try Binary.LEB128.Unsigned<UInt8>().parse(&input) == 3)
@@ -263,7 +263,7 @@
             #expect(input.map(\.bitPattern) == [0xAA])
         }
 
-        @Test func overflowConsumesRejectedByteButPreservesRemainder() {
+        @Test func `overflow consumes rejected byte but preserves remainder`() {
             var input = bytes(0x80, 0x80, 0x00, 0xAA)
             #expect(throws: Binary.LEB128.Error.overflow(bitWidth: 8)) {
                 try Binary.LEB128.Unsigned<UInt8>().parse(&input)
@@ -273,13 +273,13 @@
     }
 
     extension `Binary.LEB128.Signed Tests`.Integration {
-        @Test func redundantSignExtensionPreservesRemainder() throws {
+        @Test func `redundant sign extension preserves remainder`() throws {
             var input = bytes(0xFE, 0xFF, 0x7F, 0xAA)
             #expect(try Binary.LEB128.Signed<Int16>().parse(&input) == -2)
             #expect(input.map(\.bitPattern) == [0xAA])
         }
 
-        @Test func invalidSignBitsConsumeRejectedByte() {
+        @Test func `invalid sign bits consume rejected byte`() {
             var input = bytes(0x80, 0x01, 0xAA)
             #expect(throws: Binary.LEB128.Error.overflow(bitWidth: 8)) {
                 try Binary.LEB128.Signed<Int8>().parse(&input)
diff --git a/Tests/Absorbed/swift-binary-leb128/Binary LEB128 Tests/Binary.LEB128.Decode Tests.swift b/Tests/Absorbed/swift-binary-leb128/Binary LEB128 Tests/Binary.LEB128.Decode Tests.swift
index ea52fa2..073ad50 100644
--- a/Tests/Absorbed/swift-binary-leb128/Binary LEB128 Tests/Binary.LEB128.Decode Tests.swift	
+++ b/Tests/Absorbed/swift-binary-leb128/Binary LEB128 Tests/Binary.LEB128.Decode Tests.swift	
@@ -168,7 +168,7 @@
 
     extension Binary.LEB128.Decode.Test.`Edge Case` {
         @Test(arguments: [-1, Int.min, 8, Int.max])
-        func invalidShiftsRejectBeforeMutation(_ initialShift: Int) {
+        func `invalid shifts reject before mutation`(_ initialShift: Int) {
             var unsigned: UInt8 = 37
             var signed: Int8 = 37
             var unsignedShift = initialShift
@@ -183,7 +183,7 @@
             #expect(unsignedShift == initialShift && signedShift == initialShift)
         }
 
-        @Test func continuationAtWidthLimitIsOverflowBeforeMutation() {
+        @Test func `continuation at width limit is overflow before mutation`() {
             var unsigned: UInt8 = 3
             var signed: Int8 = 3
             var unsignedShift = 7
@@ -202,7 +202,7 @@
             #expect(unsignedShift == 7 && signedShift == 7)
         }
 
-        @Test func rejectedTerminalPayloadDoesNotMutateState() {
+        @Test func `rejected terminal payload does not mutate state`() {
             var unsigned: UInt8 = 3
             var signed: Int8 = 3
             var unsignedShift = 7
@@ -221,14 +221,14 @@
             #expect(unsignedShift == 7 && signedShift == 7)
         }
 
-        @Test func permitsRedundantEncodingWithinWidthBound() throws {
+        @Test func `permits redundant encoding within width bound`() throws {
 
             #expect(try decodeUnsigned([0x83, 0x00], UInt8.self) == 3)
             #expect(try decodeSigned([0xFE, 0x7F], Int16.self) == -2)
             #expect(try decodeSigned([0xFE, 0xFF, 0x7F], Int16.self) == -2)
         }
 
-        @Test func everyEightBitValueRoundTrips() throws {
+        @Test func `every eight bit value round trips`() throws {
             for value in UInt8.min...UInt8.max {
                 #expect(try decodeUnsigned(encoded(value), UInt8.self) == value)
             }
@@ -237,7 +237,7 @@
             }
         }
 
-        @Test func oneHundredTwentyEightBitLimits() throws {
+        @Test func `one hundred twenty eight bit limits`() throws {
             #expect(try decodeUnsigned(encoded(UInt128.max), UInt128.self) == UInt128.max)
             #expect(try decodeSigned(encoded(Int128.min), Int128.self) == Int128.min)
             #expect(try decodeSigned(encoded(Int128.max), Int128.self) == Int128.max)
