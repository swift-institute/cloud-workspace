From 0fc3fec2556ec69911842e39a83624763d492851 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:46:09 +0000
Subject: [PATCH 23/24] extension file naming: member-only extension files
 merged into the extended type's own file (type-check follows; Linux x86_64,
 Swift 6.4.2) (coenttb/work#242)

---
 .../RangeReplaceableCollection.swift          | 35 +++++++++++++++++++
 .../RangeReplaceableCollection+Binary.swift   | 34 ------------------
 2 files changed, 35 insertions(+), 34 deletions(-)
 delete mode 100644 Sources/Binary/RangeReplaceableCollection+Binary.swift

diff --git a/Sources/Binary/Absorbed/swift-binary-byte/Binary Byte/RangeReplaceableCollection.swift b/Sources/Binary/Absorbed/swift-binary-byte/Binary Byte/RangeReplaceableCollection.swift
index d409e98..7127d8c 100644
--- a/Sources/Binary/Absorbed/swift-binary-byte/Binary Byte/RangeReplaceableCollection.swift	
+++ b/Sources/Binary/Absorbed/swift-binary-byte/Binary Byte/RangeReplaceableCollection.swift	
@@ -1,3 +1,5 @@
+public import Byte
+
 #if Byte
     public import Byte
 
@@ -27,3 +29,36 @@
         }
     }
 #endif
+
+extension RangeReplaceableCollection<Byte> {
+
+    @inlinable
+    public init(
+        _ value: some FixedWidthInteger,
+        endianness: Binary.Endianness = .little
+    ) {
+        self.init()
+        reserveCapacity(MemoryLayout.size(ofValue: value))
+        value.bytes(into: &self, endianness: endianness)
+    }
+
+    @inlinable
+    public init<Values: Swift::Collection>(
+        serializing values: Values,
+        endianness: Binary.Endianness = .little
+    ) where Values.Element: FixedWidthInteger {
+        self.init()
+        reserveCapacity(values.count * MemoryLayout<Values.Element>.size)
+        for value in values {
+            value.bytes(into: &self, endianness: endianness)
+        }
+    }
+
+    @inlinable
+    public mutating func append(
+        _ value: some FixedWidthInteger,
+        endianness: Binary.Endianness = .little
+    ) {
+        value.bytes(into: &self, endianness: endianness)
+    }
+}
diff --git a/Sources/Binary/RangeReplaceableCollection+Binary.swift b/Sources/Binary/RangeReplaceableCollection+Binary.swift
deleted file mode 100644
index bd880e6..0000000
--- a/Sources/Binary/RangeReplaceableCollection+Binary.swift
+++ /dev/null
@@ -1,34 +0,0 @@
