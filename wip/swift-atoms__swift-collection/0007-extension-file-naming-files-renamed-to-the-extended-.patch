Subject: [PATCH 7/9] extension file naming: files renamed to the extended
 type's own name or the 'T where <clause>' shape (renames only; Linux x86_64,
 Swift 6.4.2) (coenttb/work#242)

---
 ...wift => Collection.Access.Random where Self is Copyable.swift} | 0
 ...wift => Collection.Bidirectional where Self is Copyable.swift} | 0
 ...col.swift => Collection.Protocol where Self is Copyable.swift} | 0
 ...n.Protocol where Self is ~Copyable, Element is Copyable.swift} | 0
 ...n.Slice.`Protocol` & ~Copyable, Tag == Collection.Slice.swift} | 0
 .../{Cardinal.Range+Collection.swift => Cardinal.Range.swift}     | 0
 6 files changed, 0 insertions(+), 0 deletions(-)
 rename Sources/Collection/{Swift.RandomAccessCollection+Collection.Access.Random.swift => Collection.Access.Random where Self is Copyable.swift} (100%)
 rename Sources/Collection/{Swift.BidirectionalCollection+Collection.Bidirectional.swift => Collection.Bidirectional where Self is Copyable.swift} (100%)
 rename Sources/Collection/{Swift.Collection+Collection.Protocol.swift => Collection.Protocol where Self is Copyable.swift} (100%)
 rename Sources/Collection/{Collection.Protocol+First.swift => Collection.Protocol where Self is ~Copyable, Element is Copyable.swift} (100%)
 rename Sources/Collection/{Collection.Slice+Property.Inout.swift => Property.Inout where Base is Collection.Slice.`Protocol` & ~Copyable, Tag == Collection.Slice.swift} (100%)
 rename Sources/Collection/Repetition/{Cardinal.Range+Collection.swift => Cardinal.Range.swift} (100%)

diff --git a/Sources/Collection/Swift.RandomAccessCollection+Collection.Access.Random.swift b/Sources/Collection/Collection.Access.Random where Self is Copyable.swift
similarity index 100%
rename from Sources/Collection/Swift.RandomAccessCollection+Collection.Access.Random.swift
