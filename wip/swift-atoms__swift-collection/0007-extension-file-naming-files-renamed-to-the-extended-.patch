similarity index 100%
rename from Sources/Collection/Swift.Collection+Collection.Protocol.swift
rename to Sources/Collection/Collection.Protocol where Self is Copyable.swift
diff --git a/Sources/Collection/Collection.Protocol+First.swift b/Sources/Collection/Collection.Protocol where Self is ~Copyable, Element is Copyable.swift
similarity index 100%
rename from Sources/Collection/Collection.Protocol+First.swift
rename to Sources/Collection/Collection.Protocol where Self is ~Copyable, Element is Copyable.swift
diff --git a/Sources/Collection/Collection.Slice+Property.Inout.swift b/Sources/Collection/Property.Inout where Base is Collection.Slice.`Protocol` & ~Copyable, Tag == Collection.Slice.swift
