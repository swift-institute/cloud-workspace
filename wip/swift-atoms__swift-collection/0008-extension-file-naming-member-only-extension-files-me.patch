From 3a99d2bbf1983b4683f77a82c7e6497ec9e9e1fa Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:46:09 +0000
Subject: [PATCH 08/10] extension file naming: member-only extension files
 merged into the extended type's own file (type-check follows; Linux x86_64,
 Swift 6.4.2) (coenttb/work#242)

---
 .../Cardinal.Range+Swift.Collection.swift     | 20 ------------------
 .../Repetition/Cardinal.Range.swift           | 21 +++++++++++++++++++
 2 files changed, 21 insertions(+), 20 deletions(-)
 delete mode 100644 Sources/Collection/Repetition/Cardinal.Range+Swift.Collection.swift

diff --git a/Sources/Collection/Repetition/Cardinal.Range+Swift.Collection.swift b/Sources/Collection/Repetition/Cardinal.Range+Swift.Collection.swift
deleted file mode 100644
index c183376..0000000
--- a/Sources/Collection/Repetition/Cardinal.Range+Swift.Collection.swift
+++ /dev/null
@@ -1,20 +0,0 @@
-#if Repetition
-    public import Repetition
-    public import Cardinal
-
-    extension Cardinal.Range {
-        public func end<C: Swift::Collection>(
-            in input: C
-        ) throws(Repetition<Self, Void>.Error) -> C.Index {
-            try end(from: input.startIndex) { position in
-                position == input.endIndex ? nil : input.index(after: position)
-            }
-        }
-
-        public func callAsFunction<C: Swift::Collection>(
-            _ input: C
-        ) throws(Repetition<Self, Void>.Error) -> C.SubSequence {
-            input[..<(try end(in: input))]
-        }
-    }
-#endif
diff --git a/Sources/Collection/Repetition/Cardinal.Range.swift b/Sources/Collection/Repetition/Cardinal.Range.swift
index 6623b9f..c7d0b2f 100644
--- a/Sources/Collection/Repetition/Cardinal.Range.swift
+++ b/Sources/Collection/Repetition/Cardinal.Range.swift
@@ -12,3 +12,24 @@
         }
     }
 #endif
+
+#if Repetition
+    public import Repetition
+    public import Cardinal
+
+    extension Cardinal.Range {
+        public func end<C: Swift::Collection>(
+            in input: C
+        ) throws(Repetition<Self, Void>.Error) -> C.Index {
+            try end(from: input.startIndex) { position in
+                position == input.endIndex ? nil : input.index(after: position)
+            }
+        }
+
+        public func callAsFunction<C: Swift::Collection>(
+            _ input: C
+        ) throws(Repetition<Self, Void>.Error) -> C.SubSequence {
+            input[..<(try end(in: input))]
+        }
+    }
+#endif
