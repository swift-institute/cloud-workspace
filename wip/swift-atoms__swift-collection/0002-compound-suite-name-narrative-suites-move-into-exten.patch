Date: Sat, 7 Nov 2026 18:48:50 +0000
Subject: [PATCH 2/2] compound suite name: narrative suites move into extension
 <Type> named after their test file, nested suites into extension
 <Type>.<Parent> (overnight/compound-suites.py); parse-checked; builds pending
 (coenttb/work#242)

---
 Tests/Collection Tests/Collection.ForEach Tests.swift |  5 ++++-
 Tests/Collection Tests/Collection.Rotated Tests.swift | 11 ++++++++---
 2 files changed, 12 insertions(+), 4 deletions(-)

diff --git a/Tests/Collection Tests/Collection.ForEach Tests.swift b/Tests/Collection Tests/Collection.ForEach Tests.swift
index d040fd4..7b30bbd 100644
--- a/Tests/Collection Tests/Collection.ForEach Tests.swift	
+++ b/Tests/Collection Tests/Collection.ForEach Tests.swift	
@@ -10,10 +10,13 @@ enum `Collection Tests` {}
 extension `Collection Tests` {
     @Suite
     struct `Collections inherit ordered and repeatable element visits` {
-        @Suite struct `Inherited element visits preserve collection contents and order` {}
     }
 }
 
+extension `Collection Tests`.`Collections inherit ordered and repeatable element visits` {
+    @Suite struct `Inherited element visits preserve collection contents and order` {}
+}
+
 extension `Collection Tests`.`Collections inherit ordered and repeatable element visits`
     .`Inherited element visits preserve collection contents and order`
 {
diff --git a/Tests/Collection Tests/Collection.Rotated Tests.swift b/Tests/Collection Tests/Collection.Rotated Tests.swift
index d270898..1b9c5dd 100644
--- a/Tests/Collection Tests/Collection.Rotated Tests.swift	
+++ b/Tests/Collection Tests/Collection.Rotated Tests.swift	
@@ -16,12 +16,17 @@ private func count<Element>(
 extension `Collection Tests` {
     @Suite
     struct `Rotated collections preserve indexed elements under normalized offsets` {
-        @Suite struct `Rotated collection indices and elements follow the normalized offset` {}
-        @Suite struct `Rotation preserves empty singleton and extreme offset behavior` {}
-        @Suite struct `Rotation composes across nested collections and slices` {}
     }
 }
 
+extension `Collection Tests`.`Rotated collections preserve indexed elements under normalized offsets` {
+    @Suite struct `Rotated collection indices and elements follow the normalized offset` {}
+
+    @Suite struct `Rotation preserves empty singleton and extreme offset behavior` {}
+
+    @Suite struct `Rotation composes across nested collections and slices` {}
+}
+
 extension `Collection Tests`.`Rotated collections preserve indexed elements under normalized offsets`
     .`Rotated collection indices and elements follow the normalized offset`
 {
