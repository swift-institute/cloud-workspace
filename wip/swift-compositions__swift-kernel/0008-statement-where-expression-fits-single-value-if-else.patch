From 9eea6c37902b520e635717567c648a60627a9e85 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:35:32 +0000
Subject: [PATCH 8/9] statement where expression fits: single-value if/else
 chains written as if expressions (type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 Sources/Kernel File/Kernel.File.Copy.swift | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/Sources/Kernel File/Kernel.File.Copy.swift b/Sources/Kernel File/Kernel.File.Copy.swift
index ad1bc9c..233b7d0 100644
--- a/Sources/Kernel File/Kernel.File.Copy.swift	
+++ b/Sources/Kernel File/Kernel.File.Copy.swift	
@@ -16,10 +16,10 @@ extension Kernel.File.Copy {
         }
 
         let sourceIsSymlink: Bool
-        if case .link(.symbolic) = sourceStats.type {
-            sourceIsSymlink = true
+        sourceIsSymlink = if case .link(.symbolic) = sourceStats.type {
+            true
         } else {
-            sourceIsSymlink = false
+            false
         }
 
         try handleDestination(destination, overwrite: options.overwrite)
