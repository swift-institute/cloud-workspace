From ba12c0b2c1840a47a4d2a7646aea9a935e15c577 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:32:51 +0000
Subject: [PATCH 10/10] compound type name, compound identifier: single-file
 internal types made fileprivate, package members used only in their target
 made internal (type-check follows; Linux x86_64, Swift 6.4.2)
 (coenttb/work#242)

---
 Sources/Kernel Core/Kernel.Time.swift                       | 2 +-
 Sources/Kernel Event/Kernel.Event.Driver.Registration.swift | 2 +-
 Tests/Kernel Tests/Kernel.System Tests.swift                | 6 +++---
 3 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/Sources/Kernel Core/Kernel.Time.swift b/Sources/Kernel Core/Kernel.Time.swift
index ce1fb30..8747771 100644
--- a/Sources/Kernel Core/Kernel.Time.swift	
+++ b/Sources/Kernel Core/Kernel.Time.swift	
@@ -21,7 +21,7 @@ extension Time.Instant {
     package var nanoseconds: Int32 { nanosecondFraction }
 
     @inlinable
-    package var totalNanoseconds: Int64 {
+    var totalNanoseconds: Int64 {
         secondsSinceUnixEpoch * 1_000_000_000 + Int64(nanosecondFraction)
     }
 
diff --git a/Sources/Kernel Event/Kernel.Event.Driver.Registration.swift b/Sources/Kernel Event/Kernel.Event.Driver.Registration.swift
index a358479..6b4c8bd 100644
--- a/Sources/Kernel Event/Kernel.Event.Driver.Registration.swift	
+++ b/Sources/Kernel Event/Kernel.Event.Driver.Registration.swift	
@@ -5,7 +5,7 @@
             package let descriptor: Kernel.Descriptor
             package var interest: Kernel.Event.Interest
 
-            package var armedInterest: Kernel.Event.Interest = []
+            var armedInterest: Kernel.Event.Interest = []
 
             package init(descriptor: consuming Kernel.Descriptor, interest: Kernel.Event.Interest) {
                 self.descriptor = descriptor
diff --git a/Tests/Kernel Tests/Kernel.System Tests.swift b/Tests/Kernel Tests/Kernel.System Tests.swift
index 1e072c2..6f0408c 100644
--- a/Tests/Kernel Tests/Kernel.System Tests.swift	
+++ b/Tests/Kernel Tests/Kernel.System Tests.swift	
@@ -3,7 +3,7 @@ import Testing
 
 @testable import Kernel
 
-enum SystemMemoryTests {
+fileprivate enum SystemMemoryTests {
     @Suite struct Test {
         @Suite struct Unit {}
     }
@@ -29,7 +29,7 @@ enum SystemMemoryTests {
 
 #endif
 
-enum SystemProcessorTests {
+fileprivate enum SystemProcessorTests {
     @Suite struct Test {
         @Suite struct Unit {}
     }
@@ -57,7 +57,7 @@ extension SystemProcessorTests.Test.Unit {
     }
 }
 
-enum SystemNameTests {
+fileprivate enum SystemNameTests {
     @Suite struct Test {
         @Suite struct Unit {}
     }
