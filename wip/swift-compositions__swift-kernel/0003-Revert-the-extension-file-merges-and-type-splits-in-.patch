diff --git a/Sources/Kernel Completion/Kernel.Completion.Notification+Wait.swift b/Sources/Kernel Completion/Kernel.Completion.Notification+Wait.swift
new file mode 100644
index 0000000..ced68da
--- /dev/null
+++ b/Sources/Kernel Completion/Kernel.Completion.Notification+Wait.swift	
@@ -0,0 +1,25 @@
+#if !os(Windows)
+
+    import POSIX_Kernel_File
+
+    extension Kernel.Completion.Notification {
+
+        public borrowing func wait() {
+            var counter: UInt64 = 0
+            while true {
+                let result = withUnsafeMutableBytes(of: &counter) { buf -> Bool in
+                    do throws(Kernel.IO.Read.Error) {
+                        _ = try unsafe Kernel.IO.Read.read(descriptor, into: buf)
+                        return true
+                    } catch {
+                        return false
+                    }
+                }
+                if result { return }
+
+                Kernel.Thread.yield()
+            }
+        }
+    }
+
+#endif
