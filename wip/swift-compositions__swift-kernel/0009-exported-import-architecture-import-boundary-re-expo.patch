From 488b20a09df56fae20339d537566adf8ba4194b4 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:40:30 +0000
Subject: [PATCH 09/10] exported import, architecture import boundary:
 re-exports moved into the target's root exports.swift (re-export set
 unchanged; type-check follows; Linux x86_64, Swift 6.4.2) (coenttb/work#242)

---
 Sources/Kernel/Exports.swift                  | 18 +++++++++---------
 ...ket.Address.Info+CrossPlatform.POSIX.swift |  2 +-
 Sources/Kernel/exports.swift                  | 19 +++++++++++++++++++
 3 files changed, 29 insertions(+), 10 deletions(-)
 create mode 100644 Sources/Kernel/exports.swift

diff --git a/Sources/Kernel/Exports.swift b/Sources/Kernel/Exports.swift
index 0210108..691fdb0 100644
--- a/Sources/Kernel/Exports.swift
+++ b/Sources/Kernel/Exports.swift
@@ -1,10 +1,10 @@
-@_exported public import Kernel_Clock
-@_exported public import Kernel_Completion
-@_exported public import Kernel_Core
-@_exported public import Kernel_Event
-@_exported public import Kernel_File
-@_exported public import Kernel_System
-@_exported public import Kernel_Thread
+public import Kernel_Clock
+public import Kernel_Completion
+public import Kernel_Core
+public import Kernel_Event
+public import Kernel_File
+public import Kernel_System
+public import Kernel_Thread
 
 #if canImport(Darwin) || canImport(Glibc) || canImport(Musl)
     public typealias Kernel = POSIX.Kernel
@@ -52,7 +52,7 @@
 #endif
 
 #if canImport(Darwin) || canImport(Glibc) || canImport(Musl)
-    @_exported public import POSIX_Kernel_Lock
+    public import POSIX_Kernel_Lock
 #elseif os(Windows)
-    @_exported public import Windows_Kernel_Lock
+    public import Windows_Kernel_Lock
 #endif
diff --git a/Sources/Kernel/Kernel.Socket.Address.Info+CrossPlatform.POSIX.swift b/Sources/Kernel/Kernel.Socket.Address.Info+CrossPlatform.POSIX.swift
index c908fda..14af68f 100644
--- a/Sources/Kernel/Kernel.Socket.Address.Info+CrossPlatform.POSIX.swift
+++ b/Sources/Kernel/Kernel.Socket.Address.Info+CrossPlatform.POSIX.swift
@@ -1,5 +1,5 @@
 #if os(macOS) || os(iOS) || os(tvOS) || os(watchOS) || os(visionOS) || os(Linux)
 
-    @_exported public import POSIX_Kernel_Socket_Address
+    public import POSIX_Kernel_Socket_Address
 
 #endif
diff --git a/Sources/Kernel/exports.swift b/Sources/Kernel/exports.swift
new file mode 100644
index 0000000..47a9e28
--- /dev/null
+++ b/Sources/Kernel/exports.swift
@@ -0,0 +1,19 @@
+@_exported public import Kernel_Clock
+@_exported public import Kernel_Completion
+@_exported public import Kernel_Core
+@_exported public import Kernel_Event
+@_exported public import Kernel_File
+@_exported public import Kernel_System
+@_exported public import Kernel_Thread
+
+#if os(macOS) || os(iOS) || os(tvOS) || os(watchOS) || os(visionOS) || os(Linux)
+
+    @_exported public import POSIX_Kernel_Socket_Address
+
+#endif
+
+#if canImport(Darwin) || canImport(Glibc) || canImport(Musl)
+    @_exported public import POSIX_Kernel_Lock
+#elseif os(Windows)
+    @_exported public import Windows_Kernel_Lock
+#endif
-- 
