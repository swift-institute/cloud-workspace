Subject: [PATCH 07/12] counter loop iteration: range loops without early exit
 written as forEach (type-check follows; Linux x86_64, Swift 6.4.2)
 (coenttb/work#242)

---
 Sources/Kernel Event/Kernel.Event.Driver.swift                  | 2 +-
 Tests/Kernel Tests/Kernel.Copy.Error Tests.swift                | 2 +-
 Tests/Kernel Tests/Kernel.File.Direct.Error Tests.swift         | 2 +-
 Tests/Kernel Tests/Kernel.File.Direct.Mode Tests.swift          | 2 +-
 Tests/Kernel Tests/Kernel.File.Direct.Mode.Resolved Tests.swift | 2 +-
 .../Kernel.File.Direct.Requirements.Reason Tests.swift          | 2 +-
 6 files changed, 6 insertions(+), 6 deletions(-)

diff --git a/Sources/Kernel Event/Kernel.Event.Driver.swift b/Sources/Kernel Event/Kernel.Event.Driver.swift
index 1547d63..5e2a960 100644
--- a/Sources/Kernel Event/Kernel.Event.Driver.swift	
+++ b/Sources/Kernel Event/Kernel.Event.Driver.swift	
@@ -140,7 +140,7 @@
                     guard rawCount > 0 else { return 0 }
 
                     var write = 0
-                    for read in 0..<rawCount {
+                    (0..<rawCount).forEach { read in
                         if shared.registry.contains(key: buffer[read].id) {
                             if write != read { buffer[write] = buffer[read] }
                             write += 1
