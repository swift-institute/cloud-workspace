From 81e9a81dc5cae8c90414a32b334125eb4954ac9f Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:27:09 +0000
Subject: [PATCH 5/5] compound suite name: narrative suites moved into the test
 file's namespace or the parent suite's extension (names and test IDs kept;
 tests only; Linux x86_64, Swift 6.4.2) (coenttb/work#242)

---
 Tests/String Tests/String Tagged Tests.swift | 54 ++++++++++----------
 1 file changed, 28 insertions(+), 26 deletions(-)

diff --git a/Tests/String Tests/String Tagged Tests.swift b/Tests/String Tests/String Tagged Tests.swift
index e3e7d66..19adbac 100644
--- a/Tests/String Tests/String Tagged Tests.swift	
+++ b/Tests/String Tests/String Tagged Tests.swift	
@@ -3,37 +3,39 @@ import String
 import Tagged
 import Testing
 
-@Suite
-struct `String Tagged Tests` {
+extension `String Tagged Tests`.`String Tagged Tests` {
+    @Suite
+    struct `String Tagged Tests` {
 
-    private enum Name {}
-    private enum Copy {}
+        private enum Name {}
+        private enum Copy {}
 
-    @Test
-    func `tagged strings vend borrowed and span views`() {
-        let name = Tagged<Name, String>(ascii: "swift")
+        @Test
+        func `tagged strings vend borrowed and span views`() {
+            let name = Tagged<Name, String>(ascii: "swift")
 
-        #expect(name.count == 5)
-        #expect(name.view.count == 5)
-        #expect(name.span.count == 5)
-        #expect(name.span[0] == 115)
-        #expect(name.span[4] == 116)
-        #expect(elementCount(name) == 5)
-    }
+            #expect(name.count == 5)
+            #expect(name.view.count == 5)
+            #expect(name.span.count == 5)
+            #expect(name.span[0] == 115)
+            #expect(name.span[4] == 116)
+            #expect(elementCount(name) == 5)
+        }
 
-    @Test
-    func `tagged strings copy borrowed storage across tags`() {
-        let source = Tagged<Name, String>(ascii: "tag")
-        let copy = Tagged<Copy, String>(copying: source.view)
+        @Test
+        func `tagged strings copy borrowed storage across tags`() {
+            let source = Tagged<Name, String>(ascii: "tag")
+            let copy = Tagged<Copy, String>(copying: source.view)
 
-        #expect(copy.count == 3)
-        #expect(copy.span[0] == 116)
-        #expect(copy.span[1] == 97)
-        #expect(copy.span[2] == 103)
-    }
+            #expect(copy.count == 3)
+            #expect(copy.span[0] == 116)
+            #expect(copy.span[1] == 97)
+            #expect(copy.span[2] == 103)
+        }
 
-    private func elementCount<S: __Span.`Protocol` & ~Copyable>(_ source: borrowing S) -> Int
-    where S.Element == String.Char {
-        source.span.count
+        private func elementCount<S: __Span.`Protocol` & ~Copyable>(_ source: borrowing S) -> Int
+        where S.Element == String.Char {
+            source.span.count
+        }
     }
 }
