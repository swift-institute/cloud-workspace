From 516dcdb2fe0b9986b0941683190358d75541305c Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 20:52:48 +0000
Subject: [PATCH 4/4] extension file naming: member-only and
 standard-library-conformance extension files merge into their type's own file
 (overnight/merge-extension-files.py); single type per file: additional types
 move to their own <Parent>.<Name>.swift inside the container's extension
 (overnight/split-types.py); parse-checked; builds pending (coenttb/work#242)

---
 Sources/String/String.Char.swift   | 23 -----------------
 Sources/String/String.Length.swift | 16 ------------
 Sources/String/String.swift        | 41 ++++++++++++++++++++++++++++++
 3 files changed, 41 insertions(+), 39 deletions(-)
 delete mode 100644 Sources/String/String.Char.swift
 delete mode 100644 Sources/String/String.Length.swift

diff --git a/Sources/String/String.Char.swift b/Sources/String/String.Char.swift
deleted file mode 100644
index f5e980f..0000000
--- a/Sources/String/String.Char.swift
+++ /dev/null
@@ -1,23 +0,0 @@
-#if STRING_AVAILABLE && (os(macOS) || os(iOS) || os(tvOS) || os(watchOS) || os(visionOS) || os(Linux) || os(Android) || os(OpenBSD) || os(Windows))
-
-    extension String {
-
-        #if STRING_AVAILABLE && os(Windows)
-
-            public typealias Char = UInt16
-
-            public typealias Codec = Unicode.UTF16
-        #else
-
-            public typealias Char = UInt8
-
-            public typealias Codec = Unicode.UTF8
-        #endif
-
-        public typealias CodeUnit = Char
-
-        @inlinable
-        public static var terminator: Char { 0 }
-    }
-
-#endif
diff --git a/Sources/String/String.Length.swift b/Sources/String/String.Length.swift
deleted file mode 100644
index 226bb45..0000000
--- a/Sources/String/String.Length.swift
+++ /dev/null
@@ -1,16 +0,0 @@
-#if STRING_AVAILABLE && (os(macOS) || os(iOS) || os(tvOS) || os(watchOS) || os(visionOS) || os(Linux) || os(Android) || os(OpenBSD) || os(Windows))
-
-    extension String {
-
-        @unsafe
-        @inlinable
-        public static func length(of pointer: UnsafePointer<Char>) -> Int {
-            var current = unsafe pointer
-            while unsafe current.pointee != terminator {
-                unsafe (current = current.successor())
-            }
-            return unsafe current - pointer
-        }
-    }
-
-#endif
diff --git a/Sources/String/String.swift b/Sources/String/String.swift
index cb3153f..b44f5df 100644
--- a/Sources/String/String.swift
+++ b/Sources/String/String.swift
@@ -150,3 +150,44 @@
     }
 
 #endif
+
+#if STRING_AVAILABLE && (os(macOS) || os(iOS) || os(tvOS) || os(watchOS) || os(visionOS) || os(Linux) || os(Android) || os(OpenBSD) || os(Windows))
+
+    extension String {
+
+        #if STRING_AVAILABLE && os(Windows)
+
+            public typealias Char = UInt16
+
+            public typealias Codec = Unicode.UTF16
+        #else
+
+            public typealias Char = UInt8
+
+            public typealias Codec = Unicode.UTF8
+        #endif
+
+        public typealias CodeUnit = Char
+
+        @inlinable
+        public static var terminator: Char { 0 }
+    }
+
+#endif
+
+#if STRING_AVAILABLE && (os(macOS) || os(iOS) || os(tvOS) || os(watchOS) || os(visionOS) || os(Linux) || os(Android) || os(OpenBSD) || os(Windows))
+
+    extension String {
+
+        @unsafe
+        @inlinable
+        public static func length(of pointer: UnsafePointer<Char>) -> Int {
+            var current = unsafe pointer
+            while unsafe current.pointee != terminator {
+                unsafe (current = current.successor())
+            }
+            return unsafe current - pointer
+        }
+    }
+
+#endif
-- 
