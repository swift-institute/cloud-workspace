From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 18:35:12 +0000
Subject: [PATCH] test display name string: @Suite display strings become the
 suite's raw-identifier name (overnight/suite-display-names.py); Linux x86_64,
 Swift 6.4.2, test builds checked in the findings session (coenttb/work#242)

---
 Tests/String Tests/String Ownership Tests.swift | 4 ++--
 Tests/String Tests/String Span Tests.swift      | 4 ++--
 2 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/Tests/String Tests/String Ownership Tests.swift b/Tests/String Tests/String Ownership Tests.swift
index 197932d..4991b51 100644
--- a/Tests/String Tests/String Ownership Tests.swift	
+++ b/Tests/String Tests/String Ownership Tests.swift	
@@ -2,8 +2,8 @@ import Ownership
 import String
 import Testing
 
-@Suite("String × Ownership")
-struct String_Ownership_Tests {
+@Suite
+struct `String × Ownership` {
 
     static func acceptsBorrowProtocol<R: Ownership.Borrow.`Protocol` & ~Copyable>(
         _ value: borrowing R
diff --git a/Tests/String Tests/String Span Tests.swift b/Tests/String Tests/String Span Tests.swift
index d5fada6..caca032 100644
--- a/Tests/String Tests/String Span Tests.swift	
+++ b/Tests/String Tests/String Span Tests.swift	
@@ -2,8 +2,8 @@ import Span
 import String
 import Testing
 
-@Suite("String × Span")
-struct String_Span_Tests {
+@Suite
+struct `String × Span` {
 
     static func count<R: Span.`Protocol` & ~Copyable>(
         _ region: borrowing R
-- 
