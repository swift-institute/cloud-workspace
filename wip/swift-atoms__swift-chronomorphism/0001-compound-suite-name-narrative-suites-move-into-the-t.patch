From 97d1a1693f369638b9b8c9bc0f319b77d0fe0dd0 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 19:33:58 +0000
Subject: [PATCH] compound suite name: narrative suites move into the test
 module's namespace `<File> Tests` (#239's layout), nested suites into
 extension <Path>.<Parent> (overnight/compound-suites.py); parse-checked;
 builds pending (coenttb/work#242)

---
 .../Boundary Tests.swift                      | 24 +++++++++++--------
 1 file changed, 14 insertions(+), 10 deletions(-)

diff --git a/Tests/Chronomorphism Macro Tests/Boundary Tests.swift b/Tests/Chronomorphism Macro Tests/Boundary Tests.swift
index fe9eff3..1a47e88 100644
--- a/Tests/Chronomorphism Macro Tests/Boundary Tests.swift	
+++ b/Tests/Chronomorphism Macro Tests/Boundary Tests.swift	
@@ -38,16 +38,20 @@ private func fibonacci(of seed: Int) -> Int {
     )
 }
 
-@Suite
-struct `Chronomorphism boundaries` {
-    @Test
-    func `a seed that stops at once folds the base case`() {
-        #expect(fibonacci(of: 0) == 0)
-        #expect(fibonacci(of: 1) == 1)
-    }
+enum `Boundary Tests` {}
+
+extension `Boundary Tests` {
+    @Suite
+    struct `Chronomorphism boundaries` {
+        @Test
+        func `a seed that stops at once folds the base case`() {
+            #expect(fibonacci(of: 0) == 0)
+            #expect(fibonacci(of: 1) == 1)
+        }
 
-    @Test
-    func `the fold sees two layers of the unfolded history`() {
-        #expect(fibonacci(of: 10) == 55)
+        @Test
+        func `the fold sees two layers of the unfolded history`() {
+            #expect(fibonacci(of: 10) == 55)
+        }
     }
 }
