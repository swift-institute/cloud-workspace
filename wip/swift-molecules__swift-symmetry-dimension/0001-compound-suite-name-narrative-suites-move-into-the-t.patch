From 3c092d75bece67523c6a4afb1f7bc93e2790c114 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 19:34:13 +0000
Subject: [PATCH] compound suite name: narrative suites move into the test
 module's namespace `<File> Tests` (#239's layout), nested suites into
 extension <Path>.<Parent> (overnight/compound-suites.py); parse-checked;
 builds pending (coenttb/work#242)

---
 .../Shear+Scale Tests.swift                   | 30 +++++++++++--------
 1 file changed, 17 insertions(+), 13 deletions(-)

diff --git a/Tests/Symmetry Dimension Tests/Shear+Scale Tests.swift b/Tests/Symmetry Dimension Tests/Shear+Scale Tests.swift
index 105170b..7c3ba64 100644
--- a/Tests/Symmetry Dimension Tests/Shear+Scale Tests.swift	
+++ b/Tests/Symmetry Dimension Tests/Shear+Scale Tests.swift	
@@ -3,20 +3,24 @@ import Symmetry
 import Symmetry_Dimension
 import Testing
 
-@Suite
-struct `Shear Scale Tests` {
+enum `Shear+Scale Tests` {}
 
-    @Test
-    func `Horizontal shear only affects x`() {
-        let shear = Shear<2, Double>.horizontal(Scale<1, Double>(0.5))
-        #expect(shear.x == 0.5)
-        #expect(shear.y == 0)
-    }
+extension `Shear+Scale Tests` {
+    @Suite
+    struct `Shear Scale Tests` {
+
+        @Test
+        func `Horizontal shear only affects x`() {
+            let shear = Shear<2, Double>.horizontal(Scale<1, Double>(0.5))
+            #expect(shear.x == 0.5)
+            #expect(shear.y == 0)
+        }
 
-    @Test
-    func `Vertical shear only affects y`() {
-        let shear = Shear<2, Double>.vertical(Scale<1, Double>(0.3))
-        #expect(shear.x == 0)
-        #expect(shear.y == 0.3)
+        @Test
+        func `Vertical shear only affects y`() {
+            let shear = Shear<2, Double>.vertical(Scale<1, Double>(0.3))
+            #expect(shear.x == 0)
+            #expect(shear.y == 0.3)
+        }
     }
 }
