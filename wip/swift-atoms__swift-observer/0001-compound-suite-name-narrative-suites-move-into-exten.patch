Subject: [PATCH] compound suite name: narrative suites move into extension
 <Type> named after their test file, nested suites into extension
 <Type>.<Parent> (overnight/compound-suites.py); parse-checked; builds pending
 (coenttb/work#242)

---
 Tests/Observer Tests/Observer Tests.swift     | 11 +++++++---
 .../Observer.Registrar Tests.swift            | 21 ++++++++++++-------
 2 files changed, 22 insertions(+), 10 deletions(-)

diff --git a/Tests/Observer Tests/Observer Tests.swift b/Tests/Observer Tests/Observer Tests.swift
index 8d46e3f..3cc03be 100644
--- a/Tests/Observer Tests/Observer Tests.swift	
+++ b/Tests/Observer Tests/Observer Tests.swift	
@@ -8,12 +8,17 @@ enum `Observer Tests` {}
 extension `Observer Tests` {
     @Suite
     struct `Observer markers accept subjects and identifiers preserve their values` {
-        @Suite struct `Subjects can opt into observation` {}
-        @Suite struct `Property identifiers distinguish observed fields` {}
-        @Suite struct `Subscription identifiers select registrations` {}
     }
 }
 
+extension `Observer Tests`.`Observer markers accept subjects and identifiers preserve their values` {
+    @Suite struct `Subjects can opt into observation` {}
+
+    @Suite struct `Property identifiers distinguish observed fields` {}
+
+    @Suite struct `Subscription identifiers select registrations` {}
+}
+
 extension `Observer Tests`.`Observer markers accept subjects and identifiers preserve their values`.`Subjects can opt into observation` {
 
     @Test
diff --git a/Tests/Observer Tests/Observer.Registrar Tests.swift b/Tests/Observer Tests/Observer.Registrar Tests.swift
index 4fcc4d9..85b1bbb 100644
--- a/Tests/Observer Tests/Observer.Registrar Tests.swift	
+++ b/Tests/Observer Tests/Observer.Registrar Tests.swift	
@@ -14,16 +14,23 @@ extension `Observer.Registrar Tests` {
 
             init(_ initial: T) { self._storage = Mutex(initial) }
         }
-
-        @Suite struct `Subscriptions can be added and removed` {}
-        @Suite struct `Notifications precede mutation` {}
-        @Suite struct `Notifications follow mutation` {}
-        @Suite struct `Mutations preserve effects and results` {}
-        @Suite struct `Copies share registrar identity` {}
-        @Suite struct `Noncopyable subjects publish mutations` {}
     }
 }
 
+extension `Observer.Registrar Tests`.`Registrars manage property subscriptions` {
+    @Suite struct `Subscriptions can be added and removed` {}
+
+    @Suite struct `Notifications precede mutation` {}
+
+    @Suite struct `Notifications follow mutation` {}
+
+    @Suite struct `Mutations preserve effects and results` {}
+
+    @Suite struct `Copies share registrar identity` {}
+
+    @Suite struct `Noncopyable subjects publish mutations` {}
+}
+
 extension `Observer.Registrar Tests`.`Registrars manage property subscriptions`.Box {
 
     var value: T {
