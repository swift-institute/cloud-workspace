From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 20:52:45 +0000
Subject: [PATCH 2/2] extension file naming: member-only and
 standard-library-conformance extension files merge into their type's own file
 (overnight/merge-extension-files.py); single type per file: additional types
 move to their own <Parent>.<Name>.swift inside the container's extension
 (overnight/split-types.py); parse-checked; builds pending (coenttb/work#242)

---
 Sources/Observer/Observer.Registrar.ID.swift | 6 ------
 Sources/Observer/Observer.Registrar.swift    | 7 +++++++
 2 files changed, 7 insertions(+), 6 deletions(-)
 delete mode 100644 Sources/Observer/Observer.Registrar.ID.swift

diff --git a/Sources/Observer/Observer.Registrar.ID.swift b/Sources/Observer/Observer.Registrar.ID.swift
deleted file mode 100644
index 8045274..0000000
--- a/Sources/Observer/Observer.Registrar.ID.swift
+++ /dev/null
@@ -1,6 +0,0 @@
-extension Observer.Registrar {
-
-    public var id: ObjectIdentifier {
-        ObjectIdentifier(_extent)
-    }
-}
diff --git a/Sources/Observer/Observer.Registrar.swift b/Sources/Observer/Observer.Registrar.swift
index 4669c97..0a8972e 100644
--- a/Sources/Observer/Observer.Registrar.swift
+++ b/Sources/Observer/Observer.Registrar.swift
@@ -99,3 +99,10 @@ extension Observer.Registrar {
         withExtendedLifetime(removed) {}
     }
 }
+
+extension Observer.Registrar {
+
+    public var id: ObjectIdentifier {
+        ObjectIdentifier(_extent)
+    }
+}
