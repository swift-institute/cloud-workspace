Subject: [PATCH 04/12] Revert the extension-file merges and type splits in
 Sources/Stack: they don't type-check (coenttb/work#242)

---
 Sources/Stack/Stack.swift   | 10 ++++++++++
 Sources/Stack/__Stack.swift | 21 ---------------------
 2 files changed, 10 insertions(+), 21 deletions(-)
 delete mode 100644 Sources/Stack/__Stack.swift

diff --git a/Sources/Stack/Stack.swift b/Sources/Stack/Stack.swift
index a5551ae..82ffeb3 100644
--- a/Sources/Stack/Stack.swift
+++ b/Sources/Stack/Stack.swift
@@ -23,6 +23,16 @@ where S: Store.`Protocol`, S: ~Copyable {}
 extension Buffer.Linear.Bounded: __StackColumnProtocol
 where S: Store.`Protocol`, S: ~Copyable {}
 
+@_documentation(visibility: public)
+@frozen
+public struct __Stack<S: ~Copyable>: ~Copyable {
+
+    @usableFromInline
+    package var column: S
+
+    @inlinable
+    public init(column: consuming S) { self.column = column }
+}
 
 extension __Stack where S: ~Copyable {
 
diff --git a/Sources/Stack/__Stack.swift b/Sources/Stack/__Stack.swift
deleted file mode 100644
index d2161fb..0000000
