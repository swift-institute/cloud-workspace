From 0b523b86b65a0836cb3821a8e3bb4be2bcc3213d Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 20:52:51 +0000
Subject: [PATCH 3/3] extension file naming: member-only and
 standard-library-conformance extension files merge into their type's own file
 (overnight/merge-extension-files.py); single type per file: additional types
 move to their own <Parent>.<Name>.swift inside the container's extension
 (overnight/split-types.py); parse-checked; builds pending (coenttb/work#242)

---
 Sources/Stack/Stack.swift   | 10 ----------
 Sources/Stack/__Stack.swift | 21 +++++++++++++++++++++
 2 files changed, 21 insertions(+), 10 deletions(-)
 create mode 100644 Sources/Stack/__Stack.swift

diff --git a/Sources/Stack/Stack.swift b/Sources/Stack/Stack.swift
index 82ffeb3..a5551ae 100644
--- a/Sources/Stack/Stack.swift
+++ b/Sources/Stack/Stack.swift
@@ -23,16 +23,6 @@ where S: Store.`Protocol`, S: ~Copyable {}
 extension Buffer.Linear.Bounded: __StackColumnProtocol
 where S: Store.`Protocol`, S: ~Copyable {}
 
-@_documentation(visibility: public)
-@frozen
-public struct __Stack<S: ~Copyable>: ~Copyable {
-
-    @usableFromInline
-    package var column: S
-
-    @inlinable
-    public init(column: consuming S) { self.column = column }
-}
 
 extension __Stack where S: ~Copyable {
 
diff --git a/Sources/Stack/__Stack.swift b/Sources/Stack/__Stack.swift
new file mode 100644
index 0000000..d2161fb
--- /dev/null
+++ b/Sources/Stack/__Stack.swift
@@ -0,0 +1,21 @@
+public import Buffer
+public import Buffer_Linear_Bounded_Primitive
+public import Buffer_Linear_Primitive
+public import Cardinal
+public import Index
+public import Memory_Allocator
+public import Memory_Allocator_Protocol
+public import Ordinal
+public import Storage
+public import Tagged
+
+@_documentation(visibility: public)
+@frozen
+public struct __Stack<S: ~Copyable>: ~Copyable {
+
+    @usableFromInline
+    package var column: S
+
+    @inlinable
+    public init(column: consuming S) { self.column = column }
+}
