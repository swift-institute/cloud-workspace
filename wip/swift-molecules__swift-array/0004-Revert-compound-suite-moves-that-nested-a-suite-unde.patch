+    @Suite struct Integration {
+        @Test
+        func `take then rewrap preserves contents`() {
+            var a = MoveArray<Int>(initialCapacity: 2)
+            a.append(4)
+            a.append(5)
+            let column = a.take()
+            let b = Array(store: column)
+            let bCount = b.count
+            #expect(bCount == Index<Int>.Count(2))
+            let b1 = b[1]
+            #expect(b1 == 5)
