-                let aCount = a.count
-                #expect(aCount == Index<Int>.Count(3))
-                let aLast = a[2]
-                #expect(aLast == 3)
+        @Test
+        func `growth from zero capacity is sound on both columns`() {
+            var a = MoveArray<Int>(initialCapacity: .zero)
