+        @Test
+        func `equal CoW arrays hash equal; unequal lengths compare unequal`() {
+            var a = CoWArray<Int>(initialCapacity: 2)
+            a.append(1)
+            var b = CoWArray<Int>(initialCapacity: 4)
+            b.append(1)
+            #expect(a == b)
+            var ha = Hasher()
+            var hb = Hasher()
+            a.hash(into: &ha)
+            b.hash(into: &hb)
+            #expect(ha.finalize() == hb.finalize())
+            b.append(2)
+            #expect(a != b)
+            let prefixSame = (a[0] == b[0])
+            #expect(prefixSame)
         }
     }
