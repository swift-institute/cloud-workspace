-                var b = CoWArray<Int>(initialCapacity: 4)
-                b.append(1)
-                #expect(a == b)
-                var ha = Hasher()
-                var hb = Hasher()
-                a.hash(into: &ha)
-                b.hash(into: &hb)
-                #expect(ha.finalize() == hb.finalize())
