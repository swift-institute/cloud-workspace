From a88776ae46b1dd80629d41495aaf2ff8d1961cae Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:46:11 +0000
Subject: [PATCH 6/6] extension file naming: member-only extension files merged
 into the extended type's own file (type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 Sources/Array/Array+Equatable.swift  |  9 -----
 Sources/Array/Array+Hashable.swift   |  9 -----
 Sources/Array/Array+OutputSpan.swift | 49 -------------------------
 Sources/Array/__Array.swift          | 55 ++++++++++++++++++++++++++++
 4 files changed, 55 insertions(+), 67 deletions(-)
 delete mode 100644 Sources/Array/Array+Equatable.swift
 delete mode 100644 Sources/Array/Array+Hashable.swift
 delete mode 100644 Sources/Array/Array+OutputSpan.swift

diff --git a/Sources/Array/Array+Equatable.swift b/Sources/Array/Array+Equatable.swift
deleted file mode 100644
index 673b5ff..0000000
--- a/Sources/Array/Array+Equatable.swift
+++ /dev/null
@@ -1,9 +0,0 @@
-public import Array_Primitive
-
-extension __Array: Equatable where S: Equatable {
-
-    @inlinable
-    public static func == (lhs: Self, rhs: Self) -> Bool {
-        lhs.store == rhs.store
-    }
-}
diff --git a/Sources/Array/Array+Hashable.swift b/Sources/Array/Array+Hashable.swift
deleted file mode 100644
index a9c1442..0000000
--- a/Sources/Array/Array+Hashable.swift
+++ /dev/null
@@ -1,9 +0,0 @@
-public import Array_Primitive
-
-extension __Array: Hashable where S: Hashable {
-
-    @inlinable
-    public func hash(into hasher: inout Hasher) {
-        store.hash(into: &hasher)
-    }
-}
diff --git a/Sources/Array/Array+OutputSpan.swift b/Sources/Array/Array+OutputSpan.swift
deleted file mode 100644
index 2a041a7..0000000
--- a/Sources/Array/Array+OutputSpan.swift
+++ /dev/null
@@ -1,49 +0,0 @@
-public import Array_Primitive
-public import Buffer
-public import Buffer_Linear_Primitive
-public import Cardinal
-internal import Index
-public import Memory
-public import Memory_Allocator
-public import Memory_Allocator_Protocol
-public import Storage
-public import Tagged
-
-extension __Array where S: ~Copyable {
-
-    @inlinable
-
-    public init<E: ~Copyable, Failure: Swift::Error>(
-        capacity: Tagged<E, Cardinal>,
-        initializingWith initializer: (inout Swift::OutputSpan<E>) throws(Failure) -> Void
-    ) throws(Failure)
-    where S == Buffer<Storage<Memory.Allocator<Memory.Heap>>.Contiguous<E>>.Linear {
-        self.init(
-            store: try Buffer<Storage<Memory.Allocator<Memory.Heap>>.Contiguous<E>>.Linear(
-                capacity: capacity,
-                initializingWith: initializer
-            )
-        )
-    }
-
-    @inlinable
-
-    public mutating func append<E: ~Copyable, Failure: Swift::Error>(
-        addingCapacity: Tagged<E, Cardinal>,
-        initializingWith initializer: (inout Swift::OutputSpan<E>) throws(Failure) -> Void
-    ) throws(Failure)
-    where S == Buffer<Storage<Memory.Allocator<Memory.Heap>>.Contiguous<E>>.Linear {
-        try store.append(
-            addingCapacity: addingCapacity,
-            initializingWith: initializer
-        )
-    }
-
-    @inlinable
-    public mutating func edit<E: ~Copyable, Failure: Swift::Error, R: ~Copyable>(
-        _ body: (inout Swift::OutputSpan<E>) throws(Failure) -> R
-    ) throws(Failure) -> R
-    where S == Buffer<Storage<Memory.Allocator<Memory.Heap>>.Contiguous<E>>.Linear {
-        try store.edit(body)
-    }
-}
diff --git a/Sources/Array/__Array.swift b/Sources/Array/__Array.swift
index ac87164..85f3d4f 100644
--- a/Sources/Array/__Array.swift
+++ b/Sources/Array/__Array.swift
@@ -172,3 +172,58 @@ extension __Array where S: ~Copyable {
         try unsafe store.withUnsafeBufferPointer(body)
     }
 }
+
+extension __Array: Equatable where S: Equatable {
+
+    @inlinable
+    public static func == (lhs: Self, rhs: Self) -> Bool {
+        lhs.store == rhs.store
+    }
+}
+
+extension __Array: Hashable where S: Hashable {
+
+    @inlinable
+    public func hash(into hasher: inout Hasher) {
+        store.hash(into: &hasher)
+    }
+}
+
+extension __Array where S: ~Copyable {
+
+    @inlinable
+
+    public init<E: ~Copyable, Failure: Swift::Error>(
+        capacity: Tagged<E, Cardinal>,
+        initializingWith initializer: (inout Swift::OutputSpan<E>) throws(Failure) -> Void
+    ) throws(Failure)
+    where S == Buffer<Storage<Memory.Allocator<Memory.Heap>>.Contiguous<E>>.Linear {
+        self.init(
+            store: try Buffer<Storage<Memory.Allocator<Memory.Heap>>.Contiguous<E>>.Linear(
+                capacity: capacity,
+                initializingWith: initializer
+            )
+        )
+    }
+
+    @inlinable
+
+    public mutating func append<E: ~Copyable, Failure: Swift::Error>(
+        addingCapacity: Tagged<E, Cardinal>,
+        initializingWith initializer: (inout Swift::OutputSpan<E>) throws(Failure) -> Void
+    ) throws(Failure)
+    where S == Buffer<Storage<Memory.Allocator<Memory.Heap>>.Contiguous<E>>.Linear {
+        try store.append(
+            addingCapacity: addingCapacity,
+            initializingWith: initializer
+        )
+    }
+
+    @inlinable
+    public mutating func edit<E: ~Copyable, Failure: Swift::Error, R: ~Copyable>(
+        _ body: (inout Swift::OutputSpan<E>) throws(Failure) -> R
+    ) throws(Failure) -> R
+    where S == Buffer<Storage<Memory.Allocator<Memory.Heap>>.Contiguous<E>>.Linear {
+        try store.edit(body)
+    }
+}
