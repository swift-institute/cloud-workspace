From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 18:49:02 +0000
Subject: [PATCH] compound suite name: narrative suites move into extension
 <Type> named after their test file, nested suites into extension
 <Type>.<Parent> (overnight/compound-suites.py); parse-checked; builds pending
 (coenttb/work#242)

---
 Tests/HTML Standard Tests/HTMLStandard Tests.swift | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/Tests/HTML Standard Tests/HTMLStandard Tests.swift b/Tests/HTML Standard Tests/HTMLStandard Tests.swift
index 3cfd7ef..67eece5 100644
--- a/Tests/HTML Standard Tests/HTMLStandard Tests.swift	
+++ b/Tests/HTML Standard Tests/HTMLStandard Tests.swift	
@@ -9,12 +9,15 @@ extension `HTML Tests` {
     @Suite
     struct Test {
         @Suite struct Unit {}
-        @Suite struct EdgeCase {}
         @Suite struct Integration {}
         @Suite(.serialized) struct Performance {}
     }
 }
 
+extension `HTML Tests`.Test {
+    @Suite struct EdgeCase {}
+}
+
 extension `HTML Tests`.Test.Unit {
 
     @Test
