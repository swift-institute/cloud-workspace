 <Type>.<Parent> (overnight/compound-suites.py); parse-checked; builds pending
 (coenttb/work#242)

---
 Tests/Coproduct Tests/Coproduct Tests.swift | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/Tests/Coproduct Tests/Coproduct Tests.swift b/Tests/Coproduct Tests/Coproduct Tests.swift
index 8ca1cc4..b1d9149 100644
--- a/Tests/Coproduct Tests/Coproduct Tests.swift	
+++ b/Tests/Coproduct Tests/Coproduct Tests.swift	
@@ -3,9 +3,15 @@ import Testing
 
 @Suite
 struct `Coproduct exposes its module namespace` {
+}
+
+extension `Coproduct exposes its module namespace` {
     @Suite struct `The Coproduct module imports successfully` {}
+
     @Suite struct `No coproduct namespace boundary cases are defined` {}
+
     @Suite struct `No coproduct namespace integration cases are defined` {}
+
     @Suite(.serialized) struct `No coproduct namespace performance cases are defined` {}
 }
 
