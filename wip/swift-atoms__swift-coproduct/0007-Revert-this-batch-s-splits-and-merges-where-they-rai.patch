diff --git a/Sources/Coproduct/Coproduct+Fold.swift b/Sources/Coproduct/Coproduct+Fold.swift
new file mode 100644
index 0000000..6f20ebb
--- /dev/null
+++ b/Sources/Coproduct/Coproduct+Fold.swift
@@ -0,0 +1,28 @@
+#if hasFeature(VariadicEnum)
+    extension Coproduct where repeat each Element: ~Copyable & ~Escapable {
+
+        @inlinable
+        public static func fold<Result: ~Copyable, E: Swift::Error>(
+            _ coproduct: consuming Coproduct,
+            _ handlers: repeat (consuming each Element) throws(E) -> Result
+        ) throws(E) -> Result {
+            switch consume coproduct {
+            case .at(let value):
+
+                try (each handlers)(consume value)
+            }
+        }
+    }
+#endif
+
+#if hasFeature(VariadicEnum)
+    extension Coproduct where repeat each Element: ~Copyable & ~Escapable {
+
+        @inlinable
+        public consuming func fold<Result: ~Copyable, E: Swift::Error>(
+            _ handlers: repeat (consuming each Element) throws(E) -> Result
+        ) throws(E) -> Result {
+            try Self.fold(self, repeat each handlers)
+        }
+    }
+#endif
diff --git a/Sources/Coproduct/Coproduct+Map.swift b/Sources/Coproduct/Coproduct+Map.swift
new file mode 100644
index 0000000..c10ec77
--- /dev/null
+++ b/Sources/Coproduct/Coproduct+Map.swift
@@ -0,0 +1,28 @@
+#if hasFeature(VariadicEnum)
+    extension Coproduct where repeat each Element: ~Copyable {
+
+        @inlinable
+        public static func map<each NewElement: ~Copyable, E: Swift::Error>(
+            _ coproduct: consuming Coproduct,
+            _ transforms: repeat (consuming each Element) throws(E) -> each NewElement
+        ) throws(E) -> Coproduct<repeat each NewElement> {
+            switch consume coproduct {
+            case .at(let value):
+
+                try .at((each transforms)(consume value))
+            }
+        }
+    }
+#endif
+
+#if hasFeature(VariadicEnum)
+    extension Coproduct where repeat each Element: ~Copyable {
+
+        @inlinable
+        public consuming func map<each NewElement: ~Copyable, E: Swift::Error>(
+            _ transforms: repeat (consuming each Element) throws(E) -> each NewElement
+        ) throws(E) -> Coproduct<repeat each NewElement> {
+            try Self.map(self, repeat each transforms)
+        }
+    }
+#endif
diff --git a/Sources/Coproduct/Coproduct+Swift.BitwiseCopyable.swift b/Sources/Coproduct/Coproduct+Swift.BitwiseCopyable.swift
new file mode 100644
index 0000000..4a6cf35
--- /dev/null
+++ b/Sources/Coproduct/Coproduct+Swift.BitwiseCopyable.swift
@@ -0,0 +1,4 @@
+#if hasFeature(VariadicEnum)
+    extension Coproduct: Swift::BitwiseCopyable
+    where repeat each Element: Swift::BitwiseCopyable {}
+#endif
diff --git a/Sources/Coproduct/Coproduct+Swift.Comparable.swift b/Sources/Coproduct/Coproduct+Swift.Comparable.swift
new file mode 100644
index 0000000..6f313e5
--- /dev/null
+++ b/Sources/Coproduct/Coproduct+Swift.Comparable.swift
@@ -0,0 +1,14 @@
+#if hasFeature(VariadicEnum)
+    extension Coproduct: Swift::Comparable
+    where repeat each Element: Swift::Comparable & ~Copyable {
+
+        @inlinable
+        public static func < (lhs: borrowing Coproduct, rhs: borrowing Coproduct) -> Bool {
+
+            switch (lhs, rhs) {
+            case (.at(let l), .at(let r)):
+                l < r
+            }
+        }
+    }
+#endif
diff --git a/Sources/Coproduct/Coproduct+Swift.CustomStringConvertible.swift b/Sources/Coproduct/Coproduct+Swift.CustomStringConvertible.swift
new file mode 100644
index 0000000..5370ffd
--- /dev/null
+++ b/Sources/Coproduct/Coproduct+Swift.CustomStringConvertible.swift
@@ -0,0 +1,14 @@
+#if hasFeature(VariadicEnum)
+    extension Coproduct: Swift::CustomStringConvertible
+    where repeat each Element: Swift::CustomStringConvertible {
+
+        @inlinable
+        public var description: String {
+            switch self {
+            case .at(let value):
+
+                "at(\(value))"
+            }
+        }
+    }
+#endif
diff --git a/Sources/Coproduct/Coproduct+Swift.Decodable.swift b/Sources/Coproduct/Coproduct+Swift.Decodable.swift
new file mode 100644
index 0000000..a3eb852
--- /dev/null
+++ b/Sources/Coproduct/Coproduct+Swift.Decodable.swift
@@ -0,0 +1,16 @@
+#if hasFeature(VariadicEnum)
+    #if !hasFeature(Embedded)
+        extension Coproduct: Swift::Decodable where repeat each Element: Swift::Decodable {
+
+            @inlinable
+            public init(from decoder: any Decoder) throws(any Swift::Error) {
+                var container = try decoder.unkeyedContainer()
+                let position = try container.decode(UInt.self)
+
+                _ = position
+                fatalError("Pack-position decoding pending the shipped pack-eliminator syntax")
+            }
+        }
+    #endif
+
+#endif
diff --git a/Sources/Coproduct/Coproduct+Swift.Encodable.swift b/Sources/Coproduct/Coproduct+Swift.Encodable.swift
new file mode 100644
index 0000000..6e3a351
--- /dev/null
+++ b/Sources/Coproduct/Coproduct+Swift.Encodable.swift
@@ -0,0 +1,17 @@
+#if hasFeature(VariadicEnum)
+    #if !hasFeature(Embedded)
+        extension Coproduct: Swift::Encodable where repeat each Element: Swift::Encodable {
+
+            @inlinable
+            public func encode(to encoder: any Encoder) throws(any Swift::Error) {
+
+                var container = encoder.unkeyedContainer()
+                switch self {
+                case .at(let value):
+                    try container.encode(value)
+                }
+            }
+        }
+    #endif
+
+#endif
diff --git a/Sources/Coproduct/Coproduct+Swift.Equatable.swift b/Sources/Coproduct/Coproduct+Swift.Equatable.swift
new file mode 100644
index 0000000..b4743f1
--- /dev/null
+++ b/Sources/Coproduct/Coproduct+Swift.Equatable.swift
@@ -0,0 +1,14 @@
+#if hasFeature(VariadicEnum)
+    extension Coproduct: Swift::Equatable
+    where repeat each Element: Swift::Equatable & ~Copyable {
+
+        @inlinable
+        public static func == (lhs: borrowing Coproduct, rhs: borrowing Coproduct) -> Bool {
+
+            switch (lhs, rhs) {
+            case (.at(let l), .at(let r)):
+                l == r
+            }
+        }
+    }
+#endif
