diff --git a/Sources/Coproduct/Coproduct+Swift.Hashable.swift b/Sources/Coproduct/Coproduct+Swift.Hashable.swift
new file mode 100644
index 0000000..5fdc761
--- /dev/null
+++ b/Sources/Coproduct/Coproduct+Swift.Hashable.swift
@@ -0,0 +1,13 @@
+#if hasFeature(VariadicEnum)
+    extension Coproduct: Swift::Hashable
+    where repeat each Element: Swift::Hashable & ~Copyable {
+
+        @inlinable
+        public borrowing func hash(into hasher: inout Hasher) {
+            switch self {
+            case .at(let value):
+                value.hash(into: &hasher)
+            }
+        }
+    }
+#endif
