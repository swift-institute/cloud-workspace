-                    truncatingIfNeeded: (contentLength >> (shift * 8))
-                )
-            }
-
-            assert(
-                writeIndex
-                    == self._serializedBytes.index(lengthIndex, offsetBy: lengthBytesNeeded - 1)
-            )
-        }
-    }
