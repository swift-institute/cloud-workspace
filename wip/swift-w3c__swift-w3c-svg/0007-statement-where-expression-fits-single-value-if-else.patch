From d17e6f5409db0da824ab96dae6aff978b5f18bf4 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:35:32 +0000
Subject: [PATCH 7/7] statement where expression fits: single-value if/else
 chains written as if expressions (type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 Sources/W3C SVG/W3C_SVG2.Types.Transform.Parse.swift | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/Sources/W3C SVG/W3C_SVG2.Types.Transform.Parse.swift b/Sources/W3C SVG/W3C_SVG2.Types.Transform.Parse.swift
index aabd376..d70d229 100644
--- a/Sources/W3C SVG/W3C_SVG2.Types.Transform.Parse.swift	
+++ b/Sources/W3C SVG/W3C_SVG2.Types.Transform.Parse.swift	
@@ -95,10 +95,10 @@ extension W3C_SVG2.Types.Transform.Parse: Parsing {
             } else {
 
                 let args = try Self._parseArgs(&input, min: 1, max: 1)
-                if fifthByte == 0x78 {
-                    result = .skewX(angle: args[0])
+                result = if fifthByte == 0x78 {
+                    .skewX(angle: args[0])
                 } else {
-                    result = .skewY(angle: args[0])
+                    .skewY(angle: args[0])
                 }
             }
 
