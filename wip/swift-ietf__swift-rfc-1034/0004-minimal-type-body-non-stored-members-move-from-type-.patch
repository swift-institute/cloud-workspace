From 68317f39e12378e9a593124ffe653840da32b827 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 22:39:54 +0000
Subject: [PATCH 4/5] minimal type body: non-stored members move from type
 bodies into an extension of the type in the same file
 (overnight/minimal-bodies.py); type-checked against the root build,
 directories that failed or couldn't be checked left out (coenttb/work#242)

---
 Sources/RFC 1034/RFC_1034.Resource.TTL.swift | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/Sources/RFC 1034/RFC_1034.Resource.TTL.swift b/Sources/RFC 1034/RFC_1034.Resource.TTL.swift
index a867182..262d4d1 100644
--- a/Sources/RFC 1034/RFC_1034.Resource.TTL.swift	
+++ b/Sources/RFC 1034/RFC_1034.Resource.TTL.swift	
@@ -17,10 +17,12 @@ extension RFC_1034.Resource {
         init(__unchecked: Void, rawValue: UInt32) {
             self.rawValue = rawValue
         }
+    }
+}
 
-        public static func < (lhs: Self, rhs: Self) -> Bool {
-            lhs.rawValue < rhs.rawValue
-        }
+extension RFC_1034.Resource.TTL {
+    public static func < (lhs: Self, rhs: Self) -> Bool {
+        lhs.rawValue < rhs.rawValue
     }
 }
 
