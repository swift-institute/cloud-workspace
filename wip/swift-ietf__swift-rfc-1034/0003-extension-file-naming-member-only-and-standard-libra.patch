From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 20:52:52 +0000
Subject: [PATCH 3/3] extension file naming: member-only and
 standard-library-conformance extension files merge into their type's own file
 (overnight/merge-extension-files.py); single type per file: additional types
 move to their own <Parent>.<Name>.swift inside the container's extension
 (overnight/split-types.py); parse-checked; builds pending (coenttb/work#242)

---
 Sources/RFC 1034/RFC_1034.Zone.SOA.swift | 49 ++++++++++++++++++++++++
 Sources/RFC 1034/RFC_1034.Zone.swift     | 46 ----------------------
 2 files changed, 49 insertions(+), 46 deletions(-)
 create mode 100644 Sources/RFC 1034/RFC_1034.Zone.SOA.swift

diff --git a/Sources/RFC 1034/RFC_1034.Zone.SOA.swift b/Sources/RFC 1034/RFC_1034.Zone.SOA.swift
new file mode 100644
index 0000000..f69f16b
--- /dev/null
+++ b/Sources/RFC 1034/RFC_1034.Zone.SOA.swift	
@@ -0,0 +1,49 @@
+
+extension RFC_1034.Zone {
+    /// Start of Authority (SOA) record data
+    ///
+    /// Per RFC 1034 Section 4.2.1, every zone must have exactly one SOA
+    /// record at the zone apex.
+    ///
+    /// The SOA record contains administrative information about the zone.
+    public struct SOA: Sendable, Hashable {
+        /// Primary name server for this zone
+        public let primaryNameServer: RFC_1034.Name
+
+        /// Email address of the zone administrator (@ replaced with .)
+        public let responsibleMailbox: RFC_1034.Name
+
+        /// Zone serial number (incremented on each change)
+        public let serial: UInt32
+
+        /// Refresh interval in seconds
+        public let refresh: UInt32
+
+        /// Retry interval in seconds
+        public let retry: UInt32
+
+        /// Expire time in seconds
+        public let expire: UInt32
+
+        /// Minimum TTL for negative caching
+        public let minimum: UInt32
+
+        public init(
+            primaryNameServer: RFC_1034.Name,
+            responsibleMailbox: RFC_1034.Name,
+            serial: UInt32,
+            refresh: UInt32,
+            retry: UInt32,
+            expire: UInt32,
+            minimum: UInt32
+        ) {
+            self.primaryNameServer = primaryNameServer
+            self.responsibleMailbox = responsibleMailbox
+            self.serial = serial
+            self.refresh = refresh
+            self.retry = retry
+            self.expire = expire
+            self.minimum = minimum
+        }
+    }
+}
diff --git a/Sources/RFC 1034/RFC_1034.Zone.swift b/Sources/RFC 1034/RFC_1034.Zone.swift
index cbcd4ef..cd50add 100644
--- a/Sources/RFC 1034/RFC_1034.Zone.swift	
+++ b/Sources/RFC 1034/RFC_1034.Zone.swift	
@@ -9,50 +9,4 @@ extension RFC_1034 {
