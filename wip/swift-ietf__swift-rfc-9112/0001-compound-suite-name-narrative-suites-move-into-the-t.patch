From c7e094108315d3fdb2354273418f04124109ea33 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 19:34:18 +0000
Subject: [PATCH 1/2] compound suite name: narrative suites move into the test
 module's namespace `<File> Tests` (#239's layout), nested suites into
 extension <Path>.<Parent> (overnight/compound-suites.py); parse-checked;
 builds pending (coenttb/work#242)

---
 .../HTTP Token Case Tests.swift               | 40 ++++++++++---------
 1 file changed, 22 insertions(+), 18 deletions(-)

diff --git a/Tests/RFC 9112 Tests/HTTP Token Case Tests.swift b/Tests/RFC 9112 Tests/HTTP Token Case Tests.swift
index ad47dec..47ac657 100644
--- a/Tests/RFC 9112 Tests/HTTP Token Case Tests.swift	
+++ b/Tests/RFC 9112 Tests/HTTP Token Case Tests.swift	
@@ -1,25 +1,29 @@
 import RFC_9112
 import Testing
 
-@Suite
-struct `HTTP token case` {
-    @Test(arguments: ["Chunked", "CHUNKED", "cHuNkEd"])
-    func `a transfer coding name is case-insensitive`(_ name: String) {
-        let encoding = RFC_9112.Transfer.Encoding(codingName: name)
-        #expect(encoding.isChunked)
-        #expect(encoding == .chunked)
-        #expect(RFC_9112.Transfer.Encoding.list([.gzip, encoding]).isChunkedFinal)
-    }
+enum `HTTP Token Case Tests` {}
 
-    @Test
-    func `a Kelvin sign does not become an ASCII k in a connection option`() {
-        let connection = RFC_9112.Connection(options: ["\u{212A}eep-alive"])
-        #expect(!connection.hasKeepAlive)
-    }
+extension `HTTP Token Case Tests` {
+    @Suite
+    struct `HTTP token case` {
+        @Test(arguments: ["Chunked", "CHUNKED", "cHuNkEd"])
+        func `a transfer coding name is case-insensitive`(_ name: String) {
+            let encoding = RFC_9112.Transfer.Encoding(codingName: name)
+            #expect(encoding.isChunked)
+            #expect(encoding == .chunked)
+            #expect(RFC_9112.Transfer.Encoding.list([.gzip, encoding]).isChunkedFinal)
+        }
+
+        @Test
+        func `a Kelvin sign does not become an ASCII k in a connection option`() {
+            let connection = RFC_9112.Connection(options: ["\u{212A}eep-alive"])
+            #expect(!connection.hasKeepAlive)
+        }
 
-    @Test
-    func `ASCII connection options are case-insensitive`() {
-        #expect(RFC_9112.Connection(options: ["Keep-Alive"]).hasKeepAlive)
-        #expect(RFC_9112.Connection(options: ["CLOSE"]).hasClose)
+        @Test
+        func `ASCII connection options are case-insensitive`() {
+            #expect(RFC_9112.Connection(options: ["Keep-Alive"]).hasKeepAlive)
+            #expect(RFC_9112.Connection(options: ["CLOSE"]).hasClose)
+        }
     }
 }
