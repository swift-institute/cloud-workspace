From 0f29252cc2aeaef82a0849bedcbc36b82e5a037d Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 01:37:31 +0000
Subject: [PATCH 09/10] extension file naming: more member-only and
 standard-library extension files merge into their type's file; single type
 per file: more additional types move to their own files
 (merge-extension-files.py, split-types.py); parse-checked; root build pending
 (coenttb/work#242)

---
 Sources/RFC 9112/HTTP.Field.swift             | 11 ----------
 .../RFC 9112/HTTP.Message.Body.Length.swift   | 20 -------------------
 .../RFC_9112.Field.ObsFold.Policy.swift       | 11 ++++++++++
 Sources/RFC 9112/RFC_9112.Field.ObsFold.swift |  4 ++++
 ...RFC_9112.Message.Body.Length.Context.swift | 11 ++++++++++
 .../RFC_9112.Message.Body.Length.Error.swift  | 17 ++++++++++++++++
 6 files changed, 43 insertions(+), 31 deletions(-)
 create mode 100644 Sources/RFC 9112/RFC_9112.Field.ObsFold.Policy.swift
 create mode 100644 Sources/RFC 9112/RFC_9112.Field.ObsFold.swift
 create mode 100644 Sources/RFC 9112/RFC_9112.Message.Body.Length.Context.swift
 create mode 100644 Sources/RFC 9112/RFC_9112.Message.Body.Length.Error.swift

diff --git a/Sources/RFC 9112/HTTP.Field.swift b/Sources/RFC 9112/HTTP.Field.swift
index 9c08c91..c3e1a55 100644
--- a/Sources/RFC 9112/HTTP.Field.swift	
+++ b/Sources/RFC 9112/HTTP.Field.swift	
@@ -3,18 +3,7 @@ extension RFC_9112 {
 }
 
 extension RFC_9112.Field {
-
-    public enum ObsFold {}
 }
 
 extension RFC_9112.Field.ObsFold {
-
-    public enum Policy: Equatable, Hashable {
-
-        case reject
-
-        case space
-
-        case discard
-    }
 }
diff --git a/Sources/RFC 9112/HTTP.Message.Body.Length.swift b/Sources/RFC 9112/HTTP.Message.Body.Length.swift
index 00bf240..9dc1541 100644
--- a/Sources/RFC 9112/HTTP.Message.Body.Length.swift	
+++ b/Sources/RFC 9112/HTTP.Message.Body.Length.swift	
@@ -17,13 +17,6 @@ extension RFC_9112.Message.Body {
 }
 
 extension RFC_9112.Message.Body.Length {
-
-    public enum Context: Equatable, Hashable {
-
-        case request
-
-        case response(status: RFC_9110.Status, to: RFC_9110.Method)
-    }
 }
 
 extension RFC_9112.Message.Body.Length.Context {
@@ -37,19 +30,6 @@ extension RFC_9112.Message.Body.Length.Context {
 }
 
 extension RFC_9112.Message.Body.Length {
-
-    public enum Error: Swift::Error, Equatable {
-
-        case transferEncodingWithContentLength
-
-        case transferEncodingWithIncompatibleStatus(RFC_9110.Status)
-
-        case chunkedNotFinal
-
-        case chunkedAppliedMultipleTimes
-
-        case transferEncodingWithoutChunked
-    }
 }
 
 extension RFC_9112.Message.Body.Length {
diff --git a/Sources/RFC 9112/RFC_9112.Field.ObsFold.Policy.swift b/Sources/RFC 9112/RFC_9112.Field.ObsFold.Policy.swift
new file mode 100644
index 0000000..bea5ad8
--- /dev/null
+++ b/Sources/RFC 9112/RFC_9112.Field.ObsFold.Policy.swift	
@@ -0,0 +1,11 @@
+
+extension RFC_9112.Field.ObsFold {
+    public enum Policy: Equatable, Hashable {
+
+        case reject
+
+        case space
+
+        case discard
+    }
+}
diff --git a/Sources/RFC 9112/RFC_9112.Field.ObsFold.swift b/Sources/RFC 9112/RFC_9112.Field.ObsFold.swift
new file mode 100644
index 0000000..5de868d
--- /dev/null
+++ b/Sources/RFC 9112/RFC_9112.Field.ObsFold.swift	
@@ -0,0 +1,4 @@
+
+extension RFC_9112.Field {
+    public enum ObsFold {}
+}
diff --git a/Sources/RFC 9112/RFC_9112.Message.Body.Length.Context.swift b/Sources/RFC 9112/RFC_9112.Message.Body.Length.Context.swift
new file mode 100644
index 0000000..93f17dc
--- /dev/null
+++ b/Sources/RFC 9112/RFC_9112.Message.Body.Length.Context.swift	
@@ -0,0 +1,11 @@
+public import RFC_9110
+
+
+extension RFC_9112.Message.Body.Length {
+    public enum Context: Equatable, Hashable {
+
+        case request
+
+        case response(status: RFC_9110.Status, to: RFC_9110.Method)
+    }
+}
diff --git a/Sources/RFC 9112/RFC_9112.Message.Body.Length.Error.swift b/Sources/RFC 9112/RFC_9112.Message.Body.Length.Error.swift
new file mode 100644
index 0000000..1f7f45a
--- /dev/null
+++ b/Sources/RFC 9112/RFC_9112.Message.Body.Length.Error.swift	
@@ -0,0 +1,17 @@
+public import RFC_9110
+
+
+extension RFC_9112.Message.Body.Length {
+    public enum Error: Swift::Error, Equatable {
+
+        case transferEncodingWithContentLength
+
+        case transferEncodingWithIncompatibleStatus(RFC_9110.Status)
+
+        case chunkedNotFinal
+
+        case chunkedAppliedMultipleTimes
+
+        case transferEncodingWithoutChunked
+    }
+}
