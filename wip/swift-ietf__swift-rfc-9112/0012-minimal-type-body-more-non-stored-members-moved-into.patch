From b322d66e75f05b0c57328c0d026b76a7a61aa7d7 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:27:44 +0000
Subject: [PATCH 12/22] minimal type body: more non-stored members moved into
 an extension of their type (batch 10; type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 .../Framing.swift                             |  3 +-
 .../HTTP.Host.Coder.swift                     | 45 +++++++++----------
 .../HTTP.Request.Target.Coder.swift           | 38 ++++++++--------
 3 files changed, 41 insertions(+), 45 deletions(-)

diff --git a/Sources/RFC 9112/Absorbed swift-rfc-9112-coder/Framing.swift b/Sources/RFC 9112/Absorbed swift-rfc-9112-coder/Framing.swift
index 6461034..74feeed 100644
--- a/Sources/RFC 9112/Absorbed swift-rfc-9112-coder/Framing.swift	
+++ b/Sources/RFC 9112/Absorbed swift-rfc-9112-coder/Framing.swift	
@@ -4,9 +4,10 @@
     import RFC_9110
 
     enum Framing {
+    }
 
+    extension Framing {
         enum Error: Swift::Error, Equatable {
-
             case transferEncoding(String)
 
             case contentLength(String)
diff --git a/Sources/RFC 9112/Absorbed swift-rfc-9112-coder/HTTP.Host.Coder.swift b/Sources/RFC 9112/Absorbed swift-rfc-9112-coder/HTTP.Host.Coder.swift
index c029053..6f1f1ae 100644
--- a/Sources/RFC 9112/Absorbed swift-rfc-9112-coder/HTTP.Host.Coder.swift	
+++ b/Sources/RFC 9112/Absorbed swift-rfc-9112-coder/HTTP.Host.Coder.swift	
@@ -8,38 +8,16 @@
     import Serializer
 
     extension RFC_9112.Host {
-
         public struct Coder<
             Input: Cursor.`Protocol`<Byte, Never>,
             Buffer: RangeReplaceableCollection<Byte>
         >: Coding {
-
-            public typealias Output = RFC_9112.Host
-
-            public typealias Failure = RFC_9112.Host.Failure
-
             public init() {}
-
-            public borrowing func parse(_ input: inout Input) throws(Failure) -> RFC_9112.Host {
-                let token = Scanning.take(&input) { byte in
-                    byte.bitPattern != 0x0D && byte.bitPattern != 0x0A
-                }
-
-                return try RFC_9112.Host(text: Scanning.trimmed(Scanning.text(token)))
-            }
-
-            public borrowing func serialize(
-                _ output: RFC_9112.Host,
-                into buffer: inout Buffer
-            ) throws(Failure) {
-                buffer.append(contentsOf: Scanning.bytes(output.description))
-            }
         }
 
         public static var coder: Coder<ArraySlice<Byte>, [Byte]> { .init() }
 
         public enum Failure: Swift::Error, Equatable {
-
             case empty
 
             case whitespace(String)
@@ -56,8 +34,28 @@
         }
     }
 
-    extension RFC_9112.Host {
+extension RFC_9112.Host.Coder {
+        public typealias Output = RFC_9112.Host
+
+        public typealias Failure = RFC_9112.Host.Failure
+
+        public borrowing func parse(_ input: inout Input) throws(Failure) -> RFC_9112.Host {
+            let token = Scanning.take(&input) { byte in
+                byte.bitPattern != 0x0D && byte.bitPattern != 0x0A
+            }
+
+            return try RFC_9112.Host(text: Scanning.trimmed(Scanning.text(token)))
+        }
+
+        public borrowing func serialize(
+            _ output: RFC_9112.Host,
+            into buffer: inout Buffer
+        ) throws(Failure) {
+            buffer.append(contentsOf: Scanning.bytes(output.description))
+        }
+}
 
+    extension RFC_9112.Host {
         public init(text: String) throws(Failure) {
             guard !text.isEmpty else { throw .empty }
             guard !text.contains(where: \.isWhitespace) else { throw .whitespace(text) }
@@ -95,7 +93,6 @@
     }
 
     extension RFC_9112.Message.Request {
-
         public var host: RFC_9112.Host? {
             get throws(RFC_9112.Host.Failure) {
                 let values = headers.values(.host)
diff --git a/Sources/RFC 9112/Absorbed swift-rfc-9112-coder/HTTP.Request.Target.Coder.swift b/Sources/RFC 9112/Absorbed swift-rfc-9112-coder/HTTP.Request.Target.Coder.swift
index 44810b9..6b6c6e9 100644
--- a/Sources/RFC 9112/Absorbed swift-rfc-9112-coder/HTTP.Request.Target.Coder.swift	
+++ b/Sources/RFC 9112/Absorbed swift-rfc-9112-coder/HTTP.Request.Target.Coder.swift	
@@ -9,36 +9,17 @@
     import Serializer
 
     extension RFC_9112.Request.Target {
-
         public struct Coder<Input: Cursor.`Protocol`<Byte, Never>, Buffer: RangeReplaceableCollection<Byte>>: Coding {
-
-            public typealias Output = RFC_9112.Request.Target
-
-            public typealias Failure = RFC_9112.Request.Target.Failure
-
             public let method: RFC_9110.Method
 
             public init(method: RFC_9110.Method = .get) {
                 self.method = method
             }
-
-            public borrowing func parse(_ input: inout Input) throws(Failure) -> Output {
-                let token = Scanning.take(&input) { byte in
-                    byte.bitPattern != 0x20 && byte.bitPattern != 0x0D && byte.bitPattern != 0x0A
-                }
-                guard !token.isEmpty else { throw .empty }
-                return try RFC_9112.Request.Target(Scanning.text(token), method: method)
-            }
-
-            public borrowing func serialize(_ output: Output, into buffer: inout Buffer) throws(Failure) {
-                buffer.append(contentsOf: Scanning.bytes(output.text))
-            }
         }
 
         public static var coder: Coder<ArraySlice<Byte>, [Byte]> { .init() }
 
         public enum Failure: Swift::Error, Equatable {
-
             case empty
 
             case absolute
@@ -51,8 +32,25 @@
         }
     }
 
-    extension RFC_9112.Request.Target {
+extension RFC_9112.Request.Target.Coder {
+        public typealias Output = RFC_9112.Request.Target
+
+        public typealias Failure = RFC_9112.Request.Target.Failure
 
+        public borrowing func parse(_ input: inout Input) throws(Failure) -> Output {
+            let token = Scanning.take(&input) { byte in
+                byte.bitPattern != 0x20 && byte.bitPattern != 0x0D && byte.bitPattern != 0x0A
+            }
+            guard !token.isEmpty else { throw .empty }
+            return try RFC_9112.Request.Target(Scanning.text(token), method: method)
+        }
+
+        public borrowing func serialize(_ output: Output, into buffer: inout Buffer) throws(Failure) {
+            buffer.append(contentsOf: Scanning.bytes(output.text))
+        }
+}
+
+    extension RFC_9112.Request.Target {
         init(_ text: String, method: RFC_9110.Method) throws(Failure) {
             if text == "*" {
                 self = .asterisk
