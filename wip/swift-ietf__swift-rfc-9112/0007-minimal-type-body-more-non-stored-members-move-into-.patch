             public init() {}
-
-            public borrowing func parse(_ input: inout Input) throws(Failure) -> Output {
-                let tokens: [RFC_9110.Token]
-                do {
-                    tokens = try RFC_9110.Field.Value.List(RFC_9110.Token.Coder<Input, Buffer>())
-                        .parse(&input)
-                } catch {
