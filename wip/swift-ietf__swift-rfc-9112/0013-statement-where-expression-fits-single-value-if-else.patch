From 9607cad675a39e2eb94eb5a491a885639a11e71c Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:35:30 +0000
Subject: [PATCH 13/13] statement where expression fits: single-value if/else
 chains written as if expressions (type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 .../HTTP.Connection.Client.Coder.swift                          | 2 +-
 .../HTTP.Connection.Server.Coder.swift                          | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/Sources/RFC 9112/Absorbed swift-rfc-9112-coder/HTTP.Connection.Client.Coder.swift b/Sources/RFC 9112/Absorbed swift-rfc-9112-coder/HTTP.Connection.Client.Coder.swift
index 83a11dd..8a19287 100644
--- a/Sources/RFC 9112/Absorbed swift-rfc-9112-coder/HTTP.Connection.Client.Coder.swift	
+++ b/Sources/RFC 9112/Absorbed swift-rfc-9112-coder/HTTP.Connection.Client.Coder.swift	
@@ -61,7 +61,7 @@
 
         public mutating func receive(_ bytes: [Byte]) throws(Error) {
             let phase: RFC_9112.Message.Coder.Phase
-            if case .body = client.state { phase = .body } else { phase = .head }
+            phase = if case .body = client.state { .body } else { .head }
 
             do throws(RFC_9112.Message.Coder.Error) {
                 try messages.append(bytes, accumulating: phase)
diff --git a/Sources/RFC 9112/Absorbed swift-rfc-9112-coder/HTTP.Connection.Server.Coder.swift b/Sources/RFC 9112/Absorbed swift-rfc-9112-coder/HTTP.Connection.Server.Coder.swift
index 5f0f242..3aced1f 100644
--- a/Sources/RFC 9112/Absorbed swift-rfc-9112-coder/HTTP.Connection.Server.Coder.swift	
+++ b/Sources/RFC 9112/Absorbed swift-rfc-9112-coder/HTTP.Connection.Server.Coder.swift	
@@ -52,7 +52,7 @@
 
         public mutating func receive(_ bytes: [Byte]) throws(Error) {
             let phase: RFC_9112.Message.Coder.Phase
-            if case .body = server.state { phase = .body } else { phase = .head }
+            phase = if case .body = server.state { .body } else { .head }
 
             do throws(RFC_9112.Message.Coder.Error) {
                 try messages.append(bytes, accumulating: phase)
-- 
2.43.0

