From 090e88bab3bc90cd08c8a66b5157ed098ec9d943 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 20:52:41 +0000
Subject: [PATCH 2/2] extension file naming: member-only and
 standard-library-conformance extension files merge into their type's own file
 (overnight/merge-extension-files.py); single type per file: additional types
 move to their own <Parent>.<Name>.swift inside the container's extension
 (overnight/split-types.py); parse-checked; builds pending (coenttb/work#242)

---
 ...ocol where Self ~Copyable & ~Escapable.swift | 16 ----------------
 Sources/Carrier/Carrier.Protocol.swift          | 17 +++++++++++++++++
 2 files changed, 17 insertions(+), 16 deletions(-)
 delete mode 100644 Sources/Carrier/Carrier.Protocol where Self ~Copyable & ~Escapable.swift

diff --git a/Sources/Carrier/Carrier.Protocol where Self ~Copyable & ~Escapable.swift b/Sources/Carrier/Carrier.Protocol where Self ~Copyable & ~Escapable.swift
deleted file mode 100644
index 7b1cdd9..0000000
--- a/Sources/Carrier/Carrier.Protocol where Self ~Copyable & ~Escapable.swift	
+++ /dev/null
@@ -1,16 +0,0 @@
-extension Carrier.`Protocol`
-where
-    Self: ~Copyable & ~Escapable,
-    Underlying: ~Copyable & ~Escapable
-{
-
-    @_alwaysEmitIntoClient
-    @_lifetime(copy underlying)
-    public init<E: Swift::Error>(
-        _ underlying: consuming Underlying,
-        validate: (borrowing Underlying) throws(E) -> Void
-    ) throws(E) {
-        try validate(underlying)
-        self.init(underlying)
-    }
-}
diff --git a/Sources/Carrier/Carrier.Protocol.swift b/Sources/Carrier/Carrier.Protocol.swift
index 95326ac..264bc50 100644
--- a/Sources/Carrier/Carrier.Protocol.swift
+++ b/Sources/Carrier/Carrier.Protocol.swift
@@ -2,3 +2,20 @@ extension Carrier {
 
     public typealias `Protocol` = _CarrierProtocol
 }
+
+extension Carrier.`Protocol`
+where
+    Self: ~Copyable & ~Escapable,
+    Underlying: ~Copyable & ~Escapable
+{
+
+    @_alwaysEmitIntoClient
+    @_lifetime(copy underlying)
+    public init<E: Swift::Error>(
+        _ underlying: consuming Underlying,
+        validate: (borrowing Underlying) throws(E) -> Void
+    ) throws(E) {
+        try validate(underlying)
+        self.init(underlying)
+    }
+}
