From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 07:06:22 +0000
Subject: [PATCH 22/22] Revert Sources/SplatPlugin to origin/main: macro
 targets aren't type-checkable outside the build (coenttb/work#242)

---
 Sources/SplatPlugin/ExhaustiveCases.swift | 4 +---
 Sources/SplatPlugin/SplatMacro.swift      | 2 +-
 2 files changed, 2 insertions(+), 4 deletions(-)

diff --git a/Sources/SplatPlugin/ExhaustiveCases.swift b/Sources/SplatPlugin/ExhaustiveCases.swift
index 2e8ff27..2bafd9d 100644
--- a/Sources/SplatPlugin/ExhaustiveCases.swift
+++ b/Sources/SplatPlugin/ExhaustiveCases.swift
@@ -2,9 +2,7 @@ import SwiftSyntax
 import SwiftSyntaxBuilder
 
 enum ExhaustiveCases {
-}
 
-extension ExhaustiveCases {
     static func generate(
         properties: [SplatMacro.PropertyInfo],
         structName: String
@@ -54,7 +52,7 @@ extension ExhaustiveCases {
 
         var lines: [String] = []
 
-        (0..<n).forEach { i in
+        for i in 0..<n {
             let nest = String(repeating: "    ", count: i)
             let op = i < n - 1 ? "flatMap" : "map"
             lines.append("\(nest)_v.\(op) { v\(i) in")
diff --git a/Sources/SplatPlugin/SplatMacro.swift b/Sources/SplatPlugin/SplatMacro.swift
index 8e23b6f..8fba95a 100644
--- a/Sources/SplatPlugin/SplatMacro.swift
+++ b/Sources/SplatPlugin/SplatMacro.swift
@@ -500,7 +500,7 @@ public struct SplatMacro: MemberMacro {
     }
 }
 
-fileprivate enum SplatError: Swift::Error, CustomStringConvertible {
+enum SplatError: Swift::Error, CustomStringConvertible {
     case noTargetStruct(String)
     case noProperties
 
