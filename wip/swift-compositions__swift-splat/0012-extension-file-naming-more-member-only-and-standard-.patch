diff --git a/Sources/SplatPlugin/SplatError.swift b/Sources/SplatPlugin/SplatError.swift
new file mode 100644
index 0000000..a97869d
--- /dev/null
+++ b/Sources/SplatPlugin/SplatError.swift
@@ -0,0 +1,19 @@
+import Foundation
+import SwiftSyntax
+import SwiftSyntaxBuilder
+import SwiftSyntaxMacros
+
+enum SplatError: Swift::Error, CustomStringConvertible {
+    case noTargetStruct(String)
+    case noProperties
+
+    var description: String {
+        switch self {
+        case .noTargetStruct(let name):
+            return "@Splat requires a nested struct named '\(name)'"
+
+        case .noProperties:
+            return "Target struct has no stored properties to splat"
+        }
+    }
+}
