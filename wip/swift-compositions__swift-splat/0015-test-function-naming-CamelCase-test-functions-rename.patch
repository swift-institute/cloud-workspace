From 4e2ae559d8a4236d56dfedb9c943f5a1b28108fc Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:25:30 +0000
Subject: [PATCH 15/22] test function naming: CamelCase test functions renamed
 to backticked sentences (tests only; type-checked, not run; Linux x86_64,
 Swift 6.4.2) (coenttb/work#242)

---
 Tests/SplatTests/CrossModuleTypedThrows Tests.swift | 6 +++---
 Tests/SplatTests/InitSyntax Tests.swift             | 8 ++++----
 2 files changed, 7 insertions(+), 7 deletions(-)

diff --git a/Tests/SplatTests/CrossModuleTypedThrows Tests.swift b/Tests/SplatTests/CrossModuleTypedThrows Tests.swift
index 68daa19..98944a4 100644
--- a/Tests/SplatTests/CrossModuleTypedThrows Tests.swift	
+++ b/Tests/SplatTests/CrossModuleTypedThrows Tests.swift	
@@ -12,7 +12,7 @@ import Testing
 struct CrossModuleTypedThrowsTests {
 
     @Test
-    func typedThrowsPropagatesAcrossModules() {
+    func `typed throws propagates across modules`() {
         // This test verifies that when calling a @Splat-generated initializer
         // from a different module, the typed throws information is preserved.
         //
@@ -31,7 +31,7 @@ struct CrossModuleTypedThrowsTests {
     }
 
     @Test
-    func typedThrowsSuccessCase() {
+    func `typed throws success case`() {
         // Verify the success case still works
         do {
             let fixture = try TypedThrowsFixture(isValid: true)
@@ -42,7 +42,7 @@ struct CrossModuleTypedThrowsTests {
     }
 
     @Test
-    func errorTypeIsCorrect() {
+    func `error type is correct`() {
         // Explicitly verify the error type
         do {
             _ = try TypedThrowsFixture(isValid: false)
diff --git a/Tests/SplatTests/InitSyntax Tests.swift b/Tests/SplatTests/InitSyntax Tests.swift
index ee6bac9..b905d99 100644
--- a/Tests/SplatTests/InitSyntax Tests.swift	
+++ b/Tests/SplatTests/InitSyntax Tests.swift	
@@ -15,7 +15,7 @@ struct InitSyntaxTests {
     // MARK: - Regular name tests (typed throws)
 
     @Test
-    func callableStyleTypedThrows() {
+    func `callable style typed throws`() {
         // Using TypeName(args) syntax - the "callable" style
         do {
             _ = try TypedThrowsFixture(isValid: false)
@@ -27,7 +27,7 @@ struct InitSyntaxTests {
     }
 
     @Test
-    func explicitInitTypedThrows() {
+    func `explicit init typed throws`() {
         // Using TypeName.init(args) syntax - explicit init
         do {
             _ = try TypedThrowsFixture(isValid: false)
@@ -40,14 +40,14 @@ struct InitSyntaxTests {
     // MARK: - Regular name tests (non-throwing)
 
     @Test
-    func regularCallableStyle() {
+    func `regular callable style`() {
         // Using RegularNamespace.Three10.One(args) syntax - callable style
         let result = RegularNamespace.Three10.One(conditionSatisfied: true)
         #expect(result.output == .valid)
     }
 
     @Test
-    func regularExplicitInit() {
+    func `regular explicit init`() {
         // Using RegularNamespace.Three10.One.init(args) syntax - explicit init
         let result = RegularNamespace.Three10.One(conditionSatisfied: true)
         #expect(result.output == .valid)
