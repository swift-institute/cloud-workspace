From 16d6156a2f5132da861b67614bd7e65d87a24972 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 01:37:25 +0000
Subject: [PATCH 09/28] extension file naming: more member-only and
 standard-library extension files merge into their type's file; single type
 per file: more additional types move to their own files
 (merge-extension-files.py, split-types.py); parse-checked; root build pending
 (coenttb/work#242)

---
 Sources/Type Algebra/Type.Atom.swift     | 11 +++++++++++
 Sources/Type Algebra/Type.Failure.swift  |  7 +++++++
 Sources/Type Algebra/Type.Variable.swift |  7 +++++++
 Sources/Type Algebra/Type.swift          | 18 ------------------
 4 files changed, 25 insertions(+), 18 deletions(-)
 create mode 100644 Sources/Type Algebra/Type.Atom.swift
 create mode 100644 Sources/Type Algebra/Type.Failure.swift
 create mode 100644 Sources/Type Algebra/Type.Variable.swift

diff --git a/Sources/Type Algebra/Type.Atom.swift b/Sources/Type Algebra/Type.Atom.swift
new file mode 100644
index 0000000..43a42b7
--- /dev/null
+++ b/Sources/Type Algebra/Type.Atom.swift	
@@ -0,0 +1,11 @@
+
+extension Type {
+    public struct Atom: Hashable, Sendable {
+        public let scope: [String]
+        public let name: String
+        public init(_ name: String, scope: [String] = []) {
+            self.name = name
+            self.scope = scope
+        }
+    }
+}
diff --git a/Sources/Type Algebra/Type.Failure.swift b/Sources/Type Algebra/Type.Failure.swift
new file mode 100644
index 0000000..7cb173c
--- /dev/null
+++ b/Sources/Type Algebra/Type.Failure.swift	
@@ -0,0 +1,7 @@
+
+extension Type {
+    public struct Failure: Swift.Error, Equatable, Sendable, CustomStringConvertible {
+        public let description: String
+        public init(_ description: String) { self.description = description }
+    }
+}
diff --git a/Sources/Type Algebra/Type.Variable.swift b/Sources/Type Algebra/Type.Variable.swift
new file mode 100644
index 0000000..2c27e61
--- /dev/null
+++ b/Sources/Type Algebra/Type.Variable.swift	
@@ -0,0 +1,7 @@
+
+extension Type {
+    public struct Variable: Hashable, Sendable {
+        public let name: String
+        public init(_ name: String) { self.name = name }
+    }
+}
diff --git a/Sources/Type Algebra/Type.swift b/Sources/Type Algebra/Type.swift
index 23c218b..37fa6ad 100644
--- a/Sources/Type Algebra/Type.swift	
+++ b/Sources/Type Algebra/Type.swift	
@@ -117,22 +117,4 @@ public enum Type {
 }
 
 extension Type {
-    public struct Atom: Hashable, Sendable {
-        public let scope: [String]
-        public let name: String
-        public init(_ name: String, scope: [String] = []) {
-            self.name = name
-            self.scope = scope
-        }
-    }
-
-    public struct Variable: Hashable, Sendable {
-        public let name: String
-        public init(_ name: String) { self.name = name }
-    }
-
-    public struct Failure: Swift.Error, Equatable, Sendable, CustomStringConvertible {
-        public let description: String
-        public init(_ description: String) { self.description = description }
-    }
 }
