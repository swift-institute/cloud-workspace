diff --git a/Sources/Algebra/Bool/Algebra.Semiring+Bool.swift b/Sources/Algebra/Bool/Algebra.Semiring.Commutative where Element == Bool.swift
similarity index 100%
rename from Sources/Algebra/Bool/Algebra.Semiring+Bool.swift
