diff --git a/Sources/Type Algebra/Type.Equation.swift b/Sources/Type Algebra/Type.Equation.swift
new file mode 100644
index 0000000..fd3d4d0
--- /dev/null
+++ b/Sources/Type Algebra/Type.Equation.swift	
@@ -0,0 +1,13 @@
+extension Type {
+    public struct Equation: Equatable, Sendable {
+        public let lhs: Morphism
+        public let rhs: Morphism
+        public init(_ lhs: Morphism, _ rhs: Morphism) throws {
+            guard lhs.domain == rhs.domain, lhs.codomain == rhs.codomain else {
+                throw Failure("an equation requires parallel maps")
+            }
+            self.lhs = lhs
+            self.rhs = rhs
+        }
+    }
+}
diff --git a/Sources/Type Algebra/Type.Family.swift b/Sources/Type Algebra/Type.Family.swift
new file mode 100644
index 0000000..2500543
--- /dev/null
+++ b/Sources/Type Algebra/Type.Family.swift	
@@ -0,0 +1,14 @@
+extension Type {
+    public struct Family: Equatable, Sendable {
+        public let fibers: Record
+        public init(_ fibers: Record) { self.fibers = fibers }
+        public var sum: Expression { fibers.alternatives }
+        public var product: Expression { fibers.expression }
+        public func fiber(at index: String) throws -> Expression {
+            guard let field = fibers.fields.first(where: { $0.name == index }) else {
+                throw Failure("unknown family index")
+            }
+            return field.type
+        }
+    }
+}
