diff --git a/Sources/Type Algebra Syntax/exports.swift b/Sources/Type Algebra Syntax/exports.swift
new file mode 100644
index 0000000..6b4ea77
--- /dev/null
+++ b/Sources/Type Algebra Syntax/exports.swift	
