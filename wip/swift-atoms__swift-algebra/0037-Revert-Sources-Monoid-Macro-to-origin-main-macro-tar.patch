---
 Sources/Monoid Macro/Monoid.swift  | 2 +-
 Sources/Monoid Macro/exports.swift | 1 -
 2 files changed, 1 insertion(+), 2 deletions(-)
 delete mode 100644 Sources/Monoid Macro/exports.swift

diff --git a/Sources/Monoid Macro/Monoid.swift b/Sources/Monoid Macro/Monoid.swift
index 4289088..8c90b55 100644
--- a/Sources/Monoid Macro/Monoid.swift	
+++ b/Sources/Monoid Macro/Monoid.swift	
@@ -1,4 +1,4 @@
-import Algebra
