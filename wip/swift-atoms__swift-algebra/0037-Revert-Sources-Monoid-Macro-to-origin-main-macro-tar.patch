 @attached(member, names: named(monoid))
 public macro Monoid() = #externalMacro(module: "Monoid_Macro_Plugin", type: "Derive")
diff --git a/Sources/Monoid Macro/exports.swift b/Sources/Monoid Macro/exports.swift
deleted file mode 100644
index de42f2c..0000000
--- a/Sources/Monoid Macro/exports.swift	
+++ /dev/null
@@ -1 +0,0 @@
