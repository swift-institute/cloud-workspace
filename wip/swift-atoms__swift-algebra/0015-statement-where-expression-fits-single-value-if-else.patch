 Sources/Type Algebra/Type.Polynomial.swift | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Sources/Type Algebra/Type.Polynomial.swift b/Sources/Type Algebra/Type.Polynomial.swift
index f6c674f..9df71dd 100644
--- a/Sources/Type Algebra/Type.Polynomial.swift	
+++ b/Sources/Type Algebra/Type.Polynomial.swift	
@@ -71,7 +71,7 @@ extension Type {
             case .variable(let variable): return try checked(variables[variable])
