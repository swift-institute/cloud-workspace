From 21dc46a58d87e8babb0626302c2e5be33c03156d Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 23:28:21 +0000
Subject: [PATCH 7/8] minimal type body: more non-stored members move into
 extensions of their type (overnight/minimal-bodies.py); type-checked, failing
 files left out (coenttb/work#242)

---
 Sources/Polygon/Ngon.swift    | 10 ++++++----
 Sources/Polygon/Polygon.swift | 11 ++++++-----
 2 files changed, 12 insertions(+), 9 deletions(-)

diff --git a/Sources/Polygon/Ngon.swift b/Sources/Polygon/Ngon.swift
index 606aaa6..331bf15 100644
--- a/Sources/Polygon/Ngon.swift
+++ b/Sources/Polygon/Ngon.swift
@@ -1,10 +1,6 @@
 public struct Ngon<let N: Int, Point> {
     public let polygon: Polygon<Point>
 
-    public enum Error: Swift::Error, Equatable, Sendable {
-        case invalidVertexCount
-    }
-
     public init(vertices: [Point]) throws(Error) {
         guard N >= 3, vertices.count == N else { throw .invalidVertexCount }
         do {
@@ -13,6 +9,12 @@ public struct Ngon<let N: Int, Point> {
     }
 }
 
+extension Ngon {
+    public enum Error: Swift::Error, Equatable, Sendable {
+        case invalidVertexCount
+    }
+}
+
 extension Ngon {
     public var vertices: [Point] { polygon.vertices }
     public var vertexCount: Int { N }
diff --git a/Sources/Polygon/Polygon.swift b/Sources/Polygon/Polygon.swift
index 74870b3..49c469f 100644
--- a/Sources/Polygon/Polygon.swift
+++ b/Sources/Polygon/Polygon.swift
@@ -3,16 +3,18 @@
 public struct Polygon<Point> {
     public let vertices: [Point]
 
-    public enum Error: Swift::Error, Equatable, Sendable {
-        case insufficientVertices
-    }
-
     public init(vertices: [Point]) throws(Error) {
         guard vertices.count >= 3 else { throw .insufficientVertices }
         self.vertices = vertices
     }
 }
 
+extension Polygon {
+    public enum Error: Swift::Error, Equatable, Sendable {
+        case insufficientVertices
+    }
+}
+
 extension Polygon {
     public var vertexCount: Int { vertices.count }
 
@@ -43,7 +45,6 @@ extension Polygon: Hashable where Point: Hashable {}
 extension Polygon: Sendable where Point: Sendable {}
 
 extension Polygon {
-
     public init(_ first: Point, _ second: Point, _ third: Point, _ remaining: Point...) {
         self.vertices = [first, second, third] + remaining
     }
-- 
2.43.0

