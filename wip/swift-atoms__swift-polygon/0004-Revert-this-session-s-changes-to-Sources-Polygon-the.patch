From 12c508e98314f89da10c4e8f0a3ffbd1aa6ae59d Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 22:14:04 +0000
Subject: [PATCH 4/8] Revert this session's changes to Sources/Polygon: they
 raised a rule over its ratchet limit (coenttb/work#242)

---
 Sources/Polygon/Ngon.swift            | 11 +++------
 Sources/Polygon/Polygon+Codable.swift | 23 ++++++++++++++++++
 Sources/Polygon/Polygon.swift         | 35 +++------------------------
 3 files changed, 31 insertions(+), 38 deletions(-)
 create mode 100644 Sources/Polygon/Polygon+Codable.swift

diff --git a/Sources/Polygon/Ngon.swift b/Sources/Polygon/Ngon.swift
index 88f4e9d..606aaa6 100644
--- a/Sources/Polygon/Ngon.swift
+++ b/Sources/Polygon/Ngon.swift
@@ -1,6 +1,10 @@
 public struct Ngon<let N: Int, Point> {
     public let polygon: Polygon<Point>
 
+    public enum Error: Swift::Error, Equatable, Sendable {
+        case invalidVertexCount
+    }
+
     public init(vertices: [Point]) throws(Error) {
         guard N >= 3, vertices.count == N else { throw .invalidVertexCount }
         do {
@@ -54,10 +58,3 @@ extension Ngon {
 
     private init(validated polygon: Polygon<Point>) { self.polygon = polygon }
 }
-
-extension Ngon {
-
-    public enum Error: Swift::Error, Equatable, Sendable {
-        case invalidVertexCount
-    }
-}
diff --git a/Sources/Polygon/Polygon+Codable.swift b/Sources/Polygon/Polygon+Codable.swift
new file mode 100644
index 0000000..13a76c7
--- /dev/null
+++ b/Sources/Polygon/Polygon+Codable.swift
@@ -0,0 +1,23 @@
+#if !hasFeature(Embedded)
+    extension Polygon: Encodable where Point: Encodable {
+        public func encode(to encoder: any Encoder) throws {
+            var container = encoder.singleValueContainer()
+            try container.encode(vertices)
+        }
+    }
+
+    extension Polygon: Decodable where Point: Decodable {
+        public init(from decoder: any Decoder) throws {
+            let container = try decoder.singleValueContainer()
+            let vertices = try container.decode([Point].self)
+            do {
+                try self.init(vertices: vertices)
+            } catch {
+                throw DecodingError.dataCorruptedError(
+                    in: container,
+                    debugDescription: "A polygon requires at least three vertices"
+                )
+            }
+        }
+    }
+#endif
diff --git a/Sources/Polygon/Polygon.swift b/Sources/Polygon/Polygon.swift
index 4e3519d..74870b3 100644
--- a/Sources/Polygon/Polygon.swift
+++ b/Sources/Polygon/Polygon.swift
@@ -3,6 +3,10 @@
 public struct Polygon<Point> {
     public let vertices: [Point]
 
+    public enum Error: Swift::Error, Equatable, Sendable {
+        case insufficientVertices
+    }
+
     public init(vertices: [Point]) throws(Error) {
         guard vertices.count >= 3 else { throw .insufficientVertices }
         self.vertices = vertices
@@ -46,34 +50,3 @@ extension Polygon {
 
     private init(validated vertices: [Point]) { self.vertices = vertices }
 }
-
-extension Polygon {
-
-    public enum Error: Swift::Error, Equatable, Sendable {
-        case insufficientVertices
-    }
-}
-
-#if !hasFeature(Embedded)
-    extension Polygon: Encodable where Point: Encodable {
-        public func encode(to encoder: any Encoder) throws {
-            var container = encoder.singleValueContainer()
-            try container.encode(vertices)
-        }
-    }
-
-    extension Polygon: Decodable where Point: Decodable {
-        public init(from decoder: any Decoder) throws {
-            let container = try decoder.singleValueContainer()
-            let vertices = try container.decode([Point].self)
-            do {
-                try self.init(vertices: vertices)
-            } catch {
-                throw DecodingError.dataCorruptedError(
-                    in: container,
-                    debugDescription: "A polygon requires at least three vertices"
-                )
-            }
-        }
-    }
-#endif
