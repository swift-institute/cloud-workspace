From 2aa1af93eb0545a23764b727c540760e7716794c Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:27:43 +0000
Subject: [PATCH 4/5] minimal type body: more non-stored members moved into an
 extension of their type (batch 10; type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 Sources/Tree Column/__TreeArena.swift | 21 ++++++++++-----------
 1 file changed, 10 insertions(+), 11 deletions(-)

diff --git a/Sources/Tree Column/__TreeArena.swift b/Sources/Tree Column/__TreeArena.swift
index 25556c2..566ecb8 100644
--- a/Sources/Tree Column/__TreeArena.swift	
+++ b/Sources/Tree Column/__TreeArena.swift	
@@ -10,10 +10,6 @@ public import Tree
 
 @usableFromInline
 struct __TreeArena<Element: ~Copyable, ChildLinks>: ~Copyable {
-
-    @usableFromInline
-    typealias Slot = __TreeNode<Element, ChildLinks>
-
     @usableFromInline
     var _column: Ownership.Shared<Slot, Storage<Memory.Allocator<Memory.Heap>.Pool>.Generational<Slot>>
 
@@ -46,6 +42,15 @@ struct __TreeArena<Element: ~Copyable, ChildLinks>: ~Copyable {
         self._column = Ownership.Shared(Storage<Memory.Allocator<Memory.Heap>.Pool>.Generational<Slot>.create(slotCapacity: slots))
         self.rootHandle = nil
     }
+}
+
+extension __TreeArena: Copyable where Element: Copyable, ChildLinks: Copyable {}
+
+extension __TreeArena: Sendable where Element: Sendable, ChildLinks: Sendable {}
+
+extension __TreeArena where Element: ~Copyable {
+    @usableFromInline
+    typealias Slot = __TreeNode<Element, ChildLinks>
 
     @inlinable
     package var count: Index<Element>.Count {
@@ -83,7 +88,6 @@ struct __TreeArena<Element: ~Copyable, ChildLinks>: ~Copyable {
     @inlinable
     package mutating func removeNode(_ handle: Store::Store.Generational.Handle) -> Element {
         guard let node = _column.withUnique({ $0.remove(handle) }) else {
-
             preconditionFailure("__TreeArena: live handle failed to resolve on removal")
         }
         return node.element
@@ -130,9 +134,4 @@ struct __TreeArena<Element: ~Copyable, ChildLinks>: ~Copyable {
         _ body: (inout Element) -> R
     ) -> R {
         _column.withUnique { body(&$0[handle].element) }
-    }
-}
-
-extension __TreeArena: Copyable where Element: Copyable, ChildLinks: Copyable {}
-
-extension __TreeArena: Sendable where Element: Sendable, ChildLinks: Sendable {}
+    }}
-- 
