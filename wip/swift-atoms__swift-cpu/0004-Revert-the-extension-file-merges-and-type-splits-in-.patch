From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 21:32:50 +0000
Subject: [PATCH 4/5] Revert the extension-file merges and type splits in
 directories the type-check can't verify (C shims, macros); institute's
 generated Ratchet+limits.swift stays its own file (coenttb/work#242)

---
 Sources/CPU/CPU.Atomic.Load.Operations.swift  |  52 +++++++++
 Sources/CPU/CPU.Atomic.Store.Operations.swift |  55 +++++++++
 Sources/CPU/CPU.Atomic.swift                  | 107 ------------------
 3 files changed, 107 insertions(+), 107 deletions(-)
 create mode 100644 Sources/CPU/CPU.Atomic.Load.Operations.swift
 create mode 100644 Sources/CPU/CPU.Atomic.Store.Operations.swift

diff --git a/Sources/CPU/CPU.Atomic.Load.Operations.swift b/Sources/CPU/CPU.Atomic.Load.Operations.swift
new file mode 100644
index 0000000..f42b56a
--- /dev/null
+++ b/Sources/CPU/CPU.Atomic.Load.Operations.swift
@@ -0,0 +1,52 @@
+public import CPU_Shims
+
+extension CPU.Atomic {
+
+    @inline(always)
+    public static func load(
+        _ pointer: UnsafeMutablePointer<UInt8>,
+        ordering: Load.Ordering
+    ) -> UInt8 {
+        switch ordering {
+        case .relaxed:
+            return unsafe swift_cpu_atomic_load_relaxed_u8_v1(pointer)
+
+        case .acquiring:
+            return unsafe swift_cpu_atomic_load_acquire_u8_v1(pointer)
+        }
+    }
+}
+
+extension CPU.Atomic {
+
+    @inline(always)
+    public static func load(
+        _ pointer: UnsafeMutablePointer<UInt32>,
+        ordering: Load.Ordering
+    ) -> UInt32 {
+        switch ordering {
+        case .relaxed:
+            return unsafe swift_cpu_atomic_load_relaxed_u32_v1(pointer)
+
+        case .acquiring:
+            return unsafe swift_cpu_atomic_load_acquire_u32_v1(pointer)
+        }
+    }
+}
+
+extension CPU.Atomic {
+
+    @inline(always)
+    public static func load(
+        _ pointer: UnsafeMutablePointer<UInt64>,
+        ordering: Load.Ordering
+    ) -> UInt64 {
+        switch ordering {
+        case .relaxed:
+            return unsafe swift_cpu_atomic_load_relaxed_u64_v1(pointer)
+
+        case .acquiring:
+            return unsafe swift_cpu_atomic_load_acquire_u64_v1(pointer)
+        }
+    }
+}
diff --git a/Sources/CPU/CPU.Atomic.Store.Operations.swift b/Sources/CPU/CPU.Atomic.Store.Operations.swift
new file mode 100644
index 0000000..a2dd0bd
--- /dev/null
+++ b/Sources/CPU/CPU.Atomic.Store.Operations.swift
@@ -0,0 +1,55 @@
+public import CPU_Shims
+
+extension CPU.Atomic {
+
+    @inline(always)
+    public static func store(
+        _ pointer: UnsafeMutablePointer<UInt8>,
+        _ value: UInt8,
+        ordering: Store.Ordering
+    ) {
+        switch ordering {
+        case .relaxed:
+            unsafe swift_cpu_atomic_store_relaxed_u8_v1(pointer, value)
+
+        case .releasing:
+            unsafe swift_cpu_atomic_store_release_u8_v1(pointer, value)
+        }
+    }
+}
+
+extension CPU.Atomic {
+
+    @inline(always)
+    public static func store(
+        _ pointer: UnsafeMutablePointer<UInt32>,
+        _ value: UInt32,
+        ordering: Store.Ordering
+    ) {
+        switch ordering {
+        case .relaxed:
+            unsafe swift_cpu_atomic_store_relaxed_u32_v1(pointer, value)
+
+        case .releasing:
+            unsafe swift_cpu_atomic_store_release_u32_v1(pointer, value)
+        }
+    }
+}
+
+extension CPU.Atomic {
+
+    @inline(always)
+    public static func store(
+        _ pointer: UnsafeMutablePointer<UInt64>,
+        _ value: UInt64,
+        ordering: Store.Ordering
+    ) {
+        switch ordering {
+        case .relaxed:
+            unsafe swift_cpu_atomic_store_relaxed_u64_v1(pointer, value)
+
+        case .releasing:
+            unsafe swift_cpu_atomic_store_release_u64_v1(pointer, value)
+        }
+    }
+}
