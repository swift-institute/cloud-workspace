+        }
+
+        @Test
+        func `Serialization appends instead of replacing`() {
+            var serialized = bytes(0xFF)
+
+            CPU.Timestamp(0).serialize(into: &serialized)
+
+            #expect(serialized == bytes(0xFF, 0, 0, 0, 0, 0, 0, 0, 0))
