Subject: [PATCH 6/9] test function naming: CamelCase test functions renamed to
 backticked sentences (tests only; type-checked, not run; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 Tests/CPU Tests/CPU.Logical Tests.swift | 4 ++--
 Tests/CPU Tests/CPU.NUMA Tests.swift    | 2 +-
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/Tests/CPU Tests/CPU.Logical Tests.swift b/Tests/CPU Tests/CPU.Logical Tests.swift
index e7682ef..6eccb99 100644
--- a/Tests/CPU Tests/CPU.Logical Tests.swift	
+++ b/Tests/CPU Tests/CPU.Logical Tests.swift	
@@ -2,14 +2,14 @@ import CPU
 import Testing
 
 @Suite struct CPULogicalTests {
-    @Test func countAndIdentifierHaveDistinctRoles() {
+    @Test func `count and identifier have distinct roles`() {
         let count = CPU.Logical.Count(_unchecked: Cardinal(4 as UInt))
         let id = CPU.Logical.ID(_unchecked: Ordinal(3 as UInt))
         #expect(Int(count) == 4)
         #expect(Int(id) == 3)
     }
 
-    @Test func coreCountConvertsToInt() {
+    @Test func `core count converts to int`() {
         let count = CPU.Core.Count(_unchecked: Cardinal(2 as UInt))
         #expect(Int(count) == 2)
     }
diff --git a/Tests/CPU Tests/CPU.NUMA Tests.swift b/Tests/CPU Tests/CPU.NUMA Tests.swift
