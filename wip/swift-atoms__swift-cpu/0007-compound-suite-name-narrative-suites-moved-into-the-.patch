Subject: [PATCH 7/7] compound suite name: narrative suites moved into the test
 file's namespace or the parent suite's extension (names and test IDs kept;
 tests only; Linux x86_64, Swift 6.4.2) (coenttb/work#242)

---
 .../CPU Binary Serializer Tests.swift         | 66 ++++++++++---------
 1 file changed, 34 insertions(+), 32 deletions(-)

diff --git a/Tests/Decision CPU Binary Serializer Tests/CPU Binary Serializer Tests.swift b/Tests/Decision CPU Binary Serializer Tests/CPU Binary Serializer Tests.swift
index 8e2e65a..e4f262c 100644
--- a/Tests/Decision CPU Binary Serializer Tests/CPU Binary Serializer Tests.swift	
+++ b/Tests/Decision CPU Binary Serializer Tests/CPU Binary Serializer Tests.swift	
@@ -15,37 +15,39 @@
         patterns.map(Byte.init(bitPattern:))
     }
 
-    @Suite
-    struct `CPU Binary Serializer Tests` {
-        @Test
-        func `Timestamp serializes its UInt64 raw value`() {
-            let serialized = serializedBytes(CPU.Timestamp(0x0102_0304_0506_0708))
-
-            #if _endian(little)
-                #expect(serialized == bytes(0x08, 0x07, 0x06, 0x05, 0x04, 0x03, 0x02, 0x01))
-            #else
-                #expect(serialized == bytes(0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08))
-            #endif
+extension `CPU Binary Serializer Tests`.`CPU Binary Serializer Tests` {
+        @Suite
+        struct `CPU Binary Serializer Tests` {
+            @Test
+            func `Timestamp serializes its UInt64 raw value`() {
+                let serialized = serializedBytes(CPU.Timestamp(0x0102_0304_0506_0708))
+
+                #if _endian(little)
+                    #expect(serialized == bytes(0x08, 0x07, 0x06, 0x05, 0x04, 0x03, 0x02, 0x01))
+                #else
+                    #expect(serialized == bytes(0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08))
+                #endif
+            }
+
+            @Test
+            func `Cyclic checksum serializes its UInt32 raw value`() {
+                let serialized = serializedBytes(CPU.Integrity.Cyclic.Checksum(0x0102_0304))
+
+                #if _endian(little)
+                    #expect(serialized == bytes(0x04, 0x03, 0x02, 0x01))
+                #else
+                    #expect(serialized == bytes(0x01, 0x02, 0x03, 0x04))
+                #endif
+            }
+
+            @Test
+            func `Serialization appends instead of replacing`() {
+                var serialized = bytes(0xFF)
+
+                CPU.Timestamp(0).serialize(into: &serialized)
+
+                #expect(serialized == bytes(0xFF, 0, 0, 0, 0, 0, 0, 0, 0))
+            }
         }
-
-        @Test
-        func `Cyclic checksum serializes its UInt32 raw value`() {
-            let serialized = serializedBytes(CPU.Integrity.Cyclic.Checksum(0x0102_0304))
-
-            #if _endian(little)
-                #expect(serialized == bytes(0x04, 0x03, 0x02, 0x01))
-            #else
-                #expect(serialized == bytes(0x01, 0x02, 0x03, 0x04))
-            #endif
-        }
-
-        @Test
-        func `Serialization appends instead of replacing`() {
-            var serialized = bytes(0xFF)
-
-            CPU.Timestamp(0).serialize(into: &serialized)
-
-            #expect(serialized == bytes(0xFF, 0, 0, 0, 0, 0, 0, 0, 0))
-        }
-    }
+}
 #endif
