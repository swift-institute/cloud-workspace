Date: Sat, 7 Nov 2026 18:48:51 +0000
Subject: [PATCH] compound suite name: narrative suites move into extension
 <Type> named after their test file, nested suites into extension
 <Type>.<Parent> (overnight/compound-suites.py); parse-checked; builds pending
 (coenttb/work#242)

---
 Tests/CPU Tests/CPU.Atomic Tests.swift  |  2 ++
 Tests/CPU Tests/CPU.Barrier Tests.swift | 22 ++++++++++++----------
 Tests/CPU Tests/CPU.Cache Tests.swift   |  2 ++
 3 files changed, 16 insertions(+), 10 deletions(-)

diff --git a/Tests/CPU Tests/CPU.Atomic Tests.swift b/Tests/CPU Tests/CPU.Atomic Tests.swift
index 7413ea2..a5b3cc1 100644
--- a/Tests/CPU Tests/CPU.Atomic Tests.swift	
+++ b/Tests/CPU Tests/CPU.Atomic Tests.swift	
@@ -22,7 +22,9 @@ struct `CPU.Atomic Tests` {
     func `Store namespace exists`() {
         _ = CPU.Atomic.Store.self
     }
+}
 
+extension `CPU.Atomic Tests` {
     @Suite
     struct `Load Ordering Tests` {
         @Test
diff --git a/Tests/CPU Tests/CPU.Barrier Tests.swift b/Tests/CPU Tests/CPU.Barrier Tests.swift
index 3d7a224..8e7cf3f 100644
--- a/Tests/CPU Tests/CPU.Barrier Tests.swift	
+++ b/Tests/CPU Tests/CPU.Barrier Tests.swift	
@@ -8,6 +8,18 @@ struct `CPU.Barrier Tests` {
     @Suite struct `Edge Case` {}
     @Suite struct Integration {}
 
+    @Test
+    func `compiler barrier alone does not synchronize threads`() {
+
+        var value = 0
+        CPU.Barrier.compiler()
+        value = 1
+        CPU.Barrier.compiler()
+        #expect(value == 1)
+    }
+}
+
+extension `CPU.Barrier Tests` {
     @Suite
     struct `Compiler Tests` {
         @Test
@@ -49,14 +61,4 @@ struct `CPU.Barrier Tests` {
             }
         }
     }
-
-    @Test
-    func `compiler barrier alone does not synchronize threads`() {
-
-        var value = 0
-        CPU.Barrier.compiler()
-        value = 1
-        CPU.Barrier.compiler()
-        #expect(value == 1)
-    }
 }
diff --git a/Tests/CPU Tests/CPU.Cache Tests.swift b/Tests/CPU Tests/CPU.Cache Tests.swift
index 421c03d..5e87e62 100644
--- a/Tests/CPU Tests/CPU.Cache Tests.swift	
+++ b/Tests/CPU Tests/CPU.Cache Tests.swift	
@@ -7,7 +7,9 @@ struct `CPU.Cache Tests` {
