Subject: [PATCH 2/2] statement where expression fits: single-value if/else
 chains written as if expressions (type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 Sources/Package Graph CLI/PackageGraph.swift | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/Sources/Package Graph CLI/PackageGraph.swift b/Sources/Package Graph CLI/PackageGraph.swift
index 14f5c8e..42cab35 100644
--- a/Sources/Package Graph CLI/PackageGraph.swift	
+++ b/Sources/Package Graph CLI/PackageGraph.swift	
@@ -156,10 +156,10 @@ extension PackageGraph {
 
     fileprivate static func resolveRoot(_ override: Swift.String) -> Path::Path {
         let rootString: Swift.String
-        if override.isEmpty {
-            rootString = unsafe currentWorkingDirectory()
+        rootString = if override.isEmpty {
+            unsafe currentWorkingDirectory()
         } else {
-            rootString = override
+            override
         }
         do throws(Path::Path.Error) {
             return try Path::Path(rootString)
