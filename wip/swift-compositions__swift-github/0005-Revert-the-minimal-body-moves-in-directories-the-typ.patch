From 8263fe5af4801fef2c6b67c9abc2c80421be1050 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 23:43:39 +0000
Subject: [PATCH 5/8] Revert the minimal-body moves in directories the
 type-check can't verify (macros, C shims) (coenttb/work#242)

---
 Sources/GitHub App/GitHub.App.Permission.swift | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/Sources/GitHub App/GitHub.App.Permission.swift b/Sources/GitHub App/GitHub.App.Permission.swift
index 47259ea..6e82c7a 100644
--- a/Sources/GitHub App/GitHub.App.Permission.swift	
+++ b/Sources/GitHub App/GitHub.App.Permission.swift	
@@ -1,6 +1,7 @@
 public import GitHub_Standard
 
 extension GitHub.App {
+
     public struct Permission: Sendable, Equatable, Comparable {
         public let name: Swift.String
         public let level: Swift.String
@@ -9,16 +10,15 @@ extension GitHub.App {
             self.name = name
             self.level = level
         }
-    }
-}
 
-extension GitHub.App.Permission {
-    public static func < (lhs: Self, rhs: Self) -> Bool {
-        lhs.name == rhs.name ? lhs.level < rhs.level : lhs.name < rhs.name
+        public static func < (lhs: Self, rhs: Self) -> Bool {
+            lhs.name == rhs.name ? lhs.level < rhs.level : lhs.name < rhs.name
+        }
     }
 }
 
 extension GitHub.App.Permission {
+
     public init(argument: Swift.String) throws(GitHub.App.Error) {
         let halves = argument.split(separator: "=", omittingEmptySubsequences: false)
         guard halves.count == 2 else {
@@ -41,5 +41,6 @@ extension GitHub.App.Permission {
 }
 
 extension GitHub.App.Permission {
+
     var field: Swift.String { "permissions[\(name)]=\(level)" }
 }
