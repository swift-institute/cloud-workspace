From cbc908a520226484850e3755ac1d7871d3434f6a Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 20:52:44 +0000
Subject: [PATCH 2/3] extension file naming: member-only and
 standard-library-conformance extension files merge into their type's own file
 (overnight/merge-extension-files.py); single type per file: additional types
 move to their own <Parent>.<Name>.swift inside the container's extension
 (overnight/split-types.py); parse-checked; builds pending (coenttb/work#242)

---
 Sources/Geometry/Geometry.Insets.swift | 6 ------
 Sources/Geometry/Geometry.swift        | 6 ++++++
 2 files changed, 6 insertions(+), 6 deletions(-)
 delete mode 100644 Sources/Geometry/Geometry.Insets.swift

diff --git a/Sources/Geometry/Geometry.Insets.swift b/Sources/Geometry/Geometry.Insets.swift
deleted file mode 100644
index 88d361a..0000000
--- a/Sources/Geometry/Geometry.Insets.swift
+++ /dev/null
@@ -1,6 +0,0 @@
-public import Inset
-
-extension Geometry {
-
-    public typealias Insets = Inset<2, Scalar>
-}
diff --git a/Sources/Geometry/Geometry.swift b/Sources/Geometry/Geometry.swift
index 0d87633..af10c28 100644
--- a/Sources/Geometry/Geometry.swift
+++ b/Sources/Geometry/Geometry.swift
@@ -1,4 +1,5 @@
 public import Linear
+public import Inset
 
 public enum Geometry<Scalar: ~Copyable, Space>: ~Copyable {}
 
@@ -107,3 +108,8 @@ extension Geometry.Magnitude where Scalar: AdditiveArithmetic {
         Self(Linear<Scalar, Space>.Magnitude(.zero))
     }
 }
+
+extension Geometry {
+
+    public typealias Insets = Inset<2, Scalar>
+}
