From e7303e64084eb77d69f883f0101e396acd949823 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:33:59 +0000
Subject: [PATCH 5/7] counter loop iteration: range loops without early exit
 written as forEach (type-check follows; Linux x86_64, Swift 6.4.2)
 (coenttb/work#242)

---
 Sources/Geometry/Affine/Geometry.Line.swift | 6 +++---
 Sources/Geometry/Geometry+Arithmetic.swift  | 6 +++---
 2 files changed, 6 insertions(+), 6 deletions(-)

diff --git a/Sources/Geometry/Affine/Geometry.Line.swift b/Sources/Geometry/Affine/Geometry.Line.swift
index 854d43d..85ed9aa 100644
--- a/Sources/Geometry/Affine/Geometry.Line.swift
+++ b/Sources/Geometry/Affine/Geometry.Line.swift
@@ -91,15 +91,15 @@
         where Scalar: FloatingPoint {
             var result: [Geometry.Point<2>] = []
             let edges = ngon.edges
-            for i in 0..<N {
+            (0..<N).forEach { i in
 
                 let seg = edges[i]
                 let segLine = Geometry.line(extending: seg)
-                guard let pt = intersection(with: segLine) else { continue }
+                guard let pt = intersection(with: segLine) else { return }
 
                 let displacement = Geometry.vector(of: seg)
                 let lenSq = displacement.dx * displacement.dx + displacement.dy * displacement.dy
-                guard lenSq > .zero else { continue }
+                guard lenSq > .zero else { return }
 
                 let vx: Linear<Scalar, Space>.Dx = pt.x - seg.start.x
                 let vy: Linear<Scalar, Space>.Dy = pt.y - seg.start.y
diff --git a/Sources/Geometry/Geometry+Arithmetic.swift b/Sources/Geometry/Geometry+Arithmetic.swift
index daeb99e..4bfb23c 100644
--- a/Sources/Geometry/Geometry+Arithmetic.swift
+++ b/Sources/Geometry/Geometry+Arithmetic.swift
@@ -107,7 +107,7 @@ extension Geometry.Size where Scalar: AdditiveArithmetic {
     @_disfavoredOverload
     public static func + (lhs: borrowing Self, rhs: borrowing Self) -> Self {
         var result = InlineArray<N, Scalar>(repeating: .zero)
-        for i in 0..<N {
+        (0..<N).forEach { i in
             result[i] = lhs.dimensions[i] + rhs.dimensions[i]
         }
         return Self(result)
@@ -117,7 +117,7 @@ extension Geometry.Size where Scalar: AdditiveArithmetic {
     @_disfavoredOverload
     public static func - (lhs: borrowing Self, rhs: borrowing Self) -> Self {
         var result = InlineArray<N, Scalar>(repeating: .zero)
-        for i in 0..<N {
+        (0..<N).forEach { i in
             result[i] = lhs.dimensions[i] - rhs.dimensions[i]
         }
         return Self(result)
@@ -130,7 +130,7 @@ extension Geometry.Size where Scalar: SignedNumeric {
     @_disfavoredOverload
     public static prefix func - (value: borrowing Self) -> Self {
         var result = InlineArray<N, Scalar>(repeating: .zero)
-        for i in 0..<N {
+        (0..<N).forEach { i in
             result[i] = -value.dimensions[i]
         }
         return Self(result)
-- 
