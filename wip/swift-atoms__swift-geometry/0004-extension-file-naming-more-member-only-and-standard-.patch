From cf3f88bc9aef3922d22558e469268f401f6c7ac9 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 01:37:26 +0000
Subject: [PATCH 4/5] extension file naming: more member-only and
 standard-library extension files merge into their type's file; single type
 per file: more additional types move to their own files
 (merge-extension-files.py, split-types.py); parse-checked; root build pending
 (coenttb/work#242)

---
 Sources/Geometry/Geometry.Magnitude.swift | 15 +++++++++++++++
 Sources/Geometry/Geometry.swift           | 10 ----------
 2 files changed, 15 insertions(+), 10 deletions(-)
 create mode 100644 Sources/Geometry/Geometry.Magnitude.swift

diff --git a/Sources/Geometry/Geometry.Magnitude.swift b/Sources/Geometry/Geometry.Magnitude.swift
new file mode 100644
index 0000000..6ecad15
--- /dev/null
+++ b/Sources/Geometry/Geometry.Magnitude.swift
@@ -0,0 +1,15 @@
+public import Linear
+public import Inset
+
+
+extension Geometry {
+    public struct Magnitude {
+
+        public var underlying: Linear<Scalar, Space>.Magnitude
+
+        @inlinable
+        public init(_ rawValue: Linear<Scalar, Space>.Magnitude) {
+            self.underlying = rawValue
+        }
+    }
+}
diff --git a/Sources/Geometry/Geometry.swift b/Sources/Geometry/Geometry.swift
index af10c28..493bb37 100644
--- a/Sources/Geometry/Geometry.swift
+++ b/Sources/Geometry/Geometry.swift
@@ -39,16 +39,6 @@ extension Geometry {
 }
 
 extension Geometry {
-
-    public struct Magnitude {
-
-        public var underlying: Linear<Scalar, Space>.Magnitude
-
-        @inlinable
-        public init(_ rawValue: Linear<Scalar, Space>.Magnitude) {
-            self.underlying = rawValue
-        }
-    }
 }
 
 extension Geometry.Magnitude: Sendable where Scalar: Sendable {}
