+                    if magnitude < 0.000001 {
+                        .nanoseconds
+                    } else if magnitude < 0.001 {
+                        .microseconds
+                    } else if magnitude < 1 {
+                        .milliseconds
+                    } else {
+                        .seconds
+                    }
             } else {
                 selected = unit
             }
