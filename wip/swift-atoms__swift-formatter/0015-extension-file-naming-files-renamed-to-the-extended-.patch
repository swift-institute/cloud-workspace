similarity index 100%
rename from Sources/Formatter/Absorbed/swift-byte-formatter/Byte Size Formatter/BinaryInteger+Byte.Size.Formatter.swift
rename to Sources/Formatter/Absorbed/swift-byte-formatter/Byte Size Formatter/BinaryInteger.swift
diff --git a/Sources/Formatter/Absorbed/swift-format-formatter/Format Formatter/BinaryFloatingPoint+Formatter.swift b/Sources/Formatter/Absorbed/swift-format-formatter/Format Formatter/BinaryFloatingPoint.swift
similarity index 100%
rename from Sources/Formatter/Absorbed/swift-format-formatter/Format Formatter/BinaryFloatingPoint+Formatter.swift
rename to Sources/Formatter/Absorbed/swift-format-formatter/Format Formatter/BinaryFloatingPoint.swift
