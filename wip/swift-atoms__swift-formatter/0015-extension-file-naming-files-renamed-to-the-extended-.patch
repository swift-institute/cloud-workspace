rename to Sources/Formatter/Absorbed/swift-format-formatter/Format Formatter/StringProtocol.swift
diff --git a/Sources/Formatter/Absorbed/swift-radix-formatter/Radix Formatter/BinaryInteger+Radix.Formatter.swift b/Sources/Formatter/Absorbed/swift-radix-formatter/Radix Formatter/Swift.BinaryInteger.swift
similarity index 100%
rename from Sources/Formatter/Absorbed/swift-radix-formatter/Radix Formatter/BinaryInteger+Radix.Formatter.swift
rename to Sources/Formatter/Absorbed/swift-radix-formatter/Radix Formatter/Swift.BinaryInteger.swift
diff --git a/Sources/Formatter/BitPattern/Bit.Pattern.Mask+Bit.Formatter.swift b/Sources/Formatter/BitPattern/Bit.Pattern.Mask.swift
