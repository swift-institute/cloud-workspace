diff --git a/Sources/Formatter/Absorbed/swift-radix-formatter/Radix Formatter/Radix.Formatter+Chaining.swift b/Sources/Formatter/Absorbed/swift-radix-formatter/Radix Formatter/Radix.Formatter+Chaining.swift
