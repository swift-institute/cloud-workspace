From 377fa72303a510558643e1650e2021d15695a251 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:46:09 +0000
Subject: [PATCH 16/20] extension file naming: member-only extension files
 merged into the extended type's own file (type-check follows; Linux x86_64,
 Swift 6.4.2) (coenttb/work#242)

---
 .../Byte Size Formatter/BinaryInteger.swift     | 17 +++++++++++++++++
 .../BinaryInteger+Formatter.swift               | 16 ----------------
 2 files changed, 17 insertions(+), 16 deletions(-)
 delete mode 100644 Sources/Formatter/Absorbed/swift-format-formatter/Format Formatter/BinaryInteger+Formatter.swift

diff --git a/Sources/Formatter/Absorbed/swift-byte-formatter/Byte Size Formatter/BinaryInteger.swift b/Sources/Formatter/Absorbed/swift-byte-formatter/Byte Size Formatter/BinaryInteger.swift
index 4416c26..3004ece 100644
--- a/Sources/Formatter/Absorbed/swift-byte-formatter/Byte Size Formatter/BinaryInteger.swift	
+++ b/Sources/Formatter/Absorbed/swift-byte-formatter/Byte Size Formatter/BinaryInteger.swift	
@@ -8,3 +8,20 @@
 
     }
 #endif
+
+#if Conversions
+    extension BinaryInteger {
+
+        @inlinable
+        public func formatted<F>(_ format: F) -> F.Output
+        where Self == F.Input, F: Formatter.`Protocol`, F.Failure == Never {
+            format.format(self)
+        }
+
+        @inlinable
+        public func formatted<F>(_ format: F) -> F.Output
+        where F: Formatter.`Protocol`, F.Input: Swift::BinaryInteger, F.Failure == Never {
+            format.format(F.Input(self))
+        }
+    }
+#endif
diff --git a/Sources/Formatter/Absorbed/swift-format-formatter/Format Formatter/BinaryInteger+Formatter.swift b/Sources/Formatter/Absorbed/swift-format-formatter/Format Formatter/BinaryInteger+Formatter.swift
deleted file mode 100644
index 85ad3b2..0000000
--- a/Sources/Formatter/Absorbed/swift-format-formatter/Format Formatter/BinaryInteger+Formatter.swift	
+++ /dev/null
@@ -1,16 +0,0 @@
-#if Conversions
-    extension BinaryInteger {
-
-        @inlinable
-        public func formatted<F>(_ format: F) -> F.Output
-        where Self == F.Input, F: Formatter.`Protocol`, F.Failure == Never {
-            format.format(self)
-        }
-
-        @inlinable
-        public func formatted<F>(_ format: F) -> F.Output
-        where F: Formatter.`Protocol`, F.Input: Swift::BinaryInteger, F.Failure == Never {
-            format.format(F.Input(self))
-        }
-    }
-#endif
