From 94aaedb15464c36dcbaa2e9e4389549a87a82713 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:27:07 +0000
Subject: [PATCH 10/25] compound suite name: narrative suites moved into the
 test file's namespace or the parent suite's extension (names and test IDs
 kept; tests only; Linux x86_64, Swift 6.4.2) (coenttb/work#242)

---
 .../Formatter Tests/Format Tagged Tests.swift | 42 ++++++++++---------
 1 file changed, 22 insertions(+), 20 deletions(-)

diff --git a/Tests/Formatter Tests/Format Tagged Tests.swift b/Tests/Formatter Tests/Format Tagged Tests.swift
index e4ae763..5094ac5 100644
--- a/Tests/Formatter Tests/Format Tagged Tests.swift	
+++ b/Tests/Formatter Tests/Format Tagged Tests.swift	
@@ -3,31 +3,33 @@
     import Tagged
     import Testing
 
-    @Suite
-    struct `Format Tagged Tests` {
-        private enum Measurement {}
+extension `Format Tagged Tests`.`Format Tagged Tests` {
+        @Suite
+        struct `Format Tagged Tests` {
+            private enum Measurement {}
 
-        @Test
-        func `Number format delegates to the tagged floating point`() {
-            let value = Tagged<Measurement, Double>(_unchecked: 12.5)
+            @Test
+            func `Number format delegates to the tagged floating point`() {
+                let value = Tagged<Measurement, Double>(_unchecked: 12.5)
 
-            #expect(value.formatted(Formatter.Number()) == "12.5")
-        }
+                #expect(value.formatted(Formatter.Number()) == "12.5")
+            }
 
-        @Test
-        func `Precision and rounding remain available`() {
-            let value = Tagged<Measurement, Double>(_unchecked: 12.375)
-            let rounded = Tagged<Measurement, Double>(_unchecked: 2.6)
+            @Test
+            func `Precision and rounding remain available`() {
+                let value = Tagged<Measurement, Double>(_unchecked: 12.375)
+                let rounded = Tagged<Measurement, Double>(_unchecked: 2.6)
 
-            #expect(value.formatted(Formatter.Number(fractionDigits: 2)) == "12.38")
-            #expect(rounded.formatted(Formatter.Number(fractionDigits: 0)) == "3")
-        }
+                #expect(value.formatted(Formatter.Number(fractionDigits: 2)) == "12.38")
+                #expect(rounded.formatted(Formatter.Number(fractionDigits: 0)) == "3")
+            }
 
-        @Test
-        func `Percent format scales the underlying value`() {
-            let value = Tagged<Measurement, Double>(_unchecked: 0.125)
+            @Test
+            func `Percent format scales the underlying value`() {
+                let value = Tagged<Measurement, Double>(_unchecked: 0.125)
 
-            #expect(value.formatted(Formatter.Number(fractionDigits: 1, scale: .percent)) == "12.5%")
+                #expect(value.formatted(Formatter.Number(fractionDigits: 1, scale: .percent)) == "12.5%")
+            }
         }
-    }
+}
 #endif
