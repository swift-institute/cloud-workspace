From 491cc7a96b723a5a029891cb226b0b548c12bf01 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:27:40 +0000
Subject: [PATCH 11/11] minimal type body: more non-stored members moved into
 an extension of their type (batch 10; type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 .../Formatter/Number/Formatter.Number.swift    | 12 +++++++-----
 .../Formatter/Time/Formatter.Duration.swift    | 18 ++++++++++--------
 2 files changed, 17 insertions(+), 13 deletions(-)

diff --git a/Sources/Formatter/Number/Formatter.Number.swift b/Sources/Formatter/Number/Formatter.Number.swift
index 3dd4776..061a24e 100644
--- a/Sources/Formatter/Number/Formatter.Number.swift
+++ b/Sources/Formatter/Number/Formatter.Number.swift
@@ -1,11 +1,6 @@
 #if Number
     extension Formatter {
         public struct Number: Sendable {
-            public enum Scale: Sendable {
-                case number
-                case percent
-            }
-
             public let fractionDigits: Int?
             public let rounding: FloatingPointRoundingRule
             public let scale: Scale
@@ -26,6 +21,13 @@
         }
     }
 
+extension Formatter.Number {
+        public enum Scale: Sendable {
+            case number
+            case percent
+        }
+}
+
     extension Formatter.Number: Formatter.`Protocol` {
         public typealias Input = Double
         public typealias Output = String
diff --git a/Sources/Formatter/Time/Formatter.Duration.swift b/Sources/Formatter/Time/Formatter.Duration.swift
index 1608115..d3f9618 100644
--- a/Sources/Formatter/Time/Formatter.Duration.swift
+++ b/Sources/Formatter/Time/Formatter.Duration.swift
@@ -2,14 +2,6 @@
     extension Formatter {
         public struct Duration<Numeric: Formatter.`Protocol`>
         where Numeric.Input == Double, Numeric.Output == String {
-            public enum Unit: Sendable, Equatable {
-                case auto, nanoseconds, microseconds, milliseconds, seconds
-            }
-
-            public enum Notation: Sendable, Equatable {
-                case spaced, compactName
-            }
-
             public let numeric: Numeric
             public let unit: Unit
             public let notation: Notation
@@ -26,6 +18,16 @@
         }
     }
 
+extension Formatter.Duration {
+        public enum Unit: Sendable, Equatable {
+            case auto, nanoseconds, microseconds, milliseconds, seconds
+        }
+
+        public enum Notation: Sendable, Equatable {
+            case spaced, compactName
+        }
+}
+
     extension Formatter.Duration.Unit {
         public var symbol: String {
             switch self {
-- 
