Subject: [PATCH] compound suite name: narrative suites move into extension
 <Type> named after their test file, nested suites into extension
 <Type>.<Parent> (overnight/compound-suites.py); parse-checked; builds pending
 (coenttb/work#242)

---
 Tests/Formatter Tests/Pair as Formatter Tests.swift | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/Tests/Formatter Tests/Pair as Formatter Tests.swift b/Tests/Formatter Tests/Pair as Formatter Tests.swift
index 0db24b6..3db2593 100644
--- a/Tests/Formatter Tests/Pair as Formatter Tests.swift	
+++ b/Tests/Formatter Tests/Pair as Formatter Tests.swift	
@@ -34,8 +34,13 @@ private struct SecondFailure: Swift::Error, Equatable {
 
 @Suite
 struct `Paired formatters route inputs and preserve output and failure order` {
+}
+
+extension `Paired formatters route inputs and preserve output and failure order` {
     @Suite struct `Paired formatters preserve both outputs and their input routing` {}
+
     @Suite struct `Paired formatter failures identify their side and stop subsequent work` {}
+
     @Suite struct `No paired formatter integration cases are defined` {}
 }
 
