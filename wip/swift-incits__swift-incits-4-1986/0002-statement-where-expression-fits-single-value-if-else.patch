From 6b3d44df35d15845a7abe15dbeb5ee5783e3f0de Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:35:30 +0000
Subject: [PATCH 2/3] statement where expression fits: single-value if/else
 chains written as if expressions (type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 Sources/INCITS 4 1986/INCITS_4_1986.ASCII.swift | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/Sources/INCITS 4 1986/INCITS_4_1986.ASCII.swift b/Sources/INCITS 4 1986/INCITS_4_1986.ASCII.swift
index d13fb25..3fdee37 100644
--- a/Sources/INCITS 4 1986/INCITS_4_1986.ASCII.swift	
+++ b/Sources/INCITS 4 1986/INCITS_4_1986.ASCII.swift	
@@ -128,12 +128,12 @@ where Source: Swift::Collection, Source.Element == ASCII::ASCII.Code {
                 ranges.append(lineStart..<index)
 
                 let next = source.index(after: index)
-                if next < source.endIndex && source[next] == .lf {
+                index = if next < source.endIndex && source[next] == .lf {
 
-                    index = source.index(after: next)
+                    source.index(after: next)
                 } else {
 
-                    index = next
+                    next
                 }
                 lineStart = index
             } else if code == .lf {
