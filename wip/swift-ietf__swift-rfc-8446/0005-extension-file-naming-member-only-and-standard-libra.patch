From c8499c3e028a911eacc662006df208ad5600c3fe Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 20:52:53 +0000
Subject: [PATCH 05/10] extension file naming: member-only and
 standard-library-conformance extension files merge into their type's own file
 (overnight/merge-extension-files.py); single type per file: additional types
 move to their own <Parent>.<Name>.swift inside the container's extension
 (overnight/split-types.py); parse-checked; builds pending (coenttb/work#242)

---
 .../RFC_8446.Handshake.MessageType.swift         | 16 ++++++++++++++++
 Sources/RFC 8446/RFC_8446.Handshake.swift        | 12 ------------
 2 files changed, 16 insertions(+), 12 deletions(-)
 create mode 100644 Sources/RFC 8446/RFC_8446.Handshake.MessageType.swift

diff --git a/Sources/RFC 8446/RFC_8446.Handshake.MessageType.swift b/Sources/RFC 8446/RFC_8446.Handshake.MessageType.swift
new file mode 100644
index 0000000..9608763
--- /dev/null
+++ b/Sources/RFC 8446/RFC_8446.Handshake.MessageType.swift	
@@ -0,0 +1,16 @@
+public import Binary
+
+
+extension RFC_8446.Handshake {
+    public struct MessageType: RawRepresentable, Sendable, Hashable, Codable {
+        public let rawValue: UInt8
+
+        public init(rawValue: UInt8) {
+            self.rawValue = rawValue
+        }
+
+        init(__unchecked: Void, rawValue: UInt8) {
+            self.rawValue = rawValue
+        }
+    }
+}
diff --git a/Sources/RFC 8446/RFC_8446.Handshake.swift b/Sources/RFC 8446/RFC_8446.Handshake.swift
index 6358338..40c28a8 100644
--- a/Sources/RFC 8446/RFC_8446.Handshake.swift	
+++ b/Sources/RFC 8446/RFC_8446.Handshake.swift	
@@ -6,18 +6,6 @@ extension RFC_8446 {
 }
 
 extension RFC_8446.Handshake {
-
-    public struct MessageType: RawRepresentable, Sendable, Hashable, Codable {
-        public let rawValue: UInt8
-
-        public init(rawValue: UInt8) {
-            self.rawValue = rawValue
-        }
-
-        init(__unchecked: Void, rawValue: UInt8) {
-            self.rawValue = rawValue
-        }
-    }
 }
 
 extension RFC_8446.Handshake.MessageType: CustomStringConvertible {
