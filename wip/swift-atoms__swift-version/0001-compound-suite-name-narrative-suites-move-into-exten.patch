diff --git a/Tests/Version Calendar Parser Tests/Version.Calendar Tests.swift b/Tests/Version Calendar Parser Tests/Version.Calendar Tests.swift
index 161177f..63b1042 100644
--- a/Tests/Version Calendar Parser Tests/Version.Calendar Tests.swift	
