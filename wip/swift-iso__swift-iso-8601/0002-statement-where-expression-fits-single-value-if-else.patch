From 78ac67e4f6d8d6c88413513b2f1796b720fe98a4 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:35:31 +0000
Subject: [PATCH 2/2] statement where expression fits: single-value if/else
 chains written as if expressions (type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 Sources/ISO 8601/ISO_8601.RecurringInterval.Formatter.swift | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/Sources/ISO 8601/ISO_8601.RecurringInterval.Formatter.swift b/Sources/ISO 8601/ISO_8601.RecurringInterval.Formatter.swift
index 5b398b6..f4761dc 100644
--- a/Sources/ISO 8601/ISO_8601.RecurringInterval.Formatter.swift	
+++ b/Sources/ISO 8601/ISO_8601.RecurringInterval.Formatter.swift	
@@ -7,10 +7,10 @@ extension ISO_8601.RecurringInterval.Formatter {
 
     public static func format(_ value: ISO_8601.RecurringInterval) -> String {
         let prefix: String
-        if let reps = value.repetitions {
-            prefix = "R\(reps)"
+        prefix = if let reps = value.repetitions {
+            "R\(reps)"
         } else {
-            prefix = "R"
+            "R"
         }
 
         let intervalStr = ISO_8601.Interval.Formatter.format(value.interval)
