From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 07:42:59 +0000
Subject: [PATCH 3/3] swift-format with the Institute configuration on files
 this session changed (coenttb/work#242)

---
 .../ISO_8601.RecurringInterval.Formatter.swift        | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/Sources/ISO 8601/ISO_8601.RecurringInterval.Formatter.swift b/Sources/ISO 8601/ISO_8601.RecurringInterval.Formatter.swift
index f4761dc..d97b54e 100644
--- a/Sources/ISO 8601/ISO_8601.RecurringInterval.Formatter.swift	
+++ b/Sources/ISO 8601/ISO_8601.RecurringInterval.Formatter.swift	
@@ -7,11 +7,12 @@ extension ISO_8601.RecurringInterval.Formatter {
 
     public static func format(_ value: ISO_8601.RecurringInterval) -> String {
         let prefix: String
-        prefix = if let reps = value.repetitions {
-            "R\(reps)"
-        } else {
-            "R"
-        }
+        prefix =
+            if let reps = value.repetitions {
+                "R\(reps)"
+            } else {
+                "R"
+            }
 
         let intervalStr = ISO_8601.Interval.Formatter.format(value.interval)
         return "\(prefix)/\(intervalStr)"
