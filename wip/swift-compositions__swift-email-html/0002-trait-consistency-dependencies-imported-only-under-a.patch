From e476d587416acbbbf5be1473a4dbe213d1112825 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:24:53 +0000
Subject: [PATCH 2/2] trait consistency: dependencies imported only under a
 trait get that trait's condition (runner repair; Linux x86_64, Swift 6.4.2)
 (coenttb/work#242)

---
 Package.swift | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Package.swift b/Package.swift
index 014c077..957c549 100644
--- a/Package.swift
+++ b/Package.swift
@@ -81,7 +81,7 @@ let package = Package(
         .target(
             name: "Email HTML Rendering",
             dependencies: [
-                .product(name: "Email Standard", package: "swift-email-standard"),
+                .product(name: "Email Standard", package: "swift-email-standard", condition: .when(traits: ["EmailHTMLRendering"])),
                 .product(name: "HTML", package: "swift-html", condition: .when(traits: ["EmailHTMLRendering"])),
                 .product(name: "HTML Rendering Core", package: "swift-html-render", condition: .when(traits: ["EmailHTMLRendering"])),
                 .product(name: "CSS Theming", package: "swift-css", condition: .when(traits: ["EmailHTMLRendering"])),
