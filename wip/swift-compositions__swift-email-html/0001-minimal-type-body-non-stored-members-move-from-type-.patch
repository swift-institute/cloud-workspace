From b0c1f7fbb7e925c7afbabfc2ddf17ed53583be5d Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 22:39:57 +0000
Subject: [PATCH] minimal type body: non-stored members move from type bodies
 into an extension of the type in the same file (overnight/minimal-bodies.py);
 type-checked against the root build, directories that failed or couldn't be
 checked left out (coenttb/work#242)

---
 .../Email HTML Rendering/Email.Document.swift | 137 +++++++++---------
 .../Email HTML Rendering/Email.Header.swift   |  72 ++++-----
 Sources/Email HTML Rendering/Email.Link.swift |  68 ++++-----
 .../Email.Paragraph.Size.swift                |  16 +-
 .../Email.Paragraph.swift                     |  51 +++----
 .../Email HTML Rendering/Email.Spacing.swift  |  21 +--
 .../Email.VStack.Alignment.swift              |  17 ++-
 .../Email HTML Rendering/Email.VStack.swift   |  43 +++---
 8 files changed, 214 insertions(+), 211 deletions(-)

diff --git a/Sources/Email HTML Rendering/Email.Document.swift b/Sources/Email HTML Rendering/Email.Document.swift
index 1759103..d1f785d 100644
--- a/Sources/Email HTML Rendering/Email.Document.swift	
+++ b/Sources/Email HTML Rendering/Email.Document.swift	
@@ -3,9 +3,7 @@
     public import HTML
 
     extension Email {
-
         public struct Document<Content: HTML.View>: HTML.Document.`Protocol` {
-
             public let preheader: String
 
             public let content: Content
@@ -19,84 +17,85 @@
                 self.preheader = preheader
                 self.content = content()
             }
+        }
