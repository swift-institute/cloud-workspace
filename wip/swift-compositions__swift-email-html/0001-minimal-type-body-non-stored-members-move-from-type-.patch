+            table {
+                border-collapse: collapse;
+            }
 
-                @media (prefers-color-scheme: dark) {
-                    body, table, td, div {
-                        background-color: \(background.dark.description) !important;
-                    }
+            @media (prefers-color-scheme: dark) {
+                body, table, td, div {
+                    background-color: \(background.dark.description) !important;
                 }
-                """
             }
+            """
         }
-    }
