-                    meta(
-                        name: .viewport,
-                        content: "width=device-width, initial-scale=1.0, viewport-fit=cover"
-                    )
-                    HTML.Style.Element { stylesheet }
-                }
+        public var head: some HTML.View {
+            HTML.Group {
+                meta(charset: .utf8)
+                meta(
+                    name: .viewport,
+                    content: "width=device-width, initial-scale=1.0, viewport-fit=cover"
