From 67214fd6f1aef1771847970f50a69cf4c81071e9 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:34:02 +0000
Subject: [PATCH] counter loop iteration: range loops without early exit
 written as forEach (type-check follows; Linux x86_64, Swift 6.4.2)
 (coenttb/work#242)

---
 .../Darwin.Kernel.Event.Queue.swift                       | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/Sources/Darwin Kernel Event Standard/Darwin.Kernel.Event.Queue.swift b/Sources/Darwin Kernel Event Standard/Darwin.Kernel.Event.Queue.swift
index 8252d79..8b8543c 100644
--- a/Sources/Darwin Kernel Event Standard/Darwin.Kernel.Event.Queue.swift	
+++ b/Sources/Darwin Kernel Event Standard/Darwin.Kernel.Event.Queue.swift	
@@ -100,7 +100,7 @@
                 of: CKevent.self,
                 capacity: events.count
             ) { buffer throws(Darwin.Kernel.Event.Queue.Error) in
-                for i in 0..<events.count {
+                (0..<events.count).forEach { i in
                     unsafe (buffer[i] = unsafe events[i].cValue)
                 }
                 let result = unsafe _kevent(
@@ -129,7 +129,7 @@
                 of: CKevent.self,
                 capacity: events.count
             ) { buffer throws(Darwin.Kernel.Event.Queue.Error) in
-                for i in 0..<events.count {
+                (0..<events.count).forEach { i in
                     unsafe (buffer[i] = unsafe events[i].cValue)
                 }
                 let result = unsafe _kevent(
@@ -189,7 +189,7 @@
                     throw .kevent(code)
                 }
                 let eventCount = Int(result)
-                for i in 0..<eventCount {
+                (0..<eventCount).forEach { i in
                     events[i] = unsafe Event(buffer[i])
                 }
                 return eventCount
@@ -234,7 +234,7 @@
                     throw .kevent(code)
                 }
                 let eventCount = Int(result)
-                for i in 0..<eventCount {
+                (0..<eventCount).forEach { i in
                     unsafe (events[i] = unsafe Event(buffer[i]))
                 }
                 return eventCount
-- 
2.43.0

