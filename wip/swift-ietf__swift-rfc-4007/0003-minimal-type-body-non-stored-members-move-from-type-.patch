From b914cf9962c86acabdbc656552bd39426e0bf6a2 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 22:39:55 +0000
Subject: [PATCH 3/5] minimal type body: non-stored members move from type
 bodies into an extension of the type in the same file
 (overnight/minimal-bodies.py); type-checked against the root build,
 directories that failed or couldn't be checked left out (coenttb/work#242)

---
 .../RFC_4007.IPv6.ScopedAddress.Coder.swift   | 52 +++++++++----------
 .../Absorbed swift-rfc-4007-coder/Scan.swift  |  2 +
 2 files changed, 28 insertions(+), 26 deletions(-)

diff --git a/Sources/RFC 4007/Absorbed swift-rfc-4007-coder/RFC_4007.IPv6.ScopedAddress.Coder.swift b/Sources/RFC 4007/Absorbed swift-rfc-4007-coder/RFC_4007.IPv6.ScopedAddress.Coder.swift
index 4b58ab0..2b0446f 100644
--- a/Sources/RFC 4007/Absorbed swift-rfc-4007-coder/RFC_4007.IPv6.ScopedAddress.Coder.swift	
+++ b/Sources/RFC 4007/Absorbed swift-rfc-4007-coder/RFC_4007.IPv6.ScopedAddress.Coder.swift	
@@ -7,40 +7,40 @@
     import Serializer
 
     extension RFC_4007.IPv6.ScopedAddress {
-
         public struct Coder<Input: Cursor.`Protocol`<Byte, Never>, Buffer: RangeReplaceableCollection<Byte>>: Coding {
+            public init() {}
+        }
 
-            public typealias Output = RFC_4007.IPv6.ScopedAddress
+        public static var coder: Coder<ArraySlice<Byte>, [Byte]> { .init() }
+    }
 
-            public typealias Failure = RFC_4007.IPv6.ScopedAddress.Error
+extension RFC_4007.IPv6.ScopedAddress.Coder {
+        public typealias Output = RFC_4007.IPv6.ScopedAddress
 
-            public init() {}
+        public typealias Failure = RFC_4007.IPv6.ScopedAddress.Error
 
-            public borrowing func parse(_ input: inout Input) throws(Failure) -> Output {
-                let start = input.checkpoint
-                let bytes = Scan.run(&input, while: Self.isScopedAddressByte)
-                do throws(Failure) {
-                    return try RFC_4007.IPv6.ScopedAddress(ascii: bytes)
-                } catch {
-                    input.seek(to: start)
-                    throw error
-                }
+        public borrowing func parse(_ input: inout Input) throws(Failure) -> Output {
+            let start = input.checkpoint
+            let bytes = Scan.run(&input, while: Self.isScopedAddressByte)
+            do throws(Failure) {
+                return try RFC_4007.IPv6.ScopedAddress(ascii: bytes)
+            } catch {
+                input.seek(to: start)
+                throw error
             }
+        }
 
-            public borrowing func serialize(_ output: Output, into buffer: inout Buffer) throws(Failure) {
-                buffer.append(contentsOf: output.serialized)
-            }
+        public borrowing func serialize(_ output: Output, into buffer: inout Buffer) throws(Failure) {
+            buffer.append(contentsOf: output.serialized)
+        }
 
-            static func isScopedAddressByte(_ byte: UInt8) -> Bool {
-                switch byte {
-                case 0x30...0x39, 0x41...0x5A, 0x61...0x7A, 0x25, 0x2D, 0x2E, 0x3A, 0x5F:
-                    return true
-                default:
-                    return false
-                }
+        static func isScopedAddressByte(_ byte: UInt8) -> Bool {
+            switch byte {
+            case 0x30...0x39, 0x41...0x5A, 0x61...0x7A, 0x25, 0x2D, 0x2E, 0x3A, 0x5F:
+                return true
+            default:
+                return false
             }
         }
-
-        public static var coder: Coder<ArraySlice<Byte>, [Byte]> { .init() }
-    }
+}
 #endif
diff --git a/Sources/RFC 4007/Absorbed swift-rfc-4007-coder/Scan.swift b/Sources/RFC 4007/Absorbed swift-rfc-4007-coder/Scan.swift
index 485358a..32f6873 100644
--- a/Sources/RFC 4007/Absorbed swift-rfc-4007-coder/Scan.swift	
+++ b/Sources/RFC 4007/Absorbed swift-rfc-4007-coder/Scan.swift	
@@ -3,7 +3,9 @@
     import Cursor
 
     enum Scan {
+    }
 
+    extension Scan {
         static func run<Input: Cursor.`Protocol`<Byte, Never>>(
             _ input: inout Input,
             while predicate: (UInt8) -> Bool
-- 
