Subject: [PATCH] compound suite name: narrative suites move into extension
 <Type> named after their test file, nested suites into extension
 <Type>.<Parent> (overnight/compound-suites.py); parse-checked; builds pending
 (coenttb/work#242)

---
 Tests/RFC 4007 Tests/RFC 4007 Coder Tests.swift |  5 +++++
 Tests/RFC 4007 Tests/RFC_4007 Tests.swift       | 14 ++++++++++----
 2 files changed, 15 insertions(+), 4 deletions(-)

diff --git a/Tests/RFC 4007 Tests/RFC 4007 Coder Tests.swift b/Tests/RFC 4007 Tests/RFC 4007 Coder Tests.swift
index 40fc584..05e2446 100644
--- a/Tests/RFC 4007 Tests/RFC 4007 Coder Tests.swift	
+++ b/Tests/RFC 4007 Tests/RFC 4007 Coder Tests.swift	
@@ -11,8 +11,13 @@
 
     @Suite
     struct `RFC 4007 Coder Tests` {
+    }
+
+    extension `RFC 4007 Coder Tests` {
         @Suite struct `Coder Tests` {}
+
         @Suite struct `ASCII Tests` {}
+
         @Suite struct `Text Tests` {}
     }
 
diff --git a/Tests/RFC 4007 Tests/RFC_4007 Tests.swift b/Tests/RFC 4007 Tests/RFC_4007 Tests.swift
index 7ed367f..1fd73c8 100644
--- a/Tests/RFC 4007 Tests/RFC_4007 Tests.swift	
+++ b/Tests/RFC 4007 Tests/RFC_4007 Tests.swift	
@@ -2,13 +2,19 @@ import RFC_4007
 import RFC_4291
 import Testing
 
-@Suite
-struct `RFC 4007 Tests` {
+extension RFC_4007 {
+    @Suite
+    struct `RFC 4007 Tests` {
+    }
+}
+
+extension RFC_4007.`RFC 4007 Tests` {
     @Suite struct `Scoped Address Tests` {}
+
     @Suite struct `Scope Tests` {}
 }
 
-extension `RFC 4007 Tests`.`Scoped Address Tests` {
+extension RFC_4007.`RFC 4007 Tests`.`Scoped Address Tests` {
 
     @Test
     func `holds an address and a zone`() {
@@ -36,7 +42,7 @@ extension `RFC 4007 Tests`.`Scoped Address Tests` {
     }
 }
 
-extension `RFC 4007 Tests`.`Scope Tests` {
+extension RFC_4007.`RFC 4007 Tests`.`Scope Tests` {
 
     @Test
     func `a link-local address requires a zone`() {
