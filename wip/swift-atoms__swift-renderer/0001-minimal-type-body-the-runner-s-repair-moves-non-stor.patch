From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 18:24:14 +0000
Subject: [PATCH 1/4] minimal type body: the runner's repair moves non-stored
 members out of type bodies into extensions; repair applied; root and test
 builds not yet run (coenttb/work#242)

---
 Sources/Renderer/Renderer.Witness.swift | 15 +++++++++------
 1 file changed, 9 insertions(+), 6 deletions(-)

diff --git a/Sources/Renderer/Renderer.Witness.swift b/Sources/Renderer/Renderer.Witness.swift
index f201ce2..a8926a9 100644
--- a/Sources/Renderer/Renderer.Witness.swift
+++ b/Sources/Renderer/Renderer.Witness.swift
@@ -9,12 +9,15 @@ extension Renderer {
         ) {
             self.operation = operation
         }
+    }
+}
 
-        public borrowing func render(
-            _ input: borrowing Input,
-            into context: inout Context
-        ) throws(Failure) {
-            try operation(input, &context)
-        }
+extension Renderer.Witness where Input: ~Copyable & ~Escapable, Context: ~Copyable & ~Escapable {
+
+    public borrowing func render(
+        _ input: borrowing Input,
+        into context: inout Context
+    ) throws(Failure) {
+        try operation(input, &context)
     }
 }
