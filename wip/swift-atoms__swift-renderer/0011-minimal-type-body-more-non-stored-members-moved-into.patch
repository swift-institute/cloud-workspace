From 82351e81307f130bd89d2bd2e7b87fe2821592c4 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:17:15 +0000
Subject: [PATCH 11/18] minimal type body: more non-stored members moved into
 an extension of their type (batch 18; type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 .../Empty Renderer/Empty.Renderer.swift          | 16 ++++++++++------
 .../Renderer.Document.Style.swift                |  6 ++++--
 2 files changed, 14 insertions(+), 8 deletions(-)

diff --git a/Sources/Renderer/Absorbed/swift-empty-renderer/Empty Renderer/Empty.Renderer.swift b/Sources/Renderer/Absorbed/swift-empty-renderer/Empty Renderer/Empty.Renderer.swift
index 08a231e..b45d82c 100644
--- a/Sources/Renderer/Absorbed/swift-empty-renderer/Empty Renderer/Empty.Renderer.swift	
+++ b/Sources/Renderer/Absorbed/swift-empty-renderer/Empty Renderer/Empty.Renderer.swift	
@@ -3,13 +3,17 @@
 
     extension Empty where Element: Renderable & ~Copyable {
         public struct Renderer: Renderer::Renderer.`Protocol` {
-            public typealias Input = Empty<Element>
-            public typealias Context = Element.Renderer.Context
-            public typealias Failure = Element.Renderer.Failure
-
             public init() {}
-
-            public borrowing func render(_ input: borrowing Input, into context: inout Context) throws(Failure) {}
         }
     }
+
+extension Empty.Renderer {
+        public typealias Input = Empty<Element>
+
+        public typealias Context = Element.Renderer.Context
+
+        public typealias Failure = Element.Renderer.Failure
+
+        public borrowing func render(_ input: borrowing Input, into context: inout Context) throws(Failure) {}
+}
 #endif
diff --git a/Sources/Renderer/Absorbed/swift-renderer-document/Renderer Document/Renderer.Document.Style.swift b/Sources/Renderer/Absorbed/swift-renderer-document/Renderer Document/Renderer.Document.Style.swift
index e1ed588..b3cace7 100644
--- a/Sources/Renderer/Absorbed/swift-renderer-document/Renderer Document/Renderer.Document.Style.swift	
+++ b/Sources/Renderer/Absorbed/swift-renderer-document/Renderer Document/Renderer.Document.Style.swift	
@@ -25,8 +25,6 @@ extension Renderer.Document.Style {
 
             public var weight: Weight?
 
-            public enum Weight: Sendable { case normal, bold }
-
             public init(size: Float? = nil, weight: Weight? = nil) {
                 self.size = size
                 self.weight = weight
@@ -37,4 +35,8 @@ extension Renderer.Document.Style {
 
         public static let empty = Self()
 }
+
+extension Renderer.Document.Style.Font {
+        public enum Weight: Sendable { case normal, bold }
+}
 #endif
-- 
