From 37820ab16692a7b90a71aa93a8cafa490904aeec Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:27:42 +0000
Subject: [PATCH 8/9] minimal type body: more non-stored members moved into an
 extension of their type (batch 10; type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 .../Empty Renderer/Empty.Renderer.swift       | 16 +++++---
 .../Renderer.Document.Style.swift             | 39 +++++++++----------
 Sources/Renderer/Renderer.Witness.swift       |  7 ++--
 3 files changed, 33 insertions(+), 29 deletions(-)

diff --git a/Sources/Renderer/Absorbed/swift-empty-renderer/Empty Renderer/Empty.Renderer.swift b/Sources/Renderer/Absorbed/swift-empty-renderer/Empty Renderer/Empty.Renderer.swift
index 08a231e..b45d82c 100644
--- a/Sources/Renderer/Absorbed/swift-empty-renderer/Empty Renderer/Empty.Renderer.swift	
+++ b/Sources/Renderer/Absorbed/swift-empty-renderer/Empty Renderer/Empty.Renderer.swift	
@@ -3,13 +3,17 @@
 
     extension Empty where Element: Renderable & ~Copyable {
         public struct Renderer: Renderer::Renderer.`Protocol` {
-            public typealias Input = Empty<Element>
-            public typealias Context = Element.Renderer.Context
-            public typealias Failure = Element.Renderer.Failure
-
             public init() {}
-
-            public borrowing func render(_ input: borrowing Input, into context: inout Context) throws(Failure) {}
         }
     }
+
+extension Empty.Renderer {
+        public typealias Input = Empty<Element>
+
+        public typealias Context = Element.Renderer.Context
+
+        public typealias Failure = Element.Renderer.Failure
+
+        public borrowing func render(_ input: borrowing Input, into context: inout Context) throws(Failure) {}
+}
 #endif
diff --git a/Sources/Renderer/Absorbed/swift-renderer-document/Renderer Document/Renderer.Document.Style.swift b/Sources/Renderer/Absorbed/swift-renderer-document/Renderer Document/Renderer.Document.Style.swift
index 1a1bc81..e1ed588 100644
--- a/Sources/Renderer/Absorbed/swift-renderer-document/Renderer Document/Renderer.Document.Style.swift	
+++ b/Sources/Renderer/Absorbed/swift-renderer-document/Renderer Document/Renderer.Document.Style.swift	
@@ -1,32 +1,12 @@
 #if Document
     extension Renderer.Document {
-
         public struct Style: Sendable {
-
             public var font: Font
 
             public var color: Color?
 
             public var margin: Float?
 
-            public struct Font: Sendable {
-
-                public var size: Float?
-
-                public var weight: Weight?
-
-                public enum Weight: Sendable { case normal, bold }
-
-                public init(size: Float? = nil, weight: Weight? = nil) {
-                    self.size = size
-                    self.weight = weight
-                }
-            }
-
-            public enum Color: Sendable { case black, red, blue, gray }
-
-            public static let empty = Self()
-
             public init(
                 font: Font = Font(),
                 color: Color? = nil,
@@ -38,4 +18,23 @@
             }
         }
     }
+
+extension Renderer.Document.Style {
+        public struct Font: Sendable {
+            public var size: Float?
+
+            public var weight: Weight?
+
+            public enum Weight: Sendable { case normal, bold }
+
+            public init(size: Float? = nil, weight: Weight? = nil) {
+                self.size = size
+                self.weight = weight
+            }
+        }
+
+        public enum Color: Sendable { case black, red, blue, gray }
+
+        public static let empty = Self()
+}
 #endif
diff --git a/Sources/Renderer/Renderer.Witness.swift b/Sources/Renderer/Renderer.Witness.swift
index f201ce2..31dcaa7 100644
--- a/Sources/Renderer/Renderer.Witness.swift
+++ b/Sources/Renderer/Renderer.Witness.swift
@@ -9,12 +9,13 @@ extension Renderer {
         ) {
             self.operation = operation
         }
+    }
+}
 
+extension Renderer.Witness where Input: ~Copyable & ~Escapable, Context: ~Copyable & ~Escapable {
         public borrowing func render(
             _ input: borrowing Input,
             into context: inout Context
         ) throws(Failure) {
             try operation(input, &context)
-        }
-    }
-}
+        }}
