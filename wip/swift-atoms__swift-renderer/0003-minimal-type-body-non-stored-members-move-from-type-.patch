Date: Sat, 7 Nov 2026 22:39:52 +0000
Subject: [PATCH 3/4] minimal type body: non-stored members move from type
 bodies into an extension of the type in the same file
 (overnight/minimal-bodies.py); type-checked against the root build,
 directories that failed or couldn't be checked left out (coenttb/work#242)

---
 .../Empty Renderer/Empty.Renderer.swift       | 16 +++++---
 .../Renderer.Document.Break.swift             | 13 +++---
 .../Renderer.Document.Empty.swift             | 20 ++++-----
 .../Renderer.Document.Pop.swift               | 23 ++++++-----
 .../Renderer.Document.Push.swift              | 41 ++++++++++---------
 .../Renderer.Document.Speculative.swift       | 11 ++---
 .../Renderer.Document.Style.swift             | 39 +++++++++---------
 7 files changed, 85 insertions(+), 78 deletions(-)

diff --git a/Sources/Renderer/Absorbed/swift-empty-renderer/Empty Renderer/Empty.Renderer.swift b/Sources/Renderer/Absorbed/swift-empty-renderer/Empty Renderer/Empty.Renderer.swift
index 08a231e..b45d82c 100644
--- a/Sources/Renderer/Absorbed/swift-empty-renderer/Empty Renderer/Empty.Renderer.swift	
+++ b/Sources/Renderer/Absorbed/swift-empty-renderer/Empty Renderer/Empty.Renderer.swift	
@@ -3,13 +3,17 @@
 
     extension Empty where Element: Renderable & ~Copyable {
         public struct Renderer: Renderer::Renderer.`Protocol` {
-            public typealias Input = Empty<Element>
-            public typealias Context = Element.Renderer.Context
-            public typealias Failure = Element.Renderer.Failure
-
             public init() {}
-
-            public borrowing func render(_ input: borrowing Input, into context: inout Context) throws(Failure) {}
         }
     }
+
+extension Empty.Renderer {
+        public typealias Input = Empty<Element>
+
+        public typealias Context = Element.Renderer.Context
+
+        public typealias Failure = Element.Renderer.Failure
+
+        public borrowing func render(_ input: borrowing Input, into context: inout Context) throws(Failure) {}
+}
 #endif
