diff --git a/Sources/Compass/Compass.Cardinal+Swift.Hashable.swift b/Sources/Compass/Compass.Cardinal+Swift.Hashable.swift
deleted file mode 100644
index 10025b6..0000000
--- a/Sources/Compass/Compass.Cardinal+Swift.Hashable.swift
+++ /dev/null
@@ -1 +0,0 @@
