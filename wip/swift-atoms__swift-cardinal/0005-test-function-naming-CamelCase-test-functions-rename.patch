From 76816e6808a4571a2504ecc89f1bec726ec34967 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:25:26 +0000
Subject: [PATCH 5/8] test function naming: CamelCase test functions renamed to
 backticked sentences (tests only; type-checked, not run; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 Tests/Cardinal Range Tests/Cardinal.Range Tests.swift | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/Tests/Cardinal Range Tests/Cardinal.Range Tests.swift b/Tests/Cardinal Range Tests/Cardinal.Range Tests.swift
index b8048c4..a9a9d3a 100644
--- a/Tests/Cardinal Range Tests/Cardinal.Range Tests.swift	
+++ b/Tests/Cardinal Range Tests/Cardinal.Range Tests.swift	
@@ -1,7 +1,7 @@
 import Cardinal
 import Testing
 
-@Test func inclusiveAndExclusiveLimits() {
+@Test func `inclusive and exclusive limits`() {
     let closed: ClosedRange<Cardinal> = 2...5
     let open: Range<Cardinal> = 2..<5
     #expect(closed.contains(5))
@@ -10,13 +10,13 @@ import Testing
     #expect(!closed.permitsAnother(after: 5))
     #expect(!open.permitsAnother(after: 4))
 }
-@Test func unboundedRangesDoNotUseAFiniteMaximum() {
+@Test func `unbounded ranges do not use a finite maximum`() {
     let range: PartialRangeFrom<Cardinal> = 2...
     #expect(range.maximum == nil)
     #expect(range.contains(2))
     #expect(range.permitsAnother(after: .max))
 }
-@Test func emptyAndZeroRangesAreDistinct() {
+@Test func `empty and zero ranges are distinct`() {
     let empty: PartialRangeUpTo<Cardinal> = ..<0
     let zero: PartialRangeThrough<Cardinal> = ...0
     #expect(!empty.contains(0))
-- 
