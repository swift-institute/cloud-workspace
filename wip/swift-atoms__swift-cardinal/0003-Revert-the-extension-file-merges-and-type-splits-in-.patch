From c2d3c2cde2db23ea8de5db45cd57db73696aa8d0 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 21:45:59 +0000
Subject: [PATCH 3/8] Revert the extension-file merges and type splits in
 directories where a merged file brought its conditional imports mid-file
 (coenttb/work#242)

---
 .../Cardinal/Algebra/Cardinal+Monoid.swift    | 16 ++++++
 ...rdinal+Swift.CustomStringConvertible.swift |  8 +++
 ...al+Swift.ExpressibleByIntegerLiteral.swift | 12 +++++
 ...inal+Swift.Hashable+Swift.Comparable.swift | 11 ++++
 Sources/Cardinal/Cardinal.swift               | 51 -------------------
 5 files changed, 47 insertions(+), 51 deletions(-)
 create mode 100644 Sources/Cardinal/Algebra/Cardinal+Monoid.swift
 create mode 100644 Sources/Cardinal/Cardinal+Swift.CustomStringConvertible.swift
 create mode 100644 Sources/Cardinal/Cardinal+Swift.ExpressibleByIntegerLiteral.swift
 create mode 100644 Sources/Cardinal/Cardinal+Swift.Hashable+Swift.Comparable.swift

diff --git a/Sources/Cardinal/Algebra/Cardinal+Monoid.swift b/Sources/Cardinal/Algebra/Cardinal+Monoid.swift
new file mode 100644
index 0000000..316c225
--- /dev/null
+++ b/Sources/Cardinal/Algebra/Cardinal+Monoid.swift
@@ -0,0 +1,16 @@
+#if Algebra
+    public import Algebra
+
+    extension Cardinal {
+
+        @inlinable
+        public static var monoid: Algebra.Monoid<Self>.Commutative {
+            .init(
+                monoid: .init(
+                    identity: Cardinal(UInt.zero),
+                    combining: { $0 + $1 }
+                )
+            )
+        }
+    }
+#endif
diff --git a/Sources/Cardinal/Cardinal+Swift.CustomStringConvertible.swift b/Sources/Cardinal/Cardinal+Swift.CustomStringConvertible.swift
new file mode 100644
index 0000000..c66d92c
--- /dev/null
+++ b/Sources/Cardinal/Cardinal+Swift.CustomStringConvertible.swift
@@ -0,0 +1,8 @@
+#if SYNCHRONIZATION_AVAILABLE
+    import Synchronization
+#endif
+
+extension Cardinal: Swift::CustomStringConvertible {
+
+    public var description: String { rawValue.description }
+}
diff --git a/Sources/Cardinal/Cardinal+Swift.ExpressibleByIntegerLiteral.swift b/Sources/Cardinal/Cardinal+Swift.ExpressibleByIntegerLiteral.swift
new file mode 100644
index 0000000..e1437e6
--- /dev/null
+++ b/Sources/Cardinal/Cardinal+Swift.ExpressibleByIntegerLiteral.swift
@@ -0,0 +1,12 @@
+#if SYNCHRONIZATION_AVAILABLE
+    import Synchronization
+#endif
+
+extension Cardinal: Swift::ExpressibleByIntegerLiteral {
+
+    @_disfavoredOverload
+    @inlinable
+    public init(integerLiteral value: UInt) {
+        self.init(value)
+    }
+}
diff --git a/Sources/Cardinal/Cardinal+Swift.Hashable+Swift.Comparable.swift b/Sources/Cardinal/Cardinal+Swift.Hashable+Swift.Comparable.swift
new file mode 100644
index 0000000..181abfd
--- /dev/null
+++ b/Sources/Cardinal/Cardinal+Swift.Hashable+Swift.Comparable.swift
@@ -0,0 +1,11 @@
+#if SYNCHRONIZATION_AVAILABLE
+    import Synchronization
+#endif
+
+extension Cardinal: Swift::Hashable, Swift::Comparable {
+
+    @inlinable
+    public borrowing func hash(into hasher: inout Hasher) {
+        hasher.combine(rawValue)
+    }
+}
diff --git a/Sources/Cardinal/Cardinal.swift b/Sources/Cardinal/Cardinal.swift
index 7053347..ddd2ca6 100644
--- a/Sources/Cardinal/Cardinal.swift
+++ b/Sources/Cardinal/Cardinal.swift
@@ -81,54 +81,3 @@ extension Cardinal {
         self.init(UInt(value))
     }
 }
