From 0bd407f79d8b9f2aed4096124aabe96f981209a5 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:33:59 +0000
Subject: [PATCH 6/8] counter loop iteration: range loops without early exit
 written as forEach (type-check follows; Linux x86_64, Swift 6.4.2)
 (coenttb/work#242)

---
 Tests/Cardinal Tests/Storage values Tests.swift | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Tests/Cardinal Tests/Storage values Tests.swift b/Tests/Cardinal Tests/Storage values Tests.swift
index 1040203..bd228a8 100644
--- a/Tests/Cardinal Tests/Storage values Tests.swift	
+++ b/Tests/Cardinal Tests/Storage values Tests.swift	
@@ -67,7 +67,7 @@ extension `Storage values Tests` {
                     initialized in
                     #expect(initialized.underlying == .zero)
                     #expect(buffer.count == Int(raw))
-                    for i in 0..<Int(raw) {
+                    (0..<Int(raw)).forEach { i in
                         unsafe buffer.baseAddress!.advanced(by: i).initialize(to: i + 10)
                     }
                     initialized = Count(Cardinal(raw))
