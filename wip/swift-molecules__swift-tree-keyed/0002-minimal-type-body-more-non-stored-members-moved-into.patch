From 00dfa6d6d304555c307d222c22cfa4771540dd3c Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:27:43 +0000
Subject: [PATCH 02/10] minimal type body: more non-stored members moved into
 an extension of their type (batch 10; type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 Sources/Tree Keyed/TreeStorage.Keyed.swift | 14 +++++---------
 Sources/Tree Keyed/__TreeArena.swift       | 20 ++++++++++----------
 Sources/Tree Keyed/__TreeKeyedLinks.swift  |  8 +++++---
 3 files changed, 20 insertions(+), 22 deletions(-)

diff --git a/Sources/Tree Keyed/TreeStorage.Keyed.swift b/Sources/Tree Keyed/TreeStorage.Keyed.swift
index f76500e..a146ead 100644
--- a/Sources/Tree Keyed/TreeStorage.Keyed.swift	
+++ b/Sources/Tree Keyed/TreeStorage.Keyed.swift	
@@ -7,13 +7,7 @@ public import Store
 public import Tree
 
 extension TreeStorage {
-
     public struct Keyed<Element: ~Copyable, Key: Swift::Hashable>: ~Copyable {
-
-        public typealias Address = Key
-
-        public typealias Error = __TreeKeyedError<Key>
-
         @usableFromInline
         var _arena: __TreeArena<Element, __TreeKeyedLinks<Key>>
 
@@ -38,7 +32,6 @@ extension TreeStorage {
 }
 
 extension TreeStorage.Keyed: __TreeStorage where Element: ~Copyable {
-
     @inlinable
     public var _count: Index<Element>.Count { _arena.count }
 
@@ -143,7 +136,6 @@ extension TreeStorage.Keyed: __TreeStorage where Element: ~Copyable {
 }
 
 extension TreeStorage.Keyed: __TreeKeyedStorage {
-
     @inlinable
     public func _parentKey(of handle: Store.Generational.Handle) -> Key? {
         _arena.withLinks(at: handle) { $0.parentKey }
@@ -166,7 +158,6 @@ extension TreeStorage.Keyed: Copyable where Element: Copyable {}
 extension TreeStorage.Keyed: Sendable where Element: Sendable, Key: Sendable {}
 
 extension __Tree where S: ~Copyable {
-
     @inlinable
     public init<Element: ~Copyable, Key: Swift::Hashable>()
     where S == TreeStorage.Keyed<Element, Key> {
@@ -201,3 +192,8 @@ extension __Tree where S: ~Copyable {
         _storage._rootHandle = handle
     }
 }
+
+extension TreeStorage.Keyed where Element: ~Copyable {
+        public typealias Address = Key
+
+        public typealias Error = __TreeKeyedError<Key>}
diff --git a/Sources/Tree Keyed/__TreeArena.swift b/Sources/Tree Keyed/__TreeArena.swift
index 4a9497d..27ea857 100644
--- a/Sources/Tree Keyed/__TreeArena.swift	
+++ b/Sources/Tree Keyed/__TreeArena.swift	
@@ -10,10 +10,6 @@ public import Tree
 
 @usableFromInline
 struct __TreeArena<Element: ~Copyable, ChildLinks>: ~Copyable {
-
-    @usableFromInline
-    typealias Slot = __TreeNode<Element, ChildLinks>
-
     @usableFromInline
     var _column: Ownership.Shared<Slot, Storage<Memory.Allocator<Memory.Heap>.Pool>.Generational<Slot>>
 
@@ -46,6 +42,15 @@ struct __TreeArena<Element: ~Copyable, ChildLinks>: ~Copyable {
         self._column = Ownership.Shared(Storage<Memory.Allocator<Memory.Heap>.Pool>.Generational<Slot>.create(slotCapacity: slots))
         self.rootHandle = nil
     }
+}
+
+extension __TreeArena: Copyable where Element: Copyable, ChildLinks: Copyable {}
+
+extension __TreeArena: Sendable where Element: Sendable, ChildLinks: Sendable {}
+
+extension __TreeArena where Element: ~Copyable {
+    @usableFromInline
+    typealias Slot = __TreeNode<Element, ChildLinks>
 
     @inlinable
     package var count: Index<Element>.Count {
@@ -129,9 +134,4 @@ struct __TreeArena<Element: ~Copyable, ChildLinks>: ~Copyable {
         _ body: (inout Element) -> R
     ) -> R {
         _column.withUnique { body(&$0[handle].element) }
-    }
-}
-
-extension __TreeArena: Copyable where Element: Copyable, ChildLinks: Copyable {}
-
-extension __TreeArena: Sendable where Element: Sendable, ChildLinks: Sendable {}
+    }}
diff --git a/Sources/Tree Keyed/__TreeKeyedLinks.swift b/Sources/Tree Keyed/__TreeKeyedLinks.swift
index 4f380c3..9101f9b 100644
--- a/Sources/Tree Keyed/__TreeKeyedLinks.swift	
+++ b/Sources/Tree Keyed/__TreeKeyedLinks.swift	
@@ -12,9 +12,6 @@ public import Store
 
 @usableFromInline
 struct __TreeKeyedLinks<Key: Swift::Hashable> {
-
-    @usableFromInline
-    typealias Children = __DictionaryOrdered<
         Ownership.Shared<
             Hash.Entry<Key, Store.Generational.Handle>,
             Hash.Indexed<Buffer<Storage<Memory.Allocator<Memory.Heap>>.Contiguous<Hash.Entry<Key, Store.Generational.Handle>>>.Linear>
@@ -32,4 +29,9 @@ struct __TreeKeyedLinks<Key: Swift::Hashable> {
     }
 }
 
+extension __TreeKeyedLinks {
+    @usableFromInline
+    typealias Children = __DictionaryOrdered<
+}
+
 extension __TreeKeyedLinks: Sendable where Key: Sendable {}
-- 
