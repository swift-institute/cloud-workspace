---
 Sources/Tree Keyed/TreeStorage.Keyed.swift | 22 +++++++++++++---------
 Sources/Tree Keyed/__TreeArena.swift       | 20 ++++++++++----------
 2 files changed, 23 insertions(+), 19 deletions(-)

diff --git a/Sources/Tree Keyed/TreeStorage.Keyed.swift b/Sources/Tree Keyed/TreeStorage.Keyed.swift
index 7e8c149..f76500e 100644
--- a/Sources/Tree Keyed/TreeStorage.Keyed.swift	
+++ b/Sources/Tree Keyed/TreeStorage.Keyed.swift	
@@ -1,13 +1,19 @@
-import Dictionary
-import Dictionary_Ordered
-import Hash_Indexed_Primitive
+public import Dictionary
+public import Dictionary_Ordered
+public import Hash_Indexed_Primitive
 public import Index
-import Storage
+public import Storage
 public import Store
 public import Tree
 
 extension TreeStorage {
+
     public struct Keyed<Element: ~Copyable, Key: Swift::Hashable>: ~Copyable {
+
+        public typealias Address = Key
+
+        public typealias Error = __TreeKeyedError<Key>
+
         @usableFromInline
         var _arena: __TreeArena<Element, __TreeKeyedLinks<Key>>
 
@@ -32,6 +38,7 @@ extension TreeStorage {
 }
 
 extension TreeStorage.Keyed: __TreeStorage where Element: ~Copyable {
+
     @inlinable
     public var _count: Index<Element>.Count { _arena.count }
 
@@ -136,6 +143,7 @@ extension TreeStorage.Keyed: __TreeStorage where Element: ~Copyable {
 }
 
 extension TreeStorage.Keyed: __TreeKeyedStorage {
+
     @inlinable
     public func _parentKey(of handle: Store.Generational.Handle) -> Key? {
         _arena.withLinks(at: handle) { $0.parentKey }
@@ -158,6 +166,7 @@ extension TreeStorage.Keyed: Copyable where Element: Copyable {}
 extension TreeStorage.Keyed: Sendable where Element: Sendable, Key: Sendable {}
 
 extension __Tree where S: ~Copyable {
+
     @inlinable
     public init<Element: ~Copyable, Key: Swift::Hashable>()
     where S == TreeStorage.Keyed<Element, Key> {
@@ -192,8 +201,3 @@ extension __Tree where S: ~Copyable {
         _storage._rootHandle = handle
     }
 }
-
-extension TreeStorage.Keyed where Element: ~Copyable {
-        public typealias Address = Key
-
-        public typealias Error = __TreeKeyedError<Key>}
diff --git a/Sources/Tree Keyed/__TreeArena.swift b/Sources/Tree Keyed/__TreeArena.swift
index 27ea857..4a9497d 100644
--- a/Sources/Tree Keyed/__TreeArena.swift	
+++ b/Sources/Tree Keyed/__TreeArena.swift	
@@ -10,6 +10,10 @@ public import Tree
 
 @usableFromInline
 struct __TreeArena<Element: ~Copyable, ChildLinks>: ~Copyable {
+
+    @usableFromInline
+    typealias Slot = __TreeNode<Element, ChildLinks>
+
     @usableFromInline
     var _column: Ownership.Shared<Slot, Storage<Memory.Allocator<Memory.Heap>.Pool>.Generational<Slot>>
 
@@ -42,15 +46,6 @@ struct __TreeArena<Element: ~Copyable, ChildLinks>: ~Copyable {
         self._column = Ownership.Shared(Storage<Memory.Allocator<Memory.Heap>.Pool>.Generational<Slot>.create(slotCapacity: slots))
         self.rootHandle = nil
     }
-}
-
-extension __TreeArena: Copyable where Element: Copyable, ChildLinks: Copyable {}
-
-extension __TreeArena: Sendable where Element: Sendable, ChildLinks: Sendable {}
-
-extension __TreeArena where Element: ~Copyable {
-    @usableFromInline
-    typealias Slot = __TreeNode<Element, ChildLinks>
 
     @inlinable
     package var count: Index<Element>.Count {
@@ -134,4 +129,9 @@ extension __TreeArena where Element: ~Copyable {
         _ body: (inout Element) -> R
     ) -> R {
         _column.withUnique { body(&$0[handle].element) }
-    }}
+    }
+}
+
+extension __TreeArena: Copyable where Element: Copyable, ChildLinks: Copyable {}
+
+extension __TreeArena: Sendable where Element: Sendable, ChildLinks: Sendable {}
