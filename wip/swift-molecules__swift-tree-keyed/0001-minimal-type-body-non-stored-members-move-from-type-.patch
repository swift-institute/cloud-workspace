From 30c0c1d072fd14cbb78dd99e4d351138e73a8c9d Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 22:39:54 +0000
Subject: [PATCH] minimal type body: non-stored members move from type bodies
 into an extension of the type in the same file (overnight/minimal-bodies.py);
 type-checked against the root build, directories that failed or couldn't be
 checked left out (coenttb/work#242)

---
 Sources/Tree Keyed/Tree.Keyed.Diff.swift   | 4 ++--
 Sources/Tree Keyed/Tree.Keyed.Insert.swift | 5 ++---
 2 files changed, 4 insertions(+), 5 deletions(-)

diff --git a/Sources/Tree Keyed/Tree.Keyed.Diff.swift b/Sources/Tree Keyed/Tree.Keyed.Diff.swift
index c25d8c7..e85c298 100644
--- a/Sources/Tree Keyed/Tree.Keyed.Diff.swift	
+++ b/Sources/Tree Keyed/Tree.Keyed.Diff.swift	
@@ -1,11 +1,12 @@
 public struct __TreeKeyedDiff<Key: Swift::Hashable, Value: Equatable> {
-
     public let operations: [Operation]
 
     public init(operations: [Operation]) {
         self.operations = operations
     }
+}
 
+extension __TreeKeyedDiff {
     public var isEmpty: Bool { operations.isEmpty }
 }
 
@@ -14,6 +15,5 @@ extension __TreeKeyedDiff: Sendable where Key: Sendable, Value: Sendable {}
 extension __TreeKeyedDiff: Equatable where Key: Equatable {}
 
 extension __Tree where S: __TreeKeyedStorage, S.Element: Equatable & Copyable {
-
     public typealias Diff = __TreeKeyedDiff<Key, Value>
 }
diff --git a/Sources/Tree Keyed/Tree.Keyed.Insert.swift b/Sources/Tree Keyed/Tree.Keyed.Insert.swift
index dbec0e0..0cbcd8d 100644
--- a/Sources/Tree Keyed/Tree.Keyed.Insert.swift	
+++ b/Sources/Tree Keyed/Tree.Keyed.Insert.swift	
@@ -1,17 +1,17 @@
 public import Tree
 
 public enum __TreeKeyedInsert<Key: Swift::Hashable> {
+}
 
+extension __TreeKeyedInsert {
     public typealias Position = __TreeKeyedInsertPosition<Key>
 }
 
 extension __Tree where S: __TreeKeyedStorage {
-
     public typealias Insert = __TreeKeyedInsert<S.Address>
 }
 
 extension __Tree where S: __TreeKeyedStorage {
-
     @inlinable
     @discardableResult
     public mutating func insert(
@@ -48,7 +48,6 @@ extension __Tree where S: __TreeKeyedStorage {
 }
 
 extension __Tree where S: __TreeKeyedStorage, S.Element: Copyable {
-
     @inlinable
     public var rootValue: Value? {
         get {
-- 
