From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:17:15 +0000
Subject: [PATCH 7/9] minimal type body: more non-stored members moved into an
 extension of their type (batch 18; type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 Sources/Tree Keyed/__TreeKeyedLinks.swift | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/Sources/Tree Keyed/__TreeKeyedLinks.swift b/Sources/Tree Keyed/__TreeKeyedLinks.swift
index 4f380c3..9101f9b 100644
--- a/Sources/Tree Keyed/__TreeKeyedLinks.swift	
+++ b/Sources/Tree Keyed/__TreeKeyedLinks.swift	
@@ -12,9 +12,6 @@ public import Store
 
 @usableFromInline
 struct __TreeKeyedLinks<Key: Swift::Hashable> {
-
-    @usableFromInline
-    typealias Children = __DictionaryOrdered<
         Ownership.Shared<
             Hash.Entry<Key, Store.Generational.Handle>,
             Hash.Indexed<Buffer<Storage<Memory.Allocator<Memory.Heap>>.Contiguous<Hash.Entry<Key, Store.Generational.Handle>>>.Linear>
@@ -32,4 +29,9 @@ struct __TreeKeyedLinks<Key: Swift::Hashable> {
     }
 }
 
+extension __TreeKeyedLinks {
+    @usableFromInline
+    typealias Children = __DictionaryOrdered<
+}
+
 extension __TreeKeyedLinks: Sendable where Key: Sendable {}
