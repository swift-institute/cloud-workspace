Subject: [PATCH 08/14] Revert the minimal-body moves in files where they
 raised a rule over its ratchet limit (coenttb/work#242)

---
 .../Byte Coder/Never.Coder.swift              | 40 ++++----
 .../Coder/Either/Swift.Optional+Coder.swift   | 93 ++++++++++---------
 2 files changed, 67 insertions(+), 66 deletions(-)

diff --git a/Sources/Coder/Absorbed/swift-byte-coder/Byte Coder/Never.Coder.swift b/Sources/Coder/Absorbed/swift-byte-coder/Byte Coder/Never.Coder.swift
index 4c7ad2e..ec3d555 100644
--- a/Sources/Coder/Absorbed/swift-byte-coder/Byte Coder/Never.Coder.swift	
+++ b/Sources/Coder/Absorbed/swift-byte-coder/Byte Coder/Never.Coder.swift	
@@ -5,30 +5,30 @@
     import Serializer
 
     extension Swift::Never {
+
         public struct Coder: Byte.Coding<Swift::Never, Swift::Never.Coder.Error> {
+
+            public typealias Buffer = [Byte]
+
+            public enum Error: Swift::Error, Equatable {
+                case absent
+            }
+
             @inlinable
             public init() {}
-        }
-    }
 
-extension Swift.Coder {
-        public typealias Buffer = [Byte]
-
-        public enum Error: Swift::Error, Equatable {
-            case absent
-        }
+            @inlinable
+            public borrowing func parse(
+                _ input: inout ArraySlice<Byte>
+            ) throws(Swift::Never.Coder.Error) -> Swift::Never {
+                throw .absent
+            }
 
-        @inlinable
-        public borrowing func parse(
-            _ input: inout ArraySlice<Byte>
-        ) throws(Swift::Never.Coder.Error) -> Swift::Never {
-            throw .absent
+            @inlinable
+            public borrowing func serialize<Buffer: RangeReplaceableCollection>(
+                _ output: Swift::Never,
+                into buffer: inout Buffer
+            ) throws(Swift::Never.Coder.Error) where Buffer.Element == Byte {}
         }
-
-        @inlinable
-        public borrowing func serialize<Buffer: RangeReplaceableCollection>(
-            _ output: Swift::Never,
-            into buffer: inout Buffer
-        ) throws(Swift::Never.Coder.Error) where Buffer.Element == Byte {}
-}
+    }
 #endif
diff --git a/Sources/Coder/Either/Swift.Optional+Coder.swift b/Sources/Coder/Either/Swift.Optional+Coder.swift
index 6d2bfd0..e9176ca 100644
--- a/Sources/Coder/Either/Swift.Optional+Coder.swift
+++ b/Sources/Coder/Either/Swift.Optional+Coder.swift
