From 3522d9a93363c8ea321d5f88d86c01a349f18bd8 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:27:40 +0000
Subject: [PATCH 12/19] minimal type body: more non-stored members moved into
 an extension of their type (batch 10; type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 .../Byte Coder/Never.Coder.swift              | 40 ++++----
 .../Coder/Either/Swift.Optional+Coder.swift   | 93 +++++++++----------
 2 files changed, 66 insertions(+), 67 deletions(-)

diff --git a/Sources/Coder/Absorbed/swift-byte-coder/Byte Coder/Never.Coder.swift b/Sources/Coder/Absorbed/swift-byte-coder/Byte Coder/Never.Coder.swift
index ec3d555..4c7ad2e 100644
--- a/Sources/Coder/Absorbed/swift-byte-coder/Byte Coder/Never.Coder.swift	
+++ b/Sources/Coder/Absorbed/swift-byte-coder/Byte Coder/Never.Coder.swift	
@@ -5,30 +5,30 @@
     import Serializer
 
     extension Swift::Never {
-
         public struct Coder: Byte.Coding<Swift::Never, Swift::Never.Coder.Error> {
-
-            public typealias Buffer = [Byte]
-
-            public enum Error: Swift::Error, Equatable {
-                case absent
-            }
-
             @inlinable
             public init() {}
+        }
+    }
 
-            @inlinable
-            public borrowing func parse(
-                _ input: inout ArraySlice<Byte>
-            ) throws(Swift::Never.Coder.Error) -> Swift::Never {
-                throw .absent
-            }
+extension Swift.Coder {
+        public typealias Buffer = [Byte]
 
-            @inlinable
-            public borrowing func serialize<Buffer: RangeReplaceableCollection>(
-                _ output: Swift::Never,
-                into buffer: inout Buffer
-            ) throws(Swift::Never.Coder.Error) where Buffer.Element == Byte {}
+        public enum Error: Swift::Error, Equatable {
+            case absent
         }
-    }
+
+        @inlinable
+        public borrowing func parse(
+            _ input: inout ArraySlice<Byte>
+        ) throws(Swift::Never.Coder.Error) -> Swift::Never {
+            throw .absent
+        }
+
+        @inlinable
+        public borrowing func serialize<Buffer: RangeReplaceableCollection>(
+            _ output: Swift::Never,
+            into buffer: inout Buffer
+        ) throws(Swift::Never.Coder.Error) where Buffer.Element == Byte {}
+}
 #endif
diff --git a/Sources/Coder/Either/Swift.Optional+Coder.swift b/Sources/Coder/Either/Swift.Optional+Coder.swift
index e9176ca..6d2bfd0 100644
--- a/Sources/Coder/Either/Swift.Optional+Coder.swift
+++ b/Sources/Coder/Either/Swift.Optional+Coder.swift
@@ -11,70 +11,69 @@
         Wrapped.Output: ~Copyable & Escapable,
         Wrapped.Buffer: ~Copyable & ~Escapable
     {
-
         public struct Coder: Coding {
+            public let wrapped: Wrapped?
 
-            public enum Error: Swift::Error, Equatable {
-
-                case missingValue
-
-                case unexpectedValue
+            @inlinable
+            public init(_ wrapped: Wrapped?) {
+                self.wrapped = wrapped
             }
+        }
+    }
 
-            public typealias Input = Wrapped.Input
+extension Swift.Coder {
+        public enum Error: Swift::Error, Equatable {
+            case missingValue
 
-            public typealias Output = Wrapped.Output?
+            case unexpectedValue
+        }
 
-            public typealias Buffer = Wrapped.Buffer
+        public typealias Input = Wrapped.Input
 
-            public typealias Failure = Either<Wrapped.Failure, Error>
+        public typealias Output = Wrapped.Output?
 
-            public let wrapped: Wrapped?
+        public typealias Buffer = Wrapped.Buffer
 
-            @inlinable
-            public init(_ wrapped: Wrapped?) {
-                self.wrapped = wrapped
+        public typealias Failure = Either<Wrapped.Failure, Error>
+
+        @inlinable
+        public borrowing func parse(_ input: inout Input) throws(Failure) -> Output {
+            guard let wrapped else {
+                return nil
             }
+            do throws(Wrapped.Failure) {
+                return try wrapped.parse(&input)
+            } catch {
+                throw .left(error)
+            }
+        }
 
-            @inlinable
-            public borrowing func parse(_ input: inout Input) throws(Failure) -> Output {
-                guard let wrapped else {
-                    return nil
+        @inlinable
+        public borrowing func serialize(
+            _ output: borrowing Output,
+            into buffer: inout Buffer
+        )
+            throws(Failure)
+        {
+            guard let wrapped else {
+                switch output {
+                case .none:
+                    return
+                case .some:
+                    throw .right(.unexpectedValue)
                 }
+            }
+            switch output {
+            case .some(let value):
                 do throws(Wrapped.Failure) {
-                    return try wrapped.parse(&input)
+                    try wrapped.serialize(value, into: &buffer)
                 } catch {
                     throw .left(error)
                 }
-            }
-
-            @inlinable
-            public borrowing func serialize(
-                _ output: borrowing Output,
-                into buffer: inout Buffer
-            )
-                throws(Failure)
-            {
-                guard let wrapped else {
-                    switch output {
-                    case .none:
-                        return
-                    case .some:
-                        throw .right(.unexpectedValue)
-                    }
-                }
-                switch output {
-                case .some(let value):
-                    do throws(Wrapped.Failure) {
-                        try wrapped.serialize(value, into: &buffer)
-                    } catch {
-                        throw .left(error)
-                    }
-                case .none:
-                    throw .right(.missingValue)
-                }
+            case .none:
+                throw .right(.missingValue)
             }
         }
-    }
+}
 
 #endif
