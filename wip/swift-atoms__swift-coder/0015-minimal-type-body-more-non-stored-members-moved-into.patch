From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:17:14 +0000
Subject: [PATCH 15/21] minimal type body: more non-stored members moved into
 an extension of their type (batch 18; type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 .../String Coder/String.Coder.Lossless.swift  | 42 ++++-----
 .../Coder/Either/Swift.Optional+Coder.swift   | 93 +++++++++----------
 2 files changed, 67 insertions(+), 68 deletions(-)

diff --git a/Sources/Coder/Absorbed/swift-string-coder/String Coder/String.Coder.Lossless.swift b/Sources/Coder/Absorbed/swift-string-coder/String Coder/String.Coder.Lossless.swift
index dde2386..7fc053e 100644
--- a/Sources/Coder/Absorbed/swift-string-coder/String Coder/String.Coder.Lossless.swift	
+++ b/Sources/Coder/Absorbed/swift-string-coder/String Coder/String.Coder.Lossless.swift	
@@ -5,38 +5,38 @@
     import Serializer
 
     extension Swift::String.Coder {
-
         public struct Lossless<
             Value: LosslessStringConvertible
         >: Byte.Coding<Value, Swift::String.Coder.Error> {
-
             public let text: Swift::String.Coder
 
-            public typealias Buffer = [Byte]
-
             @inlinable
             public init() {
                 self.text = .init()
             }
+        }
+    }
 
-            @inlinable
-            public borrowing func parse(
-                _ input: inout ArraySlice<Byte>
-            ) throws(Swift::String.Coder.Error) -> Value {
-                let description = try text.parse(&input)
-                guard let value = Value(description) else {
-                    throw .malformed
-                }
-                return value
-            }
+extension Swift.Lossless {
+        public typealias Buffer = [Byte]
 
-            @inlinable
-            public borrowing func serialize<Buffer: RangeReplaceableCollection>(
-                _ output: Value,
-                into buffer: inout Buffer
-            ) throws(Swift::String.Coder.Error) where Buffer.Element == Byte {
-                try text.serialize(output.description, into: &buffer)
+        @inlinable
+        public borrowing func parse(
+            _ input: inout ArraySlice<Byte>
+        ) throws(Swift::String.Coder.Error) -> Value {
+            let description = try text.parse(&input)
+            guard let value = Value(description) else {
+                throw .malformed
             }
+            return value
         }
-    }
+
+        @inlinable
+        public borrowing func serialize<Buffer: RangeReplaceableCollection>(
+            _ output: Value,
+            into buffer: inout Buffer
+        ) throws(Swift::String.Coder.Error) where Buffer.Element == Byte {
+            try text.serialize(output.description, into: &buffer)
+        }
+}
 #endif
diff --git a/Sources/Coder/Either/Swift.Optional+Coder.swift b/Sources/Coder/Either/Swift.Optional+Coder.swift
index e9176ca..6d2bfd0 100644
--- a/Sources/Coder/Either/Swift.Optional+Coder.swift
+++ b/Sources/Coder/Either/Swift.Optional+Coder.swift
@@ -11,70 +11,69 @@
         Wrapped.Output: ~Copyable & Escapable,
         Wrapped.Buffer: ~Copyable & ~Escapable
     {
-
         public struct Coder: Coding {
+            public let wrapped: Wrapped?
 
-            public enum Error: Swift::Error, Equatable {
-
-                case missingValue
-
-                case unexpectedValue
+            @inlinable
+            public init(_ wrapped: Wrapped?) {
+                self.wrapped = wrapped
             }
+        }
+    }
 
-            public typealias Input = Wrapped.Input
+extension Swift.Coder {
+        public enum Error: Swift::Error, Equatable {
+            case missingValue
 
-            public typealias Output = Wrapped.Output?
+            case unexpectedValue
+        }
 
-            public typealias Buffer = Wrapped.Buffer
+        public typealias Input = Wrapped.Input
 
-            public typealias Failure = Either<Wrapped.Failure, Error>
+        public typealias Output = Wrapped.Output?
 
-            public let wrapped: Wrapped?
+        public typealias Buffer = Wrapped.Buffer
 
-            @inlinable
-            public init(_ wrapped: Wrapped?) {
-                self.wrapped = wrapped
+        public typealias Failure = Either<Wrapped.Failure, Error>
+
+        @inlinable
+        public borrowing func parse(_ input: inout Input) throws(Failure) -> Output {
+            guard let wrapped else {
+                return nil
             }
+            do throws(Wrapped.Failure) {
+                return try wrapped.parse(&input)
+            } catch {
+                throw .left(error)
+            }
+        }
 
-            @inlinable
-            public borrowing func parse(_ input: inout Input) throws(Failure) -> Output {
-                guard let wrapped else {
-                    return nil
+        @inlinable
+        public borrowing func serialize(
+            _ output: borrowing Output,
+            into buffer: inout Buffer
+        )
+            throws(Failure)
+        {
+            guard let wrapped else {
+                switch output {
+                case .none:
+                    return
+                case .some:
+                    throw .right(.unexpectedValue)
                 }
+            }
+            switch output {
+            case .some(let value):
                 do throws(Wrapped.Failure) {
-                    return try wrapped.parse(&input)
+                    try wrapped.serialize(value, into: &buffer)
                 } catch {
                     throw .left(error)
                 }
-            }
-
-            @inlinable
-            public borrowing func serialize(
-                _ output: borrowing Output,
-                into buffer: inout Buffer
-            )
-                throws(Failure)
-            {
-                guard let wrapped else {
-                    switch output {
-                    case .none:
-                        return
-                    case .some:
-                        throw .right(.unexpectedValue)
-                    }
-                }
-                switch output {
-                case .some(let value):
-                    do throws(Wrapped.Failure) {
-                        try wrapped.serialize(value, into: &buffer)
-                    } catch {
-                        throw .left(error)
-                    }
-                case .none:
-                    throw .right(.missingValue)
-                }
+            case .none:
+                throw .right(.missingValue)
             }
         }
-    }
+}
 
 #endif
