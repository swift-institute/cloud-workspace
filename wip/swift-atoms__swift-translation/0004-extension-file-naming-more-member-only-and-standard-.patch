From e1450040b131be435946acf93be1d7e5618ac90b Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 01:37:29 +0000
Subject: [PATCH 4/4] extension file naming: more member-only and
 standard-library extension files merge into their type's file; single type
 per file: more additional types move to their own files
 (merge-extension-files.py, split-types.py); parse-checked; root build pending
 (coenttb/work#242)

---
 .../Affine/Translation+Affine.swift           | 13 -------
 .../Affine/Translation+Construction.swift     | 21 -----------
 Sources/Translation/Translation.swift         | 36 +++++++++++++++++++
 3 files changed, 36 insertions(+), 34 deletions(-)
 delete mode 100644 Sources/Translation/Integrations/Affine/Translation+Affine.swift
 delete mode 100644 Sources/Translation/Integrations/Affine/Translation+Construction.swift

diff --git a/Sources/Translation/Integrations/Affine/Translation+Affine.swift b/Sources/Translation/Integrations/Affine/Translation+Affine.swift
deleted file mode 100644
index 10785b4..0000000
--- a/Sources/Translation/Integrations/Affine/Translation+Affine.swift
+++ /dev/null
@@ -1,13 +0,0 @@
-#if Affine
-    public import Affine
-
-    extension Translation {
-        public func applying<Point, Failure: Swift::Error>(
-            to point: Point,
-            using affine: Affine<Point, Displacement, Failure>
-        ) throws(Failure) -> Point {
-            try affine.translated(point, by: offset)
-        }
-
-    }
-#endif
diff --git a/Sources/Translation/Integrations/Affine/Translation+Construction.swift b/Sources/Translation/Integrations/Affine/Translation+Construction.swift
deleted file mode 100644
index 0e768a8..0000000
--- a/Sources/Translation/Integrations/Affine/Translation+Construction.swift
+++ /dev/null
@@ -1,21 +0,0 @@
-#if Affine
-    public import Displacement
-
-    extension Translation {
-        public init<Scalar>(dx: Scalar)
-        where Displacement == Displacement::Displacement<1, Scalar> {
-            self.init(by: Displacement(dx: dx))
-        }
-
-        public init<Scalar>(dx: Scalar, dy: Scalar)
-        where Displacement == Displacement::Displacement<2, Scalar> {
-            self.init(by: Displacement(dx: dx, dy: dy))
-        }
-
-        public init<Scalar>(dx: Scalar, dy: Scalar, dz: Scalar)
-        where Displacement == Displacement::Displacement<3, Scalar> {
-            self.init(by: Displacement(dx: dx, dy: dy, dz: dz))
-        }
-
-    }
-#endif
diff --git a/Sources/Translation/Translation.swift b/Sources/Translation/Translation.swift
index 12b88f1..e1fa05d 100644
--- a/Sources/Translation/Translation.swift
+++ b/Sources/Translation/Translation.swift
@@ -37,3 +37,39 @@ extension Translation {
 
     public init(by displacement: Displacement) { self.init(offset: displacement) }
 }
+
+#if Affine
+    public import Affine
+
+    extension Translation {
+        public func applying<Point, Failure: Swift::Error>(
+            to point: Point,
+            using affine: Affine<Point, Displacement, Failure>
+        ) throws(Failure) -> Point {
+            try affine.translated(point, by: offset)
+        }
+
+    }
+#endif
+
+#if Affine
+    public import Displacement
+
+    extension Translation {
+        public init<Scalar>(dx: Scalar)
+        where Displacement == Displacement::Displacement<1, Scalar> {
+            self.init(by: Displacement(dx: dx))
+        }
+
+        public init<Scalar>(dx: Scalar, dy: Scalar)
+        where Displacement == Displacement::Displacement<2, Scalar> {
+            self.init(by: Displacement(dx: dx, dy: dy))
+        }
+
+        public init<Scalar>(dx: Scalar, dy: Scalar, dz: Scalar)
+        where Displacement == Displacement::Displacement<3, Scalar> {
+            self.init(by: Displacement(dx: dx, dy: dy, dz: dz))
+        }
+
+    }
+#endif
-- 
