Subject: [PATCH 4/6] extension file naming: member-only and
 standard-library-conformance extension files merge into their type's own file
 (overnight/merge-extension-files.py); single type per file: additional types
 move to their own <Parent>.<Name>.swift inside the container's extension
 (overnight/split-types.py); parse-checked; builds pending (coenttb/work#242)

---
 Sources/RFC 3986/RFC_3986.ByteSet.swift       | 34 +++++++++++++++++++
 Sources/RFC 3986/RFC_3986.CharacterSet.swift  | 30 ----------------
 .../RFC_3986.URI.Authority.Error.swift        | 17 ++++++++++
 Sources/RFC 3986/RFC_3986.URI.Authority.swift | 13 -------
 4 files changed, 51 insertions(+), 43 deletions(-)
 create mode 100644 Sources/RFC 3986/RFC_3986.ByteSet.swift
 create mode 100644 Sources/RFC 3986/RFC_3986.URI.Authority.Error.swift

diff --git a/Sources/RFC 3986/RFC_3986.ByteSet.swift b/Sources/RFC 3986/RFC_3986.ByteSet.swift
new file mode 100644
index 0000000..59d3db7
--- /dev/null
+++ b/Sources/RFC 3986/RFC_3986.ByteSet.swift	
@@ -0,0 +1,34 @@
+public import ASCII
+
+
+extension RFC_3986 {
+    public struct ByteSet: Sendable {
+
+        @usableFromInline
+        let low: UInt64
+
+        @usableFromInline
+        let high: UInt64
+
+        @inlinable
+        public init(low: UInt64, high: UInt64) {
+            self.low = low
+            self.high = high
+        }
+
+        @inlinable
+        public init(ascii characters: String) {
+            var lo: UInt64 = 0
+            var hi: UInt64 = 0
+            for byte in characters.utf8 where byte < 128 {
+                if byte < 64 {
+                    lo |= 1 << UInt64(byte)
+                } else {
+                    hi |= 1 << UInt64(byte - 64)
+                }
+            }
+            self.low = lo
+            self.high = hi
+        }
+    }
+}
