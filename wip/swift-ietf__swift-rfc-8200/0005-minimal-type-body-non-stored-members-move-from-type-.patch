From 1c730a4071457b75d51024b40a4fc611c4225650 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 22:39:56 +0000
Subject: [PATCH 5/5] minimal type body: non-stored members move from type
 bodies into an extension of the type in the same file
 (overnight/minimal-bodies.py); type-checked against the root build,
 directories that failed or couldn't be checked left out (coenttb/work#242)

---
 .../RFC 8200/RFC_8200.Extension.Header.swift  | 11 ++-
 Sources/RFC 8200/RFC_8200.FlowLabel.swift     | 16 ++--
 Sources/RFC 8200/RFC_8200.NextHeader.swift    | 94 ++++++++++---------
 Sources/RFC 8200/RFC_8200.TrafficClass.swift  | 76 +++++++--------
 4 files changed, 102 insertions(+), 95 deletions(-)

diff --git a/Sources/RFC 8200/RFC_8200.Extension.Header.swift b/Sources/RFC 8200/RFC_8200.Extension.Header.swift
index 314fde0..e8ce442 100644
--- a/Sources/RFC 8200/RFC_8200.Extension.Header.swift	
+++ b/Sources/RFC 8200/RFC_8200.Extension.Header.swift	
@@ -1,7 +1,6 @@
 import Binary
 import Byte
 
-
 extension RFC_8200.Extension {
     /// Generic extension header format
     ///
@@ -15,10 +14,12 @@ extension RFC_8200.Extension {
 
         /// Header length in 8-octet units (excluding first 8 octets)
         public let headerLength: UInt8
+    }
+}
 
-        /// The full length of the header in bytes
-        public var lengthInBytes: Int {
-            (Int(headerLength) + 1) * 8
-        }
+extension RFC_8200.Extension.Header {
+    /// The full length of the header in bytes
+    public var lengthInBytes: Int {
+        (Int(headerLength) + 1) * 8
     }
 }
diff --git a/Sources/RFC 8200/RFC_8200.FlowLabel.swift b/Sources/RFC 8200/RFC_8200.FlowLabel.swift
index 1f13919..3c8c2fa 100644
--- a/Sources/RFC 8200/RFC_8200.FlowLabel.swift	
+++ b/Sources/RFC 8200/RFC_8200.FlowLabel.swift	
@@ -25,15 +25,17 @@ extension RFC_8200 {
         init(__unchecked: Void, rawValue: UInt32) {
             self.rawValue = rawValue
         }
+    }
+}
 
-        /// Zero flow label (no flow identification)
-        public static let zero = Self(__unchecked: (), rawValue: 0)
+extension RFC_8200.FlowLabel {
+    /// Zero flow label (no flow identification)
+    public static let zero = Self(__unchecked: (), rawValue: 0)
 
-        /// Maximum flow label value
-        public static let max = Self(__unchecked: (), rawValue: 0xFFFFF)
+    /// Maximum flow label value
+    public static let max = Self(__unchecked: (), rawValue: 0xFFFFF)
 
-        public static func < (lhs: Self, rhs: Self) -> Bool {
-            lhs.rawValue < rhs.rawValue
-        }
+    public static func < (lhs: Self, rhs: Self) -> Bool {
+        lhs.rawValue < rhs.rawValue
     }
 }
diff --git a/Sources/RFC 8200/RFC_8200.NextHeader.swift b/Sources/RFC 8200/RFC_8200.NextHeader.swift
index 10ed335..df8cf56 100644
