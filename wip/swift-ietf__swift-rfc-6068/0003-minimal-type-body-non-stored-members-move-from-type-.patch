diff --git a/Sources/RFC 6068/Absorbed swift-rfc-6068-coder/RFC_6068.Mailto.Header.Coder.swift b/Sources/RFC 6068/Absorbed swift-rfc-6068-coder/RFC_6068.Mailto.Header.Coder.swift
