Subject: [PATCH 12/13] Revert files that raised `file name nested path` over
 its ratchet limit (coenttb/work#242)

---
 .../Markdown.Configuration.Directive.swift    | 28 +++++++++++++++++++
 .../Markdown.Configuration.Slug.swift         |  8 ++++++
 2 files changed, 36 insertions(+)

diff --git a/Sources/Markdown HTML Rendering/Markdown.Configuration.Directive.swift b/Sources/Markdown HTML Rendering/Markdown.Configuration.Directive.swift
index 1f28d4f..cddde28 100644
--- a/Sources/Markdown HTML Rendering/Markdown.Configuration.Directive.swift	
+++ b/Sources/Markdown HTML Rendering/Markdown.Configuration.Directive.swift	
@@ -75,7 +75,35 @@ extension Markdown.Configuration.Directives {
 }
 
 extension Markdown.Configuration.Directives {
+
+    public struct Directive: Sendable {
+        public let name: String
+        public let rawArguments: String
+        public let arguments: [String: String]
+        public let children: HTML.AnyView
+
+        public init(
+            name: String,
+            rawArguments: String,
+            arguments: [String: String],
+            children: HTML.AnyView
+        ) {
+            self.name = name
+            self.rawArguments = rawArguments
+            self.arguments = arguments
+            self.children = children
+        }
+    }
 }
 
 extension Markdown.Configuration.Directives.Directive {
+
+    public enum Result: Sendable {
+
+        case rendered(HTML.AnyView)
+
+        case useDefault
+
+        case suppress
+    }
 }
diff --git a/Sources/Markdown HTML Rendering/Markdown.Configuration.Slug.swift b/Sources/Markdown HTML Rendering/Markdown.Configuration.Slug.swift
index 5c68263..493d552 100644
--- a/Sources/Markdown HTML Rendering/Markdown.Configuration.Slug.swift	
+++ b/Sources/Markdown HTML Rendering/Markdown.Configuration.Slug.swift	
@@ -14,7 +14,15 @@ extension Markdown.Configuration {
 }
 
 extension Markdown.Configuration.SlugGenerator {
+    public struct Input: Sendable {
+        public let text: String
+        public let existingSlugs: Swift.Set<String>
 
+        public init(text: String, existingSlugs: Swift.Set<String>) {
+            self.text = text
+            self.existingSlugs = existingSlugs
+        }
+    }
 
