From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 18:49:04 +0000
Subject: [PATCH] compound suite name: narrative suites move into extension
 <Type> named after their test file, nested suites into extension
 <Type>.<Parent> (overnight/compound-suites.py); parse-checked; builds pending
 (coenttb/work#242)

---
 .../Markdown HTML Rendering Tests/Markdown.Test Tests.swift  | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/Tests/Markdown HTML Rendering Tests/Markdown.Test Tests.swift b/Tests/Markdown HTML Rendering Tests/Markdown.Test Tests.swift
index 9e975f5..2e84e5d 100644
--- a/Tests/Markdown HTML Rendering Tests/Markdown.Test Tests.swift	
+++ b/Tests/Markdown HTML Rendering Tests/Markdown.Test Tests.swift	
@@ -6,8 +6,11 @@ enum `Markdown Tests` {}
 extension `Markdown Tests` {
     @Suite struct Test {
         @Suite struct Unit {}
-        @Suite struct EdgeCase {}
         @Suite struct Integration {}
         @Suite(.serialized) struct Performance {}
     }
 }
+
+extension `Markdown Tests`.Test {
+    @Suite struct EdgeCase {}
+}
