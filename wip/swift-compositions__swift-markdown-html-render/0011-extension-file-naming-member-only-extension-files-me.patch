From 288d360a9195afa72f279f94b9c94de45d6c9622 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:46:13 +0000
Subject: [PATCH 11/13] extension file naming: member-only extension files
 merged into the extended type's own file (type-check follows; Linux x86_64,
 Swift 6.4.2) (coenttb/work#242)

---
 .../Render.Context+InterpretMarkdown.swift    | 23 -------------------
 .../Renderer.Document.Context.swift           | 22 ++++++++++++++++++
 2 files changed, 22 insertions(+), 23 deletions(-)
 delete mode 100644 Sources/Markdown HTML Rendering/Render.Context+InterpretMarkdown.swift

diff --git a/Sources/Markdown HTML Rendering/Render.Context+InterpretMarkdown.swift b/Sources/Markdown HTML Rendering/Render.Context+InterpretMarkdown.swift
deleted file mode 100644
index 0892623..0000000
--- a/Sources/Markdown HTML Rendering/Render.Context+InterpretMarkdown.swift	
+++ /dev/null
@@ -1,23 +0,0 @@
-import Renderer
-
-extension Renderer.Document.Context {
-
-    mutating func interpret(markdown actions: [Renderer.Document.Action]) {
-        for action in actions {
-            switch action {
-            case .style(let declaration, let atRule, let selector, let pseudo):
-                if let className = register(
-                    style: declaration,
-                    atRule: atRule,
-                    selector: selector,
-                    pseudo: pseudo
-                ) {
-                    add(class: className)
-                }
-
-            default:
-                interpret(action)
-            }
-        }
-    }
-}
diff --git a/Sources/Markdown HTML Rendering/Renderer.Document.Context.swift b/Sources/Markdown HTML Rendering/Renderer.Document.Context.swift
index 9259a47..3b94225 100644
--- a/Sources/Markdown HTML Rendering/Renderer.Document.Context.swift	
+++ b/Sources/Markdown HTML Rendering/Renderer.Document.Context.swift	
@@ -49,3 +49,25 @@ extension Renderer.Document.Context {
         )
     }
 }
+
+extension Renderer.Document.Context {
+
+    mutating func interpret(markdown actions: [Renderer.Document.Action]) {
+        for action in actions {
+            switch action {
+            case .style(let declaration, let atRule, let selector, let pseudo):
+                if let className = register(
+                    style: declaration,
+                    atRule: atRule,
+                    selector: selector,
+                    pseudo: pseudo
+                ) {
+                    add(class: className)
+                }
+
+            default:
+                interpret(action)
+            }
+        }
+    }
+}
