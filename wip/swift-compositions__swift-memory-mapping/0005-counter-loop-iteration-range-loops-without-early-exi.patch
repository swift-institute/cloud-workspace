From ac53b809c2ed357e208c3cf6f122b7309a6f8cef Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:34:03 +0000
Subject: [PATCH 5/5] counter loop iteration: range loops without early exit
 written as forEach (type-check follows; Linux x86_64, Swift 6.4.2)
 (coenttb/work#242)

---
 Tests/Memory Mapping Tests/Memory.Map Tests.swift | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/Tests/Memory Mapping Tests/Memory.Map Tests.swift b/Tests/Memory Mapping Tests/Memory.Map Tests.swift
index 467f840..2d9c720 100644
--- a/Tests/Memory Mapping Tests/Memory.Map Tests.swift	
+++ b/Tests/Memory Mapping Tests/Memory.Map Tests.swift	
@@ -701,7 +701,7 @@ extension Memory.Map.Test.Performance {
             let map = try Memory.Map(anonymousLength: 65536, access: [.read, .write])
 
             map.withUnsafeMutableBytes { buffer in
-                for i in 0..<buffer.count {
+                (0..<buffer.count).forEach { i in
                     buffer[i] = UInt8(truncatingIfNeeded: i)
                 }
             }
@@ -724,7 +724,7 @@ extension Memory.Map.Test.Performance {
             let map = try Memory.Map.anonymous(length: 65536, access: [.read, .write])
 
             map.withUnsafeMutableBytes { buffer in
-                for i in 0..<buffer.count {
+                (0..<buffer.count).forEach { i in
                     buffer[i] = UInt8(truncatingIfNeeded: i)
                 }
             }
-- 
