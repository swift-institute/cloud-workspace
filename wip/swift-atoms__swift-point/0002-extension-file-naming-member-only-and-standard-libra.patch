From 05cd31ffb5009f2172c8ce54c78cb092895fe0a7 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 20:52:46 +0000
Subject: [PATCH 2/5] extension file naming: member-only and
 standard-library-conformance extension files merge into their type's own file
 (overnight/merge-extension-files.py); single type per file: additional types
 move to their own <Parent>.<Name>.swift inside the container's extension
 (overnight/split-types.py); parse-checked; builds pending (coenttb/work#242)

---
 .../Affine/Point+Coordinate.System.swift      | 21 ------------
 Sources/Point/Point+Components.swift          | 12 -------
 Sources/Point/Point.swift                     | 33 +++++++++++++++++++
 3 files changed, 33 insertions(+), 33 deletions(-)
 delete mode 100644 Sources/Point/Integrations/Affine/Point+Coordinate.System.swift
 delete mode 100644 Sources/Point/Point+Components.swift

diff --git a/Sources/Point/Integrations/Affine/Point+Coordinate.System.swift b/Sources/Point/Integrations/Affine/Point+Coordinate.System.swift
deleted file mode 100644
index 149209c..0000000
--- a/Sources/Point/Integrations/Affine/Point+Coordinate.System.swift
+++ /dev/null
@@ -1,21 +0,0 @@
-#if Affine
-    public import Coordinate
-    public import Affine
-    public import Displacement
-
-    extension Point {
-
-        public func coordinateSystem<DisplacementScalar, Failure: Swift::Error>(
-            using affine: Affine<Self, Displacement<N, DisplacementScalar>, Failure>
-        ) -> Coordinate<N, DisplacementScalar>.System<Self, Failure> {
-            .init(
-                coordinates: { (point) throws(Failure) in
-                    Coordinate(components: try affine.displacement(from: self, to: point).components)
-                },
-                point: { (coordinates) throws(Failure) in
-                    try affine.translated(self, by: Displacement(components: coordinates.components))
-                }
-            )
-        }
-    }
-#endif
diff --git a/Sources/Point/Point+Components.swift b/Sources/Point/Point+Components.swift
deleted file mode 100644
index 76b5984..0000000
--- a/Sources/Point/Point+Components.swift
+++ /dev/null
@@ -1,12 +0,0 @@
-import Vector
-
-extension Point {
-
-    public init(_ components: consuming InlineArray<N, Scalar>) {
-        self.init(coordinates: Vector(components))
-    }
-
-    public init(repeating value: Scalar) {
-        self.init(coordinates: Vector(repeating: value))
-    }
-}
diff --git a/Sources/Point/Point.swift b/Sources/Point/Point.swift
index 6f29a7a..da67976 100644
--- a/Sources/Point/Point.swift
+++ b/Sources/Point/Point.swift
@@ -13,3 +13,36 @@ extension Point {
 extension Point: Equatable where Scalar: Equatable {}
 extension Point: Hashable where Scalar: Hashable {}
 extension Point: Sendable where Scalar: Sendable {}
+
+#if Affine
+    public import Coordinate
+    public import Affine
+    public import Displacement
+
+    extension Point {
+
+        public func coordinateSystem<DisplacementScalar, Failure: Swift::Error>(
+            using affine: Affine<Self, Displacement<N, DisplacementScalar>, Failure>
+        ) -> Coordinate<N, DisplacementScalar>.System<Self, Failure> {
+            .init(
+                coordinates: { (point) throws(Failure) in
+                    Coordinate(components: try affine.displacement(from: self, to: point).components)
+                },
+                point: { (coordinates) throws(Failure) in
+                    try affine.translated(self, by: Displacement(components: coordinates.components))
+                }
+            )
+        }
+    }
+#endif
+
+extension Point {
+
+    public init(_ components: consuming InlineArray<N, Scalar>) {
+        self.init(coordinates: Vector(components))
+    }
+
+    public init(repeating value: Scalar) {
+        self.init(coordinates: Vector(repeating: value))
+    }
+}
