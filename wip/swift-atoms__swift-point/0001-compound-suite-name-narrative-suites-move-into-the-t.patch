-        let p = Point(coordinates: Vector<2, Int>([1, 2]))
-        let screen = Tagged<Screen, Point<2, Int>>(_unchecked: p)
-        let world = Tagged<World, Point<2, Int>>(_unchecked: p)
-        #expect(screen.underlying == world.underlying)
