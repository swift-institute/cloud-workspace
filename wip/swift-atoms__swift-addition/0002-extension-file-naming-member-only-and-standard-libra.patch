Subject: [PATCH 2/4] extension file naming: member-only and
 standard-library-conformance extension files merge into their type's own file
 (overnight/merge-extension-files.py); single type per file: additional types
 move to their own <Parent>.<Name>.swift inside the container's extension
 (overnight/split-types.py); parse-checked; builds pending (coenttb/work#242)

---
 Sources/Addition/Addition.Augmented.swift | 19 -----------------
 Sources/Addition/Addition.Error.swift     |  8 ++++++++
 Sources/Addition/Addition.Signed.swift    |  6 ++++++
 Sources/Addition/Addition.swift           | 25 ++++++++++++++++++-----
 4 files changed, 34 insertions(+), 24 deletions(-)
 delete mode 100644 Sources/Addition/Addition.Augmented.swift
 create mode 100644 Sources/Addition/Addition.Error.swift
 create mode 100644 Sources/Addition/Addition.Signed.swift

diff --git a/Sources/Addition/Addition.Augmented.swift b/Sources/Addition/Addition.Augmented.swift
deleted file mode 100644
index 084f84b..0000000
--- a/Sources/Addition/Addition.Augmented.swift
+++ /dev/null
@@ -1,19 +0,0 @@
-extension Addition {
-
-    @inlinable
-    public static func augmented<T: FloatingPoint>(_ lhs: T, _ rhs: T) -> (head: T, tail: T) {
-        let head = lhs + rhs
-        let x = head - rhs
-        let y = head - x
-        return (head, (lhs - x) + (rhs - y))
-    }
-
-    @inlinable
-    public static func augmented<T: FloatingPoint>(large: T, small: T) -> (head: T, tail: T) {
-        guard T.radix == 2, large.magnitude >= small.magnitude else {
-            return augmented(large, small)
-        }
-        let head = large + small
-        return (head, (large - head) + small)
-    }
-}
diff --git a/Sources/Addition/Addition.Error.swift b/Sources/Addition/Addition.Error.swift
new file mode 100644
index 0000000..d5b8858
--- /dev/null
+++ b/Sources/Addition/Addition.Error.swift
@@ -0,0 +1,8 @@
+public import Polarity
+
+
+extension Addition {
+    public enum Error: Swift::Error, Hashable, Sendable {
+        case overflow
+    }
+}
diff --git a/Sources/Addition/Addition.Signed.swift b/Sources/Addition/Addition.Signed.swift
new file mode 100644
index 0000000..7be8ed9
--- /dev/null
+++ b/Sources/Addition/Addition.Signed.swift
@@ -0,0 +1,6 @@
+public import Polarity
+
+
+extension Addition {
+    public enum Signed {}
+}
diff --git a/Sources/Addition/Addition.swift b/Sources/Addition/Addition.swift
index 7eee6dd..2088e1b 100644
--- a/Sources/Addition/Addition.swift
+++ b/Sources/Addition/Addition.swift
@@ -4,9 +4,6 @@ public enum Addition {}
 
 extension Addition {
 
-    public enum Error: Swift::Error, Hashable, Sendable {
-        case overflow
-    }
 
     @inlinable
     public static func reporting<Value: FixedWidthInteger>(
@@ -40,8 +37,6 @@ extension Addition {
 }
 
 extension Addition {
-
-    public enum Signed {}
 }
 
 extension Addition.Signed {
@@ -113,3 +108,23 @@ extension Addition.Signed {
         (magnitude == .zero ? .positive : polarity, magnitude)
     }
 }
+
+extension Addition {
+
+    @inlinable
+    public static func augmented<T: FloatingPoint>(_ lhs: T, _ rhs: T) -> (head: T, tail: T) {
+        let head = lhs + rhs
+        let x = head - rhs
+        let y = head - x
+        return (head, (lhs - x) + (rhs - y))
+    }
+
+    @inlinable
+    public static func augmented<T: FloatingPoint>(large: T, small: T) -> (head: T, tail: T) {
+        guard T.radix == 2, large.magnitude >= small.magnitude else {
+            return augmented(large, small)
+        }
+        let head = large + small
+        return (head, (large - head) + small)
+    }
+}
