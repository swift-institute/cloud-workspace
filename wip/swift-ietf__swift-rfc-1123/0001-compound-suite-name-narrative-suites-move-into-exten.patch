From 97546da23c4b446ac9cf35970d3b5c6770e74c91 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 18:48:59 +0000
Subject: [PATCH] compound suite name: narrative suites move into extension
 <Type> named after their test file, nested suites into extension
 <Type>.<Parent> (overnight/compound-suites.py); parse-checked; builds pending
 (coenttb/work#242)

---
 .../RFC 1123 Tests/RFC 1123 Coder Tests.swift |  4 ++
 .../RFC_1123+RFC_1035 Bridge Tests.swift      | 44 ++++++++++---------
 2 files changed, 27 insertions(+), 21 deletions(-)

diff --git a/Tests/RFC 1123 Tests/RFC 1123 Coder Tests.swift b/Tests/RFC 1123 Tests/RFC 1123 Coder Tests.swift
index f85ed7c..6c0fee6 100644
--- a/Tests/RFC 1123 Tests/RFC 1123 Coder Tests.swift	
+++ b/Tests/RFC 1123 Tests/RFC 1123 Coder Tests.swift	
@@ -9,7 +9,11 @@
 
     @Suite
     struct `RFC 1123 Coder Tests` {
+    }
+
+    extension `RFC 1123 Coder Tests` {
         @Suite struct `Domain Tests` {}
+
         @Suite struct `Label Tests` {}
     }
 
diff --git a/Tests/RFC 1123 Tests/RFC_1123+RFC_1035 Bridge Tests.swift b/Tests/RFC 1123 Tests/RFC_1123+RFC_1035 Bridge Tests.swift
index 1e9fc50..40b2aa0 100644
--- a/Tests/RFC 1123 Tests/RFC_1123+RFC_1035 Bridge Tests.swift	
+++ b/Tests/RFC 1123 Tests/RFC_1123+RFC_1035 Bridge Tests.swift	
@@ -3,31 +3,33 @@ import RFC_1035
 import RFC_1123
 import Testing
 
-@Suite
-struct `RFC 1035 Bridge` {
+extension RFC_1123 {
+    @Suite
+    struct `RFC 1035 Bridge` {
 
-    @Test
-    func `Octet-form underscore label fails RFC 1123 conversion`() throws {
-        let domain = try RFC_1035.Domain(labels: [
-            try .init(octets: [Byte](utf8: "_dmarc")),
-            try .init("example"),
-            try .init("com"),
-        ])
-        #expect(domain.name == "_dmarc.example.com")
+        @Test
+        func `Octet-form underscore label fails RFC 1123 conversion`() throws {
+            let domain = try RFC_1035.Domain(labels: [
+                try .init(octets: [Byte](utf8: "_dmarc")),
+                try .init("example"),
+                try .init("com"),
+            ])
+            #expect(domain.name == "_dmarc.example.com")
 
-        #expect(throws: RFC_1123.Domain.Error.self) {
-            try RFC_1123.Domain(domain)
+            #expect(throws: RFC_1123.Domain.Error.self) {
+                try RFC_1123.Domain(domain)
+            }
         }
-    }
 
-    @Test
-    func `Presentation-valid octet-form domain converts`() throws {
-        let domain = try RFC_1035.Domain(labels: [
-            try .init(octets: [Byte](utf8: "example")),
-            try .init(octets: [Byte](utf8: "com")),
-        ])
+        @Test
+        func `Presentation-valid octet-form domain converts`() throws {
+            let domain = try RFC_1035.Domain(labels: [
+                try .init(octets: [Byte](utf8: "example")),
+                try .init(octets: [Byte](utf8: "com")),
+            ])
 
-        let converted = try RFC_1123.Domain(domain)
-        #expect(converted.name == "example.com")
+            let converted = try RFC_1123.Domain(domain)
+            #expect(converted.name == "example.com")
+        }
     }
 }
