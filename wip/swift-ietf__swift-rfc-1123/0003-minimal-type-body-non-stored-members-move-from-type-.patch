From e17da847c1ed8f5901408fef4c76e68819a2ca67 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 22:39:54 +0000
Subject: [PATCH 3/4] minimal type body: non-stored members move from type
 bodies into an extension of the type in the same file
 (overnight/minimal-bodies.py); type-checked against the root build,
 directories that failed or couldn't be checked left out (coenttb/work#242)

---
 .../RFC_1123.Domain.Coder.swift               | 38 +++++++++----------
 .../RFC_1123.Domain.Label.Coder.swift         | 38 +++++++++----------
 .../RFC_1123.Grammar.swift                    | 21 +++++-----
 3 files changed, 49 insertions(+), 48 deletions(-)

diff --git a/Sources/RFC 1123/Absorbed swift-rfc-1123-coder/RFC_1123.Domain.Coder.swift b/Sources/RFC 1123/Absorbed swift-rfc-1123-coder/RFC_1123.Domain.Coder.swift
index 2e2cb3c..5ffce90 100644
--- a/Sources/RFC 1123/Absorbed swift-rfc-1123-coder/RFC_1123.Domain.Coder.swift	
+++ b/Sources/RFC 1123/Absorbed swift-rfc-1123-coder/RFC_1123.Domain.Coder.swift	
@@ -6,31 +6,31 @@
     import Serializer
 
     extension RFC_1123.Domain {
-
         public struct Coder<Input: Cursor.`Protocol`<Byte, Never>, Buffer: RangeReplaceableCollection<Byte>>: Coding {
+            public init() {}
+        }
 
-            public typealias Output = RFC_1123.Domain
+        public static var coder: Coder<ArraySlice<Byte>, [Byte]> { .init() }
+    }
 
-            public typealias Failure = RFC_1123.Domain.Error
+extension RFC_1123.Domain.Coder {
+        public typealias Output = RFC_1123.Domain
 
-            public init() {}
+        public typealias Failure = RFC_1123.Domain.Error
 
-            public borrowing func parse(_ input: inout Input) throws(Failure) -> Output {
-                let start = input.checkpoint
-                let bytes = Scan.domain(&input)
-                do throws(Failure) {
-                    return try RFC_1123.Domain(ascii: bytes)
-                } catch {
-                    input.seek(to: start)
-                    throw error
-                }
-            }
-
-            public borrowing func serialize(_ output: Output, into buffer: inout Buffer) throws(Failure) {
-                Scan.append(output.rawValue, into: &buffer)
+        public borrowing func parse(_ input: inout Input) throws(Failure) -> Output {
+            let start = input.checkpoint
+            let bytes = Scan.domain(&input)
+            do throws(Failure) {
+                return try RFC_1123.Domain(ascii: bytes)
+            } catch {
+                input.seek(to: start)
+                throw error
             }
         }
 
-        public static var coder: Coder<ArraySlice<Byte>, [Byte]> { .init() }
-    }
+        public borrowing func serialize(_ output: Output, into buffer: inout Buffer) throws(Failure) {
+            Scan.append(output.rawValue, into: &buffer)
+        }
+}
 #endif
diff --git a/Sources/RFC 1123/Absorbed swift-rfc-1123-coder/RFC_1123.Domain.Label.Coder.swift b/Sources/RFC 1123/Absorbed swift-rfc-1123-coder/RFC_1123.Domain.Label.Coder.swift
index c60455d..01e474d 100644
--- a/Sources/RFC 1123/Absorbed swift-rfc-1123-coder/RFC_1123.Domain.Label.Coder.swift	
+++ b/Sources/RFC 1123/Absorbed swift-rfc-1123-coder/RFC_1123.Domain.Label.Coder.swift	
@@ -6,31 +6,31 @@
     import Serializer
 
     extension RFC_1123.Domain.Label {
-
         public struct Coder<Input: Cursor.`Protocol`<Byte, Never>, Buffer: RangeReplaceableCollection<Byte>>: Coding {
+            public init() {}
+        }
 
-            public typealias Output = RFC_1123.Domain.Label
+        public static var coder: Coder<ArraySlice<Byte>, [Byte]> { .init() }
+    }
 
-            public typealias Failure = RFC_1123.Domain.Label.Error
+extension RFC_1123.Domain.Label.Coder {
+        public typealias Output = RFC_1123.Domain.Label
 
-            public init() {}
+        public typealias Failure = RFC_1123.Domain.Label.Error
 
-            public borrowing func parse(_ input: inout Input) throws(Failure) -> Output {
-                let start = input.checkpoint
-                let bytes = Scan.run(&input, while: RFC_1123.Grammar.isLabelByte)
-                do throws(Failure) {
-                    return try RFC_1123.Domain.Label(ascii: bytes)
-                } catch {
-                    input.seek(to: start)
-                    throw error
-                }
-            }
-
-            public borrowing func serialize(_ output: Output, into buffer: inout Buffer) throws(Failure) {
-                Scan.append(output.rawValue, into: &buffer)
+        public borrowing func parse(_ input: inout Input) throws(Failure) -> Output {
+            let start = input.checkpoint
+            let bytes = Scan.run(&input, while: RFC_1123.Grammar.isLabelByte)
+            do throws(Failure) {
+                return try RFC_1123.Domain.Label(ascii: bytes)
+            } catch {
+                input.seek(to: start)
+                throw error
             }
         }
 
-        public static var coder: Coder<ArraySlice<Byte>, [Byte]> { .init() }
-    }
+        public borrowing func serialize(_ output: Output, into buffer: inout Buffer) throws(Failure) {
+            Scan.append(output.rawValue, into: &buffer)
+        }
+}
 #endif
diff --git a/Sources/RFC 1123/Absorbed swift-rfc-1123-coder/RFC_1123.Grammar.swift b/Sources/RFC 1123/Absorbed swift-rfc-1123-coder/RFC_1123.Grammar.swift
index 262b197..891d3e2 100644
--- a/Sources/RFC 1123/Absorbed swift-rfc-1123-coder/RFC_1123.Grammar.swift	
+++ b/Sources/RFC 1123/Absorbed swift-rfc-1123-coder/RFC_1123.Grammar.swift	
@@ -3,18 +3,19 @@
     import Byte
 
     extension RFC_1123 {
-
         enum Grammar {
+        }
+    }
 
-            static func isLabelByte(_ byte: Byte) -> Bool {
-                guard let code = try? ASCII.Code(byte) else { return false }
-                return code.isLetter || code.isDigit || code == ASCII.Code.hyphen
-            }
+extension RFC_1123.Grammar {
+        static func isLabelByte(_ byte: Byte) -> Bool {
+            guard let code = try? ASCII.Code(byte) else { return false }
+            return code.isLetter || code.isDigit || code == ASCII.Code.hyphen
+        }
 
-            static func isDomainByte(_ byte: Byte) -> Bool {
-                guard let code = try? ASCII.Code(byte) else { return false }
-                return code.isLetter || code.isDigit || code == ASCII.Code.hyphen || code == ASCII.Code.period
-            }
+        static func isDomainByte(_ byte: Byte) -> Bool {
+            guard let code = try? ASCII.Code(byte) else { return false }
+            return code.isLetter || code.isDigit || code == ASCII.Code.hyphen || code == ASCII.Code.period
         }
-    }
+}
 #endif
