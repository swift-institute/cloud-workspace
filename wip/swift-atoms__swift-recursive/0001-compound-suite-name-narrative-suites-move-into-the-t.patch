Subject: [PATCH] compound suite name: narrative suites move into the test
 module's namespace `<File> Tests` (#239's layout), nested suites into
 extension <Path>.<Parent> (overnight/compound-suites.py); parse-checked;
 builds pending (coenttb/work#242)

---
 .../Boundary Tests.swift                      | 36 ++++++++++---------
 1 file changed, 20 insertions(+), 16 deletions(-)

diff --git a/Tests/Recursive Macro Tests/Boundary Tests.swift b/Tests/Recursive Macro Tests/Boundary Tests.swift
index 946570a..8a7b1c4 100644
--- a/Tests/Recursive Macro Tests/Boundary Tests.swift	
+++ b/Tests/Recursive Macro Tests/Boundary Tests.swift	
@@ -9,24 +9,28 @@ private indirect enum Tree {
     case node(Tree, Tree)
 }
 
-@Suite
-struct `Recursive boundaries` {
-    @Test
-    func `a leaf projects to its payload without recursion`() {
-        guard case .leaf(7) = Tree.leaf(7).project() else {
-            Issue.record("Expected the leaf payload")
-            return
+enum `Boundary Tests` {}
+
+extension `Boundary Tests` {
+    @Suite
+    struct `Recursive boundaries` {
+        @Test
+        func `a leaf projects to its payload without recursion`() {
+            guard case .leaf(7) = Tree.leaf(7).project() else {
+                Issue.record("Expected the leaf payload")
+                return
+            }
         }
-    }
 
-    @Test
-    func `a node projects both children unchanged and in order`() {
-        guard case .node(let left, let right) = Tree.node(.leaf(1), .node(.leaf(2), .leaf(3))).project(),
-            case .leaf(1) = left,
-            case .node(.leaf(2), .leaf(3)) = right
-        else {
-            Issue.record("Expected both original children")
-            return
+        @Test
+        func `a node projects both children unchanged and in order`() {
+            guard case .node(let left, let right) = Tree.node(.leaf(1), .node(.leaf(2), .leaf(3))).project(),
+                case .leaf(1) = left,
+                case .node(.leaf(2), .leaf(3)) = right
+            else {
+                Issue.record("Expected both original children")
+                return
+            }
         }
     }
 }
