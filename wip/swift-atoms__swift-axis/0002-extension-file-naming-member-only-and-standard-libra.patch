From 4e4cc53552d5945343ff0eef600bc1520f195886 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 20:52:40 +0000
Subject: [PATCH 2/2] extension file naming: member-only and
 standard-library-conformance extension files merge into their type's own file
 (overnight/merge-extension-files.py); single type per file: additional types
 move to their own <Parent>.<Name>.swift inside the container's extension
 (overnight/split-types.py); parse-checked; builds pending (coenttb/work#242)

---
 Sources/Axis/Axis+Swift.Codable.swift | 25 -------------------------
 Sources/Axis/Axis.swift               | 26 ++++++++++++++++++++++++++
 2 files changed, 26 insertions(+), 25 deletions(-)
 delete mode 100644 Sources/Axis/Axis+Swift.Codable.swift

diff --git a/Sources/Axis/Axis+Swift.Codable.swift b/Sources/Axis/Axis+Swift.Codable.swift
deleted file mode 100644
index 93290e1..0000000
--- a/Sources/Axis/Axis+Swift.Codable.swift
+++ /dev/null
@@ -1,25 +0,0 @@
-#if !hasFeature(Embedded)
-    extension Axis: Swift::Codable {
-
-        public init(from decoder: any Decoder) throws(any Swift::Error) {
-            let container = try decoder.singleValueContainer()
-            let value = try container.decode(Int.self)
-            do throws(Self.Error) {
-                self = try Self(value)
-            } catch {
-                throw DecodingError.dataCorrupted(
-                    DecodingError.Context(
-                        codingPath: decoder.codingPath,
-                        debugDescription:
-                            "Axis index \(value) out of bounds for \(N)-dimensional space"
-                    )
-                )
-            }
-        }
-
-        public func encode(to encoder: any Encoder) throws(any Swift::Error) {
-            var container = encoder.singleValueContainer()
-            try container.encode(underlying)
-        }
-    }
-#endif
diff --git a/Sources/Axis/Axis.swift b/Sources/Axis/Axis.swift
index a4b60c7..7f45685 100644
--- a/Sources/Axis/Axis.swift
+++ b/Sources/Axis/Axis.swift
@@ -98,3 +98,29 @@ extension Axis where N == 4 {
     @inlinable
     public static var quaternary: Self { Self(_unchecked: (), 3) }
 }
+
+#if !hasFeature(Embedded)
+    extension Axis: Swift::Codable {
+
+        public init(from decoder: any Decoder) throws(any Swift::Error) {
+            let container = try decoder.singleValueContainer()
+            let value = try container.decode(Int.self)
+            do throws(Self.Error) {
+                self = try Self(value)
+            } catch {
+                throw DecodingError.dataCorrupted(
+                    DecodingError.Context(
+                        codingPath: decoder.codingPath,
+                        debugDescription:
+                            "Axis index \(value) out of bounds for \(N)-dimensional space"
+                    )
+                )
+            }
+        }
+
+        public func encode(to encoder: any Encoder) throws(any Swift::Error) {
+            var container = encoder.singleValueContainer()
+            try container.encode(underlying)
+        }
+    }
+#endif
