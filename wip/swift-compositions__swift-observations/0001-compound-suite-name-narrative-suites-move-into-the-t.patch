 builds pending (coenttb/work#242)

---
 .../Observations Tests/Observer.Tracking Tests.swift  | 11 ++++++++---
 1 file changed, 8 insertions(+), 3 deletions(-)

diff --git a/Tests/Observations Tests/Observer.Tracking Tests.swift b/Tests/Observations Tests/Observer.Tracking Tests.swift
index b8df45c..4bd5315 100644
--- a/Tests/Observations Tests/Observer.Tracking Tests.swift	
+++ b/Tests/Observations Tests/Observer.Tracking Tests.swift	
@@ -14,12 +14,17 @@ enum `Observer.Tracking Tests` {}
 extension `Observer.Tracking Tests` {
     @Suite
     struct Test {
-        @Suite struct `Context Capture` {}
-        @Suite struct `With Observer Tracking` {}
-        @Suite struct `Token` {}
     }
 }
 
+extension `Observer.Tracking Tests`.Test {
+    @Suite struct `Context Capture` {}
+
+    @Suite struct `With Observer Tracking` {}
+
+    @Suite struct `Token` {}
+}
+
 extension `Observer.Tracking Tests`.Test.`Context Capture` {
 
     @Test
