From fef79d444779c0fc8bf2312684c49b939b8f9082 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 19:34:14 +0000
Subject: [PATCH] compound suite name: narrative suites move into the test
 module's namespace `<File> Tests` (#239's layout), nested suites into
 extension <Path>.<Parent> (overnight/compound-suites.py); parse-checked;
 builds pending (coenttb/work#242)

---
 .../List Post Error Boundary Tests.swift      | 42 +++++----
 .../ReadmeVerification Tests.swift            | 90 ++++++++++---------
 2 files changed, 70 insertions(+), 62 deletions(-)

diff --git a/Tests/RFC 2369 Tests/List Post Error Boundary Tests.swift b/Tests/RFC 2369 Tests/List Post Error Boundary Tests.swift
index 2f4849b..8ffb203 100644
--- a/Tests/RFC 2369 Tests/List Post Error Boundary Tests.swift	
+++ b/Tests/RFC 2369 Tests/List Post Error Boundary Tests.swift	
@@ -2,27 +2,31 @@ import RFC_2369
 import RFC_3987
 import Testing
 
-@Suite
-struct `List-Post error boundaries` {
-    @Test
-    func `an empty value is refused`() {
-        #expect(throws: RFC_2369.List.Post.Error.self) { try RFC_2369.List.Post("") }
-    }
+enum `List Post Error Boundary Tests` {}
 
-    @Test(arguments: ["mailto:list@host.com", "(only a comment)", "   "])
-    func `a value without an angle-bracketed URI or NO is refused`(_ value: String) {
-        #expect(throws: RFC_2369.List.Post.Error.self) { try RFC_2369.List.Post(value) }
-    }
+extension `List Post Error Boundary Tests` {
+    @Suite
+    struct `List-Post error boundaries` {
+        @Test
+        func `an empty value is refused`() {
+            #expect(throws: RFC_2369.List.Post.Error.self) { try RFC_2369.List.Post("") }
+        }
 
-    @Test
-    func `nested comments are skipped before the URI`() throws {
-        let post = try RFC_2369.List.Post("((nested) comment) <mailto:list@host.com>")
-        #expect(post == .uris([RFC_3987.IRI("mailto:list@host.com")]))
-    }
+        @Test(arguments: ["mailto:list@host.com", "(only a comment)", "   "])
+        func `a value without an angle-bracketed URI or NO is refused`(_ value: String) {
+            #expect(throws: RFC_2369.List.Post.Error.self) { try RFC_2369.List.Post(value) }
+        }
+
+        @Test
+        func `nested comments are skipped before the URI`() throws {
+            let post = try RFC_2369.List.Post("((nested) comment) <mailto:list@host.com>")
+            #expect(post == .uris([RFC_3987.IRI("mailto:list@host.com")]))
+        }
 
-    @Test
-    func `several URIs keep their order`() throws {
-        let post = try RFC_2369.List.Post("<mailto:a@host.com>, <https://host.com/post>")
-        #expect(post == .uris([RFC_3987.IRI("mailto:a@host.com"), RFC_3987.IRI("https://host.com/post")]))
+        @Test
+        func `several URIs keep their order`() throws {
+            let post = try RFC_2369.List.Post("<mailto:a@host.com>, <https://host.com/post>")
+            #expect(post == .uris([RFC_3987.IRI("mailto:a@host.com"), RFC_3987.IRI("https://host.com/post")]))
+        }
     }
 }
diff --git a/Tests/RFC 2369 Tests/ReadmeVerification Tests.swift b/Tests/RFC 2369 Tests/ReadmeVerification Tests.swift
index 9f49b9f..b860055 100644
--- a/Tests/RFC 2369 Tests/ReadmeVerification Tests.swift	
+++ b/Tests/RFC 2369 Tests/ReadmeVerification Tests.swift	
@@ -3,48 +3,52 @@ import Testing
 
 @testable import RFC_2369
 
-@Suite
-struct `README Verification` {
-
-    @Test
-    func `Example from README: Creating List Headers`() {
-
-        let headers = RFC_2369.List.Header(
-            help: RFC_3987.IRI("https://example.com/help"),
-            unsubscribe: [
-                RFC_3987.IRI("https://example.com/unsubscribe"),
-                RFC_3987.IRI("mailto:unsubscribe@example.com"),
-            ],
-            subscribe: [RFC_3987.IRI("https://example.com/subscribe")],
-            post: .uris([RFC_3987.IRI("mailto:list@example.com")]),
-            owner: [RFC_3987.IRI("mailto:owner@example.com")],
-            archive: RFC_3987.IRI("https://example.com/archive")
-        )
-
-        #expect(headers.help != nil)
-        #expect(headers.unsubscribe?.count == 2)
-    }
-
-    @Test
-    func `Example from README: Rendering as Email Headers`() {
-        let headers = RFC_2369.List.Header(
-            help: RFC_3987.IRI("https://example.com/help")
-        )
-
-        let emailHeaders = [String: String](listHeader: headers)
-
-        #expect(emailHeaders["List-Help"] == "<https://example.com/help>")
-    }
-
-    @Test
-    func `Example from README: Announcement-Only Lists`() {
-
-        let headers = RFC_2369.List.Header(
-            help: RFC_3987.IRI("https://example.com/help"),
-            post: .noPosting
-        )
-
-        let emailHeaders = [String: String](listHeader: headers)
-        #expect(emailHeaders["List-Post"] == "NO")
+enum `ReadmeVerification Tests` {}
+
+extension `ReadmeVerification Tests` {
+    @Suite
+    struct `README Verification` {
+
+        @Test
+        func `Example from README: Creating List Headers`() {
+
+            let headers = RFC_2369.List.Header(
+                help: RFC_3987.IRI("https://example.com/help"),
+                unsubscribe: [
+                    RFC_3987.IRI("https://example.com/unsubscribe"),
+                    RFC_3987.IRI("mailto:unsubscribe@example.com"),
+                ],
+                subscribe: [RFC_3987.IRI("https://example.com/subscribe")],
+                post: .uris([RFC_3987.IRI("mailto:list@example.com")]),
+                owner: [RFC_3987.IRI("mailto:owner@example.com")],
+                archive: RFC_3987.IRI("https://example.com/archive")
+            )
+
+            #expect(headers.help != nil)
+            #expect(headers.unsubscribe?.count == 2)
+        }
+
+        @Test
+        func `Example from README: Rendering as Email Headers`() {
+            let headers = RFC_2369.List.Header(
+                help: RFC_3987.IRI("https://example.com/help")
+            )
+
+            let emailHeaders = [String: String](listHeader: headers)
+
+            #expect(emailHeaders["List-Help"] == "<https://example.com/help>")
+        }
+
+        @Test
+        func `Example from README: Announcement-Only Lists`() {
+
+            let headers = RFC_2369.List.Header(
+                help: RFC_3987.IRI("https://example.com/help"),
+                post: .noPosting
+            )
+
+            let emailHeaders = [String: String](listHeader: headers)
+            #expect(emailHeaders["List-Post"] == "NO")
+        }
     }
 }
