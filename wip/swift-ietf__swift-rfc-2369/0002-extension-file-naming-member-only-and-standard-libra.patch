From 563851f9910f079bf6f1d57a31fd162185c22199 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 20:52:52 +0000
Subject: [PATCH 2/2] extension file naming: member-only and
 standard-library-conformance extension files merge into their type's own file
 (overnight/merge-extension-files.py); single type per file: additional types
 move to their own <Parent>.<Name>.swift inside the container's extension
 (overnight/split-types.py); parse-checked; builds pending (coenttb/work#242)

---
 Sources/RFC 2369/RFC_2369.List.Header.Parse.Error.swift | 9 +++++++++
 Sources/RFC 2369/RFC_2369.List.Header.Parse.swift       | 4 ----
 2 files changed, 9 insertions(+), 4 deletions(-)
 create mode 100644 Sources/RFC 2369/RFC_2369.List.Header.Parse.Error.swift

diff --git a/Sources/RFC 2369/RFC_2369.List.Header.Parse.Error.swift b/Sources/RFC 2369/RFC_2369.List.Header.Parse.Error.swift
new file mode 100644
index 0000000..e0c5f68
--- /dev/null
+++ b/Sources/RFC 2369/RFC_2369.List.Header.Parse.Error.swift	
@@ -0,0 +1,9 @@
+public import Parser
+
+
+extension RFC_2369.List.Header.Parse {
+    public enum Error: Swift::Error, Sendable, Equatable {
+        case expectedOpenAngle
+        case unterminatedURI
+    }
+}
diff --git a/Sources/RFC 2369/RFC_2369.List.Header.Parse.swift b/Sources/RFC 2369/RFC_2369.List.Header.Parse.swift
index 443a262..1faa8c9 100644
--- a/Sources/RFC 2369/RFC_2369.List.Header.Parse.swift	
+++ b/Sources/RFC 2369/RFC_2369.List.Header.Parse.swift	
@@ -12,10 +12,6 @@ extension RFC_2369.List.Header {
 extension RFC_2369.List.Header.Parse {
     public typealias Output = [Input]
 
-    public enum Error: Swift::Error, Sendable, Equatable {
-        case expectedOpenAngle
-        case unterminatedURI
-    }
 }
 
 extension RFC_2369.List.Header.Parse: Parsing {
