From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:40:28 +0000
Subject: [PATCH 2/3] exported import, architecture import boundary: re-exports
 moved into the target's root exports.swift (re-export set unchanged;
 type-check follows; Linux x86_64, Swift 6.4.2) (coenttb/work#242)

---
 Sources/IPv6 Standard/IPv6Standard.swift | 6 +++---
 Sources/IPv6 Standard/exports.swift      | 3 +++
 2 files changed, 6 insertions(+), 3 deletions(-)
 create mode 100644 Sources/IPv6 Standard/exports.swift

diff --git a/Sources/IPv6 Standard/IPv6Standard.swift b/Sources/IPv6 Standard/IPv6Standard.swift
index 82660be..ef075fb 100644
--- a/Sources/IPv6 Standard/IPv6Standard.swift	
+++ b/Sources/IPv6 Standard/IPv6Standard.swift	
@@ -1,6 +1,6 @@
-@_exported import RFC_4007
-@_exported import RFC_4291
-@_exported import RFC_5952
+public import RFC_4007
+public import RFC_4291
+public import RFC_5952
 
 public enum IPv6Standard {}
 
diff --git a/Sources/IPv6 Standard/exports.swift b/Sources/IPv6 Standard/exports.swift
new file mode 100644
index 0000000..473d57d
--- /dev/null
+++ b/Sources/IPv6 Standard/exports.swift	
@@ -0,0 +1,3 @@
+@_exported public import RFC_4007
+@_exported public import RFC_4291
+@_exported public import RFC_5952
