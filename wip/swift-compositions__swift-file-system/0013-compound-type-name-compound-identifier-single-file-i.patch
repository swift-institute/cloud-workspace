From 1a98962c472e05e7dc033ee016a6a481fd1f2da5 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:32:51 +0000
Subject: [PATCH 13/13] compound type name, compound identifier: single-file
 internal types made fileprivate, package members used only in their target
 made internal (type-check follows; Linux x86_64, Swift 6.4.2)
 (coenttb/work#242)

---
 Sources/File System Core/File.Handle.swift                | 2 +-
 Sources/File System Core/File.Path.swift                  | 2 +-
 Sources/File System/File.Directory.Glob.swift             | 4 ++--
 Sources/File System/File.System.IO.Error+Completion.swift | 2 +-
 4 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/Sources/File System Core/File.Handle.swift b/Sources/File System Core/File.Handle.swift
index 1234a48..3bfc365 100644
--- a/Sources/File System Core/File.Handle.swift	
+++ b/Sources/File System Core/File.Handle.swift	
@@ -70,7 +70,7 @@ extension File.Handle {
     }
 
     @inlinable
-    package mutating func writeAll(
+    mutating func writeAll(
         _ buffer: UnsafeRawBufferPointer
     ) throws(File.Handle.Error) {
         var totalWritten = 0
diff --git a/Sources/File System Core/File.Path.swift b/Sources/File System Core/File.Path.swift
index feb261b..d5a52df 100644
--- a/Sources/File System Core/File.Path.swift	
+++ b/Sources/File System Core/File.Path.swift	
@@ -21,7 +21,7 @@ extension File.Path {
     }
 
     @usableFromInline
-    package var parentOrSelf: Path::Path {
+    var parentOrSelf: Path::Path {
         parent ?? self
     }
 }
diff --git a/Sources/File System/File.Directory.Glob.swift b/Sources/File System/File.Directory.Glob.swift
index 77c6e41..2b97898 100644
--- a/Sources/File System/File.Directory.Glob.swift	
+++ b/Sources/File System/File.Directory.Glob.swift	
@@ -25,7 +25,7 @@
     extension File.Directory.Glob {
 
         @inlinable
-        package func matchPaths(
+        func matchPaths(
             include: [Glob.Pattern],
             excluding: [Glob.Pattern],
             options: Glob.Options
@@ -42,7 +42,7 @@
         }
 
         @inlinable
-        package func matchPaths(
+        func matchPaths(
             include: [Swift.String],
             excluding: [Swift.String],
             options: Glob.Options
diff --git a/Sources/File System/File.System.IO.Error+Completion.swift b/Sources/File System/File.System.IO.Error+Completion.swift
index d62e25b..a3e3a26 100644
--- a/Sources/File System/File.System.IO.Error+Completion.swift	
+++ b/Sources/File System/File.System.IO.Error+Completion.swift	
@@ -6,7 +6,7 @@
         extension Completion.Failure {
 
             @usableFromInline
-            package var fileSystemError: File.System.IO.Error {
+            var fileSystemError: File.System.IO.Error {
                 switch self {
                 case .cancelled:
                     return .cancelled
