From b881547edff7442ed69ce700f010707407917ebe Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:34:03 +0000
Subject: [PATCH 09/15] counter loop iteration: range loops without early exit
 written as forEach (type-check follows; Linux x86_64, Swift 6.4.2)
 (coenttb/work#242)

---
 Sources/File System Core/File.Name.swift                        | 2 +-
 Tests/File System Core Tests/File.Name Tests.swift              | 2 +-
 Tests/File System Core Tests/File.System.Canonical Tests.swift  | 2 +-
 Tests/File System Core Tests/File.System.Copy Tests.swift       | 2 +-
 .../File.System.Copy.Recursive Tests.swift                      | 2 +-
 5 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/Sources/File System Core/File.Name.swift b/Sources/File System Core/File.Name.swift
index 79dafa2..607f068 100644
--- a/Sources/File System Core/File.Name.swift	
+++ b/Sources/File System Core/File.Name.swift	
@@ -84,7 +84,7 @@ extension File.Name {
             let span = view.span
             var bytes: [Path::Path.Char] = []
             bytes.reserveCapacity(span.count)
-            for i in 0..<span.count {
+            (0..<span.count).forEach { i in
                 bytes.append(span[i])
             }
             return File.Name(rawBytes: bytes)
diff --git a/Tests/File System Core Tests/File.Name Tests.swift b/Tests/File System Core Tests/File.Name Tests.swift
index 3f57947..93f52a8 100644
--- a/Tests/File System Core Tests/File.Name Tests.swift	
+++ b/Tests/File System Core Tests/File.Name Tests.swift	
@@ -350,7 +350,7 @@ extension `File.Name Tests` {
             let bytes = name.withCodeUnits { span -> [UInt8] in
                 var collected: [UInt8] = []
                 collected.reserveCapacity(span.count)
-                for i in 0..<span.count { collected.append(span[i]) }
+                (0..<span.count).forEach { i in collected.append(span[i]) }
                 return collected
             }
             #expect(bytes == [0x66, 0x69, 0x6C, 0x65])
diff --git a/Tests/File System Core Tests/File.System.Canonical Tests.swift b/Tests/File System Core Tests/File.System.Canonical Tests.swift
index 00df459..890157f 100644
--- a/Tests/File System Core Tests/File.System.Canonical Tests.swift	
+++ b/Tests/File System Core Tests/File.System.Canonical Tests.swift	
@@ -60,7 +60,7 @@ extension `File.System.Canonical Tests`.Test.Unit {
             try File.Directory.temporary { directory in
                 var rawTarget: [File.Path.Char] = []
                 rawTarget.reserveCapacity(directory.path.count + 3)
-                for index in 0..<directory.path.count {
+                (0..<directory.path.count).forEach { index in
                     rawTarget.append(directory.path.unit(at: index))
                 }
                 rawTarget.append(0x2F)
diff --git a/Tests/File System Core Tests/File.System.Copy Tests.swift b/Tests/File System Core Tests/File.System.Copy Tests.swift
index 4b43e5a..9006238 100644
--- a/Tests/File System Core Tests/File.System.Copy Tests.swift	
+++ b/Tests/File System Core Tests/File.System.Copy Tests.swift	
@@ -379,7 +379,7 @@ extension `File.System.Copy Tests`.Test.Unit {
                         let largeSize = 2 * 1024 * 1024
                         var largeContent = [Byte]()
                         largeContent.reserveCapacity(largeSize)
-                        for i in 0..<largeSize {
+                        (0..<largeSize).forEach { i in
                             largeContent.append(Byte(bitPattern: UInt8(i % 256)))
                         }
 
diff --git a/Tests/File System Core Tests/File.System.Copy.Recursive Tests.swift b/Tests/File System Core Tests/File.System.Copy.Recursive Tests.swift
index ba5244c..c8a87cf 100644
--- a/Tests/File System Core Tests/File.System.Copy.Recursive Tests.swift	
+++ b/Tests/File System Core Tests/File.System.Copy.Recursive Tests.swift	
@@ -237,7 +237,7 @@ extension `File.System.Copy.Recursive Tests` {
                 let destPath = dir.path / "dest"
 
                 var currentPath = sourcePath
-                for i in 1...5 {
+                (1...5).forEach { i in
                     let component = File.Path.Component("\(i)")
                     currentPath = currentPath.appending(component)
                 }
