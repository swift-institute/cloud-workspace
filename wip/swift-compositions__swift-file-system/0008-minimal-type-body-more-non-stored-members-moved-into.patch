Subject: [PATCH 08/16] minimal type body: more non-stored members moved into
 an extension of their type (batch 10; type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 .../File.Directory.Watch.Iterator.swift       | 32 +++++++++----------
 .../File.Directory.Watch.State.swift          | 23 ++++++-------
 2 files changed, 26 insertions(+), 29 deletions(-)

diff --git a/Sources/File System/File.Directory.Watch.Iterator.swift b/Sources/File System/File.Directory.Watch.Iterator.swift
index 40378a8..07b7991 100644
--- a/Sources/File System/File.Directory.Watch.Iterator.swift	
+++ b/Sources/File System/File.Directory.Watch.Iterator.swift	
@@ -2,9 +2,7 @@
     #if os(macOS) || os(iOS) || os(tvOS) || os(watchOS) || os(visionOS)
 
         extension File.Directory.Watch {
-
             public struct Iterator: AsyncIteratorProtocol, Sendable {
-
                 private let path: File.Path
 
                 private let options: Options
@@ -15,23 +13,25 @@
                     self.path = path
                     self.options = options
                 }
+            }
+        }
 
-                public mutating func next(
-                    isolation actor: isolated (any Actor)? = #isolation
-                ) async throws(File.Directory.Watch.Error) -> File.Directory? {
-                    if state == nil {
-                        state = try State(path: path, options: options)
-                    }
-                    guard let state else { return nil }
-                    let result = await withTaskCancellationHandler {
-                        await state.next()
-                    } onCancel: {
-                        state.wakeup.wake()
-                    }
-                    return try result.get()
+extension File.Directory.Watch.Iterator {
+            public mutating func next(
+                isolation actor: isolated (any Actor)? = #isolation
+            ) async throws(File.Directory.Watch.Error) -> File.Directory? {
+                if state == nil {
+                    state = try State(path: path, options: options)
+                }
+                guard let state else { return nil }
+                let result = await withTaskCancellationHandler {
+                    await state.next()
+                } onCancel: {
+                    state.wakeup.wake()
                 }
+                return try result.get()
             }
-        }
+}
 
     #endif
 #endif
