From 9675f8963ff2b02877cc5dda09179d0aff2654ab Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:35:32 +0000
Subject: [PATCH 10/15] statement where expression fits: single-value if/else
 chains written as if expressions (type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 Tests/Support/File.Directory.Temporary.swift | 14 +++++++-------
 1 file changed, 7 insertions(+), 7 deletions(-)

diff --git a/Tests/Support/File.Directory.Temporary.swift b/Tests/Support/File.Directory.Temporary.swift
index eadf3a4..a65d21e 100644
--- a/Tests/Support/File.Directory.Temporary.swift
+++ b/Tests/Support/File.Directory.Temporary.swift
@@ -39,18 +39,18 @@ extension File.Directory.Temporary {
         get throws {
             let path: Swift.String
             #if os(Windows)
-                if let temp = getEnvironmentVariable("TEMP") {
-                    path = temp
+                path = if let temp = getEnvironmentVariable("TEMP") {
+                    temp
                 } else if let tmp = getEnvironmentVariable("TMP") {
-                    path = tmp
+                    tmp
                 } else {
-                    path = "C:\\Temp"
+                    "C:\\Temp"
                 }
             #else
-                if let ptr = unsafe getenv("TMPDIR") {
-                    path = unsafe Swift.String(cString: ptr)
+                path = if let ptr = unsafe getenv("TMPDIR") {
+                    unsafe Swift.String(cString: ptr)
                 } else {
-                    path = "/tmp"
+                    "/tmp"
                 }
             #endif
             return try File.Directory(validating: path)
-- 
2.43.0

