From 20fbcf50ebe4b605115a0eb7dcaaf48214263af7 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 07:42:52 +0000
Subject: [PATCH 5/5] swift-format with the Institute configuration on files
 this session changed (coenttb/work#242)

---
 Sources/RFC 3339/RFC_3339.Offset.swift | 22 ++++++++++++----------
 1 file changed, 12 insertions(+), 10 deletions(-)

diff --git a/Sources/RFC 3339/RFC_3339.Offset.swift b/Sources/RFC 3339/RFC_3339.Offset.swift
index d4e3454..623e51a 100644
--- a/Sources/RFC 3339/RFC_3339.Offset.swift	
+++ b/Sources/RFC 3339/RFC_3339.Offset.swift	
@@ -47,11 +47,12 @@ extension RFC_3339.Offset {
             throw Error.offsetOutOfRange(seconds)
         }
 
-        self = if seconds == 0 {
-            .utc
-        } else {
-            .offset(seconds: seconds)
-        }
+        self =
+            if seconds == 0 {
+                .utc
+            } else {
+                .offset(seconds: seconds)
+            }
     }
 }
 
@@ -200,11 +201,12 @@ extension RFC_3339.Offset: ASCII.Parseable {
         let offsetSeconds = sign * (hours * 3600 + minutes * 60)
 
         if offsetSeconds == 0 {
-            self = if sign == -1 {
-                .unknownLocalOffset
-            } else {
-                .utc
-            }
+            self =
+                if sign == -1 {
+                    .unknownLocalOffset
+                } else {
+                    .utc
+                }
             return
         }
 
