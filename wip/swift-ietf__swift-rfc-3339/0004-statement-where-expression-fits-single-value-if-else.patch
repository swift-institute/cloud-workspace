From 9c79ca68499c958f64300159f15c61775cb69f08 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:35:30 +0000
Subject: [PATCH 4/5] statement where expression fits: single-value if/else
 chains written as if expressions (type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 Sources/RFC 3339/RFC_3339.Offset.swift | 12 ++++++------
 1 file changed, 6 insertions(+), 6 deletions(-)

diff --git a/Sources/RFC 3339/RFC_3339.Offset.swift b/Sources/RFC 3339/RFC_3339.Offset.swift
index 2b4ba86..d4e3454 100644
--- a/Sources/RFC 3339/RFC_3339.Offset.swift	
+++ b/Sources/RFC 3339/RFC_3339.Offset.swift	
@@ -47,10 +47,10 @@ extension RFC_3339.Offset {
             throw Error.offsetOutOfRange(seconds)
         }
 
-        if seconds == 0 {
-            self = .utc
+        self = if seconds == 0 {
+            .utc
         } else {
-            self = .offset(seconds: seconds)
+            .offset(seconds: seconds)
         }
     }
 }
@@ -200,10 +200,10 @@ extension RFC_3339.Offset: ASCII.Parseable {
         let offsetSeconds = sign * (hours * 3600 + minutes * 60)
 
         if offsetSeconds == 0 {
-            if sign == -1 {
-                self = .unknownLocalOffset
+            self = if sign == -1 {
+                .unknownLocalOffset
             } else {
-                self = .utc
+                .utc
             }
             return
         }
-- 
2.43.0

