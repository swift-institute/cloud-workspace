From 561cce243637c39325fd6c0c860783524fdb2f8c Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 18:48:49 +0000
Subject: [PATCH] compound suite name: narrative suites move into extension
 <Type> named after their test file, nested suites into extension
 <Type>.<Parent> (overnight/compound-suites.py); parse-checked; builds pending
 (coenttb/work#242)

---
 .../Advancement Tests/Advancement Tests.swift | 30 ++++++++++---------
 1 file changed, 16 insertions(+), 14 deletions(-)

diff --git a/Tests/Advancement Tests/Advancement Tests.swift b/Tests/Advancement Tests/Advancement Tests.swift
index 9f144ae..0bb3f20 100644
--- a/Tests/Advancement Tests/Advancement Tests.swift	
+++ b/Tests/Advancement Tests/Advancement Tests.swift	
@@ -2,22 +2,24 @@ import Addition
 import Advancement
 import Testing
 
-@Suite
-struct `Advancement checks and saturates movement by a count` {
+extension Advancement {
+    @Suite
+    struct `Advancement checks and saturates movement by a count` {
 
-    @Test
-    func `Advancement reports and throws on overflow`() {
-        let report = Advancement.reporting(UInt.max, by: 1)
-        #expect(report.value == 0)
-        #expect(report.overflow)
-        #expect(throws: Addition.Error.overflow) {
-            try Advancement.exact(UInt.max, by: 1)
+        @Test
+        func `Advancement reports and throws on overflow`() {
+            let report = Advancement.reporting(UInt.max, by: 1)
+            #expect(report.value == 0)
+            #expect(report.overflow)
+            #expect(throws: Addition.Error.overflow) {
+                try Advancement.exact(UInt.max, by: 1)
+            }
         }
-    }
 
-    @Test
-    func `Exact and saturating advancement handle forward movement`() throws {
-        #expect(try Advancement.exact(UInt(4), by: 3) == 7)
-        #expect(Advancement.saturating(UInt.max - 1, by: 2) == UInt.max)
+        @Test
+        func `Exact and saturating advancement handle forward movement`() throws {
+            #expect(try Advancement.exact(UInt(4), by: 3) == 7)
+            #expect(Advancement.saturating(UInt.max - 1, by: 2) == UInt.max)
+        }
     }
 }
