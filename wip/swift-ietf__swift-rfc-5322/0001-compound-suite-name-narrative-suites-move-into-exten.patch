--- a/Tests/RFC 5322 Foundation Integration Tests/RFC_5322.Date.FormatStyle Tests.swift	
+++ b/Tests/RFC 5322 Foundation Integration Tests/RFC_5322.Date.FormatStyle Tests.swift	
@@ -3,128 +3,132 @@ import RFC_5322
 import RFC_5322_Foundation_Integration
 import Testing
 
-@Suite
-struct `Foundation Date Formatting` {
