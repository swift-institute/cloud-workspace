From 528afc3a06673ef341d7f9c8295127a38446c747 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:35:30 +0000
Subject: [PATCH 12/13] statement where expression fits: single-value if/else
 chains written as if expressions (type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 Sources/RFC 5322/RFC_5322.Header.Value.swift | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/Sources/RFC 5322/RFC_5322.Header.Value.swift b/Sources/RFC 5322/RFC_5322.Header.Value.swift
index e605c66..56e3ead 100644
--- a/Sources/RFC 5322/RFC_5322.Header.Value.swift	
+++ b/Sources/RFC 5322/RFC_5322.Header.Value.swift	
@@ -123,10 +123,10 @@ extension RFC_5322.Header.Value {
             guard valid else {
                 let string = String(decoding: trimmed.lazy.map(\.underlying), as: UTF8.self)
                 let reason: String
-                if code.isControl {
-                    reason = "Control characters not allowed (except HTAB)"
+                reason = if code.isControl {
+                    "Control characters not allowed (except HTAB)"
                 } else {
-                    reason = "Must be printable ASCII or HTAB"
+                    "Must be printable ASCII or HTAB"
                 }
                 throw Error.invalidCharacter(string, code: code, reason: reason)
             }
