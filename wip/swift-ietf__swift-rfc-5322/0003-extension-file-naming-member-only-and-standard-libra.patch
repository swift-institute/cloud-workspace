From d6ed1c63d9918fd351e649c8125e574c212a3132 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 20:52:52 +0000
Subject: [PATCH 03/13] extension file naming: member-only and
 standard-library-conformance extension files merge into their type's own file
 (overnight/merge-extension-files.py); single type per file: additional types
 move to their own <Parent>.<Name>.swift inside the container's extension
 (overnight/split-types.py); parse-checked; builds pending (coenttb/work#242)

---
 .../RFC 5322/RFC_5322.Mailbox.LocalPart.Storage.swift | 11 +++++++++++
 Sources/RFC 5322/RFC_5322.Mailbox.LocalPart.swift     |  5 -----
 2 files changed, 11 insertions(+), 5 deletions(-)
 create mode 100644 Sources/RFC 5322/RFC_5322.Mailbox.LocalPart.Storage.swift

diff --git a/Sources/RFC 5322/RFC_5322.Mailbox.LocalPart.Storage.swift b/Sources/RFC 5322/RFC_5322.Mailbox.LocalPart.Storage.swift
new file mode 100644
index 0000000..d53c4bc
--- /dev/null
+++ b/Sources/RFC 5322/RFC_5322.Mailbox.LocalPart.Storage.swift	
@@ -0,0 +1,11 @@
+import ASCII
+public import Byte
+import INCITS_4_1986
+
+
+extension RFC_5322.Mailbox.LocalPart {
+    package enum Storage: Hashable {
+        case dotAtom([Byte])
+        case quoted([Byte])
+    }
+}
diff --git a/Sources/RFC 5322/RFC_5322.Mailbox.LocalPart.swift b/Sources/RFC 5322/RFC_5322.Mailbox.LocalPart.swift
index d17250c..382ea47 100644
--- a/Sources/RFC 5322/RFC_5322.Mailbox.LocalPart.swift	
+++ b/Sources/RFC 5322/RFC_5322.Mailbox.LocalPart.swift	
@@ -10,11 +10,6 @@ extension RFC_5322.Mailbox {
 }
 
 extension RFC_5322.Mailbox.LocalPart {
-
-    package enum Storage: Hashable {
-        case dotAtom([Byte])
-        case quoted([Byte])
-    }
 }
 
 extension RFC_5322.Mailbox.LocalPart {
