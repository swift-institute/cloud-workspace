From 6d1fb3a7d9fefa61d4a94d49fd60559d1903896f Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:24:52 +0000
Subject: [PATCH 17/18] trait consistency: dependencies imported only under a
 trait get that trait's condition (runner repair; Linux x86_64, Swift 6.4.2)
 (coenttb/work#242)

---
 Package.swift | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Package.swift b/Package.swift
index d30362d..1ff39bf 100644
--- a/Package.swift
+++ b/Package.swift
@@ -155,7 +155,7 @@ let package = Package(
             name: "RFC 5322 Tests",
             dependencies: [
                 .target(name: "RFC 5322"),
-                .product(name: "ASCII", package: "swift-ascii"),
+                .product(name: "ASCII", package: "swift-ascii", condition: .when(traits: ["Coder"])),
                 .product(name: "Byte", package: "swift-byte"),
                 .product(name: "Time", package: "swift-time"),
                 .product(name: "Coder", package: "swift-coder", condition: .when(traits: ["Coder"])),
