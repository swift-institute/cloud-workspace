+        public let parser: Op
+
+        public let precedence: Int
+
+        public let associativity: Associativity
+
+        public let apply: (Operand, Operand) -> Operand
+
+        @inlinable
+        public init(
+            parser: Op,
+            precedence: Int,
+            associativity: Associativity,
+            apply: @escaping (Operand, Operand) -> Operand
