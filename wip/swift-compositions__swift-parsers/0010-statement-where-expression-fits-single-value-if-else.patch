Subject: [PATCH 10/10] statement where expression fits: single-value if/else
 chains written as if expressions (type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 Sources/Parsers/Parsers.Diagnostic.swift | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/Sources/Parsers/Parsers.Diagnostic.swift b/Sources/Parsers/Parsers.Diagnostic.swift
index a84c1b1..7eb289a 100644
--- a/Sources/Parsers/Parsers.Diagnostic.swift
+++ b/Sources/Parsers/Parsers.Diagnostic.swift
@@ -50,11 +50,11 @@ extension Parsers.Diagnostic.Source {
         let start = lineStarts[idx]
         let end: String.Index
 
-        if idx + 1 < lineStarts.count {
+        end = if idx + 1 < lineStarts.count {
 
-            end = content.index(before: lineStarts[idx + 1])
+            content.index(before: lineStarts[idx + 1])
         } else {
-            end = content.endIndex
+            content.endIndex
         }
 
         if start >= end {
