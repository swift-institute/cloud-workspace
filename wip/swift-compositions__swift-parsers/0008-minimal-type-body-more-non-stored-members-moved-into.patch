From 9f4ba2070e2b991bab416ceaca84c852fdaec70d Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:27:46 +0000
Subject: [PATCH 08/11] minimal type body: more non-stored members moved into
 an extension of their type (batch 10; type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 Sources/Parsers/Parsers.Chain.Access.swift | 36 +++++++++++-----------
 1 file changed, 18 insertions(+), 18 deletions(-)

diff --git a/Sources/Parsers/Parsers.Chain.Access.swift b/Sources/Parsers/Parsers.Chain.Access.swift
index 22a988e..5ae746a 100644
--- a/Sources/Parsers/Parsers.Chain.Access.swift
+++ b/Sources/Parsers/Parsers.Chain.Access.swift
@@ -1,9 +1,7 @@
 public import Checkpoint
 
-
 extension Parsers.Chain {
     public struct Access<Operand: Parsing> {
-
         @usableFromInline
         let operand: Operand
 
@@ -11,23 +9,25 @@ extension Parsers.Chain {
         init(operand: Operand) {
             self.operand = operand
         }
+    }
+}
 
-        @inlinable
-        public func left<Op: Parsing>(
-            _ op: Op,
-            combine: @escaping (Operand.Output, Op.Output, Operand.Output) -> Operand.Output
-        ) -> Parsers.Chain.Left<Operand, Op>
-        where Op.Input == Operand.Input, Operand.Input: Copyable & Restorable, Operand.Input.Checkpoint: Equatable {
-            Parsers.Chain.Left(operand: operand, operator: op, combine: combine)
-        }
+extension Parsers.Chain.Access {
+    @inlinable
+    public func left<Op: Parsing>(
+        _ op: Op,
+        combine: @escaping (Operand.Output, Op.Output, Operand.Output) -> Operand.Output
+    ) -> Parsers.Chain.Left<Operand, Op>
+    where Op.Input == Operand.Input, Operand.Input: Copyable & Restorable, Operand.Input.Checkpoint: Equatable {
+        Parsers.Chain.Left(operand: operand, operator: op, combine: combine)
+    }
 
-        @inlinable
-        public func right<Op: Parsing>(
-            _ op: Op,
-            combine: @escaping (Operand.Output, Op.Output, Operand.Output) -> Operand.Output
-        ) -> Parsers.Chain.Right<Operand, Op>
-        where Op.Input == Operand.Input, Operand.Input: Copyable & Restorable, Operand.Input.Checkpoint: Equatable {
-            Parsers.Chain.Right(operand: operand, operator: op, combine: combine)
-        }
+    @inlinable
+    public func right<Op: Parsing>(
+        _ op: Op,
+        combine: @escaping (Operand.Output, Op.Output, Operand.Output) -> Operand.Output
+    ) -> Parsers.Chain.Right<Operand, Op>
+    where Op.Input == Operand.Input, Operand.Input: Copyable & Restorable, Operand.Input.Checkpoint: Equatable {
+        Parsers.Chain.Right(operand: operand, operator: op, combine: combine)
     }
 }
