From d7673b15fc906a701506979bb4be7e6ca23933a0 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:34:04 +0000
Subject: [PATCH 09/10] counter loop iteration: range loops without early exit
 written as forEach (type-check follows; Linux x86_64, Swift 6.4.2)
 (coenttb/work#242)

---
 Sources/Parsers/Parsers.Diagnostic.swift     | 8 ++++----
 Tests/Parsers Tests/Parser.Debug Tests.swift | 2 +-
 2 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/Sources/Parsers/Parsers.Diagnostic.swift b/Sources/Parsers/Parsers.Diagnostic.swift
index 3f44dad..a84c1b1 100644
--- a/Sources/Parsers/Parsers.Diagnostic.swift
+++ b/Sources/Parsers/Parsers.Diagnostic.swift
@@ -147,8 +147,8 @@ extension Parsers.Diagnostic {
         let startLine = max(1, lineInt - contextLines)
         let endLine = min(source.lineStarts.count, lineInt + contextLines)
 
-        for lineNum in startLine...endLine {
-            guard let lineContent = source.line(lineNum) else { continue }
+        (startLine...endLine).forEach { lineNum in
+            guard let lineContent = source.line(lineNum) else { return }
 
             let lineNumStr = padLeft(String(lineNum), toLength: 3)
 
@@ -218,8 +218,8 @@ extension Parsers.Diagnostic {
         let startLine = max(1, lineInt - 3)
         let endLine = min(source.lineStarts.count, lineInt + 3)
 
-        for lineNum in startLine...endLine {
-            guard let lineContent = source.line(lineNum) else { continue }
+        (startLine...endLine).forEach { lineNum in
+            guard let lineContent = source.line(lineNum) else { return }
 
             let marker = lineNum == lineInt ? ">>>" : "   "
             lines.append("\(marker) \(lineNum): \(lineContent)")
diff --git a/Tests/Parsers Tests/Parser.Debug Tests.swift b/Tests/Parsers Tests/Parser.Debug Tests.swift
index 37df6f6..2701a4e 100644
--- a/Tests/Parsers Tests/Parser.Debug Tests.swift	
+++ b/Tests/Parsers Tests/Parser.Debug Tests.swift	
@@ -59,7 +59,7 @@ extension `Parser.Debug Tests`.`Parsers.Debug.Profile.Stats`.`Edge Case` {
         let iterations = 20_000
 
         await withTaskGroup(of: Void.self) { group in
-            for i in 0..<iterations {
+            (0..<iterations).forEach { i in
                 group.addTask {
                     if i.isMultiple(of: 2) {
                         stats.recordSuccess(elapsed: .milliseconds(1))
