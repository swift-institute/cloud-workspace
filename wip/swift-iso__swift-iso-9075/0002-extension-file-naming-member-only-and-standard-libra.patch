From e7d1c93dc0c3b23aa3211ec2108af60bcf0a30b3 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 20:52:54 +0000
Subject: [PATCH 2/3] extension file naming: member-only and
 standard-library-conformance extension files merge into their type's own file
 (overnight/merge-extension-files.py); single type per file: additional types
 move to their own <Parent>.<Name>.swift inside the container's extension
 (overnight/split-types.py); parse-checked; builds pending (coenttb/work#242)

---
 .../ISO_9075.Dialect.swift                    |  9 --------
 .../ISO_9075.Rendering.swift                  | 11 ++++++++++
 .../ISO_9075.Value.Failure.swift              | 18 +++++++++++++++
 .../ISO_9075.Value.Kind.swift                 | 18 +++++++++++++++
 .../ISO 9075 Foundation/ISO_9075.Value.swift  | 22 -------------------
 5 files changed, 47 insertions(+), 31 deletions(-)
 create mode 100644 Sources/ISO 9075 Foundation/ISO_9075.Rendering.swift
 create mode 100644 Sources/ISO 9075 Foundation/ISO_9075.Value.Failure.swift
 create mode 100644 Sources/ISO 9075 Foundation/ISO_9075.Value.Kind.swift

diff --git a/Sources/ISO 9075 Foundation/ISO_9075.Dialect.swift b/Sources/ISO 9075 Foundation/ISO_9075.Dialect.swift
index b74062f..c5e83b0 100644
--- a/Sources/ISO 9075 Foundation/ISO_9075.Dialect.swift	
+++ b/Sources/ISO 9075 Foundation/ISO_9075.Dialect.swift	
@@ -14,15 +14,6 @@ extension ISO_9075 {
         var roundPrecisionClose: String { get }
     }
 
-    public struct Rendering: Hashable, Sendable {
-        public let sql: String
-        public let values: [Value]
-
-        public init(sql: String, values: [Value]) {
-            self.sql = sql
-            self.values = values
-        }
-    }
 }
 
 extension ISO_9075.Dialect {
diff --git a/Sources/ISO 9075 Foundation/ISO_9075.Rendering.swift b/Sources/ISO 9075 Foundation/ISO_9075.Rendering.swift
new file mode 100644
index 0000000..36b2798
--- /dev/null
+++ b/Sources/ISO 9075 Foundation/ISO_9075.Rendering.swift	
@@ -0,0 +1,11 @@
+extension ISO_9075 {
+    public struct Rendering: Hashable, Sendable {
+        public let sql: String
+        public let values: [Value]
+
+        public init(sql: String, values: [Value]) {
+            self.sql = sql
+            self.values = values
+        }
+    }
+}
diff --git a/Sources/ISO 9075 Foundation/ISO_9075.Value.Failure.swift b/Sources/ISO 9075 Foundation/ISO_9075.Value.Failure.swift
new file mode 100644
index 0000000..9395555
--- /dev/null
+++ b/Sources/ISO 9075 Foundation/ISO_9075.Value.Failure.swift	
@@ -0,0 +1,18 @@
+public import Byte
+public import RFC_4122
+public import Time
+
+
+extension ISO_9075.Value {
+    public struct Failure: Hashable, Sendable, Swift.Error {
+        public let description: String
+
+        public init(_ description: String) {
+            self.description = description
+        }
+
+        public init(_ error: some Swift.Error) {
+            self.description = String(describing: error)
+        }
+    }
+}
diff --git a/Sources/ISO 9075 Foundation/ISO_9075.Value.Kind.swift b/Sources/ISO 9075 Foundation/ISO_9075.Value.Kind.swift
new file mode 100644
index 0000000..b45073c
--- /dev/null
+++ b/Sources/ISO 9075 Foundation/ISO_9075.Value.Kind.swift	
@@ -0,0 +1,18 @@
+public import Byte
+public import RFC_4122
+public import Time
+
+
+extension ISO_9075.Value {
+    public enum Kind: Hashable, Sendable {
+        case bool
+        case int
+        case double
+        case text
+        case blob
+        case timestamp
+        case uuid
+        case decimal
+        case json
+    }
+}
diff --git a/Sources/ISO 9075 Foundation/ISO_9075.Value.swift b/Sources/ISO 9075 Foundation/ISO_9075.Value.swift
index 0c9f8b1..1b51771 100644
--- a/Sources/ISO 9075 Foundation/ISO_9075.Value.swift	
+++ b/Sources/ISO 9075 Foundation/ISO_9075.Value.swift	
@@ -20,31 +20,9 @@ extension ISO_9075 {
 }
 
 extension ISO_9075.Value {
-    public enum Kind: Hashable, Sendable {
-        case bool
-        case int
-        case double
-        case text
-        case blob
-        case timestamp
-        case uuid
-        case decimal
-        case json
-    }
 }
 
 extension ISO_9075.Value {
-    public struct Failure: Hashable, Sendable, Swift.Error {
-        public let description: String
-
-        public init(_ description: String) {
-            self.description = description
-        }
-
-        public init(_ error: some Swift.Error) {
-            self.description = String(describing: error)
-        }
-    }
 }
 
 extension ISO_9075.Value {
