-    }
+        @Test
+        func `the absolute allowance is inclusive`() throws {
+            let tolerance = try Tolerance<Double>(absolute: 0.5)
+            #expect(tolerance.contains(1, 1.5))
+            #expect(!tolerance.contains(1, 1.5.nextUp))
+        }
 
-    @Test
