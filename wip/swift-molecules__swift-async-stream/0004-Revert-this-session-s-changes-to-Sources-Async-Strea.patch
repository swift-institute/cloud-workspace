@@ -0,0 +1,21 @@
+public import Async
+public import Clock_Concurrency
+
+extension Async.Stream {
+
+    public func debounce(
+        _ duration: Duration,
+        clock: some Clock.Nonsending<Duration> = Swift::ContinuousClock()
+    ) -> Self {
+        Self { [self] in
+            let state = Async.Stream<Element>.Debounce.State(
+                stream: self,
+                duration: duration,
+                clock: Clock.`Any`(clock)
+            )
+            return Iterator {
+                await state.next()
+            }
+        }
+    }
+}
