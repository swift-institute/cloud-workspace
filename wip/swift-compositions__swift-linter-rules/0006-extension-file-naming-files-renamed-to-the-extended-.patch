 rename Sources/Linter Rules/{Lint.Rule.Bundle+Universal.swift => Lint.Rule.Bundle.swift} (100%)

diff --git a/Sources/Linter Rule Package/Lint.Rule+ConflictingDependencyURL.swift b/Sources/Linter Rule Package/Lint.Rule.swift
similarity index 100%
rename from Sources/Linter Rule Package/Lint.Rule+ConflictingDependencyURL.swift
