From a60af7bdf3b0115d228f24ab1b3b807340cdbc20 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:32:51 +0000
Subject: [PATCH 5/6] compound type name, compound identifier: single-file
 internal types made fileprivate, package members used only in their target
 made internal (type-check follows; Linux x86_64, Swift 6.4.2)
 (coenttb/work#242)

---
 .../Lint.Rule+ConflictingDependencyURL.swift                  | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/Sources/Linter Rule Package/Lint.Rule+ConflictingDependencyURL.swift b/Sources/Linter Rule Package/Lint.Rule+ConflictingDependencyURL.swift
index 86c13be..a87f3ae 100644
--- a/Sources/Linter Rule Package/Lint.Rule+ConflictingDependencyURL.swift	
+++ b/Sources/Linter Rule Package/Lint.Rule+ConflictingDependencyURL.swift	
@@ -64,7 +64,7 @@ package func packageConflictingDependencyURLCanonical(_ url: Swift::String) -> S
 }
 
 /// SwiftPM's identity for a location: its last path component, canonicalised.
-package func packageConflictingDependencyURLIdentity(_ url: Swift::String) -> Swift::String {
+func packageConflictingDependencyURLIdentity(_ url: Swift::String) -> Swift::String {
     let canonical = packageConflictingDependencyURLCanonical(url)
     return canonical.split(separator: "/").last.map(Swift::String.init) ?? canonical
 }
@@ -121,7 +121,7 @@ package func packageConflictingDependencyURLPins(
     return pins
 }
 
-package func packageConflictingDependencyURLFindings(
+func packageConflictingDependencyURLFindings(
     source: borrowing Lint.Source.Parsed,
     severity: Diagnostic.Severity
 ) -> [Diagnostic.Record] {
