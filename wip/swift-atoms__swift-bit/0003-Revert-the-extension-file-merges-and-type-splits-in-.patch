From b66953c126bf150cdb002400575af9a4c10222b3 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 21:45:59 +0000
Subject: [PATCH 3/3] Revert the extension-file merges and type splits in
 directories where a merged file brought its conditional imports mid-file
 (coenttb/work#242)

---
 Sources/Bit/Algebra/Bit+Z2.swift         | 28 ++++++++++++++++++++
 Sources/Bit/Bit+Swift.CaseIterable.swift |  3 +++
 Sources/Bit/Bit.swift                    | 33 ------------------------
 3 files changed, 31 insertions(+), 33 deletions(-)
 create mode 100644 Sources/Bit/Algebra/Bit+Z2.swift
 create mode 100644 Sources/Bit/Bit+Swift.CaseIterable.swift

diff --git a/Sources/Bit/Algebra/Bit+Z2.swift b/Sources/Bit/Algebra/Bit+Z2.swift
new file mode 100644
index 0000000..dbf7d7c
--- /dev/null
+++ b/Sources/Bit/Algebra/Bit+Z2.swift
@@ -0,0 +1,28 @@
+#if Algebra
+    public import Algebra
+    extension Bit {
+
+        @inlinable
+        public static var z2: Algebra.Field<Self> {
+            .init(
+                additive: .init(
+                    group: .init(
+                        identity: .zero,
+                        combining: { ($0 == $1 ? .zero : .one) },
+                        inverting: { $0 }
+                    )
+                ),
+                multiplicative: .init(
+                    monoid: .init(
+                        identity: .one,
+                        combining: { ($0 == .one && $1 == .one ? .one : .zero) }
+                    )
+                ),
+                reciprocal: { (element: Self) throws(Algebra.Field<Self>.Error) -> Self in
+                    guard element == .one else { throw .nonInvertible }
+                    return element
+                }
+            )
+        }
+    }
+#endif
diff --git a/Sources/Bit/Bit+Swift.CaseIterable.swift b/Sources/Bit/Bit+Swift.CaseIterable.swift
new file mode 100644
index 0000000..9e105f6
--- /dev/null
+++ b/Sources/Bit/Bit+Swift.CaseIterable.swift
@@ -0,0 +1,3 @@
+extension Bit: Swift::CaseIterable {
+    public static var allCases: [Bit] { [.zero, .one] }
+}
diff --git a/Sources/Bit/Bit.swift b/Sources/Bit/Bit.swift
index 972f6b7..c72e2d5 100644
--- a/Sources/Bit/Bit.swift
+++ b/Sources/Bit/Bit.swift
@@ -9,36 +9,3 @@ public enum Bit: Swift::Sendable {
 extension Bit: Swift::Equatable {}
 
 extension Bit: Swift::Hashable {}
-
-#if Algebra
-    public import Algebra
-    extension Bit {
-
-        @inlinable
-        public static var z2: Algebra.Field<Self> {
-            .init(
-                additive: .init(
-                    group: .init(
-                        identity: .zero,
