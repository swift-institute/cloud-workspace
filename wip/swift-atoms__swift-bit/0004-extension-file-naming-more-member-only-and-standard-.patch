From 0a2f35a193e8a9d3c8067b00304da5dc9ab00c6a Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 01:37:25 +0000
Subject: [PATCH 4/5] extension file naming: more member-only and
 standard-library extension files merge into their type's file; single type
 per file: more additional types move to their own files
 (merge-extension-files.py, split-types.py); parse-checked; root build pending
 (coenttb/work#242)

---
 Sources/Bit/Algebra/Bit+Z2.swift         | 28 --------------------
 Sources/Bit/Bit+Swift.CaseIterable.swift |  3 ---
 Sources/Bit/Bit.swift                    | 33 ++++++++++++++++++++++++
 3 files changed, 33 insertions(+), 31 deletions(-)
 delete mode 100644 Sources/Bit/Algebra/Bit+Z2.swift
 delete mode 100644 Sources/Bit/Bit+Swift.CaseIterable.swift

diff --git a/Sources/Bit/Algebra/Bit+Z2.swift b/Sources/Bit/Algebra/Bit+Z2.swift
deleted file mode 100644
index dbf7d7c..0000000
--- a/Sources/Bit/Algebra/Bit+Z2.swift
+++ /dev/null
@@ -1,28 +0,0 @@
-#if Algebra
-    public import Algebra
-    extension Bit {
-
-        @inlinable
-        public static var z2: Algebra.Field<Self> {
-            .init(
-                additive: .init(
-                    group: .init(
-                        identity: .zero,
-                        combining: { ($0 == $1 ? .zero : .one) },
-                        inverting: { $0 }
-                    )
-                ),
-                multiplicative: .init(
-                    monoid: .init(
-                        identity: .one,
-                        combining: { ($0 == .one && $1 == .one ? .one : .zero) }
-                    )
-                ),
-                reciprocal: { (element: Self) throws(Algebra.Field<Self>.Error) -> Self in
-                    guard element == .one else { throw .nonInvertible }
-                    return element
-                }
-            )
-        }
-    }
-#endif
diff --git a/Sources/Bit/Bit+Swift.CaseIterable.swift b/Sources/Bit/Bit+Swift.CaseIterable.swift
deleted file mode 100644
index 9e105f6..0000000
--- a/Sources/Bit/Bit+Swift.CaseIterable.swift
+++ /dev/null
@@ -1,3 +0,0 @@
-extension Bit: Swift::CaseIterable {
-    public static var allCases: [Bit] { [.zero, .one] }
-}
diff --git a/Sources/Bit/Bit.swift b/Sources/Bit/Bit.swift
index c72e2d5..972f6b7 100644
--- a/Sources/Bit/Bit.swift
+++ b/Sources/Bit/Bit.swift
@@ -9,3 +9,36 @@ public enum Bit: Swift::Sendable {
 extension Bit: Swift::Equatable {}
 
 extension Bit: Swift::Hashable {}
+
+#if Algebra
+    public import Algebra
+    extension Bit {
+
+        @inlinable
+        public static var z2: Algebra.Field<Self> {
+            .init(
+                additive: .init(
+                    group: .init(
+                        identity: .zero,
+                        combining: { ($0 == $1 ? .zero : .one) },
+                        inverting: { $0 }
+                    )
+                ),
+                multiplicative: .init(
+                    monoid: .init(
+                        identity: .one,
+                        combining: { ($0 == .one && $1 == .one ? .one : .zero) }
+                    )
+                ),
+                reciprocal: { (element: Self) throws(Algebra.Field<Self>.Error) -> Self in
+                    guard element == .one else { throw .nonInvertible }
+                    return element
+                }
+            )
+        }
+    }
+#endif
+
+extension Bit: Swift::CaseIterable {
+    public static var allCases: [Bit] { [.zero, .one] }
+}
