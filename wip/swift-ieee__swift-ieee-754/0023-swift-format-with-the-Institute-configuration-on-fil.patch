 this session changed (coenttb/work#242)

---
 .../IEEE 754/IEEE_754.Classification.swift    | 38 ++++++++++---------
 1 file changed, 20 insertions(+), 18 deletions(-)

diff --git a/Sources/IEEE 754/IEEE_754.Classification.swift b/Sources/IEEE 754/IEEE_754.Classification.swift
index c1cd00b..125960d 100644
--- a/Sources/IEEE 754/IEEE_754.Classification.swift	
+++ b/Sources/IEEE 754/IEEE_754.Classification.swift	
@@ -127,15 +127,16 @@ extension IEEE_754.Classification {
         }
 
         let kind: NumberClass.Finite
-        kind = if value.isInfinite {
-            .infinity
-        } else if value.isZero {
-            .zero
-        } else if value.isSubnormal {
-            .subnormal
-        } else {
-            .normal
-        }
+        kind =
+            if value.isInfinite {
+                .infinity
+            } else if value.isZero {
+                .zero
+            } else if value.isSubnormal {
+                .subnormal
+            } else {
+                .normal
+            }
 
         return value.sign == .minus ? .negative(kind) : .positive(kind)
     }
@@ -147,15 +148,16 @@ extension IEEE_754.Classification {
         }
 
         let kind: NumberClass.Finite
-        kind = if value.isInfinite {
-            .infinity
-        } else if value.isZero {
-            .zero
-        } else if value.isSubnormal {
-            .subnormal
-        } else {
-            .normal
-        }
+        kind =
+            if value.isInfinite {
+                .infinity
+            } else if value.isZero {
+                .zero
+            } else if value.isSubnormal {
+                .subnormal
+            } else {
+                .normal
+            }
 
         return value.sign == .minus ? .negative(kind) : .positive(kind)
     }
