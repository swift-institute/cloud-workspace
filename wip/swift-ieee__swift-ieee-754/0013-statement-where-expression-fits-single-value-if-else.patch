From 33ae59b403ff7a7746394739ae9d9ba4a3966fa5 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:35:29 +0000
Subject: [PATCH 13/23] statement where expression fits: single-value if/else
 chains written as if expressions (type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 .../IEEE 754/IEEE_754.Classification.swift    | 20 ++++++------
 Sources/IEEE 754/IEEE_754.MinMax.swift        | 32 +++++++++----------
 2 files changed, 26 insertions(+), 26 deletions(-)

diff --git a/Sources/IEEE 754/IEEE_754.Classification.swift b/Sources/IEEE 754/IEEE_754.Classification.swift
index 49228b7..c1cd00b 100644
--- a/Sources/IEEE 754/IEEE_754.Classification.swift	
+++ b/Sources/IEEE 754/IEEE_754.Classification.swift	
@@ -127,14 +127,14 @@ extension IEEE_754.Classification {
         }
 
         let kind: NumberClass.Finite
-        if value.isInfinite {
-            kind = .infinity
+        kind = if value.isInfinite {
+            .infinity
         } else if value.isZero {
-            kind = .zero
+            .zero
         } else if value.isSubnormal {
-            kind = .subnormal
+            .subnormal
         } else {
-            kind = .normal
+            .normal
         }
 
         return value.sign == .minus ? .negative(kind) : .positive(kind)
@@ -147,14 +147,14 @@ extension IEEE_754.Classification {
         }
 
         let kind: NumberClass.Finite
-        if value.isInfinite {
-            kind = .infinity
+        kind = if value.isInfinite {
+            .infinity
         } else if value.isZero {
-            kind = .zero
+            .zero
         } else if value.isSubnormal {
-            kind = .subnormal
+            .subnormal
         } else {
-            kind = .normal
+            .normal
         }
 
         return value.sign == .minus ? .negative(kind) : .positive(kind)
diff --git a/Sources/IEEE 754/IEEE_754.MinMax.swift b/Sources/IEEE 754/IEEE_754.MinMax.swift
index a518c7b..5a4479d 100644
--- a/Sources/IEEE 754/IEEE_754.MinMax.swift	
+++ b/Sources/IEEE 754/IEEE_754.MinMax.swift	
@@ -163,13 +163,13 @@ extension IEEE_754.MinMax {
         let xMag = Swift::abs(x)
         let yMag = Swift::abs(y)
 
-        if xMag < yMag {
-            return x
+        return if xMag < yMag {
+            x
         } else if yMag < xMag {
-            return y
+            y
         } else {
 
-            return minimum(x, y)
+            minimum(x, y)
         }
     }
 
@@ -183,13 +183,13 @@ extension IEEE_754.MinMax {
         let xMag = Swift::abs(x)
         let yMag = Swift::abs(y)
 
-        if xMag > yMag {
-            return x
+        return if xMag > yMag {
+            x
         } else if yMag > xMag {
-            return y
+            y
         } else {
 
-            return maximum(x, y)
+            maximum(x, y)
         }
     }
 
@@ -291,12 +291,12 @@ extension IEEE_754.MinMax {
         }
         let xMag = Swift::abs(x)
         let yMag = Swift::abs(y)
-        if xMag < yMag {
-            return x
+        return if xMag < yMag {
+            x
         } else if yMag < xMag {
-            return y
+            y
         } else {
-            return minimum(x, y)
+            minimum(x, y)
         }
     }
 
@@ -307,12 +307,12 @@ extension IEEE_754.MinMax {
         }
         let xMag = Swift::abs(x)
         let yMag = Swift::abs(y)
-        if xMag > yMag {
-            return x
+        return if xMag > yMag {
+            x
         } else if yMag > xMag {
-            return y
+            y
         } else {
-            return maximum(x, y)
+            maximum(x, y)
         }
     }
 
