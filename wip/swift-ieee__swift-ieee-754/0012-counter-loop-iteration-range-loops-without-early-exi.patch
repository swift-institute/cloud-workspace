From 4a10abf9f8e2edcdac8ca93b2d97e91a84b40af2 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:34:01 +0000
Subject: [PATCH 12/13] counter loop iteration: range loops without early exit
 written as forEach (type-check follows; Linux x86_64, Swift 6.4.2)
 (coenttb/work#242)

---
 Tests/IEEE 754 Tests/Stress Tests.swift | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/Tests/IEEE 754 Tests/Stress Tests.swift b/Tests/IEEE 754 Tests/Stress Tests.swift
index d4b7c4d..a657170 100644
--- a/Tests/IEEE 754 Tests/Stress Tests.swift	
+++ b/Tests/IEEE 754 Tests/Stress Tests.swift	
@@ -249,7 +249,7 @@ extension `Performance Tests` {
         @Test
         func `all 256 byte values in each Double position`() {
             (0..<8).forEach { position in
-                for byteValue in UInt8.min...UInt8.max {
+                (UInt8.min...UInt8.max).forEach { byteValue in
                     var bytes: [UInt8] = [0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00]
                     bytes[position] = byteValue
                     _ = Double(bytes: bytes)
@@ -260,7 +260,7 @@ extension `Performance Tests` {
         @Test
         func `all 256 byte values in each Float position`() {
             (0..<4).forEach { position in
-                for byteValue in UInt8.min...UInt8.max {
+                (UInt8.min...UInt8.max).forEach { byteValue in
                     var bytes: [UInt8] = [0x00, 0x00, 0x00, 0x00]
                     bytes[position] = byteValue
                     _ = Float(bytes: bytes)
-- 
