Subject: [PATCH 5/9] module selector spelling: Module.Name written
 Module::Name (type-check follows; Linux x86_64, Swift 6.4.2)
 (coenttb/work#242)

---
 Sources/Email Received/Email.Received.Decoding.swift | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/Sources/Email Received/Email.Received.Decoding.swift b/Sources/Email Received/Email.Received.Decoding.swift
index 791143d..5ebcee7 100644
--- a/Sources/Email Received/Email.Received.Decoding.swift	
+++ b/Sources/Email Received/Email.Received.Decoding.swift	
@@ -19,15 +19,15 @@
     extension Email.Received.Decoding {
 
         static func text(_ octets: [Byte], charset: String?) -> String {
-            switch charset.flatMap(WHATWG_Encoding.Encoding.init(label:)) {
+            switch charset.flatMap(WHATWG_Encoding::Encoding.init(label:)) {
             case let encoding?: encoding.decode(octets)
             case nil: raw(octets)
             }
         }
 
         static func raw(_ octets: [Byte]) -> String {
-            let utf8 = WHATWG_Encoding.Encoding.utf8.decode(octets)
-            return utf8.unicodeScalars.contains("\u{FFFD}") ? WHATWG_Encoding.Encoding.windows1252.decode(octets) : utf8
+            let utf8 = WHATWG_Encoding::Encoding.utf8.decode(octets)
+            return utf8.unicodeScalars.contains("\u{FFFD}") ? WHATWG_Encoding::Encoding.windows1252.decode(octets) : utf8
         }
 
         static func header(_ value: [Byte]) -> String {
