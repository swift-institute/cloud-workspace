From 3024a814f80bb157ce933405b789bc7a478b200b Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:24:53 +0000
Subject: [PATCH 8/9] trait consistency: dependencies imported only under a
 trait get that trait's condition (runner repair; Linux x86_64, Swift 6.4.2)
 (coenttb/work#242)

---
 Package.swift | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Package.swift b/Package.swift
index 3b21933..8ab7e97 100644
--- a/Package.swift
+++ b/Package.swift
@@ -94,7 +94,7 @@ let package = Package(
             name: "Email Received",
             dependencies: [
                 .product(name: "RFC 5322", package: "swift-rfc-5322"),
-                .product(name: "Email Standard", package: "swift-email-standard"),
+                .product(name: "Email Standard", package: "swift-email-standard", condition: .when(traits: ["EmailReceived"])),
                 .product(
                     name: "ASCII",
                     package: "swift-ascii",
