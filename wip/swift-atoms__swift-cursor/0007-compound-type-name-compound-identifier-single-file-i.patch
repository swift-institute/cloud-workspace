From 1c371563c8ecb4e405d906c01035068aecf3b200 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:32:46 +0000
Subject: [PATCH 7/8] compound type name, compound identifier: single-file
 internal types made fileprivate, package members used only in their target
 made internal (type-check follows; Linux x86_64, Swift 6.4.2)
 (coenttb/work#242)

---
 Tests/Cursor Tests/Fixtures/Support.swift | 2 +-
 Tests/Cursor Tests/Ownership Tests.swift  | 4 ++--
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/Tests/Cursor Tests/Fixtures/Support.swift b/Tests/Cursor Tests/Fixtures/Support.swift
index 4aef386..fec7cb4 100644
--- a/Tests/Cursor Tests/Fixtures/Support.swift	
+++ b/Tests/Cursor Tests/Fixtures/Support.swift	
@@ -1,6 +1,6 @@
 import Cursor
 
-struct OwnedValue: ~Copyable {
+fileprivate struct OwnedValue: ~Copyable {
     let value: Int
 }
 
diff --git a/Tests/Cursor Tests/Ownership Tests.swift b/Tests/Cursor Tests/Ownership Tests.swift
index ba4a901..4db7598 100644
--- a/Tests/Cursor Tests/Ownership Tests.swift	
+++ b/Tests/Cursor Tests/Ownership Tests.swift	
@@ -23,7 +23,7 @@ extension `Cursor Tests` {
             deinit { counts.destroy() }
         }
 
-        enum ReadError: Swift::Error, Equatable {
+        fileprivate enum ReadError: Swift::Error, Equatable {
             case rejected(Int)
         }
 
@@ -67,7 +67,7 @@ extension `Cursor Tests` {
             let value: Int
         }
 
-        struct PlainCursor: Cursor.`Protocol` {
+        fileprivate struct PlainCursor: Cursor.`Protocol` {
             typealias Element = Plain
             typealias Failure = Never
 
-- 
