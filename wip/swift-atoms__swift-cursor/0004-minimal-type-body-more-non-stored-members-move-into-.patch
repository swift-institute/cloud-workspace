From fc05b45a8639f7b30d218cb811f95aa10d4fb471 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 23:28:20 +0000
Subject: [PATCH 04/10] minimal type body: more non-stored members move into
 extensions of their type (overnight/minimal-bodies.py); type-checked, failing
 files left out (coenttb/work#242)

---
 Sources/Cursor/Collection/Cursor.Collection.swift | 11 ++++++++---
 1 file changed, 8 insertions(+), 3 deletions(-)

diff --git a/Sources/Cursor/Collection/Cursor.Collection.swift b/Sources/Cursor/Collection/Cursor.Collection.swift
index 66e9af7..2c39cb1 100644
--- a/Sources/Cursor/Collection/Cursor.Collection.swift
+++ b/Sources/Cursor/Collection/Cursor.Collection.swift
@@ -11,9 +11,6 @@
         }
 
         public struct Collection<Base: Swift::Collection>: Cursor.`Protocol` {
-            public typealias Element = Base.Element
-            public typealias Failure = Never
-            public typealias Checkpoint = Base.Index
             private let base: Base
             private var position: Base.Index
 
@@ -24,6 +21,14 @@
         }
     }
 
+extension Cursor.Collection {
+        public typealias Element = Base.Element
+
+        public typealias Failure = Never
+
+        public typealias Checkpoint = Base.Index
+}
+
     extension Cursor.Collection {
         public var checkpoint: Checkpoint { position }
         public var count: Int { base.distance(from: position, to: base.endIndex) }
-- 
