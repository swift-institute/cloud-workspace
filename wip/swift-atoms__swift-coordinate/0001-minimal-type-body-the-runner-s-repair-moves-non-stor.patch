From 015221d3079d3176d3c8f97b9ac23b4e564b4f87 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 18:24:13 +0000
Subject: [PATCH 1/4] minimal type body: the runner's repair moves non-stored
 members out of type bodies into extensions; repair applied; root and test
 builds not yet run (coenttb/work#242)

---
 Sources/Coordinate/Coordinate.swift | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/Sources/Coordinate/Coordinate.swift b/Sources/Coordinate/Coordinate.swift
index 796d35b..11d306f 100644
--- a/Sources/Coordinate/Coordinate.swift
+++ b/Sources/Coordinate/Coordinate.swift
@@ -4,7 +4,6 @@ public struct Coordinate<let N: Int, Scalar> {
     public let components: Vector<N, Scalar>
 
     public init(components: Vector<N, Scalar>) { self.components = components }
-    public subscript(index: Int) -> Scalar { components[index] }
 }
 
 extension Coordinate: Equatable where Scalar: Equatable {}
@@ -19,3 +18,7 @@ extension Coordinate where N == 1 {
 extension Coordinate: Comparable where N == 1, Scalar: Comparable {
     public static func < (lhs: Self, rhs: Self) -> Bool { lhs[0] < rhs[0] }
 }
+
+extension Coordinate {
+    public subscript(index: Int) -> Scalar { components[index] }
+}
