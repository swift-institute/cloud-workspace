From a53d5c06c79b15362b576cdad1d189521ec1b2b6 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 20:52:42 +0000
Subject: [PATCH 3/5] extension file naming: member-only and
 standard-library-conformance extension files merge into their type's own file
 (overnight/merge-extension-files.py); single type per file: additional types
 move to their own <Parent>.<Name>.swift inside the container's extension
 (overnight/split-types.py); parse-checked; builds pending (coenttb/work#242)

---
 Sources/Coordinate/Coordinate+Components.swift | 12 ------------
 Sources/Coordinate/Coordinate.swift            | 11 +++++++++++
 2 files changed, 11 insertions(+), 12 deletions(-)
 delete mode 100644 Sources/Coordinate/Coordinate+Components.swift

diff --git a/Sources/Coordinate/Coordinate+Components.swift b/Sources/Coordinate/Coordinate+Components.swift
deleted file mode 100644
index b5095b3..0000000
--- a/Sources/Coordinate/Coordinate+Components.swift
+++ /dev/null
@@ -1,12 +0,0 @@
-import Vector
-
-extension Coordinate {
-
-    public init(_ components: consuming InlineArray<N, Scalar>) {
-        self.init(components: Vector(components))
-    }
-
-    public init(repeating value: Scalar) {
-        self.init(components: Vector(repeating: value))
-    }
-}
diff --git a/Sources/Coordinate/Coordinate.swift b/Sources/Coordinate/Coordinate.swift
index 11d306f..570a274 100644
--- a/Sources/Coordinate/Coordinate.swift
+++ b/Sources/Coordinate/Coordinate.swift
@@ -22,3 +22,14 @@ extension Coordinate: Comparable where N == 1, Scalar: Comparable {
 extension Coordinate {
     public subscript(index: Int) -> Scalar { components[index] }
 }
+
+extension Coordinate {
+
+    public init(_ components: consuming InlineArray<N, Scalar>) {
+        self.init(components: Vector(components))
+    }
+
+    public init(repeating value: Scalar) {
+        self.init(components: Vector(repeating: value))
+    }
+}
