Date: Sun, 8 Nov 2026 03:06:18 +0000
Subject: [PATCH 10/11] single type per file: additional types moved to their
 own files (type-check follows; Linux x86_64, Swift 6.4.2) (coenttb/work#242)

---
 Sources/RFC 2183/RFC_2183.Token.Failure.swift | 13 +++++++++++++
 Sources/RFC 2183/RFC_2183.Token.swift         |  6 ------
 2 files changed, 13 insertions(+), 6 deletions(-)
 create mode 100644 Sources/RFC 2183/RFC_2183.Token.Failure.swift

diff --git a/Sources/RFC 2183/RFC_2183.Token.Failure.swift b/Sources/RFC 2183/RFC_2183.Token.Failure.swift
new file mode 100644
index 0000000..c21974c
--- /dev/null
+++ b/Sources/RFC 2183/RFC_2183.Token.Failure.swift	
@@ -0,0 +1,13 @@
+import ASCII
+import Byte
+
+
+extension RFC_2183.Token {
+    enum Failure {
+        case empty
+
+        case notASCII
+
+        case invalidCharacter(ASCII.Code)
+    }
+}
diff --git a/Sources/RFC 2183/RFC_2183.Token.swift b/Sources/RFC 2183/RFC_2183.Token.swift
index 939c3de..f71f413 100644
--- a/Sources/RFC 2183/RFC_2183.Token.swift	
+++ b/Sources/RFC 2183/RFC_2183.Token.swift	
@@ -7,13 +7,7 @@ extension RFC_2183 {
 }
 
 extension RFC_2183.Token {
-    enum Failure {
-        case empty
 
-        case notASCII
-
-        case invalidCharacter(ASCII.Code)
-    }
 
     static func validate<Bytes: Swift::Collection>(_ bytes: Bytes) -> Failure?
     where Bytes.Element == Byte {
