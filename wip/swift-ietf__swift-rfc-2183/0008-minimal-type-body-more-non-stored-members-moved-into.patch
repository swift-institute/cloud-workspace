From 8117be82f43d76b30512c425064c8fce1151ba3d Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:27:43 +0000
Subject: [PATCH 08/10] minimal type body: more non-stored members moved into
 an extension of their type (batch 10; type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 Sources/RFC 2183/RFC_2183.Token.swift | 80 +++++++++++++--------------
 1 file changed, 39 insertions(+), 41 deletions(-)

diff --git a/Sources/RFC 2183/RFC_2183.Token.swift b/Sources/RFC 2183/RFC_2183.Token.swift
index 91a771a..939c3de 100644
--- a/Sources/RFC 2183/RFC_2183.Token.swift	
+++ b/Sources/RFC 2183/RFC_2183.Token.swift	
@@ -2,58 +2,56 @@ import ASCII
 import Byte
 
 extension RFC_2183 {
-
     enum Token {
+    }
+}
 
-        enum Failure {
+extension RFC_2183.Token {
+    enum Failure {
+        case empty
 
-            case empty
+        case notASCII
 
-            case notASCII
+        case invalidCharacter(ASCII.Code)
+    }
 
-            case invalidCharacter(ASCII.Code)
+    static func validate<Bytes: Swift::Collection>(_ bytes: Bytes) -> Failure?
+    where Bytes.Element == Byte {
+        guard !bytes.isEmpty else {
+            return .empty
         }
 
-        static func validate<Bytes: Swift::Collection>(_ bytes: Bytes) -> Failure?
-        where Bytes.Element == Byte {
-
-            guard !bytes.isEmpty else {
-                return .empty
+        for byte in bytes {
+            let code: ASCII.Code
+            do throws(ASCII.Code.Error) {
+                code = try ASCII.Code(byte)
+            } catch {
+                return .notASCII
             }
 
-            for byte in bytes {
-
-                let code: ASCII.Code
-                do throws(ASCII.Code.Error) {
-                    code = try ASCII.Code(byte)
-                } catch {
-                    return .notASCII
-                }
-
-                guard code.isVisible, !specials.contains(code) else {
-                    return .invalidCharacter(code)
-                }
+            guard code.isVisible, !specials.contains(code) else {
+                return .invalidCharacter(code)
             }
-
-            return nil
         }
 
-        static let specials: [ASCII.Code] = [
-            .leftParenthesis,
-            .rightParenthesis,
-            .lessThanSign,
-            .greaterThanSign,
-            .atSign,
-            .comma,
-            .semicolon,
-            .colon,
-            .backslash,
-            .quotationMark,
-            .solidus,
-            .leftSquareBracket,
-            .rightSquareBracket,
-            .questionMark,
-            .equalsSign,
-        ]
+        return nil
     }
+
+    static let specials: [ASCII.Code] = [
+        .leftParenthesis,
+        .rightParenthesis,
+        .lessThanSign,
+        .greaterThanSign,
+        .atSign,
+        .comma,
+        .semicolon,
+        .colon,
+        .backslash,
+        .quotationMark,
+        .solidus,
+        .leftSquareBracket,
+        .rightSquareBracket,
+        .questionMark,
+        .equalsSign,
+    ]
 }
