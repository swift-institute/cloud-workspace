From b4706a77b83482f026a193daf701d2b8adf63539 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 23:31:25 +0000
Subject: [PATCH 6/9] Revert the minimal-body moves in files where they raised
 a rule over its ratchet limit (coenttb/work#242)

---
 Sources/RFC 2183/RFC_2183.Token.swift | 80 ++++++++++++++-------------
 1 file changed, 41 insertions(+), 39 deletions(-)

diff --git a/Sources/RFC 2183/RFC_2183.Token.swift b/Sources/RFC 2183/RFC_2183.Token.swift
index 939c3de..91a771a 100644
--- a/Sources/RFC 2183/RFC_2183.Token.swift	
+++ b/Sources/RFC 2183/RFC_2183.Token.swift	
@@ -2,56 +2,58 @@ import ASCII
 import Byte
 
 extension RFC_2183 {
+
     enum Token {
-    }
-}
 
-extension RFC_2183.Token {
-    enum Failure {
-        case empty
+        enum Failure {
 
-        case notASCII
+            case empty
 
-        case invalidCharacter(ASCII.Code)
-    }
+            case notASCII
 
-    static func validate<Bytes: Swift::Collection>(_ bytes: Bytes) -> Failure?
-    where Bytes.Element == Byte {
-        guard !bytes.isEmpty else {
-            return .empty
+            case invalidCharacter(ASCII.Code)
         }
 
-        for byte in bytes {
-            let code: ASCII.Code
-            do throws(ASCII.Code.Error) {
-                code = try ASCII.Code(byte)
-            } catch {
-                return .notASCII
+        static func validate<Bytes: Swift::Collection>(_ bytes: Bytes) -> Failure?
+        where Bytes.Element == Byte {
+
+            guard !bytes.isEmpty else {
+                return .empty
             }
 
-            guard code.isVisible, !specials.contains(code) else {
-                return .invalidCharacter(code)
+            for byte in bytes {
+
+                let code: ASCII.Code
+                do throws(ASCII.Code.Error) {
+                    code = try ASCII.Code(byte)
+                } catch {
+                    return .notASCII
+                }
+
+                guard code.isVisible, !specials.contains(code) else {
+                    return .invalidCharacter(code)
+                }
             }
+
+            return nil
         }
 
-        return nil
+        static let specials: [ASCII.Code] = [
+            .leftParenthesis,
+            .rightParenthesis,
+            .lessThanSign,
+            .greaterThanSign,
+            .atSign,
+            .comma,
+            .semicolon,
+            .colon,
+            .backslash,
+            .quotationMark,
+            .solidus,
+            .leftSquareBracket,
+            .rightSquareBracket,
+            .questionMark,
+            .equalsSign,
+        ]
     }
-
-    static let specials: [ASCII.Code] = [
-        .leftParenthesis,
-        .rightParenthesis,
-        .lessThanSign,
-        .greaterThanSign,
-        .atSign,
-        .comma,
-        .semicolon,
-        .colon,
-        .backslash,
-        .quotationMark,
-        .solidus,
-        .leftSquareBracket,
-        .rightSquareBracket,
-        .questionMark,
-        .equalsSign,
-    ]
 }
