From 73d2df6330e398fb128c617aad1557a1ddc3b10a Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 20:52:47 +0000
Subject: [PATCH 2/2] extension file naming: member-only and
 standard-library-conformance extension files merge into their type's own file
 (overnight/merge-extension-files.py); single type per file: additional types
 move to their own <Parent>.<Name>.swift inside the container's extension
 (overnight/split-types.py); parse-checked; builds pending (coenttb/work#242)

---
 Sources/Search/Search+Traversal.swift | 15 ---------------
 Sources/Search/Search.swift           | 16 ++++++++++++++++
 2 files changed, 16 insertions(+), 15 deletions(-)
 delete mode 100644 Sources/Search/Search+Traversal.swift

diff --git a/Sources/Search/Search+Traversal.swift b/Sources/Search/Search+Traversal.swift
deleted file mode 100644
index 1339faa..0000000
--- a/Sources/Search/Search+Traversal.swift
+++ /dev/null
@@ -1,15 +0,0 @@
-extension Search {
-
-    public func first<Position>(
-        from start: Position,
-        advance: (Position) -> Position?,
-        matching: (Pattern, Position) -> Position?
-    ) throws(Search<Pattern>.Error) -> Match<Position> {
-        var position = start
-        while true {
-            if let end = matching(pattern, position) { return Match(start: position, end: end) }
-            guard let next = advance(position) else { throw .notFound }
-            position = next
-        }
-    }
-}
diff --git a/Sources/Search/Search.swift b/Sources/Search/Search.swift
index f79a857..a74dc1b 100644
--- a/Sources/Search/Search.swift
+++ b/Sources/Search/Search.swift
@@ -2,3 +2,19 @@ public struct Search<Pattern> {
     public let pattern: Pattern
     public init(_ pattern: Pattern) { self.pattern = pattern }
 }
+
+extension Search {
+
+    public func first<Position>(
+        from start: Position,
+        advance: (Position) -> Position?,
+        matching: (Pattern, Position) -> Position?
+    ) throws(Search<Pattern>.Error) -> Match<Position> {
+        var position = start
+        while true {
+            if let end = matching(pattern, position) { return Match(start: position, end: end) }
+            guard let next = advance(position) else { throw .notFound }
+            position = next
+        }
+    }
+}
