From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:25:28 +0000
Subject: [PATCH 3/3] test function naming: CamelCase test functions renamed to
 backticked sentences (tests only; type-checked, not run; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 Tests/Search Tests/Search Tests.swift | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/Tests/Search Tests/Search Tests.swift b/Tests/Search Tests/Search Tests.swift
index eeb0cd2..db84979 100644
--- a/Tests/Search Tests/Search Tests.swift	
+++ b/Tests/Search Tests/Search Tests.swift	
@@ -1,7 +1,7 @@
 import Search
 import Testing
 
-@Test func scalarSearchReturnsBothBoundaries() throws {
+@Test func `scalar search returns both boundaries`() throws {
     let result = try Search(42).first(
         from: 0,
         advance: { $0 < 3 ? $0 + 1 : nil },
@@ -12,11 +12,11 @@ import Testing
     #expect(result.start == 2)
     #expect(result.end == 5)
 }
-@Test func emptySearchCanMatchTerminalPosition() throws {
+@Test func `empty search can match terminal position`() throws {
     let result = try Search(()).first(from: 0, advance: { _ in nil }, matching: { _, p in p })
     #expect(result.start == result.end)
 }
-@Test func missingSearchFails() {
+@Test func `missing search fails`() {
     #expect(throws: Search<Int>.Error.notFound) {
         _ = try Search(42).first(from: 0, advance: { _ in nil }, matching: { _, _ in nil })
     }
