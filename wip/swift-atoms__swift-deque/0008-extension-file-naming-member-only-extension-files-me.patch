From aad918c25e4495ad9fe6c82c2fde31dd74b30bfe Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:46:09 +0000
Subject: [PATCH 8/8] extension file naming: member-only extension files merged
 into the extended type's own file (type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 .../Queue.DoubleEnded+Equatable.swift           | 17 -----------------
 .../Queue DoubleEnded/__QueueDoubleEnded.swift  | 16 ++++++++++++++++
 2 files changed, 16 insertions(+), 17 deletions(-)
 delete mode 100644 Sources/Queue DoubleEnded/Queue.DoubleEnded+Equatable.swift

diff --git a/Sources/Queue DoubleEnded/Queue.DoubleEnded+Equatable.swift b/Sources/Queue DoubleEnded/Queue.DoubleEnded+Equatable.swift
deleted file mode 100644
index 4805457..0000000
--- a/Sources/Queue DoubleEnded/Queue.DoubleEnded+Equatable.swift	
+++ /dev/null
@@ -1,17 +0,0 @@
-public import Queue_DoubleEnded_Primitive
-
-extension __QueueDoubleEnded: Equatable where S: Equatable {
-
-    @inlinable
-    public static func == (lhs: Self, rhs: Self) -> Bool {
-        lhs.store == rhs.store
-    }
-}
-
-extension __QueueDoubleEnded: Hashable where S: Hashable {
-
-    @inlinable
-    public func hash(into hasher: inout Hasher) {
-        store.hash(into: &hasher)
-    }
-}
diff --git a/Sources/Queue DoubleEnded/__QueueDoubleEnded.swift b/Sources/Queue DoubleEnded/__QueueDoubleEnded.swift
index 7fe0e6c..519e459 100644
--- a/Sources/Queue DoubleEnded/__QueueDoubleEnded.swift	
+++ b/Sources/Queue DoubleEnded/__QueueDoubleEnded.swift	
@@ -169,3 +169,19 @@ extension __QueueDoubleEnded where S: ~Copyable {
         Self(store: store.clone())
     }
 }
+
+extension __QueueDoubleEnded: Equatable where S: Equatable {
+
+    @inlinable
+    public static func == (lhs: Self, rhs: Self) -> Bool {
+        lhs.store == rhs.store
+    }
+}
+
+extension __QueueDoubleEnded: Hashable where S: Hashable {
+
+    @inlinable
+    public func hash(into hasher: inout Hasher) {
+        store.hash(into: &hasher)
+    }
+}
-- 
