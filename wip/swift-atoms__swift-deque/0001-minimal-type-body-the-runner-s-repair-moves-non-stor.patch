From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 18:24:13 +0000
Subject: [PATCH] minimal type body: the runner's repair moves non-stored
 members out of type bodies into extensions; repair applied; root and test
 builds not yet run (coenttb/work#242)

---
 .../Queue.DoubleEnded.swift                         | 13 ++++++++-----
 1 file changed, 8 insertions(+), 5 deletions(-)

diff --git a/Sources/Queue DoubleEnded Primitive/Queue.DoubleEnded.swift b/Sources/Queue DoubleEnded Primitive/Queue.DoubleEnded.swift
index 3d994a6..9586b00 100644
--- a/Sources/Queue DoubleEnded Primitive/Queue.DoubleEnded.swift	
+++ b/Sources/Queue DoubleEnded Primitive/Queue.DoubleEnded.swift	
@@ -16,11 +16,6 @@ public struct __QueueDoubleEnded<S: ~Copyable>: ~Copyable {
     @usableFromInline
     package var store: S
 
-    public enum Position: Sendable, Equatable {
-        case front
-        case back
-    }
-
     @inlinable
     public init(store: consuming S) {
         self.store = store
@@ -119,3 +114,11 @@ extension __QueueDoubleEnded where S: ~Copyable {
         )
     }
 }
+
+extension __QueueDoubleEnded where S: ~Copyable {
+
+    public enum Position: Sendable, Equatable {
+        case front
+        case back
+    }
+}
