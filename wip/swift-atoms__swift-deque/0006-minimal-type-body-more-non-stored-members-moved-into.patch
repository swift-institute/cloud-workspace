From e310fb703760d44187e494daebd0fc84166564c2 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:27:40 +0000
Subject: [PATCH 6/8] minimal type body: more non-stored members moved into an
 extension of their type (batch 10; type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 .../Queue.DoubleEnded.swift                        | 14 ++++++--------
 1 file changed, 6 insertions(+), 8 deletions(-)

diff --git a/Sources/Queue DoubleEnded Primitive/Queue.DoubleEnded.swift b/Sources/Queue DoubleEnded Primitive/Queue.DoubleEnded.swift
index 3d994a6..f774073 100644
--- a/Sources/Queue DoubleEnded Primitive/Queue.DoubleEnded.swift	
+++ b/Sources/Queue DoubleEnded Primitive/Queue.DoubleEnded.swift	
@@ -12,15 +12,9 @@ public import Store
 @_documentation(visibility: public)
 @frozen
 public struct __QueueDoubleEnded<S: ~Copyable>: ~Copyable {
-
     @usableFromInline
     package var store: S
 
-    public enum Position: Sendable, Equatable {
-        case front
-        case back
-    }
-
     @inlinable
     public init(store: consuming S) {
         self.store = store
@@ -39,12 +33,10 @@ extension __QueueDoubleEnded: Copyable where S: Copyable {}
 extension __QueueDoubleEnded: Sendable where S: Sendable & ~Copyable {}
 
 extension __QueueDoubleEnded where S: Store.`Protocol` & ~Copyable {
-
     public typealias Index = Index::Index<S.Element>
 }
 
 extension __QueueDoubleEnded where S: ~Copyable {
-
     @inlinable
     public init<E: ~Copyable, Resource: Memory.Growable & ~Copyable>(
         minimumCapacity: Index::Index<E>.Count = .zero
@@ -119,3 +111,9 @@ extension __QueueDoubleEnded where S: ~Copyable {
         )
     }
 }
+
+extension __QueueDoubleEnded where S: ~Copyable {
+    public enum Position: Sendable, Equatable {
+        case front
+        case back
+    }}
