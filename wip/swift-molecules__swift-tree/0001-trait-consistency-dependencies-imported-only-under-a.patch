From 6bd9d89ec29af4ae255252beb73b4c665eb374ec Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:24:51 +0000
Subject: [PATCH 1/4] trait consistency: dependencies imported only under a
 trait get that trait's condition (runner repair; Linux x86_64, Swift 6.4.2)
 (coenttb/work#242)

---
 Package.swift | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Package.swift b/Package.swift
index 8683ce2..1ae8a91 100644
--- a/Package.swift
+++ b/Package.swift
@@ -98,7 +98,7 @@ let package = Package(
                 .product(name: "Memory Allocator", package: "swift-memory-allocation"),
                 .product(name: "Memory", package: "swift-memory"),
                 .product(name: "Ownership Shared Primitive", package: "swift-ownership-shared"),
-                .product(name: "Tagged", package: "swift-tagged"),
+                .product(name: "Tagged", package: "swift-tagged", condition: .when(traits: ["Property"])),
             ]
         ),
     ],
