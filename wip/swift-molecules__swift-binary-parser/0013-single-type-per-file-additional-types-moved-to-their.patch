From 5d66214f5fe880267ad217e94025d0853709ec8c Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:06:17 +0000
Subject: [PATCH 13/19] single type per file: additional types moved to their
 own files (type-check follows; Linux x86_64, Swift 6.4.2) (coenttb/work#242)

---
 .../Binary Parse/Binary.Parse.Converting.Error.swift  | 11 +++++++++++
 Sources/Binary Parse/Binary.Parse.Converting.swift    |  7 -------
 .../Binary Parse/Binary.Parse.Validated.Error.swift   | 11 +++++++++++
 Sources/Binary Parse/Binary.Parse.Validated.swift     |  7 -------
 4 files changed, 22 insertions(+), 14 deletions(-)
 create mode 100644 Sources/Binary Parse/Binary.Parse.Converting.Error.swift
 create mode 100644 Sources/Binary Parse/Binary.Parse.Validated.Error.swift

diff --git a/Sources/Binary Parse/Binary.Parse.Converting.Error.swift b/Sources/Binary Parse/Binary.Parse.Converting.Error.swift
new file mode 100644
index 0000000..7810898
--- /dev/null
+++ b/Sources/Binary Parse/Binary.Parse.Converting.Error.swift	
@@ -0,0 +1,11 @@
+public import Binary
+
+
+extension Binary.Parse.Converting {
+    public enum Error: Swift::Error {
+
+        case endOfInput(expected: String)
+
+        case overflow(source: Source)
+    }
+}
diff --git a/Sources/Binary Parse/Binary.Parse.Converting.swift b/Sources/Binary Parse/Binary.Parse.Converting.swift
index e95e660..cc74040 100644
--- a/Sources/Binary Parse/Binary.Parse.Converting.swift	
+++ b/Sources/Binary Parse/Binary.Parse.Converting.swift	
@@ -15,13 +15,6 @@ extension Binary.Parse {
 }
 
 extension Binary.Parse.Converting {
-
-    public enum Error: Swift::Error {
-
-        case endOfInput(expected: String)
-
-        case overflow(source: Source)
-    }
 }
 
 extension Binary.Parse.Converting.Error: Sendable where Source: Sendable {}
diff --git a/Sources/Binary Parse/Binary.Parse.Validated.Error.swift b/Sources/Binary Parse/Binary.Parse.Validated.Error.swift
new file mode 100644
index 0000000..09c7985
--- /dev/null
+++ b/Sources/Binary Parse/Binary.Parse.Validated.Error.swift	
@@ -0,0 +1,11 @@
+public import Binary
+
+
+extension Binary.Parse.Validated {
+    public enum Error: Swift::Error {
+
+        case endOfInput(expected: String)
+
+        case invalid(rawValue: T.RawValue)
+    }
+}
diff --git a/Sources/Binary Parse/Binary.Parse.Validated.swift b/Sources/Binary Parse/Binary.Parse.Validated.swift
index 4323ab7..0859a68 100644
--- a/Sources/Binary Parse/Binary.Parse.Validated.swift	
+++ b/Sources/Binary Parse/Binary.Parse.Validated.swift	
@@ -15,13 +15,6 @@ extension Binary.Parse {
 }
 
 extension Binary.Parse.Validated {
-
-    public enum Error: Swift::Error {
-
-        case endOfInput(expected: String)
-
-        case invalid(rawValue: T.RawValue)
-    }
 }
 
 extension Binary.Parse.Validated.Error: Sendable where T.RawValue: Sendable {}
-- 
