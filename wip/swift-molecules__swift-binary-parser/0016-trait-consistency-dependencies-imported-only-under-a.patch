From 6b24ee5bd4335a01af2df2ac0f88965230927054 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:24:51 +0000
Subject: [PATCH 16/16] trait consistency: dependencies imported only under a
 trait get that trait's condition (runner repair; Linux x86_64, Swift 6.4.2)
 (coenttb/work#242)

---
 Package.swift | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/Package.swift b/Package.swift
index 850441d..6727fcd 100644
--- a/Package.swift
+++ b/Package.swift
@@ -116,10 +116,10 @@ let package = Package(
         .target(
             name: "ASCII Decimal Machine",
             dependencies: [
-                .product(name: "Binary", package: "swift-binary"),
+                .product(name: "Binary", package: "swift-binary", condition: .when(traits: ["ASCIIDecimalMachine"])),
                 .target(name: "Binary Machine"),
                 .product(name: "ASCII", package: "swift-ascii", condition: .when(traits: ["ASCIIDecimalMachine"])),
-                .product(name: "Byte", package: "swift-byte"),
+                .product(name: "Byte", package: "swift-byte", condition: .when(traits: ["ASCIIDecimalMachine"])),
             ]
         ),
         .testTarget(
-- 
2.43.0

