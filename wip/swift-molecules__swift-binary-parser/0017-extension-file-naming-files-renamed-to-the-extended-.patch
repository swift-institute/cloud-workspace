From 366c643b4a36289043440e35bcefa3e5c33a6a6b Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:43:43 +0000
Subject: [PATCH 17/19] extension file naming: files renamed to the extended
 type's own name or the 'T where <clause>' shape (renames only; Linux x86_64,
 Swift 6.4.2) (coenttb/work#242)

---
 ...swift => InlineArray where Element is FixedWidthInteger.swift} | 0
 ...=> RawRepresentable where RawValue is FixedWidthInteger.swift} | 0
 ...is RawRepresentable, Self.RawValue is FixedWidthInteger.swift} | 0
 3 files changed, 0 insertions(+), 0 deletions(-)
 rename Sources/Binary Integer/{InlineArray+Binary.swift => InlineArray where Element is FixedWidthInteger.swift} (100%)
 rename Sources/Binary Machine/{RawRepresentable+parser.swift => RawRepresentable where RawValue is FixedWidthInteger.swift} (100%)
 rename Sources/Binary Parseable/{Binary.Parseable+FixedWidthIntegerRaw.swift => Binary.Parseable where Self is RawRepresentable, Self.RawValue is FixedWidthInteger.swift} (100%)

diff --git a/Sources/Binary Integer/InlineArray+Binary.swift b/Sources/Binary Integer/InlineArray where Element is FixedWidthInteger.swift
similarity index 100%
rename from Sources/Binary Integer/InlineArray+Binary.swift
rename to Sources/Binary Integer/InlineArray where Element is FixedWidthInteger.swift
diff --git a/Sources/Binary Machine/RawRepresentable+parser.swift b/Sources/Binary Machine/RawRepresentable where RawValue is FixedWidthInteger.swift
similarity index 100%
rename from Sources/Binary Machine/RawRepresentable+parser.swift
rename to Sources/Binary Machine/RawRepresentable where RawValue is FixedWidthInteger.swift
diff --git a/Sources/Binary Parseable/Binary.Parseable+FixedWidthIntegerRaw.swift b/Sources/Binary Parseable/Binary.Parseable where Self is RawRepresentable, Self.RawValue is FixedWidthInteger.swift
similarity index 100%
rename from Sources/Binary Parseable/Binary.Parseable+FixedWidthIntegerRaw.swift
rename to Sources/Binary Parseable/Binary.Parseable where Self is RawRepresentable, Self.RawValue is FixedWidthInteger.swift
