From ec6e8be836cf37bd983c757bf6c7957b3ee63fbc Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 20:52:52 +0000
Subject: [PATCH 2/3] extension file naming: member-only and
 standard-library-conformance extension files merge into their type's own file
 (overnight/merge-extension-files.py); single type per file: additional types
 move to their own <Parent>.<Name>.swift inside the container's extension
 (overnight/split-types.py); parse-checked; builds pending (coenttb/work#242)

---
 Sources/ECMA 48/ECMA_48.Screen+Erase.swift     |  8 --------
 Sources/ECMA 48/ECMA_48.Screen.EraseLine.swift | 10 ++++++++++
 2 files changed, 10 insertions(+), 8 deletions(-)
 create mode 100644 Sources/ECMA 48/ECMA_48.Screen.EraseLine.swift

diff --git a/Sources/ECMA 48/ECMA_48.Screen+Erase.swift b/Sources/ECMA 48/ECMA_48.Screen+Erase.swift
index c436cf0..8035d04 100644
--- a/Sources/ECMA 48/ECMA_48.Screen+Erase.swift	
+++ b/Sources/ECMA 48/ECMA_48.Screen+Erase.swift	
@@ -15,14 +15,6 @@ extension ECMA_48.Screen {
         "\(ECMA_48.csi)\(mode.rawValue)J"
     }
 
-    public enum EraseLine: Int, Sendable {
-
-        case toEnd = 0
-
-        case toBeginning = 1
-
-        case all = 2
-    }
 
     public static func eraseLine(_ mode: EraseLine = .all) -> String {
         "\(ECMA_48.csi)\(mode.rawValue)K"
diff --git a/Sources/ECMA 48/ECMA_48.Screen.EraseLine.swift b/Sources/ECMA 48/ECMA_48.Screen.EraseLine.swift
new file mode 100644
index 0000000..2e309ac
--- /dev/null
+++ b/Sources/ECMA 48/ECMA_48.Screen.EraseLine.swift	
@@ -0,0 +1,10 @@
+extension ECMA_48.Screen {
+    public enum EraseLine: Int, Sendable {
+
+        case toEnd = 0
+
+        case toBeginning = 1
+
+        case all = 2
+    }
+}
