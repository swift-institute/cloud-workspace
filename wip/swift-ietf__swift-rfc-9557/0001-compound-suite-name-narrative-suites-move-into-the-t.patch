From 84066d6e2953f29cf555c477337556937c6ee0f0 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 19:34:18 +0000
Subject: [PATCH 1/2] compound suite name: narrative suites move into the test
 module's namespace `<File> Tests` (#239's layout), nested suites into
 extension <Path>.<Parent> (overnight/compound-suites.py); parse-checked;
 builds pending (coenttb/work#242)

---
 .../RFC 9557 Tests/Time Zone Part Tests.swift | 34 +++++++++++--------
 1 file changed, 19 insertions(+), 15 deletions(-)

diff --git a/Tests/RFC 9557 Tests/Time Zone Part Tests.swift b/Tests/RFC 9557 Tests/Time Zone Part Tests.swift
index b7e5b83..87a28c7 100644
--- a/Tests/RFC 9557 Tests/Time Zone Part Tests.swift	
+++ b/Tests/RFC 9557 Tests/Time Zone Part Tests.swift	
@@ -2,24 +2,28 @@ import Testing
 
 @testable import RFC_9557
 
-@Suite
-struct `Time zone name parts` {
-    @Test(arguments: ["America//New_York", "/UTC", "UTC/", "/"])
-    func `an empty part is refused`(_ name: String) {
-        #expect(throws: RFC_9557.Validation.ValidationError.self) {
-            try RFC_9557.Validation.validateTimeZoneName(name)
+enum `Time Zone Part Tests` {}
+
+extension `Time Zone Part Tests` {
+    @Suite
+    struct `Time zone name parts` {
+        @Test(arguments: ["America//New_York", "/UTC", "UTC/", "/"])
+        func `an empty part is refused`(_ name: String) {
+            #expect(throws: RFC_9557.Validation.ValidationError.self) {
+                try RFC_9557.Validation.validateTimeZoneName(name)
+            }
         }
-    }
 
-    @Test(arguments: ["1Europe", "Etc/-5", "Etc/+5", "America/9abc"])
-    func `a part must start with a letter, a dot or an underscore`(_ name: String) {
-        #expect(throws: RFC_9557.Validation.ValidationError.self) {
-            try RFC_9557.Validation.validateTimeZoneName(name)
+        @Test(arguments: ["1Europe", "Etc/-5", "Etc/+5", "America/9abc"])
+        func `a part must start with a letter, a dot or an underscore`(_ name: String) {
+            #expect(throws: RFC_9557.Validation.ValidationError.self) {
+                try RFC_9557.Validation.validateTimeZoneName(name)
+            }
         }
-    }
 
-    @Test(arguments: ["_private", ".hidden/Zone", "Etc/GMT-14", "..."])
-    func `a part may start with a dot or an underscore and continue with any zone character`(_ name: String) throws {
-        try RFC_9557.Validation.validateTimeZoneName(name)
+        @Test(arguments: ["_private", ".hidden/Zone", "Etc/GMT-14", "..."])
+        func `a part may start with a dot or an underscore and continue with any zone character`(_ name: String) throws {
+            try RFC_9557.Validation.validateTimeZoneName(name)
+        }
     }
 }
