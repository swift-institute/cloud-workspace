From fb221177a0aa9b5a9ff75339ccdee2fbeceb5675 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:24:49 +0000
Subject: [PATCH] trait consistency: dependencies imported only under a trait
 get that trait's condition (runner repair; Linux x86_64, Swift 6.4.2)
 (coenttb/work#242)

---
 Package.swift | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Package.swift b/Package.swift
index 8ad5967..aa4ce05 100644
--- a/Package.swift
+++ b/Package.swift
@@ -171,7 +171,7 @@ let package = Package(
                 .target(name: "Executor"),
                 .target(name: "Executor Test Support"),
                 .target(name: "Executor Job Priority", condition: .when(traits: ["Clock"])),
-                .product(name: "Clock", package: "swift-clock"),
+                .product(name: "Clock", package: "swift-clock", condition: .when(traits: ["Clock"])),
             ]
         ),
     ],
