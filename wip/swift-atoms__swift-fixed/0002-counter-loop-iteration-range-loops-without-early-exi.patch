From 50e7e8ae9c622472b837887fb0423c8cb9e7dc3e Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:33:59 +0000
Subject: [PATCH 2/3] counter loop iteration: range loops without early exit
 written as forEach (type-check follows; Linux x86_64, Swift 6.4.2)
 (coenttb/work#242)

---
 Sources/Fixed/Fixed+Columns.swift | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Sources/Fixed/Fixed+Columns.swift b/Sources/Fixed/Fixed+Columns.swift
index dfdcdf9..5a2bb19 100644
--- a/Sources/Fixed/Fixed+Columns.swift
+++ b/Sources/Fixed/Fixed+Columns.swift
@@ -40,7 +40,7 @@ extension __Fixed where S: ~Copyable {
             minimumCapacity: count,
             initializingCount: count,
             with: { ptr in
-                for i in 0..<Int(bitPattern: count) {
+                (0..<Int(bitPattern: count)).forEach { i in
                     let index = Index::Index<E>(Ordinal(UInt(i)))
                     ptr.append(initializer(index))
                 }
