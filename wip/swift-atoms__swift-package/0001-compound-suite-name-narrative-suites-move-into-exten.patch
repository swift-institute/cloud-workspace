From 5a1acf62e5add2040f235b69e23ea3be14579ee6 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 18:48:54 +0000
Subject: [PATCH] compound suite name: narrative suites move into extension
 <Type> named after their test file, nested suites into extension
 <Type>.<Parent> (overnight/compound-suites.py); parse-checked; builds pending
 (coenttb/work#242)

---
 Tests/Package Tests/Package.Name Tests.swift | 5 +++++
 Tests/Package Tests/Product.Name Tests.swift | 5 +++++
 Tests/Package Tests/Target.Name Tests.swift  | 5 +++++
 3 files changed, 15 insertions(+)

diff --git a/Tests/Package Tests/Package.Name Tests.swift b/Tests/Package Tests/Package.Name Tests.swift
index b99a148..b1b2b7b 100644
--- a/Tests/Package Tests/Package.Name Tests.swift	
+++ b/Tests/Package Tests/Package.Name Tests.swift	
@@ -3,8 +3,13 @@ import Testing
 
 @Suite
 struct `Package names preserve their declared values` {
+}
+
+extension `Package names preserve their declared values` {
     @Suite struct `Names retain their values` {}
+
     @Suite struct `Names accept permissive input` {}
+
     @Suite struct `Names preserve their domain` {}
 }
 
diff --git a/Tests/Package Tests/Product.Name Tests.swift b/Tests/Package Tests/Product.Name Tests.swift
index 08213d9..308a2e1 100644
--- a/Tests/Package Tests/Product.Name Tests.swift	
+++ b/Tests/Package Tests/Product.Name Tests.swift	
@@ -3,8 +3,13 @@ import Testing
 
 @Suite
 struct `Product names preserve their declared values` {
+}
+
+extension `Product names preserve their declared values` {
     @Suite struct `Names retain their values` {}
+
     @Suite struct `Names accept permissive input` {}
+
     @Suite struct `Names preserve their domain` {}
 }
 
diff --git a/Tests/Package Tests/Target.Name Tests.swift b/Tests/Package Tests/Target.Name Tests.swift
index e5aaaa1..45d8ac0 100644
--- a/Tests/Package Tests/Target.Name Tests.swift	
+++ b/Tests/Package Tests/Target.Name Tests.swift	
@@ -3,8 +3,13 @@ import Testing
 
 @Suite
 struct `Target names preserve their declared values` {
+}
+
+extension `Target names preserve their declared values` {
     @Suite struct `Names retain their values` {}
+
     @Suite struct `Names accept permissive input` {}
+
     @Suite struct `Names preserve their domain` {}
 }
 
