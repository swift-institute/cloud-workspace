deleted file mode 100644
index 0fdffd4..0000000
--- a/Sources/Package/Package.Name.swift
+++ /dev/null
@@ -1,4 +0,0 @@
-extension Package {
-
-    public typealias Name = Tagged<Package, Swift.String>
-}
