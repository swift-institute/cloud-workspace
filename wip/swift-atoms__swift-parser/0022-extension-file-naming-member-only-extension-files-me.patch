+        where
+            A.Input == Input,
+            N.Input == Input,
+            A.Input: ~Copyable & ~Escapable,
+            N.Input: ~Copyable & ~Escapable,
+            A.Output: ~Copyable & Escapable,
+            N.Output: ~Copyable & Escapable,
