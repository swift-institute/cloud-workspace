 (coenttb/work#242)

---
 .../Collection Parser Prefix/Parser.Prefix.Through.swift | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/Sources/Parser/Absorbed/swift-collection-parser/Collection Parser Prefix/Parser.Prefix.Through.swift b/Sources/Parser/Absorbed/swift-collection-parser/Collection Parser Prefix/Parser.Prefix.Through.swift
index 304a980..89b7bbe 100644
--- a/Sources/Parser/Absorbed/swift-collection-parser/Collection Parser Prefix/Parser.Prefix.Through.swift	
+++ b/Sources/Parser/Absorbed/swift-collection-parser/Collection Parser Prefix/Parser.Prefix.Through.swift	
@@ -3,8 +3,12 @@
     public import Collection
 
     extension Parser::Prefix {
+
         public struct Through<Input: Collection.Slice.`Protocol`>: Parsing
         where Input.Element: Equatable, Input.Element: Copyable {
+
+            public typealias Failure = Parser::Prefix.Through<Input>.Error
+
             @usableFromInline
             let delimiter: [Input.Element]
 
@@ -15,10 +19,6 @@
         }
     }
 
-extension Parser.Through {
-        public typealias Failure = Parser::Prefix.Through<Input>.Error
-}
-
     extension Parser::Prefix.Through {
         public typealias Output = Input
     }
@@ -52,6 +52,7 @@ extension Parser.Through {
 
     extension Parser::Prefix.Through
     where Input: Collection.Slice.`Protocol`, Input.Element: Equatable, Input.Element: Copyable {
+
         public enum Error: Swift::Error, Equatable {
             case predicateFailed(description: String)
         }
