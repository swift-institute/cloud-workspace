From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:29:35 +0000
Subject: [PATCH 10/24] Revert Sources/Parser/Swift/Swift.Array+Parser.swift:
 it broke the type-check (coenttb/work#242)

---
 Sources/Parser/Swift/Swift.Array+Parser.swift | 23 +++++++++----------
 1 file changed, 11 insertions(+), 12 deletions(-)

diff --git a/Sources/Parser/Swift/Swift.Array+Parser.swift b/Sources/Parser/Swift/Swift.Array+Parser.swift
index 3821a82..1bcebe3 100644
--- a/Sources/Parser/Swift/Swift.Array+Parser.swift
+++ b/Sources/Parser/Swift/Swift.Array+Parser.swift
@@ -1,27 +1,26 @@
 public import Parser_Core
 
 extension Swift.Array where Element: Equatable {
+
     public struct Parser<Input: Swift::Collection>: Parser::Parsing
     where Input.SubSequence == Input, Input.Element == Element {
+
+        public typealias Output = Void
+        public typealias Failure = Error
+
+        public typealias Error = Swift::Slice<Swift::Array<Element>>.Parser<Input>.Error
+
         public let wrapped: Swift::Array<Element>
 
         @inlinable
         public init(_ wrapped: Swift::Array<Element>) {
             self.wrapped = wrapped
         }
-    }
-}
 
-extension Swift.Array.Parser {
-    public typealias Output = Void
-
-    public typealias Failure = Error
-
-    public typealias Error = Swift::Slice<Swift::Array<Element>>.Parser<Input>.Error
-
-    @inlinable
-    public borrowing func parse(_ input: inout Input) throws(Error) {
-        try wrapped.parser(for: Input.self).parse(&input)
+        @inlinable
+        public borrowing func parse(_ input: inout Input) throws(Error) {
+            try wrapped.parser(for: Input.self).parse(&input)
+        }
     }
 }
 
