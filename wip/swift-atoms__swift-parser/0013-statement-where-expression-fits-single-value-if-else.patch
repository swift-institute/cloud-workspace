From df51773647c1ef53db12d5edef763762dd4b6400 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:35:29 +0000
Subject: [PATCH 13/24] statement where expression fits: single-value if/else
 chains written as if expressions (type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 Tests/Map Parser Tests/FlatMap.Parser Owner Tests.swift | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/Tests/Map Parser Tests/FlatMap.Parser Owner Tests.swift b/Tests/Map Parser Tests/FlatMap.Parser Owner Tests.swift
index 9e36da9..ad570d6 100644
--- a/Tests/Map Parser Tests/FlatMap.Parser Owner Tests.swift	
+++ b/Tests/Map Parser Tests/FlatMap.Parser Owner Tests.swift	
@@ -90,10 +90,10 @@ extension `FlatMap.Parser Owner Tests` {
                     Downstream(seed: Seed(number: number, lifetime: lifetime), fails: false, lifetime: lifetime)
                 }
                 let parser: FlatMap::FlatMap<Parser<Int, Int, Never>.Output, Downstream>.Parser<Parser<Int, Int, Never>>
-                if fluent {
-                    parser = upstream.flatMap(transform)
+                parser = if fluent {
+                    upstream.flatMap(transform)
                 } else {
-                    parser = FlatMap::FlatMap.Parser(upstream: upstream, transform: transform)
+                    FlatMap::FlatMap.Parser(upstream: upstream, transform: transform)
                 }
                 requireCopyable(parser)
                 let copied = parser
