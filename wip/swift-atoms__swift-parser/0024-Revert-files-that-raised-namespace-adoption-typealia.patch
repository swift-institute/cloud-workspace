Date: Sun, 8 Nov 2026 04:03:57 +0000
Subject: [PATCH 24/25] Revert files that raised `namespace adoption typealias`
 over its ratchet limit (coenttb/work#242)

---
 Sources/Parser/Predicate/Predicate.Parser.swift | 6 ++----
 1 file changed, 2 insertions(+), 4 deletions(-)

diff --git a/Sources/Parser/Predicate/Predicate.Parser.swift b/Sources/Parser/Predicate/Predicate.Parser.swift
index 5e65df6..d7c8285 100644
--- a/Sources/Parser/Predicate/Predicate.Parser.swift
+++ b/Sources/Parser/Predicate/Predicate.Parser.swift
@@ -3,17 +3,15 @@
     public import Predicate
 
     extension Predicate where T: Copyable & Escapable {
+
         public struct Parser<Input: Swift::Collection>: Parser::Parsing
         where Input.SubSequence == Input, Input.Element == T {
+            public typealias Error = Predicate<T>.Error
             public let wrapped: Predicate<T>
             public init(_ wrapped: Predicate<T>) { self.wrapped = wrapped }
         }
     }
 
-extension Predicate.Parser {
-        public typealias Error = Predicate<T>.Error
-}
-
     extension Predicate.Parser where T: Copyable & Escapable {
         public typealias Output = T
 
