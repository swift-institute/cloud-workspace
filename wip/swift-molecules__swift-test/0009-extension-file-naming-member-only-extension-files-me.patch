Date: Sun, 8 Nov 2026 03:46:12 +0000
Subject: [PATCH 09/13] extension file naming: member-only extension files
 merged into the extended type's own file (type-check follows; Linux x86_64,
 Swift 6.4.2) (coenttb/work#242)

---
 .../Test.Benchmark+Measure.swift              | 27 -------------------
 Sources/Test Benchmark/Test.Benchmark.swift   | 25 +++++++++++++++++
 2 files changed, 25 insertions(+), 27 deletions(-)
 delete mode 100644 Sources/Test Benchmark/Test.Benchmark+Measure.swift

diff --git a/Sources/Test Benchmark/Test.Benchmark+Measure.swift b/Sources/Test Benchmark/Test.Benchmark+Measure.swift
deleted file mode 100644
index 53684b3..0000000
--- a/Sources/Test Benchmark/Test.Benchmark+Measure.swift	
+++ /dev/null
@@ -1,27 +0,0 @@
-public import Benchmark
-public import Test
-
-extension Test.Benchmark {
-    public static func measure<WorkloadState: Sendable, WorkloadFailure: Swift.Error, ProbeState: Sendable, Observation: Sendable, ProbeFailure: Swift.Error>(
-        plan: Benchmark::Benchmark.Plan,
-        workload: Benchmark::Benchmark.Workload<WorkloadState, WorkloadFailure>,
-        probe: Benchmark::Benchmark.Probe<ProbeState, Observation, ProbeFailure>,
-        association: Association,
-        recorder: @Sendable (Test.Issue) -> Void
-    ) -> Benchmark::Benchmark.Receipt<Observation>? {
-        do throws(Benchmark::Benchmark.Execution.Failure<WorkloadFailure, ProbeFailure>) {
-            return try Benchmark::Benchmark.run(plan: plan, workload: workload, probe: probe)
-        } catch {
-            recorder(
-                Test.Issue(
-                    kind: .errorCaught(
-                        type: String(reflecting: type(of: error)),
-                        description: Test.Text("Benchmark failed: \(association.name): \(error)")
-                    ),
-                    sourceLocation: association.source
-                )
-            )
-            return nil
-        }
-    }
-}
diff --git a/Sources/Test Benchmark/Test.Benchmark.swift b/Sources/Test Benchmark/Test.Benchmark.swift
index 0b9099d..889e8e2 100644
--- a/Sources/Test Benchmark/Test.Benchmark.swift	
+++ b/Sources/Test Benchmark/Test.Benchmark.swift	
@@ -27,3 +27,28 @@ extension Test.Benchmark {
         }
     }
 }
+
+extension Test.Benchmark {
+    public static func measure<WorkloadState: Sendable, WorkloadFailure: Swift.Error, ProbeState: Sendable, Observation: Sendable, ProbeFailure: Swift.Error>(
+        plan: Benchmark::Benchmark.Plan,
+        workload: Benchmark::Benchmark.Workload<WorkloadState, WorkloadFailure>,
+        probe: Benchmark::Benchmark.Probe<ProbeState, Observation, ProbeFailure>,
+        association: Association,
+        recorder: @Sendable (Test.Issue) -> Void
+    ) -> Benchmark::Benchmark.Receipt<Observation>? {
+        do throws(Benchmark::Benchmark.Execution.Failure<WorkloadFailure, ProbeFailure>) {
+            return try Benchmark::Benchmark.run(plan: plan, workload: workload, probe: probe)
+        } catch {
+            recorder(
+                Test.Issue(
+                    kind: .errorCaught(
+                        type: String(reflecting: type(of: error)),
+                        description: Test.Text("Benchmark failed: \(association.name): \(error)")
+                    ),
+                    sourceLocation: association.source
+                )
+            )
+            return nil
+        }
+    }
+}
