From e5756edfac709e7871911c88be975f8a0cef4409 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:35:29 +0000
Subject: [PATCH 6/7] statement where expression fits: single-value if/else
 chains written as if expressions (type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 Sources/Test/Test.Benchmark.Trend.swift | 8 ++++----
 Sources/Test/Test.Trait.Kind.swift      | 8 ++++----
 2 files changed, 8 insertions(+), 8 deletions(-)

diff --git a/Sources/Test/Test.Benchmark.Trend.swift b/Sources/Test/Test.Benchmark.Trend.swift
index 65a97eb..0a67d6d 100644
--- a/Sources/Test/Test.Benchmark.Trend.swift
+++ b/Sources/Test/Test.Benchmark.Trend.swift
@@ -74,12 +74,12 @@ extension Test.Benchmark.Trend {
         }
 
         let interpretation: Interpretation
-        if z > 1.96 {
-            interpretation = .increasing
+        interpretation = if z > 1.96 {
+            .increasing
         } else if z < -1.96 {
-            interpretation = .decreasing
+            .decreasing
         } else {
-            interpretation = .none
+            .none
         }
 
         return Self(z: z, interpretation: interpretation)
diff --git a/Sources/Test/Test.Trait.Kind.swift b/Sources/Test/Test.Trait.Kind.swift
index 31300e9..15a94eb 100644
--- a/Sources/Test/Test.Trait.Kind.swift
+++ b/Sources/Test/Test.Trait.Kind.swift
@@ -29,12 +29,12 @@ extension Test.Trait.Kind: CustomStringConvertible {
             return ".tag(\"\(name)\")"
 
         case .enabled(let isEnabled, let comment):
-            if isEnabled {
-                return ".enabled"
+            return if isEnabled {
+                ".enabled"
             } else if let comment {
-                return ".disabled(\"\(comment.plainText)\")"
+                ".disabled(\"\(comment.plainText)\")"
             } else {
-                return ".disabled"
+                ".disabled"
             }
 
         case .bug(let id, let comment):
