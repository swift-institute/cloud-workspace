From 133018c55b4c82c1f17f7dfdce4e3088fa056691 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:34:01 +0000
Subject: [PATCH 5/6] counter loop iteration: range loops without early exit
 written as forEach (type-check follows; Linux x86_64, Swift 6.4.2)
 (coenttb/work#242)

---
 Sources/Test/Test.Benchmark.Complexity.swift | 4 ++--
 Sources/Test/Test.Benchmark.Trend.swift      | 2 +-
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/Sources/Test/Test.Benchmark.Complexity.swift b/Sources/Test/Test.Benchmark.Complexity.swift
index 43bb140..53f7828 100644
--- a/Sources/Test/Test.Benchmark.Complexity.swift
+++ b/Sources/Test/Test.Benchmark.Complexity.swift
@@ -82,8 +82,8 @@ extension Test.Benchmark.Complexity {
         candidates.sort { $0.regression.rSquared > $1.regression.rSquared }
 
         var growthRatios: [Double] = []
-        for i in 1..<valid.count {
-            guard valid[i - 1].seconds > 0 else { continue }
+        (1..<valid.count).forEach { i in
+            guard valid[i - 1].seconds > 0 else { return }
             growthRatios.append(valid[i].seconds / valid[i - 1].seconds)
         }
 
diff --git a/Sources/Test/Test.Benchmark.Trend.swift b/Sources/Test/Test.Benchmark.Trend.swift
index 970a96a..65a97eb 100644
--- a/Sources/Test/Test.Benchmark.Trend.swift
+++ b/Sources/Test/Test.Benchmark.Trend.swift
@@ -55,7 +55,7 @@ extension Test.Benchmark.Trend {
         var s: Int = 0
         (0..<(n - 1)).forEach { i in
             let xi = averaging.project(durations[i])
-            for j in (i + 1)..<n {
+            ((i + 1)..<n).forEach { j in
                 let xj = averaging.project(durations[j])
                 let diff = xj - xi
                 if diff > 0 { s += 1 } else if diff < 0 { s -= 1 }
-- 
