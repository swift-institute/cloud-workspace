From f8f54f0477240ad15517cdc0b0eb2a7a2553c474 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:34:00 +0000
Subject: [PATCH 2/2] counter loop iteration: range loops without early exit
 written as forEach (type-check follows; Linux x86_64, Swift 6.4.2)
 (coenttb/work#242)

---
 Tests/Async Broadcast Tests/Broadcast Tests.swift | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Tests/Async Broadcast Tests/Broadcast Tests.swift b/Tests/Async Broadcast Tests/Broadcast Tests.swift
index 47e83bd..a744749 100644
--- a/Tests/Async Broadcast Tests/Broadcast Tests.swift	
+++ b/Tests/Async Broadcast Tests/Broadcast Tests.swift	
@@ -71,7 +71,7 @@ extension `Async broadcast benchmarks preserve delivery` {
 
         try await withThrowingTaskGroup(of: Void.self) { group in
             group.addTask {
-                for i in 0..<`Async broadcast benchmarks preserve delivery`.iterations {
+                (0..<`Async broadcast benchmarks preserve delivery`.iterations).forEach { i in
                     broadcast.send(i)
                 }
                 broadcast.finish()
