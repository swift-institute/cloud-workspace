---
 Tests/HTML Tests/InlineSVG Tests.swift | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/Tests/HTML Tests/InlineSVG Tests.swift b/Tests/HTML Tests/InlineSVG Tests.swift
index 213a175..12a07de 100644
--- a/Tests/HTML Tests/InlineSVG Tests.swift	
+++ b/Tests/HTML Tests/InlineSVG Tests.swift	
@@ -10,10 +10,13 @@ enum `InlineSVG Tests` {}
 extension `InlineSVG Tests` {
     @Suite enum Test {
         @Suite struct Unit {}
-        @Suite struct EdgeCase {}
     }
 }
 
+extension `InlineSVG Tests`.Test {
+    @Suite struct EdgeCase {}
+}
+
 extension `InlineSVG Tests`.Test.Unit {
     @Test
     func `InlineSVG renders correctly in HTML`() throws {
