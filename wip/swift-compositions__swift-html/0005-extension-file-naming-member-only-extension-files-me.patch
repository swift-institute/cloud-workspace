From 7c171e6a136245f3796c418913437c46a5f355a6 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:46:13 +0000
Subject: [PATCH 5/5] extension file naming: member-only extension files merged
 into the extended type's own file (type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 Sources/HTML/HTML.View.if.swift | 31 -------------------------------
 Sources/HTML/HTML.View.swift    | 30 ++++++++++++++++++++++++++++++
 2 files changed, 30 insertions(+), 31 deletions(-)
 delete mode 100644 Sources/HTML/HTML.View.if.swift

diff --git a/Sources/HTML/HTML.View.if.swift b/Sources/HTML/HTML.View.if.swift
deleted file mode 100644
index 8c98df7..0000000
--- a/Sources/HTML/HTML.View.if.swift
+++ /dev/null
@@ -1,31 +0,0 @@
-import HTML_Rendering
-
-extension HTML.View {
-    @discardableResult
-    @HTML.Builder
-
-    public func `if`<T: HTML.View>(
-        _ condition: Bool,
-        @HTML.Builder then modification: (Self) -> T
-    ) -> some HTML.View {
-        if condition {
-            modification(self)
-        } else {
-            self
-        }
-    }
-}
-
-extension HTML.View {
-    @HTML.Builder
-    public func `if`<X>(
-        `let` value: X?,
-        @HTML.Builder _ then: (Self, X) -> some HTML.View
-    ) -> some HTML.View {
-        if let value {
-            then(self, value)
-        } else {
-            self
-        }
-    }
-}
diff --git a/Sources/HTML/HTML.View.swift b/Sources/HTML/HTML.View.swift
index 31732cf..779cccc 100644
--- a/Sources/HTML/HTML.View.swift
+++ b/Sources/HTML/HTML.View.swift
@@ -6,3 +6,33 @@ extension HTML.View {
         self.attribute("onclick", content)
     }
 }
+
+extension HTML.View {
+    @discardableResult
+    @HTML.Builder
+
+    public func `if`<T: HTML.View>(
+        _ condition: Bool,
+        @HTML.Builder then modification: (Self) -> T
+    ) -> some HTML.View {
+        if condition {
+            modification(self)
+        } else {
+            self
+        }
+    }
+}
+
+extension HTML.View {
+    @HTML.Builder
+    public func `if`<X>(
+        `let` value: X?,
+        @HTML.Builder _ then: (Self, X) -> some HTML.View
+    ) -> some HTML.View {
+        if let value {
+            then(self, value)
+        } else {
+            self
+        }
+    }
+}
-- 
