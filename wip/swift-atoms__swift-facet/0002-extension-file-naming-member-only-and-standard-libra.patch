From e11c69d91f3cc396847929299849d98575682a0a Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 20:52:43 +0000
Subject: [PATCH 2/3] extension file naming: member-only and
 standard-library-conformance extension files merge into their type's own file
 (overnight/merge-extension-files.py); single type per file: additional types
 move to their own <Parent>.<Name>.swift inside the container's extension
 (overnight/split-types.py); parse-checked; builds pending (coenttb/work#242)

---
 Sources/Facet/Facet+Swift.Comparable.swift | 1 -
 Sources/Facet/Facet+Swift.Equatable.swift  | 1 -
 Sources/Facet/Facet+Swift.Hashable.swift   | 1 -
 Sources/Facet/Facet.swift                  | 6 ++++++
 4 files changed, 6 insertions(+), 3 deletions(-)
 delete mode 100644 Sources/Facet/Facet+Swift.Comparable.swift
 delete mode 100644 Sources/Facet/Facet+Swift.Equatable.swift
 delete mode 100644 Sources/Facet/Facet+Swift.Hashable.swift

diff --git a/Sources/Facet/Facet+Swift.Comparable.swift b/Sources/Facet/Facet+Swift.Comparable.swift
deleted file mode 100644
index 4464f21..0000000
--- a/Sources/Facet/Facet+Swift.Comparable.swift
+++ /dev/null
@@ -1 +0,0 @@
-extension Facet: Swift::Comparable {}
diff --git a/Sources/Facet/Facet+Swift.Equatable.swift b/Sources/Facet/Facet+Swift.Equatable.swift
deleted file mode 100644
index f3aaedd..0000000
--- a/Sources/Facet/Facet+Swift.Equatable.swift
+++ /dev/null
@@ -1 +0,0 @@
-extension Facet: Swift::Equatable {}
diff --git a/Sources/Facet/Facet+Swift.Hashable.swift b/Sources/Facet/Facet+Swift.Hashable.swift
deleted file mode 100644
index 1d00600..0000000
--- a/Sources/Facet/Facet+Swift.Hashable.swift
+++ /dev/null
@@ -1 +0,0 @@
-extension Facet: Swift::Hashable {}
diff --git a/Sources/Facet/Facet.swift b/Sources/Facet/Facet.swift
index e99cdc7..759f24e 100644
--- a/Sources/Facet/Facet.swift
+++ b/Sources/Facet/Facet.swift
@@ -48,3 +48,9 @@ extension Facet {
 #if !hasFeature(Embedded)
     extension Facet: Swift::Codable {}
 #endif
+
+extension Facet: Swift::Comparable {}
+
+extension Facet: Swift::Equatable {}
+
+extension Facet: Swift::Hashable {}
