From a9ca5bce763d75b49b2f10f263180a3ea4a22e5f Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 18:48:52 +0000
Subject: [PATCH] compound suite name: narrative suites move into extension
 <Type> named after their test file, nested suites into extension
 <Type>.<Parent> (overnight/compound-suites.py); parse-checked; builds pending
 (coenttb/work#242)

---
 Tests/Facet Tests/Facet Tests.swift           | 20 +++++++++++++++++++
 .../Facet+Finite.Enumerable Tests.swift       | 10 ++++++++++
 2 files changed, 30 insertions(+)

diff --git a/Tests/Facet Tests/Facet Tests.swift b/Tests/Facet Tests/Facet Tests.swift
index 7c46420..530482c 100644
--- a/Tests/Facet Tests/Facet Tests.swift	
+++ b/Tests/Facet Tests/Facet Tests.swift	
@@ -4,8 +4,13 @@ import Testing
 
 @Suite
 struct `Facet construction preserves an axis and a direction` {
+}
+
+extension `Facet construction preserves an axis and a direction` {
     @Suite struct `Facets retain both supplied components` {}
+
     @Suite struct `No facet construction boundary cases are defined` {}
+
     @Suite struct `No facet construction integration cases are defined` {}
 }
 
@@ -20,8 +25,13 @@ extension `Facet construction preserves an axis and a direction`.`Facets retain
 
 @Suite
 struct `Facet opposition flips direction while preserving its axis` {
+}
+
+extension `Facet opposition flips direction while preserving its axis` {
     @Suite struct `Opposite facets retain their axis and reverse their direction` {}
+
     @Suite struct `Applying facet opposition twice restores the original facet` {}
+
     @Suite struct `No facet opposition integration cases are defined` {}
 }
 
@@ -45,8 +55,13 @@ extension `Facet opposition flips direction while preserving its axis`.`Applying
 
 @Suite
 struct `Facet equality and hashing distinguish axis direction pairs` {
+}
+
+extension `Facet equality and hashing distinguish axis direction pairs` {
     @Suite struct `Facet equality compares both axis and direction` {}
+
     @Suite struct `No facet equality and hashing boundary cases are defined` {}
+
     @Suite struct `Facet hashing retains all distinct two dimensional facets` {}
 }
 
@@ -84,8 +99,13 @@ extension `Facet equality and hashing distinguish axis direction pairs`.`Facet h
 
 @Suite
 struct `Facet ordering compares axes before directions` {
+}
+
+extension `Facet ordering compares axes before directions` {
     @Suite struct `Facet comparison orders axes first and positive before negative` {}
+
     @Suite struct `No facet ordering boundary cases are defined` {}
+
     @Suite struct `Facet sorting agrees with finite enumeration order` {}
 }
 
diff --git a/Tests/Facet Tests/Facet+Finite.Enumerable Tests.swift b/Tests/Facet Tests/Facet+Finite.Enumerable Tests.swift
index 6d827a7..93e4f1f 100644
--- a/Tests/Facet Tests/Facet+Finite.Enumerable Tests.swift	
+++ b/Tests/Facet Tests/Facet+Finite.Enumerable Tests.swift	
@@ -5,8 +5,13 @@ import Testing
 
 @Suite
 struct `Finite facets enumerate both directions for each axis` {
+}
+
+extension `Finite facets enumerate both directions for each axis` {
     @Suite struct `Facet counts and ordinals preserve axis major direction ordering` {}
+
     @Suite struct `No facet enumeration boundary cases are defined` {}
+
     @Suite struct `No facet enumeration integration cases are defined` {}
 }
 
@@ -32,8 +37,13 @@ extension `Finite facets enumerate both directions for each axis`.`Facet counts
 
 @Suite
 struct `Facet case collections enumerate axis direction pairs in ordinal order` {
+}
+
+extension `Facet case collections enumerate axis direction pairs in ordinal order` {
     @Suite struct `Facet case collections contain two directions per axis` {}
+
     @Suite struct `No facet case collection boundary cases are defined` {}
+
     @Suite struct `Facet enumeration round trips each ordinal` {}
 }
 
