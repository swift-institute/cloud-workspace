From 318a883833c0072ec8052a76fb0c6807eda26ab5 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:35:30 +0000
Subject: [PATCH 2/2] statement where expression fits: single-value if/else
 chains written as if expressions (type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 Sources/RFC 3492/Punycode.swift | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/Sources/RFC 3492/Punycode.swift b/Sources/RFC 3492/Punycode.swift
index 13a9e05..018f84b 100644
--- a/Sources/RFC 3492/Punycode.swift	
+++ b/Sources/RFC 3492/Punycode.swift	
@@ -169,12 +169,12 @@ extension Punycode {
 extension Punycode {
 
     private static func threshold(k: UInt32, bias: UInt32) -> UInt32 {
-        if k <= bias + tmin {
-            return tmin
+        return if k <= bias + tmin {
+            tmin
         } else if k >= bias + tmax {
-            return tmax
+            tmax
         } else {
-            return k - bias
+            k - bias
         }
     }
 
