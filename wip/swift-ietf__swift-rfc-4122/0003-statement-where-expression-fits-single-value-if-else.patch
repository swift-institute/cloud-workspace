From fd50ea4b2385ebafa98aec5d08befe8eac05bb10 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:35:30 +0000
Subject: [PATCH 3/3] statement where expression fits: single-value if/else
 chains written as if expressions (type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 .../RFC_4122.UUID Foundation Comparison Tests.swift       | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/Tests/RFC 4122 Tests/RFC_4122.UUID Foundation Comparison Tests.swift b/Tests/RFC 4122 Tests/RFC_4122.UUID Foundation Comparison Tests.swift
index 24eeaad..9c5bb4a 100644
--- a/Tests/RFC 4122 Tests/RFC_4122.UUID Foundation Comparison Tests.swift	
+++ b/Tests/RFC 4122 Tests/RFC_4122.UUID Foundation Comparison Tests.swift	
@@ -259,11 +259,11 @@ private func ratioString(_ a: Duration, _ b: Duration) -> String {
     let bNs = Double(b.components.attoseconds)
     guard bNs > 0 else { return "N/A" }
     let r = aNs / bNs
-    if r < 1 {
-        return (1 / r).formatted(.number.precision(2)) + "x faster"
+    return if r < 1 {
+        (1 / r).formatted(.number.precision(2)) + "x faster"
     } else if r > 1 {
-        return r.formatted(.number.precision(2)) + "x slower"
+        r.formatted(.number.precision(2)) + "x slower"
     } else {
-        return "equal"
+        "equal"
     }
 }
