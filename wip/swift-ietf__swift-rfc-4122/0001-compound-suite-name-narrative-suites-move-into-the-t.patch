From d527e86176831d7db1fc39fcc6437df5922df701 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 19:34:15 +0000
Subject: [PATCH] compound suite name: narrative suites move into the test
 module's namespace `<File> Tests` (#239's layout), nested suites into
 extension <Path>.<Parent> (overnight/compound-suites.py); parse-checked;
 builds pending (coenttb/work#242)

---
 ...FC_4122.UUID Invalid Character Tests.swift | 46 ++++++++++---------
 1 file changed, 25 insertions(+), 21 deletions(-)

diff --git a/Tests/RFC 4122 Tests/RFC_4122.UUID Invalid Character Tests.swift b/Tests/RFC 4122 Tests/RFC_4122.UUID Invalid Character Tests.swift
index 2f68940..5328f80 100644
--- a/Tests/RFC 4122 Tests/RFC_4122.UUID Invalid Character Tests.swift	
+++ b/Tests/RFC 4122 Tests/RFC_4122.UUID Invalid Character Tests.swift	
@@ -2,33 +2,37 @@ import Testing
 
 @testable import RFC_4122
 
-@Suite
-struct `UUID invalid character` {
-    @Test
-    func `an ASCII non-hex character is reported with its position`() {
-        #expect(throws: RFC_4122.UUID.Error.invalidCharacter("g", at: 5)) {
-            try RFC_4122.UUID("01234g6789abcdef0123456789abcdef")
+enum `RFC_4122.UUID Invalid Character Tests` {}
+
+extension `RFC_4122.UUID Invalid Character Tests` {
+    @Suite
+    struct `UUID invalid character` {
+        @Test
+        func `an ASCII non-hex character is reported with its position`() {
+            #expect(throws: RFC_4122.UUID.Error.invalidCharacter("g", at: 5)) {
+                try RFC_4122.UUID("01234g6789abcdef0123456789abcdef")
+            }
         }
-    }
 
-    @Test
-    func `a combining mark after thirty compact digits is refused instead of trapping`() {
-        #expect(throws: RFC_4122.UUID.Error.self) {
-            try RFC_4122.UUID(String(repeating: "a", count: 30) + "\u{301}")
+        @Test
+        func `a combining mark after thirty compact digits is refused instead of trapping`() {
+            #expect(throws: RFC_4122.UUID.Error.self) {
+                try RFC_4122.UUID(String(repeating: "a", count: 30) + "\u{301}")
+            }
         }
-    }
 
-    @Test
-    func `a combining mark ending a hyphenated form is refused instead of trapping`() {
-        #expect(throws: RFC_4122.UUID.Error.self) {
-            try RFC_4122.UUID("00000000-0000-0000-0000-0000000000\u{301}")
+        @Test
+        func `a combining mark ending a hyphenated form is refused instead of trapping`() {
+            #expect(throws: RFC_4122.UUID.Error.self) {
+                try RFC_4122.UUID("00000000-0000-0000-0000-0000000000\u{301}")
+            }
         }
-    }
 
-    @Test
-    func `a multibyte character inside the digits is refused`() {
-        #expect(throws: RFC_4122.UUID.Error.self) {
-            try RFC_4122.UUID("é" + String(repeating: "a", count: 30))
+        @Test
+        func `a multibyte character inside the digits is refused`() {
+            #expect(throws: RFC_4122.UUID.Error.self) {
+                try RFC_4122.UUID("é" + String(repeating: "a", count: 30))
+            }
         }
     }
 }
