From de01c3ded185ad69c0c4f8162c4734945354b08f Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:41:08 +0000
Subject: [PATCH 10/13] Revert compound-suite moves that nested a suite under a
 namespace of its own name (coenttb/work#242)

---
 .../Outline Snapshot Tests.swift                          | 8 +++-----
 .../Rowspan Snapshot Tests.swift                          | 8 +++-----
 2 files changed, 6 insertions(+), 10 deletions(-)

diff --git a/Tests/Testing/PDF HTML Rendering Snapshot Tests/Outline Snapshot Tests.swift b/Tests/Testing/PDF HTML Rendering Snapshot Tests/Outline Snapshot Tests.swift
index 727dbce..132f425 100644
--- a/Tests/Testing/PDF HTML Rendering Snapshot Tests/Outline Snapshot Tests.swift	
+++ b/Tests/Testing/PDF HTML Rendering Snapshot Tests/Outline Snapshot Tests.swift	
@@ -5,13 +5,11 @@ import Test_Snapshot
 import Testing
 import Tests_Inline_Snapshot
 
-extension `Outline Snapshot Tests`.`Outline Snapshot Tests` {
-    @Suite
-    struct `Outline Snapshot Tests` {
-    }
+@Suite
+struct `Outline Snapshot Tests` {
 }
 
-extension `Outline Snapshot Tests`.`Outline Snapshot Tests` {
+extension `Outline Snapshot Tests` {
     @Suite struct Snapshot {}
 }
 
diff --git a/Tests/Testing/PDF HTML Rendering Snapshot Tests/Rowspan Snapshot Tests.swift b/Tests/Testing/PDF HTML Rendering Snapshot Tests/Rowspan Snapshot Tests.swift
index b517977..984c6da 100644
--- a/Tests/Testing/PDF HTML Rendering Snapshot Tests/Rowspan Snapshot Tests.swift	
+++ b/Tests/Testing/PDF HTML Rendering Snapshot Tests/Rowspan Snapshot Tests.swift	
@@ -5,13 +5,11 @@ import Test_Snapshot
 import Testing
 import Tests_Inline_Snapshot
 
-extension `Rowspan Snapshot Tests`.`Rowspan Snapshot Tests` {
-    @Suite
-    struct `Rowspan Snapshot Tests` {
-    }
+@Suite
+struct `Rowspan Snapshot Tests` {
 }
 
-extension `Rowspan Snapshot Tests`.`Rowspan Snapshot Tests` {
+extension `Rowspan Snapshot Tests` {
     @Suite struct Snapshot {}
 }
 
