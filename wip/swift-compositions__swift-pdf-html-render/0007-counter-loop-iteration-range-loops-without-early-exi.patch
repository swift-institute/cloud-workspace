Date: Sun, 8 Nov 2026 02:34:04 +0000
Subject: [PATCH 07/11] counter loop iteration: range loops without early exit
 written as forEach (type-check follows; Linux x86_64, Swift 6.4.2)
 (coenttb/work#242)

---
 .../PDF.HTML.Context.Table.Grid.swift         |  4 ++--
 .../BreakProperty Tests.swift                 | 22 +++++++++----------
 .../PDF.Output Tests.swift                    |  2 +-
 .../PDF.Output Snapshot Tests.swift           |  2 +-
 4 files changed, 15 insertions(+), 15 deletions(-)

diff --git a/Sources/PDF HTML Rendering/PDF.HTML.Context.Table.Grid.swift b/Sources/PDF HTML Rendering/PDF.HTML.Context.Table.Grid.swift
index a2488bd..91b0ab0 100644
--- a/Sources/PDF HTML Rendering/PDF.HTML.Context.Table.Grid.swift	
+++ b/Sources/PDF HTML Rendering/PDF.HTML.Context.Table.Grid.swift	
@@ -55,9 +55,9 @@ extension PDF.HTML.Context.Table.Grid {
                 )
             }
 
-            for c in originColumn..<(originColumn + colspan) {
+            (originColumn..<(originColumn + colspan)).forEach { c in
 
-                if r == originRow && c == originColumn { continue }
+                if r == originRow && c == originColumn { return }
                 if c < grid[r].count {
                     grid[r][c] = span
                 }
