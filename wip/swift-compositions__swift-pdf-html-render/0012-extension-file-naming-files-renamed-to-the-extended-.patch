From 81eed4088445c9e20fc2d0030fdb1b3b2241f871 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:43:48 +0000
Subject: [PATCH 12/13] extension file naming: files renamed to the extended
 type's own name or the 'T where <clause>' shape (renames only; Linux x86_64,
 Swift 6.4.2) (coenttb/work#242)

---
 ...UserSpace.Size.swift => PDF.UserSpace.Size where N == 1.swift} | 0
 ...HTML.Element.Tag+TableBorders.swift => HTML.Tag.Element.swift} | 0
 .../{PDF.Document+HTML.swift => PDF.Document.swift}               | 0
 ...er.Context +PDF.HTML.swift => Renderer.Document.Context.swift} | 0
 4 files changed, 0 insertions(+), 0 deletions(-)
 rename Sources/PDF HTML Rendering/CSS/{CSS+PDF.UserSpace.Size.swift => PDF.UserSpace.Size where N == 1.swift} (100%)
 rename Sources/PDF HTML Rendering/{HTML.Element.Tag+TableBorders.swift => HTML.Tag.Element.swift} (100%)
 rename Sources/PDF HTML Rendering/{PDF.Document+HTML.swift => PDF.Document.swift} (100%)
 rename Sources/PDF HTML Rendering/{Render.Context +PDF.HTML.swift => Renderer.Document.Context.swift} (100%)

diff --git a/Sources/PDF HTML Rendering/CSS/CSS+PDF.UserSpace.Size.swift b/Sources/PDF HTML Rendering/CSS/PDF.UserSpace.Size where N == 1.swift
similarity index 100%
rename from Sources/PDF HTML Rendering/CSS/CSS+PDF.UserSpace.Size.swift
rename to Sources/PDF HTML Rendering/CSS/PDF.UserSpace.Size where N == 1.swift
diff --git a/Sources/PDF HTML Rendering/HTML.Element.Tag+TableBorders.swift b/Sources/PDF HTML Rendering/HTML.Tag.Element.swift
similarity index 100%
rename from Sources/PDF HTML Rendering/HTML.Element.Tag+TableBorders.swift
rename to Sources/PDF HTML Rendering/HTML.Tag.Element.swift
diff --git a/Sources/PDF HTML Rendering/PDF.Document+HTML.swift b/Sources/PDF HTML Rendering/PDF.Document.swift
similarity index 100%
rename from Sources/PDF HTML Rendering/PDF.Document+HTML.swift
rename to Sources/PDF HTML Rendering/PDF.Document.swift
diff --git a/Sources/PDF HTML Rendering/Render.Context +PDF.HTML.swift b/Sources/PDF HTML Rendering/Renderer.Document.Context.swift
similarity index 100%
rename from Sources/PDF HTML Rendering/Render.Context +PDF.HTML.swift
rename to Sources/PDF HTML Rendering/Renderer.Document.Context.swift
