From ae93805068097aa3ca204d4898e46516fbc01068 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:35:32 +0000
Subject: [PATCH 08/14] statement where expression fits: single-value if/else
 chains written as if expressions (type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 .../PDF HTML Rendering/CSS/CSS.BorderShorthandParser.swift  | 6 +++---
 Sources/PDF HTML Rendering/CSS/PDF.HTML.CSS.Apply.swift     | 6 +++---
 ...Backgrounds.Border+PDF.HTML.Style.Context.Modifier.swift | 6 +++---
 3 files changed, 9 insertions(+), 9 deletions(-)

diff --git a/Sources/PDF HTML Rendering/CSS/CSS.BorderShorthandParser.swift b/Sources/PDF HTML Rendering/CSS/CSS.BorderShorthandParser.swift
index 637f454..e8ce425 100644
--- a/Sources/PDF HTML Rendering/CSS/CSS.BorderShorthandParser.swift	
+++ b/Sources/PDF HTML Rendering/CSS/CSS.BorderShorthandParser.swift	
@@ -57,10 +57,10 @@ extension W3C_CSS_Backgrounds.BorderLeft: BorderSideProperty {
     ) {
 
         let widthKeyword: W3C_CSS_Backgrounds.BorderWidth.Width?
-        if case .values(let values) = width {
-            widthKeyword = values.top
+        widthKeyword = if case .values(let values) = width {
+            values.top
         } else {
-            widthKeyword = nil
+            nil
         }
         Self.properties(
             width: widthKeyword,
diff --git a/Sources/PDF HTML Rendering/CSS/PDF.HTML.CSS.Apply.swift b/Sources/PDF HTML Rendering/CSS/PDF.HTML.CSS.Apply.swift
index 8564824..ed86176 100644
--- a/Sources/PDF HTML Rendering/CSS/PDF.HTML.CSS.Apply.swift	
+++ b/Sources/PDF HTML Rendering/CSS/PDF.HTML.CSS.Apply.swift	
@@ -136,10 +136,10 @@ extension PDF.HTML.CSS.Apply {
         case "lighter": modifier = .lighter
 
         default:
-            if let n = Int(trimmed) {
-                modifier = .number(n)
+            modifier = if let n = Int(trimmed) {
+                .number(n)
             } else {
-                modifier = nil
+                nil
             }
         }
         modifier?.apply(to: &context.pdf, configuration: configuration)
diff --git a/Sources/PDF HTML Rendering/CSS/W3C_CSS_Backgrounds.Border+PDF.HTML.Style.Context.Modifier.swift b/Sources/PDF HTML Rendering/CSS/W3C_CSS_Backgrounds.Border+PDF.HTML.Style.Context.Modifier.swift
index 818639c..869e617 100644
--- a/Sources/PDF HTML Rendering/CSS/W3C_CSS_Backgrounds.Border+PDF.HTML.Style.Context.Modifier.swift	
+++ b/Sources/PDF HTML Rendering/CSS/W3C_CSS_Backgrounds.Border+PDF.HTML.Style.Context.Modifier.swift	
@@ -17,10 +17,10 @@ extension W3C_CSS_Backgrounds.Border: PDF.HTML.Style.Context.Modifier {
                 )
             }
             let effectiveWidth: PDF.UserSpace.Size<1>?
-            if let style, style == .none || style == .hidden {
-                effectiveWidth = .init(0)
+            effectiveWidth = if let style, style == .none || style == .hidden {
+                .init(0)
             } else {
-                effectiveWidth = declaredWidth
+                declaredWidth
             }
 
             if context.table != nil {
-- 
