From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:06:17 +0000
Subject: [PATCH 08/13] single type per file: additional types moved to their
 own files (type-check follows; Linux x86_64, Swift 6.4.2) (coenttb/work#242)

---
 .../Buffer.Slab.Box.swift                     | 29 +++++++++++++++++++
 .../Buffer Slab Primitive/Buffer.Slab.swift   | 21 --------------
 2 files changed, 29 insertions(+), 21 deletions(-)
 create mode 100644 Sources/Buffer Slab Primitive/Buffer.Slab.Box.swift

diff --git a/Sources/Buffer Slab Primitive/Buffer.Slab.Box.swift b/Sources/Buffer Slab Primitive/Buffer.Slab.Box.swift
new file mode 100644
index 0000000..91cafaa
--- /dev/null
+++ b/Sources/Buffer Slab Primitive/Buffer.Slab.Box.swift	
@@ -0,0 +1,29 @@
+import Affine
+import Bit_Vector_Bounded
+import Index
+import Ordinal
+import Storage
+
+
+extension Buffer.Slab where S: ~Copyable {
+    @usableFromInline
+    internal final class Box {
+        @usableFromInline
+        internal var header: Header
+
+        @usableFromInline
+        internal var storage: S
+
+        @usableFromInline
+        internal init(header: Header, storage: consuming S) {
+            self.header = header
+            self.storage = storage
+        }
+
+        deinit {
+            header.bitmap.ones.forEach { bitIndex in
+                _ = storage.move(at: bitIndex.retag(S.Element.self))
+            }
+        }
+    }
+}
diff --git a/Sources/Buffer Slab Primitive/Buffer.Slab.swift b/Sources/Buffer Slab Primitive/Buffer.Slab.swift
index a4cd057..b25e467 100644
--- a/Sources/Buffer Slab Primitive/Buffer.Slab.swift	
+++ b/Sources/Buffer Slab Primitive/Buffer.Slab.swift	
@@ -19,27 +19,6 @@ extension Buffer where S: Store.`Protocol`, S: ~Copyable {
 }
 
