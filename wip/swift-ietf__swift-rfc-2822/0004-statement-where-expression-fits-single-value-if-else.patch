From e04563db751801505c42be971134977fde6cdda5 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:35:30 +0000
Subject: [PATCH 4/4] statement where expression fits: single-value if/else
 chains written as if expressions (type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 Sources/RFC 2822/RFC_2822.Mailbox.Parse.swift               | 6 +++---
 .../RFC 2822/RFC_2822.Message.Received.NameValuePair.swift  | 6 +++---
 Sources/RFC 2822/RFC_2822.Message.swift                     | 6 +++---
 3 files changed, 9 insertions(+), 9 deletions(-)

diff --git a/Sources/RFC 2822/RFC_2822.Mailbox.Parse.swift b/Sources/RFC 2822/RFC_2822.Mailbox.Parse.swift
index a045454..6c0947f 100644
--- a/Sources/RFC 2822/RFC_2822.Mailbox.Parse.swift	
+++ b/Sources/RFC 2822/RFC_2822.Mailbox.Parse.swift	
@@ -53,10 +53,10 @@ extension RFC_2822.Mailbox.Parse: Parsing {
         }
 
         let displayName: Input?
-        if open > input.startIndex {
-            displayName = input[input.startIndex..<open]
+        displayName = if open > input.startIndex {
+            input[input.startIndex..<open]
         } else {
-            displayName = nil
+            nil
         }
 
         let afterOpen = input.index(after: open)
diff --git a/Sources/RFC 2822/RFC_2822.Message.Received.NameValuePair.swift b/Sources/RFC 2822/RFC_2822.Message.Received.NameValuePair.swift
index 7ea4508..62849ee 100644
--- a/Sources/RFC 2822/RFC_2822.Message.Received.NameValuePair.swift	
+++ b/Sources/RFC 2822/RFC_2822.Message.Received.NameValuePair.swift	
@@ -94,10 +94,10 @@ extension RFC_2822.Message.Received.NameValuePair: ASCII.Parseable {
                 valueStart += 1
             }
 
-            if valueStart < codeArray.count {
-                value = String(ascii: codeArray[valueStart...])
+            value = if valueStart < codeArray.count {
+                String(ascii: codeArray[valueStart...])
             } else {
-                value = ""
+                ""
             }
         } else {
 
diff --git a/Sources/RFC 2822/RFC_2822.Message.swift b/Sources/RFC 2822/RFC_2822.Message.swift
index 841df21..14bd02d 100644
--- a/Sources/RFC 2822/RFC_2822.Message.swift	
+++ b/Sources/RFC 2822/RFC_2822.Message.swift	
@@ -94,10 +94,10 @@ extension RFC_2822.Message {
 
         if let headerEnd = headerEndIndex, let bodyStart = bodyStartIndex {
             fieldsBytes = Array(byteArray[..<headerEnd])
-            if bodyStart < byteArray.count {
-                bodyBytes = Array(byteArray[bodyStart...])
+            bodyBytes = if bodyStart < byteArray.count {
+                Array(byteArray[bodyStart...])
             } else {
-                bodyBytes = nil
+                nil
             }
         } else {
 
