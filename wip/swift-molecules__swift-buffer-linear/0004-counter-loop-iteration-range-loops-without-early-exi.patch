From 19e3cc3723db3d7123bcaf9348473a909f2f3101 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:34:01 +0000
Subject: [PATCH 4/7] counter loop iteration: range loops without early exit
 written as forEach (type-check follows; Linux x86_64, Swift 6.4.2)
 (coenttb/work#242)

---
 Tests/Buffer Linear Tests/Buffer.Linear+OutputSpan Tests.swift | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Tests/Buffer Linear Tests/Buffer.Linear+OutputSpan Tests.swift b/Tests/Buffer Linear Tests/Buffer.Linear+OutputSpan Tests.swift
index 3602f7a..356f6d0 100644
--- a/Tests/Buffer Linear Tests/Buffer.Linear+OutputSpan Tests.swift	
+++ b/Tests/Buffer Linear Tests/Buffer.Linear+OutputSpan Tests.swift	
@@ -110,7 +110,7 @@ extension LinearOutputSpanTests.Append {
         let capacityBefore = buffer.capacity
 
         buffer.append(addingCapacity: .init(_unchecked: Cardinal(10))) { span in
-            for i in 0..<10 {
+            (0..<10).forEach { i in
                 span.append(100 + i)
             }
         }
