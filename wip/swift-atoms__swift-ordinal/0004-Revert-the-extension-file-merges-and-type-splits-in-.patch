From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 21:46:00 +0000
Subject: [PATCH 4/7] Revert the extension-file merges and type splits in
 directories where a merged file brought its conditional imports mid-file
 (coenttb/work#242)

---
 Sources/Ordinal/Ordinal+Cardinal.Count.swift  |  9 +++
 Sources/Ordinal/Ordinal+Int.swift             | 16 ++++
 Sources/Ordinal/Ordinal+PropertyAliases.swift | 13 ++++
 ...rdinal+Swift.CustomStringConvertible.swift |  8 ++
 ...al+Swift.ExpressibleByIntegerLiteral.swift | 12 +++
 ...inal+Swift.Hashable+Swift.Comparable.swift | 11 +++
 Sources/Ordinal/Ordinal.swift                 | 74 -------------------
 7 files changed, 69 insertions(+), 74 deletions(-)
 create mode 100644 Sources/Ordinal/Ordinal+Cardinal.Count.swift
 create mode 100644 Sources/Ordinal/Ordinal+Int.swift
 create mode 100644 Sources/Ordinal/Ordinal+PropertyAliases.swift
 create mode 100644 Sources/Ordinal/Ordinal+Swift.CustomStringConvertible.swift
 create mode 100644 Sources/Ordinal/Ordinal+Swift.ExpressibleByIntegerLiteral.swift
 create mode 100644 Sources/Ordinal/Ordinal+Swift.Hashable+Swift.Comparable.swift

diff --git a/Sources/Ordinal/Ordinal+Cardinal.Count.swift b/Sources/Ordinal/Ordinal+Cardinal.Count.swift
new file mode 100644
index 0000000..60bd68f
--- /dev/null
+++ b/Sources/Ordinal/Ordinal+Cardinal.Count.swift
@@ -0,0 +1,9 @@
+public import Cardinal
+
+extension Ordinal {
+
+    @inlinable
+    public init(_ count: Cardinal) {
+        self.init(count.rawValue)
+    }
+}
diff --git a/Sources/Ordinal/Ordinal+Int.swift b/Sources/Ordinal/Ordinal+Int.swift
new file mode 100644
index 0000000..b4057a2
--- /dev/null
+++ b/Sources/Ordinal/Ordinal+Int.swift
@@ -0,0 +1,16 @@
+extension Ordinal {
+
+    @inlinable
+    public init?(exactly value: Int) {
+        guard value >= 0 else { return nil }
+        self.init(UInt(value))
+    }
+
+    @inlinable
+    public init(_ value: Int) throws(Self.Error) {
+        guard value >= 0 else {
+            throw .negativeSource(value)
+        }
+        self.init(UInt(value))
+    }
+}
diff --git a/Sources/Ordinal/Ordinal+PropertyAliases.swift b/Sources/Ordinal/Ordinal+PropertyAliases.swift
new file mode 100644
index 0000000..c6e5a7d
--- /dev/null
+++ b/Sources/Ordinal/Ordinal+PropertyAliases.swift
@@ -0,0 +1,13 @@
+public import Advancement
+public import Distance
+public import Predecessor
+public import Retreat
+public import Successor
+
+extension Ordinal {
+    public typealias Advance = Advancement::Advancement
+    public typealias Distance = Distance::Distance
+    public typealias Predecessor = Predecessor::Predecessor
+    public typealias Retreat = Retreat::Retreat
+    public typealias Successor = Successor::Successor
+}
diff --git a/Sources/Ordinal/Ordinal+Swift.CustomStringConvertible.swift b/Sources/Ordinal/Ordinal+Swift.CustomStringConvertible.swift
new file mode 100644
index 0000000..cf395c7
--- /dev/null
+++ b/Sources/Ordinal/Ordinal+Swift.CustomStringConvertible.swift
@@ -0,0 +1,8 @@
+#if SYNCHRONIZATION_AVAILABLE
+    import Synchronization
+#endif
+
+extension Ordinal: Swift.CustomStringConvertible {
+
+    public var description: String { rawValue.description }
+}
diff --git a/Sources/Ordinal/Ordinal+Swift.ExpressibleByIntegerLiteral.swift b/Sources/Ordinal/Ordinal+Swift.ExpressibleByIntegerLiteral.swift
new file mode 100644
index 0000000..26e654b
--- /dev/null
+++ b/Sources/Ordinal/Ordinal+Swift.ExpressibleByIntegerLiteral.swift
@@ -0,0 +1,12 @@
+#if SYNCHRONIZATION_AVAILABLE
+    import Synchronization
+#endif
+
+extension Ordinal: Swift.ExpressibleByIntegerLiteral {
+
+    @_disfavoredOverload
+    @inlinable
+    public init(integerLiteral value: UInt) {
+        self.init(value)
+    }
+}
diff --git a/Sources/Ordinal/Ordinal+Swift.Hashable+Swift.Comparable.swift b/Sources/Ordinal/Ordinal+Swift.Hashable+Swift.Comparable.swift
new file mode 100644
index 0000000..1bd522a
--- /dev/null
+++ b/Sources/Ordinal/Ordinal+Swift.Hashable+Swift.Comparable.swift
@@ -0,0 +1,11 @@
+#if SYNCHRONIZATION_AVAILABLE
+    import Synchronization
+#endif
+
+extension Ordinal: Swift.Hashable, Swift.Comparable {
+
+    @inlinable
+    public borrowing func hash(into hasher: inout Hasher) {
+        hasher.combine(rawValue)
+    }
+}
