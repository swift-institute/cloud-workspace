-        #expect(throws: Ordinal.Error.notForward) {
-            try Ordinal(7 as UInt).distance.forward(to: Ordinal(2 as UInt))
+            #expect(distance.rawValue == 5)
+            #expect(throws: Ordinal.Error.notForward) {
+                try Ordinal(7 as UInt).distance.forward(to: Ordinal(2 as UInt))
+            }
