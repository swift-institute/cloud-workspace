diff --git a/Tests/Consolidated swift-ordinal-property/Ordinal Property Tests/Ordinal Property Tests.swift b/Tests/Consolidated swift-ordinal-property/Ordinal Property Tests/Ordinal Property Tests.swift
index 3c87856..4d7c358 100644
--- a/Tests/Consolidated swift-ordinal-property/Ordinal Property Tests/Ordinal Property Tests.swift	
+++ b/Tests/Consolidated swift-ordinal-property/Ordinal Property Tests/Ordinal Property Tests.swift	
@@ -26,87 +26,89 @@ private struct Position: Ordinal.`Protocol`, Comparable {
     }
