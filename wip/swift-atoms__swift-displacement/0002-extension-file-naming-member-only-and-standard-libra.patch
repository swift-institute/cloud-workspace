From 7c2514a68fa3bd8fe4377590a06d821d86c06bac Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 20:52:43 +0000
Subject: [PATCH 2/4] extension file naming: member-only and
 standard-library-conformance extension files merge into their type's own file
 (overnight/merge-extension-files.py); single type per file: additional types
 move to their own <Parent>.<Name>.swift inside the container's extension
 (overnight/split-types.py); parse-checked; builds pending (coenttb/work#242)

---
 Sources/Displacement/Displacement+Components.swift | 12 ------------
 Sources/Displacement/Displacement.swift            | 11 +++++++++++
 2 files changed, 11 insertions(+), 12 deletions(-)
 delete mode 100644 Sources/Displacement/Displacement+Components.swift

diff --git a/Sources/Displacement/Displacement+Components.swift b/Sources/Displacement/Displacement+Components.swift
deleted file mode 100644
index 910c96e..0000000
--- a/Sources/Displacement/Displacement+Components.swift
+++ /dev/null
@@ -1,12 +0,0 @@
-import Vector
-
-extension Displacement {
-
-    public init(_ components: consuming InlineArray<N, Scalar>) {
-        self.init(components: Vector(components))
-    }
-
-    public init(repeating value: Scalar) {
-        self.init(components: Vector(repeating: value))
-    }
-}
diff --git a/Sources/Displacement/Displacement.swift b/Sources/Displacement/Displacement.swift
index bdbd25d..19ae9fc 100644
--- a/Sources/Displacement/Displacement.swift
+++ b/Sources/Displacement/Displacement.swift
@@ -23,3 +23,14 @@ extension Displacement: AdditiveArithmetic where Scalar: AdditiveArithmetic {
         Self(components: lhs.components - rhs.components)
     }
 }
+
+extension Displacement {
+
+    public init(_ components: consuming InlineArray<N, Scalar>) {
+        self.init(components: Vector(components))
+    }
+
+    public init(repeating value: Scalar) {
+        self.init(components: Vector(repeating: value))
+    }
+}
