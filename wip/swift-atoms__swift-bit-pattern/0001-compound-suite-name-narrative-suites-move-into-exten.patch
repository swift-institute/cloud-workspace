 (coenttb/work#242)

---
 Tests/Bit Pattern Tests/Bit.Pattern.Rotation Tests.swift | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/Tests/Bit Pattern Tests/Bit.Pattern.Rotation Tests.swift b/Tests/Bit Pattern Tests/Bit.Pattern.Rotation Tests.swift
index 0d1b13c..f2f1ce4 100644
--- a/Tests/Bit Pattern Tests/Bit.Pattern.Rotation Tests.swift	
+++ b/Tests/Bit Pattern Tests/Bit.Pattern.Rotation Tests.swift	
@@ -3,9 +3,15 @@ import Testing
 
 @Suite
 struct `Bit rotation preserves every bit` {
+}
+
+extension `Bit rotation preserves every bit` {
     @Suite struct `Bit rotations wrap positions and invert each other` {}
+
     @Suite struct `Bit rotation normalizes counts and preserves signed bit patterns` {}
+
     @Suite struct `No bit rotation integration cases are defined` {}
+
     @Suite(.serialized) struct `No bit rotation performance cases are defined` {}
 }
 
