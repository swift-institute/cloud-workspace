From df4bcab4991e746e8002b7de37e6fa557c7969ec Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:06:18 +0000
Subject: [PATCH 09/11] single type per file: additional types moved to their
 own files (type-check follows; Linux x86_64, Swift 6.4.2) (coenttb/work#242)

---
 Sources/RFC 4287/RFC_4287.Content.ContentType.swift | 13 +++++++++++++
 Sources/RFC 4287/RFC_4287.Content.swift             |  6 ------
 2 files changed, 13 insertions(+), 6 deletions(-)
 create mode 100644 Sources/RFC 4287/RFC_4287.Content.ContentType.swift

diff --git a/Sources/RFC 4287/RFC_4287.Content.ContentType.swift b/Sources/RFC 4287/RFC_4287.Content.ContentType.swift
new file mode 100644
index 0000000..fdba9c4
--- /dev/null
+++ b/Sources/RFC 4287/RFC_4287.Content.ContentType.swift	
@@ -0,0 +1,13 @@
+import RFC_3987
+public import RFC_5646
+public import RFC_9110
+
+
+extension RFC_4287.Content {
+    public enum ContentType: Hashable, Sendable, Codable {
+        case text
+        case html
+        case xhtml
+        case media(RFC_9110.MediaType)
+    }
+}
diff --git a/Sources/RFC 4287/RFC_4287.Content.swift b/Sources/RFC 4287/RFC_4287.Content.swift
index 224d9d9..123a05e 100644
--- a/Sources/RFC 4287/RFC_4287.Content.swift	
+++ b/Sources/RFC 4287/RFC_4287.Content.swift	
@@ -68,12 +68,6 @@ extension RFC_4287 {
 }
 
 extension RFC_4287.Content {
-    public enum ContentType: Hashable, Sendable, Codable {
-        case text
-        case html
-        case xhtml
-        case media(RFC_9110.MediaType)
-    }
 }
 
 extension RFC_4287.Content.ContentType {
