 6.4.2) (coenttb/work#242)

---
 Sources/RFC 4287/RFC_4287.Content.swift | 21 +++++++++------------
 1 file changed, 9 insertions(+), 12 deletions(-)

diff --git a/Sources/RFC 4287/RFC_4287.Content.swift b/Sources/RFC 4287/RFC_4287.Content.swift
index a9cf932..224d9d9 100644
--- a/Sources/RFC 4287/RFC_4287.Content.swift	
+++ b/Sources/RFC 4287/RFC_4287.Content.swift	
@@ -3,16 +3,7 @@ public import RFC_5646
 public import RFC_9110
 
 extension RFC_4287 {
-
     public struct Content: Hashable, Sendable, Codable {
