Subject: [PATCH 07/11] exported import, architecture import boundary:
 re-exports moved into the target's root exports.swift (re-export set
 unchanged; type-check follows; Linux x86_64, Swift 6.4.2) (coenttb/work#242)

---
 Sources/RFC 4287/RFC_4287.swift | 6 +++---
 Sources/RFC 4287/exports.swift  | 3 +++
 2 files changed, 6 insertions(+), 3 deletions(-)
 create mode 100644 Sources/RFC 4287/exports.swift

diff --git a/Sources/RFC 4287/RFC_4287.swift b/Sources/RFC 4287/RFC_4287.swift
index 7466a40..55af7d3 100644
--- a/Sources/RFC 4287/RFC_4287.swift	
+++ b/Sources/RFC 4287/RFC_4287.swift	
@@ -1,5 +1,5 @@
-@_exported import RFC_3339
-@_exported import RFC_3987
-@_exported import RFC_4648
+public import RFC_3339
+public import RFC_3987
+public import RFC_4648
 
 public enum RFC_4287 {}
diff --git a/Sources/RFC 4287/exports.swift b/Sources/RFC 4287/exports.swift
new file mode 100644
index 0000000..5004f1e
--- /dev/null
+++ b/Sources/RFC 4287/exports.swift	
@@ -0,0 +1,3 @@
+@_exported public import RFC_3339
+@_exported public import RFC_3987
+@_exported public import RFC_4648
