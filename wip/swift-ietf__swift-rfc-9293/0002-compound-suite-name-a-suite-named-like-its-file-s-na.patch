+        let flags: RFC_9293.`3`.`1`.Flags = [.syn, .ack]
+        let encoded = try JSONEncoder().encode(flags)
 
-            #expect(String(decoding: encoded, as: UTF8.self) == "18")
-            #expect(try JSONDecoder().decode(RFC_9293.`3`.`1`.Flags.self, from: encoded) == flags)
-        }
