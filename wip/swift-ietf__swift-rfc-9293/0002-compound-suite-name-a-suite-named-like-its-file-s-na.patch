+        #expect(throws: RFC_9293.`3`.`1`.DataOffset.Error.valueTooSmall) {
+            try JSONDecoder().decode(
+                RFC_9293.`3`.`1`.DataOffset.self,
+                from: Data("4".utf8)
             )
-            #expect(throws: RFC_9293.`3`.`1`.DataOffset.Error.valueTooSmall) {
-                try JSONDecoder().decode(
-                    RFC_9293.`3`.`1`.DataOffset.self,
-                    from: Data("4".utf8)
-                )
-            }
         }
+    }
 
-        @Test
