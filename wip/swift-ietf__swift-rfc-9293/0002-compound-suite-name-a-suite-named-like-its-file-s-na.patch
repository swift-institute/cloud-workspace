diff --git a/Tests/RFC 9293 Foundation Integration Tests/RFC_9293 Codable Tests.swift b/Tests/RFC 9293 Foundation Integration Tests/RFC_9293 Codable Tests.swift
index e9bbd39..f7e883d 100644
--- a/Tests/RFC 9293 Foundation Integration Tests/RFC_9293 Codable Tests.swift	
+++ b/Tests/RFC 9293 Foundation Integration Tests/RFC_9293 Codable Tests.swift	
@@ -3,76 +3,74 @@ import RFC_9293
 import RFC_9293_Foundation_Integration
 import Testing
 
-extension `RFC_9293 Codable Tests`.`RFC_9293 Codable Tests` {
-    @Suite
-    struct `RFC_9293 Codable Tests` {
+@Suite
+struct `RFC_9293 Codable Tests` {
 
-        @Test
-        func `a port codes as its number`() throws {
-            let port = RFC_9293.Port(8080)
