+
+        public init(iss: RFC_9293.SequenceNumber) {
+            self.una = iss
+            self.nxt = iss + 1
+            self.wnd = 0
+            self.up = iss
+            self.wl1 = iss
+            self.wl2 = iss
+            self.iss = iss
+        }
+    }
+}
