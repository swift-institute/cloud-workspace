Subject: [PATCH 2/2] Revert the extension-file merges and type splits in
 directories the type-check can't verify (C shims, macros); institute's
 generated Ratchet+limits.swift stays its own file (coenttb/work#242)

---
 ...nel.Thread.Executor.PriorityOverride.swift | 42 +++++++++++++++
 .../Kernel.Thread.Executor.Runtime.swift      | 10 ++++
 ...rnel.Thread.Executor.Sharded.Runtime.swift | 14 +++++
 .../Kernel.Thread.Executor.Sharded.swift      | 15 ------
 .../Executors/Kernel.Thread.Executor.swift    | 54 -------------------
 5 files changed, 66 insertions(+), 69 deletions(-)
 create mode 100644 Sources/Executors/Kernel.Thread.Executor.PriorityOverride.swift
 create mode 100644 Sources/Executors/Kernel.Thread.Executor.Runtime.swift
 create mode 100644 Sources/Executors/Kernel.Thread.Executor.Sharded.Runtime.swift

diff --git a/Sources/Executors/Kernel.Thread.Executor.PriorityOverride.swift b/Sources/Executors/Kernel.Thread.Executor.PriorityOverride.swift
new file mode 100644
index 0000000..d9814a5
--- /dev/null
+++ b/Sources/Executors/Kernel.Thread.Executor.PriorityOverride.swift
@@ -0,0 +1,42 @@
+extension Kernel.Thread.Executor {
+
+    internal static func runJob(
+        _ job: UnownedJob,
+        onSerial executor: UnownedSerialExecutor,
+        priorityTracking: Bool
+    ) {
+        #if os(macOS) || os(iOS) || os(tvOS) || os(watchOS) || os(visionOS)
+            if priorityTracking,
+                let qos = Darwin.Kernel.Thread.QoS(priority: UInt32(job.priority.rawValue))
+            {
+                qos.withOverride {
+                    unsafe job.runSynchronously(on: executor)
+                }
+            } else {
+                unsafe job.runSynchronously(on: executor)
+            }
+        #else
+            unsafe job.runSynchronously(on: executor)
+        #endif
+    }
+
+    internal static func runJob(
+        _ job: UnownedJob,
+        onTask executor: UnownedTaskExecutor,
+        priorityTracking: Bool
+    ) {
+        #if os(macOS) || os(iOS) || os(tvOS) || os(watchOS) || os(visionOS)
+            if priorityTracking,
+                let qos = Darwin.Kernel.Thread.QoS(priority: UInt32(job.priority.rawValue))
+            {
+                qos.withOverride {
+                    unsafe job.runSynchronously(on: executor)
+                }
+            } else {
+                unsafe job.runSynchronously(on: executor)
+            }
+        #else
+            unsafe job.runSynchronously(on: executor)
+        #endif
+    }
+}
diff --git a/Sources/Executors/Kernel.Thread.Executor.Runtime.swift b/Sources/Executors/Kernel.Thread.Executor.Runtime.swift
new file mode 100644
index 0000000..768021a
--- /dev/null
+++ b/Sources/Executors/Kernel.Thread.Executor.Runtime.swift
@@ -0,0 +1,10 @@
+extension Kernel.Thread.Executor {
+
+    public var runtime: Executor.Runtime {
+        wait.withLock {
+            if _loopExited { return .terminated }
+            if _shutdown.isSet { return .draining }
+            return .running
+        }
+    }
+}
diff --git a/Sources/Executors/Kernel.Thread.Executor.Sharded.Runtime.swift b/Sources/Executors/Kernel.Thread.Executor.Sharded.Runtime.swift
new file mode 100644
index 0000000..a261ebf
--- /dev/null
+++ b/Sources/Executors/Kernel.Thread.Executor.Sharded.Runtime.swift
@@ -0,0 +1,14 @@
+extension Kernel.Thread.Executor.Sharded {
+
+    public var runtime: Executor.Runtime {
+        let states = executors.map(\.runtime)
+        if states.contains(.running) { return .running }
+        if states.contains(.draining) { return .draining }
+        return .terminated
+    }
+
+    public var affinities: [Executor.Affinity] {
+        let total = executors.count
+        return (0..<total).map { Executor.Affinity(index: $0, count: total) }
+    }
+}
