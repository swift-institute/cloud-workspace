index c7cc259..ca653d4 100644
--- a/Sources/Executors/Kernel.Thread.Executor.Sharded.swift
+++ b/Sources/Executors/Kernel.Thread.Executor.Sharded.swift
@@ -55,18 +55,3 @@ extension Kernel.Thread.Executor.Sharded {
         }
     }
 }
