+        #expect(counts.operations == 9)
+        #expect(counts.teardowns == 3)
+        #expect(execution.measurement.values == [3, 3])
+        #expect(execution.iterations.map(\.phase) == [.warmup, .measurement, .measurement])
+        #expect(plan.work == 6)
