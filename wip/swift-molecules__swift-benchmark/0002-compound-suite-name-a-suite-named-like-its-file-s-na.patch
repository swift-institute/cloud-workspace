+    @Test
+    func `warmups, measured iterations, and batches execute exactly`() throws {
+        let counts = Counts()
+        let plan = try Benchmark.Plan(
+            warmup: 1,
+            measurements: 2,
+            batch: 3
+        )
+        let workload = Benchmark.Workload<Int, Never>(
+            setup: {
+                counts.setups += 1
+                return 0
+            },
+            operation: { state in
+                counts.operations += 1
+                state += 1
+            },
+            teardown: { state in
+                counts.teardowns += 1
+                #expect(state == 3)
+            }
