-        public static var dalton: Self {
-            do {
-                return Self(
-                    numericalValue: 166_053_906_892 * (try Rational(10).raised(to: -38)),
-                    standardUncertainty: 52 * (try Rational(10).raised(to: -38)),
-                    unit: SI.Unit.Name.kilogram.expression,
