Subject: [PATCH 12/14] Revert Sources/International System of
 Units/SI.Notation.swift: it broke the type-check (coenttb/work#242)

---
 .../SI.Notation.swift                         | 35 +++++++++----------
 1 file changed, 16 insertions(+), 19 deletions(-)

diff --git a/Sources/International System of Units/SI.Notation.swift b/Sources/International System of Units/SI.Notation.swift
index 81a722e..c889c9c 100644
--- a/Sources/International System of Units/SI.Notation.swift	
+++ b/Sources/International System of Units/SI.Notation.swift	
@@ -1,24 +1,21 @@
 extension SI {
     public enum Notation {
-    }
-}
-
-extension SI.Notation {
-    public enum Marker: String, Sendable {
-        case point = "."
-        case comma = ","
-    }
+        public enum Marker: String, Sendable {
+            case point = "."
+            case comma = ","
+        }
 
-    public static func decimal(_ text: String, marker: Marker = .point) throws(Error) -> String {
-        guard !text.isEmpty else { throw .syntax }
-        var characters = Array(text)
-        var sign = ""
-        if characters.first == "-" || characters.first == "+" { sign = String(characters.removeFirst()) }
-        guard !characters.isEmpty else { throw .syntax }
-        let parts = String(characters).split(separator: Character(marker.rawValue), omittingEmptySubsequences: false)
-        guard parts.count <= 2, !parts[0].isEmpty,
-            parts.allSatisfy({ !$0.isEmpty && $0.allSatisfy { $0.isASCII && $0.isNumber } })
-        else { throw .syntax }
-        return sign + parts.map(String.init).joined(separator: marker.rawValue)
+        public static func decimal(_ text: String, marker: Marker = .point) throws(Error) -> String {
+            guard !text.isEmpty else { throw .syntax }
+            var characters = Array(text)
+            var sign = ""
+            if characters.first == "-" || characters.first == "+" { sign = String(characters.removeFirst()) }
+            guard !characters.isEmpty else { throw .syntax }
+            let parts = String(characters).split(separator: Character(marker.rawValue), omittingEmptySubsequences: false)
+            guard parts.count <= 2, !parts[0].isEmpty,
+                parts.allSatisfy({ !$0.isEmpty && $0.allSatisfy { $0.isASCII && $0.isNumber } })
+            else { throw .syntax }
+            return sign + parts.map(String.init).joined(separator: marker.rawValue)
+        }
     }
 }
