diff --git a/Sources/International System of Units/SI.Value.swift b/Sources/International System of Units/SI.Value.swift
index 060056e..50a7348 100644
--- a/Sources/International System of Units/SI.Value.swift	
+++ b/Sources/International System of Units/SI.Value.swift	
@@ -13,44 +13,52 @@ extension SI {
