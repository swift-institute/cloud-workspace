diff --git a/Sources/International System of Units/SI.Brochure.Logarithm.swift b/Sources/International System of Units/SI.Brochure.Logarithm.swift
index 030f92f..fc15479 100644
--- a/Sources/International System of Units/SI.Brochure.Logarithm.swift	
+++ b/Sources/International System of Units/SI.Brochure.Logarithm.swift	
@@ -5,26 +5,32 @@ extension SI.Brochure {
         case neper
         case bel
         case decibel
+    }
+}
 
-        public var unit: Unit {
-            switch self {
-            case .neper: .neper
-            case .bel: .bel
-            case .decibel: .decibel
-            }
-        }
-        public var base: String { self == .neper ? "e" : "10" }
-        public var multiplier: Rational { self == .decibel ? 10 : 1 }
-        public var equation: String {
-            switch self {
-            case .neper: "LA/Np = ln(A2/A1)"
