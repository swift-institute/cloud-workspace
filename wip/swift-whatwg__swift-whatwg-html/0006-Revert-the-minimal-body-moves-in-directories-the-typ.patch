Subject: [PATCH 6/6] Revert the minimal-body moves in directories the
 type-check can't verify (macros, C shims) (coenttb/work#242)

---
 .../WHATWG.HTML.Value.Attribute.swift                     | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/Sources/WHATWG HTML FormAttributes/WHATWG.HTML.Value.Attribute.swift b/Sources/WHATWG HTML FormAttributes/WHATWG.HTML.Value.Attribute.swift
index ab0a153..4d44e95 100644
--- a/Sources/WHATWG HTML FormAttributes/WHATWG.HTML.Value.Attribute.swift	
+++ b/Sources/WHATWG HTML FormAttributes/WHATWG.HTML.Value.Attribute.swift	
@@ -1,17 +1,17 @@
 public import WHATWG_HTML_Shared
 
 extension WHATWG.HTML.Value {
+
     public struct Attribute<Element: Sendable & Hashable>: WHATWG.HTML.Attribute {
+
+        public static var attribute: String { "value" }
+
         public var value: Element
 
         public init(_ value: Element) { self.value = value }
     }
 }
 
-extension WHATWG.HTML.Value.Attribute {
-    public static var attribute: String { "value" }
-}
-
 extension WHATWG.HTML.Value.Attribute: LosslessStringConvertible where Element == String {
     public init?(_ description: String) { self = .init(description) }
 }
