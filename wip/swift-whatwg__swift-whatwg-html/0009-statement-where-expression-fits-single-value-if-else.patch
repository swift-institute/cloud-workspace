From 88f22c6084c2132f9dc53e003587cc2d48fdb34f Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:35:32 +0000
Subject: [PATCH 09/11] statement where expression fits: single-value if/else
 chains written as if expressions (type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 Sources/WHATWG HTML Shared/[UInt8].swift | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/Sources/WHATWG HTML Shared/[UInt8].swift b/Sources/WHATWG HTML Shared/[UInt8].swift
index 9752baa..aa45685 100644
--- a/Sources/WHATWG HTML Shared/[UInt8].swift	
+++ b/Sources/WHATWG HTML Shared/[UInt8].swift	
@@ -3,12 +3,12 @@ import ASCII
 extension [UInt8] {
 
     public init<T: WHATWG.HTML.BooleanAttribute>(_ attribute: T) {
-        if attribute.rawValue {
+        self = if attribute.rawValue {
 
-            self = Array(T.attribute.utf8)
+            Array(T.attribute.utf8)
         } else {
 
-            self = []
+            []
         }
     }
 }
