From e8bddcb6ff0d7de69cbffeb7617711ccec668493 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:34:04 +0000
Subject: [PATCH 2/2] counter loop iteration: range loops without early exit
 written as forEach (type-check follows; Linux x86_64, Swift 6.4.2)
 (coenttb/work#242)

---
 Tests/PDF Rendering Tests/PDF.Output Tests.swift              | 2 +-
 .../PDF Rendering Performance Tests.swift                     | 4 ++--
 .../PDF.Output Snapshot Tests.swift                           | 2 +-
 3 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/Tests/PDF Rendering Tests/PDF.Output Tests.swift b/Tests/PDF Rendering Tests/PDF.Output Tests.swift
index 89e9e1b..f2fb24f 100644
--- a/Tests/PDF Rendering Tests/PDF.Output Tests.swift	
+++ b/Tests/PDF Rendering Tests/PDF.Output Tests.swift	
@@ -86,7 +86,7 @@ struct `PDF.Output Tests` {
                     PDF.Text("Multi-Page Test Document", state: .init(fontSize: 24))
                     PDF.Divider()
 
-                    for i in 1...50 {
+                    (1...50).forEach { i in
                         PDF.Text(
                             "Paragraph \(i): This is some sample text that will help fill the page. Each paragraph adds content that will eventually cause a page break when the content exceeds the available height.",
                             state: .init(fontSize: 11)
diff --git a/Tests/Testing/PDF Rendering Performance Tests/PDF Rendering Performance Tests.swift b/Tests/Testing/PDF Rendering Performance Tests/PDF Rendering Performance Tests.swift
index 86393e8..73e504f 100644
--- a/Tests/Testing/PDF Rendering Performance Tests/PDF Rendering Performance Tests.swift	
+++ b/Tests/Testing/PDF Rendering Performance Tests/PDF Rendering Performance Tests.swift	
@@ -96,7 +96,7 @@ extension PDF.Test.Performance {
     @Test(.timed(iterations: 50, warmup: 5))
     func `document with 10 text elements`() {
         let doc = PDF.Document {
-            for i in 0..<10 {
+            (0..<10).forEach { i in
                 PDF.Text("This is paragraph \(i) with some content.")
             }
         }
@@ -106,7 +106,7 @@ extension PDF.Test.Performance {
     @Test(.timed(iterations: 10, warmup: 2))
     func `document with 100 text elements`() {
         let doc = PDF.Document {
-            for i in 0..<100 {
+            (0..<100).forEach { i in
                 PDF.Text("This is paragraph \(i) with some content to make it longer.")
             }
         }
diff --git a/Tests/Testing/PDF Rendering Snapshot Tests/PDF.Output Snapshot Tests.swift b/Tests/Testing/PDF Rendering Snapshot Tests/PDF.Output Snapshot Tests.swift
index 98814fa..5092274 100644
--- a/Tests/Testing/PDF Rendering Snapshot Tests/PDF.Output Snapshot Tests.swift	
+++ b/Tests/Testing/PDF Rendering Snapshot Tests/PDF.Output Snapshot Tests.swift	
@@ -80,7 +80,7 @@ extension PDFOutputSnapshotTests.Snapshot {
                     PDF.Text("Multi-Page Test Document", state: .init(fontSize: 24))
                     PDF.Divider()
 
-                    for i in 1...50 {
+                    (1...50).forEach { i in
                         PDF.Text(
                             "Paragraph \(i): This is some sample text that will help fill the page. Each paragraph adds content that will eventually cause a page break when the content exceeds the available height.",
                             state: .init(fontSize: 11)
-- 
2.43.0

