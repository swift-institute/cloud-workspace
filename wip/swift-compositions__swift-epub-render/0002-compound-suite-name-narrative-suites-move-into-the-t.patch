Subject: [PATCH 2/9] compound suite name: narrative suites move into the test
 module's namespace `<File> Tests` (#239's layout), nested suites into
 extension <Path>.<Parent> (overnight/compound-suites.py); parse-checked;
 builds pending (coenttb/work#242)

---
 .../EPUB Rendering Tests.swift                | 28 ++++++++++---------
 1 file changed, 15 insertions(+), 13 deletions(-)

diff --git a/Tests/EPUB Rendering Tests/EPUB Rendering Tests.swift b/Tests/EPUB Rendering Tests/EPUB Rendering Tests.swift
index 51a16f6..dda39c4 100644
--- a/Tests/EPUB Rendering Tests/EPUB Rendering Tests.swift	
+++ b/Tests/EPUB Rendering Tests/EPUB Rendering Tests.swift	
@@ -3,19 +3,21 @@ import Testing
 
 @testable import EPUB_Rendering
 
-@Suite
-struct `EPUB Rendering Tests` {
-    @Test("Rendering context defaults")
-    func renderingContextDefaults() {
-        let context = EPUB.Rendering.Context()
-        #expect(context.version == .v3_3)
-        #expect(context.ncx == false)
-        #expect(context.compression == 6)
-    }
+extension `EPUB Rendering Tests`.`EPUB Rendering Tests` {
+    @Suite
+    struct `EPUB Rendering Tests` {
+        @Test("Rendering context defaults")
+        func renderingContextDefaults() {
+            let context = EPUB.Rendering.Context()
+            #expect(context.version == .v3_3)
+            #expect(context.ncx == false)
+            #expect(context.compression == 6)
+        }
 
-    @Test("EPUB output")
-    func epubOutput() {
-        let output = EPUB.Rendering.Output(data: [0x50, 0x4B, 0x03, 0x04].map(Byte.init(bitPattern:)))
-        #expect(output.data.count == 4)
+        @Test("EPUB output")
+        func epubOutput() {
+            let output = EPUB.Rendering.Output(data: [0x50, 0x4B, 0x03, 0x04].map(Byte.init(bitPattern:)))
+            #expect(output.data.count == 4)
+        }
     }
 }
