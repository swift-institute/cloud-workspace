diff --git a/Sources/EPUB Rendering/EPUB.Rendering.Context.swift b/Sources/EPUB Rendering/EPUB.Rendering.Context.swift
new file mode 100644
index 0000000..0d30d00
--- /dev/null
+++ b/Sources/EPUB Rendering/EPUB.Rendering.Context.swift	
@@ -0,0 +1,24 @@
+public import Byte
+public import EPUB_Standard
+
+
+extension EPUB.Rendering {
+    public struct Context: Sendable {
+
+        public var version: W3C_EPUB.Version
+
+        public var ncx: Bool
+
+        public var compression: Int
+
+        public init(
+            version: W3C_EPUB.Version = .v3_3,
+            ncx: Bool = false,
+            compression: Int = 6
+        ) {
+            self.version = version
+            self.ncx = ncx
+            self.compression = compression
+        }
+    }
+}
