From 0d2f97d982164703f7462b8940f90a5a8852a843 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 04:03:58 +0000
Subject: [PATCH 15/16] Revert files that raised `file name nested path` over
 its ratchet limit (coenttb/work#242)

---
 Sources/EPUB Rendering/EPUBRenderable.swift | 28 +++++++++++++++++++++
 1 file changed, 28 insertions(+)

diff --git a/Sources/EPUB Rendering/EPUBRenderable.swift b/Sources/EPUB Rendering/EPUBRenderable.swift
index 26d975b..4b90285 100644
--- a/Sources/EPUB Rendering/EPUBRenderable.swift	
+++ b/Sources/EPUB Rendering/EPUBRenderable.swift	
@@ -7,7 +7,35 @@ extension EPUB {
 }
 
 extension EPUB.Rendering {
+
+    public struct Output: Sendable, Hashable {
+
+        public var data: [Byte]
+
+        public init(data: [Byte]) {
+            self.data = data
+        }
+    }
 }
 
 extension EPUB.Rendering {
+
+    public struct Context: Sendable {
+
+        public var version: W3C_EPUB.Version
+
+        public var ncx: Bool
+
+        public var compression: Int
+
+        public init(
+            version: W3C_EPUB.Version = .v3_3,
+            ncx: Bool = false,
+            compression: Int = 6
+        ) {
+            self.version = version
+            self.ncx = ncx
+            self.compression = compression
+        }
+    }
 }
