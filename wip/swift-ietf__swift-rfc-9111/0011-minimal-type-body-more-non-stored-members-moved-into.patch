From 8a44d1035743e50dc8fd6819aaea298c5edfc3e5 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:17:16 +0000
Subject: [PATCH 11/13] minimal type body: more non-stored members moved into
 an extension of their type (batch 18; type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 .../HTTP.Cache.Expires.Coder.swift            | 63 +++++++++----------
 1 file changed, 31 insertions(+), 32 deletions(-)

diff --git a/Sources/RFC 9111/Absorbed swift-rfc-9111-coder/HTTP.Cache.Expires.Coder.swift b/Sources/RFC 9111/Absorbed swift-rfc-9111-coder/HTTP.Cache.Expires.Coder.swift
index 24e08aa..1a38adf 100644
--- a/Sources/RFC 9111/Absorbed swift-rfc-9111-coder/HTTP.Cache.Expires.Coder.swift	
+++ b/Sources/RFC 9111/Absorbed swift-rfc-9111-coder/HTTP.Cache.Expires.Coder.swift	
@@ -8,53 +8,52 @@
     import Serializer
 
     extension RFC_9110.Cache.Expires {
-
         public struct Coder<
             Input: Cursor.`Protocol`<Byte, Never>,
             Buffer: RangeReplaceableCollection<Byte>
         >: Coding {
+            public init() {}
+        }
 
-            public typealias Output = RFC_9110.Cache.Expires
+        public static var coder: Coder<ArraySlice<Byte>, [Byte]> { .init() }
 
-            public typealias Failure = RFC_9110.Cache.Expires.Error
+        public enum Error: Swift::Error, Equatable {
+            case empty
 
-            public init() {}
+            case invalidDate(String)
+        }
+    }
 
-            public borrowing func parse(
-                _ input: inout Input
-            ) throws(Failure) -> RFC_9110.Cache.Expires {
-                let text = Scanning.trimmed(Scanning.text(Scanning.line(&input)))
+extension RFC_9110.Cache.Expires.Coder {
+        public typealias Output = RFC_9110.Cache.Expires
 
-                guard !text.isEmpty else {
-                    throw .empty
-                }
+        public typealias Failure = RFC_9110.Cache.Expires.Error
 
-                guard let date = RFC_5322.DateTime(RFC_9110.Field.Value(unchecked: text)) else {
-                    throw .invalidDate(text)
-                }
+        public borrowing func parse(
+            _ input: inout Input
+        ) throws(Failure) -> RFC_9110.Cache.Expires {
+            let text = Scanning.trimmed(Scanning.text(Scanning.line(&input)))
 
-                return RFC_9110.Cache.Expires(date: date)
+            guard !text.isEmpty else {
+                throw .empty
             }
 
-            public borrowing func serialize(
-                _ output: RFC_9110.Cache.Expires,
-                into buffer: inout Buffer
-            ) throws(Failure) {
-                buffer.append(
-                    contentsOf: Scanning.bytes(
-                        RFC_9110.Field(dateTime: output.date).value.rawValue
-                    )
-                )
+            guard let date = RFC_5322.DateTime(RFC_9110.Field.Value(unchecked: text)) else {
+                throw .invalidDate(text)
             }
-        }
-
-        public static var coder: Coder<ArraySlice<Byte>, [Byte]> { .init() }
-
-        public enum Error: Swift::Error, Equatable {
 
-            case empty
+            return RFC_9110.Cache.Expires(date: date)
+        }
 
-            case invalidDate(String)
+        public borrowing func serialize(
+            _ output: RFC_9110.Cache.Expires,
+            into buffer: inout Buffer
+        ) throws(Failure) {
+            buffer.append(
+                contentsOf: Scanning.bytes(
+                    RFC_9110.Field(dateTime: output.date).value.rawValue
+                )
+            )
         }
-    }
+}
 #endif
