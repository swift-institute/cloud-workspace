 .../HTTP.Cache.Expires.Coder.swift            | 63 ++++++++++---------
 1 file changed, 32 insertions(+), 31 deletions(-)

diff --git a/Sources/RFC 9111/Absorbed swift-rfc-9111-coder/HTTP.Cache.Expires.Coder.swift b/Sources/RFC 9111/Absorbed swift-rfc-9111-coder/HTTP.Cache.Expires.Coder.swift
