From c8af2c1ace197519c1b8e2eaefc0b3256af6d82b Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 20:52:53 +0000
Subject: [PATCH 02/14] extension file naming: member-only and
 standard-library-conformance extension files merge into their type's own file
 (overnight/merge-extension-files.py); single type per file: additional types
 move to their own <Parent>.<Name>.swift inside the container's extension
 (overnight/split-types.py); parse-checked; builds pending (coenttb/work#242)

---
 .../RFC 9111/HTTP.Cache.ReuseConditions.swift  | 18 ------------------
 Sources/RFC 9111/HTTP.Cache.swift              |  2 --
 ...C_9110.Cache.ReuseConditions.Decision.swift | 13 +++++++++++++
 ...RFC_9110.Cache.ReuseConditions.Reason.swift | 15 +++++++++++++++
 Sources/RFC 9111/RFC_9110.Cache.Storage.swift  |  6 ++++++
 5 files changed, 34 insertions(+), 20 deletions(-)
 create mode 100644 Sources/RFC 9111/RFC_9110.Cache.ReuseConditions.Decision.swift
 create mode 100644 Sources/RFC 9111/RFC_9110.Cache.ReuseConditions.Reason.swift
 create mode 100644 Sources/RFC 9111/RFC_9110.Cache.Storage.swift

diff --git a/Sources/RFC 9111/HTTP.Cache.ReuseConditions.swift b/Sources/RFC 9111/HTTP.Cache.ReuseConditions.swift
index c6ec065..8353bf9 100644
--- a/Sources/RFC 9111/HTTP.Cache.ReuseConditions.swift	
+++ b/Sources/RFC 9111/HTTP.Cache.ReuseConditions.swift	
@@ -75,25 +75,7 @@ extension RFC_9110.Cache.ReuseConditions {
         return .mustValidate(reason: .staleWithoutPermission)
     }
 
-    public enum Decision: Sendable, Equatable {
 
-        case canReuse(fresh: Bool)
-
-        case canReuseStaleWhileRevalidating
-
-        case mustValidate(reason: Reason)
-    }
-
-    public enum Reason: Sendable, Equatable {
-        case requestNoCacheDirective
-        case responseNoCacheDirective
-        case exceedsRequestMaxAge
-        case insufficientRemainingFreshness
-        case mustRevalidateDirective
-        case proxyRevalidateDirective
-        case exceedsMaxStale
-        case staleWithoutPermission
-    }
 }
 
 extension RFC_9110.Cache.ReuseConditions.Decision {
diff --git a/Sources/RFC 9111/HTTP.Cache.swift b/Sources/RFC 9111/HTTP.Cache.swift
index ab14572..a63d132 100644
--- a/Sources/RFC 9111/HTTP.Cache.swift	
+++ b/Sources/RFC 9111/HTTP.Cache.swift	
@@ -6,6 +6,4 @@ extension RFC_9110 {
 }
 
 extension RFC_9110.Cache {
-
-    public enum Storage {}
 }
diff --git a/Sources/RFC 9111/RFC_9110.Cache.ReuseConditions.Decision.swift b/Sources/RFC 9111/RFC_9110.Cache.ReuseConditions.Decision.swift
new file mode 100644
index 0000000..34214f8
--- /dev/null
+++ b/Sources/RFC 9111/RFC_9110.Cache.ReuseConditions.Decision.swift	
@@ -0,0 +1,13 @@
+public import RFC_9110
+
+
+extension RFC_9110.Cache.ReuseConditions {
+    public enum Decision: Sendable, Equatable {
+
+        case canReuse(fresh: Bool)
+
+        case canReuseStaleWhileRevalidating
+
+        case mustValidate(reason: Reason)
+    }
+}
diff --git a/Sources/RFC 9111/RFC_9110.Cache.ReuseConditions.Reason.swift b/Sources/RFC 9111/RFC_9110.Cache.ReuseConditions.Reason.swift
new file mode 100644
index 0000000..3e0a200
--- /dev/null
+++ b/Sources/RFC 9111/RFC_9110.Cache.ReuseConditions.Reason.swift	
@@ -0,0 +1,15 @@
+public import RFC_9110
+
+
+extension RFC_9110.Cache.ReuseConditions {
+    public enum Reason: Sendable, Equatable {
+        case requestNoCacheDirective
+        case responseNoCacheDirective
+        case exceedsRequestMaxAge
+        case insufficientRemainingFreshness
+        case mustRevalidateDirective
+        case proxyRevalidateDirective
+        case exceedsMaxStale
+        case staleWithoutPermission
+    }
+}
diff --git a/Sources/RFC 9111/RFC_9110.Cache.Storage.swift b/Sources/RFC 9111/RFC_9110.Cache.Storage.swift
new file mode 100644
index 0000000..f7580c1
--- /dev/null
+++ b/Sources/RFC 9111/RFC_9110.Cache.Storage.swift	
@@ -0,0 +1,6 @@
+public import RFC_9110
+
+
+extension RFC_9110.Cache {
+    public enum Storage {}
+}
