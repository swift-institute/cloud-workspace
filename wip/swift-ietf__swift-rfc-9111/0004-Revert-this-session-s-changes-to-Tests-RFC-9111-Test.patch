From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 22:14:05 +0000
Subject: [PATCH 4/6] Revert this session's changes to Tests/RFC 9111 Tests:
 they raised a rule over its ratchet limit (coenttb/work#242)

---
 ...P.Cache Delta Seconds Overflow Tests.swift | 46 +++++++++----------
 1 file changed, 21 insertions(+), 25 deletions(-)

diff --git a/Tests/RFC 9111 Tests/HTTP.Cache Delta Seconds Overflow Tests.swift b/Tests/RFC 9111 Tests/HTTP.Cache Delta Seconds Overflow Tests.swift
index 683fc1e..b90cdc8 100644
--- a/Tests/RFC 9111 Tests/HTTP.Cache Delta Seconds Overflow Tests.swift	
+++ b/Tests/RFC 9111 Tests/HTTP.Cache Delta Seconds Overflow Tests.swift	
@@ -6,32 +6,28 @@
     import RFC_9111
     import Testing
 
-enum `HTTP.Cache Delta Seconds Overflow Tests` {}
-
-extension `HTTP.Cache Delta Seconds Overflow Tests` {
-        @Suite
-        struct `Delta seconds overflow` {
-            @Test
-            func `an age too large to represent is read as two to the thirty-first`() throws {
-                var input = [Byte](utf8: "99999999999999999999")[...]
-                #expect(try HTTP.Cache.Age.coder.parse(&input) == HTTP.Cache.Age(seconds: 2_147_483_648))
-            }
+    @Suite
+    struct `Delta seconds overflow` {
+        @Test
+        func `an age too large to represent is read as two to the thirty-first`() throws {
+            var input = [Byte](utf8: "99999999999999999999")[...]
+            #expect(try HTTP.Cache.Age.coder.parse(&input) == HTTP.Cache.Age(seconds: 2_147_483_648))
+        }
 
-            @Test
-            func `a max-age too large to represent is read as two to the thirty-first`() throws {
-                var input = [Byte](utf8: "max-age=99999999999999999999, s-maxage=99999999999999999999")[...]
-                let control = HTTP.Cache.Control.coder.parse(&input)
-                #expect(control.maxAge == 2_147_483_648)
-                #expect(control.sMaxage == 2_147_483_648)
-            }
+        @Test
+        func `a max-age too large to represent is read as two to the thirty-first`() throws {
+            var input = [Byte](utf8: "max-age=99999999999999999999, s-maxage=99999999999999999999")[...]
+            let control = HTTP.Cache.Control.coder.parse(&input)
+            #expect(control.maxAge == 2_147_483_648)
+            #expect(control.sMaxage == 2_147_483_648)
+        }
 
-            @Test
-            func `a signed delta-seconds value is ignored`() throws {
-                var input = [Byte](utf8: "max-age=-5, min-fresh=+5")[...]
-                let control = HTTP.Cache.Control.coder.parse(&input)
-                #expect(control.maxAge == nil)
-                #expect(control.minFresh == nil)
-            }
+        @Test
+        func `a signed delta-seconds value is ignored`() throws {
+            var input = [Byte](utf8: "max-age=-5, min-fresh=+5")[...]
+            let control = HTTP.Cache.Control.coder.parse(&input)
+            #expect(control.maxAge == nil)
+            #expect(control.minFresh == nil)
         }
-}
+    }
 #endif
