From fb570c0ab85ee0f2174a68ff3b98dcd63952a3a6 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 19:34:26 +0000
Subject: [PATCH] compound suite name: narrative suites move into the test
 module's namespace `<File> Tests` (#239's layout), nested suites into
 extension <Path>.<Parent> (overnight/compound-suites.py); parse-checked;
 builds pending (coenttb/work#242)

---
 .../Windows.Kernel.File.Seek Tests.swift      | 20 +++++++++++--------
 1 file changed, 12 insertions(+), 8 deletions(-)

diff --git a/Tests/Windows Kernel File Tests/Windows.Kernel.File.Seek Tests.swift b/Tests/Windows Kernel File Tests/Windows.Kernel.File.Seek Tests.swift
index e1ed16c..4b0cb4d 100644
--- a/Tests/Windows Kernel File Tests/Windows.Kernel.File.Seek Tests.swift	
+++ b/Tests/Windows Kernel File Tests/Windows.Kernel.File.Seek Tests.swift	
@@ -3,14 +3,18 @@
     import Windows_32_Kernel_File
     import Windows_Kernel_File
 
-    @Suite struct `Windows Kernel File Tests` {
-        @Test func `Seek has its L2 owner type`() {
-            func assertOwner<T>(_ facade: T.Type, _ owner: T.Type) {}
+enum `Windows.Kernel.File.Seek Tests` {}
 
-            assertOwner(
-                Windows.Kernel.File.Seek.self,
-                Windows.`32`.Kernel.File.Seek.self
-            )
+extension `Windows.Kernel.File.Seek Tests` {
+        @Suite struct `Windows Kernel File Tests` {
+            @Test func `Seek has its L2 owner type`() {
+                func assertOwner<T>(_ facade: T.Type, _ owner: T.Type) {}
+
+                assertOwner(
+                    Windows.Kernel.File.Seek.self,
+                    Windows.`32`.Kernel.File.Seek.self
+                )
+            }
         }
-    }
+}
 #endif
