diff --git a/Sources/Windows Kernel Socket/Windows.Kernel.Socket.Accept.swift b/Sources/Windows Kernel Socket/Windows.Kernel.Socket.Accept.swift
new file mode 100644
index 0000000..4001c3e
--- /dev/null
+++ b/Sources/Windows Kernel Socket/Windows.Kernel.Socket.Accept.swift	
@@ -0,0 +1,12 @@
+#if os(Windows)
+    public import Windows_Kernel
+
+    extension Windows.Kernel.Socket {
+
+        public static func accept(
+            _ socket: borrowing Descriptor
+        ) throws(Error) -> Descriptor {
+            try Windows.`32`.Kernel.Socket.accept(socket)
+        }
+    }
+#endif
