diff --git a/Sources/Windows Kernel Thread/Windows.Kernel.Thread.sleep.swift b/Sources/Windows Kernel Thread/Windows.Kernel.Thread.sleep.swift
new file mode 100644
index 0000000..e4e2f0a
--- /dev/null
+++ b/Sources/Windows Kernel Thread/Windows.Kernel.Thread.sleep.swift	
@@ -0,0 +1,14 @@
+#if os(Windows)
+    public import Windows_Kernel
+    public import Windows_32_Kernel
+
+    extension Windows.Kernel.Thread {
+
+        /// Suspends the calling thread for the duration, rounded down to milliseconds.
+        @inlinable
+        public static func sleep(_ duration: Duration) {
+            Windows.`32`.Kernel.Thread.sleep(duration)
+        }
+    }
+
+#endif
