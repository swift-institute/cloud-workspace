From ca7e188573d9f54e8f8ee4fa330f6c95465b92e0 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 21:32:55 +0000
Subject: [PATCH 3/4] Revert the extension-file merges and type splits in
 directories the type-check can't verify (C shims, macros); institute's
 generated Ratchet+limits.swift stays its own file (coenttb/work#242)

---
 .../Windows.Kernel.Close.Error+code.swift     | 21 +++++++++++++++++++
 .../Windows.Kernel.Close.Error.swift          | 20 ------------------
 2 files changed, 21 insertions(+), 20 deletions(-)
 create mode 100644 Sources/Windows Kernel Descriptor/Windows.Kernel.Close.Error+code.swift

diff --git a/Sources/Windows Kernel Descriptor/Windows.Kernel.Close.Error+code.swift b/Sources/Windows Kernel Descriptor/Windows.Kernel.Close.Error+code.swift
new file mode 100644
index 0000000..58c552b
--- /dev/null
+++ b/Sources/Windows Kernel Descriptor/Windows.Kernel.Close.Error+code.swift	
@@ -0,0 +1,21 @@
+import Error
+import Windows_32_Kernel
+
+#if os(Windows)
+
+    extension Windows.Kernel.Close.Error {
+
+        @inlinable
+        public init(code: Error::Error.Code) {
+            if let e = Windows.`32`.Kernel.Descriptor.Validity.Error(code: code) {
+                self = .handle(e)
+                return
+            }
+            if let e = Windows.`32`.Kernel.IO.Error(code: code) {
+                self = .io(e)
+                return
+            }
+            self = .platform(Error::Error(code: code))
+        }
+    }
+#endif
diff --git a/Sources/Windows Kernel Descriptor/Windows.Kernel.Close.Error.swift b/Sources/Windows Kernel Descriptor/Windows.Kernel.Close.Error.swift
index cd32992..0b8fe15 100644
--- a/Sources/Windows Kernel Descriptor/Windows.Kernel.Close.Error.swift	
+++ b/Sources/Windows Kernel Descriptor/Windows.Kernel.Close.Error.swift	
@@ -1,5 +1,4 @@
 import Error
-import Windows_32_Kernel
 
 #if os(Windows)
 
@@ -33,22 +32,3 @@ import Windows_32_Kernel
     }
 
 #endif
-
-#if os(Windows)
-
-    extension Windows.Kernel.Close.Error {
-
-        @inlinable
-        public init(code: Error::Error.Code) {
-            if let e = Windows.`32`.Kernel.Descriptor.Validity.Error(code: code) {
-                self = .handle(e)
-                return
-            }
-            if let e = Windows.`32`.Kernel.IO.Error(code: code) {
-                self = .io(e)
-                return
-            }
-            self = .platform(Error::Error(code: code))
-        }
-    }
-#endif
