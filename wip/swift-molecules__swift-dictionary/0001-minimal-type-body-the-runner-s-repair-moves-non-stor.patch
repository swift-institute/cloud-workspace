From 7c260f1ff4976cb7db468cf9504ba9106e9c948a Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 18:24:15 +0000
Subject: [PATCH 1/3] minimal type body: the runner's repair moves non-stored
 members out of type bodies into extensions; repair applied; root and test
 builds not yet run (coenttb/work#242)

---
 Sources/Dictionary/Hash.Entry.swift | 13 ++++++++-----
 1 file changed, 8 insertions(+), 5 deletions(-)

diff --git a/Sources/Dictionary/Hash.Entry.swift b/Sources/Dictionary/Hash.Entry.swift
index 152fcce..97b3579 100644
--- a/Sources/Dictionary/Hash.Entry.swift
+++ b/Sources/Dictionary/Hash.Entry.swift
@@ -15,11 +15,6 @@ extension Hash {
             self.key = key
             self.value = value
         }
-
-        @inlinable
-        public consuming func take() -> Value {
-            value
-        }
     }
 }
 
@@ -39,3 +34,11 @@ extension Hash.Entry: Swift::Hashable where Key: ~Copyable, Value: ~Copyable {
         lhs.key == rhs.key
     }
 }
+
+extension Hash.Entry where Key: ~Copyable, Value: ~Copyable {
+
+    @inlinable
+    public consuming func take() -> Value {
+        value
+    }
+}
