From 27d0104a3fadcf2186373bbfbbccf7ed83ab8155 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 20:52:47 +0000
Subject: [PATCH 2/2] extension file naming: member-only and
 standard-library-conformance extension files merge into their type's own file
 (overnight/merge-extension-files.py); single type per file: additional types
 move to their own <Parent>.<Name>.swift inside the container's extension
 (overnight/split-types.py); parse-checked; builds pending (coenttb/work#242)

---
 .../Rounding+Swift.FloatingPointRoundingRule.swift | 13 -------------
 Sources/Rounding/Rounding.swift                    | 14 ++++++++++++++
 2 files changed, 14 insertions(+), 13 deletions(-)
 delete mode 100644 Sources/Rounding/Rounding+Swift.FloatingPointRoundingRule.swift

diff --git a/Sources/Rounding/Rounding+Swift.FloatingPointRoundingRule.swift b/Sources/Rounding/Rounding+Swift.FloatingPointRoundingRule.swift
deleted file mode 100644
index 0536672..0000000
--- a/Sources/Rounding/Rounding+Swift.FloatingPointRoundingRule.swift
+++ /dev/null
@@ -1,13 +0,0 @@
-extension Rounding {
-    public init(_ rule: FloatingPointRoundingRule) {
-        switch rule {
-        case .down: self = .down
-        case .up: self = .up
-        case .towardZero: self = .zero
-        case .awayFromZero: self = .away
-        case .toNearestOrEven: self = .even
-        case .toNearestOrAwayFromZero: self = .nearest(.away)
-        @unknown default: self = .even
-        }
-    }
-}
diff --git a/Sources/Rounding/Rounding.swift b/Sources/Rounding/Rounding.swift
index 652597b..888bb69 100644
--- a/Sources/Rounding/Rounding.swift
+++ b/Sources/Rounding/Rounding.swift
@@ -63,3 +63,17 @@ extension Rounding {
 #if !hasFeature(Embedded)
     extension Rounding: Swift::Codable {}
 #endif
+
+extension Rounding {
+    public init(_ rule: FloatingPointRoundingRule) {
+        switch rule {
+        case .down: self = .down
+        case .up: self = .up
+        case .towardZero: self = .zero
+        case .awayFromZero: self = .away
+        case .toNearestOrEven: self = .even
+        case .toNearestOrAwayFromZero: self = .nearest(.away)
+        @unknown default: self = .even
+        }
+    }
+}
