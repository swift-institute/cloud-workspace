From e6d2cf84127d4f4d553a49a6dceb5ee7b99a0c02 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:35:32 +0000
Subject: [PATCH 4/7] statement where expression fits: single-value if/else
 chains written as if expressions (type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 Sources/JSON/String+JSON.swift | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/Sources/JSON/String+JSON.swift b/Sources/JSON/String+JSON.swift
index 662ac71..71c16ee 100644
--- a/Sources/JSON/String+JSON.swift
+++ b/Sources/JSON/String+JSON.swift
@@ -2,10 +2,10 @@ extension String {
 
     @inlinable
     public init(_ json: JSON) {
-        if case .string(let value) = json.raw {
-            self = value
+        self = if case .string(let value) = json.raw {
+            value
         } else {
-            self = ""
+            ""
         }
     }
 }
