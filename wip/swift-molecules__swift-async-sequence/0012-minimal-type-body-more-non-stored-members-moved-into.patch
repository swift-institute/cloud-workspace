diff --git a/Sources/Async Sequence/Async.FlatMap.Iterator.swift b/Sources/Async Sequence/Async.FlatMap.Iterator.swift
index 636282f..f52415a 100644
--- a/Sources/Async Sequence/Async.FlatMap.Iterator.swift	
+++ b/Sources/Async Sequence/Async.FlatMap.Iterator.swift	
@@ -1,6 +1,5 @@
 import _Concurrency
 
-
 extension Async.FlatMap {
     public struct Iterator: AsyncIteratorProtocol {
         @usableFromInline
@@ -21,44 +20,46 @@ extension Async.FlatMap {
             self.transform = transform
             self.currentIterator = nil
         }
+    }
+}
 
-        @inlinable
-        public mutating func next(
-
-            isolation actor: isolated (any Actor)? = #isolation
-        ) async -> Segment.Element? {
-            while true {
-                if var inner = currentIterator {
-                    let element: Segment.Element?
-                    do throws(Segment.Failure) {
-                        element = try await inner.next(isolation: actor)
-                    } catch {
-                        element = nil
-                    }
-                    if let element {
-                        currentIterator = inner
-                        return element
-                    }
-                    currentIterator = nil
-                }
+extension Async.FlatMap.Iterator {
+    @inlinable
+    public mutating func next(
 
-                let base: Base.Element?
-                do throws(Base.Failure) {
-                    base = try await baseIterator.next(isolation: actor)
+        isolation actor: isolated (any Actor)? = #isolation
+    ) async -> Segment.Element? {
+        while true {
+            if var inner = currentIterator {
+                let element: Segment.Element?
+                do throws(Segment.Failure) {
+                    element = try await inner.next(isolation: actor)
                 } catch {
-                    return nil
+                    element = nil
                 }
-                guard let base else {
-                    return nil
+                if let element {
+                    currentIterator = inner
+                    return element
                 }
+                currentIterator = nil
+            }
 
-                let segment: Segment
-                switch transform {
-                case .sync(let f): segment = f(base)
-                case .async(let f): segment = await f(base)
-                }
-                currentIterator = segment.makeAsyncIterator()
+            let base: Base.Element?
+            do throws(Base.Failure) {
+                base = try await baseIterator.next(isolation: actor)
+            } catch {
+                return nil
+            }
+            guard let base else {
+                return nil
+            }
+
+            let segment: Segment
+            switch transform {
+            case .sync(let f): segment = f(base)
+            case .async(let f): segment = await f(base)
             }
+            currentIterator = segment.makeAsyncIterator()
         }
     }
 }
