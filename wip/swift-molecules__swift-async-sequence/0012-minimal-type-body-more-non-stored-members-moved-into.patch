From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:17:15 +0000
Subject: [PATCH 12/17] minimal type body: more non-stored members moved into
 an extension of their type (batch 18; type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 .../Async.CompactMap.Iterator.swift           | 43 ++++++------
 .../Async.Filter.Iterator.swift               | 43 ++++++------
 .../Async.FlatMap.Iterator.swift              | 65 ++++++++++---------
 .../Async Sequence/Async.Map.Iterator.swift   | 37 ++++++-----
 4 files changed, 96 insertions(+), 92 deletions(-)

diff --git a/Sources/Async Sequence/Async.CompactMap.Iterator.swift b/Sources/Async Sequence/Async.CompactMap.Iterator.swift
index 8feaa6b..7188482 100644
--- a/Sources/Async Sequence/Async.CompactMap.Iterator.swift	
+++ b/Sources/Async Sequence/Async.CompactMap.Iterator.swift	
@@ -1,6 +1,5 @@
 import _Concurrency
 
-
 extension Async.CompactMap {
     public struct Iterator: AsyncIteratorProtocol {
         @usableFromInline
@@ -17,28 +16,30 @@ extension Async.CompactMap {
             self.baseIterator = baseIterator
             self.transform = transform
         }
+    }
+}
 
-        @inlinable
-        public mutating func next(
+extension Async.CompactMap.Iterator {
+    @inlinable
+    public mutating func next(
 
-            isolation actor: isolated (any Actor)? = #isolation
-        ) async -> Output? {
-            while true {
-                let element: Base.Element?
-                do throws(Base.Failure) {
-                    element = try await baseIterator.next(isolation: actor)
-                } catch {
-                    return nil
-                }
-                guard let element else { return nil }
-                let result: Output?
-                switch transform {
-                case .sync(let f): result = f(element)
-                case .async(let f): result = await f(element)
-                }
-                if let output = result {
-                    return output
-                }
+        isolation actor: isolated (any Actor)? = #isolation
+    ) async -> Output? {
+        while true {
+            let element: Base.Element?
+            do throws(Base.Failure) {
+                element = try await baseIterator.next(isolation: actor)
+            } catch {
+                return nil
+            }
+            guard let element else { return nil }
+            let result: Output?
+            switch transform {
+            case .sync(let f): result = f(element)
+            case .async(let f): result = await f(element)
+            }
+            if let output = result {
+                return output
             }
         }
     }
diff --git a/Sources/Async Sequence/Async.Filter.Iterator.swift b/Sources/Async Sequence/Async.Filter.Iterator.swift
