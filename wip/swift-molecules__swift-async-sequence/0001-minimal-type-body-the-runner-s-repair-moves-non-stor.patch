 3 files changed, 30 insertions(+), 21 deletions(-)

diff --git a/Sources/Async Sequence/Async.CompactMap.swift b/Sources/Async Sequence/Async.CompactMap.swift
index 62498cf..aa2ab81 100644
--- a/Sources/Async Sequence/Async.CompactMap.swift	
+++ b/Sources/Async Sequence/Async.CompactMap.swift	
@@ -3,7 +3,6 @@ import _Concurrency
 extension Async {
 
     public struct CompactMap<Base: AsyncSequence, Output>: AsyncSequence {
-        public typealias Element = Output
 
         @usableFromInline
         let base: Base
@@ -11,12 +10,6 @@ extension Async {
         @usableFromInline
         let transform: Transform
 
-        @usableFromInline
-        enum Transform {
-            case sync((Base.Element) -> Output?)
-            case async((Base.Element) async -> Output?)
-        }
-
         @usableFromInline
         init(base: Base, transform: Transform) {
             self.base = base
@@ -73,3 +66,13 @@ extension Async.CompactMap {
         Iterator(baseIterator: base.makeAsyncIterator(), transform: transform)
     }
 }
+
+extension Async.CompactMap {
+    public typealias Element = Output
+
+    @usableFromInline
+    enum Transform {
+        case sync((Base.Element) -> Output?)
+        case async((Base.Element) async -> Output?)
+    }
+}
