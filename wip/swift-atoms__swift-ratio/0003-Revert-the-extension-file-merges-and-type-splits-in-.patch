Date: Sat, 7 Nov 2026 21:46:01 +0000
Subject: [PATCH 3/7] Revert the extension-file merges and type splits in
 directories where a merged file brought its conditional imports mid-file
 (coenttb/work#242)

---
 Sources/Ratio/Ordinal/Ordinal+Ratio.swift     | 35 +++++++++++++++
 .../Ratio+Swift.CustomStringConvertible.swift | 11 +++++
 ...io+Swift.ExpressibleByIntegerLiteral.swift | 12 +++++
 Sources/Ratio/Ratio.swift                     | 45 -------------------
 4 files changed, 58 insertions(+), 45 deletions(-)
 create mode 100644 Sources/Ratio/Ordinal/Ordinal+Ratio.swift
 create mode 100644 Sources/Ratio/Ratio+Swift.CustomStringConvertible.swift
 create mode 100644 Sources/Ratio/Ratio+Swift.ExpressibleByIntegerLiteral.swift

diff --git a/Sources/Ratio/Ordinal/Ordinal+Ratio.swift b/Sources/Ratio/Ordinal/Ordinal+Ratio.swift
new file mode 100644
index 0000000..52cba7a
--- /dev/null
+++ b/Sources/Ratio/Ordinal/Ordinal+Ratio.swift
@@ -0,0 +1,35 @@
+#if Ordinal
+    @_exported public import Cardinal
+    @_exported public import Carrier
+    @_exported public import Difference
+    import Magnitude
+    @_exported public import Ordinal
+    @_exported public import Tagged
+
+    extension Ratio where From: ~Copyable & ~Escapable, To: ~Copyable & ~Escapable {
+
+        public func applying<Input: Carrier.`Protocol`>(
+            to index: Input
+        ) throws(Error) -> Tagged<To, Ordinal>
+        where Input.Domain == From, Input.Underlying == Ordinal {
+            let count = Tagged<From, Cardinal>(_unchecked: Cardinal(index.underlying.rawValue))
+            let converted = try applying(to: count)
+            return Tagged<To, Ordinal>(_unchecked: Ordinal(converted.underlying.rawValue))
+        }
+
+        public func quotientAndRemainder(
+            dividing index: Tagged<To, Ordinal>
+        ) throws(Error) -> (
+            quotient: Tagged<From, Ordinal>, remainder: Tagged<To, Difference>
+        ) {
+            let count = Tagged<To, Cardinal>(_unchecked: Cardinal(index.underlying.rawValue))
+            let result = try quotientAndRemainder(dividing: count)
+            return (
+                Tagged<From, Ordinal>(_unchecked: Ordinal(result.quotient.underlying.rawValue)),
+                Tagged<To, Difference>(
+                    _unchecked: .positive(Difference.Magnitude(result.remainder.underlying))
+                )
+            )
+        }
+    }
+#endif
diff --git a/Sources/Ratio/Ratio+Swift.CustomStringConvertible.swift b/Sources/Ratio/Ratio+Swift.CustomStringConvertible.swift
new file mode 100644
index 0000000..2701794
--- /dev/null
+++ b/Sources/Ratio/Ratio+Swift.CustomStringConvertible.swift
@@ -0,0 +1,11 @@
+@_exported public import Cardinal
+@_exported public import Carrier
+import Magnitude
+@_exported public import Polarity
+@_exported public import Property
+import Rational
+@_exported public import Tagged
+
+extension Ratio: Swift::CustomStringConvertible {
+    public var description: String { "Ratio<\(From.self), \(To.self)>(\(value))" }
+}
diff --git a/Sources/Ratio/Ratio+Swift.ExpressibleByIntegerLiteral.swift b/Sources/Ratio/Ratio+Swift.ExpressibleByIntegerLiteral.swift
new file mode 100644
index 0000000..a1e6d3d
--- /dev/null
+++ b/Sources/Ratio/Ratio+Swift.ExpressibleByIntegerLiteral.swift
@@ -0,0 +1,12 @@
+@_exported public import Cardinal
+@_exported public import Carrier
+import Magnitude
+@_exported public import Polarity
+@_exported public import Property
+import Rational
+@_exported public import Tagged
+
+extension Ratio: Swift::ExpressibleByIntegerLiteral where From == To {
+    @_disfavoredOverload
+    public init(integerLiteral value: Int) { self.init(value) }
+}
