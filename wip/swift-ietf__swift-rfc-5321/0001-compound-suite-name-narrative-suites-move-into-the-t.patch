From 8f0ac70e4b4515daf6fd64810974d3a2ccf4f8cb Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 19:34:16 +0000
Subject: [PATCH] compound suite name: narrative suites move into the test
 module's namespace `<File> Tests` (#239's layout), nested suites into
 extension <Path>.<Parent> (overnight/compound-suites.py); parse-checked;
 builds pending (coenttb/work#242)

---
 .../SMTP Length Boundary Tests.swift          | 46 ++++++++++---------
 1 file changed, 25 insertions(+), 21 deletions(-)

diff --git a/Tests/RFC 5321 Tests/SMTP Length Boundary Tests.swift b/Tests/RFC 5321 Tests/SMTP Length Boundary Tests.swift
index 7093760..a01b9e4 100644
--- a/Tests/RFC 5321 Tests/SMTP Length Boundary Tests.swift	
+++ b/Tests/RFC 5321 Tests/SMTP Length Boundary Tests.swift	
@@ -1,29 +1,33 @@
 import RFC_5321
 import Testing
 
-@Suite
-struct `SMTP address length boundaries` {
-    @Test
-    func `a 64-byte local part is accepted`() throws {
-        _ = try RFC_5321.EmailAddress.LocalPart(String(repeating: "a", count: 64))
-    }
+enum `SMTP Length Boundary Tests` {}
 
-    @Test
-    func `a local part with a trailing dot is refused`() {
-        #expect(throws: RFC_5321.EmailAddress.LocalPart.Error.self) {
-            try RFC_5321.EmailAddress.LocalPart("user.")
+extension `SMTP Length Boundary Tests` {
+    @Suite
+    struct `SMTP address length boundaries` {
+        @Test
+        func `a 64-byte local part is accepted`() throws {
+            _ = try RFC_5321.EmailAddress.LocalPart(String(repeating: "a", count: 64))
         }
-    }
 
-    @Test
-    func `a 254-byte address is accepted and a 255-byte address is refused`() throws {
-        let local = String(repeating: "a", count: 64)
-        let label = String(repeating: "b", count: 63)
-        let fits = "\(local)@\(label).\(label).\(String(repeating: "c", count: 61))"
-        let over = "\(local)@\(label).\(label).\(String(repeating: "c", count: 62))"
-        #expect(fits.utf8.count == 254)
-        #expect(over.utf8.count == 255)
-        _ = try RFC_5321.EmailAddress(fits)
-        #expect(throws: RFC_5321.EmailAddress.Error.self) { try RFC_5321.EmailAddress(over) }
+        @Test
+        func `a local part with a trailing dot is refused`() {
+            #expect(throws: RFC_5321.EmailAddress.LocalPart.Error.self) {
+                try RFC_5321.EmailAddress.LocalPart("user.")
+            }
+        }
+
+        @Test
+        func `a 254-byte address is accepted and a 255-byte address is refused`() throws {
+            let local = String(repeating: "a", count: 64)
+            let label = String(repeating: "b", count: 63)
+            let fits = "\(local)@\(label).\(label).\(String(repeating: "c", count: 61))"
+            let over = "\(local)@\(label).\(label).\(String(repeating: "c", count: 62))"
+            #expect(fits.utf8.count == 254)
+            #expect(over.utf8.count == 255)
+            _ = try RFC_5321.EmailAddress(fits)
+            #expect(throws: RFC_5321.EmailAddress.Error.self) { try RFC_5321.EmailAddress(over) }
+        }
     }
 }
