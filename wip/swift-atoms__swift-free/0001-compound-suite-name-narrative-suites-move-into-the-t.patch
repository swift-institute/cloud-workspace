From 4f803291f4858cda0b787b69a86dc48037a8b07f Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 19:34:01 +0000
Subject: [PATCH] compound suite name: narrative suites move into the test
 module's namespace `<File> Tests` (#239's layout), nested suites into
 extension <Path>.<Parent> (overnight/compound-suites.py); parse-checked;
 builds pending (coenttb/work#242)

---
 Tests/Free Macro Tests/Boundary Tests.swift | 52 +++++++++++----------
 1 file changed, 28 insertions(+), 24 deletions(-)

diff --git a/Tests/Free Macro Tests/Boundary Tests.swift b/Tests/Free Macro Tests/Boundary Tests.swift
index ba984ad..be3829d 100644
--- a/Tests/Free Macro Tests/Boundary Tests.swift	
+++ b/Tests/Free Macro Tests/Boundary Tests.swift	
@@ -21,33 +21,37 @@ private func evaluate(_ value: Count.Free<Int>) -> Int {
     )
 }
 
-@Suite
-struct `Free boundaries` {
-    @Test
-    func `a pure value folds through the pure interpretation`() {
-        #expect(evaluate(.pure(42)) == 42)
-    }
+enum `Boundary Tests` {}
 
-    @Test
-    func `a suspended base case folds without a value`() {
-        #expect(evaluate(.suspend(.zero)) == 0)
-    }
+extension `Boundary Tests` {
+    @Suite
+    struct `Free boundaries` {
+        @Test
+        func `a pure value folds through the pure interpretation`() {
+            #expect(evaluate(.pure(42)) == 42)
+        }
 
-    @Test
-    func `flatMap on a pure value applies the transform`() {
-        let transform: (Int) -> Count.Free<Int> = { .suspend(.successor(.pure($0 * 2))) }
-        #expect(evaluate(Count.Free<Int>.pure(5).flatMap(transform)) == evaluate(transform(5)))
-    }
+        @Test
+        func `a suspended base case folds without a value`() {
+            #expect(evaluate(.suspend(.zero)) == 0)
+        }
 
-    @Test
-    func `map reaches values under suspended layers`() {
-        let value = Count.Free<Int>.suspend(.successor(.suspend(.successor(.pure(1)))))
-        #expect(evaluate(value.map { $0 + 10 }) == 13)
-    }
+        @Test
+        func `flatMap on a pure value applies the transform`() {
+            let transform: (Int) -> Count.Free<Int> = { .suspend(.successor(.pure($0 * 2))) }
+            #expect(evaluate(Count.Free<Int>.pure(5).flatMap(transform)) == evaluate(transform(5)))
+        }
 
-    @Test
-    func `joined flattens nested carriers`() {
-        let nested = Count.Free<Count.Free<Int>>.suspend(.successor(.pure(.suspend(.successor(.pure(3))))))
-        #expect(evaluate(nested.joined()) == 5)
+        @Test
+        func `map reaches values under suspended layers`() {
+            let value = Count.Free<Int>.suspend(.successor(.suspend(.successor(.pure(1)))))
+            #expect(evaluate(value.map { $0 + 10 }) == 13)
+        }
+
+        @Test
+        func `joined flattens nested carriers`() {
+            let nested = Count.Free<Count.Free<Int>>.suspend(.successor(.pure(.suspend(.successor(.pure(3))))))
+            #expect(evaluate(nested.joined()) == 5)
+        }
     }
 }
