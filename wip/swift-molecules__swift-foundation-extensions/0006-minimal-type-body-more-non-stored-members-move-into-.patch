---
 .../Foundation.FormatStyle.swift                              | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/Sources/FoundationEssentials Extensions/Foundation.FormatStyle.swift b/Sources/FoundationEssentials Extensions/Foundation.FormatStyle.swift
index 74d265c..4ee0536 100644
--- a/Sources/FoundationEssentials Extensions/Foundation.FormatStyle.swift	
+++ b/Sources/FoundationEssentials Extensions/Foundation.FormatStyle.swift	
@@ -1,16 +1,16 @@
 public import Foundation
 
 extension FormatStyle where Self == StringDateFormat {
-
     public static func dateFormat(_ dateFormat: String) -> Self {
         StringDateFormat(dateFormat: dateFormat)
     }
 }
 
 public struct StringDateFormat: FormatStyle {
-
     let dateFormat: String
+}
 
+extension StringDateFormat {
     public func format(_ value: Date) -> String {
         let formatter = DateFormatter()
         formatter.dateFormat = dateFormat
