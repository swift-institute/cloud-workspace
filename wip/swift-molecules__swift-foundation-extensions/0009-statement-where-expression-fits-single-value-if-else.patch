From c641925739d7936999204000644187b23de50de9 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:35:29 +0000
Subject: [PATCH 09/11] statement where expression fits: single-value if/else
 chains written as if expressions (type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 .../Foundation.Date.swift                            |  8 ++++----
 .../Foundation.TimeInterval.swift                    | 12 ++++++------
 2 files changed, 10 insertions(+), 10 deletions(-)

diff --git a/Sources/FoundationEssentials Extensions/Foundation.Date.swift b/Sources/FoundationEssentials Extensions/Foundation.Date.swift
index 44b1e7a..840d8de 100644
--- a/Sources/FoundationEssentials Extensions/Foundation.Date.swift	
+++ b/Sources/FoundationEssentials Extensions/Foundation.Date.swift	
@@ -357,12 +357,12 @@ extension Date {
     public func relativeFormatted(in calendar: Calendar, now: Date = Date()) -> String {
 
         if self.isToday(in: calendar) {
-            if abs(self.timeIntervalSince(now)) < 60 {
-                return "now"
+            return if abs(self.timeIntervalSince(now)) < 60 {
+                "now"
             } else if self < now {
-                return self.timeAgoSince(now, in: calendar)
+                self.timeAgoSince(now, in: calendar)
             } else {
-                return self.timeUntil(now, in: calendar)
+                self.timeUntil(now, in: calendar)
             }
         } else if self.isYesterday(in: calendar) {
             return "yesterday"
diff --git a/Sources/FoundationEssentials Extensions/Foundation.TimeInterval.swift b/Sources/FoundationEssentials Extensions/Foundation.TimeInterval.swift
index 3500416..1e274ae 100644
--- a/Sources/FoundationEssentials Extensions/Foundation.TimeInterval.swift	
+++ b/Sources/FoundationEssentials Extensions/Foundation.TimeInterval.swift	
@@ -27,16 +27,16 @@ extension Foundation.TimeInterval {
     public var asWeeks: Double { self / .week }
 
     public var formattedDuration: String {
-        if self.magnitude < .minute {
-            return "\(Self.fixed(self, fractionDigits: 0))s"
+        return if self.magnitude < .minute {
+            "\(Self.fixed(self, fractionDigits: 0))s"
         } else if self.magnitude < .hour {
-            return "\(Self.fixed(self.asMinutes, fractionDigits: 0))m"
+            "\(Self.fixed(self.asMinutes, fractionDigits: 0))m"
         } else if self.magnitude < .day {
-            return "\(Self.fixed(self.asHours, fractionDigits: 1))h"
+            "\(Self.fixed(self.asHours, fractionDigits: 1))h"
         } else if self.magnitude < .week {
-            return "\(Self.fixed(self.asDays, fractionDigits: 1))d"
+            "\(Self.fixed(self.asDays, fractionDigits: 1))d"
         } else {
-            return "\(Self.fixed(self.asWeeks, fractionDigits: 1))w"
+            "\(Self.fixed(self.asWeeks, fractionDigits: 1))w"
         }
     }
 
