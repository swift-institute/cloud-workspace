From 0f9cd9691d5ec924da2e786c02860a9aba7ba961 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 19:34:20 +0000
Subject: [PATCH] compound suite name: narrative suites move into the test
 module's namespace `<File> Tests` (#239's layout), nested suites into
 extension <Path>.<Parent> (overnight/compound-suites.py); parse-checked;
 builds pending (coenttb/work#242)

---
 .../IPv4 Standard Tests.swift                  | 18 +++++++++++-------
 1 file changed, 11 insertions(+), 7 deletions(-)

diff --git a/Tests/IPv4 Standard Tests/IPv4 Standard Tests.swift b/Tests/IPv4 Standard Tests/IPv4 Standard Tests.swift
index 3027f09..56b65a9 100644
--- a/Tests/IPv4 Standard Tests/IPv4 Standard Tests.swift	
+++ b/Tests/IPv4 Standard Tests/IPv4 Standard Tests.swift	
@@ -2,13 +2,17 @@ import IPv4_Standard
 import RFC_791
 import Testing
 
-@Suite
-struct `IPv4 Standard` {
+enum `IPv4 Standard Tests` {}
 
-    @Test
-    func `IPv4 names the RFC 791 address family`() throws {
-        let address = try IPv4.Address("192.168.1.1")
-        #expect(address.rawValue == 0xC0A8_0101)
-        #expect(address.description == "192.168.1.1")
+extension `IPv4 Standard Tests` {
+    @Suite
+    struct `IPv4 Standard` {
+
+        @Test
+        func `IPv4 names the RFC 791 address family`() throws {
+            let address = try IPv4.Address("192.168.1.1")
+            #expect(address.rawValue == 0xC0A8_0101)
+            #expect(address.description == "192.168.1.1")
+        }
     }
 }
