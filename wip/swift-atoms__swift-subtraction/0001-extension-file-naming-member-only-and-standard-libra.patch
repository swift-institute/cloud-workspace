From 4e3d86ed4a1bed3cf56a0ab15d6b0c0d602f3b1e Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 20:52:48 +0000
Subject: [PATCH 1/3] extension file naming: member-only and
 standard-library-conformance extension files merge into their type's own file
 (overnight/merge-extension-files.py); single type per file: additional types
 move to their own <Parent>.<Name>.swift inside the container's extension
 (overnight/split-types.py); parse-checked; builds pending (coenttb/work#242)

---
 Sources/Subtraction/Subtraction.Error.swift  | 9 +++++++++
 Sources/Subtraction/Subtraction.Signed.swift | 7 +++++++
 Sources/Subtraction/Subtraction.swift        | 5 +----
 3 files changed, 17 insertions(+), 4 deletions(-)
 create mode 100644 Sources/Subtraction/Subtraction.Error.swift
 create mode 100644 Sources/Subtraction/Subtraction.Signed.swift

diff --git a/Sources/Subtraction/Subtraction.Error.swift b/Sources/Subtraction/Subtraction.Error.swift
new file mode 100644
index 0000000..5de2931
--- /dev/null
+++ b/Sources/Subtraction/Subtraction.Error.swift
@@ -0,0 +1,9 @@
+public import Addition
+public import Polarity
+
+
+extension Subtraction {
+    public enum Error: Swift::Error, Hashable, Sendable {
+        case overflow
+    }
+}
diff --git a/Sources/Subtraction/Subtraction.Signed.swift b/Sources/Subtraction/Subtraction.Signed.swift
new file mode 100644
index 0000000..005434d
--- /dev/null
+++ b/Sources/Subtraction/Subtraction.Signed.swift
@@ -0,0 +1,7 @@
+public import Addition
+public import Polarity
+
+
+extension Subtraction {
+    public enum Signed {}
+}
diff --git a/Sources/Subtraction/Subtraction.swift b/Sources/Subtraction/Subtraction.swift
index 1a483ed..a7826f5 100644
--- a/Sources/Subtraction/Subtraction.swift
+++ b/Sources/Subtraction/Subtraction.swift
@@ -4,9 +4,7 @@ public import Polarity
 public enum Subtraction {}
 
 extension Subtraction {
-    public enum Error: Swift::Error, Hashable, Sendable {
-        case overflow
-    }
+
 
     @inlinable
     public static func reporting<Value: FixedWidthInteger>(
@@ -37,7 +35,6 @@ extension Subtraction {
         return Value.isSigned && rhs < .zero ? .max : .min
     }
 
-    public enum Signed {}
 }
 
 extension Subtraction.Signed {
