From d0c0c4d25b6496e63cacf059fb9d88e2e61b9ac4 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 19:34:18 +0000
Subject: [PATCH 1/2] compound suite name: narrative suites move into the test
 module's namespace `<File> Tests` (#239's layout), nested suites into
 extension <Path>.<Parent> (overnight/compound-suites.py); parse-checked;
 builds pending (coenttb/work#242)

---
 Tests/ISO 3166 Tests/ASCII Input Tests.swift  | 30 ++++++++------
 .../Code Table Consistency Tests.swift        | 40 ++++++++++---------
 2 files changed, 39 insertions(+), 31 deletions(-)

diff --git a/Tests/ISO 3166 Tests/ASCII Input Tests.swift b/Tests/ISO 3166 Tests/ASCII Input Tests.swift
index 6b2df79..c653196 100644
--- a/Tests/ISO 3166 Tests/ASCII Input Tests.swift	
+++ b/Tests/ISO 3166 Tests/ASCII Input Tests.swift	
@@ -2,19 +2,23 @@ import Testing
 
 @testable import ISO_3166
 
-@Suite
-struct `ASCII input` {
-    @Test
-    func `a Kelvin sign that lowercases to k is refused`() {
-        #expect(throws: ISO_3166.Alpha2.Error.self) { try ISO_3166.Alpha2("S\u{212A}") }
-        #expect(throws: ISO_3166.Alpha3.Error.self) { try ISO_3166.Alpha3("SV\u{212A}") }
-        #expect(throws: ISO_3166.Error.self) { try ISO_3166.Code("\u{212A}R") }
-    }
+enum `ASCII Input Tests` {}
+
+extension `ASCII Input Tests` {
+    @Suite
+    struct `ASCII input` {
+        @Test
+        func `a Kelvin sign that lowercases to k is refused`() {
+            #expect(throws: ISO_3166.Alpha2.Error.self) { try ISO_3166.Alpha2("S\u{212A}") }
+            #expect(throws: ISO_3166.Alpha3.Error.self) { try ISO_3166.Alpha3("SV\u{212A}") }
+            #expect(throws: ISO_3166.Error.self) { try ISO_3166.Code("\u{212A}R") }
+        }
 
-    @Test
-    func `ASCII codes in any case still parse`() throws {
-        _ = try ISO_3166.Alpha2("sk")
-        _ = try ISO_3166.Alpha2("SK")
-        _ = try ISO_3166.Alpha3("svk")
+        @Test
+        func `ASCII codes in any case still parse`() throws {
+            _ = try ISO_3166.Alpha2("sk")
+            _ = try ISO_3166.Alpha2("SK")
+            _ = try ISO_3166.Alpha3("svk")
+        }
     }
 }
diff --git a/Tests/ISO 3166 Tests/Code Table Consistency Tests.swift b/Tests/ISO 3166 Tests/Code Table Consistency Tests.swift
index f5ce8d0..cfc8e39 100644
--- a/Tests/ISO 3166 Tests/Code Table Consistency Tests.swift	
+++ b/Tests/ISO 3166 Tests/Code Table Consistency Tests.swift	
@@ -2,28 +2,32 @@ import Testing
 
 @testable import ISO_3166
 
-@Suite
-struct `Code table consistency` {
-    @Test
-    func `every alpha-3 code converts to an alpha-2 code and back`() {
-        for alpha3 in ISO_3166.Alpha3.allCases {
-            #expect(ISO_3166.Alpha3(ISO_3166.Alpha2(alpha3)) == alpha3)
+enum `Code Table Consistency Tests` {}
+
+extension `Code Table Consistency Tests` {
+    @Suite
+    struct `Code table consistency` {
+        @Test
+        func `every alpha-3 code converts to an alpha-2 code and back`() {
+            for alpha3 in ISO_3166.Alpha3.allCases {
+                #expect(ISO_3166.Alpha3(ISO_3166.Alpha2(alpha3)) == alpha3)
+            }
         }
-    }
 
-    @Test
-    func `every numeric code converts to an alpha-2 code and back`() {
-        for numeric in ISO_3166.Numeric.allCases {
-            #expect(ISO_3166.Numeric(ISO_3166.Alpha2(numeric)) == numeric)
+        @Test
+        func `every numeric code converts to an alpha-2 code and back`() {
+            for numeric in ISO_3166.Numeric.allCases {
+                #expect(ISO_3166.Numeric(ISO_3166.Alpha2(numeric)) == numeric)
+            }
         }
-    }
 
-    @Test
-    func `every alpha-2 code converts to alpha-3 and numeric codes`() {
-        for alpha2 in ISO_3166.Alpha2.allCases {
-            #expect(ISO_3166.Alpha2(ISO_3166.Alpha3(alpha2)) == alpha2)
-            #expect(ISO_3166.Alpha2(ISO_3166.Numeric(alpha2)) == alpha2)
+        @Test
+        func `every alpha-2 code converts to alpha-3 and numeric codes`() {
+            for alpha2 in ISO_3166.Alpha2.allCases {
+                #expect(ISO_3166.Alpha2(ISO_3166.Alpha3(alpha2)) == alpha2)
+                #expect(ISO_3166.Alpha2(ISO_3166.Numeric(alpha2)) == alpha2)
+            }
         }
-    }
 
+    }
 }
