From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:34:04 +0000
Subject: [PATCH 25/29] counter loop iteration: range loops without early exit
 written as forEach (type-check follows; Linux x86_64, Swift 6.4.2)
 (coenttb/work#242)

---
 Tests/SQLite CloudKit Tests/SyncEngine.Mock Tests.swift | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Tests/SQLite CloudKit Tests/SyncEngine.Mock Tests.swift b/Tests/SQLite CloudKit Tests/SyncEngine.Mock Tests.swift
index 5f73f1c..cbbe54b 100644
--- a/Tests/SQLite CloudKit Tests/SyncEngine.Mock Tests.swift	
+++ b/Tests/SQLite CloudKit Tests/SyncEngine.Mock Tests.swift	
@@ -67,7 +67,7 @@
                 try await device.start()
                 try await other.start()
                 try await device.database.write { db in
-                    for index in 0..<450 { try Note.insert { Note(id: "n\(index)", body: "x") }.execute(db) }
+                    (0..<450 { try Note.insert).forEach { index in Note(id: "n\(index)", body: "x") }.execute(db) }
                 }
                 try await device.sync()
                 #expect(mock.records(in: device.engine.zone).count == 450)
