Date: Sun, 8 Nov 2026 07:06:22 +0000
Subject: [PATCH 57/58] Revert Sources/SQLite Macros Implementation to
 origin/main: macro targets aren't type-checkable outside the build
 (coenttb/work#242)

---
 .../DatabaseFunctionMacro.swift                  | 16 ++++++++--------
 .../IsolationCheckMacro.swift                    |  1 +
 .../MainActorIsolationCheckMacro.swift           |  5 -----
 .../SQLite Macros Implementation/Plugin.swift    |  2 +-
 4 files changed, 10 insertions(+), 14 deletions(-)
 delete mode 100644 Sources/SQLite Macros Implementation/MainActorIsolationCheckMacro.swift

diff --git a/Sources/SQLite Macros Implementation/DatabaseFunctionMacro.swift b/Sources/SQLite Macros Implementation/DatabaseFunctionMacro.swift
index 1390f4a..98aa47d 100644
--- a/Sources/SQLite Macros Implementation/DatabaseFunctionMacro.swift	
+++ b/Sources/SQLite Macros Implementation/DatabaseFunctionMacro.swift	
@@ -558,12 +558,12 @@ extension DatabaseFunctionMacro: PeerMacro {
                 representableInputTypes.count == 1
                 ? representableInputType
                 : "(\(representableInputType))"
-            projectedCallSyntax = if baseType != nil {
-                "\(functionTypeName)(self)"
+            if baseType != nil {
+                projectedCallSyntax = "\(functionTypeName)(self)"
             } else if isInstance {
-                "\(functionTypeName)(\(declaration.name.trimmed))"
+                projectedCallSyntax = "\(functionTypeName)(\(declaration.name.trimmed))"
             } else {
-                "\(functionTypeName)()"
+                projectedCallSyntax = "\(functionTypeName)()"
             }
         }
         let isVoidReturning = signature.returnClause == nil
@@ -698,12 +698,12 @@ extension DatabaseFunctionMacro: PeerMacro {
 
             let tryPrefix = functionOriginallyThrows ? "try " : ""
             let bodyInvocation: String
-            bodyInvocation = if baseType != nil {
-                "\(tryPrefix)base.\(declaration.name.trimmed)(\(aggregateLabel)arguments)"
+            if baseType != nil {
+                bodyInvocation = "\(tryPrefix)base.\(declaration.name.trimmed)(\(aggregateLabel)arguments)"
             } else if isInstance {
-                "\(tryPrefix)self.body(arguments)"
+                bodyInvocation = "\(tryPrefix)self.body(arguments)"
             } else {
-                "\(tryPrefix)\(thunkName)(arguments)"
+                bodyInvocation = "\(tryPrefix)\(thunkName)(arguments)"
             }
             var invocationBody =
                 isVoidReturning
