From 9e9066da44a57a0eed856ed10363959d3589d284 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:24:53 +0000
Subject: [PATCH 45/58] trait consistency: dependencies imported only under a
 trait get that trait's condition (runner repair; Linux x86_64, Swift 6.4.2)
 (coenttb/work#242)

---
 Package.swift | 66 +++++++++++++++++++++++++--------------------------
 1 file changed, 33 insertions(+), 33 deletions(-)

diff --git a/Package.swift b/Package.swift
index 675a6b5..6dcca44 100644
--- a/Package.swift
+++ b/Package.swift
@@ -68,15 +68,15 @@ let package = Package(
             name: "SQLite",
             dependencies: [
                 .target(name: "SQLite SQL"),
-                .product(name: "Path", package: "swift-path"),
-                .product(name: "SQL", package: "swift-sql"),
+                .product(name: "Path", package: "swift-path", condition: .when(traits: ["GRDB"])),
+                .product(name: "SQL", package: "swift-sql", condition: .when(traits: ["GRDB", "Observation"])),
                 .product(name: "SQL Macros", package: "swift-sql"),
-                .product(name: "ISO 9075 Foundation", package: "swift-iso-9075"),
-                .product(name: "ISO 9075 Call-Level Interface", package: "swift-iso-9075"),
-                .product(name: "Byte", package: "swift-byte"),
-                .product(name: "Order", package: "swift-order"),
-                .product(name: "Time", package: "swift-time"),
-                .product(name: "RFC 4122", package: "swift-rfc-4122"),
+                .product(name: "ISO 9075 Foundation", package: "swift-iso-9075", condition: .when(traits: ["GRDB", "Observation"])),
+                .product(name: "ISO 9075 Call-Level Interface", package: "swift-iso-9075", condition: .when(traits: ["GRDB", "Observation"])),
+                .product(name: "Byte", package: "swift-byte", condition: .when(traits: ["GRDB"])),
+                .product(name: "Order", package: "swift-order", condition: .when(traits: ["GRDB"])),
+                .product(name: "Time", package: "swift-time", condition: .when(traits: ["GRDB"])),
+                .product(name: "RFC 4122", package: "swift-rfc-4122", condition: .when(traits: ["GRDB"])),
                 .product(name: "GRDB", package: "GRDB.swift", condition: .when(traits: ["GRDB", "Observation", "CloudKit"])),
                 .product(
                     name: "OrderedCollections",
@@ -91,11 +91,11 @@ let package = Package(
             name: "SQLite CloudKit",
             dependencies: [
                 .target(name: "SQLite"),
-                .product(name: "SQL", package: "swift-sql"),
-                .product(name: "SQL Macros", package: "swift-sql"),
-                .product(name: "Byte", package: "swift-byte"),
-                .product(name: "Time", package: "swift-time"),
-                .product(name: "RFC 4122", package: "swift-rfc-4122"),
+                .product(name: "SQL", package: "swift-sql", condition: .when(traits: ["CloudKit"])),
+                .product(name: "SQL Macros", package: "swift-sql", condition: .when(traits: ["CloudKit"])),
+                .product(name: "Byte", package: "swift-byte", condition: .when(traits: ["CloudKit"])),
+                .product(name: "Time", package: "swift-time", condition: .when(traits: ["CloudKit"])),
+                .product(name: "RFC 4122", package: "swift-rfc-4122", condition: .when(traits: ["CloudKit"])),
                 .product(name: "GRDB", package: "GRDB.swift", condition: .when(traits: ["CloudKit"])),
                 .product(
                     name: "OrderedCollections",
@@ -119,31 +119,31 @@ let package = Package(
             name: "SQLite Test Support",
             dependencies: [
                 .target(name: "SQLite"),
-                .product(name: "SQL", package: "swift-sql"),
-                .product(name: "SQL Test Support", package: "swift-sql"),
+                .product(name: "SQL", package: "swift-sql", condition: .when(traits: ["GRDB"])),
+                .product(name: "SQL Test Support", package: "swift-sql", condition: .when(traits: ["GRDB"])),
                 .product(name: "SQL Foundation Integration", package: "swift-sql"),
-                .product(name: "ISO 9075 Foundation", package: "swift-iso-9075"),
-                .product(name: "Byte", package: "swift-byte"),
-                .product(name: "RFC 4122", package: "swift-rfc-4122"),
-                .product(name: "Time", package: "swift-time"),
+                .product(name: "ISO 9075 Foundation", package: "swift-iso-9075", condition: .when(traits: ["GRDB"])),
+                .product(name: "Byte", package: "swift-byte", condition: .when(traits: ["GRDB"])),
+                .product(name: "RFC 4122", package: "swift-rfc-4122", condition: .when(traits: ["GRDB"])),
+                .product(name: "Time", package: "swift-time", condition: .when(traits: ["GRDB"])),
                 .product(name: "GRDB", package: "GRDB.swift", condition: .when(traits: ["GRDB"])),
-                .product(name: "CustomDump", package: "swift-custom-dump"),
-                .product(name: "InlineSnapshotTesting", package: "swift-snapshot-testing"),
+                .product(name: "CustomDump", package: "swift-custom-dump", condition: .when(traits: ["GRDB"])),
+                .product(name: "InlineSnapshotTesting", package: "swift-snapshot-testing", condition: .when(traits: ["GRDB"])),
             ]
         ),
         .testTarget(
             name: "SQLite Tests",
             dependencies: [
                 .target(name: "SQLite"),
-                .product(name: "Path", package: "swift-path"),
+                .product(name: "Path", package: "swift-path", condition: .when(traits: ["Dependencies", "GRDB"])),
                 .target(name: "SQLite Test Support"),
                 .product(name: "SQL Macros", package: "swift-sql"),
-                .product(name: "SQL Migrations", package: "swift-sql"),
-                .product(name: "ISO 9075 Call-Level Interface", package: "swift-iso-9075"),
+                .product(name: "SQL Migrations", package: "swift-sql", condition: .when(traits: ["GRDB"])),
+                .product(name: "ISO 9075 Call-Level Interface", package: "swift-iso-9075", condition: .when(traits: ["GRDB", "Observation"])),
                 .product(name: "GRDB", package: "GRDB.swift", condition: .when(traits: ["GRDB"])),
                 .product(name: "Dependencies", package: "swift-dependencies", condition: .when(traits: ["Dependencies"])),
                 .product(name: "CustomDump", package: "swift-custom-dump"),
-                .product(name: "InlineSnapshotTesting", package: "swift-snapshot-testing"),
+                .product(name: "InlineSnapshotTesting", package: "swift-snapshot-testing", condition: .when(traits: ["GRDB"])),
             ],
             swiftSettings: [
                 .treatAllWarnings(as: .error)
@@ -153,12 +153,12 @@ let package = Package(
             name: "SQLite CloudKit Tests",
             dependencies: [
                 .target(name: "SQLite"),
-                .product(name: "Path", package: "swift-path"),
+                .product(name: "Path", package: "swift-path", condition: .when(traits: ["CloudKit"])),
                 .target(name: "SQLite CloudKit"),
                 .target(name: "SQLite Test Support"),
-                .product(name: "SQL Macros", package: "swift-sql"),
-                .product(name: "CustomDump", package: "swift-custom-dump"),
-                .product(name: "InlineSnapshotTesting", package: "swift-snapshot-testing"),
+                .product(name: "SQL Macros", package: "swift-sql", condition: .when(traits: ["CloudKit"])),
+                .product(name: "CustomDump", package: "swift-custom-dump", condition: .when(traits: ["CloudKit"])),
+                .product(name: "InlineSnapshotTesting", package: "swift-snapshot-testing", condition: .when(traits: ["CloudKit"])),
             ],
             swiftSettings: [
                 .treatAllWarnings(as: .error)
@@ -171,10 +171,10 @@ let package = Package(
             dependencies: [
                 .target(name: "SQLite"),
                 .target(name: "SQLite CloudKit", condition: .when(traits: ["CloudKit"])),
-                .product(name: "SQL", package: "swift-sql"),
-                .product(name: "SQL Macros", package: "swift-sql"),
-                .product(name: "SQL Migrations", package: "swift-sql"),
-                .product(name: "ISO 9075 Call-Level Interface", package: "swift-iso-9075"),
+                .product(name: "SQL", package: "swift-sql", condition: .when(traits: ["Observation"])),
+                .product(name: "SQL Macros", package: "swift-sql", condition: .when(traits: ["Observation"])),
+                .product(name: "SQL Migrations", package: "swift-sql", condition: .when(traits: ["Observation"])),
+                .product(name: "ISO 9075 Call-Level Interface", package: "swift-iso-9075", condition: .when(traits: ["Observation"])),
             ],
             swiftSettings: [
                 .treatAllWarnings(as: .error)
