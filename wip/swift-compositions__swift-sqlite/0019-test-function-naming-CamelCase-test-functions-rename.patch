From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:25:30 +0000
Subject: [PATCH 19/28] test function naming: CamelCase test functions renamed
 to backticked sentences (tests only; type-checked, not run; Linux x86_64,
 Swift 6.4.2) (coenttb/work#242)

---
 Examples/RemindersTests/SearchRemindersTests.swift | 2 +-
 Examples/SyncUpTests/SyncUpFormTests.swift         | 4 ++--
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/Examples/RemindersTests/SearchRemindersTests.swift b/Examples/RemindersTests/SearchRemindersTests.swift
index 75002f5..3859434 100644
--- a/Examples/RemindersTests/SearchRemindersTests.swift
+++ b/Examples/RemindersTests/SearchRemindersTests.swift
@@ -120,7 +120,7 @@ extension BaseTestSuite {
             }
         }
 
-        @Test func deleteCompleted() async throws {
+        @Test func `delete completed`() async throws {
             let model = SearchRemindersModel()
             model.searchText = "Take"
             try await model.showCompletedButtonTapped()
diff --git a/Examples/SyncUpTests/SyncUpFormTests.swift b/Examples/SyncUpTests/SyncUpFormTests.swift
index 9915c4e..7351e49 100644
--- a/Examples/SyncUpTests/SyncUpFormTests.swift
+++ b/Examples/SyncUpTests/SyncUpFormTests.swift
@@ -18,7 +18,7 @@ import Testing
 struct SyncUpFormTests {
     @Dependency(\.defaultDatabase) var database
 
-    @Test func saveNew() async throws {
+    @Test func `save new`() async throws {
         let draft = SyncUp.Draft(title: "Morning Sync")
         let model = SyncUpFormModel(syncUp: draft)
         model.addAttendeeButtonTapped()
@@ -37,7 +37,7 @@ struct SyncUpFormTests {
         #expect(attendees.map(\.name) == ["Blob", "Blob Jr."])
     }
 
-    @Test func updateExisting() async throws {
+    @Test func `update existing`() async throws {
         let existingSyncUp = try await database.read { db in
             try #require(try SyncUp.fetchOne(db))
         }
