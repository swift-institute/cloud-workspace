From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:17:17 +0000
Subject: [PATCH 30/48] minimal type body: more non-stored members moved into
 an extension of their type (batch 18; type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 Sources/SQLite SQL/Instant+JulianDay.swift  | 14 +++++++------
 Sources/SQLite SQL/Instant+UnixTime.swift   | 14 +++++++------
 Sources/SQLite SQL/JSONEach.swift           |  6 ++++--
 Sources/SQLite SQL/Triggers.swift           | 17 ++++++++--------
 Sources/SQLite SQL/UUID+Bytes.swift         | 22 +++++++++++----------
 Sources/SQLite/GRDB/SQLite.Connection.swift |  8 +++++---
 6 files changed, 46 insertions(+), 35 deletions(-)

diff --git a/Sources/SQLite SQL/Instant+JulianDay.swift b/Sources/SQLite SQL/Instant+JulianDay.swift
index e96404f..d317ce0 100644
--- a/Sources/SQLite SQL/Instant+JulianDay.swift	
+++ b/Sources/SQLite SQL/Instant+JulianDay.swift	
@@ -9,14 +9,16 @@ extension Time.Instant {
         public init(queryOutput: Time.Instant) {
             self.queryOutput = queryOutput
         }
+    }
+}
 
-        public static func _queryFragment(jsonEncoding queryFragment: ISO_9075.Fragment) -> ISO_9075.Fragment {
-            subsecDateTime([queryFragment, "'julianday'"])
-        }
+extension Time.Instant.JulianDayRepresentation {
+    public static func _queryFragment(jsonEncoding queryFragment: ISO_9075.Fragment) -> ISO_9075.Fragment {
+        subsecDateTime([queryFragment, "'julianday'"])
+    }
 
-        public static func _queryFragment(jsonDecoding queryFragment: ISO_9075.Fragment) -> ISO_9075.Fragment {
-            "julianday(\(queryFragment))"
-        }
+    public static func _queryFragment(jsonDecoding queryFragment: ISO_9075.Fragment) -> ISO_9075.Fragment {
+        "julianday(\(queryFragment))"
     }
 }
 
diff --git a/Sources/SQLite SQL/Instant+UnixTime.swift b/Sources/SQLite SQL/Instant+UnixTime.swift
index 28971e9..7581f75 100644
--- a/Sources/SQLite SQL/Instant+UnixTime.swift	
+++ b/Sources/SQLite SQL/Instant+UnixTime.swift	
@@ -9,14 +9,16 @@ extension Time.Instant {
         public init(queryOutput: Time.Instant) {
             self.queryOutput = queryOutput
         }
+    }
+}
 
-        public static func _queryFragment(jsonEncoding queryFragment: ISO_9075.Fragment) -> ISO_9075.Fragment {
-            "datetime(\(queryFragment), 'unixepoch')"
-        }
+extension Time.Instant.UnixTimeRepresentation {
+    public static func _queryFragment(jsonEncoding queryFragment: ISO_9075.Fragment) -> ISO_9075.Fragment {
+        "datetime(\(queryFragment), 'unixepoch')"
+    }
 
-        public static func _queryFragment(jsonDecoding queryFragment: ISO_9075.Fragment) -> ISO_9075.Fragment {
-            "unixepoch(\(queryFragment))"
-        }
+    public static func _queryFragment(jsonDecoding queryFragment: ISO_9075.Fragment) -> ISO_9075.Fragment {
+        "unixepoch(\(queryFragment))"
     }
 }
 
