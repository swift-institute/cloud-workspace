 Tests/Contravariant Macro Tests/Law Tests.swift | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Tests/Contravariant Macro Tests/Law Tests.swift b/Tests/Contravariant Macro Tests/Law Tests.swift
index cd21cd9..48ee8d1 100644
--- a/Tests/Contravariant Macro Tests/Law Tests.swift	
+++ b/Tests/Contravariant Macro Tests/Law Tests.swift	
@@ -6,7 +6,7 @@ import Testing
     let second: [(A) -> String]
     let label: String
 }
-@Test func contravariantIdentityAndReversedComposition() {
+@Test func `contravariant identity and reversed composition`() {
     let value = Observers<Int>(first: { $0 * 2 }, second: [String.init], label: "x")
     let identity = value.contramap { $0 }
     let successive = value.contramap { $0 + 1 }.contramap { $0 * 3 }
