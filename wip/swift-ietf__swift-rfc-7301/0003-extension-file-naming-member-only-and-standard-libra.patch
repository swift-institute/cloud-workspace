From 5f7f3816fd41cc8fb1fe47d4749d73c3d3d15908 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 20:52:53 +0000
Subject: [PATCH 3/4] extension file naming: member-only and
 standard-library-conformance extension files merge into their type's own file
 (overnight/merge-extension-files.py); single type per file: additional types
 move to their own <Parent>.<Name>.swift inside the container's extension
 (overnight/split-types.py); parse-checked; builds pending (coenttb/work#242)

---
 .../RFC 7301/RFC_7301.Extension.Error.swift   | 20 +++++++++++++++++++
 Sources/RFC 7301/RFC_7301.Extension.swift     | 14 -------------
 2 files changed, 20 insertions(+), 14 deletions(-)
 create mode 100644 Sources/RFC 7301/RFC_7301.Extension.Error.swift

diff --git a/Sources/RFC 7301/RFC_7301.Extension.Error.swift b/Sources/RFC 7301/RFC_7301.Extension.Error.swift
new file mode 100644
index 0000000..2edc81d
--- /dev/null
+++ b/Sources/RFC 7301/RFC_7301.Extension.Error.swift	
@@ -0,0 +1,20 @@
+public import Binary
+public import RFC_8446
+
+
+extension RFC_7301.Extension {
+    /// Errors that can occur when creating or parsing ALPN extensions
+    public enum Error: Swift.Error, Sendable, Equatable {
+        /// Protocol list cannot be empty
+        case noProtocols
+
+        /// A `ProtocolName` entry in the list failed validation
+        case name(RFC_7301.ProtocolIdentifier.Error)
+
+        /// The input ended before a field was complete
+        case truncated
+
+        /// Bytes remained after the `ProtocolNameList` structure
+        case trailingData(_ remaining: Int)
+    }
+}
diff --git a/Sources/RFC 7301/RFC_7301.Extension.swift b/Sources/RFC 7301/RFC_7301.Extension.swift
index 582819b..97fccf1 100644
--- a/Sources/RFC 7301/RFC_7301.Extension.swift	
+++ b/Sources/RFC 7301/RFC_7301.Extension.swift	
@@ -88,20 +88,6 @@ extension RFC_7301.Extension {
 }
 
 extension RFC_7301.Extension {
-    /// Errors that can occur when creating or parsing ALPN extensions
-    public enum Error: Swift.Error, Sendable, Equatable {
-        /// Protocol list cannot be empty
-        case noProtocols
-
-        /// A `ProtocolName` entry in the list failed validation
-        case name(RFC_7301.ProtocolIdentifier.Error)
-
-        /// The input ended before a field was complete
-        case truncated
-
-        /// Bytes remained after the `ProtocolNameList` structure
-        case trailingData(_ remaining: Int)
-    }
 }
 
 extension RFC_7301.Extension.Error: CustomStringConvertible {
