---
 ..._7301_ProtocolIdentifier_UInt8 Tests.swift | 42 ++++++++++---------
 Tests/RFC 7301 Tests/RFC_7301 Tests.swift     | 10 ++++-
 2 files changed, 31 insertions(+), 21 deletions(-)

diff --git a/Tests/RFC 7301 Standard Library Integration Tests/RFC_7301_ProtocolIdentifier_UInt8 Tests.swift b/Tests/RFC 7301 Standard Library Integration Tests/RFC_7301_ProtocolIdentifier_UInt8 Tests.swift
index 0cae1bd..df8c83f 100644
--- a/Tests/RFC 7301 Standard Library Integration Tests/RFC_7301_ProtocolIdentifier_UInt8 Tests.swift	
+++ b/Tests/RFC 7301 Standard Library Integration Tests/RFC_7301_ProtocolIdentifier_UInt8 Tests.swift	
@@ -14,28 +14,32 @@ import RFC_7301
 import RFC_7301_Standard_Library_Integration
 import Testing
 
-@Suite
-struct `RFC 7301 ProtocolIdentifier UInt8 forwarder` {
-    @Test
-    func `forwarder constructs identifier from [UInt8]`() throws {
-        let uint8Bytes: [UInt8] = Array("h2".utf8)
-        let proto = try RFC_7301.ProtocolIdentifier(rawValue: uint8Bytes)
-        #expect(proto.description == "h2")
-    }
+enum `RFC_7301_ProtocolIdentifier_UInt8 Tests` {}
 
-    @Test
-    func `forwarder rejects empty [UInt8]`() {
-        let uint8Bytes: [UInt8] = []
-        #expect(throws: RFC_7301.ProtocolIdentifier.Error.self) {
-            try RFC_7301.ProtocolIdentifier(rawValue: uint8Bytes)
+extension `RFC_7301_ProtocolIdentifier_UInt8 Tests` {
+    @Suite
+    struct `RFC 7301 ProtocolIdentifier UInt8 forwarder` {
+        @Test
+        func `forwarder constructs identifier from [UInt8]`() throws {
+            let uint8Bytes: [UInt8] = Array("h2".utf8)
+            let proto = try RFC_7301.ProtocolIdentifier(rawValue: uint8Bytes)
+            #expect(proto.description == "h2")
+        }
+
+        @Test
+        func `forwarder rejects empty [UInt8]`() {
+            let uint8Bytes: [UInt8] = []
+            #expect(throws: RFC_7301.ProtocolIdentifier.Error.self) {
+                try RFC_7301.ProtocolIdentifier(rawValue: uint8Bytes)
+            }
         }
-    }
 
-    @Test
-    func `forwarder rejects too-long [UInt8]`() {
-        let uint8Bytes: [UInt8] = Array(repeating: 0x61, count: 256)
-        #expect(throws: RFC_7301.ProtocolIdentifier.Error.self) {
-            try RFC_7301.ProtocolIdentifier(rawValue: uint8Bytes)
+        @Test
+        func `forwarder rejects too-long [UInt8]`() {
+            let uint8Bytes: [UInt8] = Array(repeating: 0x61, count: 256)
+            #expect(throws: RFC_7301.ProtocolIdentifier.Error.self) {
+                try RFC_7301.ProtocolIdentifier(rawValue: uint8Bytes)
+            }
         }
     }
 }
