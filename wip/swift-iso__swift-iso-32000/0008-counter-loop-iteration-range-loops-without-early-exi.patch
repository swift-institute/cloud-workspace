From 4941e4b972d8c6e66ff5cbfc3236ea4cceb22012 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:34:02 +0000
Subject: [PATCH 08/14] counter loop iteration: range loops without early exit
 written as forEach (type-check follows; Linux x86_64, Swift 6.4.2)
 (coenttb/work#242)

---
 Sources/ISO 32000 7 Syntax/7.3 Objects.swift       | 2 +-
 Sources/ISO 32000/ISO_32000.Writer.swift           | 4 ++--
 Tests/ISO 32000 Tests/ISO_32000.Writer Tests.swift | 2 +-
 3 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/Sources/ISO 32000 7 Syntax/7.3 Objects.swift b/Sources/ISO 32000 7 Syntax/7.3 Objects.swift
index 00dceb2..db2d4f4 100644
--- a/Sources/ISO 32000 7 Syntax/7.3 Objects.swift	
+++ b/Sources/ISO 32000 7 Syntax/7.3 Objects.swift	
@@ -946,7 +946,7 @@ extension ISO_32000.`7`.`3`.`3`.PDFNumber {
                 count -= 1
             }
 
-            for i in 0..<count {
+            (0..<count).forEach { i in
                 buffer.append(digits[i].byte)
             }
         }
diff --git a/Sources/ISO 32000/ISO_32000.Writer.swift b/Sources/ISO 32000/ISO_32000.Writer.swift
index e46e30e..44a554b 100644
--- a/Sources/ISO 32000/ISO_32000.Writer.swift	
+++ b/Sources/ISO 32000/ISO_32000.Writer.swift	
@@ -791,10 +791,10 @@ extension ISO_32000.Writer {
     private static let winAnsiToUnicode: [Int: Int] = {
         var mapping: [Int: Int] = [:]
 
-        for code in 32...127 {
+        (32...127).forEach { code in
             mapping[code] = code
         }
-        for code in 160...255 {
+        (160...255).forEach { code in
             mapping[code] = code
         }
 
diff --git a/Tests/ISO 32000 Tests/ISO_32000.Writer Tests.swift b/Tests/ISO 32000 Tests/ISO_32000.Writer Tests.swift
index 431b396..a7064a6 100644
--- a/Tests/ISO 32000 Tests/ISO_32000.Writer Tests.swift	
+++ b/Tests/ISO 32000 Tests/ISO_32000.Writer Tests.swift	
@@ -146,7 +146,7 @@ struct `ISO_32000.Writer Tests` {
         let content = ISO_32000.ContentStream { builder in
             builder.beginText()
             builder.setFont(ISO_32000.Font.helvetica, size: 12)
-            for i in 0..<20 {
+            (0..<20).forEach { i in
                 builder.moveText(
                     dx: .init(72),
                     dy: .init(Double(700 - i * 20))
-- 
