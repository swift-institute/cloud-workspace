Subject: [PATCH 07/10] compound type name, compound identifier: single-file
 internal types made fileprivate, package members used only in their target
 made internal (type-check follows; Linux x86_64, Swift 6.4.2)
 (coenttb/work#242)

---
 Tests/Store Tests/Store.Protocol Tests.swift | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/Tests/Store Tests/Store.Protocol Tests.swift b/Tests/Store Tests/Store.Protocol Tests.swift
index b56744c..a0705c4 100644
--- a/Tests/Store Tests/Store.Protocol Tests.swift	
+++ b/Tests/Store Tests/Store.Protocol Tests.swift	
@@ -8,7 +8,7 @@ import Tagged
 import Testing
 
 @safe
-struct HeapStore<Element>: ~Copyable {
+fileprivate struct HeapStore<Element>: ~Copyable {
     @usableFromInline
     var _base: UnsafeMutablePointer<Element>
 
@@ -63,7 +63,7 @@ struct Token: ~Copyable {
 }
 
 @safe
-struct HeapStoreNC<Element: ~Copyable>: ~Copyable {
+fileprivate struct HeapStoreNC<Element: ~Copyable>: ~Copyable {
     @usableFromInline
     var _base: UnsafeMutablePointer<Element>
 
