 5 files changed, 155 insertions(+), 157 deletions(-)

diff --git a/Sources/RFC 2045/Absorbed swift-rfc-2045-coder/RFC_2045.Charset.Coder.swift b/Sources/RFC 2045/Absorbed swift-rfc-2045-coder/RFC_2045.Charset.Coder.swift
index 650d351..31a1057 100644
--- a/Sources/RFC 2045/Absorbed swift-rfc-2045-coder/RFC_2045.Charset.Coder.swift	
+++ b/Sources/RFC 2045/Absorbed swift-rfc-2045-coder/RFC_2045.Charset.Coder.swift	
@@ -7,37 +7,37 @@
     import Serializer
 
     extension RFC_2045.Charset {
-
         public struct Coder<
             Input: Cursor.`Protocol`<Byte, Never>,
             Buffer: RangeReplaceableCollection<Byte>
         >: Coding {
+            public init() {}
+        }
 
-            public typealias Output = RFC_2045.Charset
+        public static var coder: Coder<ArraySlice<Byte>, [Byte]> { .init() }
+    }
 
-            public typealias Failure = RFC_2045.Charset.Error
+extension RFC_2045.Charset.Coder {
+        public typealias Output = RFC_2045.Charset
 
-            public init() {}
+        public typealias Failure = RFC_2045.Charset.Error
 
-            public borrowing func parse(_ input: inout Input) throws(Failure) -> Output {
-                let start = input.checkpoint
-                let bytes = Scan.run(&input, while: RFC_2045.Grammar.isTokenCharacter)
-                do throws(Failure) {
-                    return try RFC_2045.Charset(ascii: bytes)
-                } catch {
-                    input.seek(to: start)
-                    throw error
-                }
-            }
-
-            public borrowing func serialize(
-                _ output: Output,
-                into buffer: inout Buffer
-            ) throws(Failure) {
-                Scan.append(output.rawValue, into: &buffer)
+        public borrowing func parse(_ input: inout Input) throws(Failure) -> Output {
+            let start = input.checkpoint
+            let bytes = Scan.run(&input, while: RFC_2045.Grammar.isTokenCharacter)
+            do throws(Failure) {
+                return try RFC_2045.Charset(ascii: bytes)
+            } catch {
+                input.seek(to: start)
+                throw error
             }
         }
 
-        public static var coder: Coder<ArraySlice<Byte>, [Byte]> { .init() }
-    }
+        public borrowing func serialize(
+            _ output: Output,
+            into buffer: inout Buffer
+        ) throws(Failure) {
+            Scan.append(output.rawValue, into: &buffer)
+        }
+}
 #endif
