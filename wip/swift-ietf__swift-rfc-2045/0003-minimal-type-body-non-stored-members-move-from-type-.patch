+        public borrowing func parse(_ input: inout Input) throws(Failure) -> Output {
+            let start = input.checkpoint
+            Scan.skipWhitespace(&input)
+            let bytes = Scan.run(&input, while: RFC_2045.Grammar.isTokenCharacter)
