diff --git a/Sources/Pair/Pair+Swift.Hashable.swift b/Sources/Pair/Pair+Swift.Hashable.swift
new file mode 100644
index 0000000..c663c72
--- /dev/null
+++ b/Sources/Pair/Pair+Swift.Hashable.swift
@@ -0,0 +1,12 @@
+extension Pair: Swift::Hashable
+where
+    First: Swift::Hashable & ~Copyable,
+    Second: Swift::Hashable & ~Copyable
+{
+
+    @inlinable
+    public borrowing func hash(into hasher: inout Hasher) {
+        first.hash(into: &hasher)
+        second.hash(into: &hasher)
+    }
+}
