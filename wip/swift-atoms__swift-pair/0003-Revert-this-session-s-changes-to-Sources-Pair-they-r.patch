diff --git a/Sources/Pair/Pair+Swift.BitwiseCopyable.swift b/Sources/Pair/Pair+Swift.BitwiseCopyable.swift
new file mode 100644
index 0000000..e954117
--- /dev/null
+++ b/Sources/Pair/Pair+Swift.BitwiseCopyable.swift
@@ -0,0 +1 @@
+extension Pair: Swift::BitwiseCopyable where First: Swift::BitwiseCopyable, Second: Swift::BitwiseCopyable {}
diff --git a/Sources/Pair/Pair+Swift.Comparable.swift b/Sources/Pair/Pair+Swift.Comparable.swift
new file mode 100644
index 0000000..97c5f3a
--- /dev/null
+++ b/Sources/Pair/Pair+Swift.Comparable.swift
@@ -0,0 +1,13 @@
+extension Pair: Swift::Comparable
+where
+    First: Swift::Comparable & ~Copyable,
+    Second: Swift::Comparable & ~Copyable
+{
+
+    @inlinable
+    public static func < (lhs: borrowing Pair, rhs: borrowing Pair) -> Bool {
+        if lhs.first < rhs.first { return true }
+        if rhs.first < lhs.first { return false }
+        return lhs.second < rhs.second
+    }
+}
diff --git a/Sources/Pair/Pair+Swift.Equatable.swift b/Sources/Pair/Pair+Swift.Equatable.swift
new file mode 100644
index 0000000..61537b5
--- /dev/null
+++ b/Sources/Pair/Pair+Swift.Equatable.swift
@@ -0,0 +1,11 @@
+extension Pair: Swift::Equatable
+where
+    First: Swift::Equatable & ~Copyable,
+    Second: Swift::Equatable & ~Copyable
+{
+
+    @inlinable
+    public static func == (lhs: borrowing Pair, rhs: borrowing Pair) -> Bool {
+        lhs.first == rhs.first && lhs.second == rhs.second
+    }
+}
diff --git a/Sources/Pair/Pair+Swift.Error.swift b/Sources/Pair/Pair+Swift.Error.swift
new file mode 100644
