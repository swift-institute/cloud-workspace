From 7ce05c4ff10f11afd961ca610a74e9ab00471066 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:34:01 +0000
Subject: [PATCH 4/4] counter loop iteration: range loops without early exit
 written as forEach (type-check follows; Linux x86_64, Swift 6.4.2)
 (coenttb/work#242)

---
 Tests/Tree N Tests/Tree.Binary.Builder Tests.swift | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/Tests/Tree N Tests/Tree.Binary.Builder Tests.swift b/Tests/Tree N Tests/Tree.Binary.Builder Tests.swift
index cf6d294..bf09997 100644
--- a/Tests/Tree N Tests/Tree.Binary.Builder Tests.swift	
+++ b/Tests/Tree N Tests/Tree.Binary.Builder Tests.swift	
@@ -140,7 +140,7 @@ extension `Tree.Binary.Builder`.Unit {
     @Test
     func `For loop builds wide tree`() {
         let tree = __Tree<TreeStorage.N<Int, 2>> {
-            for i in 1...7 {
+            (1...7).forEach { i in
                 i
             }
         }
@@ -153,7 +153,7 @@ extension `Tree.Binary.Builder`.`Edge Case` {
     @Test
     func `Many elements`() {
         let tree = __Tree<TreeStorage.N<Int, 2>> {
-            for i in 0..<31 {
+            (0..<31).forEach { i in
                 i
             }
         }
