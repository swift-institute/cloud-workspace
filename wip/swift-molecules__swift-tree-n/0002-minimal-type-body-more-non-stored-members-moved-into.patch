From 155298699d7ec13b79c31d286e3bbb06cfed401c Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:27:43 +0000
Subject: [PATCH 2/8] minimal type body: more non-stored members moved into an
 extension of their type (batch 10; type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 Sources/Tree N/TreeStorage.N.swift            |  9 +++-----
 Sources/Tree N/__TreeArena.swift              | 21 +++++++++----------
 .../Tree N/__TreeNOrder.Pre.Iterator.swift    |  8 +++----
 3 files changed, 17 insertions(+), 21 deletions(-)

diff --git a/Sources/Tree N/TreeStorage.N.swift b/Sources/Tree N/TreeStorage.N.swift
index 84003a1..df38fb9 100644
--- a/Sources/Tree N/TreeStorage.N.swift	
+++ b/Sources/Tree N/TreeStorage.N.swift	
@@ -4,11 +4,7 @@ public import Store
 public import Tree
 
 extension TreeStorage {
-
     public struct N<Element: ~Copyable, let n: Int>: ~Copyable {
-
-        public typealias Address = __TreeNChildSlot<n>
-
         @usableFromInline
         var _arena: __TreeArena<Element, InlineArray<n, Store.Generational.Handle?>>
 
@@ -39,7 +35,6 @@ extension TreeStorage {
 }
 
 extension TreeStorage.N: __TreeStorage where Element: ~Copyable {
-
     @inlinable
     public var _count: Index<Element>.Count { _arena.count }
 
@@ -161,7 +156,6 @@ extension TreeStorage.N: __TreeStorage where Element: ~Copyable {
 }
 
 extension TreeStorage.N: __TreeNStorage where Element: ~Copyable {
-
     @inlinable
     public static var _arity: Int { n }
 }
@@ -169,3 +163,6 @@ extension TreeStorage.N: __TreeNStorage where Element: ~Copyable {
 extension TreeStorage.N: Copyable where Element: Copyable {}
 
 extension TreeStorage.N: Sendable where Element: Sendable {}
+
+extension TreeStorage.N where Element: ~Copyable {
+        public typealias Address = __TreeNChildSlot<n>}
diff --git a/Sources/Tree N/__TreeArena.swift b/Sources/Tree N/__TreeArena.swift
index 484dc1d..a4ab206 100644
--- a/Sources/Tree N/__TreeArena.swift	
+++ b/Sources/Tree N/__TreeArena.swift	
@@ -10,10 +10,6 @@ public import Tree
 
 @usableFromInline
 struct __TreeArena<Element: ~Copyable, ChildLinks>: ~Copyable {
-
-    @usableFromInline
-    typealias Slot = __TreeNode<Element, ChildLinks>
-
     @usableFromInline
     var _column: Ownership.Shared<Slot, Storage<Memory.Allocator<Memory.Heap>.Pool>.Generational<Slot>>
 
@@ -46,6 +42,15 @@ struct __TreeArena<Element: ~Copyable, ChildLinks>: ~Copyable {
         self._column = Ownership.Shared(Storage<Memory.Allocator<Memory.Heap>.Pool>.Generational<Slot>.create(slotCapacity: slots))
         self.rootHandle = nil
     }
+}
+
+extension __TreeArena: Copyable where Element: Copyable, ChildLinks: Copyable {}
+
+extension __TreeArena: Sendable where Element: Sendable, ChildLinks: Sendable {}
+
+extension __TreeArena where Element: ~Copyable {
+    @usableFromInline
+    typealias Slot = __TreeNode<Element, ChildLinks>
 
     @inlinable
     package var count: Index<Element>.Count {
@@ -83,7 +88,6 @@ struct __TreeArena<Element: ~Copyable, ChildLinks>: ~Copyable {
     @inlinable
     package mutating func removeNode(_ handle: Store.Generational.Handle) -> Element {
         guard let node = _column.withUnique({ $0.remove(handle) }) else {
-
             preconditionFailure("__TreeArena: live handle failed to resolve on removal")
         }
         return node.element
@@ -130,9 +134,4 @@ struct __TreeArena<Element: ~Copyable, ChildLinks>: ~Copyable {
         _ body: (inout Element) -> R
     ) -> R {
         _column.withUnique { body(&$0[handle].element) }
-    }
-}
-
-extension __TreeArena: Copyable where Element: Copyable, ChildLinks: Copyable {}
-
-extension __TreeArena: Sendable where Element: Sendable, ChildLinks: Sendable {}
+    }}
diff --git a/Sources/Tree N/__TreeNOrder.Pre.Iterator.swift b/Sources/Tree N/__TreeNOrder.Pre.Iterator.swift
index 62b7635..9fd4866 100644
--- a/Sources/Tree N/__TreeNOrder.Pre.Iterator.swift	
+++ b/Sources/Tree N/__TreeNOrder.Pre.Iterator.swift	
@@ -5,7 +5,6 @@ public import Store
 public import Tree
 
 extension __TreeNOrder.Pre {
-
     public struct Iterator<S: __TreeNStorage>: ~Copyable, Iterator::Iterator.`Protocol`
     where S.Element: Copyable {
         @usableFromInline
@@ -22,7 +21,10 @@ extension __TreeNOrder.Pre {
                 self.pending.push(rootHandle)
             }
         }
+    }
+}
 
+extension __TreeNOrder.Pre.Iterator {
         @inlinable
         public mutating func next() -> S.Element? {
             guard let handle = pending.pop() else { return nil }
@@ -35,6 +37,4 @@ extension __TreeNOrder.Pre {
             }
 
             return value
-        }
-    }
-}
+        }}
