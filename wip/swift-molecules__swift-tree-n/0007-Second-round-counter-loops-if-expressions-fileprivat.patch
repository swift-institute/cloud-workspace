From e8d87513cf06f66f7f5c8ecfcbf1ce5fc131a59d Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 06:08:24 +0000
Subject: [PATCH 7/8] Second round: counter loops, if expressions, fileprivate
 single-file types, extension file renames (type-check follows; Linux x86_64,
 Swift 6.4.2) (coenttb/work#242)

---
 Sources/Tree N/TreeStorage.N.swift             | 4 ++--
 Sources/Tree N/__TreeNOrder.Pre.Iterator.swift | 2 +-
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/Sources/Tree N/TreeStorage.N.swift b/Sources/Tree N/TreeStorage.N.swift
index df38fb9..a473cfd 100644
--- a/Sources/Tree N/TreeStorage.N.swift	
+++ b/Sources/Tree N/TreeStorage.N.swift	
@@ -135,7 +135,7 @@ extension TreeStorage.N: __TreeStorage where Element: ~Copyable {
     public func _childCount(at handle: Store.Generational.Handle) -> Int {
         _arena.withLinks(at: handle) { links in
             var count = 0
-            for slot in 0..<n {
+            (0..<n).forEach { slot in
                 if links[slot] != nil { count += 1 }
             }
             return count
@@ -148,7 +148,7 @@ extension TreeStorage.N: __TreeStorage where Element: ~Copyable {
         _ body: (Store.Generational.Handle) -> Void
     ) {
         _arena.withLinks(at: handle) { links in
-            for slot in 0..<n {
+            (0..<n).forEach { slot in
                 if let child = links[slot] { body(child) }
             }
         }
diff --git a/Sources/Tree N/__TreeNOrder.Pre.Iterator.swift b/Sources/Tree N/__TreeNOrder.Pre.Iterator.swift
index 9fd4866..4d01ff7 100644
--- a/Sources/Tree N/__TreeNOrder.Pre.Iterator.swift	
+++ b/Sources/Tree N/__TreeNOrder.Pre.Iterator.swift	
@@ -32,7 +32,7 @@ extension __TreeNOrder.Pre.Iterator {
             let value = tree._value(of: handle)
 
             let children = tree._childHandles(of: handle)
-            for i in (0..<children.count).reversed() {
+            (0..<children.count).reversed().forEach { i in
                 pending.push(children[i])
             }
 
