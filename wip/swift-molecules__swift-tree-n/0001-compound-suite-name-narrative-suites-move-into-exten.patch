Date: Sat, 7 Nov 2026 18:48:59 +0000
Subject: [PATCH] compound suite name: narrative suites move into extension
 <Type> named after their test file, nested suites into extension
 <Type>.<Parent> (overnight/compound-suites.py); parse-checked; builds pending
 (coenttb/work#242)

---
 Tests/Tree N Tests/Tree.Binary.Builder Tests.swift   | 4 ++++
 Tests/Tree N Tests/Tree.N.Nested.Builder Tests.swift | 5 +++++
 2 files changed, 9 insertions(+)

diff --git a/Tests/Tree N Tests/Tree.Binary.Builder Tests.swift b/Tests/Tree N Tests/Tree.Binary.Builder Tests.swift
index 3da863c..cf6d294 100644
--- a/Tests/Tree N Tests/Tree.Binary.Builder Tests.swift	
+++ b/Tests/Tree N Tests/Tree.Binary.Builder Tests.swift	
@@ -8,7 +8,11 @@ struct `Tree.Binary.Builder` {
     @Suite struct Unit {}
     @Suite struct `Edge Case` {}
     @Suite struct Integration {}
+}
+
+extension `Tree.Binary.Builder` {
     @Suite struct `Level Order` {}
+
     @Suite struct `Static Methods` {}
 }
 
diff --git a/Tests/Tree N Tests/Tree.N.Nested.Builder Tests.swift b/Tests/Tree N Tests/Tree.N.Nested.Builder Tests.swift
index d09f1f1..3cc6318 100644
--- a/Tests/Tree N Tests/Tree.N.Nested.Builder Tests.swift	
+++ b/Tests/Tree N Tests/Tree.N.Nested.Builder Tests.swift	
@@ -7,8 +7,13 @@ import Tree_N_Test_Support
 struct `Tree.N<2>.Nested.Builder` {
     @Suite struct Unit {}
     @Suite struct `Edge Case` {}
+}
+
+extension `Tree.N<2>.Nested.Builder` {
     @Suite struct Sparse {}
+
     @Suite struct `Depth Coverage` {}
+
     @Suite struct `Static Methods` {}
 }
 
