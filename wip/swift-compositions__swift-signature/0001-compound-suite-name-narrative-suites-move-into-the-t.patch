From 9fdb1baeb7809123cc209a8acfdc726a6e89ec8b Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 19:34:25 +0000
Subject: [PATCH] compound suite name: narrative suites move into the test
 module's namespace `<File> Tests` (#239's layout), nested suites into
 extension <Path>.<Parent> (overnight/compound-suites.py); parse-checked;
 builds pending (coenttb/work#242)

---
 .../Signature Tests/DER Boundary Tests.swift  | 52 ++++++++++---------
 1 file changed, 28 insertions(+), 24 deletions(-)

diff --git a/Tests/Signature Tests/DER Boundary Tests.swift b/Tests/Signature Tests/DER Boundary Tests.swift
index 215b800..2739b4a 100644
--- a/Tests/Signature Tests/DER Boundary Tests.swift	
+++ b/Tests/Signature Tests/DER Boundary Tests.swift	
@@ -3,32 +3,36 @@ import Testing
 
 @testable import Signature
 
-@Suite
-struct `PKCS8 DER unwrap boundaries` {
-    private func unwrap(_ bytes: [UInt8]) throws(Signature.RSA.Key.Error) -> [Byte] {
-        try Signature.RSA.Key.unwrap(bytes.map { Byte($0) })
-    }
+enum `DER Boundary Tests` {}
 
-    @Test
-    func `the smallest well-formed wrapper yields its key bytes`() throws {
-        #expect(try unwrap([0x30, 0x08, 0x02, 0x00, 0x30, 0x00, 0x04, 0x02, 0xAA, 0xBB]) == [0xAA, 0xBB].map { Byte($0) })
-    }
+extension `DER Boundary Tests` {
+    @Suite
+    struct `PKCS8 DER unwrap boundaries` {
+        private func unwrap(_ bytes: [UInt8]) throws(Signature.RSA.Key.Error) -> [Byte] {
+            try Signature.RSA.Key.unwrap(bytes.map { Byte($0) })
+        }
 
-    @Test
-    func `a long-form key length is read`() throws {
-        #expect(try unwrap([0x30, 0x81, 0x09, 0x02, 0x00, 0x30, 0x00, 0x04, 0x81, 0x01, 0x07]) == [Byte(0x07)])
-    }
+        @Test
+        func `the smallest well-formed wrapper yields its key bytes`() throws {
+            #expect(try unwrap([0x30, 0x08, 0x02, 0x00, 0x30, 0x00, 0x04, 0x02, 0xAA, 0xBB]) == [0xAA, 0xBB].map { Byte($0) })
+        }
+
+        @Test
+        func `a long-form key length is read`() throws {
+            #expect(try unwrap([0x30, 0x81, 0x09, 0x02, 0x00, 0x30, 0x00, 0x04, 0x81, 0x01, 0x07]) == [Byte(0x07)])
+        }
 
-    @Test(arguments: [
-        [UInt8](),
-        [0x31, 0x00],
-        [0x30, 0x80, 0x02, 0x00],
-        [0x30, 0x85, 0x00, 0x00, 0x00, 0x00, 0x01],
-        [0x30, 0x06, 0x02, 0x84, 0xFF, 0xFF, 0xFF, 0xFF],
-        [0x30, 0x06, 0x02, 0x00, 0x30, 0x00, 0x04, 0x05, 0xAA],
-        [0x30, 0x04, 0x02, 0x00, 0x30, 0x00],
-    ])
-    func `malformed DER is rejected without trapping`(_ bytes: [UInt8]) {
-        #expect(throws: Signature.RSA.Key.Error.malformed) { try unwrap(bytes) }
+        @Test(arguments: [
+            [UInt8](),
+            [0x31, 0x00],
+            [0x30, 0x80, 0x02, 0x00],
+            [0x30, 0x85, 0x00, 0x00, 0x00, 0x00, 0x01],
+            [0x30, 0x06, 0x02, 0x84, 0xFF, 0xFF, 0xFF, 0xFF],
+            [0x30, 0x06, 0x02, 0x00, 0x30, 0x00, 0x04, 0x05, 0xAA],
+            [0x30, 0x04, 0x02, 0x00, 0x30, 0x00],
+        ])
+        func `malformed DER is rejected without trapping`(_ bytes: [UInt8]) {
+            #expect(throws: Signature.RSA.Key.Error.malformed) { try unwrap(bytes) }
+        }
     }
 }
