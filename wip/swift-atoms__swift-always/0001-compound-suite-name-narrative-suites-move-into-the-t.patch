Subject: [PATCH] compound suite name: narrative suites move into the test
 module's namespace `<File> Tests` (#239's layout), nested suites into
 extension <Path>.<Parent> (overnight/compound-suites.py); parse-checked;
 builds pending (coenttb/work#242)

---
 Tests/Always Tests/Always Tests.swift | 26 +++++++++++++++-----------
 1 file changed, 15 insertions(+), 11 deletions(-)

diff --git a/Tests/Always Tests/Always Tests.swift b/Tests/Always Tests/Always Tests.swift
index 5f0731f..d51714d 100644
--- a/Tests/Always Tests/Always Tests.swift	
+++ b/Tests/Always Tests/Always Tests.swift	
@@ -1,20 +1,24 @@
 import Always
 import Testing
 
-@Suite
-struct `Always preserves its stored value` {
+enum `Always Tests` {}
 
-    @Test
-    func `Always stores its value`() {
-        let always = Always(42)
+extension `Always Tests` {
+    @Suite
+    struct `Always preserves its stored value` {
 
-        #expect(always.value == 42)
-    }
+        @Test
+        func `Always stores its value`() {
+            let always = Always(42)
+
+            #expect(always.value == 42)
+        }
 
-    @Test
-    func `Always stores a Void value`() {
-        let always = Always(())
+        @Test
+        func `Always stores a Void value`() {
+            let always = Always(())
 
-        _ = always.value
+            _ = always.value
+        }
     }
 }
