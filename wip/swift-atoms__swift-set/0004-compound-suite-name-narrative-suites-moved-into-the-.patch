From f7e4fa14028ea83d4297dc86eba3cad0fae0fc65 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:27:08 +0000
Subject: [PATCH 4/6] compound suite name: narrative suites moved into the test
 file's namespace or the parent suite's extension (names and test IDs kept;
 tests only; Linux x86_64, Swift 6.4.2) (coenttb/work#242)

---
 .../Set Storage Tests.swift                   | 56 ++++++++++---------
 1 file changed, 29 insertions(+), 27 deletions(-)

diff --git a/Tests/Decision Set Integration Tests/Set Storage Tests.swift b/Tests/Decision Set Integration Tests/Set Storage Tests.swift
index 1582528..c8e4923 100644
--- a/Tests/Decision Set Integration Tests/Set Storage Tests.swift	
+++ b/Tests/Decision Set Integration Tests/Set Storage Tests.swift	
@@ -4,33 +4,35 @@ import Set
 import Store
 import Testing
 
-@Suite
-struct `Set Storage Tests` {
-
-    @Test
-    func `supported store metrics`() {
-        var store = MetricStore()
-        store.initialize(at: .zero, to: 42)
-        let set = __Set(store: consume store)
-
-        let first: __Set<MetricStore>.Index = .zero
-        let count = set.count
-        let isEmpty = set.isEmpty
-        let capacity = set.capacity
-
-        #expect(first == .zero)
-        #expect(count == Index<Int>.Count(1))
-        #expect(!isEmpty)
-        #expect(capacity == Index<Int>.Count(4))
-    }
-
-    @Test
-    func `clone unshares the copied store`() {
-        let set = __Set(store: CopyStore())
-        let clone = set.clone()
-
-        #expect(set.take().unshareCount == 0)
-        #expect(clone.take().unshareCount == 1)
+extension `Set Storage Tests`.`Set Storage Tests` {
+    @Suite
+    struct `Set Storage Tests` {
+
+        @Test
+        func `supported store metrics`() {
+            var store = MetricStore()
+            store.initialize(at: .zero, to: 42)
+            let set = __Set(store: consume store)
+
+            let first: __Set<MetricStore>.Index = .zero
+            let count = set.count
+            let isEmpty = set.isEmpty
+            let capacity = set.capacity
+
+            #expect(first == .zero)
+            #expect(count == Index<Int>.Count(1))
+            #expect(!isEmpty)
+            #expect(capacity == Index<Int>.Count(4))
+        }
+
+        @Test
+        func `clone unshares the copied store`() {
+            let set = __Set(store: CopyStore())
+            let clone = set.clone()
+
+            #expect(set.take().unshareCount == 0)
+            #expect(clone.take().unshareCount == 1)
+        }
     }
 }
 
