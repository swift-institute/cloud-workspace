From 147684c8a0ebe5b4a9c7914f317d80475951806c Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 20:52:56 +0000
Subject: [PATCH 2/2] extension file naming: member-only and
 standard-library-conformance extension files merge into their type's own file
 (overnight/merge-extension-files.py); single type per file: additional types
 move to their own <Parent>.<Name>.swift inside the container's extension
 (overnight/split-types.py); parse-checked; builds pending (coenttb/work#242)

---
 .../IO Kernel Events/Event.Error+Source.swift | 22 ------------------
 Sources/IO Kernel Events/Event.Error.swift    | 23 +++++++++++++++++++
 Sources/IO Kernel Events/Event.Failure.swift  | 10 --------
 Sources/IO Kernel Events/Event.swift          | 11 +++++++++
 4 files changed, 34 insertions(+), 32 deletions(-)
 delete mode 100644 Sources/IO Kernel Events/Event.Error+Source.swift
 delete mode 100644 Sources/IO Kernel Events/Event.Failure.swift

diff --git a/Sources/IO Kernel Events/Event.Error+Source.swift b/Sources/IO Kernel Events/Event.Error+Source.swift
deleted file mode 100644
index 9ce54b7..0000000
--- a/Sources/IO Kernel Events/Event.Error+Source.swift	
+++ /dev/null
@@ -1,22 +0,0 @@
-#if !os(Windows)
-    extension Event.Error {
-
-        @inlinable
-        package init(_ error: Kernel.Event.Driver.Error) {
-            switch error {
-            case .platform(let code):
-                self = .platform(code)
-
-            case .invalidDescriptor:
-                self = .invalidDescriptor
-
-            case .notRegistered:
-                self = .notRegistered
-
-            case .unsupportedPlatform:
-                self = .platform(.ENOTSUP)
-            }
-        }
-    }
-
-#endif
diff --git a/Sources/IO Kernel Events/Event.Error.swift b/Sources/IO Kernel Events/Event.Error.swift
index f13dd00..833d826 100644
--- a/Sources/IO Kernel Events/Event.Error.swift	
+++ b/Sources/IO Kernel Events/Event.Error.swift	
@@ -54,3 +54,26 @@
     }
 
 #endif
+
+#if !os(Windows)
+    extension Event.Error {
+
+        @inlinable
+        package init(_ error: Kernel.Event.Driver.Error) {
+            switch error {
+            case .platform(let code):
+                self = .platform(code)
+
+            case .invalidDescriptor:
+                self = .invalidDescriptor
+
+            case .notRegistered:
+                self = .notRegistered
+
+            case .unsupportedPlatform:
+                self = .platform(.ENOTSUP)
+            }
+        }
+    }
+
+#endif
diff --git a/Sources/IO Kernel Events/Event.Failure.swift b/Sources/IO Kernel Events/Event.Failure.swift
deleted file mode 100644
index ffac013..0000000
--- a/Sources/IO Kernel Events/Event.Failure.swift	
+++ /dev/null
@@ -1,10 +0,0 @@
-#if !os(Windows)
-    public import Either
-    public import Async_Lifecycle
-
-    extension Event {
-
-        public typealias Failure = Either<Async.Lifecycle.Error, Event.Error>
-    }
-
-#endif
diff --git a/Sources/IO Kernel Events/Event.swift b/Sources/IO Kernel Events/Event.swift
index 28dc9ea..0302aec 100644
--- a/Sources/IO Kernel Events/Event.swift	
+++ b/Sources/IO Kernel Events/Event.swift	
@@ -4,3 +4,14 @@
     public typealias Event = Kernel.Event
 
 #endif
+
+#if !os(Windows)
+    public import Either
+    public import Async_Lifecycle
+
+    extension Event {
+
+        public typealias Failure = Either<Async.Lifecycle.Error, Event.Error>
+    }
+
+#endif
