-                self = .invalidDescriptor
-
-            case .notRegistered:
-                self = .notRegistered
-
-            case .unsupportedPlatform:
-                self = .platform(.ENOTSUP)
-            }
-        }
-    }
-
-#endif
diff --git a/Sources/IO Kernel Events/Event.Failure.swift b/Sources/IO Kernel Events/Event.Failure.swift
new file mode 100644
index 0000000..ffac013
--- /dev/null
+++ b/Sources/IO Kernel Events/Event.Failure.swift	
@@ -0,0 +1,10 @@
+#if !os(Windows)
+    public import Either
+    public import Async_Lifecycle
+
+    extension Event {
+
+        public typealias Failure = Either<Async.Lifecycle.Error, Event.Error>
+    }
+
+#endif
diff --git a/Sources/IO Kernel Events/Event.swift b/Sources/IO Kernel Events/Event.swift
index 0302aec..28dc9ea 100644
--- a/Sources/IO Kernel Events/Event.swift	
+++ b/Sources/IO Kernel Events/Event.swift	
