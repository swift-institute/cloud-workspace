From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 21:32:53 +0000
Subject: [PATCH 3/7] Revert the extension-file merges and type splits in
 directories the type-check can't verify (C shims, macros); institute's
 generated Ratchet+limits.swift stays its own file (coenttb/work#242)

---
 .../IO Kernel Events/Event.Error+Source.swift | 22 ++++++++++++++++++
 Sources/IO Kernel Events/Event.Error.swift    | 23 -------------------
 Sources/IO Kernel Events/Event.Failure.swift  | 10 ++++++++
 Sources/IO Kernel Events/Event.swift          | 11 ---------
 4 files changed, 32 insertions(+), 34 deletions(-)
 create mode 100644 Sources/IO Kernel Events/Event.Error+Source.swift
 create mode 100644 Sources/IO Kernel Events/Event.Failure.swift

diff --git a/Sources/IO Kernel Events/Event.Error+Source.swift b/Sources/IO Kernel Events/Event.Error+Source.swift
new file mode 100644
index 0000000..9ce54b7
--- /dev/null
+++ b/Sources/IO Kernel Events/Event.Error+Source.swift	
@@ -0,0 +1,22 @@
+#if !os(Windows)
+    extension Event.Error {
+
+        @inlinable
+        package init(_ error: Kernel.Event.Driver.Error) {
+            switch error {
+            case .platform(let code):
+                self = .platform(code)
+
+            case .invalidDescriptor:
+                self = .invalidDescriptor
+
+            case .notRegistered:
+                self = .notRegistered
+
+            case .unsupportedPlatform:
+                self = .platform(.ENOTSUP)
+            }
+        }
+    }
+
+#endif
diff --git a/Sources/IO Kernel Events/Event.Error.swift b/Sources/IO Kernel Events/Event.Error.swift
index 833d826..f13dd00 100644
--- a/Sources/IO Kernel Events/Event.Error.swift	
+++ b/Sources/IO Kernel Events/Event.Error.swift	
@@ -54,26 +54,3 @@
     }
 
 #endif
-
-#if !os(Windows)
-    extension Event.Error {
-
-        @inlinable
-        package init(_ error: Kernel.Event.Driver.Error) {
-            switch error {
-            case .platform(let code):
