From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:34:03 +0000
Subject: [PATCH 7/8] counter loop iteration: range loops without early exit
 written as forEach (type-check follows; Linux x86_64, Swift 6.4.2)
 (coenttb/work#242)

---
 Tests/IO Kernel Events Tests/IO.Event.Fake.swift | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Tests/IO Kernel Events Tests/IO.Event.Fake.swift b/Tests/IO Kernel Events Tests/IO.Event.Fake.swift
index 0d9118e..56dd943 100644
--- a/Tests/IO Kernel Events Tests/IO.Event.Fake.swift	
+++ b/Tests/IO Kernel Events Tests/IO.Event.Fake.swift	
@@ -232,7 +232,7 @@
                 let events = state.pendingEvents
                 state.pendingEvents = []
                 let count = min(events.count, buffer.count)
-                for i in 0..<count { buffer[i] = events[i] }
+                (0..<count).forEach { i in buffer[i] = events[i] }
                 idle = count == 0
                 return count
             }
