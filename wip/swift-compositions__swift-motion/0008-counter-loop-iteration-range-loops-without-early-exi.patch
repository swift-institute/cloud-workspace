From 23b83deb2d983b715b7265a8a98990f5b463cd2f Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:34:03 +0000
Subject: [PATCH 08/10] counter loop iteration: range loops without early exit
 written as forEach (type-check follows; Linux x86_64, Swift 6.4.2)
 (coenttb/work#242)

---
 Sources/Motion Encoding/Encoding.swift           | 2 +-
 Tests/Motion Encoding Tests/Encoding Tests.swift | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/Sources/Motion Encoding/Encoding.swift b/Sources/Motion Encoding/Encoding.swift
index ee8d522..dce20c6 100644
--- a/Sources/Motion Encoding/Encoding.swift	
+++ b/Sources/Motion Encoding/Encoding.swift	
@@ -122,7 +122,7 @@ extension Encoding {
             let row = raster.width * 4
             let stride = unsafe plane.properties.bytesPerRow
             raster.bytes.withUnsafeBytes { source in
-                for line in 0..<raster.height {
+                (0..<raster.height).forEach { line in
                     let start = line * raster.stride
                     unsafe UnsafeMutableRawBufferPointer(rebasing: plane.bytes[(line * stride)..<(line * stride + row)])
                         .copyMemory(from: UnsafeRawBufferPointer(rebasing: source[start..<(start + row)]))
diff --git a/Tests/Motion Encoding Tests/Encoding Tests.swift b/Tests/Motion Encoding Tests/Encoding Tests.swift
index 04adfda..bc4d8c3 100644
--- a/Tests/Motion Encoding Tests/Encoding Tests.swift	
+++ b/Tests/Motion Encoding Tests/Encoding Tests.swift	
@@ -10,7 +10,7 @@ import Testing
     static func gradient(_ index: Int, width: Int = 320, height: Int = 180) -> Raster {
         var bytes = [UInt8](repeating: 255, count: width * height * 4)
         (0..<height).forEach { y in
-            for x in 0..<width {
+            (0..<width).forEach { x in
                 let at = (y * width + x) * 4
                 bytes[at] = UInt8(x * 255 / width)
                 bytes[at + 1] = UInt8((y * 200 / height + index * 8) % 256)
-- 
