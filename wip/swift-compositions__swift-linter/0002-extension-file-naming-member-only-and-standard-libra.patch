diff --git a/Sources/Linter Core/Lint.File.Single.Runner.swift b/Sources/Linter Core/Lint.File.Single.Runner.swift
index 7d46363..f49c26e 100644
--- a/Sources/Linter Core/Lint.File.Single.Runner.swift	
