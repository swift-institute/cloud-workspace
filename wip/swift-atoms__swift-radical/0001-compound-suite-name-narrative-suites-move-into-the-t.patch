From 776365c8dd1db5d6a55ee7391d95a6c013fa8c95 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 19:34:06 +0000
Subject: [PATCH] compound suite name: narrative suites move into the test
 module's namespace `<File> Tests` (#239's layout), nested suites into
 extension <Path>.<Parent> (overnight/compound-suites.py); parse-checked;
 builds pending (coenttb/work#242)

---
 .../Radical Boundary Tests.swift              | 82 ++++++++++---------
 Tests/Radical Tests/Radical Tests.swift       | 32 ++++----
 2 files changed, 61 insertions(+), 53 deletions(-)

diff --git a/Tests/Radical Tests/Radical Boundary Tests.swift b/Tests/Radical Tests/Radical Boundary Tests.swift
index 61584d5..072edaf 100644
--- a/Tests/Radical Tests/Radical Boundary Tests.swift	
+++ b/Tests/Radical Tests/Radical Boundary Tests.swift	
@@ -1,49 +1,53 @@
 import Radical
 import Testing
 
-@Suite
-struct `Radical boundaries` {
-    @Test
-    func `zero and one reduce to degree one`() throws {
-        #expect(try Radical(radicand: 0, degree: 7).degree == 1)
-        #expect(try Radical(radicand: 1, degree: 7).rational == 1)
-    }
+enum `Radical Boundary Tests` {}
 
-    @Test
-    func `a non-positive degree or a negative radicand is rejected`() {
-        #expect(throws: Rational.Error.unrepresentable) { try Radical(radicand: 2, degree: 0) }
-        #expect(throws: Rational.Error.unrepresentable) { try Radical(radicand: 2, degree: -2) }
-        #expect(throws: Rational.Error.unrepresentable) { try Radical(radicand: -4, degree: 2) }
-    }
+extension `Radical Boundary Tests` {
+    @Suite
+    struct `Radical boundaries` {
+        @Test
+        func `zero and one reduce to degree one`() throws {
+            #expect(try Radical(radicand: 0, degree: 7).degree == 1)
+            #expect(try Radical(radicand: 1, degree: 7).rational == 1)
+        }
 
-    @Test
-    func `a negative rational keeps its sign at degree one`() {
-        #expect(Radical(-8).rational == -8)
-        #expect(Radical(-8).isNegative)
-        #expect(!Radical(0).isNegative)
-    }
+        @Test
+        func `a non-positive degree or a negative radicand is rejected`() {
+            #expect(throws: Rational.Error.unrepresentable) { try Radical(radicand: 2, degree: 0) }
+            #expect(throws: Rational.Error.unrepresentable) { try Radical(radicand: 2, degree: -2) }
+            #expect(throws: Rational.Error.unrepresentable) { try Radical(radicand: -4, degree: 2) }
+        }
 
-    @Test
-    func `roots of different degrees multiply at their least common degree`() throws {
-        let product = try Radical(radicand: 2, degree: 2).multiplied(by: Radical(radicand: 2, degree: 3))
-        #expect(product == (try Radical(radicand: 32, degree: 6)))
-        #expect(product.rational == nil)
-    }
+        @Test
+        func `a negative rational keeps its sign at degree one`() {
+            #expect(Radical(-8).rational == -8)
+            #expect(Radical(-8).isNegative)
+            #expect(!Radical(0).isNegative)
+        }
 
-    @Test
-    func `a large prime degree stays irreducible`() throws {
-        let root = try Radical(radicand: 2, degree: 1_000_003)
-        #expect(root.degree == 1_000_003)
-        #expect(abs(root.approximation - 1) < 1e-5)
-    }
+        @Test
+        func `roots of different degrees multiply at their least common degree`() throws {
+            let product = try Radical(radicand: 2, degree: 2).multiplied(by: Radical(radicand: 2, degree: 3))
+            #expect(product == (try Radical(radicand: 32, degree: 6)))
+            #expect(product.rational == nil)
+        }
+
+        @Test
+        func `a large prime degree stays irreducible`() throws {
+            let root = try Radical(radicand: 2, degree: 1_000_003)
+            #expect(root.degree == 1_000_003)
+            #expect(abs(root.approximation - 1) < 1e-5)
+        }
 
-    @Test
-    func `the numeric root is exact at its fixed points and monotone`() {
-        #expect(Radical.root(0, degree: 3) == 0)
-        #expect(Radical.root(1, degree: 3) == 1)
-        #expect(Radical.root(27, degree: 3) == 3)
-        #expect(Radical.root(0.25, degree: 2) == 0.5)
-        #expect(Radical.root(.infinity, degree: 2) == .infinity)
-        #expect(Radical.root(2, degree: 2) < Radical.root(3, degree: 2))
+        @Test
+        func `the numeric root is exact at its fixed points and monotone`() {
+            #expect(Radical.root(0, degree: 3) == 0)
+            #expect(Radical.root(1, degree: 3) == 1)
+            #expect(Radical.root(27, degree: 3) == 3)
+            #expect(Radical.root(0.25, degree: 2) == 0.5)
+            #expect(Radical.root(.infinity, degree: 2) == .infinity)
+            #expect(Radical.root(2, degree: 2) < Radical.root(3, degree: 2))
+        }
     }
 }
diff --git a/Tests/Radical Tests/Radical Tests.swift b/Tests/Radical Tests/Radical Tests.swift
index 5cf2de6..c9bc6d5 100644
--- a/Tests/Radical Tests/Radical Tests.swift	
+++ b/Tests/Radical Tests/Radical Tests.swift	
@@ -1,19 +1,23 @@
 import Radical
 import Testing
 
-@Suite struct `Radicals distinguish exact roots from approximations` {
-    @Test func `Exact and irrational roots remain distinct`() throws {
-        let root = try Radical(radicand: 2, degree: 2)
-        #expect(root.rational == nil)
-        #expect(try root.multiplied(by: root).rational == 2)
-        #expect(try Radical(radicand: 16, degree: 4).rational == 2)
-        #expect(try Radical(radicand: 64, degree: 6).rational == 2)
-        #expect(try Radical(radicand: 8, degree: 6) == root)
-        #expect(try Radical(radicand: Rational(numerator: 4, denominator: 9), degree: 2).rational == Rational("2/3"))
-        #expect(try Radical(-8).raised(to: Rational(numerator: 1, denominator: 3)).rational == -2)
-        #expect(throws: Rational.Error.unrepresentable) { try Radical(-1).raised(to: Rational(numerator: 1, denominator: 2)) }
-        #expect(throws: Rational.Error.zero) { try Radical(0).raised(to: -1) }
-        #expect(root.scaled(by: -2).isNegative)
-        #expect(abs(root.approximation - 2.0.squareRoot()) < 1e-14)
+enum `Radical Tests` {}
+
+extension `Radical Tests` {
+    @Suite struct `Radicals distinguish exact roots from approximations` {
+        @Test func `Exact and irrational roots remain distinct`() throws {
+            let root = try Radical(radicand: 2, degree: 2)
+            #expect(root.rational == nil)
+            #expect(try root.multiplied(by: root).rational == 2)
+            #expect(try Radical(radicand: 16, degree: 4).rational == 2)
+            #expect(try Radical(radicand: 64, degree: 6).rational == 2)
+            #expect(try Radical(radicand: 8, degree: 6) == root)
+            #expect(try Radical(radicand: Rational(numerator: 4, denominator: 9), degree: 2).rational == Rational("2/3"))
+            #expect(try Radical(-8).raised(to: Rational(numerator: 1, denominator: 3)).rational == -2)
+            #expect(throws: Rational.Error.unrepresentable) { try Radical(-1).raised(to: Rational(numerator: 1, denominator: 2)) }
+            #expect(throws: Rational.Error.zero) { try Radical(0).raised(to: -1) }
+            #expect(root.scaled(by: -2).isNegative)
+            #expect(abs(root.approximation - 2.0.squareRoot()) < 1e-14)
+        }
     }
 }
