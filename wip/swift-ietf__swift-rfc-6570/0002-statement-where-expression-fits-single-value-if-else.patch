From e87f50881df1359eabe111fa8d9ce77d0642a0e8 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:35:30 +0000
Subject: [PATCH 2/2] statement where expression fits: single-value if/else
 chains written as if expressions (type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 Sources/RFC 6570/RFC_6570.Template.swift | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/Sources/RFC 6570/RFC_6570.Template.swift b/Sources/RFC 6570/RFC_6570.Template.swift
index b836ff7..f9bb537 100644
--- a/Sources/RFC 6570/RFC_6570.Template.swift	
+++ b/Sources/RFC 6570/RFC_6570.Template.swift	
@@ -149,15 +149,15 @@ extension RFC_6570.Template {
             return encoded
         }
 
-        if value.isEmpty && op == .parameter {
+        return if value.isEmpty && op == .parameter {
 
-            return varspec.name
+            varspec.name
         } else if value.isEmpty {
 
-            return "\(varspec.name)="
+            "\(varspec.name)="
         } else {
 
-            return "\(varspec.name)=\(encoded)"
+            "\(varspec.name)=\(encoded)"
         }
     }
 
