From 5dbdb888102650fd24c72cad9ae1640a084a8bcb Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:35:33 +0000
Subject: [PATCH 6/6] statement where expression fits: single-value if/else
 chains written as if expressions (type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 Sources/Sockets/Sockets.Error.swift | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/Sources/Sockets/Sockets.Error.swift b/Sources/Sockets/Sockets.Error.swift
index 294c7fc..47b3106 100644
--- a/Sources/Sockets/Sockets.Error.swift
+++ b/Sources/Sockets/Sockets.Error.swift
@@ -93,10 +93,10 @@ extension Sockets.Error {
     }
 
     internal init(code: Error::Error.Code) {
-        if code == .ECONNRESET {
-            self = .connectionReset
+        self = if code == .ECONNRESET {
+            .connectionReset
         } else {
-            self = .platform(code)
+            .platform(code)
         }
     }
 }
