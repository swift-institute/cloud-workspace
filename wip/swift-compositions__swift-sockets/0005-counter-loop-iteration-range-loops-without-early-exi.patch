From 6d0a0ec427050115a16f1058e49d9b5596ceb63b Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:34:04 +0000
Subject: [PATCH 5/6] counter loop iteration: range loops without early exit
 written as forEach (type-check follows; Linux x86_64, Swift 6.4.2)
 (coenttb/work#242)

---
 .../Sockets.TCP.Listener.Tests.HalfClose Tests.swift            | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Tests/Sockets Tests/Sockets.TCP.Listener.Tests.HalfClose Tests.swift b/Tests/Sockets Tests/Sockets.TCP.Listener.Tests.HalfClose Tests.swift
index b4570d2..9721591 100644
--- a/Tests/Sockets Tests/Sockets.TCP.Listener.Tests.HalfClose Tests.swift	
+++ b/Tests/Sockets Tests/Sockets.TCP.Listener.Tests.HalfClose Tests.swift	
@@ -72,7 +72,7 @@ extension `Sockets.TCP.Listener Tests`.Tests.`Half Close` {
 
                 var received: [UInt8] = []
                 received.reserveCapacity(n)
-                for i in 0..<n { received.append(unsafe rbuf[i]) }
+                (0..<n).forEach { i in received.append(unsafe rbuf[i]) }
                 #expect(received == payload, "Client received its own payload echoed back.")
 
                 let eof = unsafe try await clientIO.read(from: descriptor, into: unsafe .init(rbuf))
