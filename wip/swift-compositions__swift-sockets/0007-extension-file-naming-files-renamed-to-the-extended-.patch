 4 files changed, 0 insertions(+), 0 deletions(-)
 rename Sources/Sockets/{IO+Blocking.swift => IO where Capabilities == Sockets.Capabilities.swift} (100%)
 rename Sources/Sockets/{Kernel.Event.Actor+Sockets.swift => Kernel.Event.Actor.swift} (100%)
 rename Sources/Sockets/{Kernel.Socket.Address.Storage+Port.swift => Kernel.Socket.Address.Storage.swift} (100%)
 rename Sources/Sockets/{Kernel.Thread.Actor+Sockets.swift => Kernel.Thread.Actor.swift} (100%)

diff --git a/Sources/Sockets/IO+Blocking.swift b/Sources/Sockets/IO where Capabilities == Sockets.Capabilities.swift
similarity index 100%
