diff --git a/Sources/Sockets/Sockets.Error.swift b/Sources/Sockets/Sockets.Error.swift
index 95334e5..294c7fc 100644
--- a/Sources/Sockets/Sockets.Error.swift
+++ b/Sources/Sockets/Sockets.Error.swift
@@ -1,4 +1,5 @@
 public import Kernel
+internal import IO_Kernel
 
 extension Sockets {
 
@@ -23,3 +24,79 @@ extension Sockets {
         case platform(Error::Error.Code)
     }
 }
+
+extension Sockets.Error {
+
+    internal init(_ failure: Kernel.Event.Failure) {
+        switch failure {
+        case .left(.cancelled):
+            self = .cancelled
+
+        case .left(.shutdown):
+            self = .ioShutdown
+
+        case .left(.timeout):
+            self = .timeout
+
+        case .right(let error):
+            switch error {
+            case .platform(let code):
+                self.init(code: code)
+
+            case .invalidDescriptor:
+                self = .descriptor(.invalid)
+
+            case .alreadyRegistered:
+                self = .registration(.duplicate)
+
+            case .notRegistered:
+                self = .registration(.missing)
+
+            case .deregistered:
+                self = .registration(.removed)
+
+            case .readClosed:
+                self = .closed(.read)
+
+            case .writeClosed:
+                self = .closed(.write)
+
+            case .notConnected:
+                self = .notConnected
+            }
+        }
+    }
+}
+
+extension Sockets.Error {
+
+    internal init(_ error: Kernel.IO.Read.Error) {
+        self.init(code: error.code)
+    }
+
+    internal init(_ error: Kernel.IO.Write.Error) {
+        self.init(code: error.code)
+    }
+
+    internal init(_ error: Kernel.Socket.Error) {
+        self.init(code: error.code)
+    }
+
+    internal init(_ error: Kernel.File.Control.Error) {
+        switch error {
+        case .handle(let error):
+            self = .descriptor(error)
+
+        case .platform(let error):
+            self.init(code: error.code)
+        }
+    }
+
+    internal init(code: Error::Error.Code) {
+        if code == .ECONNRESET {
+            self = .connectionReset
+        } else {
+            self = .platform(code)
+        }
+    }
+}
