From 37f2f8a9f8cfe64168ad23e2f45a3efdd52f698c Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 23:31:24 +0000
Subject: [PATCH 3/4] Revert the minimal-body moves in files where they raised
 a rule over its ratchet limit (coenttb/work#242)

---
 .../Operation Syntax/Operation.Analysis.swift | 32 +++++++--------
 .../Operation.Signature.swift                 | 40 +++++++++----------
 2 files changed, 34 insertions(+), 38 deletions(-)

diff --git a/Sources/Operation Syntax/Operation.Analysis.swift b/Sources/Operation Syntax/Operation.Analysis.swift
index d42dc7a..91d36b1 100644
--- a/Sources/Operation Syntax/Operation.Analysis.swift	
+++ b/Sources/Operation Syntax/Operation.Analysis.swift	
@@ -4,6 +4,21 @@ public import Type_Algebra_Syntax
 
 extension Operation {
     public struct Analysis {
+        public struct Symbol {
+            public struct Input {
+                public let parameter: Signature.Parameter
+                public let type: TypeSyntax
+            }
+
+            public let signature: Signature
+            public let name: String
+            public let variant: String?
+            public let isPrimary: Bool
+            public let inputs: [Input]
+            public let output: TypeSyntax
+            public let failure: TypeSyntax
+        }
+
         public let declaration: ProtocolDeclSyntax
         public let owner: TypeSyntax
         public let symbols: [Symbol]
@@ -60,23 +75,6 @@ extension Operation {
     }
 }
 
-extension Operation.Analysis {
-    public struct Symbol {
-        public struct Input {
-            public let parameter: Signature.Parameter
-            public let type: TypeSyntax
-        }
-
-        public let signature: Signature
-        public let name: String
-        public let variant: String?
-        public let isPrimary: Bool
-        public let inputs: [Input]
-        public let output: TypeSyntax
-        public let failure: TypeSyntax
-    }
-}
-
 extension Operation.Analysis.Symbol {
     public var caseName: String { "\(name.prefix(1).lowercased())\(name.dropFirst())" }
 
diff --git a/Sources/Operation Syntax/Operation.Signature.swift b/Sources/Operation Syntax/Operation.Signature.swift
index 54d4455..fb76ef6 100644
--- a/Sources/Operation Syntax/Operation.Signature.swift	
+++ b/Sources/Operation Syntax/Operation.Signature.swift	
@@ -3,6 +3,25 @@ public import Type_Algebra_Syntax
 
 extension Operation {
     public struct Signature {
+        public enum Convention {
+            case value
+            case borrowing
+            case consuming
+            case sending
+            case `inout`
+            case unsupported
+        }
+
+        public struct Parameter {
+            public let declaration: FunctionParameterSyntax
+            public let localName: TokenSyntax
+            public let valueType: TypeSyntax
+            public let closureType: TypeSyntax
+            public let convention: Convention
+            public let forwardingExpression: ExprSyntax
+            public let ownedExpression: ExprSyntax
+        }
+
         public let declaration: FunctionDeclSyntax
         public let name: TokenSyntax
         public let fullName: String
@@ -89,27 +108,6 @@ extension Operation {
     }
 }
 
-extension Operation.Signature {
-    public enum Convention {
-        case value
-        case borrowing
-        case consuming
-        case sending
-        case `inout`
-        case unsupported
-    }
-
-    public struct Parameter {
-        public let declaration: FunctionParameterSyntax
-        public let localName: TokenSyntax
-        public let valueType: TypeSyntax
-        public let closureType: TypeSyntax
-        public let convention: Convention
-        public let forwardingExpression: ExprSyntax
-        public let ownedExpression: ExprSyntax
-    }
-}
-
 extension Operation.Signature.Convention {
     var isBorrowing: Bool {
         if case .borrowing = self { true } else { false }
