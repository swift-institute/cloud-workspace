From 458c4d83f1cc29231352341d825bc82fac376488 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:32:47 +0000
Subject: [PATCH 10/11] compound type name, compound identifier: single-file
 internal types made fileprivate, package members used only in their target
 made internal (type-check follows; Linux x86_64, Swift 6.4.2)
 (coenttb/work#242)

---
 Tests/Operation Tests/Fixtures/Wrong Failure.swift |  2 +-
 Tests/Operation Tests/Fixtures/Wrong Output.swift  |  2 +-
 Tests/Operation Tests/Operation Tests.swift        | 10 +++++-----
 3 files changed, 7 insertions(+), 7 deletions(-)

diff --git a/Tests/Operation Tests/Fixtures/Wrong Failure.swift b/Tests/Operation Tests/Fixtures/Wrong Failure.swift
index fa51679..681f70c 100644
--- a/Tests/Operation Tests/Fixtures/Wrong Failure.swift	
+++ b/Tests/Operation Tests/Fixtures/Wrong Failure.swift	
@@ -1,6 +1,6 @@
 import Operation
 
-struct FailureA: ~Copyable {}
+fileprivate struct FailureA: ~Copyable {}
 struct FailureB: ~Copyable {}
 enum Use: Operation.Symbol {
     typealias Input = Int
diff --git a/Tests/Operation Tests/Fixtures/Wrong Output.swift b/Tests/Operation Tests/Fixtures/Wrong Output.swift
index d4ab0f8..1aa8b22 100644
--- a/Tests/Operation Tests/Fixtures/Wrong Output.swift	
+++ b/Tests/Operation Tests/Fixtures/Wrong Output.swift	
@@ -1,6 +1,6 @@
 import Operation
 
-struct OutputA: ~Copyable {}
+fileprivate struct OutputA: ~Copyable {}
 struct OutputB: ~Copyable {}
 enum Use: Operation.Symbol {
     typealias Input = Int
diff --git a/Tests/Operation Tests/Operation Tests.swift b/Tests/Operation Tests/Operation Tests.swift
index d6d739d..152de9e 100644
--- a/Tests/Operation Tests/Operation Tests.swift	
+++ b/Tests/Operation Tests/Operation Tests.swift	
@@ -43,8 +43,8 @@ extension `Operation Tests` {
             typealias Failure = Refusal
         }
 
-        struct ScopedOutput: ~Escapable {}
-        struct ScopedFailure: ~Escapable {}
+        fileprivate struct ScopedOutput: ~Escapable {}
+        fileprivate struct ScopedFailure: ~Escapable {}
 
         enum Observe: Operation.Symbol {
             typealias Input = String
@@ -68,7 +68,7 @@ extension `Operation Tests` {
             typealias Failure = Refusal
         }
 
-        enum InspectSpan: Operation.Symbol {
+        fileprivate enum InspectSpan: Operation.Symbol {
             typealias Input = Span<Int>
             typealias Output = Void
             typealias Failure = Never
@@ -83,13 +83,13 @@ extension `Operation Tests` {
             }
         }
 
-        enum InspectLoan: Operation.Symbol {
+        fileprivate enum InspectLoan: Operation.Symbol {
             typealias Input = Loan
             typealias Output = Void
             typealias Failure = Never
         }
 
-        enum ReadingFailure: Swift::Error, Equatable {
+        fileprivate enum ReadingFailure: Swift::Error, Equatable {
             case rejected(Int)
         }
 
