From 9cb306ff39aa82d7b759e27f725910a3c458c966 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 20:52:45 +0000
Subject: [PATCH 1/4] extension file naming: member-only and
 standard-library-conformance extension files merge into their type's own file
 (overnight/merge-extension-files.py); single type per file: additional types
 move to their own <Parent>.<Name>.swift inside the container's extension
 (overnight/split-types.py); parse-checked; builds pending (coenttb/work#242)

---
 Sources/Operation/Operation.Composed.swift | 11 +++++++++++
 Sources/Operation/Operation.Operable.swift |  5 -----
 2 files changed, 11 insertions(+), 5 deletions(-)
 create mode 100644 Sources/Operation/Operation.Composed.swift

diff --git a/Sources/Operation/Operation.Composed.swift b/Sources/Operation/Operation.Composed.swift
new file mode 100644
index 0000000..b7ab08d
--- /dev/null
+++ b/Sources/Operation/Operation.Composed.swift
@@ -0,0 +1,11 @@
+import _Concurrency
+
+import _Concurrency
+
+extension Operation {
+    public protocol Composed: Operable {
+        associatedtype Call: ~Copyable, Coproduct where Call.Owner == Owner
+
+        static func call(_ input: consuming Input) -> Call
+    }
+}
diff --git a/Sources/Operation/Operation.Operable.swift b/Sources/Operation/Operation.Operable.swift
index 52f3885..e1bae69 100644
--- a/Sources/Operation/Operation.Operable.swift
+++ b/Sources/Operation/Operation.Operable.swift
@@ -5,9 +5,4 @@ extension Operation {
         static func run(_ owner: Owner, _ input: consuming Input) async throws -> Output
     }
 
-    public protocol Composed: Operable {
-        associatedtype Call: ~Copyable, Coproduct where Call.Owner == Owner
-
-        static func call(_ input: consuming Input) -> Call
-    }
 }
