 1 file changed, 19 insertions(+), 21 deletions(-)

diff --git a/Sources/Operation Syntax/Operation.Signature.swift b/Sources/Operation Syntax/Operation.Signature.swift
index 54d4455..fb76ef6 100644
--- a/Sources/Operation Syntax/Operation.Signature.swift	
+++ b/Sources/Operation Syntax/Operation.Signature.swift	
