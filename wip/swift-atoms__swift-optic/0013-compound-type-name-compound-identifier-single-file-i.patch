From 3a1c99807b1739c09a8cc55630d683350c6c520d Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:32:47 +0000
Subject: [PATCH 13/21] compound type name, compound identifier: single-file
 internal types made fileprivate, package members used only in their target
 made internal (type-check follows; Linux x86_64, Swift 6.4.2)
 (coenttb/work#242)

---
 Tests/Optic Tests/Fixtures/Adapter Capabilities.swift     | 8 ++++----
 .../Fixtures/Nonescapable Escaping Result.swift           | 6 +++---
 Tests/Optic Tests/Optic.Prism Tests.swift                 | 4 ++--
 3 files changed, 9 insertions(+), 9 deletions(-)

diff --git a/Tests/Optic Tests/Fixtures/Adapter Capabilities.swift b/Tests/Optic Tests/Fixtures/Adapter Capabilities.swift
index 5df7519..0801966 100644
--- a/Tests/Optic Tests/Fixtures/Adapter Capabilities.swift	
+++ b/Tests/Optic Tests/Fixtures/Adapter Capabilities.swift	
@@ -1,10 +1,10 @@
 import Either
 import Optic
 
-enum FirstForward: Swift.Error { case failed }
-enum FirstBackward: Swift.Error { case failed }
-enum SecondForward: Swift.Error { case failed }
-enum SecondBackward: Swift.Error { case failed }
+fileprivate enum FirstForward: Swift.Error { case failed }
+fileprivate enum FirstBackward: Swift.Error { case failed }
+fileprivate enum SecondForward: Swift.Error { case failed }
+fileprivate enum SecondBackward: Swift.Error { case failed }
 
 func firstForward(_ value: Int) throws(FirstForward) -> String {
     guard value >= 0 else { throw .failed }
diff --git a/Tests/Optic Tests/Fixtures/Nonescapable Escaping Result.swift b/Tests/Optic Tests/Fixtures/Nonescapable Escaping Result.swift
index de3fa4e..23ab43b 100644
--- a/Tests/Optic Tests/Fixtures/Nonescapable Escaping Result.swift	
+++ b/Tests/Optic Tests/Fixtures/Nonescapable Escaping Result.swift	
@@ -1,15 +1,15 @@
 import ArrowFixture
 import Either
 
-struct ScopedSource: ~Escapable {
+fileprivate struct ScopedSource: ~Escapable {
     let value: Int
 }
 
-struct ScopedTarget: ~Escapable {
+fileprivate struct ScopedTarget: ~Escapable {
     let value: Int
 }
 
-struct ScopedFocus: ~Escapable {
+fileprivate struct ScopedFocus: ~Escapable {
     let value: Int
 }
 
diff --git a/Tests/Optic Tests/Optic.Prism Tests.swift b/Tests/Optic Tests/Optic.Prism Tests.swift
index 6069af5..dc50b71 100644
--- a/Tests/Optic Tests/Optic.Prism Tests.swift	
+++ b/Tests/Optic Tests/Optic.Prism Tests.swift	
@@ -156,7 +156,7 @@ extension `Optic.Prism Tests` {
     }
 }
 
-enum TestEnum: Hashable, Sendable {
+fileprivate enum TestEnum: Hashable, Sendable {
     case intCase(Int)
     case stringCase(String)
     case voidCase
@@ -438,7 +438,7 @@ extension `Optic.Prism Tests` {
     }
 }
 
-enum TestError: Swift::Error, Hashable, Sendable {
+fileprivate enum TestError: Swift::Error, Hashable, Sendable {
     case test
     case other
 }
