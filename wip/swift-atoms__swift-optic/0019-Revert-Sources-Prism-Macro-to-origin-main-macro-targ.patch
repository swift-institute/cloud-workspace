From 76ec8666637168026d7d1092103218ffabb22026 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 07:06:19 +0000
Subject: [PATCH 19/21] Revert Sources/Prism Macro to origin/main: macro
 targets aren't type-checkable outside the build (coenttb/work#242)

---
 Sources/Prism Macro/Prisms.swift  | 4 ++--
 Sources/Prism Macro/exports.swift | 2 --
 2 files changed, 2 insertions(+), 4 deletions(-)
 delete mode 100644 Sources/Prism Macro/exports.swift

diff --git a/Sources/Prism Macro/Prisms.swift b/Sources/Prism Macro/Prisms.swift
index efeb8bd..397caa5 100644
--- a/Sources/Prism Macro/Prisms.swift	
+++ b/Sources/Prism Macro/Prisms.swift	
@@ -1,5 +1,5 @@
-import Either
-import Optic
+@_exported import Either
+@_exported import Optic
 
 @attached(member, names: named(Prisms), named(prisms))
 @attached(extension, conformances: __OpticPrismAccessible)
diff --git a/Sources/Prism Macro/exports.swift b/Sources/Prism Macro/exports.swift
deleted file mode 100644
index 40b2e2b..0000000
--- a/Sources/Prism Macro/exports.swift	
+++ /dev/null
@@ -1,2 +0,0 @@
-@_exported public import Either
-@_exported public import Optic
-- 
