Subject: [PATCH 20/21] Revert Sources/Traversal Macro to origin/main: macro
 targets aren't type-checkable outside the build (coenttb/work#242)

---
 Sources/Traversal Macro/Traversals.swift | 4 ++--
 Sources/Traversal Macro/exports.swift    | 2 --
 2 files changed, 2 insertions(+), 4 deletions(-)
 delete mode 100644 Sources/Traversal Macro/exports.swift

diff --git a/Sources/Traversal Macro/Traversals.swift b/Sources/Traversal Macro/Traversals.swift
index bc46979..578de81 100644
--- a/Sources/Traversal Macro/Traversals.swift	
+++ b/Sources/Traversal Macro/Traversals.swift	
@@ -1,5 +1,5 @@
-import Lens_Macro
-import Optic
+@_exported import Lens_Macro
+@_exported import Optic
 
 @attached(member, names: named(Traversals), named(traversals))
 public macro Traversals() =
diff --git a/Sources/Traversal Macro/exports.swift b/Sources/Traversal Macro/exports.swift
deleted file mode 100644
index abd2e25..0000000
--- a/Sources/Traversal Macro/exports.swift	
+++ /dev/null
@@ -1,2 +0,0 @@
-@_exported public import Lens_Macro
-@_exported public import Optic
