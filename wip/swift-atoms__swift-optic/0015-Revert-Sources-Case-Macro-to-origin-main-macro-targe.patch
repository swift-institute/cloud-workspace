From 4b34697a0925bf716da43053c9dc514984f2b9b2 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 07:06:19 +0000
Subject: [PATCH 15/21] Revert Sources/Case Macro to origin/main: macro targets
 aren't type-checkable outside the build (coenttb/work#242)

---
 Sources/Case Macro/Cases.swift   | 6 +++---
 Sources/Case Macro/exports.swift | 3 ---
 2 files changed, 3 insertions(+), 6 deletions(-)
 delete mode 100644 Sources/Case Macro/exports.swift

diff --git a/Sources/Case Macro/Cases.swift b/Sources/Case Macro/Cases.swift
index 1540d12..91f41e6 100644
--- a/Sources/Case Macro/Cases.swift	
+++ b/Sources/Case Macro/Cases.swift	
@@ -1,6 +1,6 @@
-import Fold_Macro
-import Optic
-import Prism_Macro
+@_exported import Fold_Macro
+@_exported import Optic
+@_exported import Prism_Macro
 
 @attached(member, names: named(Cases), named(cases))
 public macro Cases() =
diff --git a/Sources/Case Macro/exports.swift b/Sources/Case Macro/exports.swift
deleted file mode 100644
index 5644897..0000000
--- a/Sources/Case Macro/exports.swift	
+++ /dev/null
@@ -1,3 +0,0 @@
-@_exported public import Fold_Macro
-@_exported public import Optic
-@_exported public import Prism_Macro
-- 
