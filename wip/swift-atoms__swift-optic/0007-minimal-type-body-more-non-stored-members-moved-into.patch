From 4572495f4f67f2cfb25424f2b0b6a0ca42a5a012 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:27:41 +0000
Subject: [PATCH 07/14] minimal type body: more non-stored members moved into
 an extension of their type (batch 10; type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 .../Isomorphisms.swift                        | 45 +++++++++++--------
 1 file changed, 27 insertions(+), 18 deletions(-)

diff --git a/Sources/Optic Algebra Integration/Isomorphisms.swift b/Sources/Optic Algebra Integration/Isomorphisms.swift
index 1540231..4a29ce0 100644
--- a/Sources/Optic Algebra Integration/Isomorphisms.swift	
+++ b/Sources/Optic Algebra Integration/Isomorphisms.swift	
@@ -19,8 +19,6 @@ where
 }
 
 public enum AlgebraicIsomorphisms {
-    public static func productAssociativity<A, B, C>()
-        -> Optic<
             Pair<Pair<A, B>, C>, Pair<Pair<A, B>, C>, Pair<A, Pair<B, C>>, Pair<A, Pair<B, C>>
         >.Isomorphism
     {
@@ -29,20 +27,6 @@ public enum AlgebraicIsomorphisms {
             backward: { Pair(Pair($0.first, $0.second.first), $0.second.second) }
         )
     }
-    public static func leftUnit<A>() -> Optic<Pair<Void, A>, Pair<Void, A>, A, A>.Isomorphism {
-        .init(forward: { $0.second }, backward: { Pair((), $0) })
-    }
-    public static func rightUnit<A>() -> Optic<Pair<A, Void>, Pair<A, Void>, A, A>.Isomorphism {
-        .init(forward: { $0.first }, backward: { Pair($0, ()) })
-    }
-    public static func leftZero<A>() -> Optic<Either<Never, A>, Either<Never, A>, A, A>.Isomorphism {
-        .init(forward: { $0.value }, backward: { .right($0) })
-    }
-    public static func rightZero<A>() -> Optic<Either<A, Never>, Either<A, Never>, A, A>.Isomorphism {
-        .init(forward: { $0.value }, backward: { .left($0) })
-    }
-    public static func sumAssociativity<A, B, C>()
-        -> Optic<
             Either<Either<A, B>, C>, Either<Either<A, B>, C>, Either<A, Either<B, C>>, Either<A, Either<B, C>>
         >.Isomorphism
     {
@@ -63,8 +47,6 @@ public enum AlgebraicIsomorphisms {
             }
         )
     }
-    public static func distributivity<A, B, C>()
-        -> Optic<
             Pair<A, Either<B, C>>, Pair<A, Either<B, C>>, Either<Pair<A, B>, Pair<A, C>>, Either<Pair<A, B>, Pair<A, C>>
         >.Isomorphism
     {
@@ -74,3 +56,30 @@ public enum AlgebraicIsomorphisms {
         )
     }
 }
+
+extension AlgebraicIsomorphisms {
+    public static func productAssociativity<A, B, C>()
+        -> Optic<
+
+    public static func leftUnit<A>() -> Optic<Pair<Void, A>, Pair<Void, A>, A, A>.Isomorphism {
+        .init(forward: { $0.second }, backward: { Pair((), $0) })
+    }
+
+    public static func rightUnit<A>() -> Optic<Pair<A, Void>, Pair<A, Void>, A, A>.Isomorphism {
+        .init(forward: { $0.first }, backward: { Pair($0, ()) })
+    }
+
+    public static func leftZero<A>() -> Optic<Either<Never, A>, Either<Never, A>, A, A>.Isomorphism {
+        .init(forward: { $0.value }, backward: { .right($0) })
+    }
+
+    public static func rightZero<A>() -> Optic<Either<A, Never>, Either<A, Never>, A, A>.Isomorphism {
+        .init(forward: { $0.value }, backward: { .left($0) })
+    }
+
+    public static func sumAssociativity<A, B, C>()
+        -> Optic<
+
+    public static func distributivity<A, B, C>()
+        -> Optic<
+}
