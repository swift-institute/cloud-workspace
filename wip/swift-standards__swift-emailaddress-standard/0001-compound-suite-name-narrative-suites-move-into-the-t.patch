Date: Sat, 7 Nov 2026 19:34:20 +0000
Subject: [PATCH 1/2] compound suite name: narrative suites move into the test
 module's namespace `<File> Tests` (#239's layout), nested suites into
 extension <Path>.<Parent> (overnight/compound-suites.py); parse-checked;
 builds pending (coenttb/work#242)

---
 ...Address Foundation Integration Tests.swift | 78 +++++++--------
 .../EmailAddress Round Trip Tests.swift       | 94 ++++++++++---------
 .../EmailAddress+RFC2822 Tests.swift          | 72 +++++++-------
 3 files changed, 126 insertions(+), 118 deletions(-)

diff --git a/Tests/EmailAddress Foundation Integration Tests/EmailAddress Foundation Integration Tests.swift b/Tests/EmailAddress Foundation Integration Tests/EmailAddress Foundation Integration Tests.swift
index dde3546..2d53d8f 100644
--- a/Tests/EmailAddress Foundation Integration Tests/EmailAddress Foundation Integration Tests.swift	
+++ b/Tests/EmailAddress Foundation Integration Tests/EmailAddress Foundation Integration Tests.swift	
@@ -5,43 +5,45 @@ import RFC_1123
 import RFC_6531
 import Testing
 
-@Suite
-struct `EmailAddress Foundation Integration Tests` {
-
-    @Test
-    func `an email address round-trips through JSON`() throws {
-        let email = EmailAddress(
-            displayName: "John Doe",
-            localPart: try RFC_6531.Mailbox.LocalPart("john.doe"),
-            domain: try RFC_1123.Domain("example.com")
-        )
-
-        let data = try JSONEncoder().encode(email)
-
-        #expect(try JSONDecoder().decode(EmailAddress.self, from: data) == email)
-    }
-
-    @Test
-    func `an email address encodes as its mailbox text`() throws {
-        let email = EmailAddress(
-            localPart: try RFC_6531.Mailbox.LocalPart("user"),
-            domain: try RFC_1123.Domain("example.com")
-        )
-
-        let data = try JSONEncoder().encode(email)
-
-        #expect(String(decoding: data, as: UTF8.self) == #""user@example.com""#)
-        #expect(try JSONDecoder().decode(EmailAddress.self, from: data) == email)
-    }
-
-    @Test
-    func `a display name is kept in the mailbox text`() throws {
-        let data = Data(#""John Doe <john.doe@example.com>""#.utf8)
-
-        let email = try JSONDecoder().decode(EmailAddress.self, from: data)
-
-        #expect(email.displayName == "John Doe")
-        #expect(email.address == "john.doe@example.com")
-        #expect(try JSONEncoder().encode(email) == data)
+extension `EmailAddress Foundation Integration Tests`.`EmailAddress Foundation Integration Tests` {
+    @Suite
+    struct `EmailAddress Foundation Integration Tests` {
+
+        @Test
+        func `an email address round-trips through JSON`() throws {
+            let email = EmailAddress(
+                displayName: "John Doe",
+                localPart: try RFC_6531.Mailbox.LocalPart("john.doe"),
+                domain: try RFC_1123.Domain("example.com")
+            )
+
+            let data = try JSONEncoder().encode(email)
+
+            #expect(try JSONDecoder().decode(EmailAddress.self, from: data) == email)
+        }
+
+        @Test
+        func `an email address encodes as its mailbox text`() throws {
+            let email = EmailAddress(
+                localPart: try RFC_6531.Mailbox.LocalPart("user"),
+                domain: try RFC_1123.Domain("example.com")
+            )
+
+            let data = try JSONEncoder().encode(email)
+
+            #expect(String(decoding: data, as: UTF8.self) == #""user@example.com""#)
+            #expect(try JSONDecoder().decode(EmailAddress.self, from: data) == email)
+        }
+
+        @Test
+        func `a display name is kept in the mailbox text`() throws {
+            let data = Data(#""John Doe <john.doe@example.com>""#.utf8)
+
+            let email = try JSONDecoder().decode(EmailAddress.self, from: data)
+
+            #expect(email.displayName == "John Doe")
+            #expect(email.address == "john.doe@example.com")
+            #expect(try JSONEncoder().encode(email) == data)
+        }
     }
 }
