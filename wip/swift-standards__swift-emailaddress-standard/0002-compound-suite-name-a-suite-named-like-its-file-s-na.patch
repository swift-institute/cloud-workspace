From 8241739cbfd20d94620904d9362bd7bfb2d759fc Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 19:43:41 +0000
Subject: [PATCH 2/3] compound suite name: a suite named like its file's
 namespace stays in place (overnight/compound-suites.py) (coenttb/work#242)

---
 ...Address Foundation Integration Tests.swift | 78 ++++++++-------
 .../EmailAddress Round Trip Tests.swift       | 94 +++++++++----------
 2 files changed, 84 insertions(+), 88 deletions(-)

diff --git a/Tests/EmailAddress Foundation Integration Tests/EmailAddress Foundation Integration Tests.swift b/Tests/EmailAddress Foundation Integration Tests/EmailAddress Foundation Integration Tests.swift
index 2d53d8f..dde3546 100644
--- a/Tests/EmailAddress Foundation Integration Tests/EmailAddress Foundation Integration Tests.swift	
+++ b/Tests/EmailAddress Foundation Integration Tests/EmailAddress Foundation Integration Tests.swift	
@@ -5,45 +5,43 @@ import RFC_1123
 import RFC_6531
 import Testing
 
-extension `EmailAddress Foundation Integration Tests`.`EmailAddress Foundation Integration Tests` {
-    @Suite
-    struct `EmailAddress Foundation Integration Tests` {
-
-        @Test
-        func `an email address round-trips through JSON`() throws {
-            let email = EmailAddress(
-                displayName: "John Doe",
-                localPart: try RFC_6531.Mailbox.LocalPart("john.doe"),
-                domain: try RFC_1123.Domain("example.com")
-            )
-
-            let data = try JSONEncoder().encode(email)
-
-            #expect(try JSONDecoder().decode(EmailAddress.self, from: data) == email)
-        }
-
-        @Test
-        func `an email address encodes as its mailbox text`() throws {
-            let email = EmailAddress(
-                localPart: try RFC_6531.Mailbox.LocalPart("user"),
-                domain: try RFC_1123.Domain("example.com")
-            )
-
-            let data = try JSONEncoder().encode(email)
-
-            #expect(String(decoding: data, as: UTF8.self) == #""user@example.com""#)
-            #expect(try JSONDecoder().decode(EmailAddress.self, from: data) == email)
-        }
-
-        @Test
-        func `a display name is kept in the mailbox text`() throws {
-            let data = Data(#""John Doe <john.doe@example.com>""#.utf8)
-
-            let email = try JSONDecoder().decode(EmailAddress.self, from: data)
-
-            #expect(email.displayName == "John Doe")
-            #expect(email.address == "john.doe@example.com")
-            #expect(try JSONEncoder().encode(email) == data)
-        }
+@Suite
+struct `EmailAddress Foundation Integration Tests` {
+
+    @Test
+    func `an email address round-trips through JSON`() throws {
+        let email = EmailAddress(
+            displayName: "John Doe",
+            localPart: try RFC_6531.Mailbox.LocalPart("john.doe"),
+            domain: try RFC_1123.Domain("example.com")
+        )
+
+        let data = try JSONEncoder().encode(email)
+
+        #expect(try JSONDecoder().decode(EmailAddress.self, from: data) == email)
+    }
+
+    @Test
+    func `an email address encodes as its mailbox text`() throws {
+        let email = EmailAddress(
+            localPart: try RFC_6531.Mailbox.LocalPart("user"),
+            domain: try RFC_1123.Domain("example.com")
+        )
+
+        let data = try JSONEncoder().encode(email)
+
+        #expect(String(decoding: data, as: UTF8.self) == #""user@example.com""#)
+        #expect(try JSONDecoder().decode(EmailAddress.self, from: data) == email)
+    }
+
+    @Test
+    func `a display name is kept in the mailbox text`() throws {
+        let data = Data(#""John Doe <john.doe@example.com>""#.utf8)
+
+        let email = try JSONDecoder().decode(EmailAddress.self, from: data)
+
+        #expect(email.displayName == "John Doe")
+        #expect(email.address == "john.doe@example.com")
+        #expect(try JSONEncoder().encode(email) == data)
     }
 }
diff --git a/Tests/EmailAddress Standard Tests/EmailAddress Round Trip Tests.swift b/Tests/EmailAddress Standard Tests/EmailAddress Round Trip Tests.swift
index 2de6ae6..7e838de 100644
--- a/Tests/EmailAddress Standard Tests/EmailAddress Round Trip Tests.swift	
+++ b/Tests/EmailAddress Standard Tests/EmailAddress Round Trip Tests.swift	
@@ -5,66 +5,64 @@ import RFC_5322
 import RFC_6531
 import Testing
 
-extension `EmailAddress Round Trip Tests`.`EmailAddress Round Trip Tests` {
-    @Suite
-    struct `EmailAddress Round Trip Tests` {
+@Suite
+struct `EmailAddress Round Trip Tests` {
 
-        @Test
-        func `an RFC 5321 email address survives a round trip through an email address`() throws {
-            let original = try RFC_5321.EmailAddress("user@example.com")
+    @Test
+    func `an RFC 5321 email address survives a round trip through an email address`() throws {
+        let original = try RFC_5321.EmailAddress("user@example.com")
 
-            let converted = try #require(try EmailAddress(rfc5321: original).rfc5321)
+        let converted = try #require(try EmailAddress(rfc5321: original).rfc5321)
 
-            #expect(converted == original)
-            #expect(converted.address == original.address)
-            #expect(converted.displayName == original.displayName)
-            #expect(converted.localPart.description == original.localPart.description)
-            #expect(converted.domain.name == original.domain.name)
-        }
+        #expect(converted == original)
+        #expect(converted.address == original.address)
+        #expect(converted.displayName == original.displayName)
+        #expect(converted.localPart.description == original.localPart.description)
+        #expect(converted.domain.name == original.domain.name)
+    }
 
-        @Test
-        func `an RFC 5322 mailbox survives a round trip through an email address`() throws {
-            let original = try RFC_5322.Mailbox("John Doe <john@example.com>")
+    @Test
+    func `an RFC 5322 mailbox survives a round trip through an email address`() throws {
+        let original = try RFC_5322.Mailbox("John Doe <john@example.com>")
 
-            let converted = try #require(try EmailAddress(rfc5322: original).rfc5322)
+        let converted = try #require(try EmailAddress(rfc5322: original).rfc5322)
 
-            #expect(converted.address == original.address)
-            #expect(converted.displayName == original.displayName)
-            #expect(converted.displayName == "John Doe")
-        }
+        #expect(converted.address == original.address)
+        #expect(converted.displayName == original.displayName)
+        #expect(converted.displayName == "John Doe")
+    }
 
-        @Test
-        func `an RFC 6531 mailbox survives a round trip through an email address`() throws {
-            let original = try RFC_6531.Mailbox("用户@example.com")
+    @Test
+    func `an RFC 6531 mailbox survives a round trip through an email address`() throws {
+        let original = try RFC_6531.Mailbox("用户@example.com")
 
-            let converted = EmailAddress(rfc6531: original).rfc6531
+        let converted = EmailAddress(rfc6531: original).rfc6531
 
-            #expect(converted == original)
-            #expect(converted.address == original.address)
-            #expect(converted.displayName == original.displayName)
-            #expect(RFC_6531.Mailbox(EmailAddress(rfc6531: original)) == original)
-        }
+        #expect(converted == original)
+        #expect(converted.address == original.address)
+        #expect(converted.displayName == original.displayName)
+        #expect(RFC_6531.Mailbox(EmailAddress(rfc6531: original)) == original)
+    }
 
-        @Test
-        func `an ASCII email address has the same address in every RFC form`() throws {
-            let email = EmailAddress(
-                localPart: try RFC_6531.Mailbox.LocalPart("test"),
-                domain: try RFC_1123.Domain("example.com")
-            )
+    @Test
+    func `an ASCII email address has the same address in every RFC form`() throws {
+        let email = EmailAddress(
+            localPart: try RFC_6531.Mailbox.LocalPart("test"),
+            domain: try RFC_1123.Domain("example.com")
+        )
 
-            #expect(email.rfc5321?.address == "test@example.com")
-            #expect(email.rfc5322?.address == "test@example.com")
-            #expect(email.rfc6531.address == "test@example.com")
-        }
+        #expect(email.rfc5321?.address == "test@example.com")
+        #expect(email.rfc5322?.address == "test@example.com")
+        #expect(email.rfc6531.address == "test@example.com")
+    }
 
-        @Test
-        func `an internationalized RFC 6531 mailbox keeps only its RFC 6531 form`() throws {
-            let email = EmailAddress(rfc6531: try RFC_6531.Mailbox("用户@example.com"))
+    @Test
+    func `an internationalized RFC 6531 mailbox keeps only its RFC 6531 form`() throws {
+        let email = EmailAddress(rfc6531: try RFC_6531.Mailbox("用户@example.com"))
 
-            #expect(email.isInternationalized)
-            #expect(email.rfc5321 == nil)
-            #expect(email.rfc5322 == nil)
-            #expect(email.rfc6531.address == "用户@example.com")
-        }
+        #expect(email.isInternationalized)
+        #expect(email.rfc5321 == nil)
+        #expect(email.rfc5322 == nil)
+        #expect(email.rfc6531.address == "用户@example.com")
     }
 }
