From e171a215caf3808012c54301c65f2da1744a607e Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 18:49:04 +0000
Subject: [PATCH] compound suite name: narrative suites move into extension
 <Type> named after their test file, nested suites into extension
 <Type>.<Parent> (overnight/compound-suites.py); parse-checked; builds pending
 (coenttb/work#242)

---
 .../Domain Name System Tests/DNS Tests.swift  | 28 +++++++++++--------
 1 file changed, 16 insertions(+), 12 deletions(-)

diff --git a/Tests/Domain Name System Tests/DNS Tests.swift b/Tests/Domain Name System Tests/DNS Tests.swift
index aa77446..110d774 100644
--- a/Tests/Domain Name System Tests/DNS Tests.swift	
+++ b/Tests/Domain Name System Tests/DNS Tests.swift	
@@ -4,14 +4,16 @@ import Testing
 
 @testable import Domain_Name_System
 
-@Suite
-struct `DNS Query Tests` {
-    @Suite struct Unit {}
-    @Suite struct `Edge Case` {}
-    @Suite struct Integration {}
+extension DNS {
+    @Suite
+    struct `DNS Query Tests` {
+        @Suite struct Unit {}
+        @Suite struct `Edge Case` {}
+        @Suite struct Integration {}
+    }
 }
 
-extension `DNS Query Tests`.Unit {
+extension DNS.`DNS Query Tests`.Unit {
     @Test
     func `query defaults to any family and no timeout`() throws(RFC_1035.Domain.Error) {
         let name = try RFC_1035.Domain("example.com")
@@ -43,11 +45,13 @@ extension `DNS Query Tests`.Unit {
     }
 }
 
-@Suite
-struct `DNS Resolver Seam Tests` {
-    @Suite struct Unit {}
-    @Suite struct `Edge Case` {}
-    @Suite struct Integration {}
+extension DNS {
+    @Suite
+    struct `DNS Resolver Seam Tests` {
+        @Suite struct Unit {}
+        @Suite struct `Edge Case` {}
+        @Suite struct Integration {}
+    }
 }
 
 private struct Fixed: Sendable {
@@ -75,7 +79,7 @@ extension Failing: DNS.Resolver.`Protocol` {
     }
 }
 
-extension `DNS Resolver Seam Tests`.Unit {
+extension DNS.`DNS Resolver Seam Tests`.Unit {
     @Test
     func `provider order is preserved without family re-ranking`() async throws(RFC_1035.Domain
         .Error)
