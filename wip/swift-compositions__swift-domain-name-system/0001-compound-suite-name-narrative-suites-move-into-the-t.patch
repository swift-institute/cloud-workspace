From 2a5dabdebe29abae762070cb020125ea0a307602 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 19:34:23 +0000
Subject: [PATCH] compound suite name: narrative suites move into the test
 module's namespace `<File> Tests` (#239's layout), nested suites into
 extension <Path>.<Parent> (overnight/compound-suites.py); parse-checked;
 builds pending (coenttb/work#242)

---
 .../Domain Name System Tests/DNS Tests.swift  | 30 +++++++++++--------
 1 file changed, 18 insertions(+), 12 deletions(-)

diff --git a/Tests/Domain Name System Tests/DNS Tests.swift b/Tests/Domain Name System Tests/DNS Tests.swift
index aa77446..16dea97 100644
--- a/Tests/Domain Name System Tests/DNS Tests.swift	
+++ b/Tests/Domain Name System Tests/DNS Tests.swift	
@@ -4,14 +4,18 @@ import Testing
 
 @testable import Domain_Name_System
 
-@Suite
-struct `DNS Query Tests` {
-    @Suite struct Unit {}
-    @Suite struct `Edge Case` {}
-    @Suite struct Integration {}
+enum `DNS Tests` {}
+
+extension `DNS Tests` {
+    @Suite
+    struct `DNS Query Tests` {
+        @Suite struct Unit {}
+        @Suite struct `Edge Case` {}
+        @Suite struct Integration {}
+    }
 }
 
-extension `DNS Query Tests`.Unit {
+extension `DNS Tests`.`DNS Query Tests`.Unit {
     @Test
     func `query defaults to any family and no timeout`() throws(RFC_1035.Domain.Error) {
         let name = try RFC_1035.Domain("example.com")
@@ -43,11 +47,13 @@ extension `DNS Query Tests`.Unit {
     }
 }
 
-@Suite
-struct `DNS Resolver Seam Tests` {
-    @Suite struct Unit {}
-    @Suite struct `Edge Case` {}
-    @Suite struct Integration {}
+extension `DNS Tests` {
+    @Suite
+    struct `DNS Resolver Seam Tests` {
+        @Suite struct Unit {}
+        @Suite struct `Edge Case` {}
+        @Suite struct Integration {}
+    }
 }
 
 private struct Fixed: Sendable {
@@ -75,7 +81,7 @@ extension Failing: DNS.Resolver.`Protocol` {
     }
 }
 
-extension `DNS Resolver Seam Tests`.Unit {
+extension `DNS Tests`.`DNS Resolver Seam Tests`.Unit {
     @Test
     func `provider order is preserved without family re-ranking`() async throws(RFC_1035.Domain
         .Error)
