From fe4db39ce4feb023e62b11e16641bfdc86757aff Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 19:34:19 +0000
Subject: [PATCH 1/2] compound suite name: narrative suites move into the test
 module's namespace `<File> Tests` (#239's layout), nested suites into
 extension <Path>.<Parent> (overnight/compound-suites.py); parse-checked;
 builds pending (coenttb/work#242)

---
 .../Nonfinite Component Tests.swift           | 38 ++++++++++---------
 1 file changed, 21 insertions(+), 17 deletions(-)

diff --git a/Tests/Color Standard Tests/Nonfinite Component Tests.swift b/Tests/Color Standard Tests/Nonfinite Component Tests.swift
index 3db9a16..5796949 100644
--- a/Tests/Color Standard Tests/Nonfinite Component Tests.swift	
+++ b/Tests/Color Standard Tests/Nonfinite Component Tests.swift	
@@ -2,25 +2,29 @@ import Testing
 
 @testable import Color_Standard
 
-@Suite
-struct `Nonfinite components` {
-    @Test(arguments: [Double.nan, .infinity, -.infinity])
-    func `a LAB color with a nonfinite axis converts to terminal colors without trapping`(_ value: Double) {
-        let color = Color.LAB(l: 50, a: value, b: 0).canonical()
+enum `Nonfinite Component Tests` {}
 
-        _ = color.sgr
-        _ = color.sgr256
-        _ = color.sgrPalette
-        #expect(color._debugRGBA.r.isFinite)
-    }
+extension `Nonfinite Component Tests` {
+    @Suite
+    struct `Nonfinite components` {
+        @Test(arguments: [Double.nan, .infinity, -.infinity])
+        func `a LAB color with a nonfinite axis converts to terminal colors without trapping`(_ value: Double) {
+            let color = Color.LAB(l: 50, a: value, b: 0).canonical()
+
+            _ = color.sgr
+            _ = color.sgr256
+            _ = color.sgrPalette
+            #expect(color._debugRGBA.r.isFinite)
+        }
 
-    @Test(arguments: [Double.nan, .infinity, -.infinity])
-    func `an Oklab color with a nonfinite axis converts to terminal colors without trapping`(_ value: Double) {
-        let color = Color.Oklab(l: 0.5, a: 0, b: value).canonical()
+        @Test(arguments: [Double.nan, .infinity, -.infinity])
+        func `an Oklab color with a nonfinite axis converts to terminal colors without trapping`(_ value: Double) {
+            let color = Color.Oklab(l: 0.5, a: 0, b: value).canonical()
 
-        _ = color.sgr
-        _ = color.sgr256
-        _ = color.sgrPalette
-        #expect(color._debugRGBA.b.isFinite)
+            _ = color.sgr
+            _ = color.sgr256
+            _ = color.sgrPalette
+            #expect(color._debugRGBA.b.isFinite)
+        }
     }
 }
