 Sources/Color Standard/Color.Oklab.swift      | 20 +++++++++++++++++++
 6 files changed, 40 insertions(+), 56 deletions(-)
 delete mode 100644 Sources/Color Standard/Color.LAB.Lightness.Error.swift
 delete mode 100644 Sources/Color Standard/Color.LAB.Lightness.swift
 delete mode 100644 Sources/Color Standard/Color.Oklab.Lightness.Error.swift
 delete mode 100644 Sources/Color Standard/Color.Oklab.Lightness.swift

diff --git a/Sources/Color Standard/Color.LAB.Lightness.Error.swift b/Sources/Color Standard/Color.LAB.Lightness.Error.swift
deleted file mode 100644
index 82be4dc..0000000
--- a/Sources/Color Standard/Color.LAB.Lightness.Error.swift	
+++ /dev/null
@@ -1,8 +0,0 @@
-import ISO_9899
-
-
-extension Color.LAB.Lightness {
-    public struct Error: Swift::Error, Sendable, CustomStringConvertible {
-        public let value: Double
-    }
-}
diff --git a/Sources/Color Standard/Color.LAB.Lightness.swift b/Sources/Color Standard/Color.LAB.Lightness.swift
deleted file mode 100644
index 55bb099..0000000
--- a/Sources/Color Standard/Color.LAB.Lightness.swift	
+++ /dev/null
@@ -1,20 +0,0 @@
-import ISO_9899
-
-
-extension Color.LAB {
-    public struct Lightness: Sendable, Hashable {
-
-        public let value: Double
-
-        public init(_ value: Double) throws(Error) {
-            guard value >= 0 && value <= 100 else {
-                throw Error(value: value)
-            }
-            self.value = value
-        }
-
-        public init(clamping value: Double) {
-            self.value = value.clamped(to: 0...100)
-        }
-    }
-}
diff --git a/Sources/Color Standard/Color.LAB.swift b/Sources/Color Standard/Color.LAB.swift
index b545c28..45b0535 100644
--- a/Sources/Color Standard/Color.LAB.swift	
+++ b/Sources/Color Standard/Color.LAB.swift	
@@ -19,9 +19,29 @@ extension Color {
 }
 
 extension Color.LAB {
+
+    public struct Lightness: Sendable, Hashable {
+
+        public let value: Double
+
+        public init(_ value: Double) throws(Error) {
+            guard value >= 0 && value <= 100 else {
+                throw Error(value: value)
+            }
+            self.value = value
+        }
+
+        public init(clamping value: Double) {
+            self.value = value.clamped(to: 0...100)
+        }
+    }
 }
 
 extension Color.LAB.Lightness {
+
+    public struct Error: Swift::Error, Sendable, CustomStringConvertible {
+        public let value: Double
+    }
 }
 
 extension Color.LAB.Lightness.Error {
