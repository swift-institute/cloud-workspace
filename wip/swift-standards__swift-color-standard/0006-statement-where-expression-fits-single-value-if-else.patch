From ecee91a68b47cdb8819ff1a04f5efe42d86463c7 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:35:31 +0000
Subject: [PATCH 6/6] statement where expression fits: single-value if/else
 chains written as if expressions (type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 Sources/Color Standard/Color+ECMA_48.swift | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/Sources/Color Standard/Color+ECMA_48.swift b/Sources/Color Standard/Color+ECMA_48.swift
index 06eafe4..f0b2e5b 100644
--- a/Sources/Color Standard/Color+ECMA_48.swift	
+++ b/Sources/Color Standard/Color+ECMA_48.swift	
@@ -177,14 +177,14 @@ extension Color {
         let maxDiff = max(abs(r - g), abs(g - b), abs(r - b))
         if maxDiff < 0.15 {
             let avg = (r + g + b) / 3.0
-            if avg < 0.15 {
-                return .black
+            return if avg < 0.15 {
+                .black
             } else if avg < 0.5 {
-                return bright ? .brightBlack : .black
+                bright ? .brightBlack : .black
             } else if avg < 0.85 {
-                return bright ? .white : .brightBlack
+                bright ? .white : .brightBlack
             } else {
-                return .brightWhite
+                .brightWhite
             }
         }
 
