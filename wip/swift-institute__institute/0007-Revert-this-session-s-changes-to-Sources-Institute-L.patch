From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 22:14:06 +0000
Subject: [PATCH 07/23] Revert this session's changes to Sources/Institute
 Linter Rule Idiom: they raised a rule over its ratchet limit
 (coenttb/work#242)

---
 ...Lint.Rule.Idiom.ExistentialParameter.swift | 39 +++++++++----------
 1 file changed, 18 insertions(+), 21 deletions(-)

diff --git a/Sources/Institute Linter Rule Idiom/Lint.Rule.Idiom.ExistentialParameter.swift b/Sources/Institute Linter Rule Idiom/Lint.Rule.Idiom.ExistentialParameter.swift
index aa56be4..92a99b3 100644
--- a/Sources/Institute Linter Rule Idiom/Lint.Rule.Idiom.ExistentialParameter.swift	
+++ b/Sources/Institute Linter Rule Idiom/Lint.Rule.Idiom.ExistentialParameter.swift	
@@ -133,27 +133,6 @@ internal func idiomExistentialParameterUnwrapped(_ type: TypeSyntax) -> TypeSynt
 }
 
 internal enum IdiomExistentialParameterCodableWitness {
-}
-
-internal final class IdiomExistentialParameterFinder: SyntaxVisitor {
-    var positions: [AbsolutePosition] = []
-
-    override func visit(_ node: SomeOrAnyTypeSyntax) -> SyntaxVisitorContinueKind {
-        let constraint = node.constraint.trimmedDescription
-        if node.someOrAnySpecifier.tokenKind == .keyword(.any),
-            constraint != "Error", constraint != "Swift.Error", constraint != "Swift::Error"
-        {
-            positions.append(node.positionAfterSkippingLeadingTrivia)
-        }
-        return .visitChildren
-    }
-
-    override func visit(_ node: FunctionTypeSyntax) -> SyntaxVisitorContinueKind {
-        .skipChildren
-    }
-}
-
-extension IdiomExistentialParameterCodableWitness {
     static func matches(_ parameter: FunctionParameterSyntax) -> Bool {
         guard let list = parameter.parent?.as(FunctionParameterListSyntax.self), list.count == 1,
             let signature = list.parent?.parent?.as(FunctionSignatureSyntax.self),
@@ -195,3 +174,21 @@ extension IdiomExistentialParameterCodableWitness {
         } ?? false
     }
 }
+
+internal final class IdiomExistentialParameterFinder: SyntaxVisitor {
+    var positions: [AbsolutePosition] = []
+
+    override func visit(_ node: SomeOrAnyTypeSyntax) -> SyntaxVisitorContinueKind {
+        let constraint = node.constraint.trimmedDescription
+        if node.someOrAnySpecifier.tokenKind == .keyword(.any),
+            constraint != "Error", constraint != "Swift.Error", constraint != "Swift::Error"
+        {
+            positions.append(node.positionAfterSkippingLeadingTrivia)
+        }
+        return .visitChildren
+    }
+
+    override func visit(_ node: FunctionTypeSyntax) -> SyntaxVisitorContinueKind {
+        .skipChildren
+    }
+}
