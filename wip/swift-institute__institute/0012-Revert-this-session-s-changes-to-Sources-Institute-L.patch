Date: Sat, 7 Nov 2026 22:43:08 +0000
Subject: [PATCH 12/28] Revert this session's changes to Sources/Institute
 Linter Rule Manifest: they raised a rule over its ratchet limit
 (coenttb/work#242)

---
 .../Lint.Rule.Manifest.TraitConsistency.swift | 43 ++++++++++---------
 1 file changed, 22 insertions(+), 21 deletions(-)

diff --git a/Sources/Institute Linter Rule Manifest/Lint.Rule.Manifest.TraitConsistency.swift b/Sources/Institute Linter Rule Manifest/Lint.Rule.Manifest.TraitConsistency.swift
index 2642e55..5da0cf0 100644
--- a/Sources/Institute Linter Rule Manifest/Lint.Rule.Manifest.TraitConsistency.swift	
+++ b/Sources/Institute Linter Rule Manifest/Lint.Rule.Manifest.TraitConsistency.swift	
@@ -117,6 +117,13 @@ internal func manifestTraitConsistencyFixture(condition: Swift::String) -> Swift
 /// It reads the target's imports from the package facts, so it checks the files the run
 /// walked; a module the product vends under a name other than the product's is not seen.
 internal struct ManifestTraitConsistency {
+
+    struct Issue {
+        let position: AbsolutePosition
+        let message: Swift::String
+        let insertion: (offset: Swift::Int, text: Swift::String)?
+    }
+
     private(set) var issues: [Issue] = []
 
     private(set) var unhandledSourceShape: Swift::String?
@@ -176,9 +183,24 @@ internal struct ManifestTraitConsistency {
             }
         }
     }
+
+    private static func closure(of trait: Swift::String, in traits: [Swift::String: [Swift::String]]) -> Swift::Set<Swift::String> {
+        var pending = [trait]
+        var seen: Swift::Set<Swift::String> = []
+        while let next = pending.popLast() {
+            guard seen.insert(next).inserted else { continue }
+            pending.append(contentsOf: traits[next] ?? [])
+        }
+        return seen
+    }
+
+    private static func list(_ traits: Swift::Set<Swift::String>) -> Swift::String {
+        "[" + traits.sorted().map { "\"\($0)\"" }.joined(separator: ", ") + "]"
+    }
 }
 
 internal final class ManifestTraitConsistencyCollector: SyntaxVisitor {
+
     struct Dependency {
         let name: Swift::String
         let position: AbsolutePosition
@@ -308,24 +330,3 @@ private final class ManifestTraitConsistencyDefineCollector: SyntaxVisitor {
         return .visitChildren
     }
 }
