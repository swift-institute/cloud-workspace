From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:35:33 +0000
Subject: [PATCH 23/28] statement where expression fits: single-value if/else
 chains written as if expressions (type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 Sources/Source Linter/Source.Measurement+linter.swift | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/Sources/Source Linter/Source.Measurement+linter.swift b/Sources/Source Linter/Source.Measurement+linter.swift
index d8cdf74..18b34e0 100644
--- a/Sources/Source Linter/Source.Measurement+linter.swift	
+++ b/Sources/Source Linter/Source.Measurement+linter.swift	
@@ -243,12 +243,12 @@ private func sourceLinterMeasurement(
     }
 
     let verdict: Source.Measurement.Verdict
-    if !unmeasured.isEmpty {
-        verdict = .unmeasured(unmeasured)
+    verdict = if !unmeasured.isEmpty {
+        .unmeasured(unmeasured)
     } else if findings.isEmpty {
-        verdict = .clean
+        .clean
     } else {
-        verdict = .findings(findings)
+        .findings(findings)
     }
     return Source.Measurement(
         engine: engine,
