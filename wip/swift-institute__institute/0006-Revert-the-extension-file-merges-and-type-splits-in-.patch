diff --git a/Sources/Institute Planner/Institute.Planner+Digest.swift b/Sources/Institute Planner/Institute.Planner+Digest.swift
new file mode 100644
index 0000000..73578ec
--- /dev/null
+++ b/Sources/Institute Planner/Institute.Planner+Digest.swift	
@@ -0,0 +1,23 @@
+import Byte
+import FIPS_180_4
+import Institute_Model
+
+extension Institute.Planner {
+    /// Reads a SHA-256 digest as the contract spells it: 64 lowercase
+    /// hexadecimal characters.
+    static func digest(_ text: some StringProtocol) throws(Error) -> FIPS_180_4.Digest {
+        guard isHex(text, count: 64), let digest = FIPS_180_4.Digest(hex: Swift.String(text))
+        else {
+            throw .malformed(
+                line: Swift.String(text),
+                reason: "a digest is 64 lowercase hexadecimal characters"
+            )
+        }
+        return digest
+    }
+
+    /// The SHA-256 digest of `bytes`.
+    static func digest(of bytes: [Byte]) -> FIPS_180_4.Digest {
+        FIPS_180_4.SHA256.digest(bytes)
+    }
+}
diff --git a/Sources/Institute Planner/Institute.Planner+File.swift b/Sources/Institute Planner/Institute.Planner+File.swift
new file mode 100644
index 0000000..d8d7ed3
--- /dev/null
+++ b/Sources/Institute Planner/Institute.Planner+File.swift	
@@ -0,0 +1,46 @@
+import Byte
+package import File_System
+package import Institute_Model
+
+extension Institute.Planner {
+    /// A path the verbs were handed or derived.
+    package static func path(_ text: Swift.String) throws(Error) -> File.Path {
+        do throws(File.Path.Error) {
+            return try File.Path(text)
+        } catch {
+            throw .local("invalid path \(text): \(error)")
+        }
+    }
+
+    /// The bytes of the file at `path`.
+    package static func read(_ path: File.Path) throws(Error) -> [Byte] {
+        do throws(Either<File.System.Read.Full.Error, Never>) {
+            return try File.System.Read.Full.read(from: path) { span in
+                var bytes: [Byte] = []
+                bytes.reserveCapacity(span.count)
+                for index in span.indices { bytes.append(span[index]) }
+                return bytes
+            }
+        } catch {
+            throw .local("cannot read \(path): \(error)")
+        }
+    }
+
+    /// Replaces the file at `path` with `bytes`, atomically.
+    package static func write(_ bytes: [Byte], to path: File.Path) throws(Error) {
+        do throws(File.System.Write.Atomic.Error) {
+            try File(path).write.atomic(contentsOf: bytes)
+        } catch {
+            throw .local("cannot write \(path): \(error)")
+        }
+    }
+
+    /// Creates the directory at `path` and any missing parents.
+    package static func directory(_ path: File.Path) throws(Error) {
+        do throws(File.System.Create.Directory.Error) {
+            try File.System.Create.Directory.create(at: path, createIntermediates: true)
+        } catch {
+            throw .local("cannot create \(path): \(error)")
+        }
+    }
+}
