diff --git a/Sources/Source Report/Source.Report+errors.swift b/Sources/Source Report/Source.Report+errors.swift
new file mode 100644
index 0000000..b8c407a
--- /dev/null
+++ b/Sources/Source Report/Source.Report+errors.swift	
@@ -0,0 +1,19 @@
+extension Source.Report {
+    /// Whether the report carries anything the strict exit policy fails on:
+    /// an error-severity engine finding, or any artifact or control finding.
+    ///
+    /// Warning-severity engine findings are reported and never fail a strict
+    /// run.
+    public var errors: Swift.Bool {
+        measurements.contains { measurement in
+            guard case .findings(let findings) = measurement.verdict else { return false }
+            return findings.contains { $0.diagnostic.severity == .error }
+        }
+            || artifactEvidence.contains { evidence in
+                if case .findings = evidence.verdict { true } else { false }
+            }
+            || controlEvidence.contains { evidence in
+                if case .findings = evidence.verdict { true } else { false }
+            }
+    }
+}
diff --git a/Sources/Source Report/Source.Report+human.swift b/Sources/Source Report/Source.Report+human.swift
new file mode 100644
index 0000000..0f0e4a9
--- /dev/null
+++ b/Sources/Source Report/Source.Report+human.swift	
@@ -0,0 +1,51 @@
+extension Source.Report {
+    public var human: Swift.String {
+        var lines = [
+            "source profile \(profile.hex)",
+            "scope: \(scope.rawValue)",
+            "subjects: \(subjects.count)",
+        ]
+        for reason in references {
+            lines.append("UNMEASURED reference \(reason.code): \(reason.detail)")
+        }
+        for measurement in measurements {
+            switch measurement.verdict {
+            case .clean:
+                lines.append("CLEAN \(measurement.subject.identity) \(measurement.engine.token)")
+            case .findings(let findings):
+                lines.append(
+                    "FINDINGS \(measurement.subject.identity) \(measurement.engine.token) \(findings.count)"
+                )
+            case .unmeasured(let reasons):
+                for reason in reasons {
+                    lines.append(
+                        "UNMEASURED \(measurement.subject.identity) \(measurement.engine.token) \(reason.code): \(reason.detail)"
+                    )
+                }
+            case .notRequested:
+                lines.append(
+                    "NOT REQUESTED \(measurement.subject.identity) \(measurement.engine.token)"
+                )
+            }
+        }
+        for evidence in artifactEvidence {
+            switch evidence.verdict {
+            case .clean:
+                lines.append(
+                    "CLEAN \(evidence.subject) \(evidence.predicate.engine.token):\(evidence.predicate.token) \(evidence.artifact.path)"
+                )
+            case .findings(let reasons):
+                lines.append(
+                    "FINDINGS \(evidence.subject) \(evidence.predicate.engine.token):\(evidence.predicate.token) \(evidence.artifact.path) \(reasons.count)"
+                )
+            case .unmeasured(let reasons):
+                for reason in reasons {
+                    lines.append(
+                        "UNMEASURED \(evidence.subject) \(evidence.predicate.engine.token):\(evidence.predicate.token) \(evidence.artifact.path) \(reason.code): \(reason.detail)"
+                    )
+                }
+            }
+        }
+        return lines.joined(separator: "\n") + "\n"
+    }
+}
