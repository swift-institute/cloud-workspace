new file mode 100644
index 0000000..03fea65
--- /dev/null
+++ b/Sources/Institute Planner/Institute.Planner.Release+GitHub.swift	
@@ -0,0 +1,64 @@
+import Byte
+import File_System
+import Institute_GitHub
+public import Institute_Model
+
+extension Institute.Planner.Release {
+    /// The live `ci-binaries` release of swift-institute/institute, read and
+    /// downloaded through `gh`.
+    public static var github: Self {
+        .init(
+            names: { () throws(Institute.Planner.Error) in
+                do throws(Institute.GitHub.Release.Error) {
+                    return try Institute.GitHub.Release.assets(
+                        repository: Institute.Planner.publisher,
+                        tag: Institute.Planner.tag
+                    )
+                } catch {
+                    throw .transport("cannot list the \(Institute.Planner.tag) release: \(error)")
+                }
+            },
+            fetch: { name throws(Institute.Planner.Error) in
+                let destination = try staging(name)
+                defer {
+                    // swift-linter:disable:next try optional
+                    // REASON: cleanup of a private temporary file; a failed
+                    // delete leaves only tmpdir residue and must not mask the
+                    // download's own outcome.
+                    try? File.System.Delete.delete(at: destination)
+                }
+                do throws(Institute.GitHub.Release.Error) {
+                    try Institute.GitHub.Release.download(
+                        repository: Institute.Planner.publisher,
+                        tag: Institute.Planner.tag,
+                        asset: name,
+                        to: destination
+                    )
+                } catch {
+                    if case .missing = error { throw .missing("release asset \(name)") }
+                    throw .transport("cannot download \(name): \(error)")
+                }
+                return try Institute.Planner.read(destination)
+            }
+        )
+    }
+
+    /// A fresh private temporary path to download `name` into.
+    private static func staging(_ name: Swift.String) throws(Institute.Planner.Error) -> File.Path {
+        let anchor: File.Path
+        do throws(File.Path.Error) {
+            anchor = try File.Path.Temporary.deterministic(
+                prefix: "institute-planner-asset",
+                key: "",
+                suffix: ""
+            )
+        } catch {
+            throw .local("cannot resolve a temporary directory: \(error)")
+        }
+        do throws(File.Path.Temporary.Error) {
+            return try File.Path.Temporary.sibling(of: anchor, prefix: "institute-planner-asset-")
+        } catch {
+            throw .local("cannot mint a download path for \(name): \(error)")
+        }
+    }
+}
diff --git a/Sources/Institute Planner/Institute.Planner.Release+published.swift b/Sources/Institute Planner/Institute.Planner.Release+published.swift
new file mode 100644
index 0000000..b95894f
--- /dev/null
+++ b/Sources/Institute Planner/Institute.Planner.Release+published.swift	
@@ -0,0 +1,55 @@
+import Byte
+import Foundation
+public import Institute_Model
+
+extension Institute.Planner.Release {
+    /// The live `ci-binaries` release of swift-institute/institute, read from
+    /// GitHub's public endpoints without any credential: the release's public
+    /// expanded-assets page, and each asset through its download address.
+    public static var published: Self {
+        let repository = Institute.Planner.publisher
+        let tag = Institute.Planner.tag
+        return .init(
+            names: { () throws(Institute.Planner.Error) in
+                let bytes = try Institute.Planner.Curl.get(
+                    "https://github.com/\(repository)/releases/expanded_assets/\(tag)"
+                )
+                return try assets(
+                    listing: Swift.String(decoding: bytes, as: Swift.UTF8.self),
+                    tag: tag
+                )
+            },
+            fetch: { name throws(Institute.Planner.Error) in
+                guard !name.isEmpty, !name.contains(where: { $0 == "/" || $0 == "?" || $0 == "#" })
+                else {
+                    throw .malformed(line: name, reason: "an asset name is one path component")
+                }
+                return try Institute.Planner.Curl.get(
+                    "https://github.com/\(repository)/releases/download/\(tag)/\(name)"
+                )
+            }
+        )
+    }
+}
+
+extension Institute.Planner.Release {
+    /// The asset names a release's expanded-assets page links to.
+    ///
+    /// Links are matched on `/releases/download/<tag>/` alone, never on the
+    /// repository path before it: GitHub serves a renamed repository's page
+    /// under its new name, so a planner that matched the name it was built
+    /// with would find no assets and refuse to run.
+    static func assets(
+        listing: Swift.String,
+        tag: Swift.String
+    ) throws(Institute.Planner.Error) -> [Swift.String] {
+        let marker = "/releases/download/\(tag)/"
+        let names = listing.components(separatedBy: marker).dropFirst().compactMap { tail in
+            tail.split(separator: "\"", maxSplits: 1).first.map(Swift.String.init)
+        }
+        guard !names.isEmpty else {
+            throw .malformed(line: "release \(tag)", reason: "no asset links")
+        }
+        return Swift.Set(names).sorted()
+    }
+}
