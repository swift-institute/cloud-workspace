-            ),
-            .init(
-                id: "apache license license author",
-                source: "let package = Package(name: \"Fixture\")",
-                path: "Package.swift",
-                expectation: .findings(1),
-                license: .text("GNU Affero General Public License\n\n_Copyright © 2007 Free Software Foundation, Inc._")
-            ),
-            .init(
-                id: "apache license unread",
-                source: "let package = Package(name: \"Fixture\")",
-                path: "Package.swift",
-                expectation: .clean,
-                applicability: .inapplicable
-            ),
-            .init(
-                id: "apache license nested manifest",
-                source: "let package = Package(name: \"Runner\")",
-                path: "Runner/Package.swift",
-                expectation: .clean,
-                applicability: .inapplicable,
-                license: .absent
-            ),
-        ],
-        observe: { source, severity in
-            guard manifestIsRootPackageManifest(source.path.underlying), source.index.license != .unread
-            else {
-                return Lint.Rule.Observation(findings: [], coverage: .measured, applicability: .inapplicable)
-            }
-            let findings: [Diagnostic.Record]
-            switch source.index.license {
-            case .text(let text)
-            where manifestApacheLicenseNormalized(text).contains(manifestApacheLicenseCanonical)
