-                        ),
-                        severity: severity,
-                        identifier: "apache license",
-                        message: manifestApacheLicenseMessage(source.index.license)
-                    )
-                ]
-            }
-            return Lint.Rule.Observation(findings: findings, coverage: .measured)
-        }
-    )
-}
