From c00a2bbc02bc3bde8fc1f90144e7140d77125928 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 20:52:50 +0000
Subject: [PATCH] extension file naming: member-only and
 standard-library-conformance extension files merge into their type's own file
 (overnight/merge-extension-files.py); single type per file: additional types
 move to their own <Parent>.<Name>.swift inside the container's extension
 (overnight/split-types.py); parse-checked; builds pending (coenttb/work#242)

---
 Sources/Async Waiter/Async.Waiter.Queue.Metadata.swift | 6 ------
 Sources/Async Waiter/Async.Waiter.Queue.swift          | 6 ++++++
 2 files changed, 6 insertions(+), 6 deletions(-)
 delete mode 100644 Sources/Async Waiter/Async.Waiter.Queue.Metadata.swift

diff --git a/Sources/Async Waiter/Async.Waiter.Queue.Metadata.swift b/Sources/Async Waiter/Async.Waiter.Queue.Metadata.swift
deleted file mode 100644
index 301f2c5..0000000
--- a/Sources/Async Waiter/Async.Waiter.Queue.Metadata.swift	
+++ /dev/null
@@ -1,6 +0,0 @@
-public import Tagged
-
-extension Async.Waiter.Queue {
-
-    public typealias Metadata = Tagged<Async.Waiter.Queue, UInt64>
-}
diff --git a/Sources/Async Waiter/Async.Waiter.Queue.swift b/Sources/Async Waiter/Async.Waiter.Queue.swift
index d9be7a4..76a682e 100644
--- a/Sources/Async Waiter/Async.Waiter.Queue.swift	
+++ b/Sources/Async Waiter/Async.Waiter.Queue.swift	
@@ -11,6 +11,7 @@ import Ownership_Shared_Primitive
 public import Queue
 public import Storage
 import Store
+public import Tagged
 
 extension Async.Waiter {
 
@@ -27,3 +28,8 @@ extension Async.Waiter.Queue {
 
     public typealias Drain<Element: ~Copyable> = Queue::Queue<Element>
 }
+
+extension Async.Waiter.Queue {
+
+    public typealias Metadata = Tagged<Async.Waiter.Queue, UInt64>
+}
