From 56ae5ad09961efb165a1d6d825604bcc33518e2e Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:24:51 +0000
Subject: [PATCH 5/6] trait consistency: dependencies imported only under a
 trait get that trait's condition (runner repair; Linux x86_64, Swift 6.4.2)
 (coenttb/work#242)

---
 Package.swift | 14 +++++++-------
 1 file changed, 7 insertions(+), 7 deletions(-)

diff --git a/Package.swift b/Package.swift
index 9fd8600..b5dd0a4 100644
--- a/Package.swift
+++ b/Package.swift
@@ -102,22 +102,22 @@ let package = Package(
             name: "Slab Inline Primitive",
             dependencies: [
                 .target(name: "Slab Primitive"),
-                .product(name: "Buffer", package: "swift-buffer"),
+                .product(name: "Buffer", package: "swift-buffer", condition: .when(traits: ["SlabInlinePrimitive"])),
                 .product(
                     name: "Buffer Slab Inline",
-                    package: "swift-buffer-slab"
+                    package: "swift-buffer-slab", condition: .when(traits: ["SlabInlinePrimitive"])
                 ),
-                .product(name: "Bit", package: "swift-bit"),
+                .product(name: "Bit", package: "swift-bit", condition: .when(traits: ["SlabInlinePrimitive"])),
                 .product(name: "Finite", package: "swift-finite", condition: .when(traits: ["SlabInlinePrimitive"])),
-                .product(name: "Index", package: "swift-index"),
+                .product(name: "Index", package: "swift-index", condition: .when(traits: ["SlabInlinePrimitive"])),
                 .product(
                     name: "Storage",
-                    package: "swift-storage"
+                    package: "swift-storage", condition: .when(traits: ["SlabInlinePrimitive"])
                 ),
-                .product(name: "Memory", package: "swift-memory"),
+                .product(name: "Memory", package: "swift-memory", condition: .when(traits: ["SlabInlinePrimitive"])),
                 .product(
                     name: "Memory Allocator",
-                    package: "swift-memory-allocation"
+                    package: "swift-memory-allocation", condition: .when(traits: ["SlabInlinePrimitive"])
                 ),
             ]
         ),
