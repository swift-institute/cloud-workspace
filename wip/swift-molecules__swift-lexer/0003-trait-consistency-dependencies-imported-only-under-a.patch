From 8791e38475061173105c53bbb35aadb03e360061 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:24:51 +0000
Subject: [PATCH 3/5] trait consistency: dependencies imported only under a
 trait get that trait's condition (runner repair; Linux x86_64, Swift 6.4.2)
 (coenttb/work#242)

---
 Package.swift | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/Package.swift b/Package.swift
index 37f73a9..dfbeb50 100644
--- a/Package.swift
+++ b/Package.swift
@@ -82,13 +82,13 @@ let package = Package(
             name: "Lexer Standard Library Integration",
             dependencies: [
                 .target(name: "Lexer"),
-                .product(name: "Ordinal", package: "swift-ordinal"),
+                .product(name: "Ordinal", package: "swift-ordinal", condition: .when(traits: ["LexerStandardLibraryIntegration"])),
                 .product(
                     name: "Tagged",
                     package: "swift-tagged",
                     condition: .when(traits: ["LexerStandardLibraryIntegration"])
                 ),
-                .product(name: "Text", package: "swift-text"),
+                .product(name: "Text", package: "swift-text", condition: .when(traits: ["LexerStandardLibraryIntegration"])),
             ]
         ),
         .testTarget(
-- 
2.43.0

