From ebae93542e58d5380b45db8c611e371ca6f6accf Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 20:52:54 +0000
Subject: [PATCH 2/7] extension file naming: member-only and
 standard-library-conformance extension files merge into their type's own file
 (overnight/merge-extension-files.py); single type per file: additional types
 move to their own <Parent>.<Name>.swift inside the container's extension
 (overnight/split-types.py); parse-checked; builds pending (coenttb/work#242)

---
 Sources/ISO 9899 Core/ISO_9899.Errno.Code.swift | 13 +++++++++++++
 Sources/ISO 9899 Core/ISO_9899.Errno.swift      |  9 ---------
 2 files changed, 13 insertions(+), 9 deletions(-)
 create mode 100644 Sources/ISO 9899 Core/ISO_9899.Errno.Code.swift

diff --git a/Sources/ISO 9899 Core/ISO_9899.Errno.Code.swift b/Sources/ISO 9899 Core/ISO_9899.Errno.Code.swift
new file mode 100644
index 0000000..0668360
--- /dev/null
+++ b/Sources/ISO 9899 Core/ISO_9899.Errno.Code.swift	
@@ -0,0 +1,13 @@
+public import ISO_9899_Errno_Shims
+
+
+extension ISO_9899.Errno {
+    public struct Code: RawRepresentable, Equatable, Hashable, Sendable, Swift::Error {
+        public let rawValue: Int32
+
+        @inline(always)
+        public init(rawValue: Int32) {
+            self.rawValue = rawValue
+        }
+    }
+}
diff --git a/Sources/ISO 9899 Core/ISO_9899.Errno.swift b/Sources/ISO 9899 Core/ISO_9899.Errno.swift
index 01511f4..6622581 100644
--- a/Sources/ISO 9899 Core/ISO_9899.Errno.swift	
+++ b/Sources/ISO 9899 Core/ISO_9899.Errno.swift	
@@ -31,15 +31,6 @@ extension ISO_9899.Errno {
 }
 
 extension ISO_9899.Errno {
-
-    public struct Code: RawRepresentable, Equatable, Hashable, Sendable, Swift::Error {
-        public let rawValue: Int32
-
-        @inline(always)
-        public init(rawValue: Int32) {
-            self.rawValue = rawValue
-        }
-    }
 }
 
 extension ISO_9899.Errno.Code {
-- 
