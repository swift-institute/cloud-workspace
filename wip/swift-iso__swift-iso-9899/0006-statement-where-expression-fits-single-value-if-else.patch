From f0480b7e1402d09e06f8d035b669cdf375d185ff Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:35:31 +0000
Subject: [PATCH 06/10] statement where expression fits: single-value if/else
 chains written as if expressions (type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 .../ISO_9899.Math.Classification.swift        | 24 +++++++++----------
 .../ISO 9899 Core/ISO_9899.String.Order.swift |  8 +++----
 2 files changed, 16 insertions(+), 16 deletions(-)

diff --git a/Sources/ISO 9899 Core/ISO_9899.Math.Classification.swift b/Sources/ISO 9899 Core/ISO_9899.Math.Classification.swift
index 2629dc9..91ddbe2 100644
--- a/Sources/ISO 9899 Core/ISO_9899.Math.Classification.swift	
+++ b/Sources/ISO 9899 Core/ISO_9899.Math.Classification.swift	
@@ -19,16 +19,16 @@ extension ISO_9899.Math {
     public static func fpclassify(_ x: Double) -> FloatingPointClass {
         _ = iso9899_fpclassify_d(x)
 
-        if x.isNaN {
-            return .nan
+        return if x.isNaN {
+            .nan
         } else if x.isInfinite {
-            return .infinite
+            .infinite
         } else if x == 0 {
-            return .zero
+            .zero
         } else if abs(x) < Double.leastNormalMagnitude {
-            return .subnormal
+            .subnormal
         } else {
-            return .normal
+            .normal
         }
     }
 
@@ -36,16 +36,16 @@ extension ISO_9899.Math {
     public static func fpclassify(_ x: Float) -> FloatingPointClass {
         _ = iso9899_fpclassify_f(x)
 
-        if x.isNaN {
-            return .nan
+        return if x.isNaN {
+            .nan
         } else if x.isInfinite {
-            return .infinite
+            .infinite
         } else if x == 0 {
-            return .zero
+            .zero
         } else if abs(x) < Float.leastNormalMagnitude {
-            return .subnormal
+            .subnormal
         } else {
-            return .normal
+            .normal
         }
     }
 
diff --git a/Sources/ISO 9899 Core/ISO_9899.String.Order.swift b/Sources/ISO 9899 Core/ISO_9899.String.Order.swift
index 2623fdb..9851371 100644
--- a/Sources/ISO 9899 Core/ISO_9899.String.Order.swift	
+++ b/Sources/ISO 9899 Core/ISO_9899.String.Order.swift	
@@ -14,12 +14,12 @@ extension ISO_9899.String.Order {
 
     @inline(always)
     public init(cResult: Int32) {
-        if cResult < 0 {
-            self = .less
+        self = if cResult < 0 {
+            .less
         } else if cResult > 0 {
-            self = .greater
+            .greater
         } else {
-            self = .equal
+            .equal
         }
     }
 }
