diff --git a/Sources/RFC 6891/RFC_6891.Option.Code.swift b/Sources/RFC 6891/RFC_6891.Option.Code.swift
new file mode 100644
index 0000000..30b0832
--- /dev/null
+++ b/Sources/RFC 6891/RFC_6891.Option.Code.swift	
@@ -0,0 +1,20 @@
+public import Binary
+
+
+extension RFC_6891.Option {
+    /// EDNS Option Code
+    ///
+    /// Option codes are assigned by IANA.
+    public struct Code: RawRepresentable, Sendable, Hashable, Codable {
+        public let rawValue: UInt16
+
+        public init(rawValue: UInt16) {
+            self.rawValue = rawValue
+        }
+
+        /// Creates an Option Code WITHOUT validation
+        init(__unchecked: Void, rawValue: UInt16) {
+            self.rawValue = rawValue
+        }
+    }
+}
