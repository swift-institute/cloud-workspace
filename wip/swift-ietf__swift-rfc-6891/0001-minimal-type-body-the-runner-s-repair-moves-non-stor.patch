Subject: [PATCH] minimal type body: the runner's repair moves non-stored
 members out of type bodies into extensions; repair applied; root and test
 builds not yet run (coenttb/work#242)

---
 Sources/RFC 6891/RFC_6891.Option.swift | 81 +++++++++++++-------------
 1 file changed, 42 insertions(+), 39 deletions(-)

diff --git a/Sources/RFC 6891/RFC_6891.Option.swift b/Sources/RFC 6891/RFC_6891.Option.swift
index 37068b4..c3dc229 100644
--- a/Sources/RFC 6891/RFC_6891.Option.swift	
+++ b/Sources/RFC 6891/RFC_6891.Option.swift	
@@ -62,60 +62,63 @@ extension RFC_6891.Option {
         init(__unchecked: Void, rawValue: UInt16) {
             self.rawValue = rawValue
         }
+    }
+}
+
+extension RFC_6891.Option: Binary.Serializable {
+    public static func serialize<Buffer: RangeReplaceableCollection>(
+        _ option: Self,
+        into buffer: inout Buffer
+    ) where Buffer.Element == Byte {
+        buffer.append(contentsOf: option.code.rawValue.bytes(endianness: .big))
 
-        /// LLQ (1): Long-Lived Queries (RFC 8764)
-        public static let llq = Self(__unchecked: (), rawValue: 1)
+        buffer.append(contentsOf: UInt16(option.data.count).bytes(endianness: .big))
 
-        /// UL (2): Update Lease (draft)
-        public static let updateLease = Self(__unchecked: (), rawValue: 2)
+        buffer.append(contentsOf: option.data)
+    }
+}
 
