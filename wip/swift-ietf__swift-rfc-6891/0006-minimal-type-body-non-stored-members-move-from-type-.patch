From 3b1d2504c6e42cd069c032a0920030bd1e2b8c9c Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 22:39:55 +0000
Subject: [PATCH 6/6] minimal type body: non-stored members move from type
 bodies into an extension of the type in the same file
 (overnight/minimal-bodies.py); type-checked against the root build,
 directories that failed or couldn't be checked left out (coenttb/work#242)

---
 Sources/RFC 6891/RFC_6891.ExtendedRcode.swift | 20 +++---
 Sources/RFC 6891/RFC_6891.Rcode.swift         | 65 ++++++++++---------
 Sources/RFC 6891/RFC_6891.Version.swift       | 12 ++--
 3 files changed, 52 insertions(+), 45 deletions(-)

diff --git a/Sources/RFC 6891/RFC_6891.ExtendedRcode.swift b/Sources/RFC 6891/RFC_6891.ExtendedRcode.swift
index 6615204..ca626ed 100644
--- a/Sources/RFC 6891/RFC_6891.ExtendedRcode.swift	
+++ b/Sources/RFC 6891/RFC_6891.ExtendedRcode.swift	
@@ -25,17 +25,19 @@ extension RFC_6891 {
         init(__unchecked: Void, rawValue: UInt8) {
             self.rawValue = rawValue
         }
+    }
+}
 
-        /// No extended RCODE (use header RCODE only)
-        public static let zero = Self(__unchecked: (), rawValue: 0)
+extension RFC_6891.ExtendedRcode {
+    /// No extended RCODE (use header RCODE only)
+    public static let zero = Self(__unchecked: (), rawValue: 0)
 
-        /// Computes the full 12-bit RCODE
-        ///
-        /// - Parameter headerRcode: The 4-bit RCODE from the DNS header
-        /// - Returns: The combined 12-bit RCODE
-        public func fullRcode(headerRcode: UInt8) -> UInt16 {
-            (UInt16(rawValue) << 4) | UInt16(headerRcode & 0x0F)
-        }
+    /// Computes the full 12-bit RCODE
+    ///
+    /// - Parameter headerRcode: The 4-bit RCODE from the DNS header
+    /// - Returns: The combined 12-bit RCODE
+    public func fullRcode(headerRcode: UInt8) -> UInt16 {
+        (UInt16(rawValue) << 4) | UInt16(headerRcode & 0x0F)
     }
 }
 
diff --git a/Sources/RFC 6891/RFC_6891.Rcode.swift b/Sources/RFC 6891/RFC_6891.Rcode.swift
index 51345e5..c643ec4 100644
--- a/Sources/RFC 6891/RFC_6891.Rcode.swift	
+++ b/Sources/RFC 6891/RFC_6891.Rcode.swift	
@@ -4,49 +4,52 @@ extension RFC_6891 {
     ///
     /// These are the full 12-bit RCODE values used with EDNS.
     public enum Rcode {
-        /// NOERROR (0): No error
-        public static let noError: UInt16 = 0
+    }
+}
 
-        /// FORMERR (1): Format error
-        public static let formatError: UInt16 = 1
+extension RFC_6891.Rcode {
+    /// NOERROR (0): No error
+    public static let noError: UInt16 = 0
 
-        /// SERVFAIL (2): Server failure
-        public static let serverFailure: UInt16 = 2
+    /// FORMERR (1): Format error
+    public static let formatError: UInt16 = 1
 
-        /// NXDOMAIN (3): Non-existent domain
-        public static let nxDomain: UInt16 = 3
+    /// SERVFAIL (2): Server failure
+    public static let serverFailure: UInt16 = 2
 
-        /// NOTIMP (4): Not implemented
-        public static let notImplemented: UInt16 = 4
+    /// NXDOMAIN (3): Non-existent domain
+    public static let nxDomain: UInt16 = 3
 
-        /// REFUSED (5): Query refused
-        public static let refused: UInt16 = 5
+    /// NOTIMP (4): Not implemented
+    public static let notImplemented: UInt16 = 4
 
-        /// BADVERS (16): Bad OPT version
-        public static let badVersion: UInt16 = 16
+    /// REFUSED (5): Query refused
+    public static let refused: UInt16 = 5
 
-        /// BADSIG (16): TSIG signature failure (same value, different context)
-        public static let badSignature: UInt16 = 16
+    /// BADVERS (16): Bad OPT version
+    public static let badVersion: UInt16 = 16
 
-        /// BADKEY (17): Key not recognized
-        public static let badKey: UInt16 = 17
+    /// BADSIG (16): TSIG signature failure (same value, different context)
+    public static let badSignature: UInt16 = 16
 
-        /// BADTIME (18): Signature out of time window
-        public static let badTime: UInt16 = 18
+    /// BADKEY (17): Key not recognized
+    public static let badKey: UInt16 = 17
 
-        /// BADMODE (19): Bad TKEY mode
-        public static let badMode: UInt16 = 19
+    /// BADTIME (18): Signature out of time window
+    public static let badTime: UInt16 = 18
 
-        /// BADNAME (20): Duplicate key name
-        public static let badName: UInt16 = 20
+    /// BADMODE (19): Bad TKEY mode
+    public static let badMode: UInt16 = 19
 
-        /// BADALG (21): Algorithm not supported
-        public static let badAlgorithm: UInt16 = 21
+    /// BADNAME (20): Duplicate key name
+    public static let badName: UInt16 = 20
 
-        /// BADTRUNC (22): Bad truncation
-        public static let badTruncation: UInt16 = 22
+    /// BADALG (21): Algorithm not supported
+    public static let badAlgorithm: UInt16 = 21
 
-        /// BADCOOKIE (23): Bad/missing server cookie
-        public static let badCookie: UInt16 = 23
-    }
+    /// BADTRUNC (22): Bad truncation
+    public static let badTruncation: UInt16 = 22
+
+    /// BADCOOKIE (23): Bad/missing server cookie
+    public static let badCookie: UInt16 = 23
 }
diff --git a/Sources/RFC 6891/RFC_6891.Version.swift b/Sources/RFC 6891/RFC_6891.Version.swift
index ab0c1e7..8b81d67 100644
--- a/Sources/RFC 6891/RFC_6891.Version.swift	
+++ b/Sources/RFC 6891/RFC_6891.Version.swift	
@@ -21,12 +21,14 @@ extension RFC_6891 {
         init(__unchecked: Void, rawValue: UInt8) {
             self.rawValue = rawValue
         }
+    }
+}
 
-        /// EDNS version 0 (current version)
-        public static let zero = Self(__unchecked: (), rawValue: 0)
+extension RFC_6891.Version {
+    /// EDNS version 0 (current version)
+    public static let zero = Self(__unchecked: (), rawValue: 0)
 
-        public static func < (lhs: Self, rhs: Self) -> Bool {
-            lhs.rawValue < rhs.rawValue
-        }
+    public static func < (lhs: Self, rhs: Self) -> Bool {
+        lhs.rawValue < rhs.rawValue
     }
 }
