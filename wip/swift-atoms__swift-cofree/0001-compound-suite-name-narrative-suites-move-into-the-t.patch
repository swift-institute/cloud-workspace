From a6f937e38e059c8e463e356621fe3b8420f1ad8c Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 19:33:58 +0000
Subject: [PATCH] compound suite name: narrative suites move into the test
 module's namespace `<File> Tests` (#239's layout), nested suites into
 extension <Path>.<Parent> (overnight/compound-suites.py); parse-checked;
 builds pending (coenttb/work#242)

---
 Tests/Cofree Macro Tests/Boundary Tests.swift | 50 ++++++++++---------
 1 file changed, 27 insertions(+), 23 deletions(-)

diff --git a/Tests/Cofree Macro Tests/Boundary Tests.swift b/Tests/Cofree Macro Tests/Boundary Tests.swift
index a642cab..5ace654 100644
--- a/Tests/Cofree Macro Tests/Boundary Tests.swift	
+++ b/Tests/Cofree Macro Tests/Boundary Tests.swift	
@@ -16,31 +16,35 @@ private func annotations(_ value: Count.Cofree<Int>) -> [Int] {
     }
 }
 
-@Suite
-struct `Cofree boundaries` {
-    fileprivate let two = Count.Cofree<Int>.cofree(
-        2,
-        .successor(.cofree(1, .successor(.cofree(0, .zero))))
-    )
-
-    @Test
-    func `extract returns the outermost annotation`() {
-        #expect(two.extract == 2)
-        #expect(Count.Cofree<Int>.cofree(7, .zero).extract == 7)
-    }
+enum `Boundary Tests` {}
 
-    @Test
-    func `map transforms the annotation of every layer`() {
-        #expect(annotations(two.map { $0 * 10 }) == [20, 10, 0])
-    }
+extension `Boundary Tests` {
+    @Suite
+    struct `Cofree boundaries` {
+        fileprivate let two = Count.Cofree<Int>.cofree(
+            2,
+            .successor(.cofree(1, .successor(.cofree(0, .zero))))
+        )
 
-    @Test
-    func `extending with extract changes nothing`() {
-        #expect(annotations(two.extend { $0.extract }) == [2, 1, 0])
-    }
+        @Test
+        func `extract returns the outermost annotation`() {
+            #expect(two.extract == 2)
+            #expect(Count.Cofree<Int>.cofree(7, .zero).extract == 7)
+        }
+
+        @Test
+        func `map transforms the annotation of every layer`() {
+            #expect(annotations(two.map { $0 * 10 }) == [20, 10, 0])
+        }
+
+        @Test
+        func `extending with extract changes nothing`() {
+            #expect(annotations(two.extend { $0.extract }) == [2, 1, 0])
+        }
 
-    @Test
-    func `duplicate annotates each layer with its own subtree`() {
-        #expect(annotations(two.duplicate().map { $0.extract }) == [2, 1, 0])
+        @Test
+        func `duplicate annotates each layer with its own subtree`() {
+            #expect(annotations(two.duplicate().map { $0.extract }) == [2, 1, 0])
+        }
     }
 }
