---
 Sources/Ellipse/Ellipse.swift | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/Sources/Ellipse/Ellipse.swift b/Sources/Ellipse/Ellipse.swift
index 6e8d3f8..6ef249d 100644
--- a/Sources/Ellipse/Ellipse.swift
+++ b/Sources/Ellipse/Ellipse.swift
