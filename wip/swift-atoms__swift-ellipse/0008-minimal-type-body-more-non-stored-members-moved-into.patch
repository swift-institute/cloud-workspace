From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:27:40 +0000
Subject: [PATCH 8/8] minimal type body: more non-stored members moved into an
 extension of their type (batch 10; type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 Sources/Ellipse/Ellipse.swift | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/Sources/Ellipse/Ellipse.swift b/Sources/Ellipse/Ellipse.swift
index 6e8d3f8..6ef249d 100644
--- a/Sources/Ellipse/Ellipse.swift
+++ b/Sources/Ellipse/Ellipse.swift
@@ -7,8 +7,6 @@ public struct Ellipse<Point, Length: Magnitude::Scalar, Angular: BinaryFloatingP
     public let semiMinor: Magnitude<Length>
     public var orientation: Rotation<2, Angular>
 
-    public enum Error: Swift::Error, Equatable, Sendable { case unorderedAxes }
-
     public init(
         center: Point,
         semiMajor: Magnitude<Length>,
@@ -21,6 +19,10 @@ public struct Ellipse<Point, Length: Magnitude::Scalar, Angular: BinaryFloatingP
         self.semiMinor = semiMinor
         self.orientation = orientation
     }
+}
+
+extension Ellipse {
+    public enum Error: Swift::Error, Equatable, Sendable { case unorderedAxes }
 
     public struct Arc {
         public var ellipse: Ellipse
@@ -33,7 +35,6 @@ public struct Ellipse<Point, Length: Magnitude::Scalar, Angular: BinaryFloatingP
 }
 
 extension Ellipse {
-
     public static func circle(
         center: Point,
         radius: Magnitude<Length>,
