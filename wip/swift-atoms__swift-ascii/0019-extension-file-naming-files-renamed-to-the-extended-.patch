 .../{String+ASCII.Serializable.swift => Swift.String.swift}       | 0
 ...ft.Character.ASCII+ASCII.swift => Swift.Character.ASCII.swift} | 0
 ...wift.StringProtocol+ASCII.swift => Swift.StringProtocol.swift} | 0
 3 files changed, 0 insertions(+), 0 deletions(-)
 rename Sources/ASCII/Absorbed/swift-ascii-serializer/Serializable ASCII/{String+ASCII.Serializable.swift => Swift.String.swift} (100%)
 rename Sources/ASCII/{Swift.Character.ASCII+ASCII.swift => Swift.Character.ASCII.swift} (100%)
 rename Sources/ASCII/{Swift.StringProtocol+ASCII.swift => Swift.StringProtocol.swift} (100%)

diff --git a/Sources/ASCII/Absorbed/swift-ascii-serializer/Serializable ASCII/String+ASCII.Serializable.swift b/Sources/ASCII/Absorbed/swift-ascii-serializer/Serializable ASCII/Swift.String.swift
similarity index 100%
rename from Sources/ASCII/Absorbed/swift-ascii-serializer/Serializable ASCII/String+ASCII.Serializable.swift
rename to Sources/ASCII/Absorbed/swift-ascii-serializer/Serializable ASCII/Swift.String.swift
diff --git a/Sources/ASCII/Swift.Character.ASCII+ASCII.swift b/Sources/ASCII/Swift.Character.ASCII.swift
similarity index 100%
rename from Sources/ASCII/Swift.Character.ASCII+ASCII.swift
rename to Sources/ASCII/Swift.Character.ASCII.swift
diff --git a/Sources/ASCII/Swift.StringProtocol+ASCII.swift b/Sources/ASCII/Swift.StringProtocol.swift
similarity index 100%
rename from Sources/ASCII/Swift.StringProtocol+ASCII.swift
rename to Sources/ASCII/Swift.StringProtocol.swift
