From dfee82886cfd3283caac3a6a4ba7b891df5f4916 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 23:28:20 +0000
Subject: [PATCH 08/13] minimal type body: more non-stored members move into
 extensions of their type (overnight/minimal-bodies.py); type-checked, failing
 files left out (coenttb/work#242)

---
 .../ASCII.Decimal.Coder.swift                 | 95 +++++++++----------
 .../IntegerParsing.swift                      |  4 +
 2 files changed, 51 insertions(+), 48 deletions(-)

diff --git a/Sources/ASCII/Absorbed/swift-ascii-coder/ASCII Decimal Coder/ASCII.Decimal.Coder.swift b/Sources/ASCII/Absorbed/swift-ascii-coder/ASCII Decimal Coder/ASCII.Decimal.Coder.swift
index be595da..cc24f52 100644
--- a/Sources/ASCII/Absorbed/swift-ascii-coder/ASCII Decimal Coder/ASCII.Decimal.Coder.swift	
+++ b/Sources/ASCII/Absorbed/swift-ascii-coder/ASCII Decimal Coder/ASCII.Decimal.Coder.swift	
@@ -8,7 +8,6 @@
     import Serializer
 
     extension ASCII.Decimal {
-
         public struct Coder<
             Input: Cursor.`Protocol`,
             Buffer: RangeReplaceableCollection,
@@ -19,11 +18,6 @@
             Input.Failure == Never,
             Buffer.Element == Byte
         {
-
-            public typealias Output = T
-
-            public typealias Failure = ASCII.Decimal.Error
-
             public let parser: ASCII.Decimal.Parser<Input, T>
 
             @inlinable
@@ -33,52 +27,57 @@
             ) {
                 self.parser = .init(sign: sign, count: count)
             }
+        }
+    }
 
-            @inlinable
-            public borrowing func parse(_ input: inout Input) throws(Failure) -> T {
-                try parser.parse(&input)
-            }
+extension ASCII.Decimal.Coder {
+        public typealias Output = T
 
-            @inlinable
-            public borrowing func serialize(
-                _ output: borrowing T,
-                into buffer: inout Buffer
-            ) throws(Failure) {
+        public typealias Failure = ASCII.Decimal.Error
+
+        @inlinable
+        public borrowing func parse(_ input: inout Input) throws(Failure) -> T {
+            try parser.parse(&input)
+        }
 
-                let value = copy output
+        @inlinable
+        public borrowing func serialize(
+            _ output: borrowing T,
+            into buffer: inout Buffer
+        ) throws(Failure) {
+            let value = copy output
 
-                let padding: Int
-                var magnitude = value.magnitude
-                var digits = 1
-                while magnitude >= 10 {
-                    magnitude /= 10
-                    digits += 1
-                }
-                switch parser.count {
-                case .greedy:
-                    padding = 0
-                case .exactly(let count):
-                    guard count >= 0 else { throw .invalidCount(count) }
-                    guard count > 0 else { throw .insufficientDigits }
-                    guard digits <= count else { throw .overflow }
-                    padding = count - digits
-                case .atMost(let count):
-                    guard count >= 0 else { throw .invalidCount(count) }
-                    guard count > 0 else { throw .noDigits }
-                    guard digits <= count else { throw .overflow }
-                    padding = 0
-                }
-                guard parser.sign == .optional || value >= 0 else {
-                    throw .invalidSign
-                }
-                if value < 0 {
-                    buffer.append(Byte(bitPattern: 0x2D))
-                }
-                for _ in 0..<padding {
-                    buffer.append(Byte(bitPattern: 0x30))
-                }
-                ASCII.Decimal.serialize(value.magnitude, into: &buffer)
+            let padding: Int
+            var magnitude = value.magnitude
+            var digits = 1
+            while magnitude >= 10 {
+                magnitude /= 10
+                digits += 1
+            }
+            switch parser.count {
+            case .greedy:
+                padding = 0
+            case .exactly(let count):
+                guard count >= 0 else { throw .invalidCount(count) }
+                guard count > 0 else { throw .insufficientDigits }
+                guard digits <= count else { throw .overflow }
+                padding = count - digits
+            case .atMost(let count):
+                guard count >= 0 else { throw .invalidCount(count) }
+                guard count > 0 else { throw .noDigits }
+                guard digits <= count else { throw .overflow }
+                padding = 0
             }
+            guard parser.sign == .optional || value >= 0 else {
+                throw .invalidSign
+            }
+            if value < 0 {
+                buffer.append(Byte(bitPattern: 0x2D))
+            }
+            for _ in 0..<padding {
+                buffer.append(Byte(bitPattern: 0x30))
+            }
+            ASCII.Decimal.serialize(value.magnitude, into: &buffer)
         }
-    }
+}
 #endif
diff --git a/Sources/ASCII/Absorbed/swift-ascii-parser/ASCII Integer Parsing/IntegerParsing.swift b/Sources/ASCII/Absorbed/swift-ascii-parser/ASCII Integer Parsing/IntegerParsing.swift
index da06409..c38ae2c 100644
--- a/Sources/ASCII/Absorbed/swift-ascii-parser/ASCII Integer Parsing/IntegerParsing.swift	
+++ b/Sources/ASCII/Absorbed/swift-ascii-parser/ASCII Integer Parsing/IntegerParsing.swift	
@@ -5,12 +5,16 @@
     internal import Iterator
 
     package enum IntegerParsing {
+    }
+
+    extension IntegerParsing {
         package enum Radix: Int {
             case binary = 2
             case octal = 8
             case decimal = 10
             case hexadecimal = 16
         }
+
         package enum Error: Swift.Error {
             case noDigits, overflow, insufficientDigits, invalidSign
             case invalidCount(Int)
