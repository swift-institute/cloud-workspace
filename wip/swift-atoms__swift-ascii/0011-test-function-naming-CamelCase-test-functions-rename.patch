From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:25:26 +0000
Subject: [PATCH 11/13] test function naming: CamelCase test functions renamed
 to backticked sentences (tests only; type-checked, not run; Linux x86_64,
 Swift 6.4.2) (coenttb/work#242)

---
 .../ASCII.Decimal.Float.Parser Tests.swift                      | 2 +-
 .../FixedWidthInteger+Parseable Tests.swift                     | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/Tests/Absorbed/swift-ascii-parser/ASCII Decimal Parser Tests/ASCII.Decimal.Float.Parser Tests.swift b/Tests/Absorbed/swift-ascii-parser/ASCII Decimal Parser Tests/ASCII.Decimal.Float.Parser Tests.swift
index 6461a1b..6d51214 100644
--- a/Tests/Absorbed/swift-ascii-parser/ASCII Decimal Parser Tests/ASCII.Decimal.Float.Parser Tests.swift	
+++ b/Tests/Absorbed/swift-ascii-parser/ASCII Decimal Parser Tests/ASCII.Decimal.Float.Parser Tests.swift	
@@ -289,7 +289,7 @@
             "1e-400", "10000000000000000000e-419",
             "-1e-400", "-10000000000000000000e-419",
         ])
-        func exponentExtremesAgreeAcrossMantissaPaths(_ text: String) throws {
+        func `exponent extremes agree across mantissa paths`(_ text: String) throws {
             let expected = try #require(Double(text))
             var input = bytes(text + ",tail")
             let value = try ASCII.Decimal.Float.Parser<Cursor>().parse(&input)
diff --git a/Tests/Absorbed/swift-ascii-parser/ASCII Parser Standard Library Integration Tests/FixedWidthInteger+Parseable Tests.swift b/Tests/Absorbed/swift-ascii-parser/ASCII Parser Standard Library Integration Tests/FixedWidthInteger+Parseable Tests.swift
index 10a661f..fe8f3e1 100644
--- a/Tests/Absorbed/swift-ascii-parser/ASCII Parser Standard Library Integration Tests/FixedWidthInteger+Parseable Tests.swift	
+++ b/Tests/Absorbed/swift-ascii-parser/ASCII Parser Standard Library Integration Tests/FixedWidthInteger+Parseable Tests.swift	
@@ -72,7 +72,7 @@ extension `FixedWidthInteger+Parseable Tests` {
 }
 
     extension `FixedWidthInteger+Parseable Tests`.`Parseable Integer Tests` {
-        @Test func acceptsLazyAndNonzeroStartCollections() throws {
+        @Test func `accepts lazy and nonzero start collections`() throws {
             let lazyBytes = "42".utf8.lazy.map(Byte.init(bitPattern:))
             #expect(try Int(ascii: lazyBytes) == 42)
             let storage = [Byte](utf8: "xx42")
