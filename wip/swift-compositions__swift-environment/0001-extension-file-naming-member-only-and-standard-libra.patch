From 7d5db718333490f0f36a250a49ba1a9db0663cb7 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 20:52:56 +0000
Subject: [PATCH 1/3] extension file naming: member-only and
 standard-library-conformance extension files merge into their type's own file
 (overnight/merge-extension-files.py); single type per file: additional types
 move to their own <Parent>.<Name>.swift inside the container's extension
 (overnight/split-types.py); parse-checked; builds pending (coenttb/work#242)

---
 .../Environment.Snapshot+Dotenv.swift         |  6 ----
 .../Environment.Snapshot.Accessors.swift      | 23 --------------
 .../Environment.Snapshot.swift                | 31 +++++++++++++++++++
 3 files changed, 31 insertions(+), 29 deletions(-)
 delete mode 100644 Sources/Environment Core/Environment.Snapshot+Dotenv.swift
 delete mode 100644 Sources/Environment Core/Environment.Snapshot.Accessors.swift

diff --git a/Sources/Environment Core/Environment.Snapshot+Dotenv.swift b/Sources/Environment Core/Environment.Snapshot+Dotenv.swift
deleted file mode 100644
index 428083e..0000000
--- a/Sources/Environment Core/Environment.Snapshot+Dotenv.swift	
+++ /dev/null
@@ -1,6 +0,0 @@
-extension Environment.Snapshot {
-
-    public init(_ dotenv: Environment.Dotenv) {
-        self.init(dotenv.values)
-    }
-}
diff --git a/Sources/Environment Core/Environment.Snapshot.Accessors.swift b/Sources/Environment Core/Environment.Snapshot.Accessors.swift
deleted file mode 100644
index 353bfec..0000000
--- a/Sources/Environment Core/Environment.Snapshot.Accessors.swift	
+++ /dev/null
@@ -1,23 +0,0 @@
-extension Environment.Snapshot {
-
-    public func string(_ key: Swift.String) -> Swift.String? {
-        self[key]
-    }
-
-    public func int(_ key: Swift.String) -> Swift.Int? {
-        self[key].flatMap(Swift.Int.init)
-    }
-
-    public func bool(_ key: Swift.String) -> Swift.Bool? {
-        guard let value = self[key]?.lowercased() else { return nil }
-        switch value {
-        case "1", "true", "yes", "on": return true
-        case "0", "false", "no", "off": return false
-        default: return nil
-        }
-    }
-
-    public func url(_ key: Swift.String) -> Swift.String? {
-        self[key]
-    }
-}
diff --git a/Sources/Environment Core/Environment.Snapshot.swift b/Sources/Environment Core/Environment.Snapshot.swift
index 793c0d3..abac9f1 100644
--- a/Sources/Environment Core/Environment.Snapshot.swift	
+++ b/Sources/Environment Core/Environment.Snapshot.swift	
@@ -24,3 +24,34 @@ extension Environment.Snapshot {
         set { values[name] = newValue }
     }
 }
+
+extension Environment.Snapshot {
+
+    public init(_ dotenv: Environment.Dotenv) {
+        self.init(dotenv.values)
+    }
+}
+
+extension Environment.Snapshot {
+
+    public func string(_ key: Swift.String) -> Swift.String? {
+        self[key]
+    }
+
+    public func int(_ key: Swift.String) -> Swift.Int? {
+        self[key].flatMap(Swift.Int.init)
+    }
+
+    public func bool(_ key: Swift.String) -> Swift.Bool? {
+        guard let value = self[key]?.lowercased() else { return nil }
+        switch value {
+        case "1", "true", "yes", "on": return true
+        case "0", "false", "no", "off": return false
+        default: return nil
+        }
+    }
+
+    public func url(_ key: Swift.String) -> Swift.String? {
+        self[key]
+    }
+}
