--- a/Sources/RFC 791/Absorbed swift-rfc-791-coder/RFC_791.Flags.Coder.swift	
+++ b/Sources/RFC 791/Absorbed swift-rfc-791-coder/RFC_791.Flags.Coder.swift	
@@ -7,30 +7,30 @@
     import Serializer
 
     extension RFC_791.Flags {
-
         public struct Coder<Input: Cursor.`Protocol`<Byte, Never>, Buffer: RangeReplaceableCollection<Byte>>: Coding {
+            public init() {}
+        }
 
