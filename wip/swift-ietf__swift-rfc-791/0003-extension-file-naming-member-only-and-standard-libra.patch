From 6d081544408ed40d0806fb00cdda25fdff609a85 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 20:52:53 +0000
Subject: [PATCH 3/4] extension file naming: member-only and
 standard-library-conformance extension files merge into their type's own file
 (overnight/merge-extension-files.py); single type per file: additional types
 move to their own <Parent>.<Name>.swift inside the container's extension
 (overnight/split-types.py); parse-checked; builds pending (coenttb/work#242)

---
 Sources/RFC 791/RFC_791.IPv4.Address.Class.swift |  9 ---------
 Sources/RFC 791/RFC_791.IPv4.Address.Is.swift    | 12 ++++++++++++
 Sources/RFC 791/RFC_791.IPv4.swift               |  4 ++++
 Sources/RFC 791/RFC_791.swift                    |  2 --
 4 files changed, 16 insertions(+), 11 deletions(-)
 create mode 100644 Sources/RFC 791/RFC_791.IPv4.Address.Is.swift
 create mode 100644 Sources/RFC 791/RFC_791.IPv4.swift

diff --git a/Sources/RFC 791/RFC_791.IPv4.Address.Class.swift b/Sources/RFC 791/RFC_791.IPv4.Address.Class.swift
index 219a07f..5a2bc5a 100644
--- a/Sources/RFC 791/RFC_791.IPv4.Address.Class.swift	
+++ b/Sources/RFC 791/RFC_791.IPv4.Address.Class.swift	
@@ -40,15 +40,6 @@ extension RFC_791.IPv4.Address {
 
 extension RFC_791.IPv4.Address {
 
-    public struct Is: Sendable {
-        @usableFromInline
-        let address: RFC_791.IPv4.Address
-
-        @usableFromInline
-        init(_ address: RFC_791.IPv4.Address) {
-            self.address = address
-        }
-    }
 
     public var `is`: Is {
         Is(self)
diff --git a/Sources/RFC 791/RFC_791.IPv4.Address.Is.swift b/Sources/RFC 791/RFC_791.IPv4.Address.Is.swift
new file mode 100644
index 0000000..99dec98
--- /dev/null
+++ b/Sources/RFC 791/RFC_791.IPv4.Address.Is.swift	
@@ -0,0 +1,12 @@
+
+extension RFC_791.IPv4.Address {
+    public struct Is: Sendable {
+        @usableFromInline
+        let address: RFC_791.IPv4.Address
+
+        @usableFromInline
+        init(_ address: RFC_791.IPv4.Address) {
+            self.address = address
+        }
+    }
+}
diff --git a/Sources/RFC 791/RFC_791.IPv4.swift b/Sources/RFC 791/RFC_791.IPv4.swift
new file mode 100644
index 0000000..c95e752
--- /dev/null
+++ b/Sources/RFC 791/RFC_791.IPv4.swift	
@@ -0,0 +1,4 @@
+
+extension RFC_791 {
+    public enum IPv4 {}
+}
diff --git a/Sources/RFC 791/RFC_791.swift b/Sources/RFC 791/RFC_791.swift
index b8cd9d8..07b1d79 100644
--- a/Sources/RFC 791/RFC_791.swift	
+++ b/Sources/RFC 791/RFC_791.swift	
@@ -1,6 +1,4 @@
 public enum RFC_791 {}
 
 extension RFC_791 {
-
-    public enum IPv4 {}
 }
