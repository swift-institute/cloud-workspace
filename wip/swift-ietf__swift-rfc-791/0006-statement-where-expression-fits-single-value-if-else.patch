From a65a9cb6fc88778d4445744528df14ae33bca5e1 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:35:30 +0000
Subject: [PATCH 6/6] statement where expression fits: single-value if/else
 chains written as if expressions (type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 Sources/RFC 791/RFC_791.IPv4.Address.Class.swift | 12 ++++++------
 1 file changed, 6 insertions(+), 6 deletions(-)

diff --git a/Sources/RFC 791/RFC_791.IPv4.Address.Class.swift b/Sources/RFC 791/RFC_791.IPv4.Address.Class.swift
index 5a2bc5a..6e4857e 100644
--- a/Sources/RFC 791/RFC_791.IPv4.Address.Class.swift	
+++ b/Sources/RFC 791/RFC_791.IPv4.Address.Class.swift	
@@ -19,21 +19,21 @@ extension RFC_791.IPv4.Address {
     public var `class`: Class {
         let firstOctet = UInt8((rawValue >> 24) & 0xFF)
 
-        if firstOctet & 0b1000_0000 == 0 {
+        return if firstOctet & 0b1000_0000 == 0 {
 
-            return .a
+            .a
         } else if firstOctet & 0b1100_0000 == 0b1000_0000 {
 
-            return .b
+            .b
         } else if firstOctet & 0b1110_0000 == 0b1100_0000 {
 
-            return .c
+            .c
         } else if firstOctet & 0b1111_0000 == 0b1110_0000 {
 
-            return .d
+            .d
         } else {
 
-            return .e
+            .e
         }
     }
 }
