From b06e4f5528a3f84d262628301b9284ffc63d3df8 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:32:49 +0000
Subject: [PATCH 5/5] compound type name, compound identifier: single-file
 internal types made fileprivate, package members used only in their target
 made internal (type-check follows; Linux x86_64, Swift 6.4.2)
 (coenttb/work#242)

---
 Sources/Machine/Machine.Value.Arena.swift     | 2 +-
 Tests/Machine Tests/Machine.Frame Tests.swift | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/Sources/Machine/Machine.Value.Arena.swift b/Sources/Machine/Machine.Value.Arena.swift
index 37b14e2..89ef939 100644
--- a/Sources/Machine/Machine.Value.Arena.swift
+++ b/Sources/Machine/Machine.Value.Arena.swift
@@ -39,7 +39,7 @@ extension Machine.Value.Arena {
     }
 
     @inlinable
-    package func validateHandle(_ handle: Machine.Value<Mode>.Handle, operation: StaticString) {
+    func validateHandle(_ handle: Machine.Value<Mode>.Handle, operation: StaticString) {
         guard handle.generation == generation else {
             fatalError(
                 "Arena.\(operation): stale handle (generation \(handle.generation), current \(generation))"
diff --git a/Tests/Machine Tests/Machine.Frame Tests.swift b/Tests/Machine Tests/Machine.Frame Tests.swift
index 80d8c18..ecdf1a6 100644
--- a/Tests/Machine Tests/Machine.Frame Tests.swift	
+++ b/Tests/Machine Tests/Machine.Frame Tests.swift	
@@ -271,7 +271,7 @@ extension `Machine.Frame Tests` {
         typealias Checkpoint = Int
         enum TestError: Swift::Error, Sendable { case failed }
 
-        struct MemoEntry: Equatable, Sendable {
+        fileprivate struct MemoEntry: Equatable, Sendable {
             var nodeId: NodeID
             var position: Int
         }
