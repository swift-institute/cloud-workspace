Subject: [PATCH 3/5] Revert the extension-file merges and type splits in
 directories where a merged file brought its conditional imports mid-file
 (coenttb/work#242)

---
 Sources/Machine/Machine.Program+Apply.swift   | 46 +++++++++++++++
 Sources/Machine/Machine.Program.analyze.swift | 14 +++++
 Sources/Machine/Machine.Program.swift         | 59 -------------------
 3 files changed, 60 insertions(+), 59 deletions(-)
 create mode 100644 Sources/Machine/Machine.Program+Apply.swift
 create mode 100644 Sources/Machine/Machine.Program.analyze.swift

diff --git a/Sources/Machine/Machine.Program+Apply.swift b/Sources/Machine/Machine.Program+Apply.swift
new file mode 100644
index 0000000..fa63ae1
--- /dev/null
+++ b/Sources/Machine/Machine.Program+Apply.swift
@@ -0,0 +1,46 @@
+import Ordinal
+public import Tagged
+
+extension Machine.Program {
+
+    @inlinable
+    public func apply(
+        _ transform: Machine.Transform.Erased<Mode>,
+        to value: Machine.Value<Mode>
+    ) -> Machine.Value<Mode> {
+        transform.apply(using: captures, value)
+    }
+
+    @inlinable
+    public func apply(
+        _ transform: Machine.Transform.Throwing<Mode, Failure>,
+        to value: Machine.Value<Mode>
+    ) throws(Failure) -> Machine.Value<Mode> {
+        try transform.apply(using: captures, value)
+    }
+
+    @inlinable
+    public func combine(
+        _ combine: Machine.Combine.Erased<Mode>,
+        _ a: Machine.Value<Mode>,
+        _ b: Machine.Value<Mode>
+    ) -> Machine.Value<Mode> {
+        combine.combine(using: captures, a, b)
+    }
+
+    @inlinable
+    public func next(
+        _ next: Machine.Next.Erased<Mode, Machine.Node<Leaf, Failure, Mode>.ID>,
+        from value: Machine.Value<Mode>
+    ) -> Machine.Node<Leaf, Failure, Mode>.ID {
+        next.next(using: captures, value)
+    }
+
+    @inlinable
+    public func finalize(
+        _ finalize: Machine.Finalize.Array<Mode>,
+        _ values: [Machine.Value<Mode>]
+    ) -> Machine.Value<Mode> {
+        finalize.finalize(using: captures, values)
+    }
+}
diff --git a/Sources/Machine/Machine.Program.analyze.swift b/Sources/Machine/Machine.Program.analyze.swift
new file mode 100644
index 0000000..80d74a5
--- /dev/null
+++ b/Sources/Machine/Machine.Program.analyze.swift
@@ -0,0 +1,14 @@
+#if Analyze
+    public import Graph
+
+    extension Machine.Program {
+
+        @inlinable
+        public var analyze:
+            Graph.Sequential<Machine.Node<Leaf, Failure, Mode>, Machine.Node<Leaf, Failure, Mode>>
+                .Analyze<[Machine.Node<Leaf, Failure, Mode>.ID]>
+        {
+            graph.analyze(using: Machine.Node.extract)
+        }
+    }
+#endif
