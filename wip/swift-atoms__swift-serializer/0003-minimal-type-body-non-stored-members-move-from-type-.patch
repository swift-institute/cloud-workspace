From dcb677f64cac9ed99804223b583aa3ccc13c0373 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 22:39:53 +0000
Subject: [PATCH 03/14] minimal type body: non-stored members move from type
 bodies into an extension of the type in the same file
 (overnight/minimal-bodies.py); type-checked against the root build,
 directories that failed or couldn't be checked left out (coenttb/work#242)

---
 Sources/Serializer/Lazy/Lazy.Serializer.swift | 41 ++++++++++---------
 .../Swift/Swift.Array+Serializer.swift        | 20 ++++-----
 2 files changed, 31 insertions(+), 30 deletions(-)

diff --git a/Sources/Serializer/Lazy/Lazy.Serializer.swift b/Sources/Serializer/Lazy/Lazy.Serializer.swift
index 0d9d7e4..9b58864 100644
--- a/Sources/Serializer/Lazy/Lazy.Serializer.swift
+++ b/Sources/Serializer/Lazy/Lazy.Serializer.swift
@@ -9,12 +9,7 @@
         Value.Buffer: ~Copyable & ~Escapable,
         Value.Output: ~Copyable & ~Escapable
     {
-
         public struct Serializer<Failure: Swift::Error>: Serializing {
-
-            public typealias Buffer = Value.Buffer
-            public typealias Output = Value.Output
-
             public let wrapped: Lazy::Lazy<Value, FactoryFailure>
             @usableFromInline internal let factoryFailure: (FactoryFailure) -> Failure
             @usableFromInline internal let serializeFailure: (Value.Failure) -> Failure
@@ -34,21 +29,6 @@
                 self.factoryFailure = { .left($0) }
                 self.serializeFailure = { .right($0) }
             }
-
-            @inlinable
-            public borrowing func serialize(_ output: borrowing Output, into buffer: inout Buffer) throws(Failure) {
-                let parser: Value
-                do throws(FactoryFailure) {
-                    parser = try wrapped()
-                } catch {
-                    throw factoryFailure(error)
-                }
-                do throws(Value.Failure) {
-                    try parser.serialize(output, into: &buffer)
-                } catch {
-                    throw serializeFailure(error)
-                }
-            }
         }
 
         @inlinable
@@ -61,4 +41,25 @@
             .init(self)
         }
     }
+
+extension Lazy.Serializer {
+        public typealias Buffer = Value.Buffer
+
+        public typealias Output = Value.Output
+
+        @inlinable
+        public borrowing func serialize(_ output: borrowing Output, into buffer: inout Buffer) throws(Failure) {
+            let parser: Value
+            do throws(FactoryFailure) {
+                parser = try wrapped()
+            } catch {
+                throw factoryFailure(error)
+            }
+            do throws(Value.Failure) {
+                try parser.serialize(output, into: &buffer)
+            } catch {
+                throw serializeFailure(error)
+            }
+        }
+}
 #endif
diff --git a/Sources/Serializer/Swift/Swift.Array+Serializer.swift b/Sources/Serializer/Swift/Swift.Array+Serializer.swift
index 17c86cb..1f0f02c 100644
--- a/Sources/Serializer/Swift/Swift.Array+Serializer.swift
+++ b/Sources/Serializer/Swift/Swift.Array+Serializer.swift
@@ -1,24 +1,24 @@
 public import Serializer_Core
 
 extension Swift.Array {
-
     public struct Serializer<Buffer: RangeReplaceableCollection>: Serializer::Serializing
     where Buffer.Element == Element {
-
-        public typealias Output = Void
-
-        public typealias Failure = Never
-
         public let elements: [Element]
 
         @inlinable
         public init(_ elements: [Element]) {
             self.elements = elements
         }
+    }
+}
 
-        @inlinable
-        public borrowing func serialize(_ output: Void, into buffer: inout Buffer) {
-            buffer.append(contentsOf: elements)
-        }
+extension Swift.Array.Serializer {
+    public typealias Output = Void
+
+    public typealias Failure = Never
+
+    @inlinable
+    public borrowing func serialize(_ output: Void, into buffer: inout Buffer) {
+        buffer.append(contentsOf: elements)
     }
 }
