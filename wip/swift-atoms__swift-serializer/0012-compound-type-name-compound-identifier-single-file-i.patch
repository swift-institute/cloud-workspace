 (coenttb/work#242)

---
 Tests/Serializer Tests/Collection Many Tests.swift | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/Tests/Serializer Tests/Collection Many Tests.swift b/Tests/Serializer Tests/Collection Many Tests.swift
index d7417f2..903032c 100644
--- a/Tests/Serializer Tests/Collection Many Tests.swift	
+++ b/Tests/Serializer Tests/Collection Many Tests.swift	
@@ -71,7 +71,7 @@ extension `Collection Many Tests` {
         }
     }
 
-    struct RepeatedCharacter: Serializing {
+    fileprivate struct RepeatedCharacter: Serializing {
         typealias Output = Character
         typealias Buffer = [UInt8]
         typealias Failure = Never
@@ -83,7 +83,7 @@ extension `Collection Many Tests` {
         }
     }
 
-    struct RepeatedComma: Serializing {
+    fileprivate struct RepeatedComma: Serializing {
         typealias Output = Void
         typealias Buffer = [UInt8]
         typealias Failure = Never
