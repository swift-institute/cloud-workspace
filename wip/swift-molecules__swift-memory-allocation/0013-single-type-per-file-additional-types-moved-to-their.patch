From cbccda582940bcea73d135541cc8495de364b175 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:06:17 +0000
Subject: [PATCH 13/23] single type per file: additional types moved to their
 own files (type-check follows; Linux x86_64, Swift 6.4.2) (coenttb/work#242)

---
 Sources/Memory Pool/Memory.Pool.Error.swift | 23 +++++++++++++++++++++
 Sources/Memory Pool/Memory.Pool.Slot.swift  |  9 ++++++++
 Sources/Memory Pool/Memory.Pool.swift       | 17 +--------------
 3 files changed, 33 insertions(+), 16 deletions(-)
 create mode 100644 Sources/Memory Pool/Memory.Pool.Error.swift
 create mode 100644 Sources/Memory Pool/Memory.Pool.Slot.swift

diff --git a/Sources/Memory Pool/Memory.Pool.Error.swift b/Sources/Memory Pool/Memory.Pool.Error.swift
new file mode 100644
index 0000000..507a10d
--- /dev/null
+++ b/Sources/Memory Pool/Memory.Pool.Error.swift	
@@ -0,0 +1,23 @@
+public import Cardinal
+import Index
+public import Memory
+public import Tagged
+
+
+extension Memory.Pool {
+    public enum Error: Swift.Error, Equatable, Sendable {
+        case exhausted(capacity: Count)
+
+        case slotSizeTooSmall(requested: Memory.Address.Count, minimum: Memory.Address.Count)
+
+        case requestExceedsSlot(requested: Memory.Address.Count, slot: Memory.Address.Count)
+
+        case alignmentExceedsSlot(requested: Memory.Alignment, slot: Memory.Alignment)
+
+        case invalidCapacity
+
+        case foreignPointer
+
+        case doubleFree
+    }
+}
diff --git a/Sources/Memory Pool/Memory.Pool.Slot.swift b/Sources/Memory Pool/Memory.Pool.Slot.swift
new file mode 100644
index 0000000..0895ed0
--- /dev/null
+++ b/Sources/Memory Pool/Memory.Pool.Slot.swift	
@@ -0,0 +1,9 @@
+public import Cardinal
+import Index
+public import Memory
+public import Tagged
+
+
+extension Memory.Pool {
+    public enum Slot {}
+}
diff --git a/Sources/Memory Pool/Memory.Pool.swift b/Sources/Memory Pool/Memory.Pool.swift
index 02bf13e..dd36a52 100644
--- a/Sources/Memory Pool/Memory.Pool.swift	
+++ b/Sources/Memory Pool/Memory.Pool.swift	
@@ -9,23 +9,8 @@ extension Memory {
 }
 
 extension Memory.Pool {
-    public enum Slot {}
 
-    public typealias Count = Tagged::Tagged<Slot, Cardinal::Cardinal>
-
-    public enum Error: Swift.Error, Equatable, Sendable {
-        case exhausted(capacity: Count)
-
-        case slotSizeTooSmall(requested: Memory.Address.Count, minimum: Memory.Address.Count)
-
-        case requestExceedsSlot(requested: Memory.Address.Count, slot: Memory.Address.Count)
 
-        case alignmentExceedsSlot(requested: Memory.Alignment, slot: Memory.Alignment)
-
-        case invalidCapacity
-
-        case foreignPointer
+    public typealias Count = Tagged::Tagged<Slot, Cardinal::Cardinal>
 
-        case doubleFree
-    }
 }
-- 
