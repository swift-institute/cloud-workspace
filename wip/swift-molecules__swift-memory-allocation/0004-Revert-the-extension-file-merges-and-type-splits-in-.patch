diff --git a/Sources/Memory Small/Absorbed swift-memory-small/Memory.Small ~Copyable.swift b/Sources/Memory Small/Absorbed swift-memory-small/Memory.Small ~Copyable.swift
new file mode 100644
index 0000000..8f78c09
--- /dev/null
+++ b/Sources/Memory Small/Absorbed swift-memory-small/Memory.Small ~Copyable.swift	
@@ -0,0 +1,19 @@
+#if MemorySmall
+    public import Memory
+
+    extension Memory.Small {
+
+        @inlinable
+        package init(_storage: consuming _Representation) {
+            self._storage = _storage
+        }
+
+        @inlinable
+        public var isSpilled: Bool {
+            switch _storage {
+            case .inline: false
+            case .heap: true
+            }
+        }
+    }
+#endif
