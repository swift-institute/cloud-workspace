From 92fa081111054aea666eb1eaeedc1fe652fb9346 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:27:43 +0000
Subject: [PATCH 10/22] minimal type body: more non-stored members moved into
 an extension of their type (batch 10; type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 Sources/Memory Pool/Memory.Pool.swift | 26 +++++++++++++-------------
 1 file changed, 13 insertions(+), 13 deletions(-)

diff --git a/Sources/Memory Pool/Memory.Pool.swift b/Sources/Memory Pool/Memory.Pool.swift
index bd84dbc..02bf13e 100644
--- a/Sources/Memory Pool/Memory.Pool.swift	
+++ b/Sources/Memory Pool/Memory.Pool.swift	
@@ -4,28 +4,28 @@ public import Memory
 public import Tagged
 
 extension Memory {
-
     public enum Pool {
+    }
+}
 
-        public enum Slot {}
-
-        public typealias Count = Tagged::Tagged<Slot, Cardinal::Cardinal>
+extension Memory.Pool {
+    public enum Slot {}
 
-        public enum Error: Swift.Error, Equatable, Sendable {
+    public typealias Count = Tagged::Tagged<Slot, Cardinal::Cardinal>
 
-            case exhausted(capacity: Count)
+    public enum Error: Swift.Error, Equatable, Sendable {
+        case exhausted(capacity: Count)
 
-            case slotSizeTooSmall(requested: Memory.Address.Count, minimum: Memory.Address.Count)
+        case slotSizeTooSmall(requested: Memory.Address.Count, minimum: Memory.Address.Count)
 
-            case requestExceedsSlot(requested: Memory.Address.Count, slot: Memory.Address.Count)
+        case requestExceedsSlot(requested: Memory.Address.Count, slot: Memory.Address.Count)
 
-            case alignmentExceedsSlot(requested: Memory.Alignment, slot: Memory.Alignment)
+        case alignmentExceedsSlot(requested: Memory.Alignment, slot: Memory.Alignment)
 
-            case invalidCapacity
+        case invalidCapacity
 
-            case foreignPointer
+        case foreignPointer
 
-            case doubleFree
-        }
+        case doubleFree
     }
 }
