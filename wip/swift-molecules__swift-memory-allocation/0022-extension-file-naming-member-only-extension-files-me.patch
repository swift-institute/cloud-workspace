From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:46:11 +0000
Subject: [PATCH 22/23] extension file naming: member-only extension files
 merged into the extended type's own file (type-check follows; Linux x86_64,
 Swift 6.4.2) (coenttb/work#242)

---
 Sources/Memory Allocator Protocol/Memory.Allocating.swift | 6 ------
 Sources/Memory Allocator Protocol/Memory.swift            | 5 +++++
 2 files changed, 5 insertions(+), 6 deletions(-)
 delete mode 100644 Sources/Memory Allocator Protocol/Memory.Allocating.swift

diff --git a/Sources/Memory Allocator Protocol/Memory.Allocating.swift b/Sources/Memory Allocator Protocol/Memory.Allocating.swift
deleted file mode 100644
index 6f69ce0..0000000
--- a/Sources/Memory Allocator Protocol/Memory.Allocating.swift	
+++ /dev/null
@@ -1,6 +0,0 @@
-public import Memory
-
-extension Memory {
-
-    public typealias Allocating = __MemoryAllocatorProtocol
-}
diff --git a/Sources/Memory Allocator Protocol/Memory.swift b/Sources/Memory Allocator Protocol/Memory.swift
index c36569a..ee504e0 100644
--- a/Sources/Memory Allocator Protocol/Memory.swift	
+++ b/Sources/Memory Allocator Protocol/Memory.swift	
@@ -4,3 +4,8 @@ extension Memory {
 
     public typealias Allocatable = __MemoryAllocatableProtocol
 }
+
+extension Memory {
+
+    public typealias Allocating = __MemoryAllocatorProtocol
+}
