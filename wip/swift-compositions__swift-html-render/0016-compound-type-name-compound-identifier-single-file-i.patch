From 56f305bdd965dd2b4cb39201f773311b4874a0d0 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:32:51 +0000
Subject: [PATCH 16/16] compound type name, compound identifier: single-file
 internal types made fileprivate, package members used only in their target
 made internal (type-check follows; Linux x86_64, Swift 6.4.2)
 (coenttb/work#242)

---
 Sources/HTML Attributes Rendering/PopoverTarget.swift           | 2 +-
 Sources/HTML Attributes Rendering/PopoverTargetAction.swift     | 2 +-
 Sources/HTML Rendering Core/HTML.Context.swift                  | 2 +-
 .../HTML Renderable Snapshot Tests/AtRule Media Tests.swift     | 2 +-
 4 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/Sources/HTML Attributes Rendering/PopoverTarget.swift b/Sources/HTML Attributes Rendering/PopoverTarget.swift
index 5c6e59b..ab1e4ca 100644
--- a/Sources/HTML Attributes Rendering/PopoverTarget.swift	
+++ b/Sources/HTML Attributes Rendering/PopoverTarget.swift	
@@ -4,7 +4,7 @@ import HTML_Standard_Attributes
 extension HTML.View {
 
     @discardableResult
-    package func popoverTarget(
+    func popoverTarget(
         _ value: HTML.PopoverTarget.Attribute?
     ) -> HTML._Attributes<Self> {
         self.attribute(HTML.PopoverTarget.Attribute.attribute, value?.description)
diff --git a/Sources/HTML Attributes Rendering/PopoverTargetAction.swift b/Sources/HTML Attributes Rendering/PopoverTargetAction.swift
index 0c2cb19..9100866 100644
--- a/Sources/HTML Attributes Rendering/PopoverTargetAction.swift	
+++ b/Sources/HTML Attributes Rendering/PopoverTargetAction.swift	
@@ -4,7 +4,7 @@ import HTML_Standard_Attributes
 extension HTML.View {
 
     @discardableResult
-    package func popoverTargetAction(
+    func popoverTargetAction(
         _ value: HTML.PopoverTargetAction.Attribute?
     ) -> HTML._Attributes<Self> {
         self.attribute(HTML.PopoverTargetAction.Attribute.attribute, value?.description)
diff --git a/Sources/HTML Rendering Core/HTML.Context.swift b/Sources/HTML Rendering Core/HTML.Context.swift
index 2ec1c57..8f35ecd 100644
--- a/Sources/HTML Rendering Core/HTML.Context.swift	
+++ b/Sources/HTML Rendering Core/HTML.Context.swift	
@@ -35,7 +35,7 @@ extension HTML {
 
 extension HTML.Context {
 
-    struct SavedState {
+    fileprivate struct SavedState {
         let tag: String
         let isVoid: Bool
         let isBlock: Bool
diff --git a/Tests/Testing/HTML Renderable Snapshot Tests/AtRule Media Tests.swift b/Tests/Testing/HTML Renderable Snapshot Tests/AtRule Media Tests.swift
index 81d2de7..dedd9ec 100644
--- a/Tests/Testing/HTML Renderable Snapshot Tests/AtRule Media Tests.swift	
+++ b/Tests/Testing/HTML Renderable Snapshot Tests/AtRule Media Tests.swift	
@@ -237,7 +237,7 @@ extension `Snapshot Tests` {
     }
 }
 
-enum AtRule2 {
+fileprivate enum AtRule2 {
     case rule(String)
     indirect case nested(String, Self)
 }
