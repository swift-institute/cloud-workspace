From 06ed7e9b560cf6f44e6970848453cb977a880e7e Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:27:46 +0000
Subject: [PATCH 11/16] minimal type body: more non-stored members moved into
 an extension of their type (batch 10; type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 .../HTML._Attributes.swift                    | 39 ++++++++++---------
 1 file changed, 20 insertions(+), 19 deletions(-)

diff --git a/Sources/HTML Rendering Core/HTML._Attributes.swift b/Sources/HTML Rendering Core/HTML._Attributes.swift
index cdbaa10..67f9cd3 100644
--- a/Sources/HTML Rendering Core/HTML._Attributes.swift	
+++ b/Sources/HTML Rendering Core/HTML._Attributes.swift	
@@ -4,9 +4,7 @@ public import Renderer
 public import WHATWG_HTML_Shared
 
 extension HTML {
-
     public struct _Attributes<Content: HTML.View>: HTML.View {
-
         public let content: Renderer.Document.Indirect<Content>
 
         public var attributes: HTML.Context.Attributes
@@ -15,26 +13,29 @@ extension HTML {
             self.content = Renderer.Document.Indirect(content)
             self.attributes = attributes
         }
+    }
+}
 
-        public func attribute(_ name: String, _ value: String? = "") -> HTML._Attributes<Content> {
-            var copy = self
-            copy.attributes[name] = value
-            return copy
-        }
+extension HTML._Attributes {
+    public func attribute(_ name: String, _ value: String? = "") -> HTML._Attributes<Content> {
+        var copy = self
+        copy.attributes[name] = value
+        return copy
+    }
+
+    public typealias Body = Never
+
+    public var body: Never { fatalError("Body is Never and must not be accessed.") }
 
-        public typealias Body = Never
-        public var body: Never { fatalError("Body is Never and must not be accessed.") }
-
-        public static func _render(
-            _ view: borrowing Self,
-            context: inout Renderer.Document.Context
-        ) {
-            context.open(push: .attributes, pop: .attributes)
-            view.attributes.forEach { key, value in
-                context.set(attribute: key, value)
-            }
-            Content._render(view.content.value, context: &context)
+    public static func _render(
+        _ view: borrowing Self,
+        context: inout Renderer.Document.Context
+    ) {
+        context.open(push: .attributes, pop: .attributes)
+        view.attributes.forEach { key, value in
+            context.set(attribute: key, value)
         }
+        Content._render(view.content.value, context: &context)
     }
 }
 
