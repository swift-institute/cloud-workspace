@@ -4,73 +4,75 @@
     import Testing
     import Windows_32_Kernel
 
-    @Suite
-    struct `Path + Win32 grammar` {
-        @Test func absolute() {
-            let a: Path = #"C:\Users\a"#
-            let b: Path = "C:/Users/a"
