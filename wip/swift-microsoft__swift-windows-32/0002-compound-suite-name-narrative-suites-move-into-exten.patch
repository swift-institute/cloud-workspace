-            #expect(slash / "a" == #"C:\Users\a"#)
-            let abs: Path = #"D:\x"#
-            #expect(p / abs == #"D:\x"#)
-        }
-        @Test func relative() {
-            let p: Path = #"C:\Users\a\b.txt"#
