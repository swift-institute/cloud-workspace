From 8603a37823fe5eb174a0b4cb2e833f9239a583f9 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 22:39:56 +0000
Subject: [PATCH 5/7] minimal type body: non-stored members move from type
 bodies into an extension of the type in the same file
 (overnight/minimal-bodies.py); type-checked against the root build,
 directories that failed or couldn't be checked left out (coenttb/work#242)

---
 .../Windows.Kernel.File.Chown.swift           | 34 +++++++++----------
 1 file changed, 16 insertions(+), 18 deletions(-)

diff --git a/Sources/Windows 32 Kernel File/Windows.Kernel.File.Chown.swift b/Sources/Windows 32 Kernel File/Windows.Kernel.File.Chown.swift
index e921055..76b6c86 100644
--- a/Sources/Windows 32 Kernel File/Windows.Kernel.File.Chown.swift	
+++ b/Sources/Windows 32 Kernel File/Windows.Kernel.File.Chown.swift	
@@ -2,14 +2,11 @@
     public import Error
 
     extension Windows.`32`.Kernel.File {
-
         public enum Chown {}
     }
 
     extension Windows.`32`.Kernel.File.Chown {
-
         public enum Error: Swift.Error, Sendable, Equatable {
-
             case path(Path)
 
             case permission(Permission)
@@ -17,27 +14,28 @@
             case io(IO)
 
             case platform(Error::Error)
+        }
+    }
 
-            public enum Path: Swift.Error, Sendable, Equatable {
-                case notFound
-                case tooLong
-                case loop
-            }
+extension Windows.`32`.Kernel.File.Chown.Error {
+        public enum Path: Swift.Error, Sendable, Equatable {
+            case notFound
+            case tooLong
+            case loop
+        }
 
-            public enum Permission: Swift.Error, Sendable, Equatable {
-                case denied
-                case notPermitted
-                case readOnlyFilesystem
-            }
+        public enum Permission: Swift.Error, Sendable, Equatable {
+            case denied
+            case notPermitted
+            case readOnlyFilesystem
+        }
 
-            public enum IO: Swift.Error, Sendable, Equatable {
-                case hardware
-            }
+        public enum IO: Swift.Error, Sendable, Equatable {
+            case hardware
         }
-    }
+}
 
     extension Windows.`32`.Kernel.File.Chown {
-
         public static func chown(
             path: borrowing Path.Borrowed,
             uid: Windows.`32`.Kernel.User.ID,
-- 
2.43.0

