From 61366e0541afaa2391ab743cf8fb69ef3b730906 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:35:31 +0000
Subject: [PATCH 7/9] statement where expression fits: single-value if/else
 chains written as if expressions (type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 .../Windows.Kernel.Lock.Error+code.swift      |  6 ++---
 .../Windows.Kernel.Directory.swift            |  8 +++----
 .../Windows.Kernel.Environment.Error.swift    |  6 ++---
 .../Windows.Kernel.File.Open.Options.swift    | 12 +++++-----
 .../Windows.Kernel.File.Stats.Get.swift       |  8 +++----
 ...Windows.Kernel.Memory.Map.Protection.swift | 24 +++++++++----------
 .../Windows.Kernel.Memory.Map.swift           |  6 ++---
 .../Windows.Kernel.Name.swift                 |  6 ++---
 8 files changed, 38 insertions(+), 38 deletions(-)

diff --git a/Sources/Windows 32 Kernel Core/Windows.Kernel.Lock.Error+code.swift b/Sources/Windows 32 Kernel Core/Windows.Kernel.Lock.Error+code.swift
index 25f1190..1515a81 100644
--- a/Sources/Windows 32 Kernel Core/Windows.Kernel.Lock.Error+code.swift	
+++ b/Sources/Windows 32 Kernel Core/Windows.Kernel.Lock.Error+code.swift	
@@ -15,10 +15,10 @@
 
         @usableFromInline
         internal init(_ code: Error::Error.Code) {
-            if let mapped = Self(code: code) {
-                self = mapped
+            self = if let mapped = Self(code: code) {
+                mapped
             } else {
-                self = .platform(code: code)
+                .platform(code: code)
             }
         }
     }
diff --git a/Sources/Windows 32 Kernel Directory/Windows.Kernel.Directory.swift b/Sources/Windows 32 Kernel Directory/Windows.Kernel.Directory.swift
index 10684b9..baa5e2c 100644
--- a/Sources/Windows 32 Kernel Directory/Windows.Kernel.Directory.swift	
+++ b/Sources/Windows 32 Kernel Directory/Windows.Kernel.Directory.swift	
@@ -132,12 +132,12 @@
             nameChars.append(0)
 
             let type: Windows.`32`.Kernel.File.Stats.Kind?
-            if (findData.dwFileAttributes & DWORD(FILE_ATTRIBUTE_DIRECTORY)) != 0 {
-                type = .directory
+            type = if (findData.dwFileAttributes & DWORD(FILE_ATTRIBUTE_DIRECTORY)) != 0 {
+                .directory
             } else if (findData.dwFileAttributes & DWORD(FILE_ATTRIBUTE_REPARSE_POINT)) != 0 {
-                type = .link(.symbolic)
+                .link(.symbolic)
             } else {
-                type = .regular
+                .regular
             }
 
             return Windows.`32`.Kernel.Directory.Entry(rawName: nameChars, inode: nil, type: type)
diff --git a/Sources/Windows 32 Kernel Environment/Windows.Kernel.Environment.Error.swift b/Sources/Windows 32 Kernel Environment/Windows.Kernel.Environment.Error.swift
index ee65ef6..d1307b3 100644
--- a/Sources/Windows 32 Kernel Environment/Windows.Kernel.Environment.Error.swift	
+++ b/Sources/Windows 32 Kernel Environment/Windows.Kernel.Environment.Error.swift	
@@ -16,10 +16,10 @@ extension Windows.`32`.Kernel.Environment.Error {
     extension Windows.`32`.Kernel.Environment.Error {
 
         public init(code: Error::Error.Code) {
-            if let permission = Windows.`32`.Kernel.Permission.Error(code: code) {
-                self = .permission(permission)
+            self = if let permission = Windows.`32`.Kernel.Permission.Error(code: code) {
+                .permission(permission)
             } else {
-                self = .platform(Error::Error(code: code))
+                .platform(Error::Error(code: code))
             }
         }
     }
diff --git a/Sources/Windows 32 Kernel File/Windows.Kernel.File.Open.Options.swift b/Sources/Windows 32 Kernel File/Windows.Kernel.File.Open.Options.swift
index a00beef..edd5fe8 100644
--- a/Sources/Windows 32 Kernel File/Windows.Kernel.File.Open.Options.swift	
+++ b/Sources/Windows 32 Kernel File/Windows.Kernel.File.Open.Options.swift	
@@ -27,21 +27,21 @@
             let hasExclusive = contains(.exclusive)
             let hasTruncate = contains(.truncate)
 
-            if hasCreate && hasExclusive {
+            return if hasCreate && hasExclusive {
 
-                return DWORD(CREATE_NEW)
+                DWORD(CREATE_NEW)
             } else if hasCreate && hasTruncate {
 
-                return DWORD(CREATE_ALWAYS)
+                DWORD(CREATE_ALWAYS)
             } else if hasCreate {
 
-                return DWORD(OPEN_ALWAYS)
+                DWORD(OPEN_ALWAYS)
             } else if hasTruncate {
 
-                return DWORD(TRUNCATE_EXISTING)
+                DWORD(TRUNCATE_EXISTING)
             } else {
 
-                return DWORD(OPEN_EXISTING)
+                DWORD(OPEN_EXISTING)
             }
         }
 
diff --git a/Sources/Windows 32 Kernel File/Windows.Kernel.File.Stats.Get.swift b/Sources/Windows 32 Kernel File/Windows.Kernel.File.Stats.Get.swift
index a8738c8..d1bb400 100644
--- a/Sources/Windows 32 Kernel File/Windows.Kernel.File.Stats.Get.swift	
+++ b/Sources/Windows 32 Kernel File/Windows.Kernel.File.Stats.Get.swift	
@@ -7,12 +7,12 @@
             let size = (Int64(info.nFileSizeHigh) << 32) | Int64(info.nFileSizeLow)
 
             let type: Windows.`32`.Kernel.File.Stats.Kind
-            if (info.dwFileAttributes & DWORD(FILE_ATTRIBUTE_DIRECTORY)) != 0 {
-                type = .directory
+            type = if (info.dwFileAttributes & DWORD(FILE_ATTRIBUTE_DIRECTORY)) != 0 {
+                .directory
             } else if (info.dwFileAttributes & DWORD(FILE_ATTRIBUTE_REPARSE_POINT)) != 0 {
-                type = .link(.symbolic)
+                .link(.symbolic)
             } else {
-                type = .regular
+                .regular
             }
 
             var permissions: Windows.`32`.Kernel.File.Permissions = .standard
diff --git a/Sources/Windows 32 Kernel Memory Map/Windows.Kernel.Memory.Map.Protection.swift b/Sources/Windows 32 Kernel Memory Map/Windows.Kernel.Memory.Map.Protection.swift
index 454a042..425e2d6 100644
--- a/Sources/Windows 32 Kernel Memory Map/Windows.Kernel.Memory.Map.Protection.swift	
+++ b/Sources/Windows 32 Kernel Memory Map/Windows.Kernel.Memory.Map.Protection.swift	
@@ -24,18 +24,18 @@
             let hasWrite = contains(.write)
             let hasExecute = contains(.execute)
 
-            if hasExecute && hasWrite {
-                return DWORD(PAGE_EXECUTE_READWRITE)
+            return if hasExecute && hasWrite {
+                DWORD(PAGE_EXECUTE_READWRITE)
             } else if hasExecute && hasRead {
-                return DWORD(PAGE_EXECUTE_READ)
+                DWORD(PAGE_EXECUTE_READ)
             } else if hasExecute {
-                return DWORD(PAGE_EXECUTE)
+                DWORD(PAGE_EXECUTE)
             } else if hasWrite {
-                return DWORD(PAGE_READWRITE)
+                DWORD(PAGE_READWRITE)
             } else if hasRead {
-                return DWORD(PAGE_READONLY)
+                DWORD(PAGE_READONLY)
             } else {
-                return DWORD(PAGE_NOACCESS)
+                DWORD(PAGE_NOACCESS)
             }
         }
 
@@ -45,14 +45,14 @@
             let hasWrite = contains(.write)
             let hasExecute = contains(.execute)
 
-            if hasExecute && hasWrite {
-                return DWORD(PAGE_EXECUTE_READWRITE)
+            return if hasExecute && hasWrite {
+                DWORD(PAGE_EXECUTE_READWRITE)
             } else if hasExecute && hasRead {
-                return DWORD(PAGE_EXECUTE_READ)
+                DWORD(PAGE_EXECUTE_READ)
             } else if hasWrite {
-                return DWORD(PAGE_READWRITE)
+                DWORD(PAGE_READWRITE)
             } else {
-                return DWORD(PAGE_READONLY)
+                DWORD(PAGE_READONLY)
             }
         }
 
diff --git a/Sources/Windows 32 Kernel Memory Map/Windows.Kernel.Memory.Map.swift b/Sources/Windows 32 Kernel Memory Map/Windows.Kernel.Memory.Map.swift
index 5d1cd09..cd9860f 100644
--- a/Sources/Windows 32 Kernel Memory Map/Windows.Kernel.Memory.Map.swift	
+++ b/Sources/Windows 32 Kernel Memory Map/Windows.Kernel.Memory.Map.swift	
@@ -105,10 +105,10 @@
             isAnonymous: Bool = false
         ) throws(Memory.Map.Error) {
             let success: Bool
-            if isAnonymous {
-                success = unsafe VirtualFree(addr.mutablePointer, 0, DWORD(MEM_RELEASE))
+            success = if isAnonymous {
+                unsafe VirtualFree(addr.mutablePointer, 0, DWORD(MEM_RELEASE))
             } else {
-                success = unsafe UnmapViewOfFile(addr.pointer)
+                unsafe UnmapViewOfFile(addr.pointer)
             }
 
             guard success else {
diff --git a/Sources/Windows 32 Kernel System/Windows.Kernel.Name.swift b/Sources/Windows 32 Kernel System/Windows.Kernel.Name.swift
index a24e116..04ffbca 100644
--- a/Sources/Windows 32 Kernel System/Windows.Kernel.Name.swift	
+++ b/Sources/Windows 32 Kernel System/Windows.Kernel.Name.swift	
@@ -30,12 +30,12 @@
             let key = "SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion"
             guard let build = registryString(key, "CurrentBuildNumber") else { return nil }
             let release: Swift.String
-            if let major = registryNumber(key, "CurrentMajorVersionNumber"),
+            release = if let major = registryNumber(key, "CurrentMajorVersionNumber"),
                 let minor = registryNumber(key, "CurrentMinorVersionNumber")
             {
-                release = "\(major).\(minor).\(build)"
+                "\(major).\(minor).\(build)"
             } else {
-                release = build
+                build
             }
             return Self(system: "Windows", release: release, machine: machine)
         }
