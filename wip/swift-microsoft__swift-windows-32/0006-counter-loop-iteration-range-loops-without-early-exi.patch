From d80067165bb3219547f0452d4be875a3eef76f6e Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:34:02 +0000
Subject: [PATCH 6/7] counter loop iteration: range loops without early exit
 written as forEach (type-check follows; Linux x86_64, Swift 6.4.2)
 (coenttb/work#242)

---
 Sources/Windows 32 Kernel File/Path+Windows.swift     | 2 +-
 Sources/Windows 32 Kernel System/CPU.NUMA.state.swift | 4 ++--
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/Sources/Windows 32 Kernel File/Path+Windows.swift b/Sources/Windows 32 Kernel File/Path+Windows.swift
index 8b983b6..6228761 100644
--- a/Sources/Windows 32 Kernel File/Path+Windows.swift	
+++ b/Sources/Windows 32 Kernel File/Path+Windows.swift	
@@ -16,7 +16,7 @@
             let count = units.count
             let source = unsafe units.view.pointer
             unsafe self.init(count: count) { base in
-                for index in 0..<count {
+                (0..<count).forEach { index in
                     let unit = unsafe source[index]
                     unsafe base[index] =
                         !verbatim && unit == Windows.`32`.Filename.alternateSeparator
diff --git a/Sources/Windows 32 Kernel System/CPU.NUMA.state.swift b/Sources/Windows 32 Kernel System/CPU.NUMA.state.swift
index 41b8728..64f549f 100644
--- a/Sources/Windows 32 Kernel System/CPU.NUMA.state.swift	
+++ b/Sources/Windows 32 Kernel System/CPU.NUMA.state.swift	
@@ -14,9 +14,9 @@ import CPU
 
             var nodes: [Node] = []
 
-            for number in 0...UInt(highest) {
+            (0...UInt(highest)).forEach { number in
                 guard let processors = processors(of: USHORT(number)) else {
-                    continue
+                    return
                 }
                 nodes.append(Node(id: Node.ID(_unchecked: Ordinal(number)), processors: processors))
             }
