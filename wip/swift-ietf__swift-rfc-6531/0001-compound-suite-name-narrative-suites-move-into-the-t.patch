From 2c93a987f57db659a45e95252e44a76f5475ad87 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 19:34:16 +0000
Subject: [PATCH] compound suite name: narrative suites move into the test
 module's namespace `<File> Tests` (#239's layout), nested suites into
 extension <Path>.<Parent> (overnight/compound-suites.py); parse-checked;
 builds pending (coenttb/work#242)

---
 .../Quoted Local Part Characters Tests.swift  | 32 +++++++++++--------
 1 file changed, 18 insertions(+), 14 deletions(-)

diff --git a/Tests/RFC 6531 Tests/Quoted Local Part Characters Tests.swift b/Tests/RFC 6531 Tests/Quoted Local Part Characters Tests.swift
index 1091196..c970f22 100644
--- a/Tests/RFC 6531 Tests/Quoted Local Part Characters Tests.swift	
+++ b/Tests/RFC 6531 Tests/Quoted Local Part Characters Tests.swift	
@@ -2,22 +2,26 @@ import Testing
 
 @testable import RFC_6531
 
-@Suite
-struct `Quoted local part characters` {
-    @Test(arguments: ["\"a\u{0}b\"", "\"a\tb\"", "\"a\u{7F}b\"", "\"a\u{1B}b\"", "\"\\\u{1}\""])
-    func `a control character inside quotes is refused`(_ text: String) {
-        #expect(throws: RFC_6531.Mailbox.LocalPart.Error.invalidQuotedString(text)) {
-            try RFC_6531.Mailbox.LocalPart(text)
+enum `Quoted Local Part Characters Tests` {}
+
+extension `Quoted Local Part Characters Tests` {
+    @Suite
+    struct `Quoted local part characters` {
+        @Test(arguments: ["\"a\u{0}b\"", "\"a\tb\"", "\"a\u{7F}b\"", "\"a\u{1B}b\"", "\"\\\u{1}\""])
+        func `a control character inside quotes is refused`(_ text: String) {
+            #expect(throws: RFC_6531.Mailbox.LocalPart.Error.invalidQuotedString(text)) {
+                try RFC_6531.Mailbox.LocalPart(text)
+            }
         }
-    }
 
-    @Test(arguments: ["\"\\a\"", "\"\\ \"", "\"a\\~b\""])
-    func `a backslash may quote any printable ASCII character`(_ text: String) throws {
-        #expect(try RFC_6531.Mailbox.LocalPart(text).isQuoted)
-    }
+        @Test(arguments: ["\"\\a\"", "\"\\ \"", "\"a\\~b\""])
+        func `a backslash may quote any printable ASCII character`(_ text: String) throws {
+            #expect(try RFC_6531.Mailbox.LocalPart(text).isQuoted)
+        }
 
-    @Test
-    func `a space and non-ASCII text are allowed inside quotes`() throws {
-        #expect(try RFC_6531.Mailbox.LocalPart("\"john doe 用户\"").isQuoted)
+        @Test
+        func `a space and non-ASCII text are allowed inside quotes`() throws {
+            #expect(try RFC_6531.Mailbox.LocalPart("\"john doe 用户\"").isQuoted)
+        }
     }
 }
