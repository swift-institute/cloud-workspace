From 31bac396900bd0a978858c533a7d91ab39d973e4 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:29:35 +0000
Subject: [PATCH 07/11] Revert Sources/Iterator/Iterator.Buffered.swift: it
 broke the type-check (coenttb/work#242)

---
 Sources/Iterator/Iterator.Buffered.swift | 31 ++++++++++++------------
 1 file changed, 15 insertions(+), 16 deletions(-)

diff --git a/Sources/Iterator/Iterator.Buffered.swift b/Sources/Iterator/Iterator.Buffered.swift
index e9c183e..ee543c8 100644
--- a/Sources/Iterator/Iterator.Buffered.swift
+++ b/Sources/Iterator/Iterator.Buffered.swift
@@ -1,23 +1,11 @@
 extension Iterator {
+
     public struct Buffered<Base: Iterating & ~Copyable & ~Escapable, SourceFailure: Swift::Error>: Iterating, ~Copyable, ~Escapable
     where Base.Element: ~Copyable & Escapable, Base.Failure == SourceFailure {
-        private var base: Base
-        private var pending: Node?
-
-        @_lifetime(copy base)
-        public init(_ base: consuming Base) {
-            self.base = base
-            self.pending = nil
-        }
-    }
-}
-
-extension Iterator::Iterator.Buffered: Escapable
-where Base: ~Copyable & Escapable, Base.Element: ~Copyable & Escapable {}
-
-extension Iterator.Buffered where Base: ~Copyable & ~Escapable {
         public typealias Element = Base.Element
         public typealias Failure = Base.Failure
+        private var base: Base
+        private var pending: Node?
 
         private final class Node {
             var element: Element?
@@ -28,6 +16,12 @@ extension Iterator.Buffered where Base: ~Copyable & ~Escapable {
             }
         }
 
+        @_lifetime(copy base)
+        public init(_ base: consuming Base) {
+            self.base = base
+            self.pending = nil
+        }
+
         public mutating func next() throws(Failure) -> Element? {
             if let node = pending {
                 pending = node.next
@@ -40,4 +34,9 @@ extension Iterator.Buffered where Base: ~Copyable & ~Escapable {
 
         public mutating func unread(_ element: consuming Element) {
             pending = Node(element, next: pending)
-        }}
+        }
+    }
+}
+
+extension Iterator::Iterator.Buffered: Escapable
+where Base: ~Copyable & Escapable, Base.Element: ~Copyable & Escapable {}
