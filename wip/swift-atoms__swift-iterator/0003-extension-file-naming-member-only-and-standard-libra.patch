From e4780c7d927389fe5fe9b694f7689fa82c7efa67 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 20:52:44 +0000
Subject: [PATCH 3/4] extension file naming: member-only and
 standard-library-conformance extension files merge into their type's own file
 (overnight/merge-extension-files.py); single type per file: additional types
 move to their own <Parent>.<Name>.swift inside the container's extension
 (overnight/split-types.py); parse-checked; builds pending (coenttb/work#242)

---
 Sources/Iterator/Iterator.repeating.swift | 7 -------
 Sources/Iterator/Iterator.swift           | 8 ++++++++
 2 files changed, 8 insertions(+), 7 deletions(-)
 delete mode 100644 Sources/Iterator/Iterator.repeating.swift

diff --git a/Sources/Iterator/Iterator.repeating.swift b/Sources/Iterator/Iterator.repeating.swift
deleted file mode 100644
index d77a54a..0000000
--- a/Sources/Iterator/Iterator.repeating.swift
+++ /dev/null
@@ -1,7 +0,0 @@
-extension Iterator {
-
-    @inlinable
-    public static func repeating<Element>(_ element: Element) -> Iterator.Witness<Element, Never> {
-        Self.Witness<Element, Never> { element }
-    }
-}
diff --git a/Sources/Iterator/Iterator.swift b/Sources/Iterator/Iterator.swift
index f1a5bee..52ae535 100644
--- a/Sources/Iterator/Iterator.swift
+++ b/Sources/Iterator/Iterator.swift
@@ -1 +1,9 @@
 public enum Iterator {}
+
+extension Iterator {
+
+    @inlinable
+    public static func repeating<Element>(_ element: Element) -> Iterator.Witness<Element, Never> {
+        Self.Witness<Element, Never> { element }
+    }
+}
