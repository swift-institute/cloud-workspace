Subject: [PATCH 10/11] extension file naming: member-only extension files
 merged into the extended type's own file (type-check follows; Linux x86_64,
 Swift 6.4.2) (coenttb/work#242)

---
 .../Repetition/Cardinal.Range+Iteration.swift | 30 ------------------
 .../Iterator/Repetition/Cardinal.Range.swift  | 31 +++++++++++++++++++
 2 files changed, 31 insertions(+), 30 deletions(-)
 delete mode 100644 Sources/Iterator/Repetition/Cardinal.Range+Iteration.swift

diff --git a/Sources/Iterator/Repetition/Cardinal.Range+Iteration.swift b/Sources/Iterator/Repetition/Cardinal.Range+Iteration.swift
deleted file mode 100644
index d98d7ee..0000000
--- a/Sources/Iterator/Repetition/Cardinal.Range+Iteration.swift
+++ /dev/null
@@ -1,30 +0,0 @@
-#if Repetition
-    public import Repetition
-    public import Cardinal
-    internal import Predicate
-    public import Either
-
-    extension Cardinal.Range {
-
-        public func forEach<I: Iterating & ~Copyable & ~Escapable>(
-            in input: inout I,
-            _ yield: (consuming I.Element) -> Void
-        ) throws(Either<Repetition<Self, Void>.Error, I.Failure>)
-        where I.Element: ~Copyable & ~Escapable {
-            guard contains(minimum) else { throw .left(.emptyBounds) }
-            var count = Cardinal.zero
-            while permitsAnother(after: count) {
-                guard count.rawValue != UInt.max else { throw .left(.countOverflow) }
-                do throws(I.Failure) {
-                    guard let element = try input.next() else { break }
-                    yield(element)
-                    count = Cardinal(count.rawValue + 1)
-                } catch { throw .right(error) }
-            }
-            guard contains(count) else {
-                throw .left(.insufficient(actual: count))
-            }
-        }
-    }
-
-#endif
diff --git a/Sources/Iterator/Repetition/Cardinal.Range.swift b/Sources/Iterator/Repetition/Cardinal.Range.swift
index da8cce1..0d7b6fb 100644
--- a/Sources/Iterator/Repetition/Cardinal.Range.swift
+++ b/Sources/Iterator/Repetition/Cardinal.Range.swift
@@ -28,3 +28,34 @@
     }
 
 #endif
+
+#if Repetition
+    public import Repetition
+    public import Cardinal
+    internal import Predicate
+    public import Either
+
+    extension Cardinal.Range {
+
+        public func forEach<I: Iterating & ~Copyable & ~Escapable>(
+            in input: inout I,
+            _ yield: (consuming I.Element) -> Void
+        ) throws(Either<Repetition<Self, Void>.Error, I.Failure>)
+        where I.Element: ~Copyable & ~Escapable {
+            guard contains(minimum) else { throw .left(.emptyBounds) }
+            var count = Cardinal.zero
+            while permitsAnother(after: count) {
+                guard count.rawValue != UInt.max else { throw .left(.countOverflow) }
+                do throws(I.Failure) {
+                    guard let element = try input.next() else { break }
+                    yield(element)
+                    count = Cardinal(count.rawValue + 1)
+                } catch { throw .right(error) }
+            }
+            guard contains(count) else {
+                throw .left(.insufficient(actual: count))
+            }
+        }
+    }
+
+#endif
