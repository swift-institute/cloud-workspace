From 01019e9464ec9719312c1855f7788f2d8fff866c Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:27:09 +0000
Subject: [PATCH 7/7] compound suite name: narrative suites moved into the test
 file's namespace or the parent suite's extension (names and test IDs kept;
 tests only; Linux x86_64, Swift 6.4.2) (coenttb/work#242)

---
 .../Layout Boundary Tests.swift               | 34 ++++++++++---------
 1 file changed, 18 insertions(+), 16 deletions(-)

diff --git a/Tests/Layout Boundary Tests/Layout Boundary Tests.swift b/Tests/Layout Boundary Tests/Layout Boundary Tests.swift
index 8b310c0..f850a70 100644
--- a/Tests/Layout Boundary Tests/Layout Boundary Tests.swift	
+++ b/Tests/Layout Boundary Tests/Layout Boundary Tests.swift	
@@ -4,23 +4,25 @@
     import Layout
     import Testing
 
-    @Suite
-    struct `Layout Boundary Tests` {
+extension `Layout Boundary Tests`.`Layout Boundary Tests` {
+        @Suite
+        struct `Layout Boundary Tests` {
 
-        @Test
-        func `left to right layout corners map to physical corners`() {
-            #expect(Boundary.Corner(.topLeading, direction: .leftToRight) == .topLeft)
-            #expect(Boundary.Corner(.topTrailing, direction: .leftToRight) == .topRight)
-            #expect(Boundary.Corner(.bottomLeading, direction: .leftToRight) == .bottomLeft)
-            #expect(Boundary.Corner(.bottomTrailing, direction: .leftToRight) == .bottomRight)
-        }
+            @Test
+            func `left to right layout corners map to physical corners`() {
+                #expect(Boundary.Corner(.topLeading, direction: .leftToRight) == .topLeft)
+                #expect(Boundary.Corner(.topTrailing, direction: .leftToRight) == .topRight)
+                #expect(Boundary.Corner(.bottomLeading, direction: .leftToRight) == .bottomLeft)
+                #expect(Boundary.Corner(.bottomTrailing, direction: .leftToRight) == .bottomRight)
+            }
 
-        @Test
-        func `right to left layout corners reverse horizontal mapping`() {
-            #expect(Boundary.Corner(.topLeading, direction: .rightToLeft) == .topRight)
-            #expect(Boundary.Corner(.topTrailing, direction: .rightToLeft) == .topLeft)
-            #expect(Boundary.Corner(.bottomLeading, direction: .rightToLeft) == .bottomRight)
-            #expect(Boundary.Corner(.bottomTrailing, direction: .rightToLeft) == .bottomLeft)
+            @Test
+            func `right to left layout corners reverse horizontal mapping`() {
+                #expect(Boundary.Corner(.topLeading, direction: .rightToLeft) == .topRight)
+                #expect(Boundary.Corner(.topTrailing, direction: .rightToLeft) == .topLeft)
+                #expect(Boundary.Corner(.bottomLeading, direction: .rightToLeft) == .bottomRight)
+                #expect(Boundary.Corner(.bottomTrailing, direction: .rightToLeft) == .bottomLeft)
+            }
         }
-    }
+}
 #endif
