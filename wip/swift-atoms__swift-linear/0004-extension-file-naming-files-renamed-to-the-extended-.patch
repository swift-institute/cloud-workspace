 rename Sources/Linear/{Radian+Displacement.swift => Tagged where Tag == Angle.Radian, Underlying is BinaryFloatingPoint & Trigonometry.Circular.swift} (100%)

diff --git a/Sources/Linear/Linear.Vector+Real.swift b/Sources/Linear/Linear.Vector where N == 2, Scalar is BinaryFloatingPoint & Trigonometry.Circular.swift
similarity index 100%
rename from Sources/Linear/Linear.Vector+Real.swift
rename to Sources/Linear/Linear.Vector where N == 2, Scalar is BinaryFloatingPoint & Trigonometry.Circular.swift
diff --git a/Sources/Linear/Radian+Displacement.swift b/Sources/Linear/Tagged where Tag == Angle.Radian, Underlying is BinaryFloatingPoint & Trigonometry.Circular.swift
similarity index 100%
rename from Sources/Linear/Radian+Displacement.swift
