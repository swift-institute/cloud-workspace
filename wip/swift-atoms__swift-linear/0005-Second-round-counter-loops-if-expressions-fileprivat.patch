From 313c0c1d7d6871c5b8131313263c6e5a01d100ec Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 06:08:23 +0000
Subject: [PATCH 5/5] Second round: counter loops, if expressions, fileprivate
 single-file types, extension file renames (type-check follows; Linux x86_64,
 Swift 6.4.2) (coenttb/work#242)

---
 Sources/Linear/Linear+Arithmetic.swift | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/Sources/Linear/Linear+Arithmetic.swift b/Sources/Linear/Linear+Arithmetic.swift
index fcff8c2..d17312d 100644
--- a/Sources/Linear/Linear+Arithmetic.swift
+++ b/Sources/Linear/Linear+Arithmetic.swift
@@ -98,7 +98,7 @@ extension Linear.Matrix where Scalar: SignedNumeric {
     public static prefix func - (value: borrowing Self) -> Self {
         var result = value.rows
         (0..<Rows).forEach { i in
-            for j in 0..<Columns {
+            (0..<Columns).forEach { j in
                 result[i][j] = -value.rows[i][j]
             }
         }
@@ -112,7 +112,7 @@ extension Linear.Matrix where Scalar: AdditiveArithmetic {
     public static func + (lhs: borrowing Self, rhs: borrowing Self) -> Self {
         var result = lhs.rows
         (0..<Rows).forEach { i in
-            for j in 0..<Columns {
+            (0..<Columns).forEach { j in
                 result[i][j] = lhs.rows[i][j] + rhs.rows[i][j]
             }
         }
@@ -123,7 +123,7 @@ extension Linear.Matrix where Scalar: AdditiveArithmetic {
     public static func - (lhs: borrowing Self, rhs: borrowing Self) -> Self {
         var result = lhs.rows
         (0..<Rows).forEach { i in
-            for j in 0..<Columns {
+            (0..<Columns).forEach { j in
                 result[i][j] = lhs.rows[i][j] - rhs.rows[i][j]
             }
         }
