Subject: [PATCH 4/8] Runner repairs: minimal type body, counter loop
 iteration, test display name string, swift protocol qualification, comment in
 source (overnight/apply-repairs.py); type-checked against the root build,
 directories that failed it left out (coenttb/work#242)

---
 Sources/Rotation/Rotation.swift | 47 +++++++++++++++++----------------
 1 file changed, 24 insertions(+), 23 deletions(-)

diff --git a/Sources/Rotation/Rotation.swift b/Sources/Rotation/Rotation.swift
index 099fb82..804f935 100644
--- a/Sources/Rotation/Rotation.swift
+++ b/Sources/Rotation/Rotation.swift
@@ -4,29 +4,6 @@
 public struct Rotation<let N: Int, Scalar: BinaryFloatingPoint> {
     public let planes: [Plane]
     public init(planes: [Plane]) { self.planes = planes }
-
-    public enum Error: Swift::Error, Equatable, Sendable {
-        case invalidAxis
-        case coincidentAxes
-        case nonfiniteAngle
-    }
-
-    public struct Plane {
-        public let first: Axis<N>
-        public let second: Axis<N>
-        public let angle: Radian<Scalar>
-
-        public init(first: Axis<N>, second: Axis<N>, angle: Radian<Scalar>) throws(Error) {
-            guard first.underlying >= 0, first.underlying < N,
-                second.underlying >= 0, second.underlying < N
-            else { throw .invalidAxis }
-            guard first != second else { throw .coincidentAxes }
-            guard angle.underlying.isFinite else { throw .nonfiniteAngle }
-            self.first = first
-            self.second = second
-            self.angle = Radian(_unchecked: angle.underlying == 0 ? 0 : angle.underlying)
-        }
-    }
 }
 
 extension Rotation {
@@ -92,3 +69,27 @@ extension Rotation.Plane {
         Self(validatedFirst: first, second: second, angle: -angle.underlying)
     }
 }
+
+extension Rotation {
+    public enum Error: Swift::Error, Equatable, Sendable {
+        case invalidAxis
+        case coincidentAxes
+        case nonfiniteAngle
+    }
+
+    public struct Plane {
+        public let first: Axis<N>
+        public let second: Axis<N>
+        public let angle: Radian<Scalar>
+
+        public init(first: Axis<N>, second: Axis<N>, angle: Radian<Scalar>) throws(Error) {
+            guard first.underlying >= 0, first.underlying < N,
+                second.underlying >= 0, second.underlying < N
+            else { throw .invalidAxis }
+            guard first != second else { throw .coincidentAxes }
+            guard angle.underlying.isFinite else { throw .nonfiniteAngle }
+            self.first = first
+            self.second = second
+            self.angle = Radian(_unchecked: angle.underlying == 0 ? 0 : angle.underlying)
+        }
+    }}
