From 09def97db35faffffb96546b4d7f83268b839348 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:27:08 +0000
Subject: [PATCH 3/5] compound suite name: narrative suites moved into the test
 file's namespace or the parent suite's extension (names and test IDs kept;
 tests only; Linux x86_64, Swift 6.4.2) (coenttb/work#242)

---
 .../Property Carrier Tests.swift              | 60 ++++++++++---------
 1 file changed, 31 insertions(+), 29 deletions(-)

diff --git a/Tests/Consolidated swift-property-carrier/Property Carrier Tests/Property Carrier Tests.swift b/Tests/Consolidated swift-property-carrier/Property Carrier Tests/Property Carrier Tests.swift
index 5301d73..906a798 100644
--- a/Tests/Consolidated swift-property-carrier/Property Carrier Tests/Property Carrier Tests.swift	
+++ b/Tests/Consolidated swift-property-carrier/Property Carrier Tests/Property Carrier Tests.swift	
@@ -6,41 +6,43 @@ import struct Property.Property
 
 private enum Name {}
 
-@Suite
-struct `Property Carrier Tests` {
-    @Test
-    func `Underlying is the property base`() {
-        let property = Property<Name, Int>(42)
-
-        #expect(property.underlying == 42)
-    }
-
-    @Test
-    func `Domain preserves the property tag`() {
-        #expect(Property<Name, Int>.Domain.self == Name.self)
-    }
+extension `Property Carrier Tests`.`Property Carrier Tests` {
+    @Suite
+    struct `Property Carrier Tests` {
+        @Test
+        func `Underlying is the property base`() {
+            let property = Property<Name, Int>(42)
+
+            #expect(property.underlying == 42)
+        }
 
-    @Test
-    func `Property satisfies a generic Carrier constraint`() {
-        func extract<Value: Carrier.`Protocol`>(_ value: borrowing Value) -> Int
-        where Value.Underlying == Int {
-            value.underlying
+        @Test
+        func `Domain preserves the property tag`() {
+            #expect(Property<Name, Int>.Domain.self == Name.self)
         }
 
-        #expect(extract(Property<Name, Int>(42)) == 42)
-    }
+        @Test
+        func `Property satisfies a generic Carrier constraint`() {
+            func extract<Value: Carrier.`Protocol`>(_ value: borrowing Value) -> Int
+            where Value.Underlying == Int {
+                value.underlying
+            }
 
-    @Test
-    func `Carrier initializer constructs a property`() {
-        func make<Value: Carrier.`Protocol`>(
-            _: Value.Type,
-            underlying: consuming Value.Underlying
-        ) -> Value {
-            Value(underlying)
+            #expect(extract(Property<Name, Int>(42)) == 42)
         }
 
-        let property = make(Property<Name, Int>.self, underlying: 42)
+        @Test
+        func `Carrier initializer constructs a property`() {
+            func make<Value: Carrier.`Protocol`>(
+                _: Value.Type,
+                underlying: consuming Value.Underlying
+            ) -> Value {
+                Value(underlying)
+            }
 
-        #expect(property.base == 42)
+            let property = make(Property<Name, Int>.self, underlying: 42)
+
+            #expect(property.base == 42)
+        }
     }
 }
