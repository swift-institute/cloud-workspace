-    }
-}
diff --git a/Sources/Error/Error.Context.swift b/Sources/Error/Error.Context.swift
index 5a21241..c70c33e 100644
--- a/Sources/Error/Error.Context.swift
+++ b/Sources/Error/Error.Context.swift
@@ -24,3 +24,10 @@ extension Error::Error {
         }
     }
 }
+
+extension Error.Context: Swift::CustomStringConvertible {
+
+    public var description: Swift::String {
+        "\(operation) at \(function) (\(file.id):\(line))"
+    }
+}
diff --git a/Sources/Error/Error.Error+Swift.CustomStringConvertible.swift b/Sources/Error/Error.Error+Swift.CustomStringConvertible.swift
deleted file mode 100644
index 3762893..0000000
--- a/Sources/Error/Error.Error+Swift.CustomStringConvertible.swift
+++ /dev/null
@@ -1,10 +0,0 @@
-extension Error::Error: Swift::CustomStringConvertible {
-
-    public var description: Swift::String {
-        if let context {
-            return
-                "\(context.operation): \(code) at \(context.function) (\(context.file.id):\(context.line))"
-        }
-        return "\(code)"
-    }
-}
diff --git a/Sources/Error/Error.File+Swift.ExpressibleByStringLiteral.swift b/Sources/Error/Error.File+Swift.ExpressibleByStringLiteral.swift
deleted file mode 100644
index c1a01b8..0000000
--- a/Sources/Error/Error.File+Swift.ExpressibleByStringLiteral.swift
+++ /dev/null
@@ -1,7 +0,0 @@
-extension Error::Error.File: Swift::ExpressibleByStringLiteral {
-
-    @inlinable
-    public init(stringLiteral value: Swift::String) {
-        self.init(id: value)
-    }
-}
diff --git a/Sources/Error/Error.File.swift b/Sources/Error/Error.File.swift
index 7454238..7ee3cba 100644
--- a/Sources/Error/Error.File.swift
+++ b/Sources/Error/Error.File.swift
@@ -18,3 +18,11 @@ extension Error::Error.File {
         self.init(id: Swift::String(describing: id))
     }
 }
+
+extension Error::Error.File: Swift::ExpressibleByStringLiteral {
+
+    @inlinable
+    public init(stringLiteral value: Swift::String) {
+        self.init(id: value)
+    }
+}
diff --git a/Sources/Error/Error.swift b/Sources/Error/Error.swift
index d557368..04c8922 100644
--- a/Sources/Error/Error.swift
+++ b/Sources/Error/Error.swift
@@ -32,3 +32,14 @@ extension Error::Error {
         )
     }
 }
+
+extension Error::Error: Swift::CustomStringConvertible {
+
+    public var description: Swift::String {
+        if let context {
+            return
+                "\(context.operation): \(code) at \(context.function) (\(context.file.id):\(context.line))"
+        }
+        return "\(code)"
+    }
+}
