From 567f7a407bc0332365109970e773802095817487 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 20:52:43 +0000
Subject: [PATCH 2/2] extension file naming: member-only and
 standard-library-conformance extension files merge into their type's own file
 (overnight/merge-extension-files.py); single type per file: additional types
 move to their own <Parent>.<Name>.swift inside the container's extension
 (overnight/split-types.py); parse-checked; builds pending (coenttb/work#242)

---
 .../Error.Code+Swift.CustomStringConvertible.swift  | 12 ------------
 Sources/Error/Error.Code.swift                      | 13 +++++++++++++
 ...rror.Context+Swift.CustomStringConvertible.swift |  6 ------
 Sources/Error/Error.Context.swift                   |  7 +++++++
 .../Error.Error+Swift.CustomStringConvertible.swift | 10 ----------
 ...rror.File+Swift.ExpressibleByStringLiteral.swift |  7 -------
 Sources/Error/Error.File.swift                      |  8 ++++++++
 Sources/Error/Error.swift                           | 11 +++++++++++
 8 files changed, 39 insertions(+), 35 deletions(-)
 delete mode 100644 Sources/Error/Error.Code+Swift.CustomStringConvertible.swift
 delete mode 100644 Sources/Error/Error.Context+Swift.CustomStringConvertible.swift
 delete mode 100644 Sources/Error/Error.Error+Swift.CustomStringConvertible.swift
 delete mode 100644 Sources/Error/Error.File+Swift.ExpressibleByStringLiteral.swift

diff --git a/Sources/Error/Error.Code+Swift.CustomStringConvertible.swift b/Sources/Error/Error.Code+Swift.CustomStringConvertible.swift
deleted file mode 100644
index bd29fe3..0000000
--- a/Sources/Error/Error.Code+Swift.CustomStringConvertible.swift
+++ /dev/null
@@ -1,12 +0,0 @@
-extension Error.Code: Swift::CustomStringConvertible {
-
-    public var description: Swift::String {
-        switch self {
-        case .posix(let code):
-            return "posix(\(code))"
-
-        case .win32(let code):
-            return "win32(\(code))"
-        }
-    }
-}
diff --git a/Sources/Error/Error.Code.swift b/Sources/Error/Error.Code.swift
index 1b3a832..615d7cd 100644
--- a/Sources/Error/Error.Code.swift
+++ b/Sources/Error/Error.Code.swift
@@ -30,3 +30,16 @@ extension Error.Code {
         if case .win32 = self { true } else { false }
     }
 }
+
+extension Error.Code: Swift::CustomStringConvertible {
+
+    public var description: Swift::String {
+        switch self {
+        case .posix(let code):
+            return "posix(\(code))"
+
+        case .win32(let code):
+            return "win32(\(code))"
+        }
+    }
+}
diff --git a/Sources/Error/Error.Context+Swift.CustomStringConvertible.swift b/Sources/Error/Error.Context+Swift.CustomStringConvertible.swift
deleted file mode 100644
index 4a3b69e..0000000
--- a/Sources/Error/Error.Context+Swift.CustomStringConvertible.swift
+++ /dev/null
@@ -1,6 +0,0 @@
