From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 19:34:17 +0000
Subject: [PATCH] compound suite name: narrative suites move into the test
 module's namespace `<File> Tests` (#239's layout), nested suites into
 extension <Path>.<Parent> (overnight/compound-suites.py); parse-checked;
 builds pending (coenttb/work#242)

---
 .../Basic Challenge Quoting Tests.swift       | 28 +++++++++++--------
 .../ReadmeVerification Tests.swift            | 16 +++++++----
 2 files changed, 26 insertions(+), 18 deletions(-)

diff --git a/Tests/RFC 7617 Tests/Basic Challenge Quoting Tests.swift b/Tests/RFC 7617 Tests/Basic Challenge Quoting Tests.swift
index 36de468..81aa0c0 100644
--- a/Tests/RFC 7617 Tests/Basic Challenge Quoting Tests.swift	
+++ b/Tests/RFC 7617 Tests/Basic Challenge Quoting Tests.swift	
@@ -2,18 +2,22 @@ import Testing
 
 @testable import RFC_7617
 
-@Suite
-struct `Basic challenge quoting` {
-    @Test
-    func `a comma inside the quoted realm is part of the realm`() throws {
-        let challenge = try RFC_7617.Basic.Challenge(#"Basic realm="api, v2", charset="UTF-8""#)
-        #expect(challenge.realm == "api, v2")
-        #expect(challenge.charset?.lowercased() == "utf-8")
-    }
+enum `Basic Challenge Quoting Tests` {}
+
+extension `Basic Challenge Quoting Tests` {
+    @Suite
+    struct `Basic challenge quoting` {
+        @Test
+        func `a comma inside the quoted realm is part of the realm`() throws {
+            let challenge = try RFC_7617.Basic.Challenge(#"Basic realm="api, v2", charset="UTF-8""#)
+            #expect(challenge.realm == "api, v2")
+            #expect(challenge.charset?.lowercased() == "utf-8")
+        }
 
-    @Test
-    func `escaped quotes and backslashes in the realm are restored`() throws {
-        let challenge = try RFC_7617.Basic.Challenge(#"Basic realm="say \"hi\" \\ bye""#)
-        #expect(challenge.realm == #"say "hi" \ bye"#)
+        @Test
+        func `escaped quotes and backslashes in the realm are restored`() throws {
+            let challenge = try RFC_7617.Basic.Challenge(#"Basic realm="say \"hi\" \\ bye""#)
+            #expect(challenge.realm == #"say "hi" \ bye"#)
+        }
     }
 }
diff --git a/Tests/RFC 7617 Tests/ReadmeVerification Tests.swift b/Tests/RFC 7617 Tests/ReadmeVerification Tests.swift
index 3116a2f..a5cfffc 100644
--- a/Tests/RFC 7617 Tests/ReadmeVerification Tests.swift	
+++ b/Tests/RFC 7617 Tests/ReadmeVerification Tests.swift	
@@ -2,14 +2,18 @@ import Binary
 import RFC_7617
 import Testing
 
-@Suite
-struct `README Verification` {
-    @Suite struct Unit {}
-    @Suite struct `Edge Case` {}
-    @Suite struct Integration {}
+enum `ReadmeVerification Tests` {}
+
+extension `ReadmeVerification Tests` {
+    @Suite
+    struct `README Verification` {
+        @Suite struct Unit {}
+        @Suite struct `Edge Case` {}
+        @Suite struct Integration {}
+    }
 }
 
-extension `README Verification`.Unit {
+extension `ReadmeVerification Tests`.`README Verification`.Unit {
     @Test
     func `Create Basic authentication credentials`() throws {
         let credentials = try RFC_7617.Basic(userID: "user", password: "pass")
