From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 07:06:17 +0000
Subject: [PATCH 28/31] Revert Sources/Finite Macro to origin/main: macro
 targets aren't type-checkable outside the build (coenttb/work#242)

---
 Sources/Finite Macro/Finite.swift  | 6 +++---
 Sources/Finite Macro/exports.swift | 3 ---
 2 files changed, 3 insertions(+), 6 deletions(-)
 delete mode 100644 Sources/Finite Macro/exports.swift

diff --git a/Sources/Finite Macro/Finite.swift b/Sources/Finite Macro/Finite.swift
index 6d80a42..6a54896 100644
--- a/Sources/Finite Macro/Finite.swift	
+++ b/Sources/Finite Macro/Finite.swift	
@@ -1,6 +1,6 @@
-import Cardinal
-import Finite
-import Ordinal
+@_exported import Cardinal
+@_exported import Finite
+@_exported import Ordinal
 
 /// Finite sums/products with checked cardinal arithmetic and declaration-order mixed-radix enumeration.
 @attached(member, names: named(AllCases), named(count), named(ordinal), named(init))
diff --git a/Sources/Finite Macro/exports.swift b/Sources/Finite Macro/exports.swift
deleted file mode 100644
index 94b8165..0000000
--- a/Sources/Finite Macro/exports.swift	
+++ /dev/null
@@ -1,3 +0,0 @@
-@_exported public import Cardinal
-@_exported public import Finite
-@_exported public import Ordinal
