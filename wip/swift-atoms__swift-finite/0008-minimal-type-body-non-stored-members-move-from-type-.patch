From b1f852f5e73229dbfa69c4f6794254138142831b Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 22:39:52 +0000
Subject: [PATCH 08/12] minimal type body: non-stored members move from type
 bodies into an extension of the type in the same file
 (overnight/minimal-bodies.py); type-checked against the root build,
 directories that failed or couldn't be checked left out (coenttb/work#242)

---
 Sources/Finite/Finite.Enumeration.swift | 18 ++++++++----------
 1 file changed, 8 insertions(+), 10 deletions(-)

diff --git a/Sources/Finite/Finite.Enumeration.swift b/Sources/Finite/Finite.Enumeration.swift
index 6202124..d7ab6e1 100644
--- a/Sources/Finite/Finite.Enumeration.swift
+++ b/Sources/Finite/Finite.Enumeration.swift
@@ -2,24 +2,23 @@ public import Cardinal
 public import Ordinal
 
 extension Finite::Finite {
-
     public struct Enumeration<Element: Finite::Finite.Enumerable>: Swift::Sequence, Sendable {
-
         @inlinable
         public init() {}
+    }
+}
 
-        public struct Iterator: IteratorProtocol, Sendable {
-            @usableFromInline
-            var index: Ordinal::Ordinal = .zero
+extension Finite.Enumeration {
+    public struct Iterator: IteratorProtocol, Sendable {
+        @usableFromInline
+        var index: Ordinal::Ordinal = .zero
 
-            @inlinable
-            package init() {}
-        }
+        @inlinable
+        package init() {}
     }
 }
 
 extension Finite::Finite.Enumeration.Iterator {
-
     @inlinable
     public mutating func next() -> Element? {
         guard index.rawValue < Element.count.rawValue else { return nil }
@@ -29,7 +28,6 @@ extension Finite::Finite.Enumeration.Iterator {
 }
 
 extension Finite::Finite.Enumeration {
-
     @inlinable
     public func makeIterator() -> Iterator {
         Iterator()
-- 
