From 429ee97c895a74f39225050f24dc527a03df5375 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 23:28:21 +0000
Subject: [PATCH 11/26] minimal type body: more non-stored members move into
 extensions of their type (overnight/minimal-bodies.py); type-checked, failing
 files left out (coenttb/work#242)

---
 Sources/Finite Macro Core/Derivation.swift |  5 +++++
 Sources/Finite/Finite.Enumeration.swift    | 18 ++++++++----------
 2 files changed, 13 insertions(+), 10 deletions(-)

diff --git a/Sources/Finite Macro Core/Derivation.swift b/Sources/Finite Macro Core/Derivation.swift
index 2dc7564..2069382 100644
--- a/Sources/Finite Macro Core/Derivation.swift	
+++ b/Sources/Finite Macro Core/Derivation.swift	
@@ -3,12 +3,16 @@ import SwiftSyntaxBuilder
 import Type_Algebra_Syntax
 
 public enum Derivation {
+}
+
+extension Derivation {
     private struct Alternative {
         let name: String?
         let labels: [String?]
         let types: [String]
         var cardinality: String { types.isEmpty ? "Swift.UInt(1)" : "Finite::Finite.productCardinality([" + types.map { "\($0).count.rawValue" }.joined(separator: ", ") + "])" }
     }
+
     // Construction must be a bijection with the stored coordinates. Accept the
     // synthesized initializer or an explicit, effect-free fieldwise initializer.
     private static func constructionLabels(
@@ -45,6 +49,7 @@ public enum Derivation {
         }
         throw Type.Failure("@Finite requires synthesized or direct fieldwise construction; validating or normalizing initializers need an explicit finite witness")
     }
+
     public static func extensions(of declaration: some DeclGroupSyntax, type: some TypeSyntaxProtocol) throws -> [ExtensionDeclSyntax] {
         let alternatives: [Alternative]
         let generics: [String]
diff --git a/Sources/Finite/Finite.Enumeration.swift b/Sources/Finite/Finite.Enumeration.swift
