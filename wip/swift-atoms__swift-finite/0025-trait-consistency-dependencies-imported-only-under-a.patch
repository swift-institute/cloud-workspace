From 4bd1bfcd8a601e551b7f108d71b01f568b41ea4e Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:24:49 +0000
Subject: [PATCH 25/25] trait consistency: dependencies imported only under a
 trait get that trait's condition (runner repair; Linux x86_64, Swift 6.4.2)
 (coenttb/work#242)

---
 Package.swift | 20 ++++++++++----------
 1 file changed, 10 insertions(+), 10 deletions(-)

diff --git a/Package.swift b/Package.swift
index c8d29aa..30c945d 100644
--- a/Package.swift
+++ b/Package.swift
@@ -94,14 +94,14 @@ let package = Package(
         .target(
             name: "Finite",
             dependencies: [
-                .product(name: "Difference", package: "swift-difference"),
+                .product(name: "Difference", package: "swift-difference", condition: .when(traits: ["Tagged"])),
                 .product(name: "Cardinal", package: "swift-cardinal"),
                 .product(name: "Ordinal", package: "swift-ordinal"),
-                .product(name: "Index", package: "swift-index"),
-                .product(name: "Tagged", package: "swift-tagged"),
-                .product(name: "Iterator", package: "swift-iterator"),
-                .product(name: "Algebra", package: "swift-algebra"),
-                .product(name: "Polarity", package: "swift-polarity"),
+                .product(name: "Index", package: "swift-index", condition: .when(traits: ["Algebra", "Tagged"])),
+                .product(name: "Tagged", package: "swift-tagged", condition: .when(traits: ["Algebra", "Tagged"])),
+                .product(name: "Iterator", package: "swift-iterator", condition: .when(traits: ["Iterator"])),
+                .product(name: "Algebra", package: "swift-algebra", condition: .when(traits: ["Algebra"])),
+                .product(name: "Polarity", package: "swift-polarity", condition: .when(traits: ["Polarity"])),
             ],
             path: "Sources/Finite"
         ),
@@ -117,7 +117,7 @@ let package = Package(
             name: "Finite Test Support",
             dependencies: [
                 .target(name: "Finite"),
-                .product(name: "Index Test Support", package: "swift-index"),
+                .product(name: "Index Test Support", package: "swift-index", condition: .when(traits: ["Tagged"])),
             ],
             path: "Tests/Support"
         ),
@@ -126,10 +126,10 @@ let package = Package(
             dependencies: [
                 .target(name: "Finite"),
                 .target(name: "Finite Test Support"),
-                .product(name: "Cardinal", package: "swift-cardinal"),
-                .product(name: "Index", package: "swift-index"),
+                .product(name: "Cardinal", package: "swift-cardinal", condition: .when(traits: ["Tagged"])),
+                .product(name: "Index", package: "swift-index", condition: .when(traits: ["Tagged"])),
                 .product(name: "Ordinal", package: "swift-ordinal"),
-                .product(name: "Tagged", package: "swift-tagged"),
+                .product(name: "Tagged", package: "swift-tagged", condition: .when(traits: ["Tagged"])),
             ],
             path: "Tests/Finite Tests",
             resources: [.copy("Fixtures")]
-- 
