From 754d95b3cddf875700c62e01a899a1c3597206a0 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 19:34:00 +0000
Subject: [PATCH] compound suite name: narrative suites move into the test
 module's namespace `<File> Tests` (#239's layout), nested suites into
 extension <Path>.<Parent> (overnight/compound-suites.py); parse-checked;
 builds pending (coenttb/work#242)

---
 .../Exponential Tests/Exponential Tests.swift | 34 +++++++++++--------
 1 file changed, 19 insertions(+), 15 deletions(-)

diff --git a/Tests/Exponential Tests/Exponential Tests.swift b/Tests/Exponential Tests/Exponential Tests.swift
index acab2e4..1f70858 100644
--- a/Tests/Exponential Tests/Exponential Tests.swift	
+++ b/Tests/Exponential Tests/Exponential Tests.swift	
@@ -1,21 +1,25 @@
 import Exponential
 import Testing
 
-@Suite struct `Reference exponentials obey the scalar contract` {
-    @Test func `Exponentials and logarithms agree at exact reference values`() {
-        #expect(Double.exp(0) == 1 && Double.exp2(3) == 8)
-        #expect(Double.log(1) == 0 && Double.log2(8) == 3 && Double.log10(100) == 2)
-        #expect(Double.exp(-.infinity) == 0 && Double.exp(.infinity) == .infinity)
-        #expect(Double.log(0) == -.infinity && Double.log(-1).isNaN)
-        #expect(Double.exp(.nan).isNaN && Double.log(.nan).isNaN)
-    }
+enum `Exponential Tests` {}
+
+extension `Exponential Tests` {
+    @Suite struct `Reference exponentials obey the scalar contract` {
+        @Test func `Exponentials and logarithms agree at exact reference values`() {
+            #expect(Double.exp(0) == 1 && Double.exp2(3) == 8)
+            #expect(Double.log(1) == 0 && Double.log2(8) == 3 && Double.log10(100) == 2)
+            #expect(Double.exp(-.infinity) == 0 && Double.exp(.infinity) == .infinity)
+            #expect(Double.log(0) == -.infinity && Double.log(-1).isNaN)
+            #expect(Double.exp(.nan).isNaN && Double.log(.nan).isNaN)
+        }
 
-    @Test func `Cancellation sensitive operations retain tiny values and signed zero`() {
-        let tiny = 0x1p-60
-        #expect(1 + tiny == 1)
-        #expect(Double.expm1(tiny) == tiny && Double.log1p(tiny) == tiny)
-        #expect(Double.expm1(-0.0).sign == .minus && Double.log1p(-0.0).sign == .minus)
-        #expect(Double.log1p(-1) == -.infinity && Double.log1p(-2).isNaN)
-        #expect(Double.expm1(-.infinity) == -1)
+        @Test func `Cancellation sensitive operations retain tiny values and signed zero`() {
+            let tiny = 0x1p-60
+            #expect(1 + tiny == 1)
+            #expect(Double.expm1(tiny) == tiny && Double.log1p(tiny) == tiny)
+            #expect(Double.expm1(-0.0).sign == .minus && Double.log1p(-0.0).sign == .minus)
+            #expect(Double.log1p(-1) == -.infinity && Double.log1p(-2).isNaN)
+            #expect(Double.expm1(-.infinity) == -1)
+        }
     }
 }
