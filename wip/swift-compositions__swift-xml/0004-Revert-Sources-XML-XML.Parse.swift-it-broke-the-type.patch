From 48dbc9dc289f68f44e08b10be4854f178d828019 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:07:39 +0000
Subject: [PATCH 04/12] Revert Sources/XML/XML.Parse.swift: it broke the
 type-check (coenttb/work#242)

---
 Sources/XML/XML.Parse.swift | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/Sources/XML/XML.Parse.swift b/Sources/XML/XML.Parse.swift
index 721f122..244e4f7 100644
--- a/Sources/XML/XML.Parse.swift
+++ b/Sources/XML/XML.Parse.swift
@@ -21,8 +21,8 @@ extension XML.Parse {
 
     @inlinable
     public func callAsFunction(_ string: String) throws(XML.Error) -> XML.Document {
-        do throws(W3C_XML::Parse.Error) {
-            let doc = try W3C_XML::parse(string, maxDepth: depth)
+        do throws(W3C_XML.Parse.Error) {
+            let doc = try W3C_XML.parse(string, maxDepth: depth)
             return XML.Document(doc)
         } catch {
             throw XML.Error.syntax(message: "\(error)", line: 0, column: 0)
@@ -32,8 +32,8 @@ extension XML.Parse {
     @inlinable
     public func callAsFunction<Bytes>(_ bytes: Bytes) throws(XML.Error) -> XML.Document
     where Bytes: Swift.Collection<UInt8>, Bytes: Sendable {
-        do throws(W3C_XML::Parse.Error) {
-            let doc = try W3C_XML::parse(bytes, maxDepth: depth)
+        do throws(W3C_XML.Parse.Error) {
+            let doc = try W3C_XML.parse(bytes, maxDepth: depth)
             return XML.Document(doc)
         } catch {
             throw XML.Error.syntax(message: "\(error)", line: 0, column: 0)
