From 091d81cc74f98cb58ef19e996daf06afe308dcf9 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:07:39 +0000
Subject: [PATCH 03/12] Revert Sources/XML/XML.Document.swift: it broke the
 type-check (coenttb/work#242)

---
 Sources/XML/XML.Document.swift | 14 +++++++-------
 1 file changed, 7 insertions(+), 7 deletions(-)

diff --git a/Sources/XML/XML.Document.swift b/Sources/XML/XML.Document.swift
index 700d7ba..011425a 100644
--- a/Sources/XML/XML.Document.swift
+++ b/Sources/XML/XML.Document.swift
@@ -5,26 +5,26 @@ extension XML {
     public struct Document: Sendable, Hashable {
 
         @usableFromInline
-        internal var raw: W3C_XML::Document
+        internal var raw: W3C_XML.Document
 
         @inlinable
-        public init(_ raw: W3C_XML::Document) {
+        public init(_ raw: W3C_XML.Document) {
             self.raw = raw
         }
 
         @inlinable
         public init(root: XML) {
-            self.raw = W3C_XML::Document(root: root.raw)
+            self.raw = W3C_XML.Document(root: root.raw)
         }
 
         @inlinable
         public init(
-            version: W3C_XML::Declaration.Version = .v1_0,
+            version: W3C_XML.Declaration.Version = .v1_0,
             encoding: String? = "UTF-8",
             root: XML
         ) {
-            self.raw = W3C_XML::Document(
-                declaration: W3C_XML::Declaration(
+            self.raw = W3C_XML.Document(
+                declaration: W3C_XML.Declaration(
                     version: version,
                     encoding: encoding
                 ),
@@ -43,7 +43,7 @@ extension XML.Document {
     }
 
     @inlinable
-    public var version: W3C_XML::Declaration.Version? {
+    public var version: W3C_XML.Declaration.Version? {
         raw.declaration?.version
     }
 
