From 27f9ee4cdb177f1e34fb436ff5ef6157f1c387fc Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 22:39:55 +0000
Subject: [PATCH 3/3] minimal type body: non-stored members move from type
 bodies into an extension of the type in the same file
 (overnight/minimal-bodies.py); type-checked against the root build,
 directories that failed or couldn't be checked left out (coenttb/work#242)

---
 .../RFC_4291.IPv6.Address.Coder.swift         | 68 +++++++++----------
 1 file changed, 34 insertions(+), 34 deletions(-)

diff --git a/Sources/RFC 4291/Absorbed swift-rfc-4291-coder/RFC_4291.IPv6.Address.Coder.swift b/Sources/RFC 4291/Absorbed swift-rfc-4291-coder/RFC_4291.IPv6.Address.Coder.swift
index 0ef73c0..2626374 100644
--- a/Sources/RFC 4291/Absorbed swift-rfc-4291-coder/RFC_4291.IPv6.Address.Coder.swift	
+++ b/Sources/RFC 4291/Absorbed swift-rfc-4291-coder/RFC_4291.IPv6.Address.Coder.swift	
@@ -7,50 +7,50 @@
     import Serializer
 
     extension RFC_4291.IPv6.Address {
-
         public struct Coder<Input: Cursor.`Protocol`<Byte, Never>, Buffer: RangeReplaceableCollection<Byte>>: Coding {
+            public init() {}
+        }
 
-            public typealias Output = RFC_4291.IPv6.Address
+        public static var coder: Coder<ArraySlice<Byte>, [Byte]> { .init() }
+    }
 
-            public typealias Failure = RFC_4291.IPv6.Address.Error
+extension RFC_4291.IPv6.Address.Coder {
+        public typealias Output = RFC_4291.IPv6.Address
 
-            public init() {}
+        public typealias Failure = RFC_4291.IPv6.Address.Error
 
-            public borrowing func parse(_ input: inout Input) throws(Failure) -> Output {
-                let start = input.checkpoint
-                var bytes: [Byte] = []
-                while true {
-                    let mark = input.checkpoint
-                    guard let byte = input.next(), Self.isAddressByte(byte.bitPattern) else {
-                        input.seek(to: mark)
-                        break
-                    }
-                    bytes.append(byte)
-                }
-
-                do throws(Failure) {
-                    return try RFC_4291.IPv6.Address(ascii: bytes)
-                } catch {
-                    input.seek(to: start)
-                    throw error
+        public borrowing func parse(_ input: inout Input) throws(Failure) -> Output {
+            let start = input.checkpoint
+            var bytes: [Byte] = []
+            while true {
+                let mark = input.checkpoint
+                guard let byte = input.next(), Self.isAddressByte(byte.bitPattern) else {
+                    input.seek(to: mark)
+                    break
                 }
+                bytes.append(byte)
             }
 
-            public borrowing func serialize(_ output: Output, into buffer: inout Buffer) throws(Failure) {
-                var codes: [ASCII.Code] = []
-                RFC_4291.IPv6.Address.Text.Full().serialize(output, into: &codes)
-                buffer.append(contentsOf: codes.lazy.map(\.byte))
+            do throws(Failure) {
+                return try RFC_4291.IPv6.Address(ascii: bytes)
+            } catch {
+                input.seek(to: start)
+                throw error
             }
+        }
 
-            private static func isAddressByte(_ byte: UInt8) -> Bool {
-                (0x30...0x39).contains(byte)
-                    || (0x41...0x46).contains(byte)
-                    || (0x61...0x66).contains(byte)
-                    || byte == 0x3A
-                    || byte == 0x2E
-            }
+        public borrowing func serialize(_ output: Output, into buffer: inout Buffer) throws(Failure) {
+            var codes: [ASCII.Code] = []
+            RFC_4291.IPv6.Address.Text.Full().serialize(output, into: &codes)
+            buffer.append(contentsOf: codes.lazy.map(\.byte))
         }
 
-        public static var coder: Coder<ArraySlice<Byte>, [Byte]> { .init() }
-    }
+        private static func isAddressByte(_ byte: UInt8) -> Bool {
+            (0x30...0x39).contains(byte)
+                || (0x41...0x46).contains(byte)
+                || (0x61...0x66).contains(byte)
+                || byte == 0x3A
+                || byte == 0x2E
+        }
+}
 #endif
