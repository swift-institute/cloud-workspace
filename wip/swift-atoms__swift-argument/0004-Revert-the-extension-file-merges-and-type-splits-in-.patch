From a89e557a651cc87ae2947e648847730caae751d5 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 21:45:59 +0000
Subject: [PATCH 4/7] Revert the extension-file merges and type splits in
 directories where a merged file brought its conditional imports mid-file
 (coenttb/work#242)

---
 .../Argument.Environment.Variable.swift       |  9 -------
 Sources/Argument/Argument.Option.swift        | 26 -------------------
 .../Argument.Environment.Variable.Name.swift  |  8 ++++++
 ...ent.Option+Environment.Variable.Name.swift | 25 ++++++++++++++++++
 4 files changed, 33 insertions(+), 35 deletions(-)
 create mode 100644 Sources/Argument/Tagged/Argument.Environment.Variable.Name.swift
 create mode 100644 Sources/Argument/Tagged/Argument.Option+Environment.Variable.Name.swift

diff --git a/Sources/Argument/Argument.Environment.Variable.swift b/Sources/Argument/Argument.Environment.Variable.swift
index 1e6d088..da8d910 100644
--- a/Sources/Argument/Argument.Environment.Variable.swift
+++ b/Sources/Argument/Argument.Environment.Variable.swift
@@ -2,12 +2,3 @@ extension Argument.Environment {
 
     public enum Variable {}
 }
-
-#if Tagged
-    public import Tagged
-
-    extension Argument.Environment.Variable {
-
-        public typealias Name = Tagged<Argument.Environment.Variable, String>
-    }
-#endif
diff --git a/Sources/Argument/Argument.Option.swift b/Sources/Argument/Argument.Option.swift
index 60b33c0..780c964 100644
--- a/Sources/Argument/Argument.Option.swift
+++ b/Sources/Argument/Argument.Option.swift
@@ -32,29 +32,3 @@ extension Argument {
         }
     }
 }
-
-#if Tagged
-    public import Tagged
-
-    extension Argument.Option {
-
-        @inlinable
-        public init(
-            name: Argument.Name,
-            placeholder: String,
-            arity: Argument.Arity = .exactly(1),
-            visibility: Argument.Visibility = .visible,
-            help: Argument.Help = .init(),
-            environment: Argument.Environment.Variable.Name?
-        ) {
-            self.init(
-                name: name,
-                placeholder: placeholder,
-                arity: arity,
-                visibility: visibility,
-                help: help,
-                environment: environment?.underlying
-            )
-        }
-    }
-#endif
diff --git a/Sources/Argument/Tagged/Argument.Environment.Variable.Name.swift b/Sources/Argument/Tagged/Argument.Environment.Variable.Name.swift
new file mode 100644
index 0000000..6fe95d0
--- /dev/null
+++ b/Sources/Argument/Tagged/Argument.Environment.Variable.Name.swift
@@ -0,0 +1,8 @@
+#if Tagged
+    public import Tagged
+
+    extension Argument.Environment.Variable {
+
+        public typealias Name = Tagged<Argument.Environment.Variable, String>
+    }
+#endif
diff --git a/Sources/Argument/Tagged/Argument.Option+Environment.Variable.Name.swift b/Sources/Argument/Tagged/Argument.Option+Environment.Variable.Name.swift
new file mode 100644
index 0000000..0dbc5d1
--- /dev/null
+++ b/Sources/Argument/Tagged/Argument.Option+Environment.Variable.Name.swift
@@ -0,0 +1,25 @@
+#if Tagged
+    public import Tagged
+
+    extension Argument.Option {
+
+        @inlinable
+        public init(
+            name: Argument.Name,
+            placeholder: String,
+            arity: Argument.Arity = .exactly(1),
+            visibility: Argument.Visibility = .visible,
+            help: Argument.Help = .init(),
+            environment: Argument.Environment.Variable.Name?
+        ) {
+            self.init(
+                name: name,
+                placeholder: placeholder,
+                arity: arity,
+                visibility: visibility,
+                help: help,
+                environment: environment?.underlying
+            )
+        }
+    }
+#endif
-- 
