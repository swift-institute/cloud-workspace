Subject: [PATCH 2/3] extension file naming: member-only and
 standard-library-conformance extension files merge into their type's own file
 (overnight/merge-extension-files.py); single type per file: additional types
 move to their own <Parent>.<Name>.swift inside the container's extension
 (overnight/split-types.py); parse-checked; builds pending (coenttb/work#242)

---
 Sources/Async Channel/Async.Channel.Bounded.Error.swift | 8 --------
 Sources/Async Channel/Async.Channel.Bounded.swift       | 9 +++++++++
 2 files changed, 9 insertions(+), 8 deletions(-)
 delete mode 100644 Sources/Async Channel/Async.Channel.Bounded.Error.swift

diff --git a/Sources/Async Channel/Async.Channel.Bounded.Error.swift b/Sources/Async Channel/Async.Channel.Bounded.Error.swift
deleted file mode 100644
index 2a6c5f2..0000000
--- a/Sources/Async Channel/Async.Channel.Bounded.Error.swift	
+++ /dev/null
@@ -1,8 +0,0 @@
-#if !hasFeature(Embedded)
-
-    extension Async.Channel.Bounded where Element: ~Copyable {
-
-        public typealias Error = Async.Channel<Element>.Error
-    }
-
-#endif
diff --git a/Sources/Async Channel/Async.Channel.Bounded.swift b/Sources/Async Channel/Async.Channel.Bounded.swift
index 1cce395..77eed6a 100644
--- a/Sources/Async Channel/Async.Channel.Bounded.swift	
+++ b/Sources/Async Channel/Async.Channel.Bounded.swift	
@@ -40,3 +40,12 @@
     }
 
 #endif
+
+#if !hasFeature(Embedded)
+
+    extension Async.Channel.Bounded where Element: ~Copyable {
+
+        public typealias Error = Async.Channel<Element>.Error
+    }
+
+#endif
