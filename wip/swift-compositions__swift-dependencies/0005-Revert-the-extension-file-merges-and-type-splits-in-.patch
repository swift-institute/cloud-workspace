 .../EnvVars.swift                             | 31 -------------------
 Sources/Dependencies/Dependency.Error.swift   |  6 ++++
 Sources/Dependencies/Dependency.Key.swift     |  6 ++++
 Sources/Dependencies/Dependency.swift         | 24 ++++++++------
 Sources/Dependencies/_Accessor.swift          | 18 -----------
 6 files changed, 57 insertions(+), 58 deletions(-)
 create mode 100644 Sources/Dependencies Environment Integration/EnvVars.Foundation.swift
 create mode 100644 Sources/Dependencies/Dependency.Error.swift
 create mode 100644 Sources/Dependencies/Dependency.Key.swift
