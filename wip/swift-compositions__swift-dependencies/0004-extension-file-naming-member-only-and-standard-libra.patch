diff --git a/Sources/Dependencies Environment Integration/EnvVars.swift b/Sources/Dependencies Environment Integration/EnvVars.swift
index cf3f752..b1626f7 100644
--- a/Sources/Dependencies Environment Integration/EnvVars.swift	
+++ b/Sources/Dependencies Environment Integration/EnvVars.swift	
@@ -1,3 +1,5 @@
+public import Foundation
+
 public enum EnvVarsError: Swift::Error, CustomStringConvertible {
     case missingVariable(String)
     case invalidFormat(variable: String, expectedType: String, value: String)
@@ -78,3 +80,32 @@ extension EnvVars {
         set { self["TAXIDENTIFICATIONNUMBER"] = newValue }
     }
 }
+
+extension EnvVars {
+    public func baseUrl() throws(EnvVarsError) -> Foundation.URL {
+        guard let urlString = self["BASE_URL"] else {
+            throw EnvVarsError.missingVariable("BASE_URL")
+        }
+        guard let url = Foundation.URL(string: urlString) else {
+            throw EnvVarsError.invalidFormat(
+                variable: "BASE_URL",
+                expectedType: "URL",
+                value: urlString
+            )
+        }
+        return url
+    }
+
+    public mutating func setBaseUrl(_ url: Foundation.URL) {
+        self["BASE_URL"] = url.absoluteString
+    }
+
+    public var allowedInsecureHosts: [Swift::String]? {
+        get {
+            self["ALLOWED_INSECURE_HOSTS"]?.components(separatedBy: ",").map {
+                $0.trimmingCharacters(in: .whitespaces)
+            }
+        }
+        set { self["ALLOWED_INSECURE_HOSTS"] = newValue?.joined(separator: ",") }
+    }
+}
