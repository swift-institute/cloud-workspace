From 6dbc646939045e4d0e34e757312b9637586fd32e Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:27:46 +0000
Subject: [PATCH 12/13] minimal type body: more non-stored members moved into
 an extension of their type (batch 10; type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 .../Foundation.Calendar Dependencies.swift          | 10 +++++-----
 .../Dependencies/Dependency.Values.ClockKey.swift   | 13 +++++++------
 .../Dependency.Values.ContinuousClockKey.swift      |  9 +++++----
 3 files changed, 17 insertions(+), 15 deletions(-)

diff --git a/Sources/Dependencies Foundation Integration/Foundation.Calendar Dependencies.swift b/Sources/Dependencies Foundation Integration/Foundation.Calendar Dependencies.swift
index ac7f450..fcd87c8 100644
--- a/Sources/Dependencies Foundation Integration/Foundation.Calendar Dependencies.swift	
+++ b/Sources/Dependencies Foundation Integration/Foundation.Calendar Dependencies.swift	
@@ -2,17 +2,17 @@ public import Dependencies
 public import Foundation
 
 extension Calendar {
-
     public enum Key: Dependency.Key {
+    }
+}
 
-        public typealias Value = Calendar
+extension Calendar.Key {
+    public typealias Value = Calendar
 
-        public static var liveValue: Calendar { .autoupdatingCurrent }
-    }
+    public static var liveValue: Calendar { .autoupdatingCurrent }
 }
 
 extension Dependency.Values {
-
     public var calendar: Calendar {
         get { self[Calendar.Key.self] }
         set { self[Calendar.Key.self] = newValue }
diff --git a/Sources/Dependencies/Dependency.Values.ClockKey.swift b/Sources/Dependencies/Dependency.Values.ClockKey.swift
index d3cd02e..db74a6e 100644
--- a/Sources/Dependencies/Dependency.Values.ClockKey.swift
+++ b/Sources/Dependencies/Dependency.Values.ClockKey.swift
@@ -2,15 +2,16 @@ internal import Clock_Concurrency
 public import Witnesses
 
 extension __DependencyValues {
-
     internal enum ClockKey: Witness.Key {
+    }
+}
 
-        typealias Value = Clock.`Any`<Duration>
+extension __DependencyValues.ClockKey {
+    typealias Value = Clock.`Any`<Duration>
 
-        static var liveValue: Clock.`Any`<Duration> { Clock.`Any`(Swift::ContinuousClock()) }
+    static var liveValue: Clock.`Any`<Duration> { Clock.`Any`(Swift::ContinuousClock()) }
 
-        static var testValue: Clock.`Any`<Duration> { Clock.`Any`(Clock.Immediate()) }
+    static var testValue: Clock.`Any`<Duration> { Clock.`Any`(Clock.Immediate()) }
 
-        static var previewValue: Clock.`Any`<Duration> { Clock.`Any`(Clock.Immediate()) }
-    }
+    static var previewValue: Clock.`Any`<Duration> { Clock.`Any`(Clock.Immediate()) }
 }
diff --git a/Sources/Dependencies/Dependency.Values.ContinuousClockKey.swift b/Sources/Dependencies/Dependency.Values.ContinuousClockKey.swift
index 6896c57..d5dec16 100644
--- a/Sources/Dependencies/Dependency.Values.ContinuousClockKey.swift
+++ b/Sources/Dependencies/Dependency.Values.ContinuousClockKey.swift
@@ -2,11 +2,12 @@ internal import Clock_Concurrency
 public import Witnesses
 
 extension __DependencyValues {
-
     internal enum ContinuousClockKey: Witness.Key {
+    }
+}
 
-        typealias Value = any Clock.Nonsending<Duration>
+extension __DependencyValues.ContinuousClockKey {
+    typealias Value = any Clock.Nonsending<Duration>
 
-        static var liveValue: any Clock.Nonsending<Duration> { ContinuousClock() }
-    }
+    static var liveValue: any Clock.Nonsending<Duration> { ContinuousClock() }
 }
-- 
