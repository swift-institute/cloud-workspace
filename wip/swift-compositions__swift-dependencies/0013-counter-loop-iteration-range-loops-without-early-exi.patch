From da7a0ab1c9252415b89bc8877c7892e95b602616 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:34:03 +0000
Subject: [PATCH 13/14] counter loop iteration: range loops without early exit
 written as forEach (type-check follows; Linux x86_64, Swift 6.4.2)
 (coenttb/work#242)

---
 .../Dependency.Generator.UUID+Witness.Key.swift                 | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Sources/Dependencies RFC 4122 Integration/Dependency.Generator.UUID+Witness.Key.swift b/Sources/Dependencies RFC 4122 Integration/Dependency.Generator.UUID+Witness.Key.swift
index 1555490..4ccf498 100644
--- a/Sources/Dependencies RFC 4122 Integration/Dependency.Generator.UUID+Witness.Key.swift	
+++ b/Sources/Dependencies RFC 4122 Integration/Dependency.Generator.UUID+Witness.Key.swift	
@@ -9,7 +9,7 @@
             Self {
                 unsafe RFC_4122.UUID.v4(fillRandom: { buffer in
                     var generator = SystemRandomNumberGenerator()
-                    for index in 0..<16 {
+                    (0..<16).forEach { index in
                         unsafe buffer[index] = generator.next()
                     }
                 })
-- 
