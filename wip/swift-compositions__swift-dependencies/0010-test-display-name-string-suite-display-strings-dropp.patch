Subject: [PATCH 10/14] test display name string: suite display strings dropped
 (type name kept, test IDs unchanged), test strings moved into raw-identifier
 names (tests only; Linux x86_64, Swift 6.4.2) (coenttb/work#242)

---
 Tests/Dependencies Tests/Dependency.Continuation Tests.swift    | 2 +-
 .../Dependency.Values.Comprehensive Tests.swift                 | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/Tests/Dependencies Tests/Dependency.Continuation Tests.swift b/Tests/Dependencies Tests/Dependency.Continuation Tests.swift
index 5898519..584d735 100644
--- a/Tests/Dependencies Tests/Dependency.Continuation Tests.swift	
+++ b/Tests/Dependencies Tests/Dependency.Continuation Tests.swift	
@@ -3,7 +3,7 @@ import Testing
 @testable import Dependencies
 
 extension `__DependencyContext Tests`.Test {
-    @Suite("Dependency.Continuation") struct Continuation {
+    @Suite struct Continuation {
         @Suite struct Unit {}
         @Suite struct `Edge Case` {}
         @Suite struct Integration {}
diff --git a/Tests/Dependencies Tests/Dependency.Values.Comprehensive Tests.swift b/Tests/Dependencies Tests/Dependency.Values.Comprehensive Tests.swift
index 1eb788a..ab0b5f4 100644
--- a/Tests/Dependencies Tests/Dependency.Values.Comprehensive Tests.swift	
+++ b/Tests/Dependencies Tests/Dependency.Values.Comprehensive Tests.swift	
@@ -3,7 +3,7 @@ import Testing
 @testable import Dependencies
 
 extension `__DependencyValues Tests`.Test {
-    @Suite("Dependency.Values.Comprehensive") struct Comprehensive {
+    @Suite struct Comprehensive {
         @Suite struct Unit {}
         @Suite struct `Edge Case` {}
         @Suite struct Integration {}
