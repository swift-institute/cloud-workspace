From 43959a9417ba0e547d0067d1cb0d7f1ce3013fe6 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:46:13 +0000
Subject: [PATCH 18/19] extension file naming: member-only extension files
 merged into the extended type's own file (type-check follows; Linux x86_64,
 Swift 6.4.2) (coenttb/work#242)

---
 .../Dependency.Values+context.swift            |  9 ---------
 .../Dependency.Values+continuousClock.swift    | 12 ------------
 Sources/Dependencies/__DependencyValues.swift  | 18 ++++++++++++++++++
 3 files changed, 18 insertions(+), 21 deletions(-)
 delete mode 100644 Sources/Dependencies/Dependency.Values+context.swift
 delete mode 100644 Sources/Dependencies/Dependency.Values+continuousClock.swift

diff --git a/Sources/Dependencies/Dependency.Values+context.swift b/Sources/Dependencies/Dependency.Values+context.swift
deleted file mode 100644
index bd9d8af..0000000
--- a/Sources/Dependencies/Dependency.Values+context.swift
+++ /dev/null
@@ -1,9 +0,0 @@
-public import Witnesses
-
-extension __DependencyValues {
-
-    public var context: Witness.Context.Mode {
-        get { _mode ?? Witness.Context.currentMode }
-        set { _mode = newValue }
-    }
-}
diff --git a/Sources/Dependencies/Dependency.Values+continuousClock.swift b/Sources/Dependencies/Dependency.Values+continuousClock.swift
deleted file mode 100644
index 6698543..0000000
--- a/Sources/Dependencies/Dependency.Values+continuousClock.swift
+++ /dev/null
@@ -1,12 +0,0 @@
-public import Clock_Concurrency
-import Witnesses
-
-extension __DependencyValues {
-
-    /// The clock features sleep on. It keeps the caller's actor (``Clock/Nonsending``), so a test that sets
-    /// `Clock.Test` here and advances it sees every effect of a wake-up.
-    public var continuousClock: any Clock.Nonsending<Duration> {
-        get { self[ContinuousClockKey.self] }
-        set { self[ContinuousClockKey.self] = newValue }
-    }
-}
diff --git a/Sources/Dependencies/__DependencyValues.swift b/Sources/Dependencies/__DependencyValues.swift
index 9277b6e..4b68662 100644
--- a/Sources/Dependencies/__DependencyValues.swift
+++ b/Sources/Dependencies/__DependencyValues.swift
@@ -9,3 +9,21 @@ extension __DependencyValues {
         set { self[ClockKey.self] = newValue }
     }
 }
+
+extension __DependencyValues {
+
+    public var context: Witness.Context.Mode {
+        get { _mode ?? Witness.Context.currentMode }
+        set { _mode = newValue }
+    }
+}
+
+extension __DependencyValues {
+
+    /// The clock features sleep on. It keeps the caller's actor (``Clock/Nonsending``), so a test that sets
+    /// `Clock.Test` here and advances it sees every effect of a wake-up.
+    public var continuousClock: any Clock.Nonsending<Duration> {
+        get { self[ContinuousClockKey.self] }
+        set { self[ContinuousClockKey.self] = newValue }
+    }
+}
-- 
