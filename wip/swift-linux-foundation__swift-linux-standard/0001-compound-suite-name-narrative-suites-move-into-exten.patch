From 0dca683af44380aebf1fa41be19a075d753857a8 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 18:49:02 +0000
Subject: [PATCH] compound suite name: narrative suites move into extension
 <Type> named after their test file, nested suites into extension
 <Type>.<Parent> (overnight/compound-suites.py); parse-checked; builds pending
 (coenttb/work#242)

---
 .../Linux.Kernel.IO.Uring.Offset Tests.swift  | 22 ++++++++++---------
 1 file changed, 12 insertions(+), 10 deletions(-)

diff --git a/Tests/Linux Kernel Standard Tests/Linux.Kernel.IO.Uring.Offset Tests.swift b/Tests/Linux Kernel Standard Tests/Linux.Kernel.IO.Uring.Offset Tests.swift
index 1034f9e..a316d35 100644
--- a/Tests/Linux Kernel Standard Tests/Linux.Kernel.IO.Uring.Offset Tests.swift	
+++ b/Tests/Linux Kernel Standard Tests/Linux.Kernel.IO.Uring.Offset Tests.swift	
@@ -100,18 +100,20 @@
                     #expect(offset == .current)
                 }
             }
+        }
+    }
 
-            @Suite struct EdgeCase {
-                @Test
-                func `zero and current are distinct`() {
-                    #expect(Kernel.IO.Uring.Offset.zero != Kernel.IO.Uring.Offset.current)
-                }
+    extension Kernel.IO.Uring.OffsetTest {
+        @Suite struct EdgeCase {
+            @Test
+            func `zero and current are distinct`() {
+                #expect(Kernel.IO.Uring.Offset.zero != Kernel.IO.Uring.Offset.current)
+            }
 
-                @Test
-                func `max UInt64 value equals current`() {
-                    let max = Kernel.IO.Uring.Offset(UInt64.max)
-                    #expect(max == .current)
-                }
+            @Test
+            func `max UInt64 value equals current`() {
+                let max = Kernel.IO.Uring.Offset(UInt64.max)
+                #expect(max == .current)
             }
         }
     }
