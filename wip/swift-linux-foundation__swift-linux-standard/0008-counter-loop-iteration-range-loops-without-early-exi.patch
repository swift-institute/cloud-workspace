From 306d7b92846d201ca7447d40bb71a857f31bce86 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:34:02 +0000
Subject: [PATCH 08/12] counter loop iteration: range loops without early exit
 written as forEach (type-check follows; Linux x86_64, Swift 6.4.2)
 (coenttb/work#242)

---
 .../Linux Kernel Event Standard/Linux.Kernel.Event.Poll.swift   | 2 +-
 .../Linux.Kernel.IO.Uring.Enter.Options Tests.swift             | 2 +-
 .../Linux.Kernel.IO.Uring.Error Tests.swift                     | 2 +-
 .../Linux.Kernel.IO.Uring.Mmap.Offset Tests.swift               | 2 +-
 .../Linux.Kernel.IO.Uring.Opcode Tests.swift                    | 2 +-
 5 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/Sources/Linux Kernel Event Standard/Linux.Kernel.Event.Poll.swift b/Sources/Linux Kernel Event Standard/Linux.Kernel.Event.Poll.swift
index 8231817..678dbce 100644
--- a/Sources/Linux Kernel Event Standard/Linux.Kernel.Event.Poll.swift	
+++ b/Sources/Linux Kernel Event Standard/Linux.Kernel.Event.Poll.swift	
@@ -128,7 +128,7 @@
                     return .failure(.wait(code))
                 }
 
-                for i in 0..<Int(result) {
+                (0..<Int(result)).forEach { i in
                     events[i] = unsafe Event(unsafe buffer[i])
                 }
                 return .success(Int(result))
diff --git a/Tests/Linux Kernel Standard Tests/Linux.Kernel.IO.Uring.Enter.Options Tests.swift b/Tests/Linux Kernel Standard Tests/Linux.Kernel.IO.Uring.Enter.Options Tests.swift
index b857f3e..86e68cd 100644
--- a/Tests/Linux Kernel Standard Tests/Linux.Kernel.IO.Uring.Enter.Options Tests.swift	
+++ b/Tests/Linux Kernel Standard Tests/Linux.Kernel.IO.Uring.Enter.Options Tests.swift	
@@ -100,7 +100,7 @@
             ]
 
             (0..<flags.count).forEach { i in
-                for j in (i + 1)..<flags.count {
+                ((i + 1)..<flags.count).forEach { j in
                     #expect(flags[i] != flags[j])
                 }
             }
diff --git a/Tests/Linux Kernel Standard Tests/Linux.Kernel.IO.Uring.Error Tests.swift b/Tests/Linux Kernel Standard Tests/Linux.Kernel.IO.Uring.Error Tests.swift
index 30b81bf..10b6d98 100644
--- a/Tests/Linux Kernel Standard Tests/Linux.Kernel.IO.Uring.Error Tests.swift	
+++ b/Tests/Linux Kernel Standard Tests/Linux.Kernel.IO.Uring.Error Tests.swift	
@@ -140,7 +140,7 @@
             ]
 
             (0..<cases.count).forEach { i in
-                for j in (i + 1)..<cases.count {
+                ((i + 1)..<cases.count).forEach { j in
                     #expect(cases[i] != cases[j])
                 }
             }
diff --git a/Tests/Linux Kernel Standard Tests/Linux.Kernel.IO.Uring.Mmap.Offset Tests.swift b/Tests/Linux Kernel Standard Tests/Linux.Kernel.IO.Uring.Mmap.Offset Tests.swift
index 37be980..05c804e 100644
--- a/Tests/Linux Kernel Standard Tests/Linux.Kernel.IO.Uring.Mmap.Offset Tests.swift	
+++ b/Tests/Linux Kernel Standard Tests/Linux.Kernel.IO.Uring.Mmap.Offset Tests.swift	
@@ -56,7 +56,7 @@
             ]
 
             (0..<offsets.count).forEach { i in
-                for j in (i + 1)..<offsets.count {
+                ((i + 1)..<offsets.count).forEach { j in
                     #expect(offsets[i] != offsets[j])
                 }
             }
diff --git a/Tests/Linux Kernel Standard Tests/Linux.Kernel.IO.Uring.Opcode Tests.swift b/Tests/Linux Kernel Standard Tests/Linux.Kernel.IO.Uring.Opcode Tests.swift
index f9f0af2..5ef1649 100644
--- a/Tests/Linux Kernel Standard Tests/Linux.Kernel.IO.Uring.Opcode Tests.swift	
+++ b/Tests/Linux Kernel Standard Tests/Linux.Kernel.IO.Uring.Opcode Tests.swift	
@@ -207,7 +207,7 @@
             ]
 
             (0..<opcodes.count).forEach { i in
-                for j in (i + 1)..<opcodes.count {
+                ((i + 1)..<opcodes.count).forEach { j in
                     #expect(opcodes[i] != opcodes[j])
                 }
             }
