From b5d23d46a8cff9da01f18ac5ec7b4f2a7dd8f372 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:17:16 +0000
Subject: [PATCH 12/12] minimal type body: more non-stored members moved into
 an extension of their type (batch 18; type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 ...Linux.Kernel.File.Sync.Range.Options.swift | 25 +++++++++++--------
 ...inux.Kernel.IO.Uring.Install.Options.swift |  6 +++--
 ...inux.Kernel.IO.Uring.Message.Options.swift |  8 +++---
 .../Linux.Kernel.Pipe.Splice.Options.swift    | 10 +++++---
 4 files changed, 29 insertions(+), 20 deletions(-)

diff --git a/Sources/Linux Kernel File Standard/Linux.Kernel.File.Sync.Range.Options.swift b/Sources/Linux Kernel File Standard/Linux.Kernel.File.Sync.Range.Options.swift
index 14f9e20..d27f996 100644
--- a/Sources/Linux Kernel File Standard/Linux.Kernel.File.Sync.Range.Options.swift	
+++ b/Sources/Linux Kernel File Standard/Linux.Kernel.File.Sync.Range.Options.swift	
@@ -23,21 +23,24 @@
 
 extension ISO_9945.Kernel.File.Sync {
         public struct Range: Sendable {
-            public struct Options: OptionSet, Sendable {
-                public let rawValue: UInt32
+        }
+}
 
-                public init(rawValue: UInt32) {
-                    self.rawValue = rawValue
-                }
+extension ISO_9945.Kernel.File.Sync.Range {
+        public struct Options: OptionSet, Sendable {
+            public let rawValue: UInt32
 
-                public static let waitBefore = Self(
-                    rawValue: UInt32(SYNC_FILE_RANGE_WAIT_BEFORE)
-                )
+            public init(rawValue: UInt32) {
+                self.rawValue = rawValue
+            }
 
-                public static let write = Self(rawValue: UInt32(SYNC_FILE_RANGE_WRITE))
+            public static let waitBefore = Self(
+                rawValue: UInt32(SYNC_FILE_RANGE_WAIT_BEFORE)
+            )
 
-                public static let waitAfter = Self(rawValue: UInt32(SYNC_FILE_RANGE_WAIT_AFTER))
-            }
+            public static let write = Self(rawValue: UInt32(SYNC_FILE_RANGE_WRITE))
+
+            public static let waitAfter = Self(rawValue: UInt32(SYNC_FILE_RANGE_WAIT_AFTER))
         }
 }
 
diff --git a/Sources/Linux Kernel IO Uring Standard/Linux.Kernel.IO.Uring.Install.Options.swift b/Sources/Linux Kernel IO Uring Standard/Linux.Kernel.IO.Uring.Install.Options.swift
index 6a695dc..9f41b31 100644
--- a/Sources/Linux Kernel IO Uring Standard/Linux.Kernel.IO.Uring.Install.Options.swift	
+++ b/Sources/Linux Kernel IO Uring Standard/Linux.Kernel.IO.Uring.Install.Options.swift	
@@ -20,9 +20,11 @@ extension ISO_9945.Kernel.IO.Uring.Fixed.Install {
             public init(rawValue: UInt32) {
                 self.rawValue = rawValue
             }
-
-            public static let noCloseOnExec = Options(rawValue: _IORING_FIXED_FD_NO_CLOEXEC)
         }
 }
 
+extension ISO_9945.Kernel.IO.Uring.Fixed.Install.Options {
+        public static let noCloseOnExec = Options(rawValue: _IORING_FIXED_FD_NO_CLOEXEC)
+}
+
 #endif
diff --git a/Sources/Linux Kernel IO Uring Standard/Linux.Kernel.IO.Uring.Message.Options.swift b/Sources/Linux Kernel IO Uring Standard/Linux.Kernel.IO.Uring.Message.Options.swift
index 75d9366..13b9549 100644
--- a/Sources/Linux Kernel IO Uring Standard/Linux.Kernel.IO.Uring.Message.Options.swift	
+++ b/Sources/Linux Kernel IO Uring Standard/Linux.Kernel.IO.Uring.Message.Options.swift	
@@ -22,11 +22,13 @@ extension ISO_9945.Kernel.IO.Uring.Message {
             public init(rawValue: UInt32) {
                 self.rawValue = rawValue
             }
+        }
+}
 
-            public static let cqeSkip = Options(rawValue: _IORING_MSG_RING_CQE_SKIP)
+extension ISO_9945.Kernel.IO.Uring.Message.Options {
+        public static let cqeSkip = Options(rawValue: _IORING_MSG_RING_CQE_SKIP)
 
-            public static let flagsPass = Options(rawValue: _IORING_MSG_RING_FLAGS_PASS)
-        }
+        public static let flagsPass = Options(rawValue: _IORING_MSG_RING_FLAGS_PASS)
 }
 
 #endif
diff --git a/Sources/Linux Kernel Pipe Standard/Linux.Kernel.Pipe.Splice.Options.swift b/Sources/Linux Kernel Pipe Standard/Linux.Kernel.Pipe.Splice.Options.swift
index 6ff2d1e..45d3c2d 100644
--- a/Sources/Linux Kernel Pipe Standard/Linux.Kernel.Pipe.Splice.Options.swift	
+++ b/Sources/Linux Kernel Pipe Standard/Linux.Kernel.Pipe.Splice.Options.swift	
@@ -27,13 +27,15 @@ extension ISO_9945.Kernel.Pipe.Splice {
             public init(rawValue: UInt32) {
                 self.rawValue = rawValue
             }
+        }
+}
 
-            public static let move = Self(rawValue: UInt32(SPLICE_F_MOVE))
+extension ISO_9945.Kernel.Pipe.Splice.Options {
+        public static let move = Self(rawValue: UInt32(SPLICE_F_MOVE))
 
-            public static let nonblock = Self(rawValue: UInt32(SPLICE_F_NONBLOCK))
+        public static let nonblock = Self(rawValue: UInt32(SPLICE_F_NONBLOCK))
 
-            public static let more = Self(rawValue: UInt32(SPLICE_F_MORE))
-        }
+        public static let more = Self(rawValue: UInt32(SPLICE_F_MORE))
 }
 
 #endif
