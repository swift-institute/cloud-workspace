From c46bf94ae3a8e90dc4f60c6a8a963b85dc1a3fdf Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:27:11 +0000
Subject: [PATCH 06/13] compound suite name: narrative suites moved into the
 test file's namespace or the parent suite's extension (names and test IDs
 kept; tests only; Linux x86_64, Swift 6.4.2) (coenttb/work#242)

---
 .../Linux Kernel System Standard Tests.swift  | 46 ++++++++++---------
 1 file changed, 24 insertions(+), 22 deletions(-)

diff --git a/Tests/Linux Kernel Standard Tests/Linux Kernel System Standard Tests.swift b/Tests/Linux Kernel Standard Tests/Linux Kernel System Standard Tests.swift
index cfd318b..8d15bb4 100644
--- a/Tests/Linux Kernel Standard Tests/Linux Kernel System Standard Tests.swift	
+++ b/Tests/Linux Kernel Standard Tests/Linux Kernel System Standard Tests.swift	
@@ -5,33 +5,35 @@
 
     @testable import Linux_Kernel_System_Standard
 
-    @Suite
-    struct `Linux Kernel System Standard Tests` {
-        @Test
-        func `core count is at least one and at most the logical count`() {
-            let cores = Int(CPU.Core.count)
-            #expect(cores >= 1)
-            #expect(cores <= Int(CPU.Logical.count))
-        }
+extension `Linux Kernel System Standard Tests`.`Linux Kernel System Standard Tests` {
+        @Suite
+        struct `Linux Kernel System Standard Tests` {
+            @Test
+            func `core count is at least one and at most the logical count`() {
+                let cores = Int(CPU.Core.count)
+                #expect(cores >= 1)
+                #expect(cores <= Int(CPU.Logical.count))
+            }
 
-        @Test
-        func `capacity exceeds one mebibyte`() {
-            #expect(Int(Memory.Physical.capacity) > 1024 * 1024)
-        }
+            @Test
+            func `capacity exceeds one mebibyte`() {
+                #expect(Int(Memory.Physical.capacity) > 1024 * 1024)
+            }
 
-        @Test
-        func `NUMA nodes each hold processors`() {
-            if case .nonUniform(let nodes) = CPU.NUMA.state {
-                for node in nodes {
-                    #expect(!node.processors.isEmpty)
+            @Test
+            func `NUMA nodes each hold processors`() {
+                if case .nonUniform(let nodes) = CPU.NUMA.state {
+                    for node in nodes {
+                        #expect(!node.processors.isEmpty)
+                    }
                 }
             }
-        }
 
-        @Test
-        func `the CPU list format expands ranges`() {
-            #expect(Linux.Kernel.Sysfs.list(parsing: "0-3,8,10-11") == [0, 1, 2, 3, 8, 10, 11])
+            @Test
+            func `the CPU list format expands ranges`() {
+                #expect(Linux.Kernel.Sysfs.list(parsing: "0-3,8,10-11") == [0, 1, 2, 3, 8, 10, 11])
+            }
         }
-    }
+}
 
 #endif
