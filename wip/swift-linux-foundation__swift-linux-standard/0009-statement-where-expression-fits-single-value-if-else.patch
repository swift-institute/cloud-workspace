From 87fb8cd70bd970881431a24df05b423e8612962f Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:35:31 +0000
Subject: [PATCH 09/11] statement where expression fits: single-value if/else
 chains written as if expressions (type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 .../Linux.Kernel.Event.Poll.swift                           | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/Sources/Linux Kernel Event Standard/Linux.Kernel.Event.Poll.swift b/Sources/Linux Kernel Event Standard/Linux.Kernel.Event.Poll.swift
index 678dbce..1adb015 100644
--- a/Sources/Linux Kernel Event Standard/Linux.Kernel.Event.Poll.swift	
+++ b/Sources/Linux Kernel Event Standard/Linux.Kernel.Event.Poll.swift	
@@ -89,10 +89,10 @@
             event: Event? = nil
         ) throws(Linux.Kernel.Event.Poll.Error) {
             let result: Int32
-            if var cEvent = unsafe event?.cValue {
-                result = unsafe epoll_ctl(epoll.descriptor._rawValue, op.rawValue, fd._rawValue, &cEvent)
+            result = if var cEvent = unsafe event?.cValue {
+                unsafe epoll_ctl(epoll.descriptor._rawValue, op.rawValue, fd._rawValue, &cEvent)
             } else {
-                result = epoll_ctl(epoll.descriptor._rawValue, op.rawValue, fd._rawValue, nil)
+                epoll_ctl(epoll.descriptor._rawValue, op.rawValue, fd._rawValue, nil)
             }
             guard result == 0 else {
                 throw .ctl(.posix(errno))
