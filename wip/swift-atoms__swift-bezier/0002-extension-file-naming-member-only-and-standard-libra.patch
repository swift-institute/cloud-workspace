From 0d9d8392d2727c5d98380d9f48ab19009c255423 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 20:52:40 +0000
Subject: [PATCH 2/2] extension file naming: member-only and
 standard-library-conformance extension files merge into their type's own file
 (overnight/merge-extension-files.py); single type per file: additional types
 move to their own <Parent>.<Name>.swift inside the container's extension
 (overnight/split-types.py); parse-checked; builds pending (coenttb/work#242)

---
 Sources/Bezier/Bezier+Codable.swift | 23 -----------------------
 Sources/Bezier/Bezier.swift         | 24 ++++++++++++++++++++++++
 2 files changed, 24 insertions(+), 23 deletions(-)
 delete mode 100644 Sources/Bezier/Bezier+Codable.swift

diff --git a/Sources/Bezier/Bezier+Codable.swift b/Sources/Bezier/Bezier+Codable.swift
deleted file mode 100644
index 4916976..0000000
--- a/Sources/Bezier/Bezier+Codable.swift
+++ /dev/null
@@ -1,23 +0,0 @@
-#if !hasFeature(Embedded)
-    extension Bezier: Encodable where Point: Encodable {
-        public func encode(to encoder: any Encoder) throws {
-            var container = encoder.singleValueContainer()
-            try container.encode(controlPoints)
-        }
-    }
-
-    extension Bezier: Decodable where Point: Decodable {
-        public init(from decoder: any Decoder) throws {
-            let container = try decoder.singleValueContainer()
-            let points = try container.decode([Point].self)
-            do {
-                try self.init(controlPoints: points)
-            } catch {
-                throw DecodingError.dataCorruptedError(
-                    in: container,
-                    debugDescription: "A Bezier curve requires at least one control point"
-                )
-            }
-        }
-    }
-#endif
diff --git a/Sources/Bezier/Bezier.swift b/Sources/Bezier/Bezier.swift
index 3e32331..fc0d39f 100644
--- a/Sources/Bezier/Bezier.swift
+++ b/Sources/Bezier/Bezier.swift
@@ -81,3 +81,27 @@ extension Bezier {
 
     private init(nonempty controlPoints: [Point]) { self.controlPoints = controlPoints }
 }
+
+#if !hasFeature(Embedded)
+    extension Bezier: Encodable where Point: Encodable {
+        public func encode(to encoder: any Encoder) throws {
+            var container = encoder.singleValueContainer()
+            try container.encode(controlPoints)
+        }
+    }
+
+    extension Bezier: Decodable where Point: Decodable {
+        public init(from decoder: any Decoder) throws {
+            let container = try decoder.singleValueContainer()
+            let points = try container.decode([Point].self)
+            do {
+                try self.init(controlPoints: points)
+            } catch {
+                throw DecodingError.dataCorruptedError(
+                    in: container,
+                    debugDescription: "A Bezier curve requires at least one control point"
+                )
+            }
+        }
+    }
+#endif
