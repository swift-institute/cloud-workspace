From 02ecc2f71aabadc1367d28cfc692dd16eba00cb3 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:35:32 +0000
Subject: [PATCH 7/7] statement where expression fits: single-value if/else
 chains written as if expressions (type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 Sources/Benchmark Clock/Benchmark.Clock.swift | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/Sources/Benchmark Clock/Benchmark.Clock.swift b/Sources/Benchmark Clock/Benchmark.Clock.swift
index 1166112..e2c0dd7 100644
--- a/Sources/Benchmark Clock/Benchmark.Clock.swift	
+++ b/Sources/Benchmark Clock/Benchmark.Clock.swift	
@@ -54,12 +54,12 @@ extension Benchmark.Clock {
     ) -> Benchmark.Evaluation<Observation> {
         .init { current, baseline in
             let difference = current.adjusted - baseline.adjusted
-            if difference > tolerance {
-                return .regressed
+            return if difference > tolerance {
+                .regressed
             } else if difference < .zero - tolerance {
-                return .improved
+                .improved
             } else {
-                return .unchanged
+                .unchanged
             }
         }
     }
