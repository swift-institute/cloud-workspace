From 703a859a76ff08fb8d559c2ee220cd915e8379c2 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 23:28:22 +0000
Subject: [PATCH 5/6] minimal type body: more non-stored members move into
 extensions of their type (overnight/minimal-bodies.py); type-checked, failing
 files left out (coenttb/work#242)

---
 .../Julian/Gregorian.Julian.swift             | 25 ++++++++++++-------
 1 file changed, 16 insertions(+), 9 deletions(-)

diff --git a/Sources/Calendar Gregorian/Julian/Gregorian.Julian.swift b/Sources/Calendar Gregorian/Julian/Gregorian.Julian.swift
index 476e91b..9ea9c76 100644
--- a/Sources/Calendar Gregorian/Julian/Gregorian.Julian.swift	
+++ b/Sources/Calendar Gregorian/Julian/Gregorian.Julian.swift	
@@ -8,18 +8,25 @@
         /// day number 1 (Gregorian 0001-01-01 midnight) is JD 1721425.5.
         /// Tagged Double storage preserves day/offset identity, not nanosecond precision.
         public enum Julian {
-            public enum DayDomain {}
-            public enum OffsetDomain {}
-            public typealias Day = Tagged<DayDomain, Double>
-            public typealias Offset = Tagged<OffsetDomain, Double>
-            public enum Error: Swift::Error, Equatable, Sendable {
-                case nonfinite
-                case unrepresentable
-                case invalidCalendar
-            }
         }
     }
 
+extension Gregorian.Julian {
+        public enum DayDomain {}
+
+        public enum OffsetDomain {}
+
+        public typealias Day = Tagged<DayDomain, Double>
+
+        public typealias Offset = Tagged<OffsetDomain, Double>
+
+        public enum Error: Swift::Error, Equatable, Sendable {
+            case nonfinite
+            case unrepresentable
+            case invalidCalendar
+        }
+}
+
     extension Tagged where Tag == Gregorian.Julian.DayDomain, Underlying == Double {
         public static var unixEpoch: Self { .init(_unchecked: 2_440_587.5) }
         public static var j2000: Self { .init(_unchecked: 2_451_545.0) }
-- 
