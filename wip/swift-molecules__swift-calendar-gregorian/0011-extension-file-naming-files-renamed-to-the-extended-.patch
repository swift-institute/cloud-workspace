From 354df3207ebc799d4c2823f84492555fac3afdb7 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:43:43 +0000
Subject: [PATCH 11/12] extension file naming: files renamed to the extended
 type's own name or the 'T where <clause>' shape (renames only; Linux x86_64,
 Swift 6.4.2) (coenttb/work#242)

---
 ...regorian.swift => Calendar where Date == Gregorian.Date.swift} | 0
 ...regorian.swift => DateTime where Date == Gregorian.Date.swift} | 0
 ...Gregorian.Week.Day+Gregorian.swift => Gregorian.Weekday.swift} | 0
 ...ift => Time.Epoch where Reference == Gregorian.DateTime.swift} | 0
 .../{Time.Instant+Gregorian.swift => Time.Instant.swift}          | 0
 5 files changed, 0 insertions(+), 0 deletions(-)
 rename Sources/Calendar Gregorian/{Calendar+Gregorian.swift => Calendar where Date == Gregorian.Date.swift} (100%)
 rename Sources/Calendar Gregorian/{DateTime+Gregorian.swift => DateTime where Date == Gregorian.Date.swift} (100%)
 rename Sources/Calendar Gregorian/{Gregorian.Week.Day+Gregorian.swift => Gregorian.Weekday.swift} (100%)
 rename Sources/Calendar Gregorian/{Time.Epoch+Gregorian.swift => Time.Epoch where Reference == Gregorian.DateTime.swift} (100%)
 rename Sources/Calendar Gregorian/{Time.Instant+Gregorian.swift => Time.Instant.swift} (100%)

diff --git a/Sources/Calendar Gregorian/Calendar+Gregorian.swift b/Sources/Calendar Gregorian/Calendar where Date == Gregorian.Date.swift
similarity index 100%
rename from Sources/Calendar Gregorian/Calendar+Gregorian.swift
rename to Sources/Calendar Gregorian/Calendar where Date == Gregorian.Date.swift
diff --git a/Sources/Calendar Gregorian/DateTime+Gregorian.swift b/Sources/Calendar Gregorian/DateTime where Date == Gregorian.Date.swift
similarity index 100%
rename from Sources/Calendar Gregorian/DateTime+Gregorian.swift
rename to Sources/Calendar Gregorian/DateTime where Date == Gregorian.Date.swift
diff --git a/Sources/Calendar Gregorian/Gregorian.Week.Day+Gregorian.swift b/Sources/Calendar Gregorian/Gregorian.Weekday.swift
similarity index 100%
rename from Sources/Calendar Gregorian/Gregorian.Week.Day+Gregorian.swift
rename to Sources/Calendar Gregorian/Gregorian.Weekday.swift
diff --git a/Sources/Calendar Gregorian/Time.Epoch+Gregorian.swift b/Sources/Calendar Gregorian/Time.Epoch where Reference == Gregorian.DateTime.swift
similarity index 100%
rename from Sources/Calendar Gregorian/Time.Epoch+Gregorian.swift
rename to Sources/Calendar Gregorian/Time.Epoch where Reference == Gregorian.DateTime.swift
diff --git a/Sources/Calendar Gregorian/Time.Instant+Gregorian.swift b/Sources/Calendar Gregorian/Time.Instant.swift
similarity index 100%
rename from Sources/Calendar Gregorian/Time.Instant+Gregorian.swift
rename to Sources/Calendar Gregorian/Time.Instant.swift
