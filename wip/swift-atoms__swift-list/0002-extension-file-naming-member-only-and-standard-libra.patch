Subject: [PATCH 2/2] extension file naming: member-only and
 standard-library-conformance extension files merge into their type's own file
 (overnight/merge-extension-files.py); single type per file: additional types
 move to their own <Parent>.<Name>.swift inside the container's extension
 (overnight/split-types.py); parse-checked; builds pending (coenttb/work#242)

---
 Sources/List/List.Index.swift | 6 ------
 Sources/List/List.swift       | 7 +++++++
 2 files changed, 7 insertions(+), 6 deletions(-)
 delete mode 100644 Sources/List/List.Index.swift

diff --git a/Sources/List/List.Index.swift b/Sources/List/List.Index.swift
deleted file mode 100644
index a060aae..0000000
--- a/Sources/List/List.Index.swift
+++ /dev/null
@@ -1,6 +0,0 @@
-public import Index
-
-extension List where Element: ~Copyable {
-
-    public typealias Index = Index::Index<Element>
-}
diff --git a/Sources/List/List.swift b/Sources/List/List.swift
index 6cf02bd..c7ec63a 100644
--- a/Sources/List/List.swift
+++ b/Sources/List/List.swift
@@ -1 +1,8 @@
+public import Index
+
 public enum List<Element: ~Copyable> {}
+
+extension List where Element: ~Copyable {
+
+    public typealias Index = Index::Index<Element>
+}
