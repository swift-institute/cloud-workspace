From 99550daf92ffbd82862b27c28fc55b7f6eb48abd Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 20:52:54 +0000
Subject: [PATCH 2/6] extension file naming: member-only and
 standard-library-conformance extension files merge into their type's own file
 (overnight/merge-extension-files.py); single type per file: additional types
 move to their own <Parent>.<Name>.swift inside the container's extension
 (overnight/split-types.py); parse-checked; builds pending (coenttb/work#242)

---
 .../ISO_8601.DateTime.Conversion.Error.swift          | 11 +++++++++++
 .../Time Standard/ISO_8601.DateTime.Conversion.swift  |  7 -------
 2 files changed, 11 insertions(+), 7 deletions(-)
 create mode 100644 Sources/Time Standard/ISO_8601.DateTime.Conversion.Error.swift

diff --git a/Sources/Time Standard/ISO_8601.DateTime.Conversion.Error.swift b/Sources/Time Standard/ISO_8601.DateTime.Conversion.Error.swift
new file mode 100644
index 0000000..ddd3893
--- /dev/null
+++ b/Sources/Time Standard/ISO_8601.DateTime.Conversion.Error.swift	
@@ -0,0 +1,11 @@
+public import ISO_8601
+
+
+extension ISO_8601.DateTime.Conversion {
+    public enum Error: Swift::Error, Sendable, Equatable {
+
+        case offset(ISO_8601.Timezone.Offset.Error)
+
+        case dateTime(ISO_8601.DateTime.Error)
+    }
+}
diff --git a/Sources/Time Standard/ISO_8601.DateTime.Conversion.swift b/Sources/Time Standard/ISO_8601.DateTime.Conversion.swift
index a59c625..a5529fe 100644
--- a/Sources/Time Standard/ISO_8601.DateTime.Conversion.swift	
+++ b/Sources/Time Standard/ISO_8601.DateTime.Conversion.swift	
@@ -6,11 +6,4 @@ extension ISO_8601.DateTime {
 }
 
 extension ISO_8601.DateTime.Conversion {
-
-    public enum Error: Swift::Error, Sendable, Equatable {
-
-        case offset(ISO_8601.Timezone.Offset.Error)
-
-        case dateTime(ISO_8601.DateTime.Error)
-    }
 }
