From 480a091eee90692b9e71f53e07ea0397403e90db Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 23:28:24 +0000
Subject: [PATCH 2/9] minimal type body: more non-stored members move into
 extensions of their type (overnight/minimal-bodies.py); type-checked, failing
 files left out (coenttb/work#242)

---
 Sources/SPM Standard/Package.Dependency.swift | 21 +++---
 ...kage.Manifest.Target._DependencyWire.swift | 73 ++++++++++---------
 2 files changed, 47 insertions(+), 47 deletions(-)

diff --git a/Sources/SPM Standard/Package.Dependency.swift b/Sources/SPM Standard/Package.Dependency.swift
index e3bc3a5..6d4b55e 100644
--- a/Sources/SPM Standard/Package.Dependency.swift	
+++ b/Sources/SPM Standard/Package.Dependency.swift	
@@ -1,16 +1,5 @@
 extension Package {
-
     public struct Dependency: Swift::Sendable, Swift::Hashable {
-
-        public enum Source: Swift::Sendable, Swift::Hashable {
-
-            case path(Swift::String)
-
-            case url(URI, Package.Requirement)
-
-            case registry(Package.Identity, Package.Requirement)
-        }
-
         public let source: Source
 
         public let name: Package.Name
@@ -24,3 +13,13 @@ extension Package {
         }
     }
 }
+
+extension Package.Dependency {
+    public enum Source: Swift::Sendable, Swift::Hashable {
+        case path(Swift::String)
+
+        case url(URI, Package.Requirement)
+
+        case registry(Package.Identity, Package.Requirement)
+    }
+}
diff --git a/Sources/SPM Standard/Package.Manifest.Target._DependencyWire.swift b/Sources/SPM Standard/Package.Manifest.Target._DependencyWire.swift
index 7482f1d..3234230 100644
--- a/Sources/SPM Standard/Package.Manifest.Target._DependencyWire.swift	
+++ b/Sources/SPM Standard/Package.Manifest.Target._DependencyWire.swift	
@@ -1,6 +1,5 @@
 #if !hasFeature(Embedded)
     extension Package.Manifest.Target {
-
         /// A target dependency as `dump-package` writes it: the dependency, followed in the same
         /// array by its condition (`product: [name, package, moduleAliases, condition]`,
         /// `target: [name, condition]`, `byName: [name, condition]`).
@@ -8,12 +7,6 @@
             let dependency: Package::Target.Dependency
             let condition: Package.Manifest.Condition?
 
-            private enum CodingKeys: Swift::String, CodingKey {
-                case product
-                case target
-                case byName
-            }
-
             init(dependency: Package::Target.Dependency, condition: Package.Manifest.Condition?) {
                 self.dependency = dependency
                 self.condition = condition
@@ -35,41 +28,49 @@
                 }
                 self.condition = arm.isAtEnd ? nil : try arm.decodeIfPresent(Package.Manifest.Condition.self)
             }
+        }
+    }
 
-            func encode(to encoder: any Encoder) throws {
-                var container = encoder.container(keyedBy: CodingKeys.self)
-                switch self.dependency {
-                case .product(let name, let package):
-                    var arm = container.nestedUnkeyedContainer(forKey: .product)
-                    try arm.encode(name.underlying)
-                    try arm.encode(package.underlying)
-                    try arm.encodeNil()
-                    try self.encode(condition: &arm)
+extension Package.Manifest.Target._DependencyWire {
+        private enum CodingKeys: Swift::String, CodingKey {
+            case product
+            case target
+            case byName
+        }
 
-                case .target(let name):
-                    var arm = container.nestedUnkeyedContainer(forKey: .target)
-                    try arm.encode(name.underlying)
-                    try self.encode(condition: &arm)
+        func encode(to encoder: any Encoder) throws {
+            var container = encoder.container(keyedBy: CodingKeys.self)
+            switch self.dependency {
+            case .product(let name, let package):
+                var arm = container.nestedUnkeyedContainer(forKey: .product)
+                try arm.encode(name.underlying)
+                try arm.encode(package.underlying)
+                try arm.encodeNil()
+                try self.encode(condition: &arm)
 
-                case .byName(let name):
-                    var arm = container.nestedUnkeyedContainer(forKey: .byName)
-                    try arm.encode(name)
-                    try self.encode(condition: &arm)
-                }
-            }
+            case .target(let name):
+                var arm = container.nestedUnkeyedContainer(forKey: .target)
+                try arm.encode(name.underlying)
+                try self.encode(condition: &arm)
 
-            private func encode(condition arm: inout any UnkeyedEncodingContainer) throws {
-                if let condition = self.condition {
-                    try arm.encode(condition)
-                } else {
-                    try arm.encodeNil()
-                }
+            case .byName(let name):
+                var arm = container.nestedUnkeyedContainer(forKey: .byName)
+                try arm.encode(name)
+                try self.encode(condition: &arm)
             }
+        }
 
-            /// Any JSON value in a position the wire does not model (`moduleAliases`).
-            private struct _Skipped: Decodable {
-                init(from decoder: any Decoder) throws {}
+        private func encode(condition arm: inout any UnkeyedEncodingContainer) throws {
+            if let condition = self.condition {
+                try arm.encode(condition)
+            } else {
+                try arm.encodeNil()
             }
         }
-    }
+
+        /// Any JSON value in a position the wire does not model (`moduleAliases`).
+        private struct _Skipped: Decodable {
+            init(from decoder: any Decoder) throws {}
+        }
+}
 #endif
