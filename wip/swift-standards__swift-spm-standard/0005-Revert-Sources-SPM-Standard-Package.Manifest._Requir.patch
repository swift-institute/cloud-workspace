From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:29:37 +0000
Subject: [PATCH 5/9] Revert Sources/SPM
 Standard/Package.Manifest._RequirementWire.swift: it broke the type-check
 (coenttb/work#242)

---
 .../Package.Manifest._RequirementWire.swift   | 46 +++++++++----------
 1 file changed, 23 insertions(+), 23 deletions(-)

diff --git a/Sources/SPM Standard/Package.Manifest._RequirementWire.swift b/Sources/SPM Standard/Package.Manifest._RequirementWire.swift
index c76977e..52ced7b 100644
--- a/Sources/SPM Standard/Package.Manifest._RequirementWire.swift	
+++ b/Sources/SPM Standard/Package.Manifest._RequirementWire.swift	
@@ -1,4 +1,5 @@
 extension Package.Manifest {
+
     internal struct _RequirementWire: Codable {
         let exact: [Swift::String]?
         let range: [_RangeBounds]?
@@ -51,30 +52,29 @@ extension Package.Manifest {
                 self.init(range: [_RangeBounds(lowerBound: v.description, upperBound: upper)])
             }
         }
-    }
-}
 
-extension Package.Manifest._RequirementWire {
-    func toRequirement() throws -> Package.Requirement {
-        if let v = exact?.first {
-            return .exact(try _parseSemantic(v))
-        }
-        if let bounds = range?.first {
-            let lower = try _parseSemantic(bounds.lowerBound)
-            let upper = try _parseSemantic(bounds.upperBound)
-            return lower..<upper
-        }
-        if let name = branch?.first {
-            return .branch(name)
-        }
-        if let sha = revision?.first {
-            return .revision(sha)
-        }
-        throw DecodingError.dataCorrupted(
-            DecodingError.Context(
-                codingPath: [],
-                debugDescription: "Requirement matched none of exact/range/branch/revision"
+        func toRequirement() throws -> Package.Requirement {
+            if let v = exact?.first {
+                return .exact(try _parseSemantic(v))
+            }
+            if let bounds = range?.first {
+                let lower = try _parseSemantic(bounds.lowerBound)
+                let upper = try _parseSemantic(bounds.upperBound)
+                return lower..<upper
+            }
+            if let name = branch?.first {
+                return .branch(name)
+            }
+            if let sha = revision?.first {
+                return .revision(sha)
+            }
+            throw DecodingError.dataCorrupted(
+                DecodingError.Context(
+                    codingPath: [],
+                    debugDescription: "Requirement matched none of exact/range/branch/revision"
+                )
             )
-        )
+        }
+
     }
 }
