Subject: [PATCH] compound suite name: narrative suites move into extension
 <Type> named after their test file, nested suites into extension
 <Type>.<Parent> (overnight/compound-suites.py); parse-checked; builds pending
 (coenttb/work#242)

---
 Tests/SPM Standard Tests/SPM.Standard Tests.swift | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/Tests/SPM Standard Tests/SPM.Standard Tests.swift b/Tests/SPM Standard Tests/SPM.Standard Tests.swift
index 2577604..764fecf 100644
--- a/Tests/SPM Standard Tests/SPM.Standard Tests.swift	
+++ b/Tests/SPM Standard Tests/SPM.Standard Tests.swift	
@@ -6,11 +6,14 @@ import Testing
 @Suite
 struct `SPM Standard Tests` {
     @Suite struct Unit {}
-    @Suite struct `Codable Round-Trip` {}
     @Suite struct `Edge Case` {}
     @Suite struct Integration {}
 }
 
+extension `SPM Standard Tests` {
+    @Suite struct `Codable Round-Trip` {}
+}
+
 extension `SPM Standard Tests`.`Codable Round-Trip` {
     @Test
     func `Package.Identity round-trips through JSON`() throws {
