From 0e131256cd207c2ebeeed4dab32438892c9fc10c Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 19:34:23 +0000
Subject: [PATCH] compound suite name: narrative suites move into the test
 module's namespace `<File> Tests` (#239's layout), nested suites into
 extension <Path>.<Parent> (overnight/compound-suites.py); parse-checked;
 builds pending (coenttb/work#242)

---
 Tests/IP Address Tests/IP Address Tests.swift | 34 +++++++++++--------
 1 file changed, 19 insertions(+), 15 deletions(-)

diff --git a/Tests/IP Address Tests/IP Address Tests.swift b/Tests/IP Address Tests/IP Address Tests.swift
index 2263bee..d2460a9 100644
--- a/Tests/IP Address Tests/IP Address Tests.swift	
+++ b/Tests/IP Address Tests/IP Address Tests.swift	
@@ -1,24 +1,28 @@
 import IP_Address
 import Testing
 
-@Suite
-struct `IP Address` {
+enum `IP Address Tests` {}
 
-    @Test
-    func `IP Address names IPv4 and IPv6 addresses through one import`() {
-        let v4 = IPv4.Address(rawValue: 0x7F00_0001)
-        let v6 = IPv6.Address(0, 0, 0, 0, 0, 0, 0, 1)
+extension `IP Address Tests` {
+    @Suite
+    struct `IP Address` {
 
-        #expect(v4 == IPv4.Address.loopback)
-        #expect(v6.is.loopback)
-    }
+        @Test
+        func `IP Address names IPv4 and IPv6 addresses through one import`() {
+            let v4 = IPv4.Address(rawValue: 0x7F00_0001)
+            let v6 = IPv6.Address(0, 0, 0, 0, 0, 0, 0, 1)
+
+            #expect(v4 == IPv4.Address.loopback)
+            #expect(v6.is.loopback)
+        }
 
-    @Test
-    func `Address preserves canonical payloads and provider order`() {
-        let v6 = IPv6.Address(0, 0, 0, 0, 0, 0, 0, 1)
-        let v4 = IPv4.Address(rawValue: 0x7F00_0001)
-        let addresses: [IP.Address] = [.v6(v6), .v4(v4)]
+        @Test
+        func `Address preserves canonical payloads and provider order`() {
+            let v6 = IPv6.Address(0, 0, 0, 0, 0, 0, 0, 1)
+            let v4 = IPv4.Address(rawValue: 0x7F00_0001)
+            let addresses: [IP.Address] = [.v6(v6), .v4(v4)]
 
-        #expect(addresses == [.v6(v6), .v4(v4)])
+            #expect(addresses == [.v6(v6), .v4(v4)])
+        }
     }
 }
