From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 22:14:04 +0000
Subject: [PATCH 3/5] Revert this session's changes to Sources/Magnitude: they
 raised a rule over its ratchet limit (coenttb/work#242)

---
 .../Magnitude/Magnitude+Swift.Codable.swift   | 23 +++++++++++
 .../Magnitude+Swift.Comparable.swift          |  5 +++
 Sources/Magnitude/Magnitude.swift             | 41 +++----------------
 3 files changed, 33 insertions(+), 36 deletions(-)
 create mode 100644 Sources/Magnitude/Magnitude+Swift.Codable.swift
 create mode 100644 Sources/Magnitude/Magnitude+Swift.Comparable.swift

diff --git a/Sources/Magnitude/Magnitude+Swift.Codable.swift b/Sources/Magnitude/Magnitude+Swift.Codable.swift
new file mode 100644
index 0000000..c70c45e
--- /dev/null
+++ b/Sources/Magnitude/Magnitude+Swift.Codable.swift
@@ -0,0 +1,23 @@
+#if !hasFeature(Embedded)
+    extension Magnitude: Swift::Decodable where Storage: Swift::Decodable {
+        public init(from decoder: any Decoder) throws {
+            let container = try decoder.singleValueContainer()
+            let value = try container.decode(Storage.self)
+            do {
+                try self.init(validating: value)
+            } catch {
+                throw DecodingError.dataCorruptedError(
+                    in: container,
+                    debugDescription: "Magnitude must be finite and nonnegative"
+                )
+            }
+        }
+    }
+
+    extension Magnitude: Swift::Encodable where Storage: Swift::Encodable {
+        public func encode(to encoder: any Encoder) throws {
+            var container = encoder.singleValueContainer()
+            try container.encode(value)
+        }
+    }
+#endif
diff --git a/Sources/Magnitude/Magnitude+Swift.Comparable.swift b/Sources/Magnitude/Magnitude+Swift.Comparable.swift
new file mode 100644
index 0000000..7e7116b
--- /dev/null
+++ b/Sources/Magnitude/Magnitude+Swift.Comparable.swift
@@ -0,0 +1,5 @@
+import Tagged
+
+extension Magnitude: Swift::Comparable {
+    public static func < (lhs: Self, rhs: Self) -> Bool { lhs.value < rhs.value }
+}
diff --git a/Sources/Magnitude/Magnitude.swift b/Sources/Magnitude/Magnitude.swift
index 16af0f7..f8a7388 100644
--- a/Sources/Magnitude/Magnitude.swift
+++ b/Sources/Magnitude/Magnitude.swift
@@ -17,6 +17,11 @@ extension Scalar where Self: BinaryInteger {
 public struct Magnitude<Storage: Scalar> {
     private let storage: Storage
 
+    public enum Error: Swift::Error, Hashable, Sendable {
+        case negative
+        case nonfinite
+    }
+
     public init(validating value: Storage) throws(Error) {
         guard value.isFinite else { throw .nonfinite }
         guard value >= .zero else { throw .negative }
@@ -54,39 +59,3 @@ where Underlying: Representable, Tag: ~Copyable & ~Escapable {
         Magnitude(_unchecked: underlying.magnitude)
     }
 }
