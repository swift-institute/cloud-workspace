From 54bb84c96890aac67f4d64d78ff03450f1ad0d39 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 18:24:14 +0000
Subject: [PATCH 1/8] minimal type body: the runner's repair moves non-stored
 members out of type bodies into extensions; repair applied; root and test
 builds not yet run (coenttb/work#242)

---
 Sources/Magnitude/Magnitude.swift | 13 ++++++++-----
 1 file changed, 8 insertions(+), 5 deletions(-)

diff --git a/Sources/Magnitude/Magnitude.swift b/Sources/Magnitude/Magnitude.swift
index f8a7388..08cdea5 100644
--- a/Sources/Magnitude/Magnitude.swift
+++ b/Sources/Magnitude/Magnitude.swift
@@ -17,11 +17,6 @@ extension Scalar where Self: BinaryInteger {
 public struct Magnitude<Storage: Scalar> {
     private let storage: Storage
 
-    public enum Error: Swift::Error, Hashable, Sendable {
-        case negative
-        case nonfinite
-    }
-
     public init(validating value: Storage) throws(Error) {
         guard value.isFinite else { throw .nonfinite }
         guard value >= .zero else { throw .negative }
@@ -59,3 +54,11 @@ where Underlying: Representable, Tag: ~Copyable & ~Escapable {
         Magnitude(_unchecked: underlying.magnitude)
     }
 }
+
+extension Magnitude {
+
+    public enum Error: Swift::Error, Hashable, Sendable {
+        case negative
+        case nonfinite
+    }
+}
