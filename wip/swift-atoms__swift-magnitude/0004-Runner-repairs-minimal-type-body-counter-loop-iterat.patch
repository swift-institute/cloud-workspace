From dd0a4ee754b71aa05568815ea3c29b216c5fbd57 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 22:33:28 +0000
Subject: [PATCH 4/8] Runner repairs: minimal type body, counter loop
 iteration, test display name string, swift protocol qualification, comment in
 source (overnight/apply-repairs.py); type-checked against the root build,
 directories that failed it left out (coenttb/work#242)

---
 Sources/Magnitude/Magnitude.swift | 12 ++++++------
 1 file changed, 6 insertions(+), 6 deletions(-)

diff --git a/Sources/Magnitude/Magnitude.swift b/Sources/Magnitude/Magnitude.swift
index f8a7388..848dcb7 100644
--- a/Sources/Magnitude/Magnitude.swift
+++ b/Sources/Magnitude/Magnitude.swift
@@ -17,11 +17,6 @@ extension Scalar where Self: BinaryInteger {
 public struct Magnitude<Storage: Scalar> {
     private let storage: Storage
 
-    public enum Error: Swift::Error, Hashable, Sendable {
-        case negative
-        case nonfinite
-    }
-
     public init(validating value: Storage) throws(Error) {
         guard value.isFinite else { throw .nonfinite }
         guard value >= .zero else { throw .negative }
@@ -34,7 +29,6 @@ public struct Magnitude<Storage: Scalar> {
 }
 
 extension Magnitude {
-
     public var value: Storage { storage }
 
     public static var zero: Self { Self(validated: .zero) }
@@ -59,3 +53,9 @@ where Underlying: Representable, Tag: ~Copyable & ~Escapable {
         Magnitude(_unchecked: underlying.magnitude)
     }
 }
+
+extension Magnitude {
+    public enum Error: Swift::Error, Hashable, Sendable {
+        case negative
+        case nonfinite
+    }}
