From 3acb3a866e7d02e7b4ec87e7dd4e44cd9db775b6 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 20:52:54 +0000
Subject: [PATCH 3/4] extension file naming: member-only and
 standard-library-conformance extension files merge into their type's own file
 (overnight/merge-extension-files.py); single type per file: additional types
 move to their own <Parent>.<Name>.swift inside the container's extension
 (overnight/split-types.py); parse-checked; builds pending (coenttb/work#242)

---
 .../ISO_9945.Filename.Error.swift               | 17 +++++++++++++++++
 .../ISO_9945.Filename.swift                     | 12 ------------
 2 files changed, 17 insertions(+), 12 deletions(-)
 create mode 100644 Sources/ISO 9945 Kernel File/ISO_9945.Filename.Error.swift

diff --git a/Sources/ISO 9945 Kernel File/ISO_9945.Filename.Error.swift b/Sources/ISO 9945 Kernel File/ISO_9945.Filename.Error.swift
new file mode 100644
index 0000000..57316fa
--- /dev/null
+++ b/Sources/ISO 9945 Kernel File/ISO_9945.Filename.Error.swift	
@@ -0,0 +1,17 @@
+public import Binary
+
+
+extension ISO_9945.Filename {
+    public enum Error: Swift::Error, Sendable, Equatable {
+
+        case empty
+
+        case containsPathSeparator
+
+        case containsControlCharacters
+
+        case containsInteriorNUL
+
+        case invalidUTF8
+    }
+}
diff --git a/Sources/ISO 9945 Kernel File/ISO_9945.Filename.swift b/Sources/ISO 9945 Kernel File/ISO_9945.Filename.swift
index 32fab5f..52e1540 100644
--- a/Sources/ISO 9945 Kernel File/ISO_9945.Filename.swift	
+++ b/Sources/ISO 9945 Kernel File/ISO_9945.Filename.swift	
@@ -31,18 +31,6 @@ extension ISO_9945.Filename {
     /// The separator a filename may not contain.
     public static var separator: Path.Char { 0x2F }
 
-    public enum Error: Swift::Error, Sendable, Equatable {
-
-        case empty
-
-        case containsPathSeparator
-
-        case containsControlCharacters
-
-        case containsInteriorNUL
-
-        case invalidUTF8
-    }
 }
 
 extension ISO_9945.Filename.Error: CustomStringConvertible {
