From 96a6362f91ff83792eb7c062004b4bd460b4a065 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 19:33:59 +0000
Subject: [PATCH] compound suite name: narrative suites move into the test
 module's namespace `<File> Tests` (#239's layout), nested suites into
 extension <Path>.<Parent> (overnight/compound-suites.py); parse-checked;
 builds pending (coenttb/work#242)

---
 .../Boundary Tests.swift                      | 32 +++++++++++--------
 1 file changed, 18 insertions(+), 14 deletions(-)

diff --git a/Tests/Corecursive Macro Tests/Boundary Tests.swift b/Tests/Corecursive Macro Tests/Boundary Tests.swift
index 4bd00e0..e8b44f1 100644
--- a/Tests/Corecursive Macro Tests/Boundary Tests.swift	
+++ b/Tests/Corecursive Macro Tests/Boundary Tests.swift	
@@ -9,22 +9,26 @@ private indirect enum Count {
     case successor(Count)
 }
 
-@Suite
-struct `Corecursive boundaries` {
-    @Test
-    func `the base layer embeds to the base case`() {
-        guard case .zero = Count.embed(.zero) else {
-            Issue.record("Expected the base case")
-            return
+enum `Boundary Tests` {}
+
+extension `Boundary Tests` {
+    @Suite
+    struct `Corecursive boundaries` {
+        @Test
+        func `the base layer embeds to the base case`() {
+            guard case .zero = Count.embed(.zero) else {
+                Issue.record("Expected the base case")
+                return
+            }
         }
-    }
 
-    @Test
-    func `embedding wraps exactly one layer`() {
-        let inner = Count.successor(.successor(.zero))
-        guard case .successor(.successor(.successor(.zero))) = Count.embed(.successor(inner)) else {
-            Issue.record("Expected three layers")
-            return
+        @Test
+        func `embedding wraps exactly one layer`() {
+            let inner = Count.successor(.successor(.zero))
+            guard case .successor(.successor(.successor(.zero))) = Count.embed(.successor(inner)) else {
+                Issue.record("Expected three layers")
+                return
+            }
         }
     }
 }
