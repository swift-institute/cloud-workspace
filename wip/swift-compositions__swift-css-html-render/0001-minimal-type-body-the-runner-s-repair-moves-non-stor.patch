         public init(base: Base) {
             self.base = base
         }
-
-        @inlinable
-        public var body: Base {
-            base
-        }
     }
 }
 
@@ -115,3 +110,11 @@ extension HTML.View {
         HTML.CSS(base: self)
     }
 }
+
+extension HTML.CSS {
+
+    @inlinable
+    public var body: Base {
+        base
+    }
+}
diff --git a/Sources/CSS HTML Rendering/HTMLForEach.swift b/Sources/CSS HTML Rendering/HTMLForEach.swift
