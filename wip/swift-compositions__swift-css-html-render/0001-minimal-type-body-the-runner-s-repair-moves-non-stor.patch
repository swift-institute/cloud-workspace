     public init(_ value: String) {
         self.value = value
     }
+}
+
+extension RawProperty {
 
     public static var property: String {
         PropertyType.property
diff --git a/Sources/CSS HTML Rendering/CSS.swift b/Sources/CSS HTML Rendering/CSS.swift
index 03e632b..904a7a1 100644
