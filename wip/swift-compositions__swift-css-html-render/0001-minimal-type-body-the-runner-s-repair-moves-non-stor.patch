 Sources/CSS HTML Rendering/HTMLForEach.swift        |  3 +++
 4 files changed, 17 insertions(+), 5 deletions(-)

diff --git a/Sources/CSS HTML Rendering/CSS.GlobalProperty.swift b/Sources/CSS HTML Rendering/CSS.GlobalProperty.swift
index 6da88f3..9923b15 100644
--- a/Sources/CSS HTML Rendering/CSS.GlobalProperty.swift	
+++ b/Sources/CSS HTML Rendering/CSS.GlobalProperty.swift	
@@ -6,6 +6,9 @@ public struct GlobalProperty<PropertyType: W3C_CSS_Shared.Property>: W3C_CSS_Sha
     public init(_ global: Global) {
         self.global = global
     }
+}
+
+extension GlobalProperty {
 
     public static var property: String {
         PropertyType.property
diff --git a/Sources/CSS HTML Rendering/CSS.RawProperty.swift b/Sources/CSS HTML Rendering/CSS.RawProperty.swift
index 4fb37ba..46bc70c 100644
