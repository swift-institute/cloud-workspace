diff --git a/Tests/Catamorphism Macro Tests/Boundary Tests.swift b/Tests/Catamorphism Macro Tests/Boundary Tests.swift
index ab38c58..3ea2707 100644
--- a/Tests/Catamorphism Macro Tests/Boundary Tests.swift	
+++ b/Tests/Catamorphism Macro Tests/Boundary Tests.swift	
@@ -19,42 +19,46 @@ private indirect enum Count {
     case successor(Count)
 }
 
-@Suite
-struct `Catamorphism boundaries` {
-    @Test
-    func `the base case folds without recursion`() {
-        #expect(
-            Count.zero.catamorphism { (layer: Count.Base<Int>) -> Int in
-                switch layer {
-                case .zero: 0
-                case .successor(let child): child + 1
-                }
-            } == 0
-        )
-    }
+enum `Boundary Tests` {}
 
-    @Test
-    func `both children of a node are folded`() {
-        let tree = Tree.node(.node(.leaf(1), .leaf(2)), .leaf(3))
-        let sum = tree.catamorphism { (layer: Tree.Base<Int>) -> Int in
-            switch layer {
-            case .leaf(let value): value
-            case .node(let left, let right): left + right
-            }
+extension `Boundary Tests` {
+    @Suite
+    struct `Catamorphism boundaries` {
+        @Test
+        func `the base case folds without recursion`() {
+            #expect(
+                Count.zero.catamorphism { (layer: Count.Base<Int>) -> Int in
+                    switch layer {
+                    case .zero: 0
+                    case .successor(let child): child + 1
+                    }
+                } == 0
+            )
         }
-        #expect(sum == 6)
-    }
 
-    @Test
-    func `a thousand layers fold to a thousand`() {
-        let deep = (0..<1_000).reduce(Count.zero) { value, _ in .successor(value) }
-        #expect(
-            deep.catamorphism { (layer: Count.Base<Int>) -> Int in
+        @Test
+        func `both children of a node are folded`() {
+            let tree = Tree.node(.node(.leaf(1), .leaf(2)), .leaf(3))
+            let sum = tree.catamorphism { (layer: Tree.Base<Int>) -> Int in
                 switch layer {
-                case .zero: 0
-                case .successor(let child): child + 1
+                case .leaf(let value): value
+                case .node(let left, let right): left + right
                 }
-            } == 1_000
-        )
+            }
+            #expect(sum == 6)
+        }
+
+        @Test
+        func `a thousand layers fold to a thousand`() {
+            let deep = (0..<1_000).reduce(Count.zero) { value, _ in .successor(value) }
+            #expect(
+                deep.catamorphism { (layer: Count.Base<Int>) -> Int in
+                    switch layer {
+                    case .zero: 0
+                    case .successor(let child): child + 1
+                    }
+                } == 1_000
+            )
+        }
     }
 }
