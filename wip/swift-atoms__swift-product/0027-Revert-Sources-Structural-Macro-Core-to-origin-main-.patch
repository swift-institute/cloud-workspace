From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 07:06:20 +0000
Subject: [PATCH 27/28] Revert Sources/Structural Macro Core to origin/main:
 macro targets aren't type-checkable outside the build (coenttb/work#242)

---
 .../Structural.Analysis.swift                 | 24 +++++++++----------
 1 file changed, 11 insertions(+), 13 deletions(-)

diff --git a/Sources/Structural Macro Core/Structural.Analysis.swift b/Sources/Structural Macro Core/Structural.Analysis.swift
index 82e7a26..2ae1ebb 100644
--- a/Sources/Structural Macro Core/Structural.Analysis.swift	
+++ b/Sources/Structural Macro Core/Structural.Analysis.swift	
@@ -3,6 +3,17 @@ import Type_Algebra_Syntax
 
 extension Structural {
     public struct Analysis {
+        public struct Field {
+            public let name: String
+            public let type: String
+        }
+
+        public struct Case {
+            public let name: String
+            public let arity: Int
+            public let payloads: [TypeSyntax]
+        }
+
         public let type: TypeSyntax
         public let access: String
         public let parameters: [String]
@@ -61,19 +72,6 @@ extension Structural {
     }
 }
 
-extension Structural.Analysis {
-    public struct Field {
-        public let name: String
-        public let type: String
-    }
-
-    public struct Case {
-        public let name: String
-        public let arity: Int
-        public let payloads: [TypeSyntax]
-    }
-}
-
 extension Structural.Analysis {
     public static func coordinates(name: String, type: TypeSyntax) -> [Field] {
         guard let tuple = type.as(TupleTypeSyntax.self) else { return [Field(name: name, type: type.trimmedDescription)] }
