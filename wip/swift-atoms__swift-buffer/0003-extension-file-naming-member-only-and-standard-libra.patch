From dc028e1099268276ba011c6385ea195134a21307 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 20:52:41 +0000
Subject: [PATCH 3/4] extension file naming: member-only and
 standard-library-conformance extension files merge into their type's own file
 (overnight/merge-extension-files.py); single type per file: additional types
 move to their own <Parent>.<Name>.swift inside the container's extension
 (overnight/split-types.py); parse-checked; builds pending (coenttb/work#242)

---
 .../Buffer.Capacity+Swift.Comparable.swift    | 11 ----------
 Sources/Buffer/Buffer.Capacity.swift          | 10 +++++++++
 ...Buffer.Slice where Element ~Copyable.swift | 20 ------------------
 Sources/Buffer/Buffer.Slice.swift             | 21 +++++++++++++++++++
 4 files changed, 31 insertions(+), 31 deletions(-)
 delete mode 100644 Sources/Buffer/Buffer.Capacity+Swift.Comparable.swift
 delete mode 100644 Sources/Buffer/Buffer.Slice where Element ~Copyable.swift

diff --git a/Sources/Buffer/Buffer.Capacity+Swift.Comparable.swift b/Sources/Buffer/Buffer.Capacity+Swift.Comparable.swift
deleted file mode 100644
index 989e6fb..0000000
--- a/Sources/Buffer/Buffer.Capacity+Swift.Comparable.swift
+++ /dev/null
@@ -1,11 +0,0 @@
-public import Cardinal
-import Ordinal
-public import Tagged
-
-extension Buffer.Capacity: Swift::Comparable where S: ~Copyable, Element: ~Copyable {
-
-    @inlinable
-    public static func < (lhs: Self, rhs: Self) -> Bool {
-        lhs.count < rhs.count
-    }
-}
diff --git a/Sources/Buffer/Buffer.Capacity.swift b/Sources/Buffer/Buffer.Capacity.swift
index 3539f9a..471089b 100644
--- a/Sources/Buffer/Buffer.Capacity.swift
+++ b/Sources/Buffer/Buffer.Capacity.swift
@@ -1,5 +1,7 @@
 public import Index
 public import Ordinal
+public import Cardinal
+public import Tagged
 
 extension Buffer where S: ~Copyable {
 
@@ -20,3 +22,11 @@ extension Buffer.Capacity where S: ~Copyable, Element: ~Copyable {
     @inlinable
     public static var zero: Self { Self(.zero) }
 }
+
+extension Buffer.Capacity: Swift::Comparable where S: ~Copyable, Element: ~Copyable {
+
+    @inlinable
+    public static func < (lhs: Self, rhs: Self) -> Bool {
+        lhs.count < rhs.count
+    }
+}
diff --git a/Sources/Buffer/Buffer.Slice where Element ~Copyable.swift b/Sources/Buffer/Buffer.Slice where Element ~Copyable.swift
deleted file mode 100644
index 0bbd045..0000000
--- a/Sources/Buffer/Buffer.Slice where Element ~Copyable.swift	
+++ /dev/null
@@ -1,20 +0,0 @@
-extension Buffer.Slice where S: ~Copyable, Element: ~Copyable {
-
-    @inlinable
-    public var count: Int { _span.count }
-
-    @inlinable
-    public var isEmpty: Bool { _span.isEmpty }
-
-    @_lifetime(borrow self)
-    @inlinable
-    public borrowing func span() -> Swift::Span<Element> {
-        _span
-    }
-
-    @_lifetime(copy self)
-    @inlinable
-    public borrowing func extracting(_ bounds: Range<Int>) -> Buffer.Slice<Element> {
-        Buffer.Slice(_span.extracting(bounds))
-    }
-}
diff --git a/Sources/Buffer/Buffer.Slice.swift b/Sources/Buffer/Buffer.Slice.swift
index b08182c..2bc19dc 100644
--- a/Sources/Buffer/Buffer.Slice.swift
+++ b/Sources/Buffer/Buffer.Slice.swift
@@ -12,3 +12,24 @@ extension Buffer where S: ~Copyable {
         }
     }
 }
+
+extension Buffer.Slice where S: ~Copyable, Element: ~Copyable {
+
+    @inlinable
+    public var count: Int { _span.count }
+
+    @inlinable
+    public var isEmpty: Bool { _span.isEmpty }
+
+    @_lifetime(borrow self)
+    @inlinable
+    public borrowing func span() -> Swift::Span<Element> {
+        _span
+    }
+
+    @_lifetime(copy self)
+    @inlinable
+    public borrowing func extracting(_ bounds: Range<Int>) -> Buffer.Slice<Element> {
+        Buffer.Slice(_span.extracting(bounds))
+    }
+}
