 2 files changed, 16 insertions(+), 20 deletions(-)

diff --git a/Tests/Absorbed swift-buffer-index Tests/Buffer Capacity Tests.swift b/Tests/Absorbed swift-buffer-index Tests/Buffer Capacity Tests.swift
