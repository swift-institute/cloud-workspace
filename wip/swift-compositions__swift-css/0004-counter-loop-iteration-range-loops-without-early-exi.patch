From abeffe0861c180e2b035c9448f320675357b0c3e Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:34:03 +0000
Subject: [PATCH 04/11] counter loop iteration: range loops without early exit
 written as forEach (type-check follows; Linux x86_64, Swift 6.4.2)
 (coenttb/work#242)

---
 Tests/CSS Tests/DarkModeColor.Theme Concurrency Tests.swift     | 2 +-
 Tests/CSS Tests/Font.Defaults Concurrency Tests.swift           | 2 +-
 .../CSS Property Rendering Performance Tests.swift              | 2 +-
 3 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/Tests/CSS Tests/DarkModeColor.Theme Concurrency Tests.swift b/Tests/CSS Tests/DarkModeColor.Theme Concurrency Tests.swift
index 8f40749..d4794b2 100644
--- a/Tests/CSS Tests/DarkModeColor.Theme Concurrency Tests.swift	
+++ b/Tests/CSS Tests/DarkModeColor.Theme Concurrency Tests.swift	
@@ -29,7 +29,7 @@ extension `DarkModeColor.Theme Tests` {
             DarkModeColor.Theme._prepare(snapshotA)
 
             await withTaskGroup(of: Void.self) { group in
-                for i in 0..<4_000 {
+                (0..<4_000).forEach { i in
                     group.addTask {
                         DarkModeColor.Theme._prepare(i.isMultiple(of: 2) ? snapshotA : snapshotB)
                     }
diff --git a/Tests/CSS Tests/Font.Defaults Concurrency Tests.swift b/Tests/CSS Tests/Font.Defaults Concurrency Tests.swift
index 938a334..0d83ed3 100644
--- a/Tests/CSS Tests/Font.Defaults Concurrency Tests.swift	
+++ b/Tests/CSS Tests/Font.Defaults Concurrency Tests.swift	
@@ -47,7 +47,7 @@ extension `CSS_Theming.Font.Defaults Tests` {
             CSS_Theming::Font.Defaults._prepare(snapshotA)
 
             await withTaskGroup(of: Void.self) { group in
-                for i in 0..<4_000 {
+                (0..<4_000).forEach { i in
                     group.addTask {
                         CSS_Theming::Font.Defaults._prepare(
                             i.isMultiple(of: 2) ? snapshotA : snapshotB
diff --git a/Tests/Testing/CSS Performance Tests/CSS Property Rendering Performance Tests.swift b/Tests/Testing/CSS Performance Tests/CSS Property Rendering Performance Tests.swift
index 6708160..342a64a 100644
--- a/Tests/Testing/CSS Performance Tests/CSS Property Rendering Performance Tests.swift	
+++ b/Tests/Testing/CSS Performance Tests/CSS Property Rendering Performance Tests.swift	
@@ -203,7 +203,7 @@ extension `Performance Tests` {
                 _ = try String(
                     HTML.Document {
                         tag("div") {
-                            for i in 0..<50 {
+                            (0..<50).forEach { i in
                                 tag("div")
                                     .attribute("id", "item-\(i)")
                             }
