+++ /dev/null
@@ -1,11 +0,0 @@
-import Collection
-import Iterator
-import Tagged
-
-extension Infinite.Cycle: Swift::Hashable where Base: Swift::Hashable {
-
-    @inlinable
-    public func hash(into hasher: inout Hasher) {
-        hasher.combine(base)
-    }
