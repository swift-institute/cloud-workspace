-            #expect(cycle.tail.head == 2)
-        }
+extension `Infinite.Cycle+Observable Tests` {
+    @Suite
+    struct `Infinite Cycle Observable Tests` {
+        @Suite struct Unit {
+            @Test
+            func `head returns first element`() {
+                let cycle = Infinite.Cycle([1, 2, 3])!
+                #expect(cycle.head == 1)
+            }
 
