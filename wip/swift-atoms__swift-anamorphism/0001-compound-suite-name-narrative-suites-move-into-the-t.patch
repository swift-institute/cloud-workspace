From 016851178ec7eaa4c6c91aa589bbdd2114e4baac Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 19:33:56 +0000
Subject: [PATCH] compound suite name: narrative suites move into the test
 module's namespace `<File> Tests` (#239's layout), nested suites into
 extension <Path>.<Parent> (overnight/compound-suites.py); parse-checked;
 builds pending (coenttb/work#242)

---
 .../Boundary Tests.swift                      | 30 +++++++++++--------
 1 file changed, 17 insertions(+), 13 deletions(-)

diff --git a/Tests/Anamorphism Macro Tests/Boundary Tests.swift b/Tests/Anamorphism Macro Tests/Boundary Tests.swift
index 76c23a5..c285b12 100644
--- a/Tests/Anamorphism Macro Tests/Boundary Tests.swift	
+++ b/Tests/Anamorphism Macro Tests/Boundary Tests.swift	
@@ -18,21 +18,25 @@ private func leaves(_ tree: Tree) -> Int {
     }
 }
 
-@Suite
-struct `Anamorphism boundaries` {
-    @Test
-    func `a seed that stops at once unfolds to the base case`() {
-        let tree = Tree.anamorphism(0) { depth -> Tree.Base<Int> in
-            depth == 0 ? .leaf : .node(depth - 1, depth - 1)
+enum `Boundary Tests` {}
+
+extension `Boundary Tests` {
+    @Suite
+    struct `Anamorphism boundaries` {
+        @Test
+        func `a seed that stops at once unfolds to the base case`() {
+            let tree = Tree.anamorphism(0) { depth -> Tree.Base<Int> in
+                depth == 0 ? .leaf : .node(depth - 1, depth - 1)
+            }
+            #expect(leaves(tree) == 1)
         }
-        #expect(leaves(tree) == 1)
-    }
 
-    @Test
-    func `both children of a node are unfolded`() {
-        let tree = Tree.anamorphism(4) { depth -> Tree.Base<Int> in
-            depth == 0 ? .leaf : .node(depth - 1, depth - 1)
+        @Test
+        func `both children of a node are unfolded`() {
+            let tree = Tree.anamorphism(4) { depth -> Tree.Base<Int> in
+                depth == 0 ? .leaf : .node(depth - 1, depth - 1)
+            }
+            #expect(leaves(tree) == 16)
         }
-        #expect(leaves(tree) == 16)
     }
 }
