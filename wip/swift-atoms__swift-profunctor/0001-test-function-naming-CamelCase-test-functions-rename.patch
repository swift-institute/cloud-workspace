Subject: [PATCH] test function naming: CamelCase test functions renamed to
 backticked sentences (tests only; type-checked, not run; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 Tests/Profunctor Macro Tests/Law Tests.swift | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Tests/Profunctor Macro Tests/Law Tests.swift b/Tests/Profunctor Macro Tests/Law Tests.swift
index 64f42be..5b4ab90 100644
--- a/Tests/Profunctor Macro Tests/Law Tests.swift	
+++ b/Tests/Profunctor Macro Tests/Law Tests.swift	
@@ -1,7 +1,7 @@
 import Profunctor_Macro
 import Testing
 @Profunctor private struct Arrow<A, B> { let run: (A) -> B }
-@Test func dimapIdentityAndComposition() {
+@Test func `dimap identity and composition`() {
     let arrow = Arrow<Int, Int>(run: { $0 * 2 })
     let identity = arrow.dimap({ $0 }, { $0 })
     let twice = arrow.dimap({ $0 + 1 }, { $0 + 2 }).dimap({ $0 * 3 }, String.init)
