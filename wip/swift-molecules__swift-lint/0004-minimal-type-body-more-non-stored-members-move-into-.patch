From d33ce8c03e329b28e34a8e858832352931ef40d6 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 23:28:23 +0000
Subject: [PATCH 4/5] minimal type body: more non-stored members move into
 extensions of their type (overnight/minimal-bodies.py); type-checked, failing
 files left out (coenttb/work#242)

---
 Sources/Lint/Lint.Rule.Control.Expectation.swift | 14 ++++++++------
 1 file changed, 8 insertions(+), 6 deletions(-)

diff --git a/Sources/Lint/Lint.Rule.Control.Expectation.swift b/Sources/Lint/Lint.Rule.Control.Expectation.swift
index ba999fd..038083b 100644
--- a/Sources/Lint/Lint.Rule.Control.Expectation.swift
+++ b/Sources/Lint/Lint.Rule.Control.Expectation.swift
@@ -2,13 +2,15 @@ extension Lint.Rule.Control {
     public enum Expectation: Hashable, Sendable {
         case clean
         case findings(Swift::Int)
+    }
+}
 
-        @inlinable
-        public var count: Swift::Int {
-            switch self {
-            case .clean: 0
-            case .findings(let count): count
-            }
+extension Lint.Rule.Control.Expectation {
+    @inlinable
+    public var count: Swift::Int {
+        switch self {
+        case .clean: 0
+        case .findings(let count): count
         }
     }
 }
