Subject: [PATCH 1/5] compound suite name: narrative suites move into the test
 module's namespace `<File> Tests` (#239's layout), nested suites into
 extension <Path>.<Parent> (overnight/compound-suites.py); parse-checked;
 builds pending (coenttb/work#242)

---
 Tests/Lint Tests/Lint.Syntax Tests.swift     | 11 ++++++++---
 Tests/Lint Tests/Lint.Visibility Tests.swift |  5 ++++-
 2 files changed, 12 insertions(+), 4 deletions(-)

diff --git a/Tests/Lint Tests/Lint.Syntax Tests.swift b/Tests/Lint Tests/Lint.Syntax Tests.swift
index a843a5b..0b900d2 100644
--- a/Tests/Lint Tests/Lint.Syntax Tests.swift	
+++ b/Tests/Lint Tests/Lint.Syntax Tests.swift	
@@ -11,12 +11,17 @@ extension `Lint.Syntax Tests` {
         @Suite struct Unit {}
         @Suite struct `Edge Case` {}
         @Suite struct Integration {}
-        @Suite struct Identifier {}
-        @Suite struct `If Config` {}
-        @Suite struct Scope {}
     }
 }
 
+extension `Lint.Syntax Tests`.Test {
+    @Suite struct Identifier {}
+
+    @Suite struct `If Config` {}
+
+    @Suite struct Scope {}
+}
+
 extension `Lint.Syntax Tests`.Test.Identifier {
     @Test
     func `Matched pair of backticks is stripped`() {
diff --git a/Tests/Lint Tests/Lint.Visibility Tests.swift b/Tests/Lint Tests/Lint.Visibility Tests.swift
index 0e0eb4d..1079386 100644
--- a/Tests/Lint Tests/Lint.Visibility Tests.swift	
+++ b/Tests/Lint Tests/Lint.Visibility Tests.swift	
@@ -11,10 +11,13 @@ extension `Lint.Visibility Tests` {
         @Suite struct Unit {}
         @Suite struct `Edge Case` {}
         @Suite struct Integration {}
-        @Suite struct Effective {}
     }
 }
 
+extension `Lint.Visibility Tests`.Test {
+    @Suite struct Effective {}
+}
+
 extension `Lint.Visibility Tests`.Test.Unit {
     @Test
     func `Comparable orders narrower visibility lower`() {
