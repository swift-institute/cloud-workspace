From 5f76b82900226db2e3c070454a789416ebd3809f Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 23:43:41 +0000
Subject: [PATCH 5/6] Revert the minimal-body moves in directories the
 type-check can't verify (macros, C shims) (coenttb/work#242)

---
 Sources/Lint/Lint.Rule.Control.Expectation.swift | 14 ++++++--------
 1 file changed, 6 insertions(+), 8 deletions(-)

diff --git a/Sources/Lint/Lint.Rule.Control.Expectation.swift b/Sources/Lint/Lint.Rule.Control.Expectation.swift
index 038083b..ba999fd 100644
--- a/Sources/Lint/Lint.Rule.Control.Expectation.swift
+++ b/Sources/Lint/Lint.Rule.Control.Expectation.swift
@@ -2,15 +2,13 @@ extension Lint.Rule.Control {
     public enum Expectation: Hashable, Sendable {
         case clean
         case findings(Swift::Int)
-    }
-}
 
-extension Lint.Rule.Control.Expectation {
-    @inlinable
-    public var count: Swift::Int {
-        switch self {
-        case .clean: 0
-        case .findings(let count): count
+        @inlinable
+        public var count: Swift::Int {
+            switch self {
+            case .clean: 0
+            case .findings(let count): count
+            }
         }
     }
 }
