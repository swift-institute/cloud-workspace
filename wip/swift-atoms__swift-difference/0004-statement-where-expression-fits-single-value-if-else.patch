From 2564dc4dad11eaa6ae6e6c1b2f96d0b991905e30 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:35:28 +0000
Subject: [PATCH 4/6] statement where expression fits: single-value if/else
 chains written as if expressions (type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 Sources/Difference/Difference.swift | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/Sources/Difference/Difference.swift b/Sources/Difference/Difference.swift
index 2c0ecd1..663058a 100644
--- a/Sources/Difference/Difference.swift
+++ b/Sources/Difference/Difference.swift
@@ -43,10 +43,10 @@ extension Difference {
 
     @inlinable
     public init(_ value: Int) {
-        if value < 0 {
-            self = .negative(Magnitude(Cardinal(value.magnitude)))
+        self = if value < 0 {
+            .negative(Magnitude(Cardinal(value.magnitude)))
         } else {
-            self = .positive(Magnitude(Cardinal(UInt(value))))
+            .positive(Magnitude(Cardinal(UInt(value))))
         }
     }
 }
