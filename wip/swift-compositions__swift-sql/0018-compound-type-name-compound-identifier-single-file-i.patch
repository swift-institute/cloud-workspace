From 07ce2aba06ea660de847376457df0534b9710a87 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:32:52 +0000
Subject: [PATCH 18/21] compound type name, compound identifier: single-file
 internal types made fileprivate, package members used only in their target
 made internal (type-check follows; Linux x86_64, Swift 6.4.2)
 (coenttb/work#242)

---
 Sources/SQL Macros Implementation/Plugin.swift | 2 +-
 Sources/SQL/Column.swift                       | 2 +-
 Sources/SQL/Statements/Insert.swift            | 2 +-
 Sources/SQL/Statements/Update.swift            | 2 +-
 Sources/SQL/Statements/ValuesElement.swift     | 8 ++++----
 Tests/SQL Tests/Enum Table Tests.swift         | 2 +-
 6 files changed, 9 insertions(+), 9 deletions(-)

diff --git a/Sources/SQL Macros Implementation/Plugin.swift b/Sources/SQL Macros Implementation/Plugin.swift
index aab2b83..e9909bf 100644
--- a/Sources/SQL Macros Implementation/Plugin.swift	
+++ b/Sources/SQL Macros Implementation/Plugin.swift	
@@ -2,7 +2,7 @@ import SwiftCompilerPlugin
 import SwiftSyntaxMacros
 
 @main
-struct SQLPlugin: CompilerPlugin {
+fileprivate struct SQLPlugin: CompilerPlugin {
     let providingMacros: [any Macro.Type] =
         [
             BindMacro.self,
diff --git a/Sources/SQL/Column.swift b/Sources/SQL/Column.swift
index 2ca854d..efc6eb9 100644
--- a/Sources/SQL/Column.swift
+++ b/Sources/SQL/Column.swift
@@ -55,7 +55,7 @@ extension Column {
         decoding("\(quote: name)")
     }
 
-    package var fieldOffset: Int? {
+    var fieldOffset: Int? {
         keyPath.flatMap { MemoryLayout<Root>.offset(of: $0) }
     }
 
diff --git a/Sources/SQL/Statements/Insert.swift b/Sources/SQL/Statements/Insert.swift
index 4f2f6bb..b698f7d 100644
--- a/Sources/SQL/Statements/Insert.swift
+++ b/Sources/SQL/Statements/Insert.swift
@@ -445,7 +445,7 @@ private enum InsertValues {
 }
 
 public struct Insert<Into: Table, Returning> {
-    package var conflictResolution: ISO_9075.Fragment?
+    var conflictResolution: ISO_9075.Fragment?
     var columnNames: [String]
     var conflictTargetColumnNames: [String]
     var conflictTargetFilter: [ISO_9075.Fragment]
diff --git a/Sources/SQL/Statements/Update.swift b/Sources/SQL/Statements/Update.swift
index d1d6b79..d8a37c4 100644
--- a/Sources/SQL/Statements/Update.swift
+++ b/Sources/SQL/Statements/Update.swift
@@ -28,7 +28,7 @@ extension PrimaryKeyedTable {
 
 public struct Update<From: Table, Returning> {
     var isEmpty: Bool
-    package var conflictResolution: ISO_9075.Fragment?
+    var conflictResolution: ISO_9075.Fragment?
     var updates: Updates<From>
     var `where`: [ISO_9075.Fragment]
     var returning: [ISO_9075.Fragment]
diff --git a/Sources/SQL/Statements/ValuesElement.swift b/Sources/SQL/Statements/ValuesElement.swift
index 7cf4a13..5ff0e00 100644
--- a/Sources/SQL/Statements/ValuesElement.swift
+++ b/Sources/SQL/Statements/ValuesElement.swift
@@ -3,7 +3,7 @@ public import ISO_9075_Foundation
 public struct ValuesElement: Sendable {
     package let offset: Int
     package let columns: [Column]
-    package let fieldOffsets: [Int]
+    let fieldOffsets: [Int]
 
     package init(offset: Int, columns: [Column], fieldOffsets: [Int] = []) {
         self.offset = offset
@@ -42,7 +42,7 @@ extension QueryRepresentable {
 }
 
 extension [ValuesElement] {
-    package func columnIndex<Value>(of keyPath: PartialKeyPath<Value>) -> Int? {
+    func columnIndex<Value>(of keyPath: PartialKeyPath<Value>) -> Int? {
         guard let target = MemoryLayout<Value>.offset(of: keyPath) else { return nil }
         var position = 0
         for element in self {
@@ -73,11 +73,11 @@ extension Table {
         TableColumns.allColumns.firstIndex { $0.keyPath == keyPath }
     }
 
-    package static var valuesElement: ValuesElement {
+    static var valuesElement: ValuesElement {
         ValuesElement(offset: 0, columns: _valuesColumns, fieldOffsets: _valuesFieldOffsets)
     }
 
-    package static var writableValuesElement: ValuesElement {
+    static var writableValuesElement: ValuesElement {
         ValuesElement(
             offset: 0,
             columns: TableColumns.writableColumns.map { ValuesElement.Column(name: $0.name, decoding: $0.decoding) }
diff --git a/Tests/SQL Tests/Enum Table Tests.swift b/Tests/SQL Tests/Enum Table Tests.swift
index c1f0186..9bd224f 100644
--- a/Tests/SQL Tests/Enum Table Tests.swift	
+++ b/Tests/SQL Tests/Enum Table Tests.swift	
@@ -13,7 +13,7 @@
         case note(String)
     }
 
-    struct RenderedValues: QueryDecoder {
+    fileprivate struct RenderedValues: QueryDecoder {
         var values: [ISO_9075.Value]
 
         mutating func next() -> ISO_9075.Value {
