From e7d34680162d59eec742118cba320607cb44ed43 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:35:33 +0000
Subject: [PATCH 15/21] statement where expression fits: single-value if/else
 chains written as if expressions (type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 .../Internal/ExprSyntax.swift                      | 12 ++++++------
 Sources/SQL Macros Implementation/TableMacro.swift | 14 +++++++-------
 Sources/SQL/Optional.swift                         |  6 +++---
 3 files changed, 16 insertions(+), 16 deletions(-)

diff --git a/Sources/SQL Macros Implementation/Internal/ExprSyntax.swift b/Sources/SQL Macros Implementation/Internal/ExprSyntax.swift
index 850bfc3..3db015d 100644
--- a/Sources/SQL Macros Implementation/Internal/ExprSyntax.swift	
+++ b/Sources/SQL Macros Implementation/Internal/ExprSyntax.swift	
@@ -4,16 +4,16 @@ import SwiftSyntaxBuilder
 
 extension ExprSyntax {
     var literalType: TypeSyntax? {
-        if self.is(BooleanLiteralExprSyntax.self) {
-            return "Swift.Bool"
+        return if self.is(BooleanLiteralExprSyntax.self) {
+            "Swift.Bool"
         } else if self.is(FloatLiteralExprSyntax.self) {
-            return "Swift.Double"
+            "Swift.Double"
         } else if self.is(IntegerLiteralExprSyntax.self) {
-            return "Swift.Int"
+            "Swift.Int"
         } else if self.is(StringLiteralExprSyntax.self) {
-            return "Swift.String"
+            "Swift.String"
         } else {
-            return nil
+            nil
         }
     }
 
diff --git a/Sources/SQL Macros Implementation/TableMacro.swift b/Sources/SQL Macros Implementation/TableMacro.swift
index fa5e4b4..ed132bc 100644
--- a/Sources/SQL Macros Implementation/TableMacro.swift	
+++ b/Sources/SQL Macros Implementation/TableMacro.swift	
@@ -616,10 +616,10 @@ extension TableMacro: ExtensionMacro {
                     """
                 )
                 let caseArgumentLabel: String
-                if let firstName = parameter.firstName, firstName.tokenKind != .wildcard {
-                    caseArgumentLabel = "\(firstName.text.trimmingBackticks()): "
+                caseArgumentLabel = if let firstName = parameter.firstName, firstName.tokenKind != .wildcard {
+                    "\(firstName.text.trimmingBackticks()): "
                 } else {
-                    caseArgumentLabel = ""
+                    ""
                 }
                 decodingAssignments.append(
                     """
@@ -1574,12 +1574,12 @@ extension TableMacro: MemberAttributeMacro {
         }
 
         let checkAttribute: [AttributeSyntax]
-        if let columnType {
-            checkAttribute = ["@\(macrosModuleName)::ColumnCheck(\(columnType.trimmed).self)"]
+        checkAttribute = if let columnType {
+            ["@\(macrosModuleName)::ColumnCheck(\(columnType.trimmed).self)"]
         } else if let initializer = binding.initializer {
-            checkAttribute = ["@\(macrosModuleName)::ColumnCheck(\(initializer.value.trimmed))"]
+            ["@\(macrosModuleName)::ColumnCheck(\(initializer.value.trimmed))"]
         } else {
-            checkAttribute = []
+            []
         }
         return checkAttribute
     }
diff --git a/Sources/SQL/Optional.swift b/Sources/SQL/Optional.swift
index 84792f0..14712e9 100644
--- a/Sources/SQL/Optional.swift
+++ b/Sources/SQL/Optional.swift
@@ -61,10 +61,10 @@ extension Optional: QueryRepresentable where Wrapped: QueryRepresentable {
 
     @inlinable
     public init(queryOutput: Wrapped.QueryOutput?) {
-        if let queryOutput {
-            self = Wrapped(queryOutput: queryOutput)
+        self = if let queryOutput {
+            Wrapped(queryOutput: queryOutput)
         } else {
-            self = nil
+            nil
         }
     }
 
