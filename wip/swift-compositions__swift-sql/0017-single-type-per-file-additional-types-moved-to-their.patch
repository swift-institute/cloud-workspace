diff --git a/Sources/SQL/Statements/ValuesElement.Column.swift b/Sources/SQL/Statements/ValuesElement.Column.swift
new file mode 100644
index 0000000..680e12f
--- /dev/null
+++ b/Sources/SQL/Statements/ValuesElement.Column.swift
@@ -0,0 +1,14 @@
+public import ISO_9075_Foundation
+
+
+extension ValuesElement {
+    public struct Column: Sendable {
+        package let name: String?
+        package let decoding: @Sendable (ISO_9075.Fragment) -> ISO_9075.Fragment
+
+        package init(name: String?, decoding: @escaping @Sendable (ISO_9075.Fragment) -> ISO_9075.Fragment) {
+            self.name = name
+            self.decoding = decoding
+        }
+    }
+}
