From d888a72b39273fd5158c1d27854f16c5d1e82736 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 23:31:25 +0000
Subject: [PATCH 09/19] Revert the minimal-body moves in files where they
 raised a rule over its ratchet limit (coenttb/work#242)

---
 .../Statements/CommonTableExpression.swift    | 26 +++++++------------
 Sources/SQL/Statements/ValuesElement.swift    |  3 +--
 2 files changed, 10 insertions(+), 19 deletions(-)

diff --git a/Sources/SQL/Statements/CommonTableExpression.swift b/Sources/SQL/Statements/CommonTableExpression.swift
index 47544f9..4c98cf8 100644
--- a/Sources/SQL/Statements/CommonTableExpression.swift
+++ b/Sources/SQL/Statements/CommonTableExpression.swift
@@ -1,6 +1,9 @@
 public import ISO_9075_Foundation
 
 public struct With<Base: Statement>: Statement, Sendable {
+    public typealias QueryValue = Base.QueryValue
+    public typealias From = Never
+
     var ctes: [CommonTableExpressionClause]
     var statement: ISO_9075.Fragment
     var hasUpsertParsingAmbiguity: Bool
@@ -46,12 +49,6 @@ public struct With<Base: Statement>: Statement, Sendable {
         self.statement = statement.query
         hasUpsertParsingAmbiguity = statement._hasUpsertParsingAmbiguity
     }
-}
-
-extension With {
-    public typealias QueryValue = Base.QueryValue
-
-    public typealias From = Never
 
     public var _hasUpsertParsingAmbiguity: Bool { hasUpsertParsingAmbiguity }
 
@@ -74,6 +71,7 @@ extension ISO_9075.Fragment {
 }
 
 public struct CommonTableExpressionClause: QueryExpression, Sendable {
+    public typealias QueryValue = ()
     let tableName: ISO_9075.Fragment
     let select: ISO_9075.Fragment
     let materialization: Materialization?
@@ -83,10 +81,6 @@ public struct CommonTableExpressionClause: QueryExpression, Sendable {
         self.select = select
         self.materialization = materialization
     }
-}
-
-extension CommonTableExpressionClause {
-    public typealias QueryValue = ()
 
     public var queryFragment: ISO_9075.Fragment {
         guard !select.isEmpty else { return "" }
@@ -98,14 +92,12 @@ extension CommonTableExpressionClause {
     public enum Materialization: Hashable, Sendable {
         case materialized
         case notMaterialized
-    }
-}
 
-extension CommonTableExpressionClause.Materialization {
-    var queryFragment: ISO_9075.Fragment {
-        switch self {
-        case .materialized: "MATERIALIZED "
-        case .notMaterialized: "NOT MATERIALIZED "
+        var queryFragment: ISO_9075.Fragment {
+            switch self {
+            case .materialized: "MATERIALIZED "
+            case .notMaterialized: "NOT MATERIALIZED "
+            }
         }
     }
 }
diff --git a/Sources/SQL/Statements/ValuesElement.swift b/Sources/SQL/Statements/ValuesElement.swift
index eca9a98..6cb3984 100644
--- a/Sources/SQL/Statements/ValuesElement.swift
+++ b/Sources/SQL/Statements/ValuesElement.swift
@@ -10,9 +10,7 @@ public struct ValuesElement: Sendable {
         self.columns = columns
         self.fieldOffsets = fieldOffsets
     }
-}
 
-extension ValuesElement {
     public struct Column: Sendable {
         package let name: String?
         package let decoding: @Sendable (ISO_9075.Fragment) -> ISO_9075.Fragment
@@ -21,6 +19,7 @@ extension ValuesElement {
             self.name = name
             self.decoding = decoding
         }
+
     }
 
     package static func elements<each V: QueryRepresentable>(for types: repeat (each V).Type) -> [ValuesElement] {
-- 
