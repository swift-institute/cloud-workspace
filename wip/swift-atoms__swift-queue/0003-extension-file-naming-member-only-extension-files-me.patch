From d868d526e8f08ef6683d4d83300d9f7302fcab26 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:46:10 +0000
Subject: [PATCH 3/3] extension file naming: member-only extension files merged
 into the extended type's own file (type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 Sources/Queue/Queue+Equatable.swift |  9 ---------
 Sources/Queue/Queue+Hashable.swift  |  9 ---------
 Sources/Queue/__Queue.swift         | 16 ++++++++++++++++
 3 files changed, 16 insertions(+), 18 deletions(-)
 delete mode 100644 Sources/Queue/Queue+Equatable.swift
 delete mode 100644 Sources/Queue/Queue+Hashable.swift

diff --git a/Sources/Queue/Queue+Equatable.swift b/Sources/Queue/Queue+Equatable.swift
deleted file mode 100644
index afeb2b5..0000000
--- a/Sources/Queue/Queue+Equatable.swift
+++ /dev/null
@@ -1,9 +0,0 @@
-public import Queue_Primitive
-
-extension __Queue: Equatable where S: Equatable {
-
-    @inlinable
-    public static func == (lhs: Self, rhs: Self) -> Bool {
-        lhs.store == rhs.store
-    }
-}
diff --git a/Sources/Queue/Queue+Hashable.swift b/Sources/Queue/Queue+Hashable.swift
deleted file mode 100644
index 5998225..0000000
--- a/Sources/Queue/Queue+Hashable.swift
+++ /dev/null
@@ -1,9 +0,0 @@
-public import Queue_Primitive
-
-extension __Queue: Hashable where S: Hashable {
-
-    @inlinable
-    public func hash(into hasher: inout Hasher) {
-        store.hash(into: &hasher)
-    }
-}
diff --git a/Sources/Queue/__Queue.swift b/Sources/Queue/__Queue.swift
index 2508efa..95992e6 100644
--- a/Sources/Queue/__Queue.swift
+++ b/Sources/Queue/__Queue.swift
@@ -151,3 +151,19 @@ extension __Queue where S: ~Copyable {
         Self(store: store.clone())
     }
 }
+
+extension __Queue: Equatable where S: Equatable {
+
+    @inlinable
+    public static func == (lhs: Self, rhs: Self) -> Bool {
+        lhs.store == rhs.store
+    }
+}
+
+extension __Queue: Hashable where S: Hashable {
+
+    @inlinable
+    public func hash(into hasher: inout Hasher) {
+        store.hash(into: &hasher)
+    }
+}
-- 
