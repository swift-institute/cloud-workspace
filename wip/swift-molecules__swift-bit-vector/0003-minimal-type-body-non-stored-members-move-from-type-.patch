From 9ee54381882f9eb2993a81b87077a86a619256e6 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 22:39:53 +0000
Subject: [PATCH 3/7] minimal type body: non-stored members move from type
 bodies into an extension of the type in the same file
 (overnight/minimal-bodies.py); type-checked against the root build,
 directories that failed or couldn't be checked left out (coenttb/work#242)

---
 .../Bit Vector Inline/Bit.Vector.Inline.swift | 18 +++++++++--------
 .../Bit Vector Static/Bit.Vector.Static.swift | 20 ++++++++-----------
 2 files changed, 18 insertions(+), 20 deletions(-)

diff --git a/Sources/Bit Vector Inline/Bit.Vector.Inline.swift b/Sources/Bit Vector Inline/Bit.Vector.Inline.swift
index 9800b14..c145624 100644
--- a/Sources/Bit Vector Inline/Bit.Vector.Inline.swift	
+++ b/Sources/Bit Vector Inline/Bit.Vector.Inline.swift	
@@ -8,13 +8,6 @@ public import Tagged
 
 extension Bit.Vector {
     public struct Inline<let wordCount: Int>: Sendable {
-        @inlinable
-        public static var _capacity: Index<Bit>.Count {
-            Tagged<Bit, Cardinal>(
-                _unchecked: Cardinal(UInt(wordCount * UInt.bitWidth))
-            )
-        }
-
         @usableFromInline
         package var _storage: InlineArray<wordCount, UInt>
 
@@ -64,9 +57,18 @@ extension Bit.Vector {
                 }
             }
         }
+    }
+}
 
-        public typealias Error = __BitVectorInlineError
+extension Bit.Vector.Inline {
+    @inlinable
+    public static var _capacity: Index<Bit>.Count {
+        Tagged<Bit, Cardinal>(
+            _unchecked: Cardinal(UInt(wordCount * UInt.bitWidth))
+        )
     }
+
+    public typealias Error = __BitVectorInlineError
 }
 
 extension Bit.Vector.Inline {
diff --git a/Sources/Bit Vector Static/Bit.Vector.Static.swift b/Sources/Bit Vector Static/Bit.Vector.Static.swift
index 5e1b234..25a95b3 100644
--- a/Sources/Bit Vector Static/Bit.Vector.Static.swift	
+++ b/Sources/Bit Vector Static/Bit.Vector.Static.swift	
@@ -6,18 +6,10 @@ public import Ordinal
 import Tagged
 
 extension Bit.Vector {
-
     public struct Static<let wordCount: Int>: Sendable {
         @usableFromInline
         package var _storage: InlineArray<wordCount, UInt>
 
-        @inlinable
-        public static var capacity: Index<Bit>.Count {
-            Tagged<Bit, Cardinal>(
-                _unchecked: Cardinal(UInt(wordCount * UInt.bitWidth))
-            )
-        }
-
         @inlinable
         public init() {
             self._storage = InlineArray(repeating: 0)
@@ -26,7 +18,15 @@ extension Bit.Vector {
 }
 
 extension Bit.Vector.Static {
+    @inlinable
+    public static var capacity: Index<Bit>.Count {
+        Tagged<Bit, Cardinal>(
+            _unchecked: Cardinal(UInt(wordCount * UInt.bitWidth))
+        )
+    }
+}
 
+extension Bit.Vector.Static {
     @inlinable
     public subscript(index: Index<Bit>) -> Bool {
         get {
@@ -45,7 +45,6 @@ extension Bit.Vector.Static {
 }
 
 extension Bit.Vector.Static {
-
     @inlinable
     public var isEmpty: Bool { allFalse }
 
@@ -54,7 +53,6 @@ extension Bit.Vector.Static {
 }
 
 extension Bit.Vector.Static {
-
     @inlinable
     public var ones: Bit.Vector.Ones.Static<wordCount> {
         Bit.Vector.Ones.Static<wordCount>(storage: _storage)
@@ -62,7 +60,6 @@ extension Bit.Vector.Static {
 }
 
 extension Bit.Vector.Static {
-
     @inlinable
     public mutating func toggle(_ index: Index<Bit>) {
         precondition(index < Self.capacity, "Index out of bounds")
@@ -72,7 +69,6 @@ extension Bit.Vector.Static {
 }
 
 extension Bit.Vector.Static {
-
     @inlinable
     public var zeros: Bit.Vector.Zeros.Static<wordCount> {
         Bit.Vector.Zeros.Static<wordCount>(storage: _storage)
