Subject: [PATCH 5/6] compound type name, compound identifier: single-file
 internal types made fileprivate, package members used only in their target
 made internal (type-check follows; Linux x86_64, Swift 6.4.2)
 (coenttb/work#242)

---
 Tests/Bit Vector Tests/Bit.Vector.Bounded Tests.swift | 2 +-
 Tests/Bit Vector Tests/Bit.Vector.Dynamic Tests.swift | 2 +-
 Tests/Bit Vector Tests/Bit.Vector.Inline Tests.swift  | 2 +-
 3 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/Tests/Bit Vector Tests/Bit.Vector.Bounded Tests.swift b/Tests/Bit Vector Tests/Bit.Vector.Bounded Tests.swift
index bdd5d87..bec1ed4 100644
--- a/Tests/Bit Vector Tests/Bit.Vector.Bounded Tests.swift	
+++ b/Tests/Bit Vector Tests/Bit.Vector.Bounded Tests.swift	
@@ -2,7 +2,7 @@ import Bit_Vector
 import Bit_Vector_Test_Support
 import Testing
 
-enum BitVectorBoundedTests {
+fileprivate enum BitVectorBoundedTests {
     @Suite struct Unit {}
     @Suite struct `Edge Case` {}
 }
diff --git a/Tests/Bit Vector Tests/Bit.Vector.Dynamic Tests.swift b/Tests/Bit Vector Tests/Bit.Vector.Dynamic Tests.swift
index 2b7c3b2..d44660a 100644
--- a/Tests/Bit Vector Tests/Bit.Vector.Dynamic Tests.swift	
+++ b/Tests/Bit Vector Tests/Bit.Vector.Dynamic Tests.swift	
@@ -3,7 +3,7 @@ import Bit_Vector_Test_Support
 import Index
 import Testing
 
-enum BitVectorDynamicTests {
+fileprivate enum BitVectorDynamicTests {
     @Suite struct Unit {}
     @Suite struct `Edge Case` {}
 }
diff --git a/Tests/Bit Vector Tests/Bit.Vector.Inline Tests.swift b/Tests/Bit Vector Tests/Bit.Vector.Inline Tests.swift
index e38e176..dcd53aa 100644
--- a/Tests/Bit Vector Tests/Bit.Vector.Inline Tests.swift	
+++ b/Tests/Bit Vector Tests/Bit.Vector.Inline Tests.swift	
@@ -2,7 +2,7 @@ import Bit_Vector
 import Bit_Vector_Test_Support
 import Testing
 
-enum BitVectorInlineTests {
+fileprivate enum BitVectorInlineTests {
     @Suite struct Unit {}
     @Suite struct `Edge Case` {}
 }
