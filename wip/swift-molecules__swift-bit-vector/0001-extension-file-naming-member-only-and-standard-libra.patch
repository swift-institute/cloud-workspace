+extension Bit.Vector {
+
+    @inlinable
+    public var ones: Ones.View {
+        @_lifetime(borrow self)
+        borrowing get {
+            Ones.View(vector: self)
+        }
+    }
+}
+
+extension Bit.Vector {
+
+    @inlinable
+    public mutating func take() -> Bit.Vector {
+        var empty = Bit.Vector(capacity: capacity)
+        swap(&self, &empty)
+        return empty
+    }
+}
+
+extension Bit.Vector {
+
+    @inlinable
+    public nonmutating func toggle(_ index: Index<Bit>) {
+        precondition(index < capacity, "Index out of bounds")
+        let location = Bit.Pack<UInt>.Location(index: index, bitsPerWord: .bitsPerWord)
+        let current = unsafe _words[location.word]
+        unsafe _words[location.word] = current ^ location.mask
+    }
+}
+
+extension Bit.Vector {
+
+    @inlinable
+    public var zeros: Zeros.View {
+        @_lifetime(borrow self)
+        borrowing get {
+            Zeros.View(vector: self)
+        }
+    }
+}
