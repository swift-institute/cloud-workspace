From 00f3e97216cd1ff0cef4f4359f09719f0f45a7ce Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:35:31 +0000
Subject: [PATCH 4/4] statement where expression fits: single-value if/else
 chains written as if expressions (type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 Sources/W3C PNG/W3C_PNG.parse.swift | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/Sources/W3C PNG/W3C_PNG.parse.swift b/Sources/W3C PNG/W3C_PNG.parse.swift
index 64441c3..44fa00a 100644
--- a/Sources/W3C PNG/W3C_PNG.parse.swift	
+++ b/Sources/W3C PNG/W3C_PNG.parse.swift	
@@ -256,12 +256,12 @@ extension W3C_PNG {
         let pb = abs(p - b)
         let pc = abs(p - c)
 
-        if pa <= pb && pa <= pc {
-            return a
+        return if pa <= pb && pa <= pc {
+            a
         } else if pb <= pc {
-            return b
+            b
         } else {
-            return c
+            c
         }
     }
 }
