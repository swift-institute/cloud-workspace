From f726427c370bcc22cd8258cbd7c3b14a8fb2f95d Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 22:39:57 +0000
Subject: [PATCH 3/4] minimal type body: non-stored members move from type
 bodies into an extension of the type in the same file
 (overnight/minimal-bodies.py); type-checked against the root build,
 directories that failed or couldn't be checked left out (coenttb/work#242)

---
 Sources/W3C PNG/W3C_PNG.CRC.swift | 12 ++++++------
 1 file changed, 6 insertions(+), 6 deletions(-)

diff --git a/Sources/W3C PNG/W3C_PNG.CRC.swift b/Sources/W3C PNG/W3C_PNG.CRC.swift
index 59a7ec0..cbb497c 100644
--- a/Sources/W3C PNG/W3C_PNG.CRC.swift	
+++ b/Sources/W3C PNG/W3C_PNG.CRC.swift	
@@ -1,19 +1,19 @@
 internal import Byte
 
 extension W3C_PNG {
-
     internal enum CRC {
+    }
+}
 
-        private static let table: [UInt32] = (0..<256).map { n in
-            (0..<8).reduce(UInt32(n)) { c, _ in
-                c & 1 != 0 ? 0xEDB8_8320 ^ (c >> 1) : c >> 1
-            }
+extension W3C_PNG.CRC {
+    private static let table: [UInt32] = (0..<256).map { n in
+        (0..<8).reduce(UInt32(n)) { c, _ in
+            c & 1 != 0 ? 0xEDB8_8320 ^ (c >> 1) : c >> 1
         }
     }
 }
 
 extension W3C_PNG.CRC {
-
     internal static func checksum(_ bytes: some Swift.Sequence<Byte>) -> UInt32 {
         bytes.reduce(UInt32(0xFFFF_FFFF)) { c, byte in
             table[Int((c ^ UInt32(byte.underlying)) & 0xFF)] ^ (c >> 8)
-- 
