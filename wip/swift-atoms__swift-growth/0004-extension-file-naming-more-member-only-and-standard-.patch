From 01117ee1f8e84b843d5cc5631ff0a9eed9121800 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 01:37:27 +0000
Subject: [PATCH 4/4] extension file naming: more member-only and
 standard-library extension files merge into their type's file; single type
 per file: more additional types move to their own files
 (merge-extension-files.py, split-types.py); parse-checked; root build pending
 (coenttb/work#242)

---
 .../Growth.Policy.Memory.swift                  | 16 ----------------
 Sources/Growth/Growth.Policy.swift              | 17 +++++++++++++++++
 2 files changed, 17 insertions(+), 16 deletions(-)
 delete mode 100644 Sources/Growth/Absorbed swift-growth-memory/Growth.Policy.Memory.swift

diff --git a/Sources/Growth/Absorbed swift-growth-memory/Growth.Policy.Memory.swift b/Sources/Growth/Absorbed swift-growth-memory/Growth.Policy.Memory.swift
deleted file mode 100644
index ce7d5a8..0000000
--- a/Sources/Growth/Absorbed swift-growth-memory/Growth.Policy.Memory.swift	
+++ /dev/null
@@ -1,16 +0,0 @@
-#if Memory
-    public import Memory
-
-    extension Growth.Policy where Element: ~Copyable {
-
-        @inlinable
-        public static func paged(_ alignment: Memory.Alignment) -> Self {
-            .custom { current throws(Error) in
-                let minimum = current == .zero ? Count.one : current
-                let rounded = alignment.alignUp(minimum.underlying.rawValue)
-                guard rounded >= minimum.underlying.rawValue else { throw .overflow }
-                return Count(Cardinal(rounded))
-            }
-        }
-    }
-#endif
diff --git a/Sources/Growth/Growth.Policy.swift b/Sources/Growth/Growth.Policy.swift
index 165d84a..be3c74b 100644
--- a/Sources/Growth/Growth.Policy.swift
+++ b/Sources/Growth/Growth.Policy.swift
@@ -72,3 +72,20 @@ extension Growth.Policy where Element: ~Copyable {
 extension Growth.Policy where Element: ~Copyable {
     public typealias Count = Tagged::Tagged<Element, Cardinal::Cardinal>
 }
+
+#if Memory
+    public import Memory
+
+    extension Growth.Policy where Element: ~Copyable {
+
+        @inlinable
+        public static func paged(_ alignment: Memory.Alignment) -> Self {
+            .custom { current throws(Error) in
+                let minimum = current == .zero ? Count.one : current
+                let rounded = alignment.alignUp(minimum.underlying.rawValue)
+                guard rounded >= minimum.underlying.rawValue else { throw .overflow }
+                return Count(Cardinal(rounded))
+            }
+        }
+    }
+#endif
