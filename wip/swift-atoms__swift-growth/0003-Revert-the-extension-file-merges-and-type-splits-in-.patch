From faea5727efc7ef4362c19cd1f3bf9258cd106768 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 21:46:00 +0000
Subject: [PATCH 3/5] Revert the extension-file merges and type splits in
 directories where a merged file brought its conditional imports mid-file
 (coenttb/work#242)

---
 .../Growth.Policy.Memory.swift                  | 16 ++++++++++++++++
 Sources/Growth/Growth.Policy.swift              | 17 -----------------
 2 files changed, 16 insertions(+), 17 deletions(-)
 create mode 100644 Sources/Growth/Absorbed swift-growth-memory/Growth.Policy.Memory.swift

diff --git a/Sources/Growth/Absorbed swift-growth-memory/Growth.Policy.Memory.swift b/Sources/Growth/Absorbed swift-growth-memory/Growth.Policy.Memory.swift
new file mode 100644
index 0000000..ce7d5a8
--- /dev/null
+++ b/Sources/Growth/Absorbed swift-growth-memory/Growth.Policy.Memory.swift	
@@ -0,0 +1,16 @@
+#if Memory
+    public import Memory
+
+    extension Growth.Policy where Element: ~Copyable {
+
+        @inlinable
+        public static func paged(_ alignment: Memory.Alignment) -> Self {
+            .custom { current throws(Error) in
+                let minimum = current == .zero ? Count.one : current
+                let rounded = alignment.alignUp(minimum.underlying.rawValue)
+                guard rounded >= minimum.underlying.rawValue else { throw .overflow }
+                return Count(Cardinal(rounded))
+            }
+        }
+    }
+#endif
diff --git a/Sources/Growth/Growth.Policy.swift b/Sources/Growth/Growth.Policy.swift
index be3c74b..165d84a 100644
--- a/Sources/Growth/Growth.Policy.swift
+++ b/Sources/Growth/Growth.Policy.swift
@@ -72,20 +72,3 @@ extension Growth.Policy where Element: ~Copyable {
 extension Growth.Policy where Element: ~Copyable {
     public typealias Count = Tagged::Tagged<Element, Cardinal::Cardinal>
 }
-
-#if Memory
-    public import Memory
-
-    extension Growth.Policy where Element: ~Copyable {
-
-        @inlinable
-        public static func paged(_ alignment: Memory.Alignment) -> Self {
-            .custom { current throws(Error) in
-                let minimum = current == .zero ? Count.one : current
-                let rounded = alignment.alignUp(minimum.underlying.rawValue)
-                guard rounded >= minimum.underlying.rawValue else { throw .overflow }
-                return Count(Cardinal(rounded))
-            }
-        }
-    }
-#endif
