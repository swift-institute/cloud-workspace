From 8e704b638df52a7e5ecde21fa86f0c01894413c1 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:43:37 +0000
Subject: [PATCH 08/10] extension file naming: files renamed to the extended
 type's own name or the 'T where <clause>' shape (renames only; Linux x86_64,
 Swift 6.4.2) (coenttb/work#242)

---
 ...yte.swift => Carrier.Protocol where Underlying == UInt8.swift} | 0
 ...t.Array+Byte.swift => Swift.Array where Element == Byte.swift} | 0
 ...ce+Byte.swift => Swift.ArraySlice where Element == Byte.swift} | 0
 Sources/Byte/{Swift.String+Byte.swift => Swift.String.swift}      | 0
 Sources/Byte/{Swift.UInt8+Byte.swift => Swift.UInt8.swift}        | 0
 5 files changed, 0 insertions(+), 0 deletions(-)
 rename Sources/Byte/{Carrier+Byte.swift => Carrier.Protocol where Underlying == UInt8.swift} (100%)
 rename Sources/Byte/{Swift.Array+Byte.swift => Swift.Array where Element == Byte.swift} (100%)
 rename Sources/Byte/{Swift.ArraySlice+Byte.swift => Swift.ArraySlice where Element == Byte.swift} (100%)
 rename Sources/Byte/{Swift.String+Byte.swift => Swift.String.swift} (100%)
 rename Sources/Byte/{Swift.UInt8+Byte.swift => Swift.UInt8.swift} (100%)

diff --git a/Sources/Byte/Carrier+Byte.swift b/Sources/Byte/Carrier.Protocol where Underlying == UInt8.swift
similarity index 100%
rename from Sources/Byte/Carrier+Byte.swift
rename to Sources/Byte/Carrier.Protocol where Underlying == UInt8.swift
diff --git a/Sources/Byte/Swift.Array+Byte.swift b/Sources/Byte/Swift.Array where Element == Byte.swift
similarity index 100%
rename from Sources/Byte/Swift.Array+Byte.swift
rename to Sources/Byte/Swift.Array where Element == Byte.swift
diff --git a/Sources/Byte/Swift.ArraySlice+Byte.swift b/Sources/Byte/Swift.ArraySlice where Element == Byte.swift
similarity index 100%
rename from Sources/Byte/Swift.ArraySlice+Byte.swift
rename to Sources/Byte/Swift.ArraySlice where Element == Byte.swift
diff --git a/Sources/Byte/Swift.String+Byte.swift b/Sources/Byte/Swift.String.swift
similarity index 100%
rename from Sources/Byte/Swift.String+Byte.swift
rename to Sources/Byte/Swift.String.swift
diff --git a/Sources/Byte/Swift.UInt8+Byte.swift b/Sources/Byte/Swift.UInt8.swift
similarity index 100%
rename from Sources/Byte/Swift.UInt8+Byte.swift
rename to Sources/Byte/Swift.UInt8.swift
