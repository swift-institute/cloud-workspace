From bcc29d4835d166846cd0482fb810404d5738bdd1 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 21:45:59 +0000
Subject: [PATCH 3/6] Revert the extension-file merges and type splits in
 directories where a merged file brought its conditional imports mid-file
 (coenttb/work#242)

---
 .../Absorbed/swift-byte-bit/Byte+Bit.swift    |  9 +++++++++
 .../Byte/BitPattern/Byte+Bit.Pattern.swift    | 10 ++++++++++
 Sources/Byte/Byte.swift                       | 19 -------------------
 3 files changed, 19 insertions(+), 19 deletions(-)
 create mode 100644 Sources/Byte/Absorbed/swift-byte-bit/Byte+Bit.swift
 create mode 100644 Sources/Byte/BitPattern/Byte+Bit.Pattern.swift

diff --git a/Sources/Byte/Absorbed/swift-byte-bit/Byte+Bit.swift b/Sources/Byte/Absorbed/swift-byte-bit/Byte+Bit.swift
new file mode 100644
index 0000000..f1e1b6a
--- /dev/null
+++ b/Sources/Byte/Absorbed/swift-byte-bit/Byte+Bit.swift
@@ -0,0 +1,9 @@
+public import Bit
+
+extension Byte {
+    @inlinable
+    public subscript(_ index: Int) -> Bit {
+        precondition((0..<UInt8.bitWidth).contains(index), "Bit index out of bounds")
+        return (underlying >> UInt8(index)) & 1 == 1 ? Bit.one : Bit.zero
+    }
+}
diff --git a/Sources/Byte/BitPattern/Byte+Bit.Pattern.swift b/Sources/Byte/BitPattern/Byte+Bit.Pattern.swift
new file mode 100644
index 0000000..9a2e9d0
--- /dev/null
+++ b/Sources/Byte/BitPattern/Byte+Bit.Pattern.swift
@@ -0,0 +1,10 @@
+#if BitPattern
+    public import Bit_Pattern
+
+    extension Byte {
+        @inlinable
+        public var bits: Bit.Pattern<UInt8>.Mask {
+            Bit.Pattern<UInt8>.Mask(underlying)
+        }
+    }
+#endif
diff --git a/Sources/Byte/Byte.swift b/Sources/Byte/Byte.swift
index 89ec2c2..06771d0 100644
--- a/Sources/Byte/Byte.swift
+++ b/Sources/Byte/Byte.swift
@@ -32,22 +32,3 @@ extension Byte {
 extension Byte: Swift.Equatable {}
 
 extension Byte: Swift.Hashable {}
-
-extension Byte {
-    @inlinable
-    public subscript(_ index: Int) -> Bit {
-        precondition((0..<UInt8.bitWidth).contains(index), "Bit index out of bounds")
-        return (underlying >> UInt8(index)) & 1 == 1 ? Bit.one : Bit.zero
-    }
-}
-
-#if BitPattern
-    public import Bit_Pattern
-
-    extension Byte {
-        @inlinable
-        public var bits: Bit.Pattern<UInt8>.Mask {
-            Bit.Pattern<UInt8>.Mask(underlying)
-        }
-    }
-#endif
-- 
