From fcca8232f4cb9a9b2de60b512535767c2c816d71 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:24:49 +0000
Subject: [PATCH 07/10] trait consistency: dependencies imported only under a
 trait get that trait's condition (runner repair; Linux x86_64, Swift 6.4.2)
 (coenttb/work#242)

---
 Package.swift | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Package.swift b/Package.swift
index 41d42f2..208dc5b 100644
--- a/Package.swift
+++ b/Package.swift
@@ -58,7 +58,7 @@ let package = Package(
         .testTarget(
             name: "Decision Byte Bit Tests",
             dependencies: [
-                .target(name: "Byte"), .product(name: "Bit", package: "swift-bit"),
+                .target(name: "Byte"), .product(name: "Bit", package: "swift-bit", condition: .when(traits: ["BitPattern"])),
                 .product(
                     name: "Bit Pattern",
                     package: "swift-bit-pattern",
