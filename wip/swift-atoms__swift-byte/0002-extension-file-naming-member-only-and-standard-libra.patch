From fb8d5c5a64e47739973b80315b82b9d9b7f40019 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 20:52:41 +0000
Subject: [PATCH 2/8] extension file naming: member-only and
 standard-library-conformance extension files merge into their type's own file
 (overnight/merge-extension-files.py); single type per file: additional types
 move to their own <Parent>.<Name>.swift inside the container's extension
 (overnight/split-types.py); parse-checked; builds pending (coenttb/work#242)

---
 .../Absorbed/swift-byte-bit/Byte+Bit.swift    |  9 ---------
 .../Byte/BitPattern/Byte+Bit.Pattern.swift    | 10 ----------
 Sources/Byte/Byte.swift                       | 19 +++++++++++++++++++
 3 files changed, 19 insertions(+), 19 deletions(-)
 delete mode 100644 Sources/Byte/Absorbed/swift-byte-bit/Byte+Bit.swift
 delete mode 100644 Sources/Byte/BitPattern/Byte+Bit.Pattern.swift

diff --git a/Sources/Byte/Absorbed/swift-byte-bit/Byte+Bit.swift b/Sources/Byte/Absorbed/swift-byte-bit/Byte+Bit.swift
deleted file mode 100644
index f1e1b6a..0000000
--- a/Sources/Byte/Absorbed/swift-byte-bit/Byte+Bit.swift
+++ /dev/null
@@ -1,9 +0,0 @@
-public import Bit
-
-extension Byte {
-    @inlinable
-    public subscript(_ index: Int) -> Bit {
-        precondition((0..<UInt8.bitWidth).contains(index), "Bit index out of bounds")
-        return (underlying >> UInt8(index)) & 1 == 1 ? Bit.one : Bit.zero
-    }
-}
diff --git a/Sources/Byte/BitPattern/Byte+Bit.Pattern.swift b/Sources/Byte/BitPattern/Byte+Bit.Pattern.swift
deleted file mode 100644
index 9a2e9d0..0000000
--- a/Sources/Byte/BitPattern/Byte+Bit.Pattern.swift
+++ /dev/null
@@ -1,10 +0,0 @@
-#if BitPattern
-    public import Bit_Pattern
-
-    extension Byte {
-        @inlinable
-        public var bits: Bit.Pattern<UInt8>.Mask {
-            Bit.Pattern<UInt8>.Mask(underlying)
-        }
-    }
-#endif
diff --git a/Sources/Byte/Byte.swift b/Sources/Byte/Byte.swift
index 06771d0..89ec2c2 100644
--- a/Sources/Byte/Byte.swift
+++ b/Sources/Byte/Byte.swift
@@ -32,3 +32,22 @@ extension Byte {
 extension Byte: Swift.Equatable {}
 
 extension Byte: Swift.Hashable {}
+
+extension Byte {
+    @inlinable
+    public subscript(_ index: Int) -> Bit {
+        precondition((0..<UInt8.bitWidth).contains(index), "Bit index out of bounds")
+        return (underlying >> UInt8(index)) & 1 == 1 ? Bit.one : Bit.zero
+    }
+}
+
+#if BitPattern
+    public import Bit_Pattern
+
+    extension Byte {
+        @inlinable
+        public var bits: Bit.Pattern<UInt8>.Mask {
+            Bit.Pattern<UInt8>.Mask(underlying)
+        }
+    }
+#endif
-- 
