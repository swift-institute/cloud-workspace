Subject: [PATCH] compound suite name: narrative suites move into extension
 <Type> named after their test file, nested suites into extension
 <Type>.<Parent> (overnight/compound-suites.py); parse-checked; builds pending
 (coenttb/work#242)

---
 Tests/RFC 6750 Tests/RFC_6750 Tests.swift          | 14 ++++++++------
 .../RFC_6750.Bearer.B64Token Tests.swift           | 14 ++++++++------
 2 files changed, 16 insertions(+), 12 deletions(-)

diff --git a/Tests/RFC 6750 Tests/RFC_6750 Tests.swift b/Tests/RFC 6750 Tests/RFC_6750 Tests.swift
index 6504bf3..6a32032 100644
--- a/Tests/RFC 6750 Tests/RFC_6750 Tests.swift	
+++ b/Tests/RFC 6750 Tests/RFC_6750 Tests.swift	
@@ -2,14 +2,16 @@ import Testing
 
 @testable import RFC_6750
 
-@Suite
-struct `RFC 6750 Tests` {
-    @Suite struct Unit {}
-    @Suite struct `Edge Case` {}
-    @Suite struct Integration {}
+extension RFC_6750 {
+    @Suite
+    struct `RFC 6750 Tests` {
+        @Suite struct Unit {}
+        @Suite struct `Edge Case` {}
+        @Suite struct Integration {}
+    }
 }
 
-extension `RFC 6750 Tests`.Unit {
+extension RFC_6750.`RFC 6750 Tests`.Unit {
     @Test
     func `Bearer token creation and validation`() throws {
         let bearer = try RFC_6750.Bearer(token: "mF_9.B5f-4.1JqM")
diff --git a/Tests/RFC 6750 Tests/RFC_6750.Bearer.B64Token Tests.swift b/Tests/RFC 6750 Tests/RFC_6750.Bearer.B64Token Tests.swift
