From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 07:06:18 +0000
Subject: [PATCH 6/8] Revert Sources/Representable Macro to origin/main: macro
 targets aren't type-checkable outside the build (coenttb/work#242)

---
 Sources/Representable Macro/Representable.swift | 2 +-
 Sources/Representable Macro/exports.swift       | 1 -
 2 files changed, 1 insertion(+), 2 deletions(-)
 delete mode 100644 Sources/Representable Macro/exports.swift

diff --git a/Sources/Representable Macro/Representable.swift b/Sources/Representable Macro/Representable.swift
index e73a2e9..5666d6a 100644
--- a/Sources/Representable Macro/Representable.swift	
+++ b/Sources/Representable Macro/Representable.swift	
@@ -1,4 +1,4 @@
-import Finite_Macro
+@_exported import Finite_Macro
 @attached(peer, names: suffixed(Index))
 @attached(member, names: named(Index), named(index), named(tabulate), named(values))
 public macro Representable() = #externalMacro(module: "Representable_Macro_Plugin", type: "Derive")
diff --git a/Sources/Representable Macro/exports.swift b/Sources/Representable Macro/exports.swift
deleted file mode 100644
index e2a085d..0000000
--- a/Sources/Representable Macro/exports.swift	
+++ /dev/null
@@ -1 +0,0 @@
-@_exported public import Finite_Macro
