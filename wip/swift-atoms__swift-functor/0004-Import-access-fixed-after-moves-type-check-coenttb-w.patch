From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:42:33 +0000
Subject: [PATCH 4/4] Import access fixed after moves (type-check,
 coenttb/work#242)

---
 Sources/Functor Base Macro/BaseFunctor.swift    | 2 +-
 Sources/Representable Macro/Representable.swift | 2 +-
 Sources/Traversable Macro/Traversable.swift     | 2 +-
 3 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/Sources/Functor Base Macro/BaseFunctor.swift b/Sources/Functor Base Macro/BaseFunctor.swift
index 8875aae..e6194d7 100644
--- a/Sources/Functor Base Macro/BaseFunctor.swift	
+++ b/Sources/Functor Base Macro/BaseFunctor.swift	
@@ -1,4 +1,4 @@
-public import Functor_Macro
+import Functor_Macro
 
 @attached(member, names: arbitrary)
 public macro FunctorBase() =
diff --git a/Sources/Representable Macro/Representable.swift b/Sources/Representable Macro/Representable.swift
index 2836e37..e73a2e9 100644
--- a/Sources/Representable Macro/Representable.swift	
+++ b/Sources/Representable Macro/Representable.swift	
@@ -1,4 +1,4 @@
-public import Finite_Macro
+import Finite_Macro
 @attached(peer, names: suffixed(Index))
 @attached(member, names: named(Index), named(index), named(tabulate), named(values))
 public macro Representable() = #externalMacro(module: "Representable_Macro_Plugin", type: "Derive")
diff --git a/Sources/Traversable Macro/Traversable.swift b/Sources/Traversable Macro/Traversable.swift
index 6b929e5..c603009 100644
--- a/Sources/Traversable Macro/Traversable.swift	
+++ b/Sources/Traversable Macro/Traversable.swift	
@@ -1,3 +1,3 @@
-public import Traversal_Support
+import Traversal_Support
 @attached(member, names: named(traverseOptional), named(traverseResult), named(traverseSequential))
 public macro Traversable() = #externalMacro(module: "Traversable_Macro_Plugin", type: "Derive")
