From e684fe861c5d5bedcb481d1e8b7fa590795a5be9 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 07:06:18 +0000
Subject: [PATCH 7/8] Revert Sources/Traversable Macro to origin/main: macro
 targets aren't type-checkable outside the build (coenttb/work#242)

---
 Sources/Traversable Macro/Traversable.swift | 2 +-
 Sources/Traversable Macro/exports.swift     | 1 -
 2 files changed, 1 insertion(+), 2 deletions(-)
 delete mode 100644 Sources/Traversable Macro/exports.swift

diff --git a/Sources/Traversable Macro/Traversable.swift b/Sources/Traversable Macro/Traversable.swift
index c603009..143eaf7 100644
--- a/Sources/Traversable Macro/Traversable.swift	
+++ b/Sources/Traversable Macro/Traversable.swift	
@@ -1,3 +1,3 @@
-import Traversal_Support
+@_exported import Traversal_Support
 @attached(member, names: named(traverseOptional), named(traverseResult), named(traverseSequential))
 public macro Traversable() = #externalMacro(module: "Traversable_Macro_Plugin", type: "Derive")
diff --git a/Sources/Traversable Macro/exports.swift b/Sources/Traversable Macro/exports.swift
deleted file mode 100644
index 67c23e6..0000000
--- a/Sources/Traversable Macro/exports.swift	
+++ /dev/null
@@ -1 +0,0 @@
-@_exported public import Traversal_Support
-- 
