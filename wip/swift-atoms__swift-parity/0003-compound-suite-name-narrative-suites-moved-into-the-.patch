Subject: [PATCH 3/6] compound suite name: narrative suites moved into the test
 file's namespace or the parent suite's extension (names and test IDs kept;
 tests only; Linux x86_64, Swift 6.4.2) (coenttb/work#242)

---
 .../Optic Iso Tests.swift                        | 16 +++++++++-------
 Tests/Parity Tests/Parity Pair Tests.swift       | 14 ++++++++------
 2 files changed, 17 insertions(+), 13 deletions(-)

diff --git a/Tests/Parity Algebra Integration Tests/Optic Iso Tests.swift b/Tests/Parity Algebra Integration Tests/Optic Iso Tests.swift
index ccb911a..ca5a814 100644
--- a/Tests/Parity Algebra Integration Tests/Optic Iso Tests.swift	
+++ b/Tests/Parity Algebra Integration Tests/Optic Iso Tests.swift	
@@ -3,14 +3,16 @@
     import Optic
     import Testing
 
-    @Suite
-    struct `Optic Iso Tests` {
-        @Suite struct Unit {}
-        @Suite struct `Edge Case` {}
-        @Suite struct Integration {}
-    }
+extension `Optic Iso Tests`.`Optic Iso Tests` {
+        @Suite
+        struct `Optic Iso Tests` {
+            @Suite struct Unit {}
+            @Suite struct `Edge Case` {}
+            @Suite struct Integration {}
+        }
+}
 
-    extension `Optic Iso Tests`.Unit {
+    extension `Optic Iso Tests`.`Optic Iso Tests`.Unit {
 
         @Test
         func `Optic Iso round-trips`() {
