Subject: [PATCH] compound suite name: narrative suites move into extension
 <Type> named after their test file, nested suites into extension
 <Type>.<Parent> (overnight/compound-suites.py); parse-checked; builds pending
 (coenttb/work#242)

---
 Tests/Parity Tests/Parity Tests.swift | 13 ++++++++++---
 1 file changed, 10 insertions(+), 3 deletions(-)

diff --git a/Tests/Parity Tests/Parity Tests.swift b/Tests/Parity Tests/Parity Tests.swift
index 6957803..9c2aa41 100644
--- a/Tests/Parity Tests/Parity Tests.swift	
+++ b/Tests/Parity Tests/Parity Tests.swift	
@@ -2,14 +2,21 @@ import Pair
 import Parity
 import Testing
 
-@Suite
-struct `Parity values resolve through pairs` {
+extension Parity {
+    @Suite
+    struct `Parity values resolve through pairs` {
+    }
+}
+
+extension Parity.`Parity values resolve through pairs` {
     @Suite struct `Parity values resolve through pairs in their public representations` {}
+
     @Suite struct `No additional parity edge cases are defined` {}
+
     @Suite struct `No additional parity integration cases are defined` {}
 }
 
-extension `Parity values resolve through pairs`.`Parity values resolve through pairs in their public representations` {
+extension Parity.`Parity values resolve through pairs`.`Parity values resolve through pairs in their public representations` {
 
     @Test
     func `Parity Value typealias resolves through Pair`() {
