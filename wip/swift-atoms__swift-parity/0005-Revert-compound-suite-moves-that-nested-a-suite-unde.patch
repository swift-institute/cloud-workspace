index 6f50fcc..bf7b556 100644
--- a/Tests/Parity Tests/Parity Pair Tests.swift	
+++ b/Tests/Parity Tests/Parity Pair Tests.swift	
@@ -1,16 +1,14 @@
 import Parity
 import Testing
 
-extension `Parity Pair Tests`.`Parity Pair Tests` {
-    @Suite
-    struct `Parity Pair Tests` {
-        @Suite struct Unit {}
-        @Suite struct `Edge Case` {}
-        @Suite struct Integration {}
-    }
+@Suite
+struct `Parity Pair Tests` {
+    @Suite struct Unit {}
+    @Suite struct `Edge Case` {}
+    @Suite struct Integration {}
 }
 
-extension `Parity Pair Tests`.`Parity Pair Tests`.Unit {
+extension `Parity Pair Tests`.Unit {
 
     @Test
     func `Parity Value typealias resolves through Pair`() {
