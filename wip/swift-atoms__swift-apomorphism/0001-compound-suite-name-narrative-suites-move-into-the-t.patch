From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 19:33:56 +0000
Subject: [PATCH 1/3] compound suite name: narrative suites move into the test
 module's namespace `<File> Tests` (#239's layout), nested suites into
 extension <Path>.<Parent> (overnight/compound-suites.py); parse-checked;
 builds pending (coenttb/work#242)

---
 .../Boundary Tests.swift                      | 28 +++++++++++--------
 1 file changed, 16 insertions(+), 12 deletions(-)

diff --git a/Tests/Apomorphism Macro Tests/Boundary Tests.swift b/Tests/Apomorphism Macro Tests/Boundary Tests.swift
index b6b63f8..040f6eb 100644
--- a/Tests/Apomorphism Macro Tests/Boundary Tests.swift	
+++ b/Tests/Apomorphism Macro Tests/Boundary Tests.swift	
@@ -19,19 +19,23 @@ private func depth(_ value: Count) -> Int {
     }
 }
 
-@Suite
-struct `Apomorphism boundaries` {
-    @Test
-    func `a seed that stops at once unfolds to the base case`() {
-        let value = Count.apomorphism(0) { _ -> Count.Base<Either<Count, Int>> in .zero }
-        #expect(depth(value) == 0)
-    }
+enum `Boundary Tests` {}
+
+extension `Boundary Tests` {
+    @Suite
+    struct `Apomorphism boundaries` {
+        @Test
+        func `a seed that stops at once unfolds to the base case`() {
+            let value = Count.apomorphism(0) { _ -> Count.Base<Either<Count, Int>> in .zero }
+            #expect(depth(value) == 0)
+        }
 
-    @Test
-    func `seeds keep unfolding until the coalgebra stops`() {
-        let value = Count.apomorphism(5) { seed -> Count.Base<Either<Count, Int>> in
-            seed == 0 ? .zero : .successor(.right(seed - 1))
+        @Test
+        func `seeds keep unfolding until the coalgebra stops`() {
+            let value = Count.apomorphism(5) { seed -> Count.Base<Either<Count, Int>> in
+                seed == 0 ? .zero : .successor(.right(seed - 1))
+            }
+            #expect(depth(value) == 5)
         }
-        #expect(depth(value) == 5)
     }
 }
