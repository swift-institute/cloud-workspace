From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 07:06:17 +0000
Subject: [PATCH 4/4] Revert Sources/Apomorphism Macro to origin/main: macro
 targets aren't type-checkable outside the build (coenttb/work#242)

---
 Sources/Apomorphism Macro/Apomorphism.swift | 2 +-
 Sources/Apomorphism Macro/exports.swift     | 1 -
 2 files changed, 1 insertion(+), 2 deletions(-)
 delete mode 100644 Sources/Apomorphism Macro/exports.swift

diff --git a/Sources/Apomorphism Macro/Apomorphism.swift b/Sources/Apomorphism Macro/Apomorphism.swift
index 8601537..f70a8e8 100644
--- a/Sources/Apomorphism Macro/Apomorphism.swift	
+++ b/Sources/Apomorphism Macro/Apomorphism.swift	
@@ -1,4 +1,4 @@
-import Either
+@_exported import Either
 
 @attached(member, names: arbitrary)
 public macro Apomorphism() = #externalMacro(module: "Apomorphism_Macro_Plugin", type: "Macro")
diff --git a/Sources/Apomorphism Macro/exports.swift b/Sources/Apomorphism Macro/exports.swift
deleted file mode 100644
index 9a5ecd2..0000000
--- a/Sources/Apomorphism Macro/exports.swift	
+++ /dev/null
@@ -1 +0,0 @@
-@_exported public import Either
