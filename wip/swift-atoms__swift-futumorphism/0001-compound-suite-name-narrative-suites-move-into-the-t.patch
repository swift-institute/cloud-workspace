From ab7e13583fa85e6937bac131c9bbeb3e53b5e94d Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 19:34:01 +0000
Subject: [PATCH] compound suite name: narrative suites move into the test
 module's namespace `<File> Tests` (#239's layout), nested suites into
 extension <Path>.<Parent> (overnight/compound-suites.py); parse-checked;
 builds pending (coenttb/work#242)

---
 .../Boundary Tests.swift                      | 28 +++++++++++--------
 1 file changed, 16 insertions(+), 12 deletions(-)

diff --git a/Tests/Futumorphism Macro Tests/Boundary Tests.swift b/Tests/Futumorphism Macro Tests/Boundary Tests.swift
index 244e60e..d47f825 100644
--- a/Tests/Futumorphism Macro Tests/Boundary Tests.swift	
+++ b/Tests/Futumorphism Macro Tests/Boundary Tests.swift	
@@ -20,19 +20,23 @@ private func depth(_ value: Count) -> Int {
     }
 }
 
-@Suite
-struct `Futumorphism boundaries` {
-    @Test
-    func `a seed that stops at once unfolds to the base case`() {
-        let value = Count.futumorphism(0) { _ -> Count.Base<Count.Free<Int>> in .zero }
-        #expect(depth(value) == 0)
-    }
+enum `Boundary Tests` {}
+
+extension `Boundary Tests` {
+    @Suite
+    struct `Futumorphism boundaries` {
+        @Test
+        func `a seed that stops at once unfolds to the base case`() {
+            let value = Count.futumorphism(0) { _ -> Count.Base<Count.Free<Int>> in .zero }
+            #expect(depth(value) == 0)
+        }
 
-    @Test
-    func `plain seeds unfold one layer at a time`() {
-        let value = Count.futumorphism(5) { seed -> Count.Base<Count.Free<Int>> in
-            seed == 0 ? .zero : .successor(.pure(seed - 1))
+        @Test
+        func `plain seeds unfold one layer at a time`() {
+            let value = Count.futumorphism(5) { seed -> Count.Base<Count.Free<Int>> in
+                seed == 0 ? .zero : .successor(.pure(seed - 1))
+            }
+            #expect(depth(value) == 5)
         }
-        #expect(depth(value) == 5)
     }
 }
