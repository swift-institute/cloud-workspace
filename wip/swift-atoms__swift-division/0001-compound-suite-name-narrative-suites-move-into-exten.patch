Subject: [PATCH] compound suite name: narrative suites move into extension
 <Type> named after their test file, nested suites into extension
 <Type>.<Parent> (overnight/compound-suites.py); parse-checked; builds pending
 (coenttb/work#242)

---
 Tests/Division Tests/Division Tests.swift                 | 8 +++++---
 .../Division Tests/Division.Rounded Migration Tests.swift | 6 ++++++
 2 files changed, 11 insertions(+), 3 deletions(-)

diff --git a/Tests/Division Tests/Division Tests.swift b/Tests/Division Tests/Division Tests.swift
index ea17484..88208f3 100644
--- a/Tests/Division Tests/Division Tests.swift	
+++ b/Tests/Division Tests/Division Tests.swift	
@@ -2,10 +2,12 @@ import Division
 import Polarity
 import Testing
 
-@Suite
-struct `Integer division preserves quotient and remainder invariants` {}
+extension Division {
+    @Suite
+    struct `Integer division preserves quotient and remainder invariants` {}
+}
 
-extension `Integer division preserves quotient and remainder invariants` {
+extension Division.`Integer division preserves quotient and remainder invariants` {
     @Test
     func `Int8 Euclidean division agrees with a wider integer oracle`() throws {
         for dividend in Int16(-128)...127 {
diff --git a/Tests/Division Tests/Division.Rounded Migration Tests.swift b/Tests/Division Tests/Division.Rounded Migration Tests.swift
index 0e2e71d..a6efbb2 100644
--- a/Tests/Division Tests/Division.Rounded Migration Tests.swift	
+++ b/Tests/Division Tests/Division.Rounded Migration Tests.swift	
@@ -3,9 +3,15 @@ import Testing
 
 @Suite
 struct `Integer division applies rounding policies` {
+}
+
+extension `Integer division applies rounding policies` {
     @Suite struct `Division preserves quotient remainder and rounding relationships` {}
+
     @Suite struct `Negative operands follow the requested rounding direction` {}
+
     @Suite struct `No integration cases are defined` {}
+
     @Suite(.serialized) struct `No performance cases are defined` {}
 }
 
