diff --git a/Sources/Division/Division.Error.swift b/Sources/Division/Division.Error.swift
new file mode 100644
index 0000000..a1b8038
--- /dev/null
+++ b/Sources/Division/Division.Error.swift
@@ -0,0 +1,14 @@
+public import Addition
+public import Polarity
+public import Subtraction
+public import Rounding
+
+
+extension Division {
+    public enum Error: Swift::Error, Hashable, Sendable {
+        case zero
+        case negative
+        case overflow
+        case inexact
+    }
+}
diff --git a/Sources/Division/Division.Signed.swift b/Sources/Division/Division.Signed.swift
new file mode 100644
index 0000000..99a6cf3
--- /dev/null
+++ b/Sources/Division/Division.Signed.swift
@@ -0,0 +1,9 @@
+public import Addition
+public import Polarity
+public import Subtraction
+public import Rounding
+
+
+extension Division {
+    public enum Signed {}
+}
diff --git a/Sources/Division/Division.swift b/Sources/Division/Division.swift
