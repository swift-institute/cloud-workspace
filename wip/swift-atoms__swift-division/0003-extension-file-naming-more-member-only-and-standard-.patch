From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 01:37:26 +0000
Subject: [PATCH 3/8] extension file naming: more member-only and
 standard-library extension files merge into their type's file; single type
 per file: more additional types move to their own files
 (merge-extension-files.py, split-types.py); parse-checked; root build pending
 (coenttb/work#242)

---
 Sources/Division/Division.Error.swift  | 14 ++++++++++++++
 Sources/Division/Division.Signed.swift |  9 +++++++++
 Sources/Division/Division.swift        |  8 +-------
 3 files changed, 24 insertions(+), 7 deletions(-)
 create mode 100644 Sources/Division/Division.Error.swift
 create mode 100644 Sources/Division/Division.Signed.swift

diff --git a/Sources/Division/Division.Error.swift b/Sources/Division/Division.Error.swift
new file mode 100644
index 0000000..a1b8038
--- /dev/null
+++ b/Sources/Division/Division.Error.swift
@@ -0,0 +1,14 @@
+public import Addition
+public import Polarity
+public import Subtraction
+public import Rounding
+
+
+extension Division {
+    public enum Error: Swift::Error, Hashable, Sendable {
+        case zero
+        case negative
+        case overflow
+        case inexact
+    }
+}
diff --git a/Sources/Division/Division.Signed.swift b/Sources/Division/Division.Signed.swift
new file mode 100644
index 0000000..99a6cf3
--- /dev/null
+++ b/Sources/Division/Division.Signed.swift
@@ -0,0 +1,9 @@
+public import Addition
+public import Polarity
+public import Subtraction
+public import Rounding
+
+
+extension Division {
+    public enum Signed {}
+}
diff --git a/Sources/Division/Division.swift b/Sources/Division/Division.swift
index 3df5d9f..a2ef494 100644
--- a/Sources/Division/Division.swift
+++ b/Sources/Division/Division.swift
@@ -6,12 +6,7 @@ public import Rounding
 public enum Division {}
 
 extension Division {
-    public enum Error: Swift::Error, Hashable, Sendable {
-        case zero
-        case negative
-        case overflow
-        case inexact
-    }
+
 
     @inlinable
     public static func quotient<Value: FixedWidthInteger>(
@@ -50,7 +45,6 @@ extension Division {
         } catch { throw .overflow }
     }
 
-    public enum Signed {}
 }
 
 extension Division.Signed {
