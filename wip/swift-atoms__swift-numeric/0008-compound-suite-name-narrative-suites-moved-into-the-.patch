Subject: [PATCH 08/12] compound suite name: narrative suites moved into the
 test file's namespace or the parent suite's extension (names and test IDs
 kept; tests only; Linux x86_64, Swift 6.4.2) (coenttb/work#242)

---
 .../Complex Numeric Relaxed Tests.swift                   | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/Tests/Numeric Complex Integration Tests/Complex Numeric Relaxed Tests.swift b/Tests/Numeric Complex Integration Tests/Complex Numeric Relaxed Tests.swift
index 91cf2c6..1c6b1da 100644
--- a/Tests/Numeric Complex Integration Tests/Complex Numeric Relaxed Tests.swift	
+++ b/Tests/Numeric Complex Integration Tests/Complex Numeric Relaxed Tests.swift	
@@ -3,10 +3,12 @@
     import Numeric
     import Testing
 
-    @Suite
-    struct `Complex Numeric Relaxed Tests` {}
+extension `Complex Numeric Relaxed Tests`.`Complex Numeric Relaxed Tests` {
+        @Suite
+        struct `Complex Numeric Relaxed Tests` {}
+}
 
-    extension `Complex Numeric Relaxed Tests` {
+    extension `Complex Numeric Relaxed Tests`.`Complex Numeric Relaxed Tests` {
 
         @Test
         func `double operations use relaxed scalar arithmetic`() {
