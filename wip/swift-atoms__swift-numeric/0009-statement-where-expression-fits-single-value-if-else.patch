From ef60b8d8f278b368b48dbaecfec8e13edb08870a Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:35:29 +0000
Subject: [PATCH 09/11] statement where expression fits: single-value if/else
 chains written as if expressions (type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 Sources/Numeric/Numeric.Sign.swift | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/Sources/Numeric/Numeric.Sign.swift b/Sources/Numeric/Numeric.Sign.swift
index 8b7e319..1601558 100644
--- a/Sources/Numeric/Numeric.Sign.swift
+++ b/Sources/Numeric/Numeric.Sign.swift
@@ -55,12 +55,12 @@ extension Numeric.Sign {
 
     @inlinable
     public init<T: Comparable & AdditiveArithmetic>(_ value: T) {
-        if value > .zero {
-            self = .positive
+        self = if value > .zero {
+            .positive
         } else if value < .zero {
-            self = .negative
+            .negative
         } else {
-            self = .zero
+            .zero
         }
     }
 }
