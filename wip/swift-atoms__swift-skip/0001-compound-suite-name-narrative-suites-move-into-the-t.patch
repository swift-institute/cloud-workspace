From 7af7ea20decb626a81d81fe636d7e58e7020e940 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 19:34:08 +0000
Subject: [PATCH] compound suite name: narrative suites move into the test
 module's namespace `<File> Tests` (#239's layout), nested suites into
 extension <Path>.<Parent> (overnight/compound-suites.py); parse-checked;
 builds pending (coenttb/work#242)

---
 Tests/Skip Tests/Skip Tests.swift | 34 +++++++++++++++++--------------
 1 file changed, 19 insertions(+), 15 deletions(-)

diff --git a/Tests/Skip Tests/Skip Tests.swift b/Tests/Skip Tests/Skip Tests.swift
index ee7d821..1b264f7 100644
--- a/Tests/Skip Tests/Skip Tests.swift	
+++ b/Tests/Skip Tests/Skip Tests.swift	
@@ -1,22 +1,26 @@
 import Skip
 import Testing
 
-@Suite
-struct `Skip discards values independently of parsing` {
+enum `Skip Tests` {}
 
-    @Test
-    func `a scoped value is retained and a linear value is destroyed`() {
-        let lifetime = Lifetime()
-        let skip = Skip::Skip<Span<Int>, Token>()
-        let values = [42]
-        let result = skip(values.span, Token(lifetime: lifetime))
-        #expect(result[0] == 42)
-        #expect(lifetime.destroyed == 1)
-    }
+extension `Skip Tests` {
+    @Suite
+    struct `Skip discards values independently of parsing` {
+
+        @Test
+        func `a scoped value is retained and a linear value is destroyed`() {
+            let lifetime = Lifetime()
+            let skip = Skip::Skip<Span<Int>, Token>()
+            let values = [42]
+            let result = skip(values.span, Token(lifetime: lifetime))
+            #expect(result[0] == 42)
+            #expect(lifetime.destroyed == 1)
+        }
 
-    private final class Lifetime { var destroyed = 0 }
-    private struct Token: ~Copyable {
-        let lifetime: Lifetime
-        deinit { lifetime.destroyed += 1 }
+        private final class Lifetime { var destroyed = 0 }
+        private struct Token: ~Copyable {
+            let lifetime: Lifetime
+            deinit { lifetime.destroyed += 1 }
+        }
     }
 }
