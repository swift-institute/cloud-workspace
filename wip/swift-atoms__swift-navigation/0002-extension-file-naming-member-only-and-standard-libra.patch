From fe75c0689f5cf6fa7def7b7560b5e53ce72a1654 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 20:52:45 +0000
Subject: [PATCH 2/2] extension file naming: member-only and
 standard-library-conformance extension files merge into their type's own file
 (overnight/merge-extension-files.py); single type per file: additional types
 move to their own <Parent>.<Name>.swift inside the container's extension
 (overnight/split-types.py); parse-checked; builds pending (coenttb/work#242)

---
 Sources/Navigation/Navigation.Identity.swift      |  6 ------
 ...ation.Stack+Swift.RandomAccessCollection.swift | 14 --------------
 Sources/Navigation/Navigation.Stack.swift         | 15 +++++++++++++++
 Sources/Navigation/Navigation.swift               |  7 +++++++
 4 files changed, 22 insertions(+), 20 deletions(-)
 delete mode 100644 Sources/Navigation/Navigation.Identity.swift
 delete mode 100644 Sources/Navigation/Navigation.Stack+Swift.RandomAccessCollection.swift

diff --git a/Sources/Navigation/Navigation.Identity.swift b/Sources/Navigation/Navigation.Identity.swift
deleted file mode 100644
index 0180b8b..0000000
--- a/Sources/Navigation/Navigation.Identity.swift
+++ /dev/null
@@ -1,6 +0,0 @@
-public import Tagged
-
-extension Navigation {
-
-    public typealias Identity = Tagged<Navigation, UInt64>
-}
diff --git a/Sources/Navigation/Navigation.Stack+Swift.RandomAccessCollection.swift b/Sources/Navigation/Navigation.Stack+Swift.RandomAccessCollection.swift
deleted file mode 100644
index 7a8a993..0000000
--- a/Sources/Navigation/Navigation.Stack+Swift.RandomAccessCollection.swift
+++ /dev/null
@@ -1,14 +0,0 @@
-extension Navigation.Stack: Swift.RandomAccessCollection {
-
-    public typealias Element = Navigation.Destination<Value>
-
-    public typealias Index = Int
-
-    public var startIndex: Int { placed.startIndex }
-
-    public var endIndex: Int { placed.endIndex }
-
-    public subscript(position: Int) -> Navigation.Destination<Value> {
-        placed[position]
-    }
-}
diff --git a/Sources/Navigation/Navigation.Stack.swift b/Sources/Navigation/Navigation.Stack.swift
index 26d6045..2489bf8 100644
--- a/Sources/Navigation/Navigation.Stack.swift
+++ b/Sources/Navigation/Navigation.Stack.swift
@@ -69,3 +69,18 @@ extension Navigation.Stack: Swift.Sendable where Value: Swift.Sendable {}
 extension Navigation.Stack: Swift.Equatable where Value: Swift.Equatable {}
 
 extension Navigation.Stack: Swift.Hashable where Value: Swift.Hashable {}
+
+extension Navigation.Stack: Swift.RandomAccessCollection {
+
+    public typealias Element = Navigation.Destination<Value>
+
+    public typealias Index = Int
+
+    public var startIndex: Int { placed.startIndex }
+
+    public var endIndex: Int { placed.endIndex }
+
+    public subscript(position: Int) -> Navigation.Destination<Value> {
+        placed[position]
+    }
+}
diff --git a/Sources/Navigation/Navigation.swift b/Sources/Navigation/Navigation.swift
index 6d61a48..afaae26 100644
--- a/Sources/Navigation/Navigation.swift
+++ b/Sources/Navigation/Navigation.swift
@@ -1 +1,8 @@
+public import Tagged
+
 public enum Navigation {}
+
+extension Navigation {
+
+    public typealias Identity = Tagged<Navigation, UInt64>
+}
