@@ -0,0 +1,60 @@
+public import Cursor
+import Parser
+
+
+extension W3C_XML.Parse {
+    public struct ProcessingInstruction<Input: Cursor.`Protocol`>: Parser::Parsing, Sendable
+    where Input: Sendable, Input.Element == Byte, Input.Failure == Never {
+
+        public typealias Output = W3C_XML.Instruction
+        public typealias Failure = W3C_XML.Parse.Error
+
+        @inlinable
+        public init() {}
+
+        @inlinable
+        public func parse(_ input: inout Input) throws(Failure) -> Output {
+
+            try expectLiteral(&input, "<?")
+
+            let target = try Name<Input>().parse(&input)
+
+            if target.qualified.lowercased() == "xml" {
+                throw .expected("processing instruction target (not 'xml')")
+            }
+
+            var data: String? = nil
+
+            if let byte = input.xmlPeek(), W3C_XML.isWhitespace(byte) {
+                Whitespace<Input>().parse(&input)
+
+                var bytes: [Byte] = []
+
+                while true {
+                    guard let byte = input.xmlPeek() else {
+                        throw .unexpectedEndOfInput(expected: "?>")
+                    }
+
+                    if byte == ASCII.Code.questionMark.byte {
+                        _ = input.next()
+                        if input.xmlPeek() == ASCII.Code.greaterThanSign.byte {
+                            _ = input.next()
+                            if !bytes.isEmpty {
+                                data = String(decoding: bytes, as: UTF8.self)
+                            }
+                            return W3C_XML.Instruction(target: target.qualified, data: data)
+                        }
+
+                        bytes.append(ASCII.Code.questionMark.byte)
+                        continue
+                    }
+                    bytes.append(try input.xmlTake(expected: "character"))
+                }
+            }
+
+            try expectLiteral(&input, "?>")
+
+            return W3C_XML.Instruction(target: target.qualified, data: nil)
+        }
+    }
+}
diff --git a/Sources/W3C XML/W3C_XML.Parse.Reference.swift b/Sources/W3C XML/W3C_XML.Parse.Reference.swift
new file mode 100644
index 0000000..55ec5ab
--- /dev/null
+++ b/Sources/W3C XML/W3C_XML.Parse.Reference.swift	
@@ -0,0 +1,107 @@
+import ASCII
+import Byte
+public import Cursor
+import Parser
+
+
+extension W3C_XML.Parse {
+    public struct Reference<Input: Cursor.`Protocol`>: Parser::Parsing, Sendable
+    where Input: Sendable, Input.Element == Byte, Input.Failure == Never {
+
+        public typealias Output = String
+        public typealias Failure = W3C_XML.Parse.Error
+
+        @inlinable
+        public init() {}
+
+        @inlinable
+        public func parse(_ input: inout Input) throws(Failure) -> Output {
+
+            guard input.xmlPeek() == ASCII.Code.ampersand.byte else {
+                throw .expected("&")
+            }
+            _ = input.next()
+
+            guard let next = input.xmlPeek() else {
+                throw .unexpectedEndOfInput(expected: "entity or character reference")
+            }
+
+            guard next == ASCII.Code.numberSign.byte else {
+
+                return try parseEntityRef(&input)
+            }
+            _ = input.next()
+            return try parseCharRef(&input)
+        }
+
+        @usableFromInline
+        func parseCharRef(_ input: inout Input) throws(Failure) -> String {
+            var isHex = false
+
+            if input.xmlPeek() == ASCII.Code.x.byte || input.xmlPeek() == ASCII.Code.X.byte {
+                isHex = true
+                _ = input.next()
+            }
+
+            var digits: [Byte] = []
+            while let byte = input.xmlPeek(), byte != ASCII.Code.semicolon.byte {
+                digits.append(byte)
+                _ = input.next()
+            }
+
+            guard !digits.isEmpty else {
+                throw .invalidCharacterReference(isHex ? "&#x;" : "&#;")
+            }
+
+            var slice = digits[...]
+            let value: UInt32
+            do {
+                if isHex {
+                    value = try ASCII.Hexadecimal.Parser<ArraySlice<Byte>, UInt32>().parse(&slice)
+                } else {
+                    value = try ASCII.Decimal.Parser<ArraySlice<Byte>, UInt32>().parse(&slice)
+                }
+            } catch {
+
+                throw .invalidCharacterReference(isHex ? "&#x..." : "&#...")
+            }
+
+            guard slice.isEmpty else {
+                throw .invalidCharacterReference(isHex ? "&#x..." : "&#...")
+            }
+
+            guard input.xmlPeek() == ASCII.Code.semicolon.byte else {
+                throw .expected(";")
+            }
+            _ = input.next()
+
+            guard let scalar = Unicode.Scalar(value), W3C_XML.isChar(scalar) else {
+                throw .invalidCharacterReference("&#\(isHex ? "x" : "")\(value);")
+            }
+
+            return String(scalar)
+        }
+
+        @inlinable
+        package func parseEntityRef(_ input: inout Input) throws(Failure) -> String {
+
+            let name = try Name<Input>().parse(&input)
+
+            guard input.xmlPeek() == ASCII.Code.semicolon.byte else {
+                throw .expected(";")
+            }
+            _ = input.next()
+
+            switch name.qualified {
+            case "lt": return "<"
+            case "gt": return ">"
+            case "amp": return "&"
+            case "apos": return "'"
+            case "quot": return "\""
+
+            default:
+                throw .unknownEntity(name.qualified)
+            }
+        }
+    }
+}
