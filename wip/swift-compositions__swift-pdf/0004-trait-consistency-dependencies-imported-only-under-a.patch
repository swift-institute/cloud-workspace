From 4daff851487240d7986451a97d18b9fa995f0161 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:24:53 +0000
Subject: [PATCH 4/6] trait consistency: dependencies imported only under a
 trait get that trait's condition (runner repair; Linux x86_64, Swift 6.4.2)
 (coenttb/work#242)

---
 Package.swift | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/Package.swift b/Package.swift
index 047502c..ee88fde 100644
--- a/Package.swift
+++ b/Package.swift
@@ -38,8 +38,8 @@ let package = Package(
             dependencies: [
                 // Unconditional until SwiftPM resolves mixed trait requests
                 // (swift-institute/Issues#123); the code stays behind #if HTML.
-                .product(name: "HTML", package: "swift-html"),
-                .product(name: "PDF HTML Rendering", package: "swift-pdf-html-render"),
+                .product(name: "HTML", package: "swift-html", condition: .when(traits: ["HTML"])),
+                .product(name: "PDF HTML Rendering", package: "swift-pdf-html-render", condition: .when(traits: ["HTML"])),
                 .product(name: "File System", package: "swift-file-system"),
             ]
         ),
-- 
