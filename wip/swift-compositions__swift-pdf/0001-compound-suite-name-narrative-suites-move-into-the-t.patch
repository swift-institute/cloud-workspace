From 835bd7c422d28a4a80b6694f0e51c26be5f80ce3 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 19:34:24 +0000
Subject: [PATCH] compound suite name: narrative suites move into the test
 module's namespace `<File> Tests` (#239's layout), nested suites into
 extension <Path>.<Parent> (overnight/compound-suites.py); parse-checked;
 builds pending (coenttb/work#242)

---
 Tests/PDF Tests/PDF.Debug.Crash Tests.swift | 66 +++++++++++----------
 1 file changed, 35 insertions(+), 31 deletions(-)

diff --git a/Tests/PDF Tests/PDF.Debug.Crash Tests.swift b/Tests/PDF Tests/PDF.Debug.Crash Tests.swift
index 150ada3..7721805 100644
--- a/Tests/PDF Tests/PDF.Debug.Crash Tests.swift	
+++ b/Tests/PDF Tests/PDF.Debug.Crash Tests.swift	
@@ -1,42 +1,46 @@
 import PDF
 import Testing
 
-@Suite struct DebugCrashInvestigation {
+enum `PDF.Debug.Crash Tests` {}
 
-    @Test func fontCopyDestroyCycle() {
-        var font = PDF.Font.helvetica
-        for _ in 0..<100 {
-            font = font.bold
-            font = font.italic
-            font = font.regular
+extension `PDF.Debug.Crash Tests` {
+    @Suite struct DebugCrashInvestigation {
+
+        @Test func fontCopyDestroyCycle() {
+            var font = PDF.Font.helvetica
+            for _ in 0..<100 {
+                font = font.bold
+                font = font.italic
+                font = font.regular
+            }
+            #expect(font.weight == .regular)
         }
-        #expect(font.weight == .regular)
-    }
 
-    @Test func nestedInoutFontAssignment() {
-        struct Inner { var font: PDF.Font = .helvetica }
-        struct Middle { var style: Inner = .init() }
-        struct Outer { var pdf: Middle = .init() }
-        var context = Outer()
-        context.pdf.style.font = context.pdf.style.font.bold
-        #expect(context.pdf.style.font.weight == .bold)
-    }
+        @Test func nestedInoutFontAssignment() {
+            struct Inner { var font: PDF.Font = .helvetica }
+            struct Middle { var style: Inner = .init() }
+            struct Outer { var pdf: Middle = .init() }
+            var context = Outer()
+            context.pdf.style.font = context.pdf.style.font.bold
+            #expect(context.pdf.style.font.weight == .bold)
+        }
 
-    #if HTML
-        @Test func markdownPlain() {
-            let doc = PDF.Document(info: .init(title: "T", author: "T")) {
-                p { "Hello" }
+        #if HTML
+            @Test func markdownPlain() {
+                let doc = PDF.Document(info: .init(title: "T", author: "T")) {
+                    p { "Hello" }
+                }
+                #expect(doc.pages.count >= 1)
             }
-            #expect(doc.pages.count >= 1)
-        }
-    #endif
+        #endif
 
-    #if Markdown
-        @Test func markdownHeading() {
-            let doc = PDF.Document(info: .init(title: "T", author: "T")) {
-                Markdown { "# Heading" }
+        #if Markdown
+            @Test func markdownHeading() {
+                let doc = PDF.Document(info: .init(title: "T", author: "T")) {
+                    Markdown { "# Heading" }
+                }
+                #expect(doc.pages.count >= 1)
             }
-            #expect(doc.pages.count >= 1)
-        }
-    #endif
+        #endif
+    }
 }
