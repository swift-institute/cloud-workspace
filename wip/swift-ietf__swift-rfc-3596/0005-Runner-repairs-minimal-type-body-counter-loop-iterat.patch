Subject: [PATCH 05/10] Runner repairs: minimal type body, counter loop
 iteration, test display name string, swift protocol qualification, comment in
 source (overnight/apply-repairs.py); type-checked against the root build,
 directories that failed it left out (coenttb/work#242)

---
 Sources/RFC 3596/RFC_3596.IP6.ARPA.swift | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/Sources/RFC 3596/RFC_3596.IP6.ARPA.swift b/Sources/RFC 3596/RFC_3596.IP6.ARPA.swift
index 2b0d4f9..622a0dd 100644
--- a/Sources/RFC 3596/RFC_3596.IP6.ARPA.swift	
+++ b/Sources/RFC 3596/RFC_3596.IP6.ARPA.swift	
@@ -10,7 +10,6 @@ extension RFC_3596 {
     /// The format uses nibbles (4-bit values) in reverse order, separated
     /// by dots, followed by "ip6.arpa".
     public enum IP6 {
-        public enum ARPA {}
     }
 }
 
@@ -58,3 +57,6 @@ extension RFC_3596.IP6.ARPA {
         return nibbles.map(String.init).joined(separator: ".") + "." + suffix
     }
 }
+
+extension RFC_3596.IP6 {
+        public enum ARPA {}}
