From f9756696d2159da83845c90393c1b40ad8e5c849 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:27:43 +0000
Subject: [PATCH 10/10] minimal type body: more non-stored members moved into
 an extension of their type (batch 10; type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 Sources/RFC 3596/RFC_3596.IP6.ARPA.swift | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/Sources/RFC 3596/RFC_3596.IP6.ARPA.swift b/Sources/RFC 3596/RFC_3596.IP6.ARPA.swift
index 2b0d4f9..7643085 100644
--- a/Sources/RFC 3596/RFC_3596.IP6.ARPA.swift	
+++ b/Sources/RFC 3596/RFC_3596.IP6.ARPA.swift	
@@ -10,10 +10,13 @@ extension RFC_3596 {
     /// The format uses nibbles (4-bit values) in reverse order, separated
     /// by dots, followed by "ip6.arpa".
     public enum IP6 {
-        public enum ARPA {}
     }
 }
 
+extension RFC_3596.IP6 {
+    public enum ARPA {}
+}
+
 extension RFC_3596.IP6.ARPA {
     /// The suffix for IPv6 reverse DNS names
     public static let suffix = "ip6.arpa"
-- 
