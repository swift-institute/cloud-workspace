Date: Sat, 7 Nov 2026 23:31:25 +0000
Subject: [PATCH 8/8] Revert the minimal-body moves in files where they raised
 a rule over its ratchet limit (coenttb/work#242)

---
 Sources/RFC 3596/RFC_3596.IP6.ARPA.swift | 5 +----
 1 file changed, 1 insertion(+), 4 deletions(-)

diff --git a/Sources/RFC 3596/RFC_3596.IP6.ARPA.swift b/Sources/RFC 3596/RFC_3596.IP6.ARPA.swift
index 7643085..2b0d4f9 100644
--- a/Sources/RFC 3596/RFC_3596.IP6.ARPA.swift	
+++ b/Sources/RFC 3596/RFC_3596.IP6.ARPA.swift	
@@ -10,13 +10,10 @@ extension RFC_3596 {
     /// The format uses nibbles (4-bit values) in reverse order, separated
     /// by dots, followed by "ip6.arpa".
     public enum IP6 {
+        public enum ARPA {}
     }
 }
 
-extension RFC_3596.IP6 {
-    public enum ARPA {}
-}
-
 extension RFC_3596.IP6.ARPA {
     /// The suffix for IPv6 reverse DNS names
     public static let suffix = "ip6.arpa"
