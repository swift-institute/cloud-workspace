Subject: [PATCH 1/4] minimal type body: the runner's repair moves non-stored
 members out of type bodies into extensions; repair applied; root and test
 builds not yet run (coenttb/work#242)

---
 Sources/RFC 3596/RFC_3596.IP6.ARPA.swift | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/Sources/RFC 3596/RFC_3596.IP6.ARPA.swift b/Sources/RFC 3596/RFC_3596.IP6.ARPA.swift
index 2b0d4f9..5198d54 100644
--- a/Sources/RFC 3596/RFC_3596.IP6.ARPA.swift	
+++ b/Sources/RFC 3596/RFC_3596.IP6.ARPA.swift	
@@ -10,7 +10,6 @@ extension RFC_3596 {
     /// The format uses nibbles (4-bit values) in reverse order, separated
     /// by dots, followed by "ip6.arpa".
     public enum IP6 {
-        public enum ARPA {}
     }
 }
 
@@ -58,3 +57,7 @@ extension RFC_3596.IP6.ARPA {
         return nibbles.map(String.init).joined(separator: ".") + "." + suffix
     }
 }
+
+extension RFC_3596.IP6 {
+    public enum ARPA {}
+}
