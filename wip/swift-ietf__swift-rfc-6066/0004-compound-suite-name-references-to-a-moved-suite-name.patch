From 7bc2df5585bc301e6e4c8616b76b529729363539 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 19:57:08 +0000
Subject: [PATCH 4/5] compound suite name: references to a moved suite name its
 namespace (coenttb/work#242)

---
 .../RFC_6066_ServerName Tests.swift              | 16 ++++++++--------
 1 file changed, 8 insertions(+), 8 deletions(-)

diff --git a/Tests/RFC 6066 Tests/RFC_6066_ServerName Tests.swift b/Tests/RFC 6066 Tests/RFC_6066_ServerName Tests.swift
index 1835daa..bbd3a66 100644
--- a/Tests/RFC 6066 Tests/RFC_6066_ServerName Tests.swift	
+++ b/Tests/RFC 6066 Tests/RFC_6066_ServerName Tests.swift	
@@ -73,7 +73,7 @@ extension `RFC_6066_ServerName Tests`.`RFC 6066 server_name (SNI)` {
         func `Creates from string`() throws {
             let hostName = try RFC_6066.HostName("example.com")
             #expect(hostName.description == "example.com")
-            #expect(hostName.rawValue == `RFC 6066 server_name (SNI)`.exampleCom)
+            #expect(hostName.rawValue == `RFC_6066_ServerName Tests`.`RFC 6066 server_name (SNI)`.exampleCom)
         }
 
         @Test
@@ -83,7 +83,7 @@ extension `RFC_6066_ServerName Tests`.`RFC 6066 server_name (SNI)` {
             var buffer: [Byte] = []
             RFC_6066.HostName.serialize(hostName, into: &buffer)
 
-            let expected: [Byte] = [Byte(0x00), Byte(0x0B)] + `RFC 6066 server_name (SNI)`.exampleCom
+            let expected: [Byte] = [Byte(0x00), Byte(0x0B)] + `RFC_6066_ServerName Tests`.`RFC 6066 server_name (SNI)`.exampleCom
             #expect(buffer == expected)
         }
 
@@ -136,7 +136,7 @@ extension `RFC_6066_ServerName Tests`.`RFC 6066 server_name (SNI)` {
             var buffer: [Byte] = []
             RFC_6066.ServerName.serialize(serverName, into: &buffer)
 
-            let expected: [Byte] = [Byte(0x00), Byte(0x00), Byte(0x0B)] + `RFC 6066 server_name (SNI)`.exampleCom
+            let expected: [Byte] = [Byte(0x00), Byte(0x00), Byte(0x0B)] + `RFC_6066_ServerName Tests`.`RFC 6066 server_name (SNI)`.exampleCom
             #expect(buffer == expected)
         }
 
@@ -162,7 +162,7 @@ extension `RFC_6066_ServerName Tests`.`RFC 6066 server_name (SNI)` {
         func `Serializes the RFC 6066 §3 body byte-for-byte`() throws {
             let list = RFC_6066.ServerNameList(hostName: try RFC_6066.HostName("example.com"))
 
-            #expect(list.bytes == `RFC 6066 server_name (SNI)`.body)
+            #expect(list.bytes == `RFC_6066_ServerName Tests`.`RFC 6066 server_name (SNI)`.body)
             #expect(list.bytes.count == 16)
         }
 
@@ -173,10 +173,10 @@ extension `RFC_6066_ServerName Tests`.`RFC 6066 server_name (SNI)` {
 
             #expect(ext.type == .serverName)
             #expect(ext.type.rawValue == 0)
-            #expect(ext.data == `RFC 6066 server_name (SNI)`.body)
+            #expect(ext.data == `RFC_6066_ServerName Tests`.`RFC 6066 server_name (SNI)`.body)
 
             // extension_type (0x0000) | extension_data length (16) | body
-            let expected: [Byte] = [Byte(0x00), Byte(0x00), Byte(0x00), Byte(0x10)] + `RFC 6066 server_name (SNI)`.body
+            let expected: [Byte] = [Byte(0x00), Byte(0x00), Byte(0x00), Byte(0x10)] + `RFC_6066_ServerName Tests`.`RFC 6066 server_name (SNI)`.body
             #expect(ext.bytes == expected)
         }
 
@@ -188,7 +188,7 @@ extension `RFC_6066_ServerName Tests`.`RFC 6066 server_name (SNI)` {
 
         @Test
         func `Parses the reference body`() throws {
-            let list = try RFC_6066.ServerNameList(binary: `RFC 6066 server_name (SNI)`.body)
+            let list = try RFC_6066.ServerNameList(binary: `RFC_6066_ServerName Tests`.`RFC 6066 server_name (SNI)`.body)
             #expect(list.serverNameList.count == 1)
             #expect(list.hostName?.description == "example.com")
         }
@@ -234,7 +234,7 @@ extension `RFC_6066_ServerName Tests`.`RFC 6066 server_name (SNI)` {
 
         @Test
         func `Rejects trailing bytes`() {
-            let bytes: [Byte] = `RFC 6066 server_name (SNI)`.body + [Byte(0xFF)]
+            let bytes: [Byte] = `RFC_6066_ServerName Tests`.`RFC 6066 server_name (SNI)`.body + [Byte(0xFF)]
             #expect(throws: RFC_6066.ServerNameList.Error.trailingData(1)) {
                 try RFC_6066.ServerNameList(binary: bytes)
             }
