From c70d464772e2052bdc12fd3119a63508eed19bbe Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:27:44 +0000
Subject: [PATCH 07/13] minimal type body: more non-stored members moved into
 an extension of their type (batch 10; type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 .../RFC 6066/RFC_6066.CertificateStatus.swift | 22 +++++++-------
 .../RFC_6066.CertificateStatusRequest.swift   | 26 ++++++++--------
 .../RFC 6066/RFC_6066.ServerNameList.swift    | 30 ++++++++++---------
 3 files changed, 42 insertions(+), 36 deletions(-)

diff --git a/Sources/RFC 6066/RFC_6066.CertificateStatus.swift b/Sources/RFC 6066/RFC_6066.CertificateStatus.swift
index aba6415..40a6f66 100644
--- a/Sources/RFC 6066/RFC_6066.CertificateStatus.swift	
+++ b/Sources/RFC 6066/RFC_6066.CertificateStatus.swift	
@@ -53,19 +53,21 @@ extension RFC_6066 {
             }
             self.init(__unchecked: (), response: response)
         }
+    }
+}
 
-        /// The wire discriminator for this response — always `ocsp(1)`.
-        public var statusType: CertificateStatusType { .ocsp }
+extension RFC_6066.CertificateStatus {
+    /// The wire discriminator for this response — always `ocsp(1)`.
+    public var statusType: CertificateStatusType { .ocsp }
 
-        /// The extension type carrying this response in TLS 1.3 (`status_request`).
-        public static let extensionType: RFC_8446.Extension.ExtensionType = .statusRequest
+    /// The extension type carrying this response in TLS 1.3 (`status_request`).
+    public static let extensionType: RFC_8446.Extension.ExtensionType = .statusRequest
 
-        /// Wraps this response in a generic ``RFC_8446/Extension/Data`` envelope —
-        /// the TLS 1.3 `CertificateEntry` form (RFC 8446 Section 4.4.2.1).
-        public var extensionData: RFC_8446.Extension.Data {
-            get throws(RFC_8446.Extension.Data.Error) {
-                try RFC_8446.Extension.Data(type: Self.extensionType, data: self.bytes)
-            }
+    /// Wraps this response in a generic ``RFC_8446/Extension/Data`` envelope —
+    /// the TLS 1.3 `CertificateEntry` form (RFC 8446 Section 4.4.2.1).
+    public var extensionData: RFC_8446.Extension.Data {
+        get throws(RFC_8446.Extension.Data.Error) {
+            try RFC_8446.Extension.Data(type: Self.extensionType, data: self.bytes)
         }
     }
 }
diff --git a/Sources/RFC 6066/RFC_6066.CertificateStatusRequest.swift b/Sources/RFC 6066/RFC_6066.CertificateStatusRequest.swift
index 1829ea4..5c8eee2 100644
--- a/Sources/RFC 6066/RFC_6066.CertificateStatusRequest.swift	
+++ b/Sources/RFC 6066/RFC_6066.CertificateStatusRequest.swift	
@@ -42,21 +42,23 @@ extension RFC_6066 {
         public init() {
             self.init(request: OCSPStatusRequest())
         }
+    }
+}
 
-        /// The wire discriminator for this payload — always `ocsp(1)`.
-        public var statusType: CertificateStatusType { .ocsp }
+extension RFC_6066.CertificateStatusRequest {
+    /// The wire discriminator for this payload — always `ocsp(1)`.
+    public var statusType: CertificateStatusType { .ocsp }
 
-        /// The extension type for this payload (`status_request`).
-        public static let extensionType: RFC_8446.Extension.ExtensionType = .statusRequest
+    /// The extension type for this payload (`status_request`).
+    public static let extensionType: RFC_8446.Extension.ExtensionType = .statusRequest
 
-        /// Wraps this payload in a generic ``RFC_8446/Extension/Data`` envelope.
-        ///
-        /// - Throws: ``RFC_8446/Extension/Data/Error`` if the body exceeds the
-        ///   envelope's 65535-byte limit.
-        public var extensionData: RFC_8446.Extension.Data {
-            get throws(RFC_8446.Extension.Data.Error) {
-                try RFC_8446.Extension.Data(type: Self.extensionType, data: self.bytes)
-            }
+    /// Wraps this payload in a generic ``RFC_8446/Extension/Data`` envelope.
+    ///
+    /// - Throws: ``RFC_8446/Extension/Data/Error`` if the body exceeds the
+    ///   envelope's 65535-byte limit.
+    public var extensionData: RFC_8446.Extension.Data {
+        get throws(RFC_8446.Extension.Data.Error) {
+            try RFC_8446.Extension.Data(type: Self.extensionType, data: self.bytes)
         }
     }
 }
diff --git a/Sources/RFC 6066/RFC_6066.ServerNameList.swift b/Sources/RFC 6066/RFC_6066.ServerNameList.swift
index cc21c02..12d4056 100644
--- a/Sources/RFC 6066/RFC_6066.ServerNameList.swift	
+++ b/Sources/RFC 6066/RFC_6066.ServerNameList.swift	
@@ -72,23 +72,25 @@ extension RFC_6066 {
         public init(hostName: HostName) {
             self.init(__unchecked: (), serverNameList: [ServerName(hostName: hostName)])
         }
+    }
+}
 
-        /// The offered `host_name`, if the list carries one.
-        public var hostName: HostName? {
-            serverNameList.first { $0.nameType == .hostName }?.hostName
-        }
+extension RFC_6066.ServerNameList {
+    /// The offered `host_name`, if the list carries one.
+    public var hostName: HostName? {
+        serverNameList.first { $0.nameType == .hostName }?.hostName
+    }
 
-        /// The extension type for this payload (`server_name`).
-        public static let extensionType: RFC_8446.Extension.ExtensionType = .serverName
+    /// The extension type for this payload (`server_name`).
+    public static let extensionType: RFC_8446.Extension.ExtensionType = .serverName
 
-        /// Wraps this payload in a generic ``RFC_8446/Extension/Data`` envelope.
-        ///
-        /// - Throws: ``RFC_8446/Extension/Data/Error`` if the body exceeds the
-        ///   envelope's 65535-byte limit.
-        public var extensionData: RFC_8446.Extension.Data {
-            get throws(RFC_8446.Extension.Data.Error) {
-                try RFC_8446.Extension.Data(type: Self.extensionType, data: self.bytes)
-            }
+    /// Wraps this payload in a generic ``RFC_8446/Extension/Data`` envelope.
+    ///
+    /// - Throws: ``RFC_8446/Extension/Data/Error`` if the body exceeds the
+    ///   envelope's 65535-byte limit.
+    public var extensionData: RFC_8446.Extension.Data {
+        get throws(RFC_8446.Extension.Data.Error) {
+            try RFC_8446.Extension.Data(type: Self.extensionType, data: self.bytes)
         }
     }
 }
-- 
2.43.0

