From ed8478ba9cdef94bd4ad4e2c40b50de0e0981247 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 23:28:24 +0000
Subject: [PATCH 5/9] minimal type body: more non-stored members move into
 extensions of their type (overnight/minimal-bodies.py); type-checked, failing
 files left out (coenttb/work#242)

---
 .../RFC_6066.CertificateURL.URLAndHash.swift  |  9 +-
 .../RFC_6066.ClientCertificateURL.swift       | 20 ++--
 Sources/RFC 6066/RFC_6066.ServerName.swift    |  8 +-
 ..._6066.ServerNameList.Acknowledgement.swift | 20 ++--
 Sources/RFC 6066/RFC_6066.TruncatedHMAC.swift | 20 ++--
 .../RFC_6066.TrustedAuthorities.swift         | 22 +++--
 Sources/RFC 6066/RFC_6066.Wire.Reader.swift   | 92 ++++++++++---------
 7 files changed, 102 insertions(+), 89 deletions(-)

diff --git a/Sources/RFC 6066/RFC_6066.CertificateURL.URLAndHash.swift b/Sources/RFC 6066/RFC_6066.CertificateURL.URLAndHash.swift
index 1229abe..e58450b 100644
--- a/Sources/RFC 6066/RFC_6066.CertificateURL.URLAndHash.swift	
+++ b/Sources/RFC 6066/RFC_6066.CertificateURL.URLAndHash.swift	
@@ -25,9 +25,6 @@ extension RFC_6066.CertificateURL {
         /// The SHA-1 hash of the DER object at ``url``.
         public let sha1Hash: RFC_6066.SHA1Hash
 
-        /// The mandatory `padding` byte value (0x01).
-        public static let padding: Byte = Byte(0x01)
-
         /// Creates a URL/hash pair WITHOUT validation.
         init(__unchecked: Void, url: [Byte], sha1Hash: RFC_6066.SHA1Hash) {
             self.url = url
@@ -49,10 +46,14 @@ extension RFC_6066.CertificateURL {
             }
             self.init(__unchecked: (), url: url, sha1Hash: sha1Hash)
         }
-
     }
 }
 
+extension RFC_6066.CertificateURL.URLAndHash {
+    /// The mandatory `padding` byte value (0x01).
+    public static let padding: Byte = Byte(0x01)
+}
+
 extension RFC_6066.CertificateURL.URLAndHash: Binary.Serializable {
     public static func serialize<Buffer: RangeReplaceableCollection>(
         _ value: Self,
diff --git a/Sources/RFC 6066/RFC_6066.ClientCertificateURL.swift b/Sources/RFC 6066/RFC_6066.ClientCertificateURL.swift
index be7a103..ebddfb5 100644
--- a/Sources/RFC 6066/RFC_6066.ClientCertificateURL.swift	
+++ b/Sources/RFC 6066/RFC_6066.ClientCertificateURL.swift	
@@ -17,17 +17,19 @@ extension RFC_6066 {
     public struct ClientCertificateURL: Sendable, Hashable {
         /// Creates the empty `client_certificate_url` body.
         public init() {}
+    }
+}
 
-        /// The extension type for this payload (`client_certificate_url`).
-        public static let extensionType: RFC_8446.Extension.ExtensionType = .clientCertificateURL
+extension RFC_6066.ClientCertificateURL {
+    /// The extension type for this payload (`client_certificate_url`).
+    public static let extensionType: RFC_8446.Extension.ExtensionType = .clientCertificateURL
 
-        /// Wraps this payload in a generic ``RFC_8446/Extension/Data`` envelope
-        /// with an empty `extension_data`.
-        public var extensionData: RFC_8446.Extension.Data {
-            // swift-format-ignore: NeverUseForceTry
-            // swiftlint:disable:next force_try
-            try! RFC_8446.Extension.Data(type: Self.extensionType, data: [])
-        }
+    /// Wraps this payload in a generic ``RFC_8446/Extension/Data`` envelope
+    /// with an empty `extension_data`.
+    public var extensionData: RFC_8446.Extension.Data {
+        // swift-format-ignore: NeverUseForceTry
+        // swiftlint:disable:next force_try
+        try! RFC_8446.Extension.Data(type: Self.extensionType, data: [])
     }
 }
 
diff --git a/Sources/RFC 6066/RFC_6066.ServerName.swift b/Sources/RFC 6066/RFC_6066.ServerName.swift
index 56ae7a5..0d20d75 100644
--- a/Sources/RFC 6066/RFC_6066.ServerName.swift	
+++ b/Sources/RFC 6066/RFC_6066.ServerName.swift	
@@ -28,12 +28,14 @@ extension RFC_6066 {
         public init(hostName: HostName) {
             self.hostName = hostName
         }
-
-        /// The wire discriminator for this entry — always `host_name(0)`.
-        public var nameType: NameType { .hostName }
     }
 }
 
+extension RFC_6066.ServerName {
+    /// The wire discriminator for this entry — always `host_name(0)`.
+    public var nameType: NameType { .hostName }
+}
+
 extension RFC_6066.ServerName: Binary.Serializable {
     /// Serializes `name_type` (1 byte) followed by the `HostName` vector.
     public static func serialize<Buffer: RangeReplaceableCollection>(
diff --git a/Sources/RFC 6066/RFC_6066.ServerNameList.Acknowledgement.swift b/Sources/RFC 6066/RFC_6066.ServerNameList.Acknowledgement.swift
