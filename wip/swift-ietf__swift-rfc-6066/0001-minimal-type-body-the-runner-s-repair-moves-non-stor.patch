@@ -23,9 +23,6 @@ extension RFC_6066.ServerName {
         init(__unchecked: Void, rawValue: UInt8) {
             self.rawValue = rawValue
         }
-
-        /// host_name (0) — the name is a `HostName`.
-        public static let hostName = Self(__unchecked: (), rawValue: 0)
     }
 }
 
@@ -37,3 +34,9 @@ extension RFC_6066.ServerName.NameType: CustomStringConvertible {
         }
     }
 }
+
+extension RFC_6066.ServerName.NameType {
+
+    /// host_name (0) — the name is a `HostName`.
+    public static let hostName = Self(__unchecked: (), rawValue: 0)
+}
diff --git a/Sources/RFC 6066/RFC_6066.TrustedAuthority.IdentifierType.swift b/Sources/RFC 6066/RFC_6066.TrustedAuthority.IdentifierType.swift
index 50f0d53..02f30c1 100644
--- a/Sources/RFC 6066/RFC_6066.TrustedAuthority.IdentifierType.swift	
+++ b/Sources/RFC 6066/RFC_6066.TrustedAuthority.IdentifierType.swift	
@@ -22,18 +22,6 @@ extension RFC_6066.TrustedAuthority {
         init(__unchecked: Void, rawValue: UInt8) {
             self.rawValue = rawValue
         }
-
-        /// pre_agreed (0) — no identifier is supplied; the CA is known out of band.
-        public static let preAgreed = Self(__unchecked: (), rawValue: 0)
-
-        /// key_sha1_hash (1) — SHA-1 hash of the CA's `SubjectPublicKeyInfo`.
-        public static let keySHA1Hash = Self(__unchecked: (), rawValue: 1)
-
-        /// x509_name (2) — the CA's DER-encoded X.509 `DistinguishedName`.
-        public static let x509Name = Self(__unchecked: (), rawValue: 2)
-
-        /// cert_sha1_hash (3) — SHA-1 hash of the CA's DER certificate.
-        public static let certSHA1Hash = Self(__unchecked: (), rawValue: 3)
     }
 }
 
@@ -48,3 +36,18 @@ extension RFC_6066.TrustedAuthority.IdentifierType: CustomStringConvertible {
         }
     }
 }
+
+extension RFC_6066.TrustedAuthority.IdentifierType {
+
+    /// pre_agreed (0) — no identifier is supplied; the CA is known out of band.
+    public static let preAgreed = Self(__unchecked: (), rawValue: 0)
+
+    /// key_sha1_hash (1) — SHA-1 hash of the CA's `SubjectPublicKeyInfo`.
+    public static let keySHA1Hash = Self(__unchecked: (), rawValue: 1)
+
+    /// x509_name (2) — the CA's DER-encoded X.509 `DistinguishedName`.
+    public static let x509Name = Self(__unchecked: (), rawValue: 2)
+
+    /// cert_sha1_hash (3) — SHA-1 hash of the CA's DER certificate.
+    public static let certSHA1Hash = Self(__unchecked: (), rawValue: 3)
+}
