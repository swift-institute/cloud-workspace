Subject: [PATCH 1/3] minimal type body: the runner's repair moves non-stored
 members out of type bodies into extensions; repair applied; root and test
 builds not yet run (coenttb/work#242)

---
 .../RFC_6066.CertificateStatusType.swift      |  9 ++++---
 ...FC_6066.CertificateURL.CertChainType.swift | 15 ++++++-----
 .../RFC_6066.ServerName.NameType.swift        |  9 ++++---
 ...6066.TrustedAuthority.IdentifierType.swift | 27 ++++++++++---------
 4 files changed, 36 insertions(+), 24 deletions(-)

diff --git a/Sources/RFC 6066/RFC_6066.CertificateStatusType.swift b/Sources/RFC 6066/RFC_6066.CertificateStatusType.swift
index f6bceec..3049778 100644
--- a/Sources/RFC 6066/RFC_6066.CertificateStatusType.swift	
+++ b/Sources/RFC 6066/RFC_6066.CertificateStatusType.swift	
@@ -22,9 +22,6 @@ extension RFC_6066 {
         init(__unchecked: Void, rawValue: UInt8) {
             self.rawValue = rawValue
         }
-
-        /// ocsp (1) — the status is an OCSP response (RFC 6960).
-        public static let ocsp = Self(__unchecked: (), rawValue: 1)
     }
 }
 
@@ -36,3 +33,9 @@ extension RFC_6066.CertificateStatusType: CustomStringConvertible {
         }
     }
 }
+
+extension RFC_6066.CertificateStatusType {
+
+    /// ocsp (1) — the status is an OCSP response (RFC 6960).
+    public static let ocsp = Self(__unchecked: (), rawValue: 1)
+}
diff --git a/Sources/RFC 6066/RFC_6066.CertificateURL.CertChainType.swift b/Sources/RFC 6066/RFC_6066.CertificateURL.CertChainType.swift
index 00a99e7..77aa8e5 100644
--- a/Sources/RFC 6066/RFC_6066.CertificateURL.CertChainType.swift	
+++ b/Sources/RFC 6066/RFC_6066.CertificateURL.CertChainType.swift	
@@ -21,12 +21,6 @@ extension RFC_6066.CertificateURL {
         init(__unchecked: Void, rawValue: UInt8) {
             self.rawValue = rawValue
         }
-
-        /// individual_certs (0) — each URL refers to a single DER certificate.
-        public static let individualCerts = Self(__unchecked: (), rawValue: 0)
-
-        /// pkipath (1) — a single URL refers to a DER PkiPath certificate chain.
-        public static let pkipath = Self(__unchecked: (), rawValue: 1)
     }
 }
 
@@ -39,3 +33,12 @@ extension RFC_6066.CertificateURL.CertChainType: CustomStringConvertible {
         }
     }
 }
+
+extension RFC_6066.CertificateURL.CertChainType {
+
+    /// individual_certs (0) — each URL refers to a single DER certificate.
+    public static let individualCerts = Self(__unchecked: (), rawValue: 0)
+
+    /// pkipath (1) — a single URL refers to a DER PkiPath certificate chain.
+    public static let pkipath = Self(__unchecked: (), rawValue: 1)
+}
diff --git a/Sources/RFC 6066/RFC_6066.ServerName.NameType.swift b/Sources/RFC 6066/RFC_6066.ServerName.NameType.swift
index 47fcff9..102ff24 100644
--- a/Sources/RFC 6066/RFC_6066.ServerName.NameType.swift	
