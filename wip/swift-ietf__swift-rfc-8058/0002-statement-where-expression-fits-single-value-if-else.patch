From 68d4f17c9f6132b4dd1e5f4d09a06ad4be9890cd Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:35:30 +0000
Subject: [PATCH 2/5] statement where expression fits: single-value if/else
 chains written as if expressions (type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 Sources/RFC 8058/OneClick+Unsubscribe.swift | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/Sources/RFC 8058/OneClick+Unsubscribe.swift b/Sources/RFC 8058/OneClick+Unsubscribe.swift
index 6800cad..df8b347 100644
--- a/Sources/RFC 8058/OneClick+Unsubscribe.swift	
+++ b/Sources/RFC 8058/OneClick+Unsubscribe.swift	
@@ -24,10 +24,10 @@ extension RFC_8058.OneClick {
             self.opaqueToken = opaqueToken
 
             let fullURIString: String
-            if baseURL.value.hasSuffix("/") {
-                fullURIString = "\(baseURL.value)\(opaqueToken)"
+            fullURIString = if baseURL.value.hasSuffix("/") {
+                "\(baseURL.value)\(opaqueToken)"
             } else {
-                fullURIString = "\(baseURL.value)/\(opaqueToken)"
+                "\(baseURL.value)/\(opaqueToken)"
             }
 
             let uri: RFC_3987.IRI
