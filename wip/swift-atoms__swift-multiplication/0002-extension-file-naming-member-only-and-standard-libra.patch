Date: Sat, 7 Nov 2026 20:52:45 +0000
Subject: [PATCH 2/2] extension file naming: member-only and
 standard-library-conformance extension files merge into their type's own file
 (overnight/merge-extension-files.py); single type per file: additional types
 move to their own <Parent>.<Name>.swift inside the container's extension
 (overnight/split-types.py); parse-checked; builds pending (coenttb/work#242)

---
 .../Multiplication/Multiplication.Augmented.swift  |  8 --------
 Sources/Multiplication/Multiplication.Error.swift  |  8 ++++++++
 Sources/Multiplication/Multiplication.Signed.swift |  6 ++++++
 Sources/Multiplication/Multiplication.swift        | 14 +++++++++-----
 4 files changed, 23 insertions(+), 13 deletions(-)
 delete mode 100644 Sources/Multiplication/Multiplication.Augmented.swift
 create mode 100644 Sources/Multiplication/Multiplication.Error.swift
 create mode 100644 Sources/Multiplication/Multiplication.Signed.swift

diff --git a/Sources/Multiplication/Multiplication.Augmented.swift b/Sources/Multiplication/Multiplication.Augmented.swift
deleted file mode 100644
index 19b8262..0000000
--- a/Sources/Multiplication/Multiplication.Augmented.swift
+++ /dev/null
@@ -1,8 +0,0 @@
-extension Multiplication {
-
-    @inlinable
-    public static func augmented<T: FloatingPoint>(_ lhs: T, _ rhs: T) -> (head: T, tail: T) {
-        let head = lhs * rhs
-        return (head, (-head).addingProduct(lhs, rhs))
-    }
-}
diff --git a/Sources/Multiplication/Multiplication.Error.swift b/Sources/Multiplication/Multiplication.Error.swift
new file mode 100644
index 0000000..290d73f
--- /dev/null
+++ b/Sources/Multiplication/Multiplication.Error.swift
@@ -0,0 +1,8 @@
+public import Polarity
+
+
+extension Multiplication {
+    public enum Error: Swift::Error, Hashable, Sendable {
+        case overflow
+    }
+}
diff --git a/Sources/Multiplication/Multiplication.Signed.swift b/Sources/Multiplication/Multiplication.Signed.swift
new file mode 100644
index 0000000..8afe737
--- /dev/null
+++ b/Sources/Multiplication/Multiplication.Signed.swift
@@ -0,0 +1,6 @@
+public import Polarity
+
+
+extension Multiplication {
+    public enum Signed {}
+}
diff --git a/Sources/Multiplication/Multiplication.swift b/Sources/Multiplication/Multiplication.swift
index 3e1c80c..540de7c 100644
--- a/Sources/Multiplication/Multiplication.swift
+++ b/Sources/Multiplication/Multiplication.swift
@@ -4,9 +4,6 @@ public enum Multiplication {}
 
 extension Multiplication {
 
-    public enum Error: Swift::Error, Hashable, Sendable {
-        case overflow
-    }
 
     @inlinable
     public static func reporting<Value: FixedWidthInteger>(
@@ -40,8 +37,6 @@ extension Multiplication {
 }
 
 extension Multiplication {
-
-    public enum Signed {}
 }
 
 extension Multiplication.Signed {
@@ -81,3 +76,12 @@ extension Multiplication.Signed {
         (magnitude == .zero ? .positive : polarity, magnitude)
     }
 }
+
+extension Multiplication {
+
+    @inlinable
+    public static func augmented<T: FloatingPoint>(_ lhs: T, _ rhs: T) -> (head: T, tail: T) {
+        let head = lhs * rhs
+        return (head, (-head).addingProduct(lhs, rhs))
+    }
+}
