From dd87268c00c2f5a9f1fb0c1f10b949047e47e1fe Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 20:52:54 +0000
Subject: [PATCH 2/5] extension file naming: member-only and
 standard-library-conformance extension files merge into their type's own file
 (overnight/merge-extension-files.py); single type per file: additional types
 move to their own <Parent>.<Name>.swift inside the container's extension
 (overnight/split-types.py); parse-checked; builds pending (coenttb/work#242)

---
 Sources/Domain Standard/Domain.Error.swift | 16 ++++++++++++++++
 Sources/Domain Standard/Domain.swift       | 11 -----------
 2 files changed, 16 insertions(+), 11 deletions(-)
 create mode 100644 Sources/Domain Standard/Domain.Error.swift

diff --git a/Sources/Domain Standard/Domain.Error.swift b/Sources/Domain Standard/Domain.Error.swift
new file mode 100644
index 0000000..863abb4
--- /dev/null
+++ b/Sources/Domain Standard/Domain.Error.swift	
@@ -0,0 +1,16 @@
+public import RFC_1035
+public import RFC_1123
+
+
+extension Domain {
+    public enum Error: Swift::Error, Equatable {
+
+        case invalidFormat(_ description: String)
+
+        case cannotCreateSubdomain
+
+        case conversionFailure(_ from: String, to: String)
+
+        case idnaConversionFailure(_ reason: String)
+    }
+}
diff --git a/Sources/Domain Standard/Domain.swift b/Sources/Domain Standard/Domain.swift
index 06664cd..65399c7 100644
--- a/Sources/Domain Standard/Domain.swift	
+++ b/Sources/Domain Standard/Domain.swift	
@@ -122,17 +122,6 @@ extension Domain {
 }
 
 extension Domain {
-
-    public enum Error: Swift::Error, Equatable {
-
-        case invalidFormat(_ description: String)
-
-        case cannotCreateSubdomain
-
-        case conversionFailure(_ from: String, to: String)
-
-        case idnaConversionFailure(_ reason: String)
-    }
 }
 
 extension Domain.Error: CustomStringConvertible {
