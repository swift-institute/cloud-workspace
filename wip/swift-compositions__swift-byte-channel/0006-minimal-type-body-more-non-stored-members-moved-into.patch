From 21f19e0ccc8f925bf9a4da9127118b7ab97c5ca5 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:17:17 +0000
Subject: [PATCH 6/8] minimal type body: more non-stored members moved into an
 extension of their type (batch 18; type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 Sources/Byte Channel/Byte.Channel.Writer.swift | 12 +++++++-----
 1 file changed, 7 insertions(+), 5 deletions(-)

diff --git a/Sources/Byte Channel/Byte.Channel.Writer.swift b/Sources/Byte Channel/Byte.Channel.Writer.swift
index 52784ef..afb9c16 100644
--- a/Sources/Byte Channel/Byte.Channel.Writer.swift	
+++ b/Sources/Byte Channel/Byte.Channel.Writer.swift	
@@ -6,11 +6,6 @@ import Synchronization
 extension Byte.Channel {
     /// The outbound endpoint for owned byte chunks.
     public struct Writer: Sendable {
-        enum Backend: Sendable {
-            case bounded(Async.Channel<Accepted>.Typed<Failure>.Sender, Gate)
-            case rendezvous(Async.Channel<Byte.Chunk>.Typed<Failure>.Rendezvous.Sender)
-        }
-
         let backend: Backend
 
         init(_ backend: Backend) {
@@ -19,6 +14,13 @@ extension Byte.Channel {
     }
 }
 
+extension Byte.Channel.Writer {
+    enum Backend: Sendable {
+        case bounded(Async.Channel<Accepted>.Typed<Failure>.Sender, Gate)
+        case rendezvous(Async.Channel<Byte.Chunk>.Typed<Failure>.Rendezvous.Sender)
+    }
+}
+
 extension Byte.Channel.Writer {
     /// Sends one whole chunk while preserving ownership on rejection.
     public func send(_ chunk: consuming sending Byte.Chunk) async -> Send.Outcome {
