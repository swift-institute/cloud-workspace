From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 20:52:55 +0000
Subject: [PATCH 2/7] extension file naming: member-only and
 standard-library-conformance extension files merge into their type's own file
 (overnight/merge-extension-files.py); single type per file: additional types
 move to their own <Parent>.<Name>.swift inside the container's extension
 (overnight/split-types.py); parse-checked; builds pending (coenttb/work#242)

---
 .../Byte.Channel.Writer.Send.Outcome.swift          | 13 +++++++++++++
 Sources/Byte Channel/Byte.Channel.Writer.Send.swift | 10 ++++++++++
 Sources/Byte Channel/Byte.Channel.Writer.swift      |  7 -------
 3 files changed, 23 insertions(+), 7 deletions(-)
 create mode 100644 Sources/Byte Channel/Byte.Channel.Writer.Send.Outcome.swift
 create mode 100644 Sources/Byte Channel/Byte.Channel.Writer.Send.swift

diff --git a/Sources/Byte Channel/Byte.Channel.Writer.Send.Outcome.swift b/Sources/Byte Channel/Byte.Channel.Writer.Send.Outcome.swift
new file mode 100644
index 0000000..13f1de0
--- /dev/null
+++ b/Sources/Byte Channel/Byte.Channel.Writer.Send.Outcome.swift	
@@ -0,0 +1,13 @@
+public import Async_Channel
+public import Byte
+public import Byte_Chunk
+import Synchronization
+
+
+extension Byte.Channel.Writer.Send {
+    /// The ownership-preserving result of any byte-channel send.
+    public enum Outcome: ~Copyable {
+        case sent
+        case rejected(Byte.Chunk, Byte.Channel<Failure>.Error)
+    }
+}
diff --git a/Sources/Byte Channel/Byte.Channel.Writer.Send.swift b/Sources/Byte Channel/Byte.Channel.Writer.Send.swift
new file mode 100644
index 0000000..d2e6c92
--- /dev/null
+++ b/Sources/Byte Channel/Byte.Channel.Writer.Send.swift	
@@ -0,0 +1,10 @@
+public import Async_Channel
+public import Byte
+public import Byte_Chunk
+import Synchronization
+
+
+extension Byte.Channel.Writer {
+    /// Namespace for ownership-preserving send results.
+    public enum Send {}
+}
diff --git a/Sources/Byte Channel/Byte.Channel.Writer.swift b/Sources/Byte Channel/Byte.Channel.Writer.swift
index 5205d8f..52784ef 100644
--- a/Sources/Byte Channel/Byte.Channel.Writer.swift	
