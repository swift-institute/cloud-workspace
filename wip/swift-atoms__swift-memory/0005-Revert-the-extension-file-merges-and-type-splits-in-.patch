diff --git a/Sources/Memory/Memory.Alignment.Error+Swift.CustomStringConvertible.swift b/Sources/Memory/Memory.Alignment.Error+Swift.CustomStringConvertible.swift
new file mode 100644
index 0000000..60897ba
--- /dev/null
+++ b/Sources/Memory/Memory.Alignment.Error+Swift.CustomStringConvertible.swift
@@ -0,0 +1,12 @@
+extension Memory.Alignment.Error: Swift::CustomStringConvertible {
+
+    public var description: String {
+        switch self {
+        case .notPowerOfTwo(let value):
+            return "alignment must be a power of 2 (was \(value))"
+
+        case .shiftExceedsBitWidth(let shift, let bitWidth):
+            return "shift \(shift) exceeds carrier bit width \(bitWidth)"
+        }
+    }
+}
