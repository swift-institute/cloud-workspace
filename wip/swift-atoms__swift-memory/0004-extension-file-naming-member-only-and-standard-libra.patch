diff --git a/Sources/Memory/Memory.Alignment.Error.swift b/Sources/Memory/Memory.Alignment.Error.swift
index a7a9a03..27a4eaf 100644
--- a/Sources/Memory/Memory.Alignment.Error.swift
+++ b/Sources/Memory/Memory.Alignment.Error.swift
@@ -7,3 +7,16 @@ extension Memory.Alignment {
         case shiftExceedsBitWidth(shift: UInt8, bitWidth: Int)
     }
 }
+
+extension Memory.Alignment.Error: Swift::CustomStringConvertible {
+
+    public var description: String {
+        switch self {
+        case .notPowerOfTwo(let value):
+            return "alignment must be a power of 2 (was \(value))"
+
+        case .shiftExceedsBitWidth(let shift, let bitWidth):
+            return "shift \(shift) exceeds carrier bit width \(bitWidth)"
+        }
+    }
+}
diff --git a/Sources/Memory/Memory.Alignment.swift b/Sources/Memory/Memory.Alignment.swift
index 14eb7fd..5d50e9d 100644
--- a/Sources/Memory/Memory.Alignment.swift
+++ b/Sources/Memory/Memory.Alignment.swift
@@ -119,3 +119,44 @@ extension Memory.Alignment {
         return value & ~mask
     }
 }
+
+#if Carrier
+    public import Carrier
+    extension Memory.Alignment {
+
+        @_disfavoredOverload
+        @inlinable
+        public func isAligned<C: Carrier.`Protocol`>(_ value: C) -> Bool
+        where C.Underlying: FixedWidthInteger {
+            isAligned(value.underlying)
+        }
+
+        @_disfavoredOverload
+        @inlinable
+        public func alignUp<C: Carrier.`Protocol`>(_ value: C) -> C
+        where C.Underlying: FixedWidthInteger {
+            C(alignUp(value.underlying))
+        }
+
+        @_disfavoredOverload
+        @inlinable
+        public func alignDown<C: Carrier.`Protocol`>(_ value: C) -> C
+        where C.Underlying: FixedWidthInteger {
+            C(alignDown(value.underlying))
+        }
+    }
+#endif
+
+extension Memory.Alignment: Swift::Comparable {
+
+    public static func < (lhs: Memory.Alignment, rhs: Memory.Alignment) -> Bool {
+        lhs.shift < rhs.shift
+    }
+}
+
+extension Memory.Alignment: Swift::CustomStringConvertible {
+
+    public var description: String {
+        "\(magnitude() as Int)"
+    }
+}
