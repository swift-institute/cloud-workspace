diff --git a/Sources/Either/Either+Swift.Hashable.swift b/Sources/Either/Either+Swift.Hashable.swift
new file mode 100644
index 0000000..e41db76
--- /dev/null
+++ b/Sources/Either/Either+Swift.Hashable.swift
@@ -0,0 +1,19 @@
+extension Either: Swift.Hashable
+where
+    Left: Swift.Hashable & ~Copyable,
+    Right: Swift.Hashable & ~Copyable
+{
+
+    @inlinable
+    public borrowing func hash(into hasher: inout Hasher) {
+        switch self {
+        case .left(let left):
+            hasher.combine(0 as UInt8)
+            left.hash(into: &hasher)
+
+        case .right(let right):
+            hasher.combine(1 as UInt8)
+            right.hash(into: &hasher)
+        }
+    }
+}
