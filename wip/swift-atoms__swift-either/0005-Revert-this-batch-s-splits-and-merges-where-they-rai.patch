diff --git a/Sources/Either/Either+Swift.Comparable.swift b/Sources/Either/Either+Swift.Comparable.swift
new file mode 100644
index 0000000..4102942
--- /dev/null
+++ b/Sources/Either/Either+Swift.Comparable.swift
@@ -0,0 +1,29 @@
+extension Either: Swift.Comparable
+where
+    Left: Swift.Comparable & ~Copyable,
+    Right: Swift.Comparable & ~Copyable
+{
+
+    @inlinable
+    public static func < (lhs: borrowing Either, rhs: borrowing Either) -> Bool {
+        switch lhs {
+        case .left(let lLeft):
+            switch rhs {
+            case .left(let rLeft):
+                return lLeft < rLeft
+
+            case .right:
+                return true
+            }
+
+        case .right(let lRight):
+            switch rhs {
+            case .left:
+                return false
+
+            case .right(let rRight):
+                return lRight < rRight
+            }
+        }
+    }
+}
diff --git a/Sources/Either/Either+Swift.Equatable.swift b/Sources/Either/Either+Swift.Equatable.swift
new file mode 100644
index 0000000..b30c887
--- /dev/null
+++ b/Sources/Either/Either+Swift.Equatable.swift
@@ -0,0 +1,29 @@
+extension Either: Swift.Equatable
+where
+    Left: Swift.Equatable & ~Copyable,
+    Right: Swift.Equatable & ~Copyable
+{
+
+    @inlinable
+    public static func == (lhs: borrowing Either, rhs: borrowing Either) -> Bool {
+        switch lhs {
+        case .left(let lLeft):
+            switch rhs {
+            case .left(let rLeft):
+                return lLeft == rLeft
+
+            case .right:
+                return false
+            }
+
+        case .right(let lRight):
+            switch rhs {
+            case .left:
+                return false
+
+            case .right(let rRight):
+                return lRight == rRight
+            }
+        }
+    }
+}
