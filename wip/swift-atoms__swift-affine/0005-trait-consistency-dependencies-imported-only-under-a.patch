From 8aeea4ceba8ab03ea3f1f154ba585ca061f7a0d0 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:24:48 +0000
Subject: [PATCH 5/5] trait consistency: dependencies imported only under a
 trait get that trait's condition (runner repair; Linux x86_64, Swift 6.4.2)
 (coenttb/work#242)

---
 Package.swift | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/Package.swift b/Package.swift
index bccb778..736ecad 100644
--- a/Package.swift
+++ b/Package.swift
@@ -19,8 +19,8 @@ let package = Package(
         .target(
             name: "Affine",
             dependencies: [
-                .product(name: "Tagged", package: "swift-tagged"),
-                .product(name: "Vector", package: "swift-vector"),
+                .product(name: "Tagged", package: "swift-tagged", condition: .when(traits: ["Tagged"])),
+                .product(name: "Vector", package: "swift-vector", condition: .when(traits: ["Vector"])),
             ]
         ),
         .testTarget(name: "Affine Tests", dependencies: [.target(name: "Affine")]),
@@ -28,8 +28,8 @@ let package = Package(
             name: "Affine Representations Tests",
             dependencies: [
                 .target(name: "Affine"),
-                .product(name: "Tagged", package: "swift-tagged"),
-                .product(name: "Vector", package: "swift-vector"),
+                .product(name: "Tagged", package: "swift-tagged", condition: .when(traits: ["Tagged"])),
+                .product(name: "Vector", package: "swift-vector", condition: .when(traits: ["Vector"])),
             ]
         ),
     ],
-- 
