-    public static func measure<T, E: Swift.Error>(
-        warmup: Int = 0,
-        iterations: Int = 10,
-        operation: () async throws(E) -> T
-    ) async throws(E) -> (result: T, measurement: Test.Benchmark.Measurement) {
-        for _ in 0..<warmup {
