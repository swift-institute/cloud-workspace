-            preconditionFailure("the timed scope runs only for entries carrying the trait")
-        }
-
-        for _ in 0..<config.iteration.warmup {
-            try await operation()
-        }
-
-        var durations: [Duration] = []
-        durations.reserveCapacity(config.iteration.count)
