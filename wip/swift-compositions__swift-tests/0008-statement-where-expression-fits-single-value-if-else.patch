From 9e7c421aa7800a741a2a2b511c37a498320cba72 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:35:33 +0000
Subject: [PATCH 08/18] statement where expression fits: single-value if/else
 chains written as if expressions (type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 Sources/Tests Performance/Test.Runner.swift    | 18 +++++++++---------
 ...Complexity.Baseline+JSON.Serializable.swift |  6 +++---
 .../Tests Performance/Tests.Complexity.swift   | 16 ++++++++--------
 3 files changed, 20 insertions(+), 20 deletions(-)

diff --git a/Sources/Tests Performance/Test.Runner.swift b/Sources/Tests Performance/Test.Runner.swift
index 07827cd..fe67833 100644
--- a/Sources/Tests Performance/Test.Runner.swift	
+++ b/Sources/Tests Performance/Test.Runner.swift	
@@ -251,10 +251,10 @@ extension Test.Runner {
         }
 
         let effective: Concurrency
-        if let traits, traits[Test.Trait.Serialized.self] {
-            effective = .serial
+        effective = if let traits, traits[Test.Trait.Serialized.self] {
+            .serial
         } else {
-            effective = concurrency
+            concurrency
         }
 
         switch effective {
@@ -376,12 +376,12 @@ extension Test.Runner {
             bodyThrew = true
 
             let isRequirementFailure: Bool
-            if let runnerError = error as? Self.Error,
+            isRequirementFailure = if let runnerError = error as? Self.Error,
                 case .bodyFailed(.requirementFailed) = runnerError
             {
-                isRequirementFailure = true
+                true
             } else {
-                isRequirementFailure = false
+                false
             }
 
             if !isRequirementFailure {
@@ -430,10 +430,10 @@ extension Test.Runner {
             }
         }
 
-        if bodyThrew || hasExpectationFailures {
-            testResult = .failed
+        testResult = if bodyThrew || hasExpectationFailures {
+            .failed
         } else {
-            testResult = .passed
+            .passed
         }
 
         await sender.send(
diff --git a/Sources/Tests Performance/Tests.Complexity.Baseline+JSON.Serializable.swift b/Sources/Tests Performance/Tests.Complexity.Baseline+JSON.Serializable.swift
index b56a65a..8f63054 100644
--- a/Sources/Tests Performance/Tests.Complexity.Baseline+JSON.Serializable.swift	
+++ b/Sources/Tests Performance/Tests.Complexity.Baseline+JSON.Serializable.swift	
@@ -48,10 +48,10 @@ extension Tests.Complexity.Baseline: JSON.Serializable {
         }
 
         let bestRSquared: Double?
-        if json.bestRSquared.isNull || !json.bestRSquared.isNumber {
-            bestRSquared = nil
+        bestRSquared = if json.bestRSquared.isNull || !json.bestRSquared.isNumber {
+            nil
         } else {
-            bestRSquared = Double(json.bestRSquared)
+            Double(json.bestRSquared)
         }
 
         return Self(
diff --git a/Sources/Tests Performance/Tests.Complexity.swift b/Sources/Tests Performance/Tests.Complexity.swift
index 38ef663..2b2deb3 100644
--- a/Sources/Tests Performance/Tests.Complexity.swift	
+++ b/Sources/Tests Performance/Tests.Complexity.swift	
@@ -297,12 +297,12 @@ extension Tests.Complexity {
                     effectiveExponent: 0
                 )
             let confidence: Confidence
-            if evidence.metricCV < policy.constantCVThreshold * 0.2 {
-                confidence = .high
+            confidence = if evidence.metricCV < policy.constantCVThreshold * 0.2 {
+                .high
             } else if evidence.metricCV < policy.constantCVThreshold * 0.5 {
-                confidence = .medium
+                .medium
             } else {
-                confidence = .low
+                .low
             }
             return Result(
                 evidence: evidence,
@@ -371,12 +371,12 @@ extension Tests.Complexity {
         }.map(\.complexity)
 
         var confidence: Confidence
-        if separation >= policy.highSeparationThreshold {
-            confidence = .high
+        confidence = if separation >= policy.highSeparationThreshold {
+            .high
         } else if separation >= policy.mediumSeparationThreshold {
-            confidence = .medium
+            .medium
         } else {
-            confidence = .low
+            .low
         }
 
         let tolerance = Swift.max(
