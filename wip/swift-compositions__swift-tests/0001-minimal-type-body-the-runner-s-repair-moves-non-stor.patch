From d4e822c0895e0c79f32e18d1541dbc8c35c3898f Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 18:24:17 +0000
Subject: [PATCH 01/18] minimal type body: the runner's repair moves non-stored
 members out of type bodies into extensions; repair applied; root and test
 builds not yet run (coenttb/work#242)

---
 Sources/Tests Performance/Test.Runner.swift | 27 ++++++++++++---------
 1 file changed, 15 insertions(+), 12 deletions(-)

diff --git a/Sources/Tests Performance/Test.Runner.swift b/Sources/Tests Performance/Test.Runner.swift
index 075191f..52c1e11 100644
--- a/Sources/Tests Performance/Test.Runner.swift	
+++ b/Sources/Tests Performance/Test.Runner.swift	
@@ -569,18 +569,6 @@ extension Test.Runner {
         var passed: Int = 0
         var failed: Int = 0
         var skipped: Int = 0
-
-        static func + (lhs: Self, rhs: Self) -> Self {
-            Self(
-                passed: lhs.passed + rhs.passed,
-                failed: lhs.failed + rhs.failed,
-                skipped: lhs.skipped + rhs.skipped
-            )
-        }
-
-        static func += (lhs: inout Self, rhs: Self) {
-            lhs = lhs + rhs
-        }
     }
 }
 
@@ -640,3 +628,18 @@ extension Test.Runner {
     /// Errors thrown during test execution.
     public typealias Error = Test.Trait.Scope.Provider.Error
 }
+
+extension Test.Runner.Counters {
+
+    static func + (lhs: Self, rhs: Self) -> Self {
+        Self(
+            passed: lhs.passed + rhs.passed,
+            failed: lhs.failed + rhs.failed,
+            skipped: lhs.skipped + rhs.skipped
+        )
+    }
+
+    static func += (lhs: inout Self, rhs: Self) {
+        lhs = lhs + rhs
+    }
+}
