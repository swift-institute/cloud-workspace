 extension its operator moved to can see it (coenttb/work#242)

---
 Sources/Tests Performance/Test.Runner.swift | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Sources/Tests Performance/Test.Runner.swift b/Sources/Tests Performance/Test.Runner.swift
index 52c1e11..07827cd 100644
--- a/Sources/Tests Performance/Test.Runner.swift	
+++ b/Sources/Tests Performance/Test.Runner.swift	
@@ -565,7 +565,7 @@ extension Test.Runner {
     /// Each `walk` call returns a `Counters` value. These are aggregated
     /// functionally — no shared mutable state needed, even across concurrent
     /// task groups.
-    private struct Counters: Sendable {
+    fileprivate struct Counters: Sendable {
         var passed: Int = 0
         var failed: Int = 0
         var skipped: Int = 0
