Subject: [PATCH 3/5] Revert the extension-file merges and type splits in
 directories where a merged file brought its conditional imports mid-file
 (coenttb/work#242)

---
 ...b.Pattern+ExpressibleByStringLiteral.swift | 13 ++++++
 .../Glob Parser/Glob.Pattern+Parsing.swift    | 19 ++++++++
 .../Glob Parser/Glob.Pattern+parser.swift     | 11 +++++
 Sources/Glob/Glob.Pattern.swift               | 46 -------------------
 4 files changed, 43 insertions(+), 46 deletions(-)
 create mode 100644 Sources/Glob/Absorbed/swift-glob-parser/Glob Parser/Glob.Pattern+ExpressibleByStringLiteral.swift
 create mode 100644 Sources/Glob/Absorbed/swift-glob-parser/Glob Parser/Glob.Pattern+Parsing.swift
 create mode 100644 Sources/Glob/Absorbed/swift-glob-parser/Glob Parser/Glob.Pattern+parser.swift

diff --git a/Sources/Glob/Absorbed/swift-glob-parser/Glob Parser/Glob.Pattern+ExpressibleByStringLiteral.swift b/Sources/Glob/Absorbed/swift-glob-parser/Glob Parser/Glob.Pattern+ExpressibleByStringLiteral.swift
new file mode 100644
index 0000000..bddb190
--- /dev/null
+++ b/Sources/Glob/Absorbed/swift-glob-parser/Glob Parser/Glob.Pattern+ExpressibleByStringLiteral.swift	
@@ -0,0 +1,13 @@
+#if Parser
+    extension Glob.Pattern: ExpressibleByStringLiteral {
+
+        @inlinable
+        public init(stringLiteral value: Swift::String) {
+            do throws(Glob.Error) {
+                self = try Glob.Pattern.parse(value)
+            } catch {
+                fatalError("Glob.Pattern literal failed to parse: \(value): \(error)")
+            }
+        }
+    }
+#endif
diff --git a/Sources/Glob/Absorbed/swift-glob-parser/Glob Parser/Glob.Pattern+Parsing.swift b/Sources/Glob/Absorbed/swift-glob-parser/Glob Parser/Glob.Pattern+Parsing.swift
new file mode 100644
index 0000000..77d7e86
--- /dev/null
+++ b/Sources/Glob/Absorbed/swift-glob-parser/Glob Parser/Glob.Pattern+Parsing.swift	
@@ -0,0 +1,19 @@
+#if Parser
+    import Byte
+    import Cursor
+    import Parser
+
+    extension Glob.Pattern {
+
+        @inlinable
+        public init(_ pattern: Swift::String) throws(Glob.Error) {
+            self = try Self.parse(pattern)
+        }
+
+        @inlinable
+        public static func parse(_ pattern: Swift::String) throws(Glob.Error) -> Self {
+            var input = [Byte](utf8: pattern)[...]
+            return try Self.Parser<ArraySlice<Byte>>().parse(&input)
+        }
+    }
+#endif
diff --git a/Sources/Glob/Absorbed/swift-glob-parser/Glob Parser/Glob.Pattern+parser.swift b/Sources/Glob/Absorbed/swift-glob-parser/Glob Parser/Glob.Pattern+parser.swift
new file mode 100644
index 0000000..c0997c9
--- /dev/null
+++ b/Sources/Glob/Absorbed/swift-glob-parser/Glob Parser/Glob.Pattern+parser.swift	
@@ -0,0 +1,11 @@
+#if Parser
+    import Byte
+    import Cursor
+    import Parser
+
+    extension Glob.Pattern {
+
+        @inlinable
+        public static var parser: Glob.Pattern.Parser<ArraySlice<Byte>> { Glob.Pattern.Parser<ArraySlice<Byte>>() }
+    }
+#endif
diff --git a/Sources/Glob/Glob.Pattern.swift b/Sources/Glob/Glob.Pattern.swift
index 7aa6fcc..f52d161 100644
--- a/Sources/Glob/Glob.Pattern.swift
+++ b/Sources/Glob/Glob.Pattern.swift
@@ -19,49 +19,3 @@ extension Glob {
         }
     }
 }
