From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 07:06:20 +0000
Subject: [PATCH 4/4] Revert Sources/Zygomorphism Macro to origin/main: macro
 targets aren't type-checkable outside the build (coenttb/work#242)

---
 Sources/Zygomorphism Macro/Zygomorphism.swift | 2 +-
 Sources/Zygomorphism Macro/exports.swift      | 1 -
 2 files changed, 1 insertion(+), 2 deletions(-)
 delete mode 100644 Sources/Zygomorphism Macro/exports.swift

diff --git a/Sources/Zygomorphism Macro/Zygomorphism.swift b/Sources/Zygomorphism Macro/Zygomorphism.swift
index db7855f..8cf8c98 100644
--- a/Sources/Zygomorphism Macro/Zygomorphism.swift	
+++ b/Sources/Zygomorphism Macro/Zygomorphism.swift	
@@ -1,3 +1,3 @@
-import Product
+@_exported import Product
 @attached(member, names: arbitrary)
 public macro Zygomorphism() = #externalMacro(module: "Zygomorphism_Macro_Plugin", type: "Macro")
diff --git a/Sources/Zygomorphism Macro/exports.swift b/Sources/Zygomorphism Macro/exports.swift
deleted file mode 100644
index fd3bc8d..0000000
--- a/Sources/Zygomorphism Macro/exports.swift	
+++ /dev/null
@@ -1 +0,0 @@
-@_exported public import Product
