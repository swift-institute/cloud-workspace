From 0a89cc98270df33303d69e2a1dee890aaea5a83f Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:35:32 +0000
Subject: [PATCH 08/13] statement where expression fits: single-value if/else
 chains written as if expressions (type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 .../Plist.Binary.Serializer.swift             | 20 +++++++++----------
 1 file changed, 10 insertions(+), 10 deletions(-)

diff --git a/Sources/Plist Binary/Plist.Binary.Serializer.swift b/Sources/Plist Binary/Plist.Binary.Serializer.swift
index d39e2ae..d844173 100644
--- a/Sources/Plist Binary/Plist.Binary.Serializer.swift	
+++ b/Sources/Plist Binary/Plist.Binary.Serializer.swift	
@@ -126,24 +126,24 @@ extension Plist.Binary.Writer {
         let size: Int
 
         if value >= 0 {
-            if unsigned <= 0xFF {
-                size = 1
+            size = if unsigned <= 0xFF {
+                1
             } else if unsigned <= 0xFFFF {
-                size = 2
+                2
             } else if unsigned <= 0xFFFF_FFFF {
-                size = 4
+                4
             } else {
-                size = 8
+                8
             }
         } else {
-            if value >= Int8.min {
-                size = 1
+            size = if value >= Int8.min {
+                1
             } else if value >= Int16.min {
-                size = 2
+                2
             } else if value >= Int32.min {
-                size = 4
+                4
             } else {
-                size = 8
+                8
             }
         }
 
