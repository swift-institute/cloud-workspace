diff --git a/Sources/Plist/Plist.LocatedError.swift b/Sources/Plist/Plist.LocatedError.swift
new file mode 100644
index 0000000..ce18de4
--- /dev/null
+++ b/Sources/Plist/Plist.LocatedError.swift
@@ -0,0 +1,19 @@
+import Plist_Binary
+import Plist_Core
+import Plist_XML
+
+
+extension Plist {
+    public struct LocatedError: Swift.Error, Sendable, Hashable {
+
+        public let error: Plist.Error
+
+        public let offset: Int
+
+        @inlinable
+        public init(_ error: Plist.Error, at offset: Int) {
+            self.error = error
+            self.offset = offset
+        }
+    }
+}
diff --git a/Sources/Plist/Plist.ND.State.swift b/Sources/Plist/Plist.ND.State.swift
new file mode 100644
index 0000000..cee6196
--- /dev/null
+++ b/Sources/Plist/Plist.ND.State.swift
@@ -0,0 +1,22 @@
+public import Async_Stream
+
+
+extension Plist.ND {
+    @usableFromInline
+    internal final class State<I: AsyncIteratorProtocol>: @unchecked Sendable
+    where I.Element == UInt8 {
+        @usableFromInline
+        var iterator: I
+
+        @usableFromInline
+        var buffer: [UInt8] = []
+
+        @usableFromInline
+        var done = false
+
+        @usableFromInline
+        init(_ iterator: I) {
+            self.iterator = iterator
+        }
+    }
+}
