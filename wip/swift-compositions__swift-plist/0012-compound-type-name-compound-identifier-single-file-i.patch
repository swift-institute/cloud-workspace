From 7b1d875ccfd2facba9a88d83adab525178d8f09a Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:32:52 +0000
Subject: [PATCH 12/19] compound type name, compound identifier: single-file
 internal types made fileprivate, package members used only in their target
 made internal (type-check follows; Linux x86_64, Swift 6.4.2)
 (coenttb/work#242)

---
 Sources/Plist Binary/Plist.Binary.Marker.swift | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/Sources/Plist Binary/Plist.Binary.Marker.swift b/Sources/Plist Binary/Plist.Binary.Marker.swift
index 12f8f76..dfedbdd 100644
--- a/Sources/Plist Binary/Plist.Binary.Marker.swift	
+++ b/Sources/Plist Binary/Plist.Binary.Marker.swift	
@@ -39,12 +39,12 @@ extension Plist.Binary.Marker {
 extension Plist.Binary.Marker {
 
     @inlinable
-    package static func highNibble(_ byte: UInt8) -> UInt8 {
+    static func highNibble(_ byte: UInt8) -> UInt8 {
         byte & 0xF0
     }
 
     @inlinable
-    package static func lowNibble(_ byte: UInt8) -> UInt8 {
+    static func lowNibble(_ byte: UInt8) -> UInt8 {
         byte & 0x0F
     }
 
