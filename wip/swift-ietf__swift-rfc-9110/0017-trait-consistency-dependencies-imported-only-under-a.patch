From 9e23152d7951ebd7b4f568a1a063d2fa45624705 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:24:52 +0000
Subject: [PATCH 17/19] trait consistency: dependencies imported only under a
 trait get that trait's condition (runner repair; Linux x86_64, Swift 6.4.2)
 (coenttb/work#242)

---
 Package.swift | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Package.swift b/Package.swift
index 2c76567..82b3fc1 100644
--- a/Package.swift
+++ b/Package.swift
@@ -86,7 +86,7 @@ let package = Package(
                 .product(name: "RFC 5322", package: "swift-rfc-5322"),
                 .product(
                     name: "Standard Library Extensions",
-                    package: "swift-standard-library-extensions"
+                    package: "swift-standard-library-extensions", condition: .when(traits: ["Coder"])
                 ),
                 .product(name: "Coder", package: "swift-coder", condition: .when(traits: ["Coder"])),
                 .product(name: "Cursor", package: "swift-cursor", condition: .when(traits: ["Coder"])),
