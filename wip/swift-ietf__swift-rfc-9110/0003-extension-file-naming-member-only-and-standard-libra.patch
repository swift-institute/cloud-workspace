From 5ee5078afbd9c15e95cff742264bb2cba9f12472 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 20:52:53 +0000
Subject: [PATCH 3/7] extension file naming: member-only and
 standard-library-conformance extension files merge into their type's own file
 (overnight/merge-extension-files.py); single type per file: additional types
 move to their own <Parent>.<Name>.swift inside the container's extension
 (overnight/split-types.py); parse-checked; builds pending (coenttb/work#242)

---
 Sources/RFC 9110/HTTP.Token.swift           | 5 -----
 Sources/RFC 9110/RFC_9110.Token.Error.swift | 7 +++++++
 2 files changed, 7 insertions(+), 5 deletions(-)
 create mode 100644 Sources/RFC 9110/RFC_9110.Token.Error.swift

diff --git a/Sources/RFC 9110/HTTP.Token.swift b/Sources/RFC 9110/HTTP.Token.swift
index 384f23a..52bb18c 100644
--- a/Sources/RFC 9110/HTTP.Token.swift	
+++ b/Sources/RFC 9110/HTTP.Token.swift	
@@ -19,11 +19,6 @@ extension RFC_9110 {
 }
 
 extension RFC_9110.Token {
-
-    public enum Error: Swift::Error, Equatable {
-        case empty
-        case invalidCharacter(UInt8)
-    }
 }
 
 extension RFC_9110.Token {
diff --git a/Sources/RFC 9110/RFC_9110.Token.Error.swift b/Sources/RFC 9110/RFC_9110.Token.Error.swift
new file mode 100644
index 0000000..a80c125
--- /dev/null
+++ b/Sources/RFC 9110/RFC_9110.Token.Error.swift	
@@ -0,0 +1,7 @@
+
+extension RFC_9110.Token {
+    public enum Error: Swift::Error, Equatable {
+        case empty
+        case invalidCharacter(UInt8)
+    }
+}
