From ec36e4a76605aa2d54b90443aed47c0257fb9b87 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 18:48:49 +0000
Subject: [PATCH] compound suite name: narrative suites move into extension
 <Type> named after their test file, nested suites into extension
 <Type>.<Parent> (overnight/compound-suites.py); parse-checked; builds pending
 (coenttb/work#242)

---
 Tests/Angle Tests/Angle.Phase Tests.swift | 22 ++++++++++++----------
 1 file changed, 12 insertions(+), 10 deletions(-)

diff --git a/Tests/Angle Tests/Angle.Phase Tests.swift b/Tests/Angle Tests/Angle.Phase Tests.swift
index 2efdfa8..1c927e6 100644
--- a/Tests/Angle Tests/Angle.Phase Tests.swift	
+++ b/Tests/Angle Tests/Angle.Phase Tests.swift	
@@ -1,17 +1,19 @@
 import Angle
 import Testing
 
-@Suite struct `Angles normalize equivalent turns to the same phase` {
-    @Test func `Equivalent turns have the same phase`() {
-        #expect(Angle.Phase(degrees: 450) == .quarter)
-        #expect(Angle.Phase(degrees: -90) == .threeQuarter)
-        #expect(Angle.Phase(degrees: -360) == .zero)
-        #expect(Angle.Phase(degrees: 45) == nil)
-    }
+extension Angle.Phase {
+    @Suite struct `Angles normalize equivalent turns to the same phase` {
+        @Test func `Equivalent turns have the same phase`() {
+            #expect(Angle.Phase(degrees: 450) == .quarter)
+            #expect(Angle.Phase(degrees: -90) == .threeQuarter)
+            #expect(Angle.Phase(degrees: -360) == .zero)
+            #expect(Angle.Phase(degrees: 45) == nil)
+        }
 
-    @Test func `Every phase round trips through degrees`() {
-        for phase in Angle.Phase.allCases {
-            #expect(Angle.Phase(degrees: phase.degrees) == phase)
+        @Test func `Every phase round trips through degrees`() {
+            for phase in Angle.Phase.allCases {
+                #expect(Angle.Phase(degrees: phase.degrees) == phase)
+            }
         }
     }
 }
