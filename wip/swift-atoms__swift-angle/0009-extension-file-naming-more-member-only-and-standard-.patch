 create mode 100644 Sources/Angle/Angle.Degree.Full.swift
 create mode 100644 Sources/Angle/Angle.Degree.Straight.swift
 create mode 100644 Sources/Angle/Angle.Degree.swift
 create mode 100644 Sources/Angle/Angle.Radian.swift

diff --git a/Sources/Angle/Angle.Degree.Full.swift b/Sources/Angle/Angle.Degree.Full.swift
new file mode 100644
index 0000000..f31fa99
--- /dev/null
+++ b/Sources/Angle/Angle.Degree.Full.swift
@@ -0,0 +1,12 @@
