+            case nonfinite
+        }
+
         public init(
             start: Angle.Radian.Value<Scalar>,
             amount: Angle.Radian.Value<Scalar>
@@ -18,12 +23,6 @@ extension Angle {
     }
 }
 
-extension Angle.Sweep {
-    public enum Error: Swift::Error, Equatable, Sendable {
-        case nonfinite
-    }
-}
-
