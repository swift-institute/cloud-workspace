From 086d6f036493ebe8afda346c1d5a6090b11b9994 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 23:28:20 +0000
Subject: [PATCH 7/8] minimal type body: more non-stored members move into
 extensions of their type (overnight/minimal-bodies.py); type-checked, failing
 files left out (coenttb/work#242)

---
 Sources/Angle/Angle.Sweep.swift | 11 ++++---
 Sources/Angle/Radian.swift      | 54 +++++++++++++++------------------
 2 files changed, 30 insertions(+), 35 deletions(-)

diff --git a/Sources/Angle/Angle.Sweep.swift b/Sources/Angle/Angle.Sweep.swift
index 32190c5..ff6ec3c 100644
--- a/Sources/Angle/Angle.Sweep.swift
+++ b/Sources/Angle/Angle.Sweep.swift
@@ -1,15 +1,10 @@
 public import Tagged
 
 extension Angle {
-
     public struct Sweep<Scalar: BinaryFloatingPoint> {
         public let start: Angle.Radian.Value<Scalar>
         public let amount: Angle.Radian.Value<Scalar>
 
-        public enum Error: Swift::Error, Equatable, Sendable {
-            case nonfinite
-        }
-
         public init(
             start: Angle.Radian.Value<Scalar>,
             amount: Angle.Radian.Value<Scalar>
@@ -23,6 +18,12 @@ extension Angle {
     }
 }
 
+extension Angle.Sweep {
+    public enum Error: Swift::Error, Equatable, Sendable {
+        case nonfinite
+    }
+}
+
 extension Angle.Sweep {
     public var end: Angle.Radian.Value<Scalar> {
         .init(_unchecked: start.underlying + amount.underlying)
diff --git a/Sources/Angle/Radian.swift b/Sources/Angle/Radian.swift
index 86ba3d2..545a430 100644
--- a/Sources/Angle/Radian.swift
+++ b/Sources/Angle/Radian.swift
@@ -4,7 +4,6 @@ public import Tagged
 public typealias Radian<Scalar> = Angle.Radian.Value<Scalar>
 
 extension Tagged::Tagged where Tag == Angle.Radian, Underlying: BinaryFloatingPoint {
-
     @inlinable
     public static var zero: Self { Self(_unchecked: .zero) }
 
@@ -13,44 +12,44 @@ extension Tagged::Tagged where Tag == Angle.Radian, Underlying: BinaryFloatingPo
 }
 
 extension Angle.Radian {
-
     public struct Pi<Scalar: BinaryFloatingPoint>: Sendable {
         @usableFromInline
         internal init() {}
+    }
+}
 
-        @inlinable
-        public var full: Radian<Scalar> { Radian(_unchecked: .pi) }
-
-        @inlinable
-        public var half: Radian<Scalar> { Radian(_unchecked: .pi / 2) }
+extension Angle.Radian.Pi {
+    @inlinable
+    public var full: Radian<Scalar> { Radian(_unchecked: .pi) }
 
-        @inlinable
-        public var quarter: Radian<Scalar> { Radian(_unchecked: .pi / 4) }
+    @inlinable
+    public var half: Radian<Scalar> { Radian(_unchecked: .pi / 2) }
 
-        @inlinable
-        public var two: Radian<Scalar> { Radian(_unchecked: .pi * 2) }
+    @inlinable
+    public var quarter: Radian<Scalar> { Radian(_unchecked: .pi / 4) }
 
-        @inlinable
-        public var third: Radian<Scalar> { Radian(_unchecked: .pi / 3) }
+    @inlinable
+    public var two: Radian<Scalar> { Radian(_unchecked: .pi * 2) }
 
-        @inlinable
-        public var sixth: Radian<Scalar> { Radian(_unchecked: .pi / 6) }
+    @inlinable
+    public var third: Radian<Scalar> { Radian(_unchecked: .pi / 3) }
 
-        public func fraction(_ coefficient: Rational) -> Radian<Scalar> {
-            let value = coefficient.scaledApproximation(as: Scalar.self)
-            return Radian(
-                _unchecked: Scalar(
-                    sign: .plus,
-                    exponent: Scalar.Exponent(clamping: value.exponent),
-                    significand: .pi * value.significand
-                )
+    @inlinable
+    public var sixth: Radian<Scalar> { Radian(_unchecked: .pi / 6) }
+
+    public func fraction(_ coefficient: Rational) -> Radian<Scalar> {
+        let value = coefficient.scaledApproximation(as: Scalar.self)
+        return Radian(
+            _unchecked: Scalar(
+                sign: .plus,
+                exponent: Scalar.Exponent(clamping: value.exponent),
+                significand: .pi * value.significand
             )
-        }
+        )
     }
 }
 
 extension Tagged::Tagged where Tag == Angle.Radian, Underlying: AdditiveArithmetic {
-
     @inlinable
     public static func + (lhs: Self, rhs: Self) -> Self {
         Self(_unchecked: lhs.underlying + rhs.underlying)
@@ -63,7 +62,6 @@ extension Tagged::Tagged where Tag == Angle.Radian, Underlying: AdditiveArithmet
 }
 
 extension Tagged::Tagged where Tag == Angle.Radian, Underlying: Swift::Numeric {
-
     @_disfavoredOverload
     @inlinable
     public static func * (lhs: Self, rhs: Underlying) -> Self {
@@ -78,7 +76,6 @@ extension Tagged::Tagged where Tag == Angle.Radian, Underlying: Swift::Numeric {
 }
 
 extension Tagged::Tagged where Tag == Angle.Radian, Underlying: FloatingPoint {
-
     @inlinable
     public static func / (lhs: Self, rhs: Underlying) -> Self {
         Self(_unchecked: lhs.underlying / rhs)
@@ -86,7 +83,6 @@ extension Tagged::Tagged where Tag == Angle.Radian, Underlying: FloatingPoint {
 }
 
 extension Tagged::Tagged where Tag == Angle.Radian, Underlying: SignedNumeric {
-
     @inlinable
     public static prefix func - (value: Self) -> Self {
         value.map { -$0 }
@@ -94,7 +90,6 @@ extension Tagged::Tagged where Tag == Angle.Radian, Underlying: SignedNumeric {
 }
 
 extension Tagged::Tagged where Tag == Angle.Radian, Underlying: BinaryFloatingPoint {
-
     @inlinable
     public init(degrees: Degree<Underlying>) {
         self.init(_unchecked: degrees.underlying * .pi / 180)
@@ -102,7 +97,6 @@ extension Tagged::Tagged where Tag == Angle.Radian, Underlying: BinaryFloatingPo
 }
 
 extension Tagged::Tagged where Tag == Angle.Radian, Underlying: BinaryFloatingPoint {
-
     @inlinable
     public var degrees: Degree<Underlying> {
         Degree(radians: self)
