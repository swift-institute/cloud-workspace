From ddeef775dda9c602459a93e67ee933be5205381d Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 20:52:52 +0000
Subject: [PATCH 2/5] extension file naming: member-only and
 standard-library-conformance extension files merge into their type's own file
 (overnight/merge-extension-files.py); single type per file: additional types
 move to their own <Parent>.<Name>.swift inside the container's extension
 (overnight/split-types.py); parse-checked; builds pending (coenttb/work#242)

---
 Sources/RFC 3987/IRI.swift                        |  5 -----
 Sources/RFC 3987/RFC_3987.IRI.Representable.swift | 10 ++++++++++
 2 files changed, 10 insertions(+), 5 deletions(-)
 create mode 100644 Sources/RFC 3987/RFC_3987.IRI.Representable.swift

diff --git a/Sources/RFC 3987/IRI.swift b/Sources/RFC 3987/IRI.swift
index 281c19e..7c64c53 100644
--- a/Sources/RFC 3987/IRI.swift	
+++ b/Sources/RFC 3987/IRI.swift	
@@ -94,11 +94,6 @@ extension RFC_3987.IRI: ASCII.Parseable {
 }
 
 extension RFC_3987.IRI {
-
-    public protocol Representable {
-
-        var iri: RFC_3987.IRI { get }
-    }
 }
 
 extension RFC_3987 {
diff --git a/Sources/RFC 3987/RFC_3987.IRI.Representable.swift b/Sources/RFC 3987/RFC_3987.IRI.Representable.swift
new file mode 100644
index 0000000..df3dfb2
--- /dev/null
+++ b/Sources/RFC 3987/RFC_3987.IRI.Representable.swift	
@@ -0,0 +1,10 @@
+public import ASCII
+public import Binary
+
+
+extension RFC_3987.IRI {
+    public protocol Representable {
+
+        var iri: RFC_3987.IRI { get }
+    }
+}
