From bde926b69fca30496f0e88d2bd827d2cd542bdff Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:35:31 +0000
Subject: [PATCH 14/17] statement where expression fits: single-value if/else
 chains written as if expressions (type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 Sources/ISO 14496-22/FontFile+Parsing.swift | 20 ++++++++++----------
 1 file changed, 10 insertions(+), 10 deletions(-)

diff --git a/Sources/ISO 14496-22/FontFile+Parsing.swift b/Sources/ISO 14496-22/FontFile+Parsing.swift
index ff00a50..6a4eb25 100644
--- a/Sources/ISO 14496-22/FontFile+Parsing.swift	
+++ b/Sources/ISO 14496-22/FontFile+Parsing.swift	
@@ -261,18 +261,18 @@ extension ISO_14496_22.FontFile {
             encodingRecords.append(record)
 
             let priority: Int
-            if platformID == 3 && encodingID == 10 {
-                priority = 4
+            priority = if platformID == 3 && encodingID == 10 {
+                4
             } else if platformID == 3 && encodingID == 1 {
-                priority = 3
+                3
             } else if platformID == 0 && encodingID == 4 {
-                priority = 2
+                2
             } else if platformID == 0 && encodingID == 3 {
-                priority = 1
+                1
             } else if platformID == 0 {
-                priority = 0
+                0
             } else {
-                priority = -1
+                -1
             }
 
             if priority > bestPriority {
@@ -350,10 +350,10 @@ extension ISO_14496_22.FontFile {
                         idRangeOffsetOffset + i * 2 + Int(idRangeOffset) + Int(code - startCode) * 2
                     if glyphIdOffset + 2 <= data.count {
                         let glyphId = readUInt16(data, at: glyphIdOffset)
-                        if glyphId != 0 {
-                            glyphIndex = UInt16(truncatingIfNeeded: Int(glyphId) + Int(idDelta))
+                        glyphIndex = if glyphId != 0 {
+                            UInt16(truncatingIfNeeded: Int(glyphId) + Int(idDelta))
                         } else {
-                            glyphIndex = 0
+                            0
                         }
                     } else {
                         glyphIndex = 0
