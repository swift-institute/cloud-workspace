From 78f06978e4a041c49e1c9425113393d3d7c3d7b9 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:17:16 +0000
Subject: [PATCH 16/17] minimal type body: more non-stored members moved into
 an extension of their type (batch 18; type-check follows; Linux x86_64, Swift
 6.4.2) (coenttb/work#242)

---
 .../Tables/ISO_14496_22.Fixed.swift            |  8 +++++---
 .../Tables/ISO_14496_22.HeadTable.Flags.swift  | 14 ++++++++------
 .../ISO_14496_22.HeadTable.MacStyle.swift      | 18 ++++++++++--------
 3 files changed, 23 insertions(+), 17 deletions(-)

diff --git a/Sources/ISO 14496-22/Tables/ISO_14496_22.Fixed.swift b/Sources/ISO 14496-22/Tables/ISO_14496_22.Fixed.swift
index 7e4f78c..75a2b64 100644
--- a/Sources/ISO 14496-22/Tables/ISO_14496_22.Fixed.swift	
+++ b/Sources/ISO 14496-22/Tables/ISO_14496_22.Fixed.swift	
@@ -13,9 +13,11 @@ extension ISO_14496_22 {
             self.integer = Int16(truncatingIfNeeded: rawValue >> 16)
             self.fraction = UInt16(truncatingIfNeeded: rawValue & 0xFFFF)
         }
+    }
+}
 
-        public var doubleValue: Double {
-            Double(integer) + Double(fraction) / 65536.0
-        }
+extension ISO_14496_22.Fixed {
+    public var doubleValue: Double {
+        Double(integer) + Double(fraction) / 65536.0
     }
 }
diff --git a/Sources/ISO 14496-22/Tables/ISO_14496_22.HeadTable.Flags.swift b/Sources/ISO 14496-22/Tables/ISO_14496_22.HeadTable.Flags.swift
index f6d3a87..7e3e84b 100644
--- a/Sources/ISO 14496-22/Tables/ISO_14496_22.HeadTable.Flags.swift	
+++ b/Sources/ISO 14496-22/Tables/ISO_14496_22.HeadTable.Flags.swift	
@@ -6,15 +6,17 @@ extension ISO_14496_22.HeadTable {
         public init(rawValue: UInt16) {
             self.rawValue = rawValue
         }
+    }
+}
 
-        public static let baselineAtY0 = Flags(rawValue: 1 << 0)
+extension ISO_14496_22.HeadTable.Flags {
+    public static let baselineAtY0 = Flags(rawValue: 1 << 0)
 
-        public static let leftSidebearingAtX0 = Flags(rawValue: 1 << 1)
+    public static let leftSidebearingAtX0 = Flags(rawValue: 1 << 1)
 
-        public static let instructionsDependOnPointSize = Flags(rawValue: 1 << 2)
+    public static let instructionsDependOnPointSize = Flags(rawValue: 1 << 2)
 
-        public static let forcePPEMToInteger = Flags(rawValue: 1 << 3)
+    public static let forcePPEMToInteger = Flags(rawValue: 1 << 3)
 
-        public static let instructionsMayAlterAdvanceWidth = Flags(rawValue: 1 << 4)
-    }
+    public static let instructionsMayAlterAdvanceWidth = Flags(rawValue: 1 << 4)
 }
diff --git a/Sources/ISO 14496-22/Tables/ISO_14496_22.HeadTable.MacStyle.swift b/Sources/ISO 14496-22/Tables/ISO_14496_22.HeadTable.MacStyle.swift
index 9d9b372..ca91d8b 100644
--- a/Sources/ISO 14496-22/Tables/ISO_14496_22.HeadTable.MacStyle.swift	
+++ b/Sources/ISO 14496-22/Tables/ISO_14496_22.HeadTable.MacStyle.swift	
@@ -6,19 +6,21 @@ extension ISO_14496_22.HeadTable {
         public init(rawValue: UInt16) {
             self.rawValue = rawValue
         }
+    }
+}
 
-        public static let bold = MacStyle(rawValue: 1 << 0)
+extension ISO_14496_22.HeadTable.MacStyle {
+    public static let bold = MacStyle(rawValue: 1 << 0)
 
-        public static let italic = MacStyle(rawValue: 1 << 1)
+    public static let italic = MacStyle(rawValue: 1 << 1)
 
-        public static let underline = MacStyle(rawValue: 1 << 2)
+    public static let underline = MacStyle(rawValue: 1 << 2)
 
-        public static let outline = MacStyle(rawValue: 1 << 3)
+    public static let outline = MacStyle(rawValue: 1 << 3)
 
-        public static let shadow = MacStyle(rawValue: 1 << 4)
+    public static let shadow = MacStyle(rawValue: 1 << 4)
 
-        public static let condensed = MacStyle(rawValue: 1 << 5)
+    public static let condensed = MacStyle(rawValue: 1 << 5)
 
-        public static let extended = MacStyle(rawValue: 1 << 6)
-    }
+    public static let extended = MacStyle(rawValue: 1 << 6)
 }
