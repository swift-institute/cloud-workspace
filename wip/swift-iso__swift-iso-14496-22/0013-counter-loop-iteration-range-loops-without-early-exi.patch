Subject: [PATCH 13/18] counter loop iteration: range loops without early exit
 written as forEach (type-check follows; Linux x86_64, Swift 6.4.2)
 (coenttb/work#242)

---
 Sources/ISO 14496-22/FontFile+Parsing.swift | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Sources/ISO 14496-22/FontFile+Parsing.swift b/Sources/ISO 14496-22/FontFile+Parsing.swift
index cd346fe..ff00a50 100644
--- a/Sources/ISO 14496-22/FontFile+Parsing.swift	
+++ b/Sources/ISO 14496-22/FontFile+Parsing.swift	
@@ -391,7 +391,7 @@ extension ISO_14496_22.FontFile {
             let endCharCode = readUInt32(data, at: groupOffset + 4)
             let startGlyphID = readUInt32(data, at: groupOffset + 8)
 
-            for code in startCharCode...endCharCode {
+            (startCharCode...endCharCode).forEach { code in
                 let glyphIndex = UInt16(truncatingIfNeeded: startGlyphID + (code - startCharCode))
                 if glyphIndex != 0 {
                     mapping[code] = glyphIndex
