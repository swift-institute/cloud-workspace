diff --git a/Sources/Complex/Complex.Number.swift b/Sources/Complex/Complex.Number.swift
new file mode 100644
index 0000000..ba97083
--- /dev/null
+++ b/Sources/Complex/Complex.Number.swift
@@ -0,0 +1,15 @@
+
+extension Complex {
+    public struct Number<Scalar>: Sendable where Scalar: Sendable {
+
+        public var real: Real<Scalar>
+
+        public var imaginary: Imaginary<Scalar>
+
+        @inlinable
+        public init(real: Real<Scalar>, imaginary: Imaginary<Scalar>) {
+            self.real = real
+            self.imaginary = imaginary
+        }
+    }
+}
