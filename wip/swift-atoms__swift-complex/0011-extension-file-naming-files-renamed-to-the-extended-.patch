Date: Sun, 8 Nov 2026 03:43:38 +0000
Subject: [PATCH 11/12] extension file naming: files renamed to the extended
 type's own name or the 'T where <clause>' shape (renames only; Linux x86_64,
 Swift 6.4.2) (coenttb/work#242)

---
 ...> Complex.Imaginary where Scalar is BinaryFloatingPoint.swift} | 0
 ... Scalar is BinaryFloatingPoint & Exponential.`Protocol`.swift} | 0
 ...t => Complex.Number where Scalar is BinaryFloatingPoint.swift} | 0
 ...oint & Trigonometry.`Protocol` & Exponential.`Protocol`.swift} | 0
 ...ift => Complex.Real where Scalar is BinaryFloatingPoint.swift} | 0
 .../Complex/{Swift.Double+Complex.swift => Swift.Double.swift}    | 0
 Sources/Complex/{Swift.Float+Complex.swift => Swift.Float.swift}  | 0
 7 files changed, 0 insertions(+), 0 deletions(-)
 rename Sources/Complex/{Complex.Imaginary+Arithmetic.swift => Complex.Imaginary where Scalar is BinaryFloatingPoint.swift} (100%)
 rename Sources/Complex/{Complex.Number+Exponential.swift => Complex.Number where Scalar is BinaryFloatingPoint & Exponential.`Protocol`.swift} (100%)
 rename Sources/Complex/{Complex+Arithmetic.swift => Complex.Number where Scalar is BinaryFloatingPoint.swift} (100%)
 rename Sources/Complex/{Complex.Math.Hyperbolic.swift => Complex.Number.Math where Scalar is BinaryFloatingPoint & Trigonometry.`Protocol` & Exponential.`Protocol`.swift} (100%)
 rename Sources/Complex/{Complex.Real+Arithmetic.swift => Complex.Real where Scalar is BinaryFloatingPoint.swift} (100%)
 rename Sources/Complex/{Swift.Double+Complex.swift => Swift.Double.swift} (100%)
 rename Sources/Complex/{Swift.Float+Complex.swift => Swift.Float.swift} (100%)

diff --git a/Sources/Complex/Complex.Imaginary+Arithmetic.swift b/Sources/Complex/Complex.Imaginary where Scalar is BinaryFloatingPoint.swift
similarity index 100%
rename from Sources/Complex/Complex.Imaginary+Arithmetic.swift
rename to Sources/Complex/Complex.Imaginary where Scalar is BinaryFloatingPoint.swift
diff --git a/Sources/Complex/Complex.Number+Exponential.swift b/Sources/Complex/Complex.Number where Scalar is BinaryFloatingPoint & Exponential.`Protocol`.swift
similarity index 100%
rename from Sources/Complex/Complex.Number+Exponential.swift
rename to Sources/Complex/Complex.Number where Scalar is BinaryFloatingPoint & Exponential.`Protocol`.swift
diff --git a/Sources/Complex/Complex+Arithmetic.swift b/Sources/Complex/Complex.Number where Scalar is BinaryFloatingPoint.swift
similarity index 100%
rename from Sources/Complex/Complex+Arithmetic.swift
rename to Sources/Complex/Complex.Number where Scalar is BinaryFloatingPoint.swift
diff --git a/Sources/Complex/Complex.Math.Hyperbolic.swift b/Sources/Complex/Complex.Number.Math where Scalar is BinaryFloatingPoint & Trigonometry.`Protocol` & Exponential.`Protocol`.swift
similarity index 100%
rename from Sources/Complex/Complex.Math.Hyperbolic.swift
rename to Sources/Complex/Complex.Number.Math where Scalar is BinaryFloatingPoint & Trigonometry.`Protocol` & Exponential.`Protocol`.swift
diff --git a/Sources/Complex/Complex.Real+Arithmetic.swift b/Sources/Complex/Complex.Real where Scalar is BinaryFloatingPoint.swift
similarity index 100%
rename from Sources/Complex/Complex.Real+Arithmetic.swift
rename to Sources/Complex/Complex.Real where Scalar is BinaryFloatingPoint.swift
diff --git a/Sources/Complex/Swift.Double+Complex.swift b/Sources/Complex/Swift.Double.swift
similarity index 100%
rename from Sources/Complex/Swift.Double+Complex.swift
rename to Sources/Complex/Swift.Double.swift
diff --git a/Sources/Complex/Swift.Float+Complex.swift b/Sources/Complex/Swift.Float.swift
similarity index 100%
rename from Sources/Complex/Swift.Float+Complex.swift
rename to Sources/Complex/Swift.Float.swift
