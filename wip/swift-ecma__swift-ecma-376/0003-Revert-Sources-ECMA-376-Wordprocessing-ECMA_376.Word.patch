 1 file changed, 6 insertions(+), 6 deletions(-)

diff --git a/Sources/ECMA 376 Wordprocessing/ECMA_376.Wordprocessing+Markup.swift b/Sources/ECMA 376 Wordprocessing/ECMA_376.Wordprocessing+Markup.swift
index 64eae25..110e9d5 100644
