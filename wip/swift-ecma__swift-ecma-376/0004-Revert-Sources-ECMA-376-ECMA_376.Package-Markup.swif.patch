---
 Sources/ECMA 376/ECMA_376.Package+Markup.swift | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/Sources/ECMA 376/ECMA_376.Package+Markup.swift b/Sources/ECMA 376/ECMA_376.Package+Markup.swift
index a7fdb02..5c69303 100644
--- a/Sources/ECMA 376/ECMA_376.Package+Markup.swift	
+++ b/Sources/ECMA 376/ECMA_376.Package+Markup.swift	
@@ -1,10 +1,10 @@
 public import W3C_XML
 
 extension ECMA_376.Package {
-    public func markup(_ name: ECMA_376.Part.Name) throws(ECMA_376.Package.Error) -> W3C_XML::Element {
+    public func markup(_ name: ECMA_376.Part.Name) throws(ECMA_376.Package.Error) -> W3C_XML.Element {
         let bytes = try part(name)
-        do throws(W3C_XML::Parse.Error) {
-            return try W3C_XML::parse(bytes.map(\.underlying)).root
+        do throws(W3C_XML.Parse.Error) {
+            return try W3C_XML.parse(bytes.map(\.underlying)).root
         } catch {
             throw .markup(error)
         }
