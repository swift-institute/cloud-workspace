 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/Sources/ECMA 376 Wordprocessing/ECMA_376.Wordprocessing.Document.Source.swift b/Sources/ECMA 376 Wordprocessing/ECMA_376.Wordprocessing.Document.Source.swift
index 380a9cd..510d3c2 100644
