From a5d149e989064d158ef46a47b20e8a15197d4c5c Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:24:51 +0000
Subject: [PATCH 6/7] trait consistency: dependencies imported only under a
 trait get that trait's condition (runner repair; Linux x86_64, Swift 6.4.2)
 (coenttb/work#242)

---
 Package.swift | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/Package.swift b/Package.swift
index c16b210..f906055 100644
--- a/Package.swift
+++ b/Package.swift
@@ -53,8 +53,8 @@ let package = Package(
         .target(
             name: "Text",
             dependencies: [
-                .product(name: "Byte", package: "swift-byte"),
-                .product(name: "Ownership", package: "swift-ownership"),
+                .product(name: "Byte", package: "swift-byte", condition: .when(traits: ["Byte", "Ownership"])),
+                .product(name: "Ownership", package: "swift-ownership", condition: .when(traits: ["Ownership"])),
                 .product(name: "Carrier", package: "swift-carrier"),
                 .product(name: "Difference", package: "swift-difference"),
                 .product(name: "Cardinal", package: "swift-cardinal"),
@@ -84,8 +84,8 @@ let package = Package(
         .testTarget(
             name: "Text Tests",
             dependencies: [
-                .product(name: "Byte", package: "swift-byte"),
-                .product(name: "Ownership", package: "swift-ownership"),
+                .product(name: "Byte", package: "swift-byte", condition: .when(traits: ["Byte", "Ownership"])),
+                .product(name: "Ownership", package: "swift-ownership", condition: .when(traits: ["Ownership"])),
                 .target(name: "Text"),
                 .target(name: "Text Test Support"),
                 .product(name: "Difference", package: "swift-difference"),
