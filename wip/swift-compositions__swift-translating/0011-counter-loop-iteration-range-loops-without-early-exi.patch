Subject: [PATCH 11/14] counter loop iteration: range loops without early exit
 written as forEach (type-check follows; Linux x86_64, Swift 6.4.2)
 (coenttb/work#242)

---
 Tests/Translating Dependencies Tests/Performance Tests.swift | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Tests/Translating Dependencies Tests/Performance Tests.swift b/Tests/Translating Dependencies Tests/Performance Tests.swift
index 242a6c4..0031a15 100644
--- a/Tests/Translating Dependencies Tests/Performance Tests.swift	
+++ b/Tests/Translating Dependencies Tests/Performance Tests.swift	
@@ -159,7 +159,7 @@ extension Performance {
                     var translatedStrings: [Translated<String>] = []
                     translatedStrings.reserveCapacity(stringCount)
 
-                    for i in 1...stringCount {
+                    (1...stringCount).forEach { i in
                         let translated = Translated<String> { language in
                             "String \(i) in \(language)"
                         }
