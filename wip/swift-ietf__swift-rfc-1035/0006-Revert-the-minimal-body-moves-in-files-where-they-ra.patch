Subject: [PATCH 6/9] Revert the minimal-body moves in files where they raised
 a rule over its ratchet limit (coenttb/work#242)

---
 .../RFC_1035.Message.Coder.swift              | 108 +++++++++---------
 1 file changed, 54 insertions(+), 54 deletions(-)

diff --git a/Sources/RFC 1035/Absorbed swift-rfc-1035-coder/RFC_1035.Message.Coder.swift b/Sources/RFC 1035/Absorbed swift-rfc-1035-coder/RFC_1035.Message.Coder.swift
index 4374a5e..bd33125 100644
--- a/Sources/RFC 1035/Absorbed swift-rfc-1035-coder/RFC_1035.Message.Coder.swift	
+++ b/Sources/RFC 1035/Absorbed swift-rfc-1035-coder/RFC_1035.Message.Coder.swift	
@@ -7,65 +7,65 @@
     import Serializer
 
     extension RFC_1035.Message {
+
         public struct Coder<Input: Cursor.`Protocol`<Byte, Never>, Buffer: RangeReplaceableCollection<Byte>>: Coding {
+
+            public typealias Output = RFC_1035.Message
+
+            public typealias Failure = RFC_1035.Message.Failure
+
             public init() {}
-        }
 
-        public static var coder: Coder<ArraySlice<Byte>, [Byte]> { .init() }
-    }
+            public borrowing func parse(_ input: inout Input) throws(Failure) -> Output {
+                let start = input.checkpoint
+                var reader = RFC_1035.Wire.Reader(Scan.drain(&input))
+
+                do throws(Failure) {
+                    let id = try reader.uint16()
+                    let flags = try reader.uint16()
+                    let qdcount = Int(try reader.uint16())
+                    let ancount = Int(try reader.uint16())
+                    let nscount = Int(try reader.uint16())
+                    let arcount = Int(try reader.uint16())
+
+                    let header = try RFC_1035.Message.Header(id: id, flags: flags)
+
+                    var questions: [RFC_1035.Question] = []
+                    questions.reserveCapacity(qdcount)
+                    for _ in 0..<qdcount { questions.append(try reader.question()) }
 
