diff --git a/Sources/RFC 1035/Absorbed swift-rfc-1035-coder/RFC_1035.Domain.Coder.swift b/Sources/RFC 1035/Absorbed swift-rfc-1035-coder/RFC_1035.Domain.Coder.swift
index 24565fa..fb2af65 100644
--- a/Sources/RFC 1035/Absorbed swift-rfc-1035-coder/RFC_1035.Domain.Coder.swift	
+++ b/Sources/RFC 1035/Absorbed swift-rfc-1035-coder/RFC_1035.Domain.Coder.swift	
@@ -6,31 +6,31 @@
     import Serializer
 
     extension RFC_1035.Domain {
-
         public struct Coder<Input: Cursor.`Protocol`<Byte, Never>, Buffer: RangeReplaceableCollection<Byte>>: Coding {
+            public init() {}
+        }
 
-            public typealias Output = RFC_1035.Domain
+        public static var coder: Coder<ArraySlice<Byte>, [Byte]> { .init() }
+    }
 
-            public typealias Failure = RFC_1035.Domain.Error
+extension RFC_1035.Domain.Coder {
+        public typealias Output = RFC_1035.Domain
 
-            public init() {}
+        public typealias Failure = RFC_1035.Domain.Error
 
-            public borrowing func parse(_ input: inout Input) throws(Failure) -> Output {
-                let start = input.checkpoint
-                let bytes = Scan.run(&input) { byte in Scan.isPresentationByte(byte) || byte == 0x2E }
-                do throws(Failure) {
-                    return try RFC_1035.Domain(ascii: bytes)
-                } catch {
-                    input.seek(to: start)
-                    throw error
-                }
-            }
-
-            public borrowing func serialize(_ output: Output, into buffer: inout Buffer) throws(Failure) {
-                Scan.append(output.rawValue, into: &buffer)
+        public borrowing func parse(_ input: inout Input) throws(Failure) -> Output {
+            let start = input.checkpoint
+            let bytes = Scan.run(&input) { byte in Scan.isPresentationByte(byte) || byte == 0x2E }
+            do throws(Failure) {
+                return try RFC_1035.Domain(ascii: bytes)
+            } catch {
+                input.seek(to: start)
+                throw error
             }
         }
 
-        public static var coder: Coder<ArraySlice<Byte>, [Byte]> { .init() }
-    }
+        public borrowing func serialize(_ output: Output, into buffer: inout Buffer) throws(Failure) {
+            Scan.append(output.rawValue, into: &buffer)
+        }
+}
 #endif
diff --git a/Sources/RFC 1035/Absorbed swift-rfc-1035-coder/RFC_1035.Domain.Label.Coder.swift b/Sources/RFC 1035/Absorbed swift-rfc-1035-coder/RFC_1035.Domain.Label.Coder.swift
index 4da56f0..db086c2 100644
