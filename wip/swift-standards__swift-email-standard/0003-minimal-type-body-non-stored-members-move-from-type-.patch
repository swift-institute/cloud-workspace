From a5b5b2b7f37440bc5cfbe04c0dcd1cb12d2d07a1 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 22:39:56 +0000
Subject: [PATCH 3/6] minimal type body: non-stored members move from type
 bodies into an extension of the type in the same file
 (overnight/minimal-bodies.py); type-checked against the root build,
 directories that failed or couldn't be checked left out (coenttb/work#242)

---
 Sources/Email Standard/Email.swift | 68 +++++++++++++-----------------
 1 file changed, 30 insertions(+), 38 deletions(-)

diff --git a/Sources/Email Standard/Email.swift b/Sources/Email Standard/Email.swift
index 303fea0..16b0416 100644
--- a/Sources/Email Standard/Email.swift	
+++ b/Sources/Email Standard/Email.swift	
@@ -5,7 +5,6 @@ public import RFC_2046
 public import RFC_5322
 
 public struct Email: Hashable, Sendable, CustomDebugStringConvertible {
-
     public let to: [EmailAddress]
 
     public let from: EmailAddress
@@ -52,9 +51,7 @@ public struct Email: Hashable, Sendable, CustomDebugStringConvertible {
 }
 
 extension Email {
-
     public enum Error: Swift::Error, Hashable, Sendable {
-
         case emptyRecipients
 
         case multipart(RFC_2046.Multipart.Error)
@@ -74,52 +71,51 @@ extension Email.Error: CustomStringConvertible {
 }
 
 extension Email {
-
     public enum Body: Hashable, Sendable {
-
         case text([Byte], charset: RFC_2045.Charset)
 
         case html([Byte], charset: RFC_2045.Charset)
 
         case multipart(RFC_2046.Multipart)
+    }
+}
 
-        public var contentType: RFC_2045.ContentType {
-            switch self {
-            case .text(_, let charset):
-                return RFC_2045.ContentType(
-                    __unchecked: (),
-                    type: "text",
-                    subtype: "plain",
-                    parameters: [.charset: charset.rawValue]
-                )
-
-            case .html(_, let charset):
-                return RFC_2045.ContentType(
-                    __unchecked: (),
-                    type: "text",
-                    subtype: "html",
-                    parameters: [.charset: charset.rawValue]
-                )
-
-            case .multipart(let multipart):
-                return multipart.contentType
-            }
+extension Email.Body {
+    public var contentType: RFC_2045.ContentType {
+        switch self {
+        case .text(_, let charset):
+            return RFC_2045.ContentType(
+                __unchecked: (),
+                type: "text",
+                subtype: "plain",
+                parameters: [.charset: charset.rawValue]
+            )
+
+        case .html(_, let charset):
+            return RFC_2045.ContentType(
+                __unchecked: (),
+                type: "text",
+                subtype: "html",
+                parameters: [.charset: charset.rawValue]
+            )
+
+        case .multipart(let multipart):
+            return multipart.contentType
         }
+    }
 
-        public var transferEncoding: RFC_2045.ContentTransferEncoding? {
-            switch self {
-            case .text, .html:
-                return .sevenBit
+    public var transferEncoding: RFC_2045.ContentTransferEncoding? {
+        switch self {
+        case .text, .html:
+            return .sevenBit
 
-            case .multipart:
-                return nil
-            }
+        case .multipart:
+            return nil
         }
     }
 }
 
 extension Email.Body {
-
     public static func text(
         _ content: some StringProtocol,
         charset: RFC_2045.Charset = .utf8
@@ -144,14 +140,12 @@ extension Email.Body {
 }
 
 extension Email.Body: ExpressibleByStringLiteral {
-
     public init(stringLiteral value: String) {
         self = .text(value)
     }
 }
 
 extension Email {
-
     public init(
         to: [EmailAddress],
         from: EmailAddress,
@@ -215,7 +209,6 @@ extension Email {
 }
 
 extension Email {
-
     public var debugDescription: String {
         let recipients = to.map(\.address).joined(separator: ", ")
         var parts = ["From: \(from.address)", "To: \(recipients)"]
@@ -237,7 +230,6 @@ extension Email {
 }
 
 extension Email {
-
     public var allHeaders: [RFC_5322.Header] {
         var result = additionalHeaders
         result[.contentType] = body.contentType.description
-- 
2.43.0

