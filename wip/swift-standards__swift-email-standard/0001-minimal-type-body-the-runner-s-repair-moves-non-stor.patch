From d99a35d8682969041b8fa3650a29f1a431aea8cd Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 18:24:16 +0000
Subject: [PATCH 1/6] minimal type body: the runner's repair moves non-stored
 members out of type bodies into extensions; repair applied; root and test
 builds not yet run (coenttb/work#242)

---
 Sources/Email Standard/Email.swift | 21 ++++++++++++---------
 1 file changed, 12 insertions(+), 9 deletions(-)

diff --git a/Sources/Email Standard/Email.swift b/Sources/Email Standard/Email.swift
index 16ee58a..303fea0 100644
--- a/Sources/Email Standard/Email.swift	
+++ b/Sources/Email Standard/Email.swift	
@@ -49,15 +49,6 @@ public struct Email: Hashable, Sendable, CustomDebugStringConvertible {
         self.body = body
         self.additionalHeaders = additionalHeaders
     }
-
-    public var allHeaders: [RFC_5322.Header] {
-        var result = additionalHeaders
-        result[.contentType] = body.contentType.description
-        if let encoding = body.transferEncoding {
-            result[.contentTransferEncoding] = encoding.description
-        }
-        return result
-    }
 }
 
 extension Email {
@@ -244,3 +235,15 @@ extension Email {
         return parts.joined(separator: " ")
     }
 }
+
+extension Email {
+
+    public var allHeaders: [RFC_5322.Header] {
+        var result = additionalHeaders
+        result[.contentType] = body.contentType.description
+        if let encoding = body.transferEncoding {
+            result[.contentTransferEncoding] = encoding.description
+        }
+        return result
+    }
+}
