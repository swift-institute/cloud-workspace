From a10e5c28f2e0f6db51cd089da3968f5bf17dcc4c Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 01:37:32 +0000
Subject: [PATCH 4/7] extension file naming: more member-only and
 standard-library extension files merge into their type's file; single type
 per file: more additional types move to their own files
 (merge-extension-files.py, split-types.py); parse-checked; root build pending
 (coenttb/work#242)

---
 Sources/Email Standard/Email.Body.swift  | 16 ++++++++++++++++
 Sources/Email Standard/Email.Error.swift | 14 ++++++++++++++
 Sources/Email Standard/Email.swift       | 12 ------------
 3 files changed, 30 insertions(+), 12 deletions(-)
 create mode 100644 Sources/Email Standard/Email.Body.swift
 create mode 100644 Sources/Email Standard/Email.Error.swift

diff --git a/Sources/Email Standard/Email.Body.swift b/Sources/Email Standard/Email.Body.swift
new file mode 100644
index 0000000..6940ece
--- /dev/null
+++ b/Sources/Email Standard/Email.Body.swift	
@@ -0,0 +1,16 @@
+public import Byte
+public import EmailAddress_Standard
+public import RFC_2045
+public import RFC_2046
+public import RFC_5322
+
+
+extension Email {
+    public enum Body: Hashable, Sendable {
+        case text([Byte], charset: RFC_2045.Charset)
+
+        case html([Byte], charset: RFC_2045.Charset)
+
+        case multipart(RFC_2046.Multipart)
+    }
+}
diff --git a/Sources/Email Standard/Email.Error.swift b/Sources/Email Standard/Email.Error.swift
new file mode 100644
index 0000000..8543fbb
--- /dev/null
+++ b/Sources/Email Standard/Email.Error.swift	
@@ -0,0 +1,14 @@
+public import Byte
+public import EmailAddress_Standard
+public import RFC_2045
+public import RFC_2046
+public import RFC_5322
+
+
+extension Email {
+    public enum Error: Swift::Error, Hashable, Sendable {
+        case emptyRecipients
+
+        case multipart(RFC_2046.Multipart.Error)
+    }
+}
diff --git a/Sources/Email Standard/Email.swift b/Sources/Email Standard/Email.swift
index 16b0416..345909e 100644
--- a/Sources/Email Standard/Email.swift	
+++ b/Sources/Email Standard/Email.swift	
@@ -51,11 +51,6 @@ public struct Email: Hashable, Sendable, CustomDebugStringConvertible {
 }
 
 extension Email {
-    public enum Error: Swift::Error, Hashable, Sendable {
-        case emptyRecipients
-
-        case multipart(RFC_2046.Multipart.Error)
-    }
 }
 
 extension Email.Error: CustomStringConvertible {
@@ -71,13 +66,6 @@ extension Email.Error: CustomStringConvertible {
 }
 
 extension Email {
-    public enum Body: Hashable, Sendable {
-        case text([Byte], charset: RFC_2045.Charset)
-
-        case html([Byte], charset: RFC_2045.Charset)
-
-        case multipart(RFC_2046.Multipart)
-    }
 }
 
 extension Email.Body {
