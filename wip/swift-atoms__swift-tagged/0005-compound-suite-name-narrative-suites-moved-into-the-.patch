From 91798ba54c018a5bd8d142e0152cb71d41e9f7e1 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 02:27:09 +0000
Subject: [PATCH 5/6] compound suite name: narrative suites moved into the test
 file's namespace or the parent suite's extension (names and test IDs kept;
 tests only; Linux x86_64, Swift 6.4.2) (coenttb/work#242)

---
 .../Validated Byte Tagged Tests.swift         | 48 ++++++++++---------
 1 file changed, 25 insertions(+), 23 deletions(-)

diff --git a/Tests/Tagged Tests/Validated Byte Tagged Tests.swift b/Tests/Tagged Tests/Validated Byte Tagged Tests.swift
index fde5bdf..dea5048 100644
--- a/Tests/Tagged Tests/Validated Byte Tagged Tests.swift	
+++ b/Tests/Tagged Tests/Validated Byte Tagged Tests.swift	
@@ -18,34 +18,36 @@ private struct EvenByte: Equatable {
 
 private func requirePacketDomain<Value>(_: Tagged<Packet, Value>) {}
 
-@Suite
-struct `Validated Byte Tagged Tests` {
-    @Test func `forwards the underlying byte`() {
-        let tagged = Tagged<Packet, UInt8>(_unchecked: UInt8(0x42))
-        #expect(tagged.underlying == UInt8(0x42))
-    }
+extension `Validated Byte Tagged Tests`.`Validated Byte Tagged Tests` {
+    @Suite
+    struct `Validated Byte Tagged Tests` {
+        @Test func `forwards the underlying byte`() {
+            let tagged = Tagged<Packet, UInt8>(_unchecked: UInt8(0x42))
+            #expect(tagged.underlying == UInt8(0x42))
+        }
 
-    @Test func `tags a successfully validated byte`() throws {
-        let underlying = try EvenByte(UInt8(0xA4))
-        let tagged = Tagged<Packet, EvenByte>(_unchecked: underlying)
-        #expect(tagged.underlying.byte == UInt8(0xA4))
-    }
+        @Test func `tags a successfully validated byte`() throws {
+            let underlying = try EvenByte(UInt8(0xA4))
+            let tagged = Tagged<Packet, EvenByte>(_unchecked: underlying)
+            #expect(tagged.underlying.byte == UInt8(0xA4))
+        }
 
-    @Test func `uses the tag as the validated value domain`() {
-        let tagged = Tagged<Packet, UInt8>(_unchecked: UInt8(0x42))
-        requirePacketDomain(tagged)
-    }
+        @Test func `uses the tag as the validated value domain`() {
+            let tagged = Tagged<Packet, UInt8>(_unchecked: UInt8(0x42))
+            requirePacketDomain(tagged)
+        }
 
-    @Test func `validates before attaching the tag`() {
-        #expect(throws: EvenByte.Error.odd) {
-            Tagged<Packet, EvenByte>(_unchecked: try EvenByte(UInt8(0x01)))
+        @Test func `validates before attaching the tag`() {
+            #expect(throws: EvenByte.Error.odd) {
+                Tagged<Packet, EvenByte>(_unchecked: try EvenByte(UInt8(0x01)))
+            }
         }
-    }
 
-    @Test func `round-trips every byte through Tagged`() {
-        (UInt8.min...UInt8.max).forEach { raw in
-            let tagged = Tagged<Packet, UInt8>(_unchecked: UInt8(raw))
-            #expect(tagged.underlying == raw)
+        @Test func `round-trips every byte through Tagged`() {
+            (UInt8.min...UInt8.max).forEach { raw in
+                let tagged = Tagged<Packet, UInt8>(_unchecked: UInt8(raw))
+                #expect(tagged.underlying == raw)
+            }
         }
     }
 }
