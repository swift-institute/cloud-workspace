From c8130ae1a11646a20a1a9151e66b0c15adc4b5f2 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 18:48:53 +0000
Subject: [PATCH] compound suite name: narrative suites move into extension
 <Type> named after their test file, nested suites into extension
 <Type>.<Parent> (overnight/compound-suites.py); parse-checked; builds pending
 (coenttb/work#242)

---
 Tests/Link Tests/Link+Topology Tests.swift | 5 +++++
 Tests/Link Tests/Link.Header Tests.swift   | 5 +++++
 Tests/Link Tests/Link.Node Tests.swift     | 5 +++++
 3 files changed, 15 insertions(+)

diff --git a/Tests/Link Tests/Link+Topology Tests.swift b/Tests/Link Tests/Link+Topology Tests.swift
index 6247e41..00311ab 100644
--- a/Tests/Link Tests/Link+Topology Tests.swift	
+++ b/Tests/Link Tests/Link+Topology Tests.swift	
@@ -69,8 +69,13 @@ extension Pool {
 
 @Suite
 struct `Linked topology operations preserve ordered nodes and header state` {
+}
+
+extension `Linked topology operations preserve ordered nodes and header state` {
     @Suite struct `Linked insertion and removal preserve node order and endpoints` {}
+
     @Suite struct `Linked topology operations preserve empty states and allow reuse after draining` {}
+
     @Suite struct `Mixed linked operations preserve traversal order and reusable slots` {}
 }
 
diff --git a/Tests/Link Tests/Link.Header Tests.swift b/Tests/Link Tests/Link.Header Tests.swift
index 6d913d7..c989575 100644
--- a/Tests/Link Tests/Link.Header Tests.swift	
+++ b/Tests/Link Tests/Link.Header Tests.swift	
@@ -9,8 +9,13 @@ private enum Tag {}
 
 @Suite
 struct `Link headers preserve sentinels endpoints and counts` {
+}
+
+extension `Link headers preserve sentinels endpoints and counts` {
     @Suite struct `Link header construction and mutation preserve their stored fields` {}
+
     @Suite struct `Link headers support zero sentinels and singly linked topology` {}
+
     @Suite struct `No link header integration cases are defined` {}
 }
 
diff --git a/Tests/Link Tests/Link.Node Tests.swift b/Tests/Link Tests/Link.Node Tests.swift
index 4054f1e..13d4f0d 100644
--- a/Tests/Link Tests/Link.Node Tests.swift	
+++ b/Tests/Link Tests/Link.Node Tests.swift	
@@ -7,8 +7,13 @@ import Testing
 
 @Suite
 struct `Link nodes retain mutable links and element payloads` {
+}
+
+extension `Link nodes retain mutable links and element payloads` {
     @Suite struct `Link node construction and mutation preserve links and payloads` {}
+
     @Suite struct `Link nodes preserve string payloads` {}
+
     @Suite struct `No link node integration cases are defined` {}
 }
 
