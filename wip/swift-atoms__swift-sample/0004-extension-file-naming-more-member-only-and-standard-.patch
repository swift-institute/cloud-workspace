From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 01:37:28 +0000
Subject: [PATCH 4/9] extension file naming: more member-only and
 standard-library extension files merge into their type's file; single type
 per file: more additional types move to their own files
 (merge-extension-files.py, split-types.py); parse-checked; root build pending
 (coenttb/work#242)

---
 Sources/Sample/Sample.Accumulator+Monoid.swift | 14 --------------
 Sources/Sample/Sample.Accumulator.swift        | 13 +++++++++++++
 2 files changed, 13 insertions(+), 14 deletions(-)
 delete mode 100644 Sources/Sample/Sample.Accumulator+Monoid.swift

diff --git a/Sources/Sample/Sample.Accumulator+Monoid.swift b/Sources/Sample/Sample.Accumulator+Monoid.swift
deleted file mode 100644
index 8af9b8d..0000000
--- a/Sources/Sample/Sample.Accumulator+Monoid.swift
+++ /dev/null
@@ -1,14 +0,0 @@
-@_exported public import Algebra
-
-extension Sample.Accumulator {
-
-    @inlinable
-    public static var monoid: Algebra.Monoid<Self>.Commutative {
-        .init(
-            monoid: .init(
-                identity: .empty,
-                combining: { $0.merged(with: $1) }
-            )
-        )
-    }
-}
diff --git a/Sources/Sample/Sample.Accumulator.swift b/Sources/Sample/Sample.Accumulator.swift
index 0ead43a..0865c42 100644
--- a/Sources/Sample/Sample.Accumulator.swift
+++ b/Sources/Sample/Sample.Accumulator.swift
@@ -62,3 +62,16 @@ extension Sample.Accumulator {
         Self.monoid
     }
 }
+
+extension Sample.Accumulator {
+
+    @inlinable
+    public static var monoid: Algebra.Monoid<Self>.Commutative {
+        .init(
+            monoid: .init(
+                identity: .empty,
+                combining: { $0.merged(with: $1) }
+            )
+        )
+    }
+}
