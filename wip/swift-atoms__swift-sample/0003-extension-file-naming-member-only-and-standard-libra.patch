diff --git a/Sources/Sample/Sample.Regression.swift b/Sources/Sample/Sample.Regression.swift
index 7f704ac..cd02ee8 100644
--- a/Sources/Sample/Sample.Regression.swift
+++ b/Sources/Sample/Sample.Regression.swift
@@ -2,3 +2,63 @@ extension Sample {
 
     public enum Regression {}
 }
+
+extension Sample.Regression {
+
+    public static func linear(x: [Double], y: [Double]) -> Fit {
+        precondition(x.count == y.count, "x and y must have the same length")
+        precondition(x.count >= 2, "Need at least 2 data points for linear regression")
+
+        let n = Double(x.count)
+        var sumX: Double = 0
+        var sumY: Double = 0
+        var sumXY: Double = 0
+        var sumXX: Double = 0
+        var allXEqual = true
+
+        (0..<x.count).forEach { i in
+            sumX += x[i]
+            sumY += y[i]
+            sumXY += x[i] * y[i]
+            sumXX += x[i] * x[i]
+            if x[i] != x[0] { allXEqual = false }
+        }
+
+        let denominator = n * sumXX - sumX * sumX
+        guard denominator != 0, !allXEqual else {
+
+            return Fit(
+                slope: 0,
+                intercept: sumY / n,
+                rSquared: 0,
+                meanSquaredError: .infinity
+            )
+        }
+
+        let slope = (n * sumXY - sumX * sumY) / denominator
+        let intercept = (sumY - slope * sumX) / n
+
+        let yMean = sumY / n
+        var ssRes: Double = 0
+        var ssTot: Double = 0
+
+        (0..<x.count).forEach { i in
+            let predicted = slope * x[i] + intercept
+            let residual = y[i] - predicted
+            ssRes += residual * residual
+            let deviation = y[i] - yMean
+            ssTot += deviation * deviation
+        }
+
+        let rSquared = ssTot > 0 ? 1.0 - ssRes / ssTot : 0.0
+
+        let mse = x.count > 2 ? ssRes / Double(x.count - 2) : ssRes
+
+        return Fit(
+            slope: slope,
+            intercept: intercept,
+            rSquared: rSquared,
+            meanSquaredError: mse
+        )
+    }
+}
