Subject: [PATCH 2/7] compound suite name: a suite named like its file's
 namespace stays in place (overnight/compound-suites.py) (coenttb/work#242)

---
 .../Sample Comparison Tests.swift             |  6 ++--
 .../Sample Order Tests.swift                  | 30 +++++++++----------
 .../Sample Algebra Tests.swift                | 28 ++++++++---------
 3 files changed, 29 insertions(+), 35 deletions(-)

diff --git a/Tests/Consolidated swift-sample-comparison/Sample Comparison Tests/Sample Comparison Tests.swift b/Tests/Consolidated swift-sample-comparison/Sample Comparison Tests/Sample Comparison Tests.swift
index b66164d..9e8a6ed 100644
--- a/Tests/Consolidated swift-sample-comparison/Sample Comparison Tests/Sample Comparison Tests.swift	
+++ b/Tests/Consolidated swift-sample-comparison/Sample Comparison Tests/Sample Comparison Tests.swift	
@@ -1,6 +1,4 @@
 import Testing
 
-extension `Sample Comparison Tests`.`Sample Comparison Tests` {
-    @Suite
-    struct `Sample Comparison Tests` {}
-}
+@Suite
+struct `Sample Comparison Tests` {}
diff --git a/Tests/Consolidated swift-sample-order/Sample Order Tests/Sample Order Tests.swift b/Tests/Consolidated swift-sample-order/Sample Order Tests/Sample Order Tests.swift
index ae4a8de..3b7f1da 100644
--- a/Tests/Consolidated swift-sample-order/Sample Order Tests/Sample Order Tests.swift	
+++ b/Tests/Consolidated swift-sample-order/Sample Order Tests/Sample Order Tests.swift	
@@ -2,23 +2,21 @@ import Order
 import Sample
 import Testing
 
-extension `Sample Order Tests`.`Sample Order Tests` {
-    @Suite
-    struct `Sample Order Tests` {
+@Suite
+struct `Sample Order Tests` {
 
-        @Test
-        func `order comparator constructs a sorted sample batch`() {
-            let values = [4, 1, 3, 2]
-            let comparator: Order.Comparator<Int> = .ascending
-            let batch = Sample.Batch(
-                count: values.count,
-                sortedBy: comparator,
-                initializingWith: { values[$0] }
-            )
+    @Test
+    func `order comparator constructs a sorted sample batch`() {
+        let values = [4, 1, 3, 2]
+        let comparator: Order.Comparator<Int> = .ascending
+        let batch = Sample.Batch(
+            count: values.count,
+            sortedBy: comparator,
+            initializingWith: { values[$0] }
+        )
 
-            #expect(batch.withMin { $0 } == 1)
-            #expect(batch.withMedian { $0 } == 3)
-            #expect(batch.withMax { $0 } == 4)
-        }
+        #expect(batch.withMin { $0 } == 1)
+        #expect(batch.withMedian { $0 } == 3)
+        #expect(batch.withMax { $0 } == 4)
     }
 }
diff --git a/Tests/Sample Tests/swift-sample-algebra/Sample Algebra Tests.swift b/Tests/Sample Tests/swift-sample-algebra/Sample Algebra Tests.swift
index 49576ad..5e95c12 100644
--- a/Tests/Sample Tests/swift-sample-algebra/Sample Algebra Tests.swift	
+++ b/Tests/Sample Tests/swift-sample-algebra/Sample Algebra Tests.swift	
@@ -2,24 +2,22 @@ import Algebra
 import Sample
 import Testing
 
-extension `Sample Algebra Tests`.`Sample Algebra Tests` {
-    @Suite
-    struct `Sample Algebra Tests` {
+@Suite
+struct `Sample Algebra Tests` {
 
-        @Test
-        func `commutative monoid delegates to the sample accumulator`() {
-            var lhs = Sample.Accumulator.empty
-            lhs.record(10)
-            lhs.record(30)
+    @Test
+    func `commutative monoid delegates to the sample accumulator`() {
+        var lhs = Sample.Accumulator.empty
+        lhs.record(10)
+        lhs.record(30)
 
-            var rhs = Sample.Accumulator.empty
-            rhs.record(20)
+        var rhs = Sample.Accumulator.empty
+        rhs.record(20)
 
-            let monoid = Sample.Accumulator.commutativeMonoid
+        let monoid = Sample.Accumulator.commutativeMonoid
 
-            #expect(monoid.identity == .empty)
-            #expect(monoid(lhs, rhs) == lhs.merged(with: rhs))
-            #expect(monoid(lhs, rhs) == monoid(rhs, lhs))
-        }
+        #expect(monoid.identity == .empty)
+        #expect(monoid(lhs, rhs) == lhs.merged(with: rhs))
+        #expect(monoid(lhs, rhs) == monoid(rhs, lhs))
     }
 }
