diff --git a/Tests/ISO 21320 Standard Library Integration Tests/ISO_21320_CRC32_UInt8_ Tests.swift b/Tests/ISO 21320 Standard Library Integration Tests/ISO_21320_CRC32_UInt8_ Tests.swift
