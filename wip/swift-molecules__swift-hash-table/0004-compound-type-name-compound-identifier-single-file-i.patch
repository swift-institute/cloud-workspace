From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 03:32:49 +0000
Subject: [PATCH 4/6] compound type name, compound identifier: single-file
 internal types made fileprivate, package members used only in their target
 made internal (type-check follows; Linux x86_64, Swift 6.4.2)
 (coenttb/work#242)

---
 Sources/Hash Table Primitive/Hash.Table.swift | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/Sources/Hash Table Primitive/Hash.Table.swift b/Sources/Hash Table Primitive/Hash.Table.swift
index 4a9dd1d..ec937b7 100644
--- a/Sources/Hash Table Primitive/Hash.Table.swift	
+++ b/Sources/Hash Table Primitive/Hash.Table.swift	
@@ -58,7 +58,7 @@ extension Hash {
         }
 
         @inlinable
-        package static func makeRankPlane(
+        static func makeRankPlane(
             bucketCapacity: Tagged<Bucket, Cardinal>
         ) -> Buffer<Storage<Memory.Allocator<Memory.Small<0>>>.Contiguous<Int>>.Linear {
             var plane = Buffer<Storage<Memory.Allocator<Memory.Small<0>>>.Contiguous<Int>>.Linear(
@@ -90,7 +90,7 @@ extension Hash {
         }
 
         @inlinable
-        package static func makeSeed() -> Int {
+        static func makeSeed() -> Int {
             var generator = SystemRandomNumberGenerator()
             return Int(bitPattern: UInt(truncatingIfNeeded: generator.next() as UInt64))
         }
