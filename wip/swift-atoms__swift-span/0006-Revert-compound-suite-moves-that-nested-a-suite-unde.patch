Subject: [PATCH 06/10] Revert compound-suite moves that nested a suite under a
 namespace of its own name (coenttb/work#242)

---
 .../Memory Span Tests.swift                   |  6 +--
 Tests/Span Tests/Span Index Tests.swift       | 50 +++++++++----------
 2 files changed, 26 insertions(+), 30 deletions(-)

diff --git a/Tests/Absorbed swift-memory-span Tests/Memory Span Tests.swift b/Tests/Absorbed swift-memory-span Tests/Memory Span Tests.swift
index 0ade4fe..6926798 100644
--- a/Tests/Absorbed swift-memory-span Tests/Memory Span Tests.swift	
+++ b/Tests/Absorbed swift-memory-span Tests/Memory Span Tests.swift	
@@ -1,7 +1,5 @@
 import Span
 import Testing
 
-extension `Memory Span Tests`.`Memory Span Tests` {
-    @Suite
-    struct `Memory Span Tests` {}
-}
+@Suite
+struct `Memory Span Tests` {}
diff --git a/Tests/Span Tests/Span Index Tests.swift b/Tests/Span Tests/Span Index Tests.swift
index f3339ab..869dbb4 100644
--- a/Tests/Span Tests/Span Index Tests.swift	
+++ b/Tests/Span Tests/Span Index Tests.swift	
@@ -4,37 +4,35 @@ import Ordinal
 import Span
 import Testing
 
-extension `Span Index Tests`.`Span Index Tests` {
-    @Suite
-    struct `Span Index Tests` {
+@Suite
+struct `Span Index Tests` {
 
-        @Test
-        func `MutableSpan Protocol aliases the seam contract`() {
-            #expect(requiresMutableSpanProtocol(Fixture.self))
-        }
+    @Test
+    func `MutableSpan Protocol aliases the seam contract`() {
+        #expect(requiresMutableSpanProtocol(Fixture.self))
+    }
 
-        @Test
-        func `mutableSpan exposes full mutable storage`() {
-            var fixture = Fixture()
-            do {
-                var span = fixture.mutableSpan
-                #expect(span.count == 3)
-                span[1] = 42
-            }
-            #expect(fixture.span[1] == 42)
+    @Test
+    func `mutableSpan exposes full mutable storage`() {
+        var fixture = Fixture()
+        do {
+            var span = fixture.mutableSpan
+            #expect(span.count == 3)
+            span[1] = 42
         }
+        #expect(fixture.span[1] == 42)
+    }
 
-        @Test
-        func `typed count limits the mutable view`() {
-            var fixture = Fixture()
-            let count = Index<Int>.Count(_unchecked: Cardinal(2))
-            do {
-                var prefix = fixture.mutableSpan(count: count)
-                #expect(prefix.count == 2)
-                prefix[1] = 7
-            }
-            #expect(fixture.span[1] == 7)
+    @Test
+    func `typed count limits the mutable view`() {
+        var fixture = Fixture()
+        let count = Index<Int>.Count(_unchecked: Cardinal(2))
+        do {
+            var prefix = fixture.mutableSpan(count: count)
+            #expect(prefix.count == 2)
+            prefix[1] = 7
         }
+        #expect(fixture.span[1] == 7)
     }
 }
 
