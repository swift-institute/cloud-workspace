From 2bd73a348305df91e64de50aff86c77072e88ca2 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 18:48:55 +0000
Subject: [PATCH] compound suite name: narrative suites move into extension
 <Type> named after their test file, nested suites into extension
 <Type>.<Parent> (overnight/compound-suites.py); parse-checked; builds pending
 (coenttb/work#242)

---
 .../Predecessor Tests/Predecessor Tests.swift | 30 ++++++++++---------
 1 file changed, 16 insertions(+), 14 deletions(-)

diff --git a/Tests/Predecessor Tests/Predecessor Tests.swift b/Tests/Predecessor Tests/Predecessor Tests.swift
index dcad43d..0456727 100644
--- a/Tests/Predecessor Tests/Predecessor Tests.swift	
+++ b/Tests/Predecessor Tests/Predecessor Tests.swift	
@@ -2,22 +2,24 @@ import Predecessor
 import Subtraction
 import Testing
 
-@Suite
-struct `Predecessor checks and saturates movement to the previous value` {
+extension Predecessor {
+    @Suite
+    struct `Predecessor checks and saturates movement to the previous value` {
 
-    @Test
-    func `Predecessor reports and throws at the least value`() {
-        let report = Predecessor.reporting(UInt.zero)
-        #expect(report.value == UInt.max)
-        #expect(report.overflow)
-        #expect(throws: Subtraction.Error.overflow) {
-            try Predecessor.exact(UInt.zero)
+        @Test
+        func `Predecessor reports and throws at the least value`() {
+            let report = Predecessor.reporting(UInt.zero)
+            #expect(report.value == UInt.max)
+            #expect(report.overflow)
+            #expect(throws: Subtraction.Error.overflow) {
+                try Predecessor.exact(UInt.zero)
+            }
         }
-    }
 
-    @Test
-    func `Exact and saturating predecessor operations select the previous value`() throws {
-        #expect(try Predecessor.exact(UInt(42)) == 41)
-        #expect(Predecessor.saturating(UInt.zero) == .zero)
+        @Test
+        func `Exact and saturating predecessor operations select the previous value`() throws {
+            #expect(try Predecessor.exact(UInt(42)) == 41)
+            #expect(Predecessor.saturating(UInt.zero) == .zero)
+        }
     }
 }
