diff --git a/Sources/Interval/Interval.Unit+Swift.ExpressibleByFloatLiteral.swift b/Sources/Interval/Interval.Unit+Swift.ExpressibleByFloatLiteral.swift
new file mode 100644
index 0000000..957361a
--- /dev/null
+++ b/Sources/Interval/Interval.Unit+Swift.ExpressibleByFloatLiteral.swift
@@ -0,0 +1,16 @@
+extension Interval.Unit: Swift::ExpressibleByFloatLiteral
+where Scalar: Swift::ExpressibleByFloatLiteral {
+
+    public typealias FloatLiteralType = Scalar.FloatLiteralType
+
+    @inlinable
+    public init(floatLiteral value: FloatLiteralType) {
+        let scalar = Scalar(floatLiteral: value)
+        precondition(
+            scalar.isFinite && scalar >= 0 && scalar <= 1,
+            "Float literal must be finite and in [0, 1]"
+        )
+
+        self._storage = scalar
+    }
+}
diff --git a/Sources/Interval/Interval.Unit+Swift.ExpressibleByIntegerLiteral.swift b/Sources/Interval/Interval.Unit+Swift.ExpressibleByIntegerLiteral.swift
new file mode 100644
index 0000000..70fb40e
--- /dev/null
+++ b/Sources/Interval/Interval.Unit+Swift.ExpressibleByIntegerLiteral.swift
@@ -0,0 +1,16 @@
+extension Interval.Unit: Swift::ExpressibleByIntegerLiteral
+where Scalar: Swift::ExpressibleByIntegerLiteral {
+
+    public typealias IntegerLiteralType = Scalar.IntegerLiteralType
+
+    @inlinable
+    public init(integerLiteral value: IntegerLiteralType) {
+        let scalar = Scalar(integerLiteral: value)
+        precondition(
+            scalar >= 0 && scalar <= 1,
+            "Integer literal must be 0 or 1"
+        )
+
+        self._storage = scalar
+    }
+}
