From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 18:48:53 +0000
Subject: [PATCH] compound suite name: narrative suites move into extension
 <Type> named after their test file, nested suites into extension
 <Type>.<Parent> (overnight/compound-suites.py); parse-checked; builds pending
 (coenttb/work#242)

---
 Tests/Interval Tests/Interval Tests.swift | 12 +++++++-----
 1 file changed, 7 insertions(+), 5 deletions(-)

diff --git a/Tests/Interval Tests/Interval Tests.swift b/Tests/Interval Tests/Interval Tests.swift
index b3ab789..388502c 100644
--- a/Tests/Interval Tests/Interval Tests.swift	
+++ b/Tests/Interval Tests/Interval Tests.swift	
@@ -1,10 +1,12 @@
 import Interval
 import Testing
 
-@Suite
-struct `The Interval namespace has zero size` {
-    @Test
-    func `interval namespace is empty`() {
-        #expect(MemoryLayout<Interval>.size == 0)
+extension Interval {
+    @Suite
+    struct `The Interval namespace has zero size` {
+        @Test
+        func `interval namespace is empty`() {
+            #expect(MemoryLayout<Interval>.size == 0)
+        }
     }
 }
