+where Scalar: Swift::ExpressibleByIntegerLiteral {
+
+    public typealias IntegerLiteralType = Scalar.IntegerLiteralType
+
+    @inlinable
+    public init(integerLiteral value: IntegerLiteralType) {
+        let scalar = Scalar(integerLiteral: value)
