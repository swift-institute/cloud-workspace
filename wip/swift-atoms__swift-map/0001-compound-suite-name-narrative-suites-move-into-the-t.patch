From 968cfc79f7612ffaeb1f6223e9965ff0657b2730 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 19:34:03 +0000
Subject: [PATCH] compound suite name: narrative suites move into the test
 module's namespace `<File> Tests` (#239's layout), nested suites into
 extension <Path>.<Parent> (overnight/compound-suites.py); parse-checked;
 builds pending (coenttb/work#242)

---
 Tests/Map Tests/Map Tests.swift | 54 ++++++++++++++++++---------------
 1 file changed, 29 insertions(+), 25 deletions(-)

diff --git a/Tests/Map Tests/Map Tests.swift b/Tests/Map Tests/Map Tests.swift
index 0bd5dea..ffa7ca2 100644
--- a/Tests/Map Tests/Map Tests.swift	
+++ b/Tests/Map Tests/Map Tests.swift	
@@ -1,34 +1,38 @@
 import Map
 import Testing
 
-@Suite
-struct `Map transforms values independently` {
+enum `Map Tests` {}
 
-    @Test
-    func `a standalone map preserves typed failure`() {
-        let map = Map::Map<Int, String, Rejected> { value throws(Rejected) in
-            guard value >= 0 else { throw .negative }
-            return String(value)
-        }
-        do throws(Rejected) {
-            #expect(try map(42) == "42")
-            _ = try map(-1)
-            Issue.record("Expected rejection")
-        } catch {
-            #expect(error == .negative)
+extension `Map Tests` {
+    @Suite
+    struct `Map transforms values independently` {
+
+        @Test
+        func `a standalone map preserves typed failure`() {
+            let map = Map::Map<Int, String, Rejected> { value throws(Rejected) in
+                guard value >= 0 else { throw .negative }
+                return String(value)
+            }
+            do throws(Rejected) {
+                #expect(try map(42) == "42")
+                _ = try map(-1)
+                Issue.record("Expected rejection")
+            } catch {
+                #expect(error == .negative)
+            }
         }
-    }
 
-    @Test
-    func `a standalone map carries a scoped result`() {
-        let map = Map::Map<Span<Int>, Span<Int>, Never> {
-            (source: consuming Span<Int>) in source
+        @Test
+        func `a standalone map carries a scoped result`() {
+            let map = Map::Map<Span<Int>, Span<Int>, Never> {
+                (source: consuming Span<Int>) in source
+            }
+            let values = [10, 20]
+            let result = map(values.span)
+            #expect(result[0] == 10)
+            #expect(result[1] == 20)
         }
-        let values = [10, 20]
-        let result = map(values.span)
-        #expect(result[0] == 10)
-        #expect(result[1] == 20)
-    }
 
-    private enum Rejected: Swift::Error { case negative }
+        private enum Rejected: Swift::Error { case negative }
+    }
 }
