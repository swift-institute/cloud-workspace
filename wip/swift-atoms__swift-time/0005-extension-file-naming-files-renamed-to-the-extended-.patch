diff --git a/Sources/Time Foundation Integration/Foundation.Date+Time.Instant.swift b/Sources/Time Foundation Integration/Foundation.Date.swift
similarity index 100%
rename from Sources/Time Foundation Integration/Foundation.Date+Time.Instant.swift
rename to Sources/Time Foundation Integration/Foundation.Date.swift
