rename to Sources/Time Foundation Integration/Time.Instant.swift
diff --git a/Sources/Time Foundation Integration/Time.Zone.Rule+Foundation.TimeZone.swift b/Sources/Time Foundation Integration/Time.Zone.Rule.swift
similarity index 100%
rename from Sources/Time Foundation Integration/Time.Zone.Rule+Foundation.TimeZone.swift
rename to Sources/Time Foundation Integration/Time.Zone.Rule.swift
diff --git a/Sources/Time/Swift.Duration+Time.swift b/Sources/Time/Swift.Duration.swift
similarity index 100%
rename from Sources/Time/Swift.Duration+Time.swift
rename to Sources/Time/Swift.Duration.swift
diff --git a/Sources/Time/Time.Timezone.Offset.swift b/Sources/Time/Translation where Displacement == Time.Second.Offset.swift
similarity index 100%
rename from Sources/Time/Time.Timezone.Offset.swift
rename to Sources/Time/Translation where Displacement == Time.Second.Offset.swift
