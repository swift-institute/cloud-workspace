diff --git a/Sources/Time/Time.Instant.swift b/Sources/Time/Time.Instant.swift
index 80f76e4..3919243 100644
--- a/Sources/Time/Time.Instant.swift
+++ b/Sources/Time/Time.Instant.swift
@@ -156,3 +156,15 @@ extension Time.Instant {
         try lhs.advanced(by: -rhs)
     }
 }
+
+extension Time.Instant {
+
+    @inlinable
+    public static func milliseconds(from duration: Duration?) -> CInt {
+        guard let duration else { return -1 }
+        let ms = duration.attoseconds / 1_000_000_000_000_000
+        return CInt(clamping: ms)
+    }
+}
+
+extension Time.Instant: Swift.Comparable {}
