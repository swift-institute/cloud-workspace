From 608c35b90dec407cd1bdb2c15efeb9c6dfdc5314 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 18:24:16 +0000
Subject: [PATCH 1/5] minimal type body: the runner's repair moves non-stored
 members out of type bodies into extensions; repair applied; root and test
 builds not yet run (coenttb/work#242)

---
 Sources/W3C CSS Shared/WithGlobal.swift | 29 ++++++++++++++-----------
 1 file changed, 16 insertions(+), 13 deletions(-)

diff --git a/Sources/W3C CSS Shared/WithGlobal.swift b/Sources/W3C CSS Shared/WithGlobal.swift
index 2d498a9..b486806 100644
--- a/Sources/W3C CSS Shared/WithGlobal.swift	
+++ b/Sources/W3C CSS Shared/WithGlobal.swift	
@@ -13,40 +13,43 @@ public enum WithGlobal<T: Sendable & Hashable>: Sendable, Hashable {
     public init(_ global: Global) {
         self = .global(global)
     }
+}
 
-    @inlinable
-    public func map<U: Sendable & Hashable>(_ transform: (T) -> U) -> WithGlobal<U> {
+extension WithGlobal: GlobalConvertible {}
+
+extension WithGlobal: CustomStringConvertible where T: CustomStringConvertible {
+    public var description: String {
         switch self {
         case .value(let t):
-            return .value(transform(t))
+            return t.description
 
         case .global(let g):
-            return .global(g)
+            return g.description
         }
     }
+}
+
+extension WithGlobal {
 
     @inlinable
-    public func flatMap<U: Sendable & Hashable>(_ transform: (T) -> WithGlobal<U>) -> WithGlobal<U> {
+    public func map<U: Sendable & Hashable>(_ transform: (T) -> U) -> WithGlobal<U> {
         switch self {
         case .value(let t):
-            return transform(t)
+            return .value(transform(t))
 
         case .global(let g):
             return .global(g)
         }
     }
-}
 
-extension WithGlobal: GlobalConvertible {}
-
-extension WithGlobal: CustomStringConvertible where T: CustomStringConvertible {
-    public var description: String {
+    @inlinable
+    public func flatMap<U: Sendable & Hashable>(_ transform: (T) -> WithGlobal<U>) -> WithGlobal<U> {
         switch self {
         case .value(let t):
-            return t.description
+            return transform(t)
 
         case .global(let g):
-            return g.description
+            return .global(g)
         }
     }
 }
