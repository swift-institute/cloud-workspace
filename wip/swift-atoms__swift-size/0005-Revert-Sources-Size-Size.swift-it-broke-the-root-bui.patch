Subject: [PATCH 5/7] Revert Sources/Size/Size.swift: it broke the root build
 (coenttb/work#242)

---
 Sources/Size/Size.swift | 29 +++++------------------------
 1 file changed, 5 insertions(+), 24 deletions(-)

diff --git a/Sources/Size/Size.swift b/Sources/Size/Size.swift
index e30ea18..233c0e7 100644
--- a/Sources/Size/Size.swift
+++ b/Sources/Size/Size.swift
@@ -1,12 +1,15 @@
-public import Magnitude
-public import Vector
+@_exported public import Magnitude
+@_exported public import Vector
 
 public struct Size<let N: Int, Scalar: Magnitude::Scalar> {
     public let dimensions: Vector<N, Magnitude<Scalar>>
+    public typealias Error = Magnitude<Scalar>.Error
 
     public init(dimensions: Vector<N, Magnitude<Scalar>>) {
         self.dimensions = dimensions
     }
+
+    public subscript(index: Int) -> Magnitude<Scalar> { dimensions[index] }
 }
 
 extension Size {
@@ -39,25 +42,3 @@ extension Vector where Scalar: Magnitude::Scalar {
         self.init(size.dimensions.map(\.value).components)
     }
 }
-
-extension Size {
-    public typealias Error = Magnitude<Scalar>.Error
-
-    public subscript(index: Int) -> Magnitude<Scalar> { dimensions[index] }
-}
-
-#if !hasFeature(Embedded)
-    extension Size: Decodable where Scalar: Decodable {
-
-        public init(from decoder: any Decoder) throws {
-            self.init(dimensions: try Vector(from: decoder))
-        }
-
-    }
-
-    extension Size: Encodable where Scalar: Encodable {
-        public func encode(to encoder: any Encoder) throws {
-            try dimensions.encode(to: encoder)
-        }
-    }
-#endif
