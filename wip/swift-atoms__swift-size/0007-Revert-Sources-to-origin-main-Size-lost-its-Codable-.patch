From 37a5900daa050dbdf26c753e0348c5fb1b2117ea Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sun, 8 Nov 2026 07:20:01 +0000
Subject: [PATCH 7/7] Revert Sources to origin/main: Size lost its Codable
 conformance (coenttb/work#242)

---
 Sources/Size/Size+Codable.swift | 17 +++++++++++++++++
 Sources/Size/exports.swift      |  2 --
 2 files changed, 17 insertions(+), 2 deletions(-)
 create mode 100644 Sources/Size/Size+Codable.swift
 delete mode 100644 Sources/Size/exports.swift

diff --git a/Sources/Size/Size+Codable.swift b/Sources/Size/Size+Codable.swift
new file mode 100644
index 0000000..58777c8
--- /dev/null
+++ b/Sources/Size/Size+Codable.swift
@@ -0,0 +1,17 @@
+internal import Vector
+
+#if !hasFeature(Embedded)
+    extension Size: Decodable where Scalar: Decodable {
+
+        public init(from decoder: any Decoder) throws {
+            self.init(dimensions: try Vector(from: decoder))
+        }
+
+    }
+
+    extension Size: Encodable where Scalar: Encodable {
+        public func encode(to encoder: any Encoder) throws {
+            try dimensions.encode(to: encoder)
+        }
+    }
+#endif
diff --git a/Sources/Size/exports.swift b/Sources/Size/exports.swift
deleted file mode 100644
index 448a7de..0000000
--- a/Sources/Size/exports.swift
+++ /dev/null
@@ -1,2 +0,0 @@
-@_exported public import Magnitude
-@_exported public import Vector
-- 
