From a8bd3b971809bfc741d36b3d6ab7cf1fbe0223cc Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Sat, 7 Nov 2026 20:52:48 +0000
Subject: [PATCH 3/3] extension file naming: member-only and
 standard-library-conformance extension files merge into their type's own file
 (overnight/merge-extension-files.py); single type per file: additional types
 move to their own <Parent>.<Name>.swift inside the container's extension
 (overnight/split-types.py); parse-checked; builds pending (coenttb/work#242)

---
 Sources/Size/Size+Codable.swift | 17 -----------------
 Sources/Size/Size.swift         | 16 ++++++++++++++++
 2 files changed, 16 insertions(+), 17 deletions(-)
 delete mode 100644 Sources/Size/Size+Codable.swift

diff --git a/Sources/Size/Size+Codable.swift b/Sources/Size/Size+Codable.swift
deleted file mode 100644
index 58777c8..0000000
--- a/Sources/Size/Size+Codable.swift
+++ /dev/null
@@ -1,17 +0,0 @@
-internal import Vector
-
-#if !hasFeature(Embedded)
-    extension Size: Decodable where Scalar: Decodable {
-
-        public init(from decoder: any Decoder) throws {
-            self.init(dimensions: try Vector(from: decoder))
-        }
-
-    }
-
-    extension Size: Encodable where Scalar: Encodable {
-        public func encode(to encoder: any Encoder) throws {
-            try dimensions.encode(to: encoder)
-        }
-    }
-#endif
diff --git a/Sources/Size/Size.swift b/Sources/Size/Size.swift
index b8373c0..cfad394 100644
--- a/Sources/Size/Size.swift
+++ b/Sources/Size/Size.swift
@@ -45,3 +45,19 @@ extension Size {
 
     public subscript(index: Int) -> Magnitude<Scalar> { dimensions[index] }
 }
+
+#if !hasFeature(Embedded)
+    extension Size: Decodable where Scalar: Decodable {
+
+        public init(from decoder: any Decoder) throws {
+            self.init(dimensions: try Vector(from: decoder))
+        }
+
+    }
+
+    extension Size: Encodable where Scalar: Encodable {
+        public func encode(to encoder: any Encoder) throws {
+            try dimensions.encode(to: encoder)
+        }
+    }
+#endif
