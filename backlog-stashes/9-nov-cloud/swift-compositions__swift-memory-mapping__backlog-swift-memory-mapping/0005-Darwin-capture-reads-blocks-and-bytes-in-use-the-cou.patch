From 06bdf4674228c629363ed7900f03139c3da9e7d2 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Mon, 9 Nov 2026 13:59:03 +0000
Subject: [PATCH 5/5] Darwin capture reads blocks and bytes in use, the counts
 swift-darwin-standard#10 now reports; malloc zone statistics give no
 deallocation count (coenttb/work#242)

---
 .../Memory.Allocation.Statistics.swift               | 12 ++++++------
 1 file changed, 6 insertions(+), 6 deletions(-)

diff --git a/Sources/Memory Mapping/Memory.Allocation.Statistics.swift b/Sources/Memory Mapping/Memory.Allocation.Statistics.swift
index d1559e7..f94c7eb 100644
--- a/Sources/Memory Mapping/Memory.Allocation.Statistics.swift	
+++ b/Sources/Memory Mapping/Memory.Allocation.Statistics.swift	
@@ -61,9 +61,9 @@ extension Memory.Allocation.Statistics {
         #if os(macOS) || os(iOS) || os(tvOS) || os(watchOS) || os(visionOS)
             let statistics = Darwin.Memory.Allocation.Statistics.capture()
             return Self(
-                allocations: statistics.allocations,
-                deallocations: statistics.deallocations,
-                bytesAllocated: statistics.bytesAllocated,
+                allocations: statistics.blocksInUse,
+                deallocations: 0,
+                bytesAllocated: statistics.bytesInUse,
                 availability: .available,
                 scope: .process,
                 instrumentation: .snapshot
@@ -71,9 +71,9 @@ extension Memory.Allocation.Statistics {
         #elseif os(Linux)
             let statistics = Linux.Memory.Allocation.Statistics.capture()
             return Self(
-                allocations: statistics.allocations,
-                deallocations: statistics.deallocations,
-                bytesAllocated: statistics.bytesAllocated,
+                allocations: statistics.blocksInUse,
+                deallocations: 0,
+                bytesAllocated: statistics.bytesInUse,
                 availability: .available,
                 scope: .thread,
                 instrumentation: .interposed
