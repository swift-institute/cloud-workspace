From 10345abde5ad392b81a0738ef22eb6b77e1d64f8 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Mon, 9 Nov 2026 11:30:47 +0000
Subject: [PATCH 3/5] Memory.Allocation.Leak.Detector no longer offers
 net.bytes, which returned gross bytes allocated; the leak error labels the
 figure as bytes allocated since baseline
 (swift-compositions/swift-memory-mapping#15)

---
 .../Memory Mapping/Memory.Allocation.Leak.Detector.swift  | 8 +-------
 Sources/Memory Mapping/Memory.Allocation.Leak.Error.swift | 2 +-
 2 files changed, 2 insertions(+), 8 deletions(-)

diff --git a/Sources/Memory Mapping/Memory.Allocation.Leak.Detector.swift b/Sources/Memory Mapping/Memory.Allocation.Leak.Detector.swift
index d978757..58903ab 100644
--- a/Sources/Memory Mapping/Memory.Allocation.Leak.Detector.swift	
+++ b/Sources/Memory Mapping/Memory.Allocation.Leak.Detector.swift	
@@ -23,7 +23,7 @@ extension Memory.Allocation.Leak.Detector {
         guard netAllocs == 0 else {
             throw .detected(
                 allocations: netAllocs,
-                bytes: net.bytes,
+                bytes: delta().bytes.allocated,
                 file: file,
                 line: line
             )
@@ -54,12 +54,6 @@ extension Memory.Allocation.Leak.Detector.Net {
         let delta = Memory.Allocation.Statistics.delta(from: detector.baseline, to: current)
         return delta.net.allocations
     }
-
-    public var bytes: Int {
-        let current = Memory.Allocation.Statistics.capture()
-        let delta = Memory.Allocation.Statistics.delta(from: detector.baseline, to: current)
-        return delta.bytes.allocated
-    }
 }
 
 extension Memory.Allocation.Leak.Detector {
diff --git a/Sources/Memory Mapping/Memory.Allocation.Leak.Error.swift b/Sources/Memory Mapping/Memory.Allocation.Leak.Error.swift
index 4f04165..7d355c1 100644
--- a/Sources/Memory Mapping/Memory.Allocation.Leak.Error.swift	
+++ b/Sources/Memory Mapping/Memory.Allocation.Leak.Error.swift	
@@ -13,7 +13,7 @@ extension Memory.Allocation.Leak.Error: CustomStringConvertible {
             return """
                 Memory leak detected at \(file):\(line)
                 Net allocations: \(allocations)
-                Net bytes: \(bytes)
+                Bytes allocated since baseline: \(bytes)
                 """
         }
     }
-- 
