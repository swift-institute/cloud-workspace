diff --git a/Sources/Memory Mapping/Memory.Map.swift b/Sources/Memory Mapping/Memory.Map.swift
index 12a5575..6dc0ed7 100644
--- a/Sources/Memory Mapping/Memory.Map.swift	
+++ b/Sources/Memory Mapping/Memory.Map.swift	
@@ -188,7 +188,32 @@ extension Memory.Map {
 
             let region = Self.Region(base: baseAddress, length: mappingLenCount)
 
-            let lockToken: Memory.Lock.Token? = nil
+            let lockToken: Memory.Lock.Token?
+            if case .coordinated(let kind, let scope) = effectiveSafety {
+                let lockRange = Self.computeLockRange(
+                    scope: scope,
+                    alignedOffset: alignedOffset,
+                    mappingLength: mappingLen
+                )
+                do throws(Kernel.Lock.Error) {
+                    lockToken = try Memory.Lock.Token.acquire(
+                        descriptor: fileHandle,
+                        range: lockRange,
+                        kind: kind
+                    )
+                } catch {
+                    do throws(Self.Error) {
+                        try Self.unmap(
+                            addr: region.base,
+                            length: region.length,
+                            isAnonymous: false
+                        )
+                    } catch {}
+                    throw .fileLock(error)
+                }
+            } else {
+                lockToken = nil
+            }
 
             return Self(
                 region: region,
diff --git a/Tests/Memory Mapping Tests/Memory.Map Tests.swift b/Tests/Memory Mapping Tests/Memory.Map Tests.swift
index 2d9c720..9fee295 100644
--- a/Tests/Memory Mapping Tests/Memory.Map Tests.swift	
+++ b/Tests/Memory Mapping Tests/Memory.Map Tests.swift	
@@ -733,3 +733,47 @@ extension Memory.Map.Test.Performance {
         }
     #endif
 }
+
+extension Memory.Map.Test.Integration {
+    #if os(Windows)
+        @Test
+        func `coordinated file mapping holds its exclusive lock until unmap (Windows)`() throws {
+            let path = try Path(validating: Kernel.Temporary.filePath(prefix: "memory-map-lock"))
+            let owner = try Kernel.File.Open.open(
+                path: path,
+                mode: .readWrite,
+                options: [.create, .truncate],
+                permissions: .standard
+            )
+            let other = try Kernel.File.Open.open(
+                path: path,
+                mode: .readWrite,
+                options: [],
+                permissions: .standard
+            )
+            defer { try? Kernel.File.Delete.delete(path: path) }
+
+            let content = Array(repeating: UInt8(7), count: 4096)
+            _ = try unsafe content.withUnsafeBytes { buffer in
+                try unsafe Kernel.IO.Write.write(owner, from: buffer)
+            }
+
+            let map = try Memory.Map.open(
+                fileHandle: owner,
+                range: .whole,
+                access: [.read, .write],
+                sharing: .shared,
+                safety: .coordinated(.exclusive, scope: .file)
+            )
+
+            #expect(throws: Kernel.Lock.Error.self) {
+                try Kernel.Lock.Immediate.lock(other, range: .file, kind: .exclusive)
+            }
+
+            map.unmap()
+
+            try Kernel.Lock.Immediate.lock(other, range: .file, kind: .exclusive)
+            try Kernel.Lock.unlock(other, range: .file)
+        }
+    #endif
+}
