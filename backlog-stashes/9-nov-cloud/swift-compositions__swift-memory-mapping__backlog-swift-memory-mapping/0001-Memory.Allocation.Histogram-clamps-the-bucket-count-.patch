From e074fb7c310956438e3706ad8ca6e63f3b5a471d Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Mon, 9 Nov 2026 11:30:47 +0000
Subject: [PATCH 1/5] Memory.Allocation.Histogram clamps the bucket count to
 the value span instead of trapping on an inverted range
 (swift-compositions/swift-memory-mapping#15)

---
 .../Memory.Allocation.Histogram.swift         |  7 ++---
 .../Memory.Allocation.Histogram Tests.swift   | 26 +++++++++++++++++++
 2 files changed, 30 insertions(+), 3 deletions(-)
 create mode 100644 Tests/Memory Mapping Tests/Memory.Allocation.Histogram Tests.swift

diff --git a/Sources/Memory Mapping/Memory.Allocation.Histogram.swift b/Sources/Memory Mapping/Memory.Allocation.Histogram.swift
index 025883d..d3a481d 100644
--- a/Sources/Memory Mapping/Memory.Allocation.Histogram.swift	
+++ b/Sources/Memory Mapping/Memory.Allocation.Histogram.swift	
@@ -10,11 +10,12 @@ extension Memory.Allocation {
                 return
             }
             let span = max - min + 1
-            let bucketSize = Swift.max(1, span / bucketCount)
+            let bucketTotal = Swift.min(bucketCount, span)
+            let bucketSize = span / bucketTotal
             var result: [Bucket] = []
-            (0..<bucketCount).forEach { i in
+            (0..<bucketTotal).forEach { i in
                 let lo = min + i * bucketSize
-                let hi = (i == bucketCount - 1) ? max + 1 : lo + bucketSize
+                let hi = (i == bucketTotal - 1) ? max + 1 : lo + bucketSize
                 let count = sorted.filter { $0 >= lo && $0 < hi }.count
                 result.append(Bucket(range: lo..<hi, count: count))
             }
diff --git a/Tests/Memory Mapping Tests/Memory.Allocation.Histogram Tests.swift b/Tests/Memory Mapping Tests/Memory.Allocation.Histogram Tests.swift
new file mode 100644
index 0000000..e5236da
--- /dev/null
+++ b/Tests/Memory Mapping Tests/Memory.Allocation.Histogram Tests.swift	
@@ -0,0 +1,26 @@
+import Testing
+
+@testable import Memory_Mapping
+
+extension Memory.Test.`Edge Case` {
+    @Test func `histogram of a single value has one bucket holding it`() {
+        let histogram = Memory.Allocation.Histogram(values: [42], buckets: 10)
+        #expect(histogram.buckets.count == 1)
+        #expect(histogram.buckets.first?.range == 42..<43)
+        #expect(histogram.buckets.first?.count == 1)
+    }
+
+    @Test func `histogram whose values span fewer integers than buckets clamps the bucket count`() {
+        let histogram = Memory.Allocation.Histogram(values: [1, 2, 2, 3], buckets: 10)
+        #expect(histogram.buckets.count == 3)
+        #expect(histogram.buckets.map(\.count) == [1, 2, 1])
+        #expect(histogram.buckets.allSatisfy { $0.range.lowerBound < $0.range.upperBound })
+    }
+
+    @Test func `histogram over a wide span keeps the requested bucket count and every value`() {
+        let values = Array(0..<100)
+        let histogram = Memory.Allocation.Histogram(values: values, buckets: 10)
+        #expect(histogram.buckets.count == 10)
+        #expect(histogram.buckets.reduce(0) { $0 + $1.count } == values.count)
+    }
+}
