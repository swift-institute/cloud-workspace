From 222feed15d673cd26ff36ec735b10d6de1e35c3d Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Mon, 9 Nov 2026 11:33:43 +0000
Subject: [PATCH 1/2] Process.Spawn.Configuration.timeout documents that POSIX
 kills only the direct child while Windows kills the job, and a test pins that
 a grandchild holding the pipe delays run(_:)
 (swift-compositions/swift-process#24)

---
 .../Process/Process.Spawn.Configuration.swift |  6 +++++
 .../Process.Spawn.Capture.v3 Tests.swift      | 26 +++++++++++++++++++
 2 files changed, 32 insertions(+)

diff --git a/Sources/Process/Process.Spawn.Configuration.swift b/Sources/Process/Process.Spawn.Configuration.swift
index 5bd5b12..406d5ed 100644
--- a/Sources/Process/Process.Spawn.Configuration.swift
+++ b/Sources/Process/Process.Spawn.Configuration.swift
@@ -18,6 +18,12 @@ extension Process.Spawn {
 
         public let directory: Path::Path?
 
+        /// The time `Process.Spawn.run(_:)` allows the child before terminating it.
+        ///
+        /// On Windows the child runs in a job object and the timeout terminates the whole job,
+        /// descendants included. On POSIX systems the timeout sends `SIGKILL` to the direct child
+        /// only: a descendant that inherited a captured pipe keeps it open, and `run(_:)` returns
+        /// only once every holder of the pipe has closed it or exited.
         public let timeout: Duration?
 
         public init(
diff --git a/Tests/Process Tests/Process.Spawn.Capture.v3 Tests.swift b/Tests/Process Tests/Process.Spawn.Capture.v3 Tests.swift
index be75e6f..3ba4fd3 100644
--- a/Tests/Process Tests/Process.Spawn.Capture.v3 Tests.swift	
+++ b/Tests/Process Tests/Process.Spawn.Capture.v3 Tests.swift	
@@ -183,6 +183,32 @@
                 #expect(bytes.count > 0, "expected non-empty capture")
             }
 
+            @Test(
+                .timeLimit(.minutes(1))
+            )
+            func `timeout kills only the direct child, so a grandchild holding the pipe delays the return`()
+                throws
+            {
+                let started = ContinuousClock().now
+                let output = try Process.Spawn.run(
+                    Process.Spawn.Configuration(
+                        executable: "/bin/sh",
+                        arguments: ["-c", "sleep 2 & exec sleep 30"],
+                        stdout: .pipe,
+                        timeout: .milliseconds(200)
+                    )
+                )
+                let elapsed = ContinuousClock().now - started
+
+                guard case .signaled(let signal) = output.status else {
+                    Issue.record("expected .signaled, got \(output.status)")
+                    return
+                }
+                #expect(signal == 9)
+                #expect(elapsed >= .milliseconds(1500), "elapsed: \(elapsed)")
+                #expect(elapsed < .seconds(10), "elapsed: \(elapsed)")
+            }
+
             @Test
             func `nil timeout preserves indefinite-wait behavior`() throws {
                 let configuration = Process.Spawn.Configuration(
