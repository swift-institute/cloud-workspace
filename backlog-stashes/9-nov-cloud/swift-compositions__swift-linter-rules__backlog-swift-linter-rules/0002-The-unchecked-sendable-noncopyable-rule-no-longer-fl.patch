 .../MemoryNonSendableStorageTypeFinder.swift  | 31 +++++++++++
 ...ryUncheckedSendableNoncopyable Tests.swift | 51 +++++++++++++++++++
 3 files changed, 104 insertions(+), 1 deletion(-)
 create mode 100644 Sources/Linter Rule Memory/MemoryNonSendableStorageTypeFinder.swift

diff --git a/Sources/Linter Rule Memory/Lint.Rule.Memory.UnnecessaryUncheckedSendableNoncopyable.swift b/Sources/Linter Rule Memory/Lint.Rule.Memory.UnnecessaryUncheckedSendableNoncopyable.swift
index 7d3704b..3d0bedd 100644
