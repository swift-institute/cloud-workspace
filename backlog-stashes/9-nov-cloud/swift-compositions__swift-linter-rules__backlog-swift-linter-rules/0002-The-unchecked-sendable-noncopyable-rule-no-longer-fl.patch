             Diagnostic.Record(
diff --git a/Sources/Linter Rule Memory/MemoryNonSendableStorageTypeFinder.swift b/Sources/Linter Rule Memory/MemoryNonSendableStorageTypeFinder.swift
new file mode 100644
index 0000000..f33235a
--- /dev/null
+++ b/Sources/Linter Rule Memory/MemoryNonSendableStorageTypeFinder.swift	
@@ -0,0 +1,31 @@
+internal import SwiftSyntax
+
+internal final class MemoryNonSendableStorageTypeFinder: SyntaxVisitor {
+    static let names: Set<Swift::String> = [
+        "UnsafePointer", "UnsafeMutablePointer", "UnsafeRawPointer", "UnsafeMutableRawPointer",
+        "UnsafeBufferPointer", "UnsafeMutableBufferPointer", "UnsafeRawBufferPointer",
+        "UnsafeMutableRawBufferPointer", "OpaquePointer", "Unmanaged", "AnyObject",
+    ]
+
+    var found = false
+
+    override func visit(_ node: IdentifierTypeSyntax) -> SyntaxVisitorContinueKind {
+        if Self.names.contains(node.name.text) { found = true }
+        return .visitChildren
+    }
+
+    override func visit(_ node: MemberTypeSyntax) -> SyntaxVisitorContinueKind {
+        if Self.names.contains(node.name.text) { found = true }
+        return .visitChildren
+    }
+
+    override func visit(_ node: FunctionTypeSyntax) -> SyntaxVisitorContinueKind {
+        let isSendable =
+            node.parent?.as(AttributedTypeSyntax.self)?.attributes.contains { element in
+                guard case .attribute(let attribute) = element else { return false }
+                return attribute.attributeName.trimmedDescription == "Sendable"
+            } ?? false
+        if !isSendable { found = true }
+        return .visitChildren
+    }
+}
diff --git a/Tests/Linter Rule Memory Tests/Lint.Rule.Memory.UnnecessaryUncheckedSendableNoncopyable Tests.swift b/Tests/Linter Rule Memory Tests/Lint.Rule.Memory.UnnecessaryUncheckedSendableNoncopyable Tests.swift
index 10e67b2..8cba209 100644
--- a/Tests/Linter Rule Memory Tests/Lint.Rule.Memory.UnnecessaryUncheckedSendableNoncopyable Tests.swift	
+++ b/Tests/Linter Rule Memory Tests/Lint.Rule.Memory.UnnecessaryUncheckedSendableNoncopyable Tests.swift	
@@ -80,3 +80,54 @@ extension `unchecked sendable noncopyable Tests`.Unit {
         #expect(findings.isEmpty)
     }
 }
+
+extension `unchecked sendable noncopyable Tests`.`Edge Case` {
+    @Test
+    func `noncopyable struct storing only Sendable values is flagged`() {
+        let source = """
+            struct Reader: ~Copyable, @unchecked Sendable {
+                let count: Int
+                var name: String
+                var handler: @Sendable () -> Void
+            }
+            """
+        let findings = `unchecked sendable noncopyable Tests`.findings(in: source)
+        #expect(findings.count == 1)
+    }
+
+    @Test
+    func `noncopyable struct storing an unsafe pointer is not flagged`() {
+        let source = """
+            struct Arena: ~Copyable, @unchecked Sendable {
+                let base: UnsafeMutableRawPointer
+                let count: Int
+            }
+            """
+        let findings = `unchecked sendable noncopyable Tests`.findings(in: source)
+        #expect(findings.isEmpty)
+    }
+
+    @Test
+    func `noncopyable struct storing a non-Sendable closure is not flagged`() {
+        let source = """
+            struct Callback: ~Copyable, @unchecked Sendable {
+                let body: (() -> Void)?
+            }
+            """
+        let findings = `unchecked sendable noncopyable Tests`.findings(in: source)
+        #expect(findings.isEmpty)
+    }
+
+    @Test
+    func `static and computed pointer properties do not exempt the struct`() {
+        let source = """
+            struct Reader: ~Copyable, @unchecked Sendable {
+                static let shared: OpaquePointer? = nil
+                var address: UnsafeRawPointer? { nil }
+                let count: Int
+            }
+            """
+        let findings = `unchecked sendable noncopyable Tests`.findings(in: source)
+        #expect(findings.count == 1)
+    }
+}
