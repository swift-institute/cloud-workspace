From 44616cb736f0f2ae21eca18e3efc77415f4547f1 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Mon, 9 Nov 2026 11:40:40 +0000
Subject: [PATCH 09/18] BorderWidth(vertical:horizontal:) writes the horizontal
 width instead of repeating the vertical one (swift-w3c/swift-w3c-css#13)

---
 Sources/W3C CSS Backgrounds/BorderWidth.swift      |  2 +-
 .../BorderWidth Tests.swift                        | 14 ++++++++++++++
 2 files changed, 15 insertions(+), 1 deletion(-)
 create mode 100644 Tests/W3C CSS Backgrounds Tests/BorderWidth Tests.swift

diff --git a/Sources/W3C CSS Backgrounds/BorderWidth.swift b/Sources/W3C CSS Backgrounds/BorderWidth.swift
index 8366136..4da02d6 100644
--- a/Sources/W3C CSS Backgrounds/BorderWidth.swift	
+++ b/Sources/W3C CSS Backgrounds/BorderWidth.swift	
@@ -126,7 +126,7 @@ extension BorderWidth {
     }
 
     public init(vertical: Width, horizontal: Width) {
-        self = .values(.init(vertical, vertical, vertical, vertical))
+        self = .values(.init(vertical: vertical, horizontal: horizontal))
     }
 
     public init(top: Width, horizontal: Width, bottom: Width) {
diff --git a/Tests/W3C CSS Backgrounds Tests/BorderWidth Tests.swift b/Tests/W3C CSS Backgrounds Tests/BorderWidth Tests.swift
new file mode 100644
index 0000000..f6b7ad3
--- /dev/null
+++ b/Tests/W3C CSS Backgrounds Tests/BorderWidth Tests.swift	
@@ -0,0 +1,14 @@
+import Testing
+
+@testable import W3C_CSS_Backgrounds
+
+enum `BorderWidth Tests` {}
+
+extension `BorderWidth Tests` {
+    @Suite
+    struct `BorderWidth - Serialization` {
+        @Test func `vertical and horizontal widths are both written`() {
+            #expect(BorderWidth(vertical: .thin, horizontal: .thick).description == "thin thick")
+        }
+    }
+}
