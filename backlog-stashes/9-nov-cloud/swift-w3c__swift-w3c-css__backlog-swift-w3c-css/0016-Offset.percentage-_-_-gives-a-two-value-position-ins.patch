From c432141a6a7d039a7addfb7a5014901f12731dbc Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Mon, 9 Nov 2026 11:46:44 +0000
Subject: [PATCH 16/18] Offset.percentage(_:_:) gives a two-value position
 instead of making the second value the anchor (swift-w3c/swift-w3c-css#13)

---
 Sources/W3C CSS Animations/Offset.swift           |  2 +-
 Tests/W3C CSS Animations Tests/Offset Tests.swift | 14 ++++++++++++++
 2 files changed, 15 insertions(+), 1 deletion(-)
 create mode 100644 Tests/W3C CSS Animations Tests/Offset Tests.swift

diff --git a/Sources/W3C CSS Animations/Offset.swift b/Sources/W3C CSS Animations/Offset.swift
index 634fc2c..7b3af5a 100644
--- a/Sources/W3C CSS Animations/Offset.swift	
+++ b/Sources/W3C CSS Animations/Offset.swift	
@@ -92,6 +92,6 @@ extension Offset {
 
     public static func percentage(_ x: Percentage, _ y: Percentage) -> Self {
 
-        .position(.percentage(x), .percent(y))
+        .position(.position(.values(.percentage(x), .percentage(y))), nil)
     }
 }
diff --git a/Tests/W3C CSS Animations Tests/Offset Tests.swift b/Tests/W3C CSS Animations Tests/Offset Tests.swift
new file mode 100644
index 0000000..b84dd8e
--- /dev/null
+++ b/Tests/W3C CSS Animations Tests/Offset Tests.swift	
@@ -0,0 +1,14 @@
+import Testing
+
+@testable import W3C_CSS_Animations
+
+enum `Offset Tests` {}
+
+extension `Offset Tests` {
+    @Suite
+    struct `Offset - Position` {
+        @Test func `a percentage pair is a horizontal and vertical position, not an anchor`() {
+            #expect(Offset.percentage(50, 25).description == "50% 25%")
+        }
+    }
+}
