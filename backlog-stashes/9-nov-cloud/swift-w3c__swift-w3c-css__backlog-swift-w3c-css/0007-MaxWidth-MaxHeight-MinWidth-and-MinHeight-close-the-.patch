diff --git a/Sources/W3C CSS BoxModel/MaxHeight.swift b/Sources/W3C CSS BoxModel/MaxHeight.swift
index 0b4d014..2060f3e 100644
--- a/Sources/W3C CSS BoxModel/MaxHeight.swift	
+++ b/Sources/W3C CSS BoxModel/MaxHeight.swift	
@@ -42,7 +42,7 @@ extension MaxHeight: CustomStringConvertible {
 
         case .fitContent(let lengthPercentage):
             if let description = lengthPercentage?.description {
-                "fit-content(\(description)"
+                "fit-content(\(description))"
             } else {
                 "fit-content"
             }
