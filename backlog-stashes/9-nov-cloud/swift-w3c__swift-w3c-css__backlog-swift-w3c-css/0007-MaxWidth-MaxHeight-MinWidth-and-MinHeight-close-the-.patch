diff --git a/Tests/W3C CSS BoxModel Tests/MaxHeight Tests.swift b/Tests/W3C CSS BoxModel Tests/MaxHeight Tests.swift
new file mode 100644
index 0000000..086dd1e
--- /dev/null
+++ b/Tests/W3C CSS BoxModel Tests/MaxHeight Tests.swift	
@@ -0,0 +1,19 @@
+import Testing
+
+@testable import W3C_CSS_BoxModel
+
+enum `MaxHeight Tests` {}
+
+extension `MaxHeight Tests` {
+    @Suite
+    struct `MaxHeight - Serialization` {
+        @Test func `fit-content with an argument closes its parenthesis`() {
+            #expect(MaxHeight.fitContent(.px(200)).description == "fit-content(200px)")
+            #expect(MaxHeight.fitContent(nil).description == "fit-content")
+        }
+
+        @Test func `property name`() {
+            #expect(MaxHeight.property == "max-height")
+        }
+    }
+}
