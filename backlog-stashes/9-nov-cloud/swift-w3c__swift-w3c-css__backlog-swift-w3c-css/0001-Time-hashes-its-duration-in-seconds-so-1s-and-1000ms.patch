From cf7c39ef7141aa710769050e1c341211e10f286a Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Mon, 9 Nov 2026 11:30:40 +0000
Subject: [PATCH 01/18] Time hashes its duration in seconds, so 1s and 1000ms
 hash alike as they compare equal (swift-w3c/swift-w3c-css#13)

---
 Sources/W3C CSS Values/Time.swift           |  4 ++++
 Tests/W3C CSS Values Tests/Time Tests.swift | 11 +++++++++++
 2 files changed, 15 insertions(+)

diff --git a/Sources/W3C CSS Values/Time.swift b/Sources/W3C CSS Values/Time.swift
index 7305060..759bee7 100644
--- a/Sources/W3C CSS Values/Time.swift	
+++ b/Sources/W3C CSS Values/Time.swift	
@@ -115,6 +115,10 @@ extension Time: Comparable {
     public static func == (lhs: Time, rhs: Time) -> Bool {
         return lhs.inSeconds == rhs.inSeconds
     }
+
+    public func hash(into hasher: inout Hasher) {
+        hasher.combine(inSeconds)
+    }
 }
 
 extension Time: ExpressibleByIntegerLiteral {
diff --git a/Tests/W3C CSS Values Tests/Time Tests.swift b/Tests/W3C CSS Values Tests/Time Tests.swift
index 82c45ac..88e68e2 100644
--- a/Tests/W3C CSS Values Tests/Time Tests.swift	
+++ b/Tests/W3C CSS Values Tests/Time Tests.swift	
@@ -240,6 +240,17 @@ extension `Time Tests` {
     }
 }
 
+extension `Time Tests` {
+    @Suite
+    struct `Time - Hashable Conformance` {
+        @Test func `equal durations in different units hash alike`() {
+            let set: Set<Time> = [.s(1), .ms(1000)]
+            #expect(set.count == 1)
+            #expect(Time.s(1).hashValue == Time.ms(1000).hashValue)
+        }
+    }
+}
+
 extension `Time Tests` {
     @Suite
     struct `Time - Integer Literal` {
