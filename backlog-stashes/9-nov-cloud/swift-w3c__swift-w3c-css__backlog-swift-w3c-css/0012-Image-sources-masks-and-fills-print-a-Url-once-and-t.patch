@@ -0,0 +1,19 @@
+import Testing
+
+@testable import W3C_CSS_Positioning
+
+enum `PositionTryFallbacks Tests` {}
+
+extension `PositionTryFallbacks Tests` {
+    @Suite
+    struct `PositionTryFallbacks - Serialization` {
+        @Test func `fallbacks are written as identifiers and keywords`() {
+            #expect(PositionTryFallbacks.customOption("--above").description == "--above")
+            #expect(PositionTryFallbacks.positionArea(.physical(.top, .center)).description == "top center")
+            #expect(
+                PositionTryFallbacks.combine(.customOption("--above"), .tactic(.flipBlock)).description
+                    == "--above, flip-block"
+            )
+        }
+    }
+}
