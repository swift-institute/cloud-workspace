diff --git a/Tests/W3C CSS Backgrounds Tests/BorderImageSource Tests.swift b/Tests/W3C CSS Backgrounds Tests/BorderImageSource Tests.swift
new file mode 100644
index 0000000..cfafeb7
--- /dev/null
+++ b/Tests/W3C CSS Backgrounds Tests/BorderImageSource Tests.swift	
@@ -0,0 +1,20 @@
+import Testing
+import W3C_CSS_Shared
+
+@testable import W3C_CSS_Backgrounds
+
+enum `BorderImageSource Tests` {}
+
+extension `BorderImageSource Tests` {
+    @Suite
+    struct `BorderImageSource - Serialization` {
+        @Test func `a url is written once`() {
+            #expect(BorderImageSource.url(Url("a.png")).description == "url(\"a.png\")")
+        }
+
+        @Test func `a gradient is written as a gradient function`() {
+            let source = BorderImageSource.gradient(.linearGradient(to: .right, colors: [.named(.red), .named(.blue)]))
+            #expect(source.description == "linear-gradient(to right, red, blue)")
+        }
+    }
+}
