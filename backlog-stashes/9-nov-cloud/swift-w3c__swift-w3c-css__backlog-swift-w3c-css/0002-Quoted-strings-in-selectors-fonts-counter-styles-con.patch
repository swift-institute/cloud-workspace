diff --git a/Sources/W3C CSS Syntax/W3C_CSS.Block.swift b/Sources/W3C CSS Syntax/W3C_CSS.Block.swift
new file mode 100644
index 0000000..f26b446
--- /dev/null
+++ b/Sources/W3C CSS Syntax/W3C_CSS.Block.swift	
@@ -0,0 +1,118 @@
+public import W3C_CSS_Shared
+
+extension W3C_CSS {
+
+    /// A `prelude { body }` block, as found in an at-rule or inside its body.
+    public struct Block: Sendable, Hashable {
+
+        public let prelude: String
+
+        public let body: String
+
+        public init(prelude: String, body: String) {
+            self.prelude = prelude
+            self.body = body
+        }
+    }
+}
+
+extension W3C_CSS.Block {
+
+    /// The top-level blocks of `text`, skipping quoted text and any `;`-terminated statement between them.
+    public static func parse(_ text: String) -> [W3C_CSS.Block] {
+        var blocks: [W3C_CSS.Block] = []
+        var prelude = ""
+        var body = ""
+        var depth = 0
+        var quote: Character?
+        var escaped = false
+
+        for character in text {
+            if let open = quote {
+                if escaped {
+                    escaped = false
+                } else if character == "\\" {
+                    escaped = true
+                } else if character == open {
+                    quote = nil
+                }
+                if depth == 0 { prelude.append(character) } else { body.append(character) }
+                continue
+            }
+
+            switch character {
+            case "{":
+                if depth > 0 { body.append(character) }
+                depth += 1
+
+            case "}":
+                guard depth > 0 else { continue }
+                depth -= 1
+                if depth == 0 {
+                    blocks.append(W3C_CSS.Block(prelude: trimmed(prelude[...]), body: body))
+                    prelude = ""
+                    body = ""
+                } else {
+                    body.append(character)
+                }
+
+            case ";" where depth == 0:
+                prelude = ""
+
+            default:
+                if character == "\"" || character == "'" { quote = character }
+                if depth == 0 { prelude.append(character) } else { body.append(character) }
+            }
+        }
+
+        return blocks
+    }
+
+    static func split(_ text: String, at separator: Character) -> [Substring] {
+        var parts: [Substring] = []
+        var start = text.startIndex
+        var depth = 0
+        var quote: Character?
+        var escaped = false
+
+        for index in text.indices {
+            let character = text[index]
+            if let open = quote {
+                if escaped {
+                    escaped = false
+                } else if character == "\\" {
+                    escaped = true
+                } else if character == open {
+                    quote = nil
+                }
+                continue
+            }
+            switch character {
+            case "\"", "'":
+                quote = character
+
+            case "(", "{", "[":
+                depth += 1
+
+            case ")", "}", "]":
+                depth = max(0, depth - 1)
+
+            case separator where depth == 0:
+                parts.append(text[start..<index])
+                start = text.index(after: index)
+
+            default:
+                break
+            }
+        }
+        parts.append(text[start...])
+        return parts
+    }
+
+    static func trimmed(_ text: Substring) -> String {
+        var result = text
+        while result.first?.isWhitespace == true { result.removeFirst() }
+        while result.last?.isWhitespace == true { result.removeLast() }
+        return String(result)
+    }
+}
diff --git a/Sources/W3C CSS Syntax/W3C_CSS.Descriptors.swift b/Sources/W3C CSS Syntax/W3C_CSS.Descriptors.swift
new file mode 100644
index 0000000..63fe52c
--- /dev/null
+++ b/Sources/W3C CSS Syntax/W3C_CSS.Descriptors.swift	
@@ -0,0 +1,69 @@
+public import W3C_CSS_Shared
+
+extension W3C_CSS {
+
+    /// The `name: value` descriptors of an at-rule block, kept in the order they were first set.
+    public struct Descriptors: Sendable, Hashable {
+
+        public private(set) var entries: [Entry]
+
+        public init() {
+            self.entries = []
+        }
+
+        /// Reads the `name: value;` declarations of a block body, such as `system: cyclic; symbols: "*";`.
+        public init(parsing body: String) {
+            self.entries = []
+            for declaration in W3C_CSS.Block.split(body, at: ";") {
+                guard let colon = declaration.firstIndex(of: ":") else { continue }
+                let name = W3C_CSS.Block.trimmed(declaration[..<colon])
+                let value = W3C_CSS.Block.trimmed(declaration[declaration.index(after: colon)...])
+                guard !name.isEmpty, !value.isEmpty else { continue }
+                self[name] = value
+            }
+        }
+    }
+}
+
+extension W3C_CSS.Descriptors {
+
+    public struct Entry: Sendable, Hashable {
+
+        public let name: String
+
+        public let value: String
+
+        public init(name: String, value: String) {
+            self.name = name
+            self.value = value
+        }
+    }
+}
+
+extension W3C_CSS.Descriptors {
+
+    public var isEmpty: Bool { entries.isEmpty }
+
+    /// The value of the descriptor `name`; setting an existing one keeps its position, and `nil` removes it.
+    public subscript(name: String) -> String? {
+        get {
+            entries.first { $0.name == name }?.value
+        }
+        set {
+            if let index = entries.firstIndex(where: { $0.name == name }) {
+                if let newValue {
+                    entries[index] = Entry(name: name, value: newValue)
+                } else {
+                    entries.remove(at: index)
+                }
+            } else if let newValue {
+                entries.append(Entry(name: name, value: newValue))
+            }
+        }
+    }
+
+    /// One `name: value;` line per descriptor, each prefixed with `indent`.
+    public func lines(indent: String) -> String {
+        entries.map { "\(indent)\($0.name): \($0.value);" }.joined(separator: "\n")
+    }
+}
