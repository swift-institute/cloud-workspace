+import Testing
+
+@testable import W3C_CSS_Animations
+
+enum `Keyframes Tests` {}
+
+extension `Keyframes Tests` {
+    @Suite
+    struct `Keyframes - Serialization` {
+        @Test func `styles print in a stable order`() {
+            let keyframes = Keyframes("fade")
+                .keyframe(.from, ["opacity": "0", "color": "red"])
+                .keyframe(.to, ["opacity": "1"])
+            #expect(
+                keyframes.rawValue
+                    == "@keyframes fade {\n  from {\n    color: red;\n    opacity: 0;\n  }\n\n  to {\n    opacity: 1;\n  }\n}"
+            )
+        }
+
+        @Test func `a rule read from text keeps its keyframes when a builder is called`() {
+            let keyframes = Keyframes(rawValue: "@keyframes fade { from { opacity: 0; } }")
+                .keyframe(.to, ["opacity": "1"])
+            #expect(
+                keyframes.rawValue
+                    == "@keyframes fade {\n  from {\n    opacity: 0;\n  }\n\n  to {\n    opacity: 1;\n  }\n}"
+            )
+        }
+    }
+}
