+import Testing
+
+@testable import W3C_CSS_CounterStyles
+
+enum `CounterStyle Tests` {}
+
+extension `CounterStyle Tests` {
+    @Suite
+    struct `CounterStyle - Serialization` {
+        @Test func `the at-rule identifier is counter-style`() {
+            #expect(CounterStyle.identifier == "counter-style")
+        }
+
+        @Test func `strings are escaped and descriptors keep their order`() {
+            let style = CounterStyle("thumbs").system(.cyclic).symbols(["a", "b"]).suffix("\" ")
+            #expect(
+                style.rawValue == "@counter-style thumbs {\n  system: cyclic;\n  symbols: a b;\n  suffix: \"\\\" \";\n}"
+            )
+        }
+
+        @Test func `additive symbols are a comma separated list`() {
+            let style = CounterStyle("roman").additiveSymbols([(5, "V"), (1, "I")])
+            #expect(style.rawValue == "@counter-style roman {\n  additive-symbols: 5 \"V\", 1 \"I\";\n}")
+        }
+
+        @Test func `a rule read from text keeps its body when a builder is called`() {
+            let style = CounterStyle(rawValue: "@counter-style x { system: fixed; symbols: a b; }").suffix(".")
+            #expect(style.rawValue == "@counter-style x {\n  system: fixed;\n  symbols: a b;\n  suffix: \".\";\n}")
+        }
+    }
+}
