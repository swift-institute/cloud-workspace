+extension Media {
+
+    private static func parse(_ rawValue: String) -> [String] {
+        var text = Substring(rawValue)
+        if text.hasPrefix("@media") {
+            text = text.dropFirst(6)
+        }
+        if let brace = text.firstIndex(of: "{") {
+            text = text[..<brace]
+        }
+        return topLevel(String(text), separatedBy: ",").map(trimmed).filter { !$0.isEmpty }
+    }
+
+    private static func hasMediaType(_ query: String) -> Bool {
+        var text = Substring(query)
+        for prefix in ["not ", "only "] where text.hasPrefix(prefix) {
+            text = text.dropFirst(prefix.count)
+        }
+        return text.first.map { $0 != "(" } ?? false
+    }
+
+    private static func operand(_ query: String) -> String {
+        let isCompound = !hasMediaType(query) && (query.hasPrefix("not ") || topLevel(query, separatedBy: " or ").count > 1)
+        return isCompound ? "(\(query))" : query
+    }
+
+    private static func inParens(_ query: String) -> String {
+        guard query.first == "(", let close = closingParenthesis(of: query), query.index(after: close) == query.endIndex
+        else {
+            return "(\(query))"
+        }
+        return query
+    }
+
+    private static func closingParenthesis(of text: String) -> String.Index? {
+        var depth = 0
+        for index in text.indices {
+            switch text[index] {
+            case "(":
+                depth += 1
+
+            case ")":
+                depth -= 1
+                if depth == 0 { return index }
+
+            default:
+                break
+            }
+        }
+        return nil
+    }
+
+    private static func topLevel(_ text: String, separatedBy separator: String) -> [String] {
+        var parts: [String] = []
+        var current = ""
+        var depth = 0
+        var index = text.startIndex
+        while index < text.endIndex {
+            let character = text[index]
+            if depth == 0, text[index...].hasPrefix(separator) {
+                parts.append(current)
+                current = ""
+                index = text.index(index, offsetBy: separator.count)
+                continue
+            }
+            if character == "(" { depth += 1 }
+            if character == ")" { depth -= 1 }
+            current.append(character)
+            index = text.index(after: index)
+        }
+        parts.append(current)
+        return parts
+    }
+
+    private static func trimmed(_ text: String) -> String {
+        var result = Substring(text)
+        while result.first?.isWhitespace == true { result.removeFirst() }
+        while result.last?.isWhitespace == true { result.removeLast() }
+        return String(result)
+    }
+}
diff --git a/Tests/W3C CSS Containment Tests/Container Tests.swift b/Tests/W3C CSS Containment Tests/Container Tests.swift
new file mode 100644
index 0000000..c7bc253
--- /dev/null
+++ b/Tests/W3C CSS Containment Tests/Container Tests.swift	
@@ -0,0 +1,42 @@
+import Testing
+
+@testable import W3C_CSS_Containment
+
+enum `Container Tests` {}
+
+extension `Container Tests` {
+    @Suite
+    struct `Container - Conditions` {
+        @Test func `a size range puts the feature between its bounds`() {
+            #expect(
+                Container.width(.range(min: .px(100), max: .px(400))).rawValue == "@container (100px <= width <= 400px)"
+            )
+        }
+
+        @Test func `and and or parenthesize compound operands`() {
+            let wide = Container.width(.greaterThan(.px(400))).and(.orientation(.landscape))
+            #expect(wide.rawValue == "@container (width > 400px) and (orientation: landscape)")
+            #expect(
+                wide.or(.height(.lessThan(.px(200)))).rawValue
+                    == "@container ((width > 400px) and (orientation: landscape)) or (height < 200px)"
+            )
+        }
+
+        @Test func `operators keep the name of the left container`() {
+            let container =
+                Container.width(name: "sidebar", .greaterThan(.px(400)))
+                && Container.height(name: "main", .lessThan(.px(200)))
+            #expect(container.rawValue == "@container sidebar (width > 400px) and (height < 200px)")
+        }
+
+        @Test func `a container read from text keeps its name and condition`() {
+            let container = Container(rawValue: "@container sidebar (width > 400px)").and(.height(.lessThan(.px(200))))
+            #expect(container.rawValue == "@container sidebar (width > 400px) and (height < 200px)")
+        }
+
+        @Test func `not negates a compound condition as a whole`() {
+            let condition = Container.Condition.not(.width(.greaterThan(.px(1))).and(.height(.lessThan(.px(2)))))
+            #expect(condition.rawValue == "not ((width > 1px) and (height < 2px))")
+        }
+    }
+}
