+extension Container {
+
+    private static func parse(_ rawValue: String) -> (name: String?, condition: Condition) {
+        var text = Substring(rawValue)
+        if text.hasPrefix("@container") {
+            text = text.dropFirst(10)
+        }
+        if let brace = text.firstIndex(of: "{") {
+            text = text[..<brace]
+        }
+        text = text.drop(while: \.isWhitespace)
+        while text.last?.isWhitespace == true { text.removeLast() }
+
+        guard let first = text.first, first != "(",
+            !text.hasPrefix("not "), !text.hasPrefix("style("), !text.hasPrefix("scroll-state(")
+        else {
+            return (nil, Condition(rawValue: String(text)))
+        }
+        let nameEnd = text.firstIndex(where: \.isWhitespace) ?? text.endIndex
+        return (String(text[..<nameEnd]), Condition(rawValue: String(text[nameEnd...].drop(while: \.isWhitespace))))
     }
 }
