+
+extension `Media Tests` {
+    @Suite
+    struct `Media - Query Lists` {
+        @Test func `negating a list of conditions negates the whole list`() {
+            let media = !(Media.minWidth(.px(300)) || Media.prefersColorScheme(.dark))
+            #expect(media.rawValue == "@media not ((min-width: 300px) or (prefers-color-scheme: dark))")
+        }
+
+        @Test func `negating a single condition wraps it`() {
+            #expect(Media.maxWidth(.px(500)).not().rawValue == "@media not (max-width: 500px)")
+        }
+
+        @Test func `and distributes over a comma list`() {
+            let media = (Media.screen || Media.print) && Media.maxWidth(.px(500))
+            #expect(media.rawValue == "@media screen and (max-width: 500px), print and (max-width: 500px)")
+        }
+
+        @Test func `a query read from text combines by its queries`() {
+            let media = Media(rawValue: "@media screen, print").and(Media.maxWidth(.px(500)))
+            #expect(media.rawValue == "@media screen and (max-width: 500px), print and (max-width: 500px)")
+        }
+    }
+}
