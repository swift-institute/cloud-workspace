From cfaefa83474776467a0373913c4e0fe335352c44 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Mon, 9 Nov 2026 11:35:33 +0000
Subject: [PATCH 03/18] ClassSelector and IDSelector escape their names as CSS
 identifiers, so a leading digit or a space no longer gives an invalid
 selector (swift-w3c/swift-w3c-css#13)

---
 Sources/W3C CSS Selectors/Class.swift              | 2 +-
 Sources/W3C CSS Selectors/ID.swift                 | 2 +-
 Tests/W3C CSS Selectors Tests/Selector Tests.swift | 7 +++++++
 3 files changed, 9 insertions(+), 2 deletions(-)

diff --git a/Sources/W3C CSS Selectors/Class.swift b/Sources/W3C CSS Selectors/Class.swift
index 90bb640..82acb40 100644
--- a/Sources/W3C CSS Selectors/Class.swift	
+++ b/Sources/W3C CSS Selectors/Class.swift	
@@ -13,6 +13,6 @@ public struct ClassSelector: Sendable, Hashable {
 extension ClassSelector: CustomStringConvertible {
 
     public var description: String {
-        return ".\(className)"
+        return ".\(Ident(className))"
     }
 }
diff --git a/Sources/W3C CSS Selectors/ID.swift b/Sources/W3C CSS Selectors/ID.swift
index c6a7dda..b8a9f8a 100644
--- a/Sources/W3C CSS Selectors/ID.swift	
+++ b/Sources/W3C CSS Selectors/ID.swift	
@@ -13,6 +13,6 @@ public struct IDSelector: Sendable, Hashable {
 extension IDSelector: CustomStringConvertible {
 
     public var description: String {
-        return "#\(id)"
+        return "#\(Ident(id))"
     }
 }
diff --git a/Tests/W3C CSS Selectors Tests/Selector Tests.swift b/Tests/W3C CSS Selectors Tests/Selector Tests.swift
index 71c2711..c190cdf 100644
--- a/Tests/W3C CSS Selectors Tests/Selector Tests.swift	
+++ b/Tests/W3C CSS Selectors Tests/Selector Tests.swift	
@@ -255,6 +255,13 @@ extension `Selector Tests` {
             #expect(selector.description == ".btn-primary_large-123")
         }
 
+        @Test func `class and id names are escaped as identifiers`() {
+            #expect(ClassSelector("1col").description == ".\\31 col")
+            #expect(ClassSelector("a b").description == ".a\\ b")
+            #expect(ClassSelector("sm:p-4").description == ".sm\\:p-4")
+            #expect(IDSelector("2nd").description == "#\\32 nd")
+        }
+
         @Test func `unicode characters in selectors`() {
             let selector = ClassSelector("ボタン")
             #expect(selector.description == ".ボタン")
-- 
2.43.0

