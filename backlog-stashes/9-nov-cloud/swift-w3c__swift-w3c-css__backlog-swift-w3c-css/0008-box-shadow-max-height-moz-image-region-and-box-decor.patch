diff --git a/Tests/W3C CSS Alignment Tests/Property Name Tests.swift b/Tests/W3C CSS Alignment Tests/Property Name Tests.swift
new file mode 100644
index 0000000..e72f10e
--- /dev/null
+++ b/Tests/W3C CSS Alignment Tests/Property Name Tests.swift	
@@ -0,0 +1,27 @@
+import Testing
+
+@testable import W3C_CSS_Alignment
+
+enum `Property Name Tests` {}
+
+extension `Property Name Tests` {
+    @Suite
+    struct `Property Name - Spec Names` {
+        @Test(arguments: [
+            (W3C_CSS_Alignment.AlignContent.property, "align-content"),
+            (W3C_CSS_Alignment.AlignItems.property, "align-items"),
+            (W3C_CSS_Alignment.AlignSelf.property, "align-self"),
+            (W3C_CSS_Alignment.AlignmentBaseline.property, "alignment-baseline"),
+            (W3C_CSS_Alignment.JustifyContent.property, "justify-content"),
+            (W3C_CSS_Alignment.JustifyItems.property, "justify-items"),
+            (W3C_CSS_Alignment.JustifySelf.property, "justify-self"),
+            (W3C_CSS_Alignment.PlaceContent.property, "place-content"),
+            (W3C_CSS_Alignment.PlaceItems.property, "place-items"),
+            (W3C_CSS_Alignment.PlaceSelf.property, "place-self"),
+            (W3C_CSS_Alignment.VerticalAlign.property, "vertical-align"),
+        ])
+        func `every property and at-rule has its spec name`(name: String, expected: String) {
+            #expect(name == expected)
+        }
+    }
+}
