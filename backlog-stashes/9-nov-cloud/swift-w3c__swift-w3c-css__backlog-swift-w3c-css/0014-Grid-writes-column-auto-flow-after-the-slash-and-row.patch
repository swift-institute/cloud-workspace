From ea98e767b4796de962cba446ba3d85183f6633b0 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Mon, 9 Nov 2026 11:45:57 +0000
Subject: [PATCH 14/18] Grid writes column auto-flow after the slash and row
 auto-flow before it, instead of ignoring the direction
 (swift-w3c/swift-w3c-css#13)

---
 Sources/W3C CSS Grid/Grid.swift           | 15 +++++----------
 Tests/W3C CSS Grid Tests/Grid Tests.swift | 20 ++++++++++++++++++++
 2 files changed, 25 insertions(+), 10 deletions(-)
 create mode 100644 Tests/W3C CSS Grid Tests/Grid Tests.swift

diff --git a/Sources/W3C CSS Grid/Grid.swift b/Sources/W3C CSS Grid/Grid.swift
index 64ef5a0..f275c45 100644
--- a/Sources/W3C CSS Grid/Grid.swift	
+++ b/Sources/W3C CSS Grid/Grid.swift	
@@ -27,19 +27,14 @@ extension Grid {
             let columnsStr = columns.map { $0.description }.joined(separator: " ")
             return "\(rowsStr) / \(columnsStr)"
 
-        case .autoFlow(_, let density, let trackSize):
-            var result = "auto-flow"
-            if let density, density == .dense {
-                result += " dense"
-            }
-            guard let trackSize else {
-                return "\(result) / auto"
-            }
-            return "\(result) / \(trackSize)"
+        case .autoFlow(let direction, let density, let trackSize):
+            let flow = density == .dense ? "auto-flow dense" : "auto-flow"
+            let template = trackSize?.description ?? "auto"
+            return direction == .row ? "\(flow) / \(template)" : "\(template) / \(flow)"
 
         case .explicit(let tracks, let autoFlow):
             let tracksStr = tracks.map { $0.description }.joined(separator: " ")
-            return "\(tracksStr) / \(autoFlow)"
+            return autoFlow.direction == .row ? "\(autoFlow) / \(tracksStr)" : "\(tracksStr) / \(autoFlow)"
 
         case .global(let value):
             return value.description
diff --git a/Tests/W3C CSS Grid Tests/Grid Tests.swift b/Tests/W3C CSS Grid Tests/Grid Tests.swift
new file mode 100644
index 0000000..e255177
--- /dev/null
+++ b/Tests/W3C CSS Grid Tests/Grid Tests.swift	
@@ -0,0 +1,20 @@
+import Testing
+
+@testable import W3C_CSS_Grid
+
+enum `Grid Tests` {}
+
+extension `Grid Tests` {
+    @Suite
+    struct `Grid - Auto Flow` {
+        @Test func `row flow puts auto-flow before the slash`() {
+            #expect(Grid.autoFlow(.row).description == "auto-flow / auto")
+            #expect(Grid.explicit([.px(100)], .autoFlow(.row, .dense, .fr(1))).description == "auto-flow dense 1fr / 100px")
+        }
+
+        @Test func `column flow puts auto-flow after the slash`() {
+            #expect(Grid.autoFlow(.column, .dense).description == "auto / auto-flow dense")
+            #expect(Grid.explicit([.px(100)], .autoFlow(.column)).description == "100px / auto-flow")
+        }
+    }
+}
