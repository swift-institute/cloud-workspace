From c164fd818aae208c22d02741f7d6d13f977e8f92 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Mon, 9 Nov 2026 11:41:01 +0000
Subject: [PATCH 10/18] Padding.named writes a missing side as 0 instead of
 putting padding-* declarations into the padding value
 (swift-w3c/swift-w3c-css#13)

---
 Sources/W3C CSS BoxModel/Padding.swift        | 26 +++----------------
 .../Padding Tests.swift                       | 19 ++++++++++++++
 2 files changed, 23 insertions(+), 22 deletions(-)
 create mode 100644 Tests/W3C CSS BoxModel Tests/Padding Tests.swift

diff --git a/Sources/W3C CSS BoxModel/Padding.swift b/Sources/W3C CSS BoxModel/Padding.swift
index e97a2bd..73e33ad 100644
--- a/Sources/W3C CSS BoxModel/Padding.swift	
+++ b/Sources/W3C CSS BoxModel/Padding.swift	
@@ -41,28 +41,10 @@ extension Padding {
             return "\(top) \(right) \(bottom) \(left)"
 
         case .named(let sides):
-
-            guard let top = sides.top, let right = sides.right, let bottom = sides.bottom,
-                let left = sides.left
-            else {
-
-                var individualProperties: [String] = []
-
-                if let top = sides.top {
-                    individualProperties.append("padding-top: \(top);")
-                }
-                if let right = sides.right {
-                    individualProperties.append("padding-right: \(right);")
-                }
-                if let bottom = sides.bottom {
-                    individualProperties.append("padding-bottom: \(bottom);")
-                }
-                if let left = sides.left {
-                    individualProperties.append("padding-left: \(left);")
-                }
-
-                return individualProperties.joined(separator: " ")
-            }
+            let top = sides.top ?? .px(0)
+            let right = sides.right ?? .px(0)
+            let bottom = sides.bottom ?? .px(0)
+            let left = sides.left ?? .px(0)
 
             return if top == right && right == bottom && bottom == left {
 
diff --git a/Tests/W3C CSS BoxModel Tests/Padding Tests.swift b/Tests/W3C CSS BoxModel Tests/Padding Tests.swift
new file mode 100644
index 0000000..0a7a525
--- /dev/null
+++ b/Tests/W3C CSS BoxModel Tests/Padding Tests.swift	
@@ -0,0 +1,19 @@
+import Testing
+
+@testable import W3C_CSS_BoxModel
+
+enum `Padding Tests` {}
+
+extension `Padding Tests` {
+    @Suite
+    struct `Padding - Named Sides` {
+        @Test func `a missing side is written as zero`() {
+            #expect(Padding.sides(top: .px(10)).description == "10px 0px 0px")
+            #expect(Padding.sides(top: .px(10), right: .px(5), bottom: .px(10)).description == "10px 5px 10px 0px")
+        }
+
+        @Test func `all four sides compress as before`() {
+            #expect(Padding.sides(top: .px(1), right: .px(2), bottom: .px(1), left: .px(2)).description == "1px 2px")
+        }
+    }
+}
