 .../FontVariantLigatures Tests.swift             | 16 ++++++++++++++++
 .../FontVariationSettings Tests.swift            | 15 +++++++++++++++
 .../W3C CSS Images Tests/PaintOrder Tests.swift  | 15 +++++++++++++++
 .../HangingPunctuation Tests.swift               | 14 ++++++++++++++
 .../TextUnderlinePosition Tests.swift            | 14 ++++++++++++++
 17 files changed, 122 insertions(+), 14 deletions(-)
