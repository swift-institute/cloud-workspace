diff --git a/Sources/W3C CSS Fonts/FontFeatureSettings.swift b/Sources/W3C CSS Fonts/FontFeatureSettings.swift
index 3c43bd1..ef2c066 100644
--- a/Sources/W3C CSS Fonts/FontFeatureSettings.swift	
+++ b/Sources/W3C CSS Fonts/FontFeatureSettings.swift	
@@ -62,9 +62,9 @@ extension FontFeatureSettings: CustomStringConvertible {
             return "normal"
 
         case .features(let features):
-            let featureStrings = features.map { tag, value -> String in
+            let featureStrings = features.sorted { $0.key < $1.key }.map { tag, value -> String in
                 let valueStr = value.map { " \($0)" } ?? ""
-                return "\"\(tag)\"\(valueStr)"
+                return "\(CSSString(tag))\(valueStr)"
             }
             return featureStrings.joined(separator: ", ")
 
diff --git a/Sources/W3C CSS Fonts/FontVariantEastAsian.swift b/Sources/W3C CSS Fonts/FontVariantEastAsian.swift
index 5388fda..bdc24e2 100644
--- a/Sources/W3C CSS Fonts/FontVariantEastAsian.swift	
+++ b/Sources/W3C CSS Fonts/FontVariantEastAsian.swift	
@@ -45,7 +45,7 @@ extension FontVariantEastAsian: CustomStringConvertible {
             return value.rawValue
 
         case .combined(let values):
-            return values.map { $0.rawValue }.joined(separator: " ")
+            return EastAsianVariantValue.allCases.filter { values.contains($0) }.map { $0.rawValue }.joined(separator: " ")
 
         case .global(let global):
             return global.description
diff --git a/Sources/W3C CSS Fonts/FontVariantLigatures.swift b/Sources/W3C CSS Fonts/FontVariantLigatures.swift
