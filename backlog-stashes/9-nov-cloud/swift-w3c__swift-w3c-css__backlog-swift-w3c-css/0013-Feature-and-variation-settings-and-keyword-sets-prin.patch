         case .global(let global):
             return global.description
diff --git a/Sources/W3C CSS Fonts/FontVariationSettings.swift b/Sources/W3C CSS Fonts/FontVariationSettings.swift
index a8b6aeb..d688180 100644
--- a/Sources/W3C CSS Fonts/FontVariationSettings.swift	
+++ b/Sources/W3C CSS Fonts/FontVariationSettings.swift	
@@ -34,8 +34,8 @@ extension FontVariationSettings: CustomStringConvertible {
             return "normal"
 
         case .axes(let axes):
-            let axisStrings = axes.map { axis, value -> String in
-                return "\"\(axis)\" \(value)"
+            let axisStrings = axes.sorted { $0.key < $1.key }.map { axis, value -> String in
+                return "\(CSSString(axis)) \(value)"
             }
             return axisStrings.joined(separator: ", ")
 
diff --git a/Sources/W3C CSS Images/PaintOrder.swift b/Sources/W3C CSS Images/PaintOrder.swift
index 4814aa6..b8b63d9 100644
--- a/Sources/W3C CSS Images/PaintOrder.swift	
+++ b/Sources/W3C CSS Images/PaintOrder.swift	
@@ -4,7 +4,7 @@ public enum PaintOrder: Property {
 
     case normal
 
-    case custom(Set<PaintLayer>)
+    case custom([PaintLayer])
 
     case global(Global)
 }
@@ -26,7 +26,7 @@ extension PaintOrder: CustomStringConvertible {
                 return "normal"
             }
 
-            return layers.map { $0.rawValue }.sorted().joined(separator: " ")
+            return layers.map { $0.rawValue }.joined(separator: " ")
 
         case .global(let global):
             return global.description
@@ -47,6 +47,10 @@ extension PaintOrder {
     public static let markers: PaintOrder = .first(.markers)
 
     public static func order(_ layers: PaintLayer...) -> PaintOrder {
-        .custom(Set(layers))
+        .custom(
+            layers.reduce(into: [PaintLayer]()) { result, layer in
+                if !result.contains(layer) { result.append(layer) }
+            }
+        )
     }
 }
