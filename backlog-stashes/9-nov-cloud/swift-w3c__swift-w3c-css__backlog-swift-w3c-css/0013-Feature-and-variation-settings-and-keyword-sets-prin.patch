diff --git a/Sources/W3C CSS Text/TextUnderlinePosition.swift b/Sources/W3C CSS Text/TextUnderlinePosition.swift
index a5f4412..7e373f8 100644
--- a/Sources/W3C CSS Text/TextUnderlinePosition.swift	
+++ b/Sources/W3C CSS Text/TextUnderlinePosition.swift	
@@ -91,7 +91,8 @@ extension TextUnderlinePosition: CustomStringConvertible {
             return "right"
 
         case .combined(let values):
-            return values.map { $0.description }.joined(separator: " ")
+            let order: [TextUnderlinePositionValue] = [.auto, .fromFont, .under, .left, .right]
+            return order.filter { values.contains($0) }.map { $0.description }.joined(separator: " ")
 
         case .global(let global):
             return global.description
diff --git a/Tests/W3C CSS Fonts Tests/FontFeatureSettings Tests.swift b/Tests/W3C CSS Fonts Tests/FontFeatureSettings Tests.swift
new file mode 100644
index 0000000..495a1c9
--- /dev/null
+++ b/Tests/W3C CSS Fonts Tests/FontFeatureSettings Tests.swift	
@@ -0,0 +1,15 @@
+import Testing
+
+@testable import W3C_CSS_Fonts
+
+enum `FontFeatureSettings Tests` {}
+
+extension `FontFeatureSettings Tests` {
+    @Suite
+    struct `FontFeatureSettings - Serialization` {
+        @Test func `features print in a stable order`() {
+            let settings = FontFeatureSettings.features(["liga": .on, "kern": .off, "smcp": nil])
+            #expect(settings.description == "\"kern\" off, \"liga\" on, \"smcp\"")
+        }
+    }
+}
