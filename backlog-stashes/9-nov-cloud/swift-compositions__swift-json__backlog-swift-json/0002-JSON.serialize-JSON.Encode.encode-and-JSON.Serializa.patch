From 5de34afd41656719278dd6091026f05c1957d15b Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Mon, 9 Nov 2026 11:30:16 +0000
Subject: [PATCH 2/3] JSON.serialize, JSON.Encode.encode and
 JSON.Serializable.jsonString/jsonBytes throw JSON.Encode.Error.depthExceeded
 instead of trapping beyond maxDepth (swift-compositions/swift-json#15)

---
 Sources/JSON/JSON.Encode.swift            |  26 ++---
 Sources/JSON/JSON.Serializable.swift      |  11 ++-
 Sources/JSON/JSON.swift                   |  46 +++++----
 Tests/JSON Tests/Encoder Tests.swift      | 111 ++++++++++++++--------
 Tests/JSON Tests/JSON Tests.swift         |  29 +++++-
 Tests/JSON Tests/JSON.Encoder Tests.swift |   2 +-
 Tests/JSON Tests/Round-Trip Tests.swift   |  18 ++--
 7 files changed, 151 insertions(+), 92 deletions(-)

diff --git a/Sources/JSON/JSON.Encode.swift b/Sources/JSON/JSON.Encode.swift
index 8edb6ce..b47be7f 100644
--- a/Sources/JSON/JSON.Encode.swift
+++ b/Sources/JSON/JSON.Encode.swift
@@ -19,36 +19,30 @@ extension JSON.Encode.Error: CustomStringConvertible {
 
 extension JSON.Encode {
 
+    /// `value` encoded as JSON text.
+    ///
+    /// Throws ``JSON/Encode/Error/depthExceeded(maxDepth:)`` when `value` nests deeper than `options.maxDepth`.
     @inlinable
     public static func encode(
         _ value: RFC_8259.Value,
         options: JSON.Encode.Options = JSON.Encode.Options()
-    ) -> [UInt8] {
+    ) throws(JSON.Encode.Error) -> [UInt8] {
         var buffer: [UInt8] = []
         var encoder = Encoder(options: options)
-        do throws(JSON.Encode.Error) {
-            try encoder.encode(value, into: &buffer)
-        } catch {
-            preconditionFailure(
-                "JSON encoding exceeded maximum depth despite non-throwing contract: \(error)"
-            )
-        }
+        try encoder.encode(value, into: &buffer)
         return buffer
     }
 
+    /// Appends `value` encoded as JSON text to `buffer`.
+    ///
+    /// Throws ``JSON/Encode/Error/depthExceeded(maxDepth:)`` when `value` nests deeper than `options.maxDepth`.
     @inlinable
     public static func encode<Buffer: Swift.RangeReplaceableCollection>(
         _ value: RFC_8259.Value,
         into buffer: inout Buffer,
         options: JSON.Encode.Options = JSON.Encode.Options()
-    ) where Buffer.Element == UInt8 {
+    ) throws(JSON.Encode.Error) where Buffer.Element == UInt8 {
         var encoder = Encoder(options: options)
-        do throws(JSON.Encode.Error) {
-            try encoder.encode(value, into: &buffer)
-        } catch {
-            preconditionFailure(
-                "JSON encoding exceeded maximum depth despite non-throwing contract: \(error)"
-            )
-        }
+        try encoder.encode(value, into: &buffer)
     }
 }
diff --git a/Sources/JSON/JSON.Serializable.swift b/Sources/JSON/JSON.Serializable.swift
index 5213489..c3e8871 100644
--- a/Sources/JSON/JSON.Serializable.swift
+++ b/Sources/JSON/JSON.Serializable.swift
@@ -88,14 +88,17 @@ extension JSON.Serializable {
         throw .unknown
     }
 
+    /// This value as JSON text; throws when it nests deeper than the default ``JSON/Encode/Options/maxDepth``.
     @inlinable
-    public func jsonString(pretty: Bool = false, sortKeys: Bool = false) -> String {
-        json.serialize(pretty: pretty, sortKeys: sortKeys)
+    public func jsonString(pretty: Bool = false, sortKeys: Bool = false) throws(JSON.Encode.Error) -> String {
+        try json.serialize(pretty: pretty, sortKeys: sortKeys)
     }
 
+    /// This value as JSON text in UTF-8 bytes; throws when it nests deeper than the default
+    /// ``JSON/Encode/Options/maxDepth``.
     @inlinable
-    public func jsonBytes(pretty: Bool = false, sortKeys: Bool = false) -> [UInt8] {
-        json.serialize(pretty: pretty, sortKeys: sortKeys, as: [UInt8].self)
+    public func jsonBytes(pretty: Bool = false, sortKeys: Bool = false) throws(JSON.Encode.Error) -> [UInt8] {
+        try json.serialize(pretty: pretty, sortKeys: sortKeys, as: [UInt8].self)
     }
 }
 
diff --git a/Sources/JSON/JSON.swift b/Sources/JSON/JSON.swift
index cd5e925..9173022 100644
--- a/Sources/JSON/JSON.swift
+++ b/Sources/JSON/JSON.swift
@@ -162,33 +162,33 @@ extension JSON {
 
 extension JSON {
 
+    /// This value as JSON text.
+    ///
+    /// Throws ``JSON/Encode/Error/depthExceeded(maxDepth:)`` when the value nests deeper than the default
+    /// ``JSON/Encode/Options/maxDepth``.
     @inlinable
-    public func serialize(pretty: Bool = false, sortKeys: Bool = false) -> String {
+    public func serialize(pretty: Bool = false, sortKeys: Bool = false) throws(JSON.Encode.Error) -> String {
         let options = JSON.Encode.Options(prettyPrint: pretty, sortKeys: sortKeys)
         var bytes: [UInt8] = []
         var encoder = JSON.Encode.Encoder(options: options)
-        do throws(JSON.Encode.Error) {
-            try encoder.encode(raw, into: &bytes)
-        } catch {
-            preconditionFailure(
-                "JSON encoding exceeded maximum depth despite non-throwing contract: \(error)"
-            )
-        }
+        try encoder.encode(raw, into: &bytes)
         return String(decoding: bytes, as: UTF8.self)
     }
 
+    /// This value as JSON text, in UTF-8 bytes.
+    ///
+    /// Throws ``JSON/Encode/Error/depthExceeded(maxDepth:)`` when the value nests deeper than the default
+    /// ``JSON/Encode/Options/maxDepth``.
     @inlinable
-    public func serialize(pretty: Bool = false, sortKeys: Bool = false, as: [UInt8].Type) -> [UInt8] {
+    public func serialize(
+        pretty: Bool = false,
+        sortKeys: Bool = false,
+        as: [UInt8].Type
+    ) throws(JSON.Encode.Error) -> [UInt8] {
         let options = JSON.Encode.Options(prettyPrint: pretty, sortKeys: sortKeys)
         var bytes: [UInt8] = []
         var encoder = JSON.Encode.Encoder(options: options)
-        do throws(JSON.Encode.Error) {
-            try encoder.encode(raw, into: &bytes)
-        } catch {
-            preconditionFailure(
-                "JSON encoding exceeded maximum depth despite non-throwing contract: \(error)"
-            )
-        }
+        try encoder.encode(raw, into: &bytes)
         return bytes
     }
 }
@@ -221,7 +221,19 @@ extension JSON {
         _ value: T,
         options: JSON.Encode.Options = JSON.Encode.Options()
     ) throws(Swift.EncodingError) -> [Byte] {
-        JSON.Encode.encode(RFC_8259.Value(try JSON(encoding: value)), options: options).map { Byte($0) }
+        let tree = RFC_8259.Value(try JSON(encoding: value))
+        do throws(JSON.Encode.Error) {
+            return try JSON.Encode.encode(tree, options: options).map { Byte($0) }
+        } catch {
+            throw .invalidValue(
+                value,
+                EncodingError.Context(
+                    codingPath: [],
+                    debugDescription: error.description,
+                    underlyingError: error
+                )
+            )
+        }
     }
 }
 
