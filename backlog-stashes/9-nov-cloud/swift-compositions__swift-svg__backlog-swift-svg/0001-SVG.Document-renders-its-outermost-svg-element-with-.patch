From b464bb36be48104e5277698c3845ec8fa9b33122 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Mon, 9 Nov 2026 11:33:02 +0000
Subject: [PATCH] SVG.Document renders its outermost svg element with
 xmlns="http://www.w3.org/2000/svg" so the output opens as a standalone SVG
 file (swift-compositions/swift-svg#7)

---
 Sources/SVG/SVG.Document.swift      | 38 +++++++++++++++++++++++++++++
 Tests/SVG Tests/DocumentTests.swift | 18 +++++++++++++-
 2 files changed, 55 insertions(+), 1 deletion(-)
 create mode 100644 Sources/SVG/SVG.Document.swift

diff --git a/Sources/SVG/SVG.Document.swift b/Sources/SVG/SVG.Document.swift
new file mode 100644
index 0000000..4e898c4
--- /dev/null
+++ b/Sources/SVG/SVG.Document.swift
@@ -0,0 +1,38 @@
+public import SVG_Rendering
+public import SVG_Standard
+
+extension SVG_Rendering::SVG {
+    /// A standalone SVG document: its outermost `svg` element declares the SVG namespace,
+    /// `xmlns="http://www.w3.org/2000/svg"`, so the rendered text opens as an `.svg` file.
+    ///
+    /// ```swift
+    /// let document = SVG.Document(svg(width: 100, height: 100)) {
+    ///     circle(cx: 50, cy: 50, r: 40)
+    /// }
+    /// ```
+    public struct Document<Content: SVG_Rendering::SVG.View>: SVG_Rendering::SVG.View {
+        /// The outermost `svg` element.
+        public let root: SVG_Standard::SVG_Standard.Document.SVG
+
+        let content: Content
+
+        /// Creates a document whose outermost element is `root`, holding `content`.
+        public init(
+            _ root: SVG_Standard::SVG_Standard.Document.SVG,
+            @SVG_Rendering::SVG.Builder _ content: () -> Content = { SVG_Rendering::SVG.Empty() }
+        ) {
+            self.root = root
+            self.content = content()
+        }
+    }
+}
+
+extension SVG_Rendering::SVG.Document {
+    /// The SVG namespace every standalone SVG document declares on its outermost element.
+    public static var namespace: String { "http://www.w3.org/2000/svg" }
+
+    public var body: some SVG_Rendering::SVG.View {
+        root { content }
+            .xmlns(Self.namespace)
+    }
+}
diff --git a/Tests/SVG Tests/DocumentTests.swift b/Tests/SVG Tests/DocumentTests.swift
index d390392..303f7f6 100644
--- a/Tests/SVG Tests/DocumentTests.swift	
+++ b/Tests/SVG Tests/DocumentTests.swift	
@@ -1,5 +1,5 @@
-import Space_Test_Support
 import SVG
+import Space_Test_Support
 import Testing
 
 @Suite
@@ -54,4 +54,20 @@ struct `Document Tests` {
         let rendered = String(svgElement)
         #expect(!rendered.contains("\n"))
     }
+
+    @Test
+    func `SVG document declares the SVG namespace on its outermost element`() {
+        let document = SVG.Document(svg(width: 100, height: 100)) {
+            g {
+                circle(cx: 50, cy: 50, r: 40)
+            }
+        }
+
+        let rendered = String(document)
+        #expect(rendered.hasPrefix("<svg"))
+        #expect(rendered.contains("xmlns=\"http://www.w3.org/2000/svg\""))
+        #expect(rendered.contains("width=\"100\""))
+        #expect(rendered.ranges(of: "xmlns=").count == 1)
+        #expect(rendered.hasSuffix("</svg>"))
+    }
 }
