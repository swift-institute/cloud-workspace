From 9f4ee49a5d1bb5611d465775026cbbaf18af5aa9 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Mon, 9 Nov 2026 11:31:29 +0000
Subject: [PATCH 1/2] URI.canonical(authority:) keeps the userinfo, the
 authority's or else the URI's, instead of dropping it
 (swift-standards/swift-uri-standard#7)

---
 Sources/URI Standard/URI.Canonicalization.swift  | 10 +++++++++-
 .../URI Standard Tests/URI Canonical Tests.swift | 16 ++++++++++++++++
 2 files changed, 25 insertions(+), 1 deletion(-)

diff --git a/Sources/URI Standard/URI.Canonicalization.swift b/Sources/URI Standard/URI.Canonicalization.swift
index 567f2de..609ed2a 100644
--- a/Sources/URI Standard/URI.Canonicalization.swift	
+++ b/Sources/URI Standard/URI.Canonicalization.swift	
@@ -7,6 +7,10 @@ extension RFC_3986.URI {
 
 extension RFC_3986.URI {
 
+    /// This URI with its host and port replaced by `authority`'s.
+    ///
+    /// The userinfo is kept: `authority`'s when it has one, otherwise this URI's, so
+    /// `https://user@example.com/` becomes `https://user@canonical.com/`.
     public func canonical(
         authority: RFC_3986.URI.Authority
     ) throws(RFC_3986.URI.Canonicalization.Error) -> RFC_3986.URI {
@@ -20,7 +24,11 @@ extension RFC_3986.URI {
         }
         var host: [Byte] = []
         RFC_3986.URI.Host.serialize(authority.host, into: &host)
-        value += "//\(String(decoding: host, as: UTF8.self))"
+        value += "//"
+        if let userinfo = authority.userinfo ?? self.userinfo {
+            value += "\(userinfo.description)@"
+        }
+        value += String(decoding: host, as: UTF8.self)
         if let port = authority.port {
             value += ":\(port.value)"
         }
diff --git a/Tests/URI Standard Tests/URI Canonical Tests.swift b/Tests/URI Standard Tests/URI Canonical Tests.swift
index 9dd6f9e..fccb8cc 100644
--- a/Tests/URI Standard Tests/URI Canonical Tests.swift	
+++ b/Tests/URI Standard Tests/URI Canonical Tests.swift	
@@ -41,6 +41,22 @@ struct `URI Canonical Tests` {
 
     @Suite
     struct `Edge Case` {
+        @Test
+        func `canonical keeps the userinfo of the URI`() throws(URI.Canonicalization.Error) {
+            let uri = URI(unchecked: "https://user@example.com/path")
+            let result = try uri.canonical(authority: URI.Canonicalization.authority("canonical.com"))
+
+            #expect(result == "https://user@canonical.com/path")
+        }
+
+        @Test
+        func `canonical takes the userinfo of the authority when it has one`() throws(URI.Canonicalization.Error) {
+            let uri = URI(unchecked: "https://user@example.com/path")
+            let result = try uri.canonical(authority: URI.Canonicalization.authority("other:secret@canonical.com:8443"))
+
+            #expect(result == "https://other:secret@canonical.com:8443/path")
+        }
+
         @Test
         func `canonical rejects an empty host`() {
             let uri = URI(unchecked: "https://example.com/path")
-- 
