From 290f75862179f35230d90c6bbd49b8c329a06ac5 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Mon, 9 Nov 2026 11:35:14 +0000
Subject: [PATCH 1/2] Color stores its XYZ under the D65 white point, so the
 same color reached from a D50 space compares equal
 (swift-standards/swift-color-standard#5)

---
 Sources/Color Standard/Color.swift | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/Sources/Color Standard/Color.swift b/Sources/Color Standard/Color.swift
index 9b2e1ba..943e1e3 100644
--- a/Sources/Color Standard/Color.swift	
+++ b/Sources/Color Standard/Color.swift	
@@ -1,5 +1,9 @@
 import ISO_9899
 
+/// A color, stored as CIE XYZ under the D65 white point with an alpha.
+///
+/// A color reached from a D50 space such as LAB is adapted to D65 when it is made, so equality
+/// compares colors under one white point.
 public struct Color: Sendable, Hashable {
 
     internal var _xyz: _XYZ
@@ -7,7 +11,7 @@ public struct Color: Sendable, Hashable {
     internal var _alpha: Double
 
     internal init(_xyz: _XYZ, _alpha: Double = 1.0) {
-        self._xyz = _xyz
+        self._xyz = _xyz.adapted(to: .d65)
         self._alpha = _alpha.clamped(to: 0...1)
     }
 }
