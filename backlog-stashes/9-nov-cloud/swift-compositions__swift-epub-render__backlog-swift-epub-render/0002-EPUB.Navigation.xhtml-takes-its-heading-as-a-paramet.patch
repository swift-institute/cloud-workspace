From 19a6052e7be24105aa70d7160c1872b421725777 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Mon, 9 Nov 2026 11:38:05 +0000
Subject: [PATCH 2/2] EPUB.Navigation.xhtml takes its heading as a parameter
 and throws EPUB.Navigation.Error.empty instead of writing a toc nav without
 the required ol (swift-compositions/swift-epub-render#5)

---
 .../EPUB.Navigation.Error.swift               |  9 +++++
 Sources/EPUB Rendering/EPUB.Navigation.swift  |  9 +++--
 .../EPUB.Navigation Tests.swift               | 34 +++++++++++++++++++
 3 files changed, 50 insertions(+), 2 deletions(-)
 create mode 100644 Sources/EPUB Rendering/EPUB.Navigation.Error.swift
 create mode 100644 Tests/EPUB Rendering Tests/EPUB.Navigation Tests.swift

diff --git a/Sources/EPUB Rendering/EPUB.Navigation.Error.swift b/Sources/EPUB Rendering/EPUB.Navigation.Error.swift
new file mode 100644
index 0000000..da446df
--- /dev/null
+++ b/Sources/EPUB Rendering/EPUB.Navigation.Error.swift	
@@ -0,0 +1,9 @@
+extension EPUB.Navigation {
+
+    /// A navigation document that EPUB forbids.
+    public enum Error: Swift.Error, Sendable, Hashable {
+
+        /// A `toc` nav needs an `ol` with at least one entry.
+        case empty
+    }
+}
diff --git a/Sources/EPUB Rendering/EPUB.Navigation.swift b/Sources/EPUB Rendering/EPUB.Navigation.swift
index d5d487f..93d6db2 100644
--- a/Sources/EPUB Rendering/EPUB.Navigation.swift	
+++ b/Sources/EPUB Rendering/EPUB.Navigation.swift	
@@ -20,11 +20,16 @@ extension EPUB.Navigation {
         }
     }
 
+    /// Throws ``Error/empty`` when `items` is empty: EPUB requires the `toc`
+    /// nav's list to hold at least one entry.
     public static func xhtml(
         title: String,
+        heading: String,
         items: [Item],
         language: BCP47.LanguageTag
-    ) -> String {
+    ) throws(EPUB.Navigation.Error) -> String {
+        guard !items.isEmpty else { throw .empty }
+
         var xml = """
             <?xml version="1.0" encoding="UTF-8"?>
             <!DOCTYPE html>
@@ -35,7 +40,7 @@ extension EPUB.Navigation {
             </head>
             <body>
               <nav epub:type="toc" id="toc">
-                <h1>Table of Contents</h1>
+                <h1>\(escapeXML(heading))</h1>
 
             """
 
diff --git a/Tests/EPUB Rendering Tests/EPUB.Navigation Tests.swift b/Tests/EPUB Rendering Tests/EPUB.Navigation Tests.swift
new file mode 100644
index 0000000..fa3fccb
--- /dev/null
+++ b/Tests/EPUB Rendering Tests/EPUB.Navigation Tests.swift	
@@ -0,0 +1,34 @@
+import BCP_47
+import RFC_3987
+import Testing
+
+@testable import EPUB_Rendering
+
+enum `EPUB.Navigation Tests` {}
+
+extension `EPUB.Navigation Tests` {
+    @Suite
+    struct `Navigation document` {
+
+        @Test
+        func `an empty item list is rejected`() throws {
+            let language = try BCP47.LanguageTag("en")
+            #expect(throws: EPUB.Navigation.Error.empty) {
+                try EPUB.Navigation.xhtml(title: "Book", heading: "Contents", items: [], language: language)
+            }
+        }
+
+        @Test
+        func `the heading is the one given`() throws {
+            let xhtml = try EPUB.Navigation.xhtml(
+                title: "Boek",
+                heading: "Inhoud",
+                items: [.init(title: "Een", href: try RFC_3987.IRI.Reference("een.xhtml"))],
+                language: try BCP47.LanguageTag("nl")
+            )
+            #expect(xhtml.contains("<h1>Inhoud</h1>"))
+            #expect(!xhtml.contains("Table of Contents"))
+            #expect(xhtml.contains("<ol>"))
+        }
+    }
+}
