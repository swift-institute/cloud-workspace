From 6c9aa6a0dcd81ef685af61c65fbaa36f1bab2a7c Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Mon, 9 Nov 2026 11:36:32 +0000
Subject: [PATCH 2/7] Atomic writes copy the replaced file's extended
 attributes and, on Linux, its POSIX ACLs when asked, and refuse ACL
 preservation where it is unsupported instead of ignoring both options
 (swift-compositions/swift-file-system#22)

---
 Sources/File System Core/Error.Code.swift     |  6 ++
 .../File.System.Write.Atomic+API.swift        | 62 ++++++++++++++++++-
 ...ile.System.Write.Atomic.Preservation.swift |  3 +
 .../File.System.Write.Atomic Tests.swift      | 38 ++++++++++++
 4 files changed, 107 insertions(+), 2 deletions(-)

diff --git a/Sources/File System Core/Error.Code.swift b/Sources/File System Core/Error.Code.swift
index 1d10f47..15821ea 100644
--- a/Sources/File System Core/Error.Code.swift	
+++ b/Sources/File System Core/Error.Code.swift	
@@ -41,4 +41,10 @@ extension Error::Error.Code {
             .EEXIST
         #endif
     }
+
+    #if !os(Windows)
+        internal static var _notSupported: Self {
+            .ENOTSUP
+        }
+    #endif
 }
diff --git a/Sources/File System Core/File.System.Write.Atomic+API.swift b/Sources/File System Core/File.System.Write.Atomic+API.swift
index eadb720..70b4a63 100644
--- a/Sources/File System Core/File.System.Write.Atomic+API.swift	
+++ b/Sources/File System Core/File.System.Write.Atomic+API.swift	
@@ -109,6 +109,11 @@ extension File.System.Write.Atomic {
         phase = .syncedFile
 
         if let stats = destStats {
+            try applyAttributes(
+                from: resolved,
+                to: tempPath,
+                options: options
+            )
             try applyMetadata(
                 from: stats,
                 to: descriptor,
@@ -300,8 +305,61 @@ extension File.System.Write.Atomic {
                 throw .timestampPreservationFailed(error)
             }
         }
+    }
+
+    private static func applyAttributes(
+        from source: File.Path,
+        to destination: File.Path,
+        options: borrowing Options
+    ) throws(Error) {
+        let wantsAttributes = options.preservation.contains(.extendedAttributes)
+        let wantsACLs = options.preservation.contains(.acls)
+        guard wantsAttributes || wantsACLs else { return }
+
+        #if !os(Linux)
+            if wantsACLs {
+                throw .platformIncompatible(
+                    operation: "acl",
+                    message: "ACL preservation is only supported on Linux"
+                )
+            }
+        #endif
+
+        let names: [Swift.String]
+        do throws(File.System.Metadata.Attributes.Error) {
+            names = try File.System.Metadata.Attributes.list(at: source)
+        } catch {
+            #if !os(Windows)
+                if error.code == ._notSupported { return }
+            #endif
+            throw .metadataPreservationFailed(
+                operation: "listxattr",
+                code: error.code,
+                message: "\(error)"
+            )
+        }
 
-        _ = options.preservation.contains(.extendedAttributes)
-        _ = options.preservation.contains(.acls)
+        do throws(File.System.Metadata.Attributes.Error) {
+            for name in names {
+                #if os(Linux)
+                    let wanted =
+                        name.hasPrefix("system.posix_acl_")
+                        ? wantsACLs : wantsAttributes && name.hasPrefix("user.")
+                #else
+                    let wanted = wantsAttributes
+                #endif
+                guard wanted else { continue }
+                guard let value = try File.System.Metadata.Attributes.get(name, at: source) else {
+                    continue
+                }
+                try File.System.Metadata.Attributes.set(name, to: value.span, at: destination)
+            }
+        } catch {
+            throw .metadataPreservationFailed(
+                operation: "xattr",
+                code: error.code,
+                message: "\(error)"
+            )
+        }
     }
 }
diff --git a/Sources/File System Core/File.System.Write.Atomic.Preservation.swift b/Sources/File System Core/File.System.Write.Atomic.Preservation.swift
index a9b1991..a454e39 100644
--- a/Sources/File System Core/File.System.Write.Atomic.Preservation.swift	
+++ b/Sources/File System Core/File.System.Write.Atomic.Preservation.swift	
@@ -17,8 +17,11 @@ extension File.System.Write.Atomic.Preservation {
 
     public static let timestamps = Self(rawValue: 1 << 1)
 
+    /// Copies the replaced file's extended attributes to the new file (on Linux, those in the `user.` namespace).
     public static let extendedAttributes = Self(rawValue: 1 << 2)
 
+    /// Copies the replaced file's POSIX ACLs to the new file. Supported on Linux only; elsewhere a write that
+    /// replaces a file with this option fails with `platformIncompatible`.
     public static let acls = Self(rawValue: 1 << 3)
 
     public static let all: Self = [
diff --git a/Tests/File System Core Tests/File.System.Write.Atomic Tests.swift b/Tests/File System Core Tests/File.System.Write.Atomic Tests.swift
index e30b41a..a0df44a 100644
--- a/Tests/File System Core Tests/File.System.Write.Atomic Tests.swift	
+++ b/Tests/File System Core Tests/File.System.Write.Atomic Tests.swift	
@@ -332,6 +332,44 @@ extension `File.System.Write.Atomic Tests`.Test.Unit {
 
 extension `File.System.Write.Atomic Tests`.Test.Integration {
 
+    #if os(Linux) || os(macOS)
+        @Test
+        func `extendedAttributes preservation carries the replaced file's attributes`() throws {
+            try File.Directory.temporary { dir in
+                let path = dir.path / "kept.txt"
+                let empty: [Byte] = []
+                try File.System.Write.Atomic.write(empty.span, to: path)
+                let value = [Byte](utf8: "kept")
+                try File.System.Metadata.Attributes.set("user.example.kept", to: value.span, at: path)
+
+                let data: [Byte] = ([1, 2, 3] as [UInt8]).map(Byte.init(bitPattern:))
+                try File.System.Write.Atomic.write(
+                    data.span,
+                    to: path,
+                    options: .init(preservation: [.permissions, .extendedAttributes])
+                )
+
+                #expect(try File.System.Metadata.Attributes.get("user.example.kept", at: path) == value)
+            }
+        }
+
+        @Test
+        func `Without extendedAttributes preservation the replaced file's attributes are dropped`() throws {
+            try File.Directory.temporary { dir in
+                let path = dir.path / "dropped.txt"
+                let empty: [Byte] = []
+                try File.System.Write.Atomic.write(empty.span, to: path)
+                let value = [Byte](utf8: "dropped")
+                try File.System.Metadata.Attributes.set("user.example.dropped", to: value.span, at: path)
+
+                let data: [Byte] = ([1, 2, 3] as [UInt8]).map(Byte.init(bitPattern:))
+                try File.System.Write.Atomic.write(data.span, to: path)
+
+                #expect(try File.System.Metadata.Attributes.get("user.example.dropped", at: path) == nil)
+            }
+        }
+    #endif
+
     @Test
     func `Racing noClobber writers never overwrite the destination`() async throws {
         let temporary = File.temporary(extension: "bin", prefix: "noclobber-race")
