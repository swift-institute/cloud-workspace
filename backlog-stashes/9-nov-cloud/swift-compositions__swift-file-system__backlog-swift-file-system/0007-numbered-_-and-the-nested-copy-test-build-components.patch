From 31af1a366de327ab8d244800119e99ac7bfe6570 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Mon, 9 Nov 2026 13:58:44 +0000
Subject: [PATCH 7/7] numbered(_:) and the nested-copy test build components
 with the throwing init, now that swift-iso-9945's Filename takes no string
 interpolation (follows swift-iso-9945#93, coenttb/work#242)

---
 Sources/File System Core/File.Path.Component.swift       | 9 ++++++++-
 .../File.System.Copy.Recursive Tests.swift               | 4 ++--
 2 files changed, 10 insertions(+), 3 deletions(-)

diff --git a/Sources/File System Core/File.Path.Component.swift b/Sources/File System Core/File.Path.Component.swift
index 342e3d7..ae0cc55 100644
--- a/Sources/File System Core/File.Path.Component.swift	
+++ b/Sources/File System Core/File.Path.Component.swift	
@@ -54,6 +54,13 @@ extension File.Path.Component {
     public func numbered(_ number: Int) -> File.Path.Component {
         guard number > 1 else { return self }
         let suffix = self.extension.map { "." + $0.string } ?? ""
-        return File.Path.Component("\(stem.string) \(number)\(suffix)")
+        let name = "\(stem.string) \(number)\(suffix)"
+        do throws(Path::Path.Component.Error) {
+            return try File.Path.Component(name)
+        } catch {
+            // swift-linter:disable:next fatal error outside tests
+            // REASON: the stem and extension come from a valid component, and a space and decimal digits keep it valid, so this name cannot be refused.
+            fatalError("Numbered name \(name) is not a path component (\(error))")
+        }
     }
 }
diff --git a/Tests/File System Core Tests/File.System.Copy.Recursive Tests.swift b/Tests/File System Core Tests/File.System.Copy.Recursive Tests.swift
index 13ec3d3..625633a 100644
--- a/Tests/File System Core Tests/File.System.Copy.Recursive Tests.swift	
+++ b/Tests/File System Core Tests/File.System.Copy.Recursive Tests.swift	
@@ -255,8 +255,8 @@ extension `File.System.Copy.Recursive Tests` {
                 let destPath = dir.path / "dest"
 
                 var currentPath = sourcePath
-                (1...5).forEach { i in
-                    let component = File.Path.Component("\(i)")
+                try (1...5).forEach { i in
+                    let component = try File.Path.Component("\(i)" as Swift.String)
                     currentPath = currentPath.appending(component)
                 }
 
-- 
