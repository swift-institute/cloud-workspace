From 00c59aea96c908fc527ae7570f3935b957b01cf3 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Mon, 9 Nov 2026 11:32:17 +0000
Subject: [PATCH 3/3] Parsers.Diagnostic.Source.line(_:) strips the trailing
 line break from the last line like every other line
 (swift-compositions/swift-parsers#9)

---
 Sources/Parsers/Parsers.Diagnostic.swift          | 2 ++
 Tests/Parsers Tests/Parser.Diagnostic Tests.swift | 9 ++++++++-
 2 files changed, 10 insertions(+), 1 deletion(-)

diff --git a/Sources/Parsers/Parsers.Diagnostic.swift b/Sources/Parsers/Parsers.Diagnostic.swift
index f98def6..a9f3e96 100644
--- a/Sources/Parsers/Parsers.Diagnostic.swift
+++ b/Sources/Parsers/Parsers.Diagnostic.swift
@@ -54,6 +54,8 @@ extension Parsers.Diagnostic.Source {
             if idx + 1 < lineStarts.count {
 
                 content.index(before: lineStarts[idx + 1])
+            } else if content.utf8.last == 0x0A {
+                content.index(before: content.endIndex)
             } else {
                 content.endIndex
             }
diff --git a/Tests/Parsers Tests/Parser.Diagnostic Tests.swift b/Tests/Parsers Tests/Parser.Diagnostic Tests.swift
index e9f3f53..69dde6e 100644
--- a/Tests/Parsers Tests/Parser.Diagnostic Tests.swift	
+++ b/Tests/Parsers Tests/Parser.Diagnostic Tests.swift	
@@ -46,7 +46,14 @@ extension `Parser.Diagnostic Tests`.`Parsers.Diagnostic.Source`.`Line Starts` {
         let source = Parsers.Diagnostic.Source(content: "aaa\nbbb\n")
         #expect(source.line(1) == "aaa")
 
-        #expect(source.line(2) == "bbb\n")
+        #expect(source.line(2) == "bbb")
+        #expect(source.line(3) == nil)
+    }
+
+    @Test
+    func `Trailing CRLF is stripped from the last line`() {
+        let source = Parsers.Diagnostic.Source(content: "aaa\r\nbbb\r\n")
+        #expect(source.line(2) == "bbb")
         #expect(source.line(3) == nil)
     }
 
