From d1101c81d610adc1b8c0c6a1e03a98b9d28567ae Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Mon, 9 Nov 2026 11:32:02 +0000
Subject: [PATCH 2/3] Parsers.Expression.Climbing stops before a second
 non-associative operator of the same precedence, so a < b < c no longer
 parses as one expression; postfix operators are now tested
 (swift-compositions/swift-parsers#9)

---
 Sources/Parsers/Parsers.Expression.swift      | 10 ++
 .../Parser.Expression Tests.swift             | 96 +++++++++++++++++++
 2 files changed, 106 insertions(+)

diff --git a/Sources/Parsers/Parsers.Expression.swift b/Sources/Parsers/Parsers.Expression.swift
index b87db95..592c27b 100644
--- a/Sources/Parsers/Parsers.Expression.swift
+++ b/Sources/Parsers/Parsers.Expression.swift
@@ -50,6 +50,8 @@ extension Parsers.Expression.Climbing: Parsing {
             }
         }
 
+        var nonAssociative: Int?
+
         while true {
 
             var matchedOp: Parsers.Expression.Operator<Operand, Op>?
@@ -76,6 +78,11 @@ extension Parsers.Expression.Climbing: Parsing {
                 break
             }
 
+            guard nonAssociative != op.precedence else {
+                input = opSaved
+                break
+            }
+
             let nextPrecedence: Int
             switch op.associativity {
             case .left:
@@ -103,6 +110,9 @@ extension Parsers.Expression.Climbing: Parsing {
             }
 
             lhs = op.apply(lhs, rhs)
+            if case .none = op.associativity {
+                nonAssociative = op.precedence
+            }
         }
 
         return lhs
diff --git a/Tests/Parsers Tests/Parser.Expression Tests.swift b/Tests/Parsers Tests/Parser.Expression Tests.swift
index 06360f6..ce822eb 100644
--- a/Tests/Parsers Tests/Parser.Expression Tests.swift	
+++ b/Tests/Parsers Tests/Parser.Expression Tests.swift	
@@ -171,4 +171,100 @@ extension `Parser.Expression Tests`.`Parsers.Expression`.`Edge Case` {
 
         #expect(result == 2)
     }
+
+    @Test
+    func `non-associative operator rejects a chain of the same precedence`() throws {
+        let parser = Parsers.Expression.Climbing(
+            atom: IntAtom(),
+            operators: [
+                .init(
+                    parser: OpParser(byte: UInt8(ascii: "<")),
+                    precedence: 1,
+                    associativity: .none
+                ) { $0 < $1 ? 1 : 0 },
+                .init(
+                    parser: OpParser(byte: UInt8(ascii: "+")),
+                    precedence: 2,
+                    associativity: .left
+                ) { $0 + $1 },
+            ]
+        )
+        var input = "1<2<3"[...].utf8
+
+        let result = try parser.parse(&input)
+
+        #expect(result == 1)
+        #expect(input.first == UInt8(ascii: "<"))
+    }
+
+    @Test
+    func `non-associative operator accepts higher-precedence operands`() throws {
+        let parser = Parsers.Expression.Climbing(
+            atom: IntAtom(),
+            operators: [
+                .init(
+                    parser: OpParser(byte: UInt8(ascii: "<")),
+                    precedence: 1,
+                    associativity: .none
+                ) { $0 < $1 ? 1 : 0 },
+                .init(
+                    parser: OpParser(byte: UInt8(ascii: "+")),
+                    precedence: 2,
+                    associativity: .left
+                ) { $0 + $1 },
+            ]
+        )
+        var input = "1+1<1+2"[...].utf8
+
+        let result = try parser.parse(&input)
+
+        #expect(result == 1)
+        #expect(input.isEmpty)
+    }
+
+    @Test
+    func `postfix operator binds tighter than infix`() throws {
+        let parser = Parsers.Expression.Climbing(
+            atom: IntAtom(),
+            operators: [
+                .init(
+                    parser: OpParser(byte: UInt8(ascii: "+")),
+                    precedence: 1,
+                    associativity: .left
+                ) { $0 + $1 }
+            ],
+            postfix: [
+                .init(parser: OpParser(byte: UInt8(ascii: "!"))) { $0 * 2 }
+            ]
+        )
+        var input = "1+3!"[...].utf8
+
+        let result = try parser.parse(&input)
+
+        #expect(result == 7)
+        #expect(input.isEmpty)
+    }
+
+    @Test
+    func `postfix operator applies to the leading operand`() throws {
+        let parser = Parsers.Expression.Climbing(
+            atom: IntAtom(),
+            operators: [
+                .init(
+                    parser: OpParser(byte: UInt8(ascii: "+")),
+                    precedence: 1,
+                    associativity: .left
+                ) { $0 + $1 }
+            ],
+            postfix: [
+                .init(parser: OpParser(byte: UInt8(ascii: "!"))) { $0 * 2 }
+            ]
+        )
+        var input = "3!+1"[...].utf8
+
+        let result = try parser.parse(&input)
+
+        #expect(result == 7)
+        #expect(input.isEmpty)
+    }
 }
