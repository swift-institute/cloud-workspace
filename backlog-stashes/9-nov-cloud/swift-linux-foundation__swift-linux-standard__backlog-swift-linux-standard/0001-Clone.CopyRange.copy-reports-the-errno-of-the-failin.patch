From 27a87184787e45f329b0adaeba7e6f22a5031aa2 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Mon, 9 Nov 2026 11:35:58 +0000
Subject: [PATCH 1/4] Clone.CopyRange.copy reports the errno of the failing
 copy_file_range instead of rereading errno after the call, and
 Capability.probe reports reflink only for Btrfs and XFS through
 File.System.Kind (swift-linux-foundation/swift-linux-standard#18)

---
 .../Linux.Kernel.Copy.Range.swift             |  12 +-
 .../Linux.Kernel.File.Clone.swift             |  41 ++++---
 .../Linux.Kernel.File.Clone Tests.swift       | 110 ++++++++++++++++++
 3 files changed, 142 insertions(+), 21 deletions(-)
 create mode 100644 Tests/Linux Kernel Standard Tests/Linux.Kernel.File.Clone Tests.swift

diff --git a/Sources/Linux Kernel File Standard/Linux.Kernel.Copy.Range.swift b/Sources/Linux Kernel File Standard/Linux.Kernel.Copy.Range.swift
index 06a7d95..06b775a 100644
--- a/Sources/Linux Kernel File Standard/Linux.Kernel.Copy.Range.swift	
+++ b/Sources/Linux Kernel File Standard/Linux.Kernel.Copy.Range.swift	
@@ -19,13 +19,14 @@
 
     extension Linux.Kernel.Copy.Range {
 
-        internal static func copy(
+        internal static func copy<Failure: Swift.Error>(
             fromFd sourceFd: Int32,
             sourceOffset: inout ISO_9945.Kernel.File.Offset,
             toFd destinationFd: Int32,
             destOffset: inout ISO_9945.Kernel.File.Offset,
-            length: ISO_9945.Kernel.File.Size
-        ) throws(Linux.Kernel.Copy.Error) -> ISO_9945.Kernel.File.Size {
+            length: ISO_9945.Kernel.File.Size,
+            failure: (Int32) -> Failure
+        ) throws(Failure) -> ISO_9945.Kernel.File.Size {
             var srcOff = off_t(sourceOffset.underlying)
             var dstOff = off_t(destOffset.underlying)
 
@@ -41,7 +42,7 @@
             )
 
             guard result >= 0 else {
-                throw Linux.Kernel.Copy.Error(posixErrno: errno)
+                throw failure(errno)
             }
 
             sourceOffset = ISO_9945.Kernel.File.Offset(Int64(srcOff))
@@ -61,7 +62,8 @@
                 sourceOffset: &sourceOffset,
                 toFd: destination._rawValue,
                 destOffset: &destOffset,
-                length: length
+                length: length,
+                failure: Linux.Kernel.Copy.Error.init(posixErrno:)
             )
         }
     }
diff --git a/Sources/Linux Kernel File Standard/Linux.Kernel.File.Clone.swift b/Sources/Linux Kernel File Standard/Linux.Kernel.File.Clone.swift
index 446fb2c..fe521fd 100644
--- a/Sources/Linux Kernel File Standard/Linux.Kernel.File.Clone.swift	
+++ b/Sources/Linux Kernel File Standard/Linux.Kernel.File.Clone.swift	
@@ -18,6 +18,18 @@ extension Linux.Kernel.File {
