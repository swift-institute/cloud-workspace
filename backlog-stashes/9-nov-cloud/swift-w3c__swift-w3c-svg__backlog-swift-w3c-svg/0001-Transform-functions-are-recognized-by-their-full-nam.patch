+            [UInt8]("rotate".utf8), [UInt8]("skewx".utf8), [UInt8]("skewy".utf8),
+        ]
+        guard known.contains(name) else { throw .expectedFunction }
 
         Self._skipWS(&input)
 
@@ -72,12 +73,12 @@ extension W3C_SVG2.Types.Transform.Parse: Parsing {
 
         let result: Function
 
-        switch firstByte {
-        case 0x74:
+        switch name {
