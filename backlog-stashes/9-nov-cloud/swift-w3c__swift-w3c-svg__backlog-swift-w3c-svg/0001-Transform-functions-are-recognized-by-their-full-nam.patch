                 cy: args.count > 2 ? args[2] : 0
             )
 
-        case 0x73:
-            if nameLen == 5 {
+        case [UInt8]("scale".utf8):
+            let args = try Self._parseArgs(&input, min: 1, max: 2)
+            result = .scale(sx: args[0], sy: args.count > 1 ? args[1] : args[0])
 
