+
+extension Test.Reporter {
+    /// The document the JSON reporter writes: `{"events": [...]}`, one object per event.
+    static func jsonDocument(for events: [Test.Event]) -> JSON {
+        .object([("events", .array(events.map { jsonRecord(for: $0) }))])
+    }
+
+    static func jsonRecord(for event: Test.Event) -> JSON {
+        var fields: [(Swift.String, JSON)] = [("kind", .string(event.kind.underlying))]
+
+        if let id = event.id {
+            fields.append(("test_id", .string(id.fullyQualifiedName)))
+        }
+
+        if let result = event.result {
+            fields.append(("result", .string("\(result)")))
+        }
+
+        if let duration = event.elapsed {
+            let components = duration.components
+            let nanoseconds =
+                Swift.Int(components.seconds) * 1_000_000_000
+                + Swift.Int(components.attoseconds / 1_000_000_000)
+            fields.append(("elapsed_ns", .number(nanoseconds)))
+        }
+
+        return .object(fields)
+    }
+}
diff --git a/Tests/Tests Tests/Test.Reporter.JSON Tests.swift b/Tests/Tests Tests/Test.Reporter.JSON Tests.swift
new file mode 100644
index 0000000..82d41f5
--- /dev/null
+++ b/Tests/Tests Tests/Test.Reporter.JSON Tests.swift	
@@ -0,0 +1,41 @@
+import JSON
+import Testing
+import Tests_Test_Support
+
+@testable import Tests_Reporter
+
+enum `Test.Reporter.JSON Tests` {}
+
+extension `Test.Reporter.JSON Tests` {
+    @Suite
+    struct Test {
+        @Suite struct Unit {}
+    }
+}
+
+// MARK: - Unit
+
+extension `Test.Reporter.JSON Tests`.Test.Unit {
+
+    @Test
+    func `a test name with quotes and a backslash serializes to valid JSON`() throws {
+        let event = Test::Test.Event(
+            id: .stub(#"says "hi" \ bye"#),
+            kind: .testEnded,
+            result: .passed
+        )
+        let document = Tests_Core.Test.Reporter.jsonDocument(for: [event])
+        let text = document.serialize(pretty: true)
+
+        #expect(try JSON.parse(text) == document)
+        #expect(text.contains(#"says \"hi\" \\ bye"#))
+    }
+
+    @Test
+    func `elapsed nanoseconds include whole seconds`() {
+        let event = Test::Test.Event(kind: .runEnded, elapsed: .milliseconds(2500))
+        let record = Tests_Core.Test.Reporter.jsonRecord(for: event)
+
+        #expect(record.serialize().contains(#""elapsed_ns":2500000000"#))
+    }
+}
