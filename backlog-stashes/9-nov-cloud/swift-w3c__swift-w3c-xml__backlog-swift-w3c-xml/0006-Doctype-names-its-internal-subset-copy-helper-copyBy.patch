From 36a16f9f60ddfffcaf103d9ab12c54518773ddd6 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Mon, 9 Nov 2026 11:40:11 +0000
Subject: [PATCH 6/6] Doctype names its internal-subset copy helper copyBytes
 so it cannot be read as the copy operator (swift-w3c/swift-w3c-xml#7)

---
 Sources/W3C XML/W3C_XML.Parse.Document.swift | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/Sources/W3C XML/W3C_XML.Parse.Document.swift b/Sources/W3C XML/W3C_XML.Parse.Document.swift
index 10d35c6..e50b2ac 100644
--- a/Sources/W3C XML/W3C_XML.Parse.Document.swift	
+++ b/Sources/W3C XML/W3C_XML.Parse.Document.swift	
@@ -163,13 +163,13 @@ extension W3C_XML.Parse {
                     }
                     if byte == ASCII.Code.quotationMark.byte || byte == ASCII.Code.apostrophe.byte {
                         bytes.append(try input.xmlTake(expected: "character"))
-                        try copy(&input, through: [byte], into: &bytes)
+                        try copyBytes(&input, through: [byte], into: &bytes)
                     } else if matchLiteral(&input, "<!--") {
                         bytes.append(contentsOf: [Byte](utf8: "<!--"))
-                        try copy(&input, through: [Byte](utf8: "-->"), into: &bytes)
+                        try copyBytes(&input, through: [Byte](utf8: "-->"), into: &bytes)
                     } else if matchLiteral(&input, "<?") {
                         bytes.append(contentsOf: [Byte](utf8: "<?"))
-                        try copy(&input, through: [Byte](utf8: "?>"), into: &bytes)
+                        try copyBytes(&input, through: [Byte](utf8: "?>"), into: &bytes)
                     } else {
                         bytes.append(try input.xmlTake(expected: "character"))
                     }
@@ -193,7 +193,7 @@ extension W3C_XML.Parse {
         }
 
         @inlinable
-        package func copy(
+        package func copyBytes(
             _ input: inout Input,
             through terminator: [Byte],
             into bytes: inout [Byte]
-- 
