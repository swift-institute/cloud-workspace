diff --git a/Tests/W3C XML Tests/W3C_XML.Entity Tests.swift b/Tests/W3C XML Tests/W3C_XML.Entity Tests.swift
new file mode 100644
index 0000000..d4188cf
--- /dev/null
+++ b/Tests/W3C XML Tests/W3C_XML.Entity Tests.swift	
@@ -0,0 +1,138 @@
+import Testing
+
+@testable import W3C_XML
+
+enum `W3C_XML.Entity Tests` {}
+
+extension `W3C_XML.Entity Tests` {
+    @Suite
+    struct `Internal entity declarations` {
+        @Test
