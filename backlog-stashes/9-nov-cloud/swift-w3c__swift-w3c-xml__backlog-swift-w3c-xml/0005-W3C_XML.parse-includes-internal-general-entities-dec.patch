diff --git a/Sources/W3C XML/W3C_XML.Entity.Declarations.swift b/Sources/W3C XML/W3C_XML.Entity.Declarations.swift
new file mode 100644
index 0000000..5f096fe
--- /dev/null
+++ b/Sources/W3C XML/W3C_XML.Entity.Declarations.swift	
@@ -0,0 +1,226 @@
+extension W3C_XML.Entity {
+
+    /// The general entities declared in an internal DTD subset (XML 1.0 §4.2).
+    ///
+    /// Internal entities map to their replacement text: character references in the
+    /// literal are expanded and general entity references are kept for expansion on use.
+    /// External and unparsed entities are recorded by name only; they are never resolved.
+    /// Parameter entities are not read, so, as XML 1.0 §5.1 requires of a processor that
+    /// does not read them, declarations after the first parameter-entity reference are skipped.
+    struct Declarations: Sendable {
+
+        var replacements: [String: [UInt8]] = [:]
+
+        var external: Swift::Set<String> = []
+
+        var isEmpty: Bool { replacements.isEmpty && external.isEmpty }
+
+        init(subset: String) throws(W3C_XML.Parse.Error) {
+            let bytes = Swift::Array(subset.utf8)
+            var index = 0
+
+            while index < bytes.count {
+                let byte = bytes[index]
+                if Self.isSpace(byte) {
+                    index += 1
+                } else if Self.starts(bytes, at: index, with: "<!--") {
+                    index = try Self.end(of: "-->", in: bytes, from: index + 4)
+                } else if Self.starts(bytes, at: index, with: "<?") {
+                    index = try Self.end(of: "?>", in: bytes, from: index + 2)
+                } else if byte == UInt8(ascii: "%") {
+                    return
+                } else if Self.starts(bytes, at: index, with: "<!ENTITY") {
+                    index = try declareEntity(bytes, from: index + 8)
+                } else if Self.starts(bytes, at: index, with: "<!") {
+                    index = try Self.skipDeclaration(bytes, from: index + 2)
+                } else {
+                    throw .expected("markup declaration in the internal subset")
+                }
+            }
+        }
+    }
+}
+
+extension W3C_XML.Entity.Declarations {
+
+    mutating func declareEntity(_ bytes: [UInt8], from start: Int) throws(W3C_XML.Parse.Error) -> Int {
+        var index = try Self.requiredSpace(bytes, from: start)
+
+        var isParameter = false
+        if index < bytes.count, bytes[index] == UInt8(ascii: "%") {
+            isParameter = true
+            index = try Self.requiredSpace(bytes, from: index + 1)
+        }
+
+        let (name, afterName) = try Self.name(bytes, from: index)
+        index = try Self.requiredSpace(bytes, from: afterName)
+
+        var replacement: [UInt8]? = nil
+        if index < bytes.count, bytes[index] == UInt8(ascii: "\"") || bytes[index] == UInt8(ascii: "'") {
+            let (literal, afterLiteral) = try Self.literal(bytes, from: index)
+            index = afterLiteral
+            if !isParameter {
+                replacement = try Self.replacementText(literal)
+            }
+        } else if Self.starts(bytes, at: index, with: "SYSTEM") {
+            index = try Self.requiredSpace(bytes, from: index + 6)
+            index = try Self.literal(bytes, from: index).end
+        } else if Self.starts(bytes, at: index, with: "PUBLIC") {
+            index = try Self.requiredSpace(bytes, from: index + 6)
+            index = try Self.literal(bytes, from: index).end
+            index = try Self.requiredSpace(bytes, from: index)
+            index = try Self.literal(bytes, from: index).end
+        } else {
+            throw .expected("entity value or external ID")
+        }
+
+        if replacement == nil, !isParameter {
+            let afterSpace = Self.skipSpace(bytes, from: index)
+            if afterSpace > index, Self.starts(bytes, at: afterSpace, with: "NDATA") {
+                index = try Self.requiredSpace(bytes, from: afterSpace + 5)
+                index = try Self.name(bytes, from: index).end
+            }
+        }
+
+        index = Self.skipSpace(bytes, from: index)
+        guard index < bytes.count, bytes[index] == UInt8(ascii: ">") else {
+            throw .expected("> after entity declaration")
+        }
+
+        let isDeclared = replacements[name] != nil || external.contains(name)
+        if !isParameter, !isDeclared, W3C_XML.Entity.predefined(name) == nil {
+            if let replacement {
+                replacements[name] = replacement
+            } else {
+                external.insert(name)
+            }
+        }
+
+        return index + 1
+    }
+
+    static func replacementText(_ literal: ArraySlice<UInt8>) throws(W3C_XML.Parse.Error) -> [UInt8] {
+        var result: [UInt8] = []
+        var index = literal.startIndex
+
+        while index < literal.endIndex {
+            let byte = literal[index]
+            if byte == UInt8(ascii: "%") {
+                throw .expected("no parameter-entity reference inside an internal-subset declaration")
+            }
+            guard byte == UInt8(ascii: "&") else {
+                result.append(byte)
+                index += 1
+                continue
+            }
+            guard let semicolon = literal[index...].firstIndex(of: UInt8(ascii: ";")) else {
+                throw .expected(";")
+            }
+            let body = literal[(index + 1)..<semicolon]
+            if body.first == UInt8(ascii: "#") {
+                let reference = String(decoding: body.dropFirst(), as: UTF8.self)
+                guard let scalar = W3C_XML.Entity.numeric(reference) else {
+                    throw .invalidCharacterReference("&#\(reference);")
+                }
+                result.append(contentsOf: Swift::Array(String(scalar).utf8))
+            } else {
+                guard try name(Swift::Array(body), from: 0).end == body.count else {
+                    throw .invalidName
+                }
+                result.append(contentsOf: literal[index...semicolon])
+            }
+            index = semicolon + 1
+        }
+
+        return result
+    }
+}
+
+extension W3C_XML.Entity.Declarations {
+
+    static func isSpace(_ byte: UInt8) -> Bool {
+        byte == 0x20 || byte == 0x09 || byte == 0x0A || byte == 0x0D
+    }
+
+    static func starts(_ bytes: [UInt8], at index: Int, with literal: String) -> Bool {
+        let prefix = Swift::Array(literal.utf8)
+        guard index + prefix.count <= bytes.count else { return false }
+        return bytes[index..<(index + prefix.count)].elementsEqual(prefix)
+    }
+
+    static func end(of terminator: String, in bytes: [UInt8], from start: Int) throws(W3C_XML.Parse.Error) -> Int {
+        let pattern = Swift::Array(terminator.utf8)
+        var index = start
+        while index + pattern.count <= bytes.count {
+            if bytes[index..<(index + pattern.count)].elementsEqual(pattern) {
+                return index + pattern.count
+            }
+            index += 1
+        }
+        throw .unexpectedEndOfInput(expected: terminator)
+    }
+
+    static func skipSpace(_ bytes: [UInt8], from start: Int) -> Int {
+        var index = start
+        while index < bytes.count, isSpace(bytes[index]) {
+            index += 1
+        }
+        return index
+    }
+
+    static func requiredSpace(_ bytes: [UInt8], from start: Int) throws(W3C_XML.Parse.Error) -> Int {
+        let index = skipSpace(bytes, from: start)
+        guard index > start else { throw .expected("whitespace") }
+        return index
+    }
+
+    static func name(_ bytes: [UInt8], from start: Int) throws(W3C_XML.Parse.Error) -> (name: String, end: Int) {
+        var index = start
+        while index < bytes.count {
+            let byte = bytes[index]
+            if isSpace(byte) || byte == UInt8(ascii: ">") || byte == UInt8(ascii: "\"")
+                || byte == UInt8(ascii: "'") || byte == UInt8(ascii: ";")
+            {
+                break
+            }
+            index += 1
+        }
+        let name = String(decoding: bytes[start..<index], as: UTF8.self)
+        guard let first = name.unicodeScalars.first, W3C_XML.isNameStartChar(first),
+            name.unicodeScalars.allSatisfy(W3C_XML.isNameChar)
+        else {
+            throw .invalidName
+        }
+        return (name, index)
+    }
+
+    static func literal(
+        _ bytes: [UInt8],
+        from start: Int
+    ) throws(W3C_XML.Parse.Error) -> (value: ArraySlice<UInt8>, end: Int) {
+        guard start < bytes.count, bytes[start] == UInt8(ascii: "\"") || bytes[start] == UInt8(ascii: "'") else {
+            throw .expected("\" or '")
+        }
+        let quote = bytes[start]
+        guard let close = bytes[(start + 1)...].firstIndex(of: quote) else {
+            throw .unexpectedEndOfInput(expected: String(UnicodeScalar(quote)))
+        }
+        return (bytes[(start + 1)..<close], close + 1)
+    }
+
+    static func skipDeclaration(_ bytes: [UInt8], from start: Int) throws(W3C_XML.Parse.Error) -> Int {
+        var index = start
+        while index < bytes.count {
+            let byte = bytes[index]
+            if byte == UInt8(ascii: ">") {
+                return index + 1
+            }
+            if byte == UInt8(ascii: "\"") || byte == UInt8(ascii: "'") {
+                index = try literal(bytes, from: index).end
+            } else {
+                index += 1
+            }
+        }
+        throw .unexpectedEndOfInput(expected: ">")
+    }
+}
diff --git a/Sources/W3C XML/W3C_XML.Entity.Expansion.swift b/Sources/W3C XML/W3C_XML.Entity.Expansion.swift
new file mode 100644
index 0000000..cf2a92f
--- /dev/null
+++ b/Sources/W3C XML/W3C_XML.Entity.Expansion.swift	
@@ -0,0 +1,239 @@
+import Byte
+import Cursor
+import Machine
+import Parser
+import Parser_Machine
+
+extension W3C_XML.Entity {
+
+    /// Includes the replacement text of internal general entities where the document
+    /// references them (XML 1.0 §4.4): in content as markup, in attribute values as data.
+    ///
+    /// References inside comments, CDATA sections and processing instructions are left alone,
+    /// as are character references, predefined entities and undeclared names. A reference to
+    /// an external or unparsed entity throws ``W3C_XML/Parse/Error/externalEntity(_:)``,
+    /// since external entities are never resolved. Recursion, nesting depth and the total
+    /// expanded size are bounded by ``Limits``.
+    struct Expansion {
+
+        let declarations: Declarations
+
+        let limits: Limits
+
+        let maxDepth: Int
+
+        var expandedBytes = 0
+
+        var validated: Swift::Set<String> = []
+
+        init(declarations: Declarations, limits: Limits, maxDepth: Int) {
+            self.declarations = declarations
+            self.limits = limits
+            self.maxDepth = maxDepth
+        }
+    }
+}
+
+extension W3C_XML.Entity.Expansion {
+
+    mutating func markup(_ source: [UInt8]) throws(W3C_XML.Parse.Error) -> [UInt8] {
+        var output: [UInt8] = []
+        output.reserveCapacity(source.count)
+        try markup(source, into: &output, open: [])
+        return output
+    }
+
+    mutating func markup(
+        _ source: [UInt8],
+        into output: inout [UInt8],
+        open: [String]
+    ) throws(W3C_XML.Parse.Error) {
+        var index = 0
+
+        while index < source.count {
+            let byte = source[index]
+
+            if byte == UInt8(ascii: "<") {
+                if let end = Self.end(of: "<!--", "-->", in: source, at: index)
+                    ?? Self.end(of: "<![CDATA[", "]]>", in: source, at: index)
+                    ?? Self.end(of: "<?", "?>", in: source, at: index)
+                {
+                    output.append(contentsOf: source[index..<end])
+                    index = end
+                } else {
+                    index = try tag(source, from: index, into: &output, open: open)
+                }
+            } else if byte == UInt8(ascii: "&"), let reference = Self.reference(in: source, at: index),
+                declarations.replacements[reference.name] != nil || declarations.external.contains(reference.name)
+            {
+                try include(reference.name, inAttribute: false, into: &output, open: open)
+                index = reference.end
+            } else {
+                output.append(byte)
+                index += 1
+            }
+        }
+    }
+
+    mutating func tag(
+        _ source: [UInt8],
+        from start: Int,
+        into output: inout [UInt8],
+        open: [String]
+    ) throws(W3C_XML.Parse.Error) -> Int {
+        output.append(source[start])
+        var index = start + 1
+
+        while index < source.count, source[index] != UInt8(ascii: ">") {
+            let byte = source[index]
+            output.append(byte)
+            index += 1
+            guard byte == UInt8(ascii: "\"") || byte == UInt8(ascii: "'") else { continue }
+
+            while index < source.count, source[index] != byte {
+                if source[index] == UInt8(ascii: "&"), let reference = Self.reference(in: source, at: index),
+                    declarations.replacements[reference.name] != nil
+                        || declarations.external.contains(reference.name)
+                {
+                    try include(reference.name, inAttribute: true, into: &output, open: open)
+                    index = reference.end
+                } else {
+                    output.append(source[index])
+                    index += 1
+                }
+            }
+            if index < source.count {
+                output.append(byte)
+                index += 1
+            }
+        }
+
+        if index < source.count {
+            output.append(source[index])
+            index += 1
+        }
+        return index
+    }
+
+    mutating func attributeText(
+        _ source: [UInt8],
+        into output: inout [UInt8],
+        open: [String]
+    ) throws(W3C_XML.Parse.Error) {
+        var index = 0
+
+        while index < source.count {
+            let byte = source[index]
+            if byte == UInt8(ascii: "&"), let reference = Self.reference(in: source, at: index),
+                declarations.replacements[reference.name] != nil || declarations.external.contains(reference.name)
+            {
+                try include(reference.name, inAttribute: true, into: &output, open: open)
+                index = reference.end
+            } else if byte == UInt8(ascii: "\"") {
+                output.append(contentsOf: Swift::Array("&#34;".utf8))
+                index += 1
+            } else if byte == UInt8(ascii: "'") {
+                output.append(contentsOf: Swift::Array("&#39;".utf8))
+                index += 1
+            } else {
+                output.append(byte)
+                index += 1
+            }
+        }
+    }
+
+    mutating func include(
+        _ name: String,
+        inAttribute: Bool,
+        into output: inout [UInt8],
+        open: [String]
+    ) throws(W3C_XML.Parse.Error) {
+        guard let text = declarations.replacements[name] else {
+            throw .externalEntity(name)
+        }
+        guard !open.contains(name) else {
+            throw .recursiveEntity(name)
+        }
+        guard open.count < limits.depth else {
+            throw .entityDepthExceeded(limit: limits.depth)
+        }
+
+        var replacement: [UInt8] = []
+        if inAttribute {
+            try attributeText(text, into: &replacement, open: open + [name])
+        } else {
+            try markup(text, into: &replacement, open: open + [name])
+        }
+
+        expandedBytes += replacement.count
+        guard expandedBytes <= limits.expandedBytes else {
+            throw .entityExpansionExceeded(limit: limits.expandedBytes)
+        }
+
+        if !inAttribute {
+            try validate(name, replacement)
+        }
+        output.append(contentsOf: replacement)
+    }
+
+    /// Checks that a replacement text included in content is well-formed content on its own
+    /// (XML 1.0 §4.3.2), so an entity cannot open a tag that the document closes.
+    mutating func validate(_ name: String, _ replacement: [UInt8]) throws(W3C_XML.Parse.Error) {
+        guard !validated.contains(name) else { return }
+
+        var wrapped = [Byte](utf8: "<x>")
+        wrapped.append(contentsOf: replacement.map(Byte.init(bitPattern:)))
+        wrapped.append(contentsOf: [Byte](utf8: "</x>"))
+        var input = wrapped[...]
+
+        let parser =
+            W3C_XML.Parse.machineElement(maxDepth: maxDepth)
+            as Machine::Machine.Parser.Parser<ArraySlice<Byte>, W3C_XML.Element, W3C_XML.Parse.Error>
+        _ = try parser.parse(&input)
+        guard input.xmlPeek() == nil else {
+            throw .expected("well-formed replacement text for entity \(name)")
+        }
+
+        validated.insert(name)
+    }
+}
+
+extension W3C_XML.Entity.Expansion {
+
+    static func end(of opener: String, _ terminator: String, in source: [UInt8], at index: Int) -> Int? {
+        let open = Swift::Array(opener.utf8)
+        guard index + open.count <= source.count,
+            source[index..<(index + open.count)].elementsEqual(open)
+        else {
+            return nil
+        }
+        let close = Swift::Array(terminator.utf8)
+        var cursor = index + open.count
+        while cursor + close.count <= source.count {
+            if source[cursor..<(cursor + close.count)].elementsEqual(close) {
+                return cursor + close.count
+            }
+            cursor += 1
+        }
+        return source.count
+    }
+
+    static func reference(in source: [UInt8], at index: Int) -> (name: String, end: Int)? {
+        var cursor = index + 1
+        guard cursor < source.count, source[cursor] != UInt8(ascii: "#") else { return nil }
+        while cursor < source.count {
+            let byte = source[cursor]
+            if byte == UInt8(ascii: ";") {
+                guard cursor > index + 1 else { return nil }
+                return (String(decoding: source[(index + 1)..<cursor], as: UTF8.self), cursor + 1)
+            }
+            if W3C_XML.Entity.Declarations.isSpace(byte) || byte == UInt8(ascii: "<") || byte == UInt8(ascii: "&")
+                || byte == UInt8(ascii: "\"") || byte == UInt8(ascii: "'") || byte == UInt8(ascii: ">")
+            {
+                return nil
+            }
+            cursor += 1
+        }
+        return nil
+    }
+}
diff --git a/Sources/W3C XML/W3C_XML.Entity.Limits.swift b/Sources/W3C XML/W3C_XML.Entity.Limits.swift
new file mode 100644
index 0000000..346b6c7
--- /dev/null
+++ b/Sources/W3C XML/W3C_XML.Entity.Limits.swift	
@@ -0,0 +1,18 @@
+extension W3C_XML.Entity {
+
+    /// Bounds on expanding general entities declared in a document's internal DTD subset.
+    public struct Limits: Sendable, Hashable {
+
+        /// The deepest nesting of entity references inside replacement text.
+        public var depth: Int
+
+        /// The most bytes all entity expansions in one document may produce together.
+        public var expandedBytes: Int
+
+        @inlinable
+        public init(depth: Int = 16, expandedBytes: Int = 1 << 22) {
+            self.depth = depth
+            self.expandedBytes = expandedBytes
+        }
+    }
+}
