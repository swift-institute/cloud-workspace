From 033aeac5f8456773fe02b52f45e2dc08d72c3be9 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Mon, 9 Nov 2026 11:37:06 +0000
Subject: [PATCH 3/6] Text content no longer traps after a million iterations:
 every iteration consumes input, so a long run of references parses
 (swift-w3c/swift-w3c-xml#7)

---
 Sources/W3C XML/W3C_XML.Parse.MachineElement.swift | 8 --------
 1 file changed, 8 deletions(-)

diff --git a/Sources/W3C XML/W3C_XML.Parse.MachineElement.swift b/Sources/W3C XML/W3C_XML.Parse.MachineElement.swift
index 73219d6..04099b9 100644
--- a/Sources/W3C XML/W3C_XML.Parse.MachineElement.swift	
+++ b/Sources/W3C XML/W3C_XML.Parse.MachineElement.swift	
@@ -317,16 +317,8 @@ extension W3C_XML.Parse {
         @usableFromInline
         func parse(_ input: inout Input) throws(Failure) -> String {
             var result: [Byte] = []
-            var iterationCount = 0
-            let maxIterations = 1_000_000
 
             while let byte = input.xmlPeek() {
-                iterationCount += 1
-                precondition(
-                    iterationCount < maxIterations,
-                    "NonEmptyTextContent: runaway loop detected"
-                )
-
                 if byte == ASCII.Code.lessThanSign.byte {
 
                     break
-- 
