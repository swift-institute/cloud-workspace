From 24a0fc61ab1ae41f50ac91a45196de06b860c262 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Mon, 9 Nov 2026 11:28:53 +0000
Subject: [PATCH] Xcode.Scheme.write(_:to:) is pinned by a test to reject a
 scheme name containing a slash with .path before creating anything
 (swift-compositions/swift-xcode#4)

---
 .../Xcode Scheme Tests/Xcode.Scheme Tests.swift  | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/Tests/Xcode Scheme Tests/Xcode.Scheme Tests.swift b/Tests/Xcode Scheme Tests/Xcode.Scheme Tests.swift
index 8662484..f6e788d 100644
--- a/Tests/Xcode Scheme Tests/Xcode.Scheme Tests.swift	
+++ b/Tests/Xcode Scheme Tests/Xcode.Scheme Tests.swift	
@@ -38,3 +38,19 @@ func `no launch action is emitted, because xcodebuild segfaults on the stub`() {
     #expect(xml.contains("ArchiveAction"))
     #expect(xml.contains(#"parallelizable="NO""#))
 }
+
+@Test
+func `a scheme name containing a slash is rejected before anything is written`() {
+    let reference = Xcode.Scheme.Reference(
+        blueprint: "Workspace-Package",
+        name: "Workspace-Package",
+        container: "container:Application"
+    )
+    let scheme = Xcode.Scheme(build: [.init(reference: reference)], test: [])
+    #expect(throws: Xcode.Scheme.Error.path) {
+        try scheme.write("../../escaped", to: "/nonexistent/Application.xcworkspace")
+    }
+    #expect(throws: Xcode.Scheme.Error.path) {
+        try scheme.write("nested/scheme", to: "/nonexistent/Application.xcworkspace")
+    }
+}
