From 59fef6b91ddee69a5160684db67e531f4ad31db0 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Mon, 9 Nov 2026 11:28:32 +0000
Subject: [PATCH 2/3] W3C_EPUB.FixedLayouts.Viewport stores whole-pixel Int
 sizes, so a non-finite size cannot be built and metaContent no longer
 truncates (swift-w3c/swift-w3c-epub#8)

---
 .../W3C_EPUB.FixedLayouts.Viewport.swift            | 11 +++++------
 .../W3C EPUB Tests/Viewport Finite Size Tests.swift | 13 +++++++------
 2 files changed, 12 insertions(+), 12 deletions(-)

diff --git a/Sources/W3C EPUB Fixed Layouts/W3C_EPUB.FixedLayouts.Viewport.swift b/Sources/W3C EPUB Fixed Layouts/W3C_EPUB.FixedLayouts.Viewport.swift
index 4744fac..1302518 100644
--- a/Sources/W3C EPUB Fixed Layouts/W3C_EPUB.FixedLayouts.Viewport.swift	
+++ b/Sources/W3C EPUB Fixed Layouts/W3C_EPUB.FixedLayouts.Viewport.swift	
@@ -2,14 +2,14 @@ public import W3C_EPUB_Shared
 
 extension W3C_EPUB.FixedLayouts {
 
+    /// A fixed-layout viewport size in whole CSS pixels, as written in the `viewport` meta tag.
     public struct Viewport: Sendable, Hashable {
 
-        public var width: Double
+        public var width: Int
 
-        public var height: Double
+        public var height: Int
 
-        public init(width: Double, height: Double) {
-            precondition(width.isFinite && height.isFinite, "EPUB viewport size must be finite: \(width) × \(height)")
+        public init(width: Int, height: Int) {
             self.width = width
             self.height = height
         }
@@ -24,7 +24,6 @@ extension W3C_EPUB.FixedLayouts.Viewport {
     public static let iphone = W3C_EPUB.FixedLayouts.Viewport(width: 375, height: 667)
 
     public var metaContent: String {
-        precondition(width.isFinite && height.isFinite, "EPUB viewport size must be finite: \(width) × \(height)")
-        return "width=\(Int(width)), height=\(Int(height))"
+        "width=\(width), height=\(height)"
     }
 }
diff --git a/Tests/W3C EPUB Tests/Viewport Finite Size Tests.swift b/Tests/W3C EPUB Tests/Viewport Finite Size Tests.swift
index 6d90d14..7ce84f5 100644
--- a/Tests/W3C EPUB Tests/Viewport Finite Size Tests.swift	
+++ b/Tests/W3C EPUB Tests/Viewport Finite Size Tests.swift	
@@ -9,15 +9,16 @@ extension `Viewport Finite Size Tests` {
     @Suite
     struct `Viewport finite size` {
         @Test
-        func `a viewport with a non-finite size is refused when it is created`() async {
-            await #expect(processExitsWith: .failure) {
-                _ = W3C_EPUB.FixedLayouts.Viewport(width: .nan, height: 600)
-            }
+        func `a viewport writes its whole-pixel size as meta content`() {
+            #expect(W3C_EPUB.FixedLayouts.Viewport(width: 375, height: 667).metaContent == "width=375, height=667")
         }
 
         @Test
-        func `a finite viewport writes its meta content`() {
-            #expect(W3C_EPUB.FixedLayouts.Viewport(width: 375, height: 667).metaContent == "width=375, height=667")
+        func `a viewport keeps the size it was given`() {
+            let viewport = W3C_EPUB.FixedLayouts.Viewport(width: 2048, height: 1536)
+            #expect(viewport.width == 2048)
+            #expect(viewport.height == 1536)
+            #expect(viewport == .ipadRetina)
         }
     }
 }
