From 69f6e0a6309fd552545592f602ffa1342342d1ca Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Mon, 9 Nov 2026 11:28:23 +0000
Subject: [PATCH 1/3] W3C_EPUB.Version has a patch component, so v2_0_1 prints
 as 2.0.1 and sorts after 2.0 (swift-w3c/swift-w3c-epub#8)

---
 Sources/W3C EPUB Shared/W3C_EPUB.Version.swift | 13 ++++++-------
 Tests/W3C EPUB Tests/W3C_EPUB_ Tests.swift     |  9 +++++++++
 2 files changed, 15 insertions(+), 7 deletions(-)

diff --git a/Sources/W3C EPUB Shared/W3C_EPUB.Version.swift b/Sources/W3C EPUB Shared/W3C_EPUB.Version.swift
index ab1dd6e..14ee015 100644
--- a/Sources/W3C EPUB Shared/W3C_EPUB.Version.swift	
+++ b/Sources/W3C EPUB Shared/W3C_EPUB.Version.swift	
@@ -3,10 +3,12 @@ extension W3C_EPUB {
     public struct Version: Sendable, Hashable, Comparable {
         public let major: Int
         public let minor: Int
+        public let patch: Int
 
-        public init(major: Int, minor: Int) {
+        public init(major: Int, minor: Int, patch: Int = 0) {
             self.major = major
             self.minor = minor
+            self.patch = patch
         }
     }
 }
@@ -19,18 +21,15 @@ extension W3C_EPUB.Version {
 
     public static let v3_0 = W3C_EPUB.Version(major: 3, minor: 0)
 
-    public static let v2_0_1 = W3C_EPUB.Version(major: 2, minor: 0)
+    public static let v2_0_1 = W3C_EPUB.Version(major: 2, minor: 0, patch: 1)
 
     public static func < (lhs: W3C_EPUB.Version, rhs: W3C_EPUB.Version) -> Bool {
-        if lhs.major != rhs.major {
-            return lhs.major < rhs.major
-        }
-        return lhs.minor < rhs.minor
+        (lhs.major, lhs.minor, lhs.patch) < (rhs.major, rhs.minor, rhs.patch)
     }
 }
 
 extension W3C_EPUB.Version: CustomStringConvertible {
     public var description: String {
-        "\(major).\(minor)"
+        patch == 0 ? "\(major).\(minor)" : "\(major).\(minor).\(patch)"
     }
 }
diff --git a/Tests/W3C EPUB Tests/W3C_EPUB_ Tests.swift b/Tests/W3C EPUB Tests/W3C_EPUB_ Tests.swift
index 539142f..e088e1b 100644
--- a/Tests/W3C EPUB Tests/W3C_EPUB_ Tests.swift	
+++ b/Tests/W3C EPUB Tests/W3C_EPUB_ Tests.swift	
@@ -24,6 +24,15 @@ extension `W3C_EPUB_ Tests` {
             #expect(W3C_EPUB.Version.v3_2 < W3C_EPUB.Version.v3_3)
         }
 
+        @Test
+        func `Version 2.0.1 keeps its patch component`() {
+            #expect(W3C_EPUB.Version.v2_0_1.description == "2.0.1")
+            #expect(W3C_EPUB.Version.v3_3.description == "3.3")
+            #expect(W3C_EPUB.Version.v2_0_1 != W3C_EPUB.Version(major: 2, minor: 0))
+            #expect(W3C_EPUB.Version(major: 2, minor: 0) < W3C_EPUB.Version.v2_0_1)
+            #expect(W3C_EPUB.Version.v2_0_1 < W3C_EPUB.Version(major: 2, minor: 1))
+        }
+
         @Test
         func `Media types`() {
             #expect(W3C_EPUB.Media.Kind.epub.rawValue == "application/epub+zip")
-- 
