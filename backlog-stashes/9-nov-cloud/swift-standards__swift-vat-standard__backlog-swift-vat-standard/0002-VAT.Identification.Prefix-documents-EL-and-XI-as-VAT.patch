From 3459528332a4fcd38fb30643ed750ca8fbf363bc Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Mon, 9 Nov 2026 11:32:10 +0000
Subject: [PATCH 2/2] VAT.Identification.Prefix documents EL and XI as VAT
 prefixes that don't map onto ISO 3166 (swift-standards/swift-vat-standard#1)

---
 Sources/VAT Standard/VAT.Identification.Prefix.swift | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/Sources/VAT Standard/VAT.Identification.Prefix.swift b/Sources/VAT Standard/VAT.Identification.Prefix.swift
index ff55c42..ac525ea 100644
--- a/Sources/VAT Standard/VAT.Identification.Prefix.swift	
+++ b/Sources/VAT Standard/VAT.Identification.Prefix.swift	
@@ -1,4 +1,8 @@
 extension VAT.Identification {
+    /// The VAT prefix of a member state, or of Northern Ireland.
+    ///
+    /// These are VAT prefixes, not ISO 3166 alpha-2 codes: Greece is `EL` where ISO 3166 has `GR`,
+    /// and Northern Ireland is `XI`, which ISO 3166 doesn't assign. So the type doesn't map onto ISO 3166.
     public enum Prefix: String, Sendable, Hashable, CaseIterable {
         case at = "AT"
         case be = "BE"
-- 
