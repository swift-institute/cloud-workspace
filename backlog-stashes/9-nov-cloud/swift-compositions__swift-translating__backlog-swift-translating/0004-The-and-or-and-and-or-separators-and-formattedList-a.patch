From 77beefbc8858c4ac7816645a738140668a2421c0 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Mon, 9 Nov 2026 11:40:06 +0000
Subject: [PATCH 4/4] The and, or and and/or separators and formattedList are
 translated into Dutch, French, German and Spanish as well as English
 (swift-compositions/swift-translating#11)

---
 Sources/Translated String/[String].swift      | 24 ++++++++++++++++---
 .../Translating Dependencies/[String].swift   |  6 ++---
 .../TranslatedString Tests.swift              |  9 ++++++-
 3 files changed, 32 insertions(+), 7 deletions(-)

diff --git a/Sources/Translated String/[String].swift b/Sources/Translated String/[String].swift
index 67bf6f3..ba6b3a4 100644
--- a/Sources/Translated String/[String].swift	
+++ b/Sources/Translated String/[String].swift	
@@ -23,13 +23,31 @@ extension TranslatedString {
     public init(_ separator: [String].Separator) {
         switch separator {
         case .and:
-            self = [.english: "and"]
+            self = [
+                .dutch: "en",
+                .english: "and",
+                .french: "et",
+                .german: "und",
+                .spanish: "y",
+            ]
 
         case .or:
-            self = [.english: "or"]
+            self = [
+                .dutch: "of",
+                .english: "or",
+                .french: "ou",
+                .german: "oder",
+                .spanish: "o",
+            ]
 
         case .andOr:
-            self = [.english: "and/or"]
+            self = [
+                .dutch: "en/of",
+                .english: "and/or",
+                .french: "et/ou",
+                .german: "und/oder",
+                .spanish: "y/o",
+            ]
         }
     }
 }
diff --git a/Sources/Translating Dependencies/[String].swift b/Sources/Translating Dependencies/[String].swift
index b74f72e..dbff59f 100644
--- a/Sources/Translating Dependencies/[String].swift	
+++ b/Sources/Translating Dependencies/[String].swift	
@@ -41,13 +41,13 @@ extension [String] {
 extension [String] {
 
     public func formattedList(separator: ListSeparator = .and) -> Translated<Self> {
-        .mapping({ _ in
+        .mapping({ language in
             switch separator {
             case .and:
-                return self.formattedItems(with: "and")
+                return self.formattedItems(with: TranslatedString(.and)(language))
 
             case .or:
-                return self.formattedItems(with: "or")
+                return self.formattedItems(with: TranslatedString(.or)(language))
 
             case .individual:
                 return self.formattedItems(with: "")
diff --git a/Tests/Translated String Tests/TranslatedString Tests.swift b/Tests/Translated String Tests/TranslatedString Tests.swift
index 4f60404..bad1369 100644
--- a/Tests/Translated String Tests/TranslatedString Tests.swift	
+++ b/Tests/Translated String Tests/TranslatedString Tests.swift	
@@ -121,7 +121,10 @@ extension `TranslatedString Tests` {
             let separator = TranslatedString(.and)
 
             #expect(separator[.english] == "and")
-
+            #expect(separator[.dutch] == "en")
+            #expect(separator[.french] == "et")
+            #expect(separator[.german] == "und")
+            #expect(separator[.spanish] == "y")
         }
 
         @Test
@@ -129,6 +132,8 @@ extension `TranslatedString Tests` {
             let separator = TranslatedString(.or)
 
             #expect(separator[.english] == "or")
+            #expect(separator[.dutch] == "of")
+            #expect(separator[.german] == "oder")
         }
 
         @Test
@@ -136,6 +141,8 @@ extension `TranslatedString Tests` {
             let separator = TranslatedString(.andOr)
 
             #expect(separator[.english] == "and/or")
+            #expect(separator[.dutch] == "en/of")
+            #expect(separator[.german] == "und/oder")
         }
 
         @Test
-- 
