From 75d9d3b27a78ff1552ed53de09c392bea5474235 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Mon, 9 Nov 2026 11:40:06 +0000
Subject: [PATCH 2/4] TranslatedString.isEmpty checks the default and every
 stored translation, not only English and Dutch
 (swift-compositions/swift-translating#11)

---
 Sources/Translating/TranslatedString.swift    |  2 +-
 .../Translating Tests.swift                   | 28 +++++++++++++++++++
 2 files changed, 29 insertions(+), 1 deletion(-)

diff --git a/Sources/Translating/TranslatedString.swift b/Sources/Translating/TranslatedString.swift
index e8e3556..8b3d3df 100644
--- a/Sources/Translating/TranslatedString.swift
+++ b/Sources/Translating/TranslatedString.swift
@@ -24,7 +24,7 @@ extension TranslatedString {
     }
 
     public var isEmpty: Bool {
-        self.english.isEmpty && self.dutch.isEmpty
+        self.default.isEmpty && self.dictionary.values.allSatisfy(\.isEmpty)
     }
 
     public var capitalized: Self {
diff --git a/Tests/Translating Dependencies Tests/Translating Tests.swift b/Tests/Translating Dependencies Tests/Translating Tests.swift
index a64ec0c..158c8db 100644
--- a/Tests/Translating Dependencies Tests/Translating Tests.swift	
+++ b/Tests/Translating Dependencies Tests/Translating Tests.swift	
@@ -5,6 +5,7 @@ import Language
 import Testing
 import Translated
 import Translated_String
+import Translating
 
 @testable import Translating_Dependencies
 
@@ -247,3 +248,30 @@ extension `Translating Tests` {
         }
     }
 }
+
+extension `Translating Tests` {
+    @Suite
+    struct Emptiness {
+
+        @Test
+        func `A string with only a non-English, non-Dutch translation is not empty`() {
+            let german = TranslatedString(default: "", dictionary: [.german: "Hallo"])
+
+            #expect(!german.isEmpty)
+        }
+
+        @Test
+        func `A string whose default and every translation are empty is empty`() {
+            let blank = TranslatedString(default: "", dictionary: [.english: "", .french: ""])
+
+            #expect(blank.isEmpty)
+        }
+
+        @Test
+        func `A string with only a non-empty default is not empty`() {
+            let fallback = TranslatedString(default: "Hello", dictionary: [.english: "", .dutch: ""])
+
+            #expect(!fallback.isEmpty)
+        }
+    }
+}
