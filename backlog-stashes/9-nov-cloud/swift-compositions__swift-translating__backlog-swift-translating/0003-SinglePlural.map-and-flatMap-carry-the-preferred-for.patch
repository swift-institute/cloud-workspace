From 799ad8bda118e90a23727297a7cda809682de1d7 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Mon, 9 Nov 2026 11:40:06 +0000
Subject: [PATCH 3/4] SinglePlural.map and flatMap carry the preferred form
 through (swift-compositions/swift-translating#11)

---
 Sources/Single Plural/SinglePlural.swift      |  9 ++++--
 .../SinglePlural Tests.swift                  | 29 ++++++++++++++++++-
 2 files changed, 35 insertions(+), 3 deletions(-)

diff --git a/Sources/Single Plural/SinglePlural.swift b/Sources/Single Plural/SinglePlural.swift
index eb6147f..7954046 100644
--- a/Sources/Single Plural/SinglePlural.swift	
+++ b/Sources/Single Plural/SinglePlural.swift	
@@ -102,13 +102,18 @@ extension SinglePlural {
 extension SinglePlural {
 
     public func map<B>(_ transform: (A) -> B) -> SinglePlural<B> {
-        return SinglePlural<B>(single: transform(self.single), plural: transform(self.plural))
+        return SinglePlural<B>(
+            single: transform(self.single),
+            plural: transform(self.plural),
+            preferred: self.preferred
+        )
     }
 
     public func flatMap<B>(_ transform: (A) -> SinglePlural<B>) -> SinglePlural<B> {
         return SinglePlural<B>(
             single: transform(self.single).single,
-            plural: transform(self.plural).plural
+            plural: transform(self.plural).plural,
+            preferred: self.preferred
         )
     }
 }
diff --git a/Tests/Single Plural Tests/SinglePlural Tests.swift b/Tests/Single Plural Tests/SinglePlural Tests.swift
index fecc4ab..e2995b0 100644
--- a/Tests/Single Plural Tests/SinglePlural Tests.swift	
+++ b/Tests/Single Plural Tests/SinglePlural Tests.swift	
@@ -1 +1,28 @@
-import Foundation
+import Testing
+
+@testable import Single_Plural
+
+@Suite
+struct `SinglePlural Tests` {
+
+    @Test
+    func `Map keeps the preferred form`() {
+        let counts = SinglePlural(single: 1, plural: 2, preferred: .plural)
+
+        let mapped = counts.map { "\($0)" }
+
+        #expect(mapped.preferred == .plural)
+        #expect(mapped.preferredA == "2")
+    }
+
+    @Test
+    func `FlatMap keeps the preferred form`() {
+        let counts = SinglePlural(single: 1, plural: 2, preferred: .plural)
+
+        let mapped = counts.flatMap { SinglePlural("\($0)") }
+
+        #expect(mapped.preferred == .plural)
+        #expect(mapped.single == "1")
+        #expect(mapped.plural == "2")
+    }
+}
