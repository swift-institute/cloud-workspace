From 58c020d8d2c2a35d252e2777f884000908016963 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Mon, 9 Nov 2026 11:40:01 +0000
Subject: [PATCH 1/4] TranslatedString + resolves each side through the
 subscript, so the sum follows each side's fallbacks
 (swift-compositions/swift-translating#11)

---
 Sources/Translated/Translated.swift           |  6 ++----
 Tests/Translated Tests/Translated Tests.swift | 19 +++++++++++++++++++
 2 files changed, 21 insertions(+), 4 deletions(-)

diff --git a/Sources/Translated/Translated.swift b/Sources/Translated/Translated.swift
index 88f3c4b..5a83176 100644
--- a/Sources/Translated/Translated.swift
+++ b/Sources/Translated/Translated.swift
@@ -4,7 +4,7 @@ public struct Translated<A> {
 
     package var `default`: A
 
-    internal var dictionary: [Language: A]
+    package var dictionary: [Language: A]
 
     public init(
         `default`: A,
@@ -1879,9 +1879,7 @@ extension Translated<String> {
         let allKeys = Set(lhs.dictionary.keys).union(rhs.dictionary.keys)
 
         let newTranslations = Dictionary(
-            uniqueKeysWithValues: allKeys.map {
-                ($0, (lhs.dictionary[$0] ?? lhs.default) + (rhs.dictionary[$0] ?? rhs.default))
-            }
+            uniqueKeysWithValues: allKeys.map { ($0, lhs[$0] + rhs[$0]) }
         )
 
         return Self(
diff --git a/Tests/Translated Tests/Translated Tests.swift b/Tests/Translated Tests/Translated Tests.swift
index 6f4afbf..d9c7a74 100644
--- a/Tests/Translated Tests/Translated Tests.swift	
+++ b/Tests/Translated Tests/Translated Tests.swift	
@@ -351,3 +351,22 @@ extension `Translated Tests` {
 
     }
 }
+
+extension `Translated Tests` {
+    @Suite
+    struct Concatenation {
+
+        @Test
+        func `Each side of a sum resolves through its own fallbacks`() {
+            let lhs = Translated<String>(default: "Hello ", dictionary: [.dutch: "Hallo "])
+            let rhs = Translated<String>(default: "world", dictionary: [.afrikaans: "wêreld"])
+
+            let sum = lhs + rhs
+
+            #expect(sum[.afrikaans] == lhs[.afrikaans] + rhs[.afrikaans])
+            #expect(sum[.afrikaans] == "Hallo wêreld")
+            #expect(sum[.dutch] == "Hallo world")
+            #expect(sum[.english] == "Hello world")
+        }
+    }
+}
