From f99f14434a42a2b7878d7013ed7a7f03b19c2c25 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Mon, 9 Nov 2026 11:36:42 +0000
Subject: [PATCH 2/2] Date + DateComponents and Date - DateComponents return
 nil when the calendar yields no date instead of trapping
 (swift-compositions/swift-dependencies#12)

---
 .../Date.swift                                | 20 ++---
 .../Foundation Dependencies Tests.swift       | 76 +++++++++----------
 .../Foundation.Date Dependencies Tests.swift  | 19 +++++
 ... Tests (Foundation Extensions) Tests.swift | 52 ++++++-------
 .../Readme Verification Tests.swift           | 48 ++++++------
 5 files changed, 115 insertions(+), 100 deletions(-)

diff --git a/Sources/Dependencies Foundation Integration/Date.swift b/Sources/Dependencies Foundation Integration/Date.swift
index 3884b86..00748ef 100644
--- a/Sources/Dependencies Foundation Integration/Date.swift	
+++ b/Sources/Dependencies Foundation Integration/Date.swift	
@@ -18,20 +18,16 @@ extension Date {
     }
 }
 
-public func + (lhs: Date, rhs: DateComponents) -> Date {
-    @Dependency(\.calendar) var calendar
-    guard let result = lhs.adding(rhs, in: calendar) else {
-        preconditionFailure("Adding date components \(rhs) to \(lhs) produced no date")
-    }
-    return result
+/// `lhs` moved forward by `rhs` in the dependency calendar, or `nil` when the
+/// calendar yields no date.
+public func + (lhs: Date, rhs: DateComponents) -> Date? {
+    lhs.adding(rhs)
 }
 
-public func - (lhs: Date, rhs: DateComponents) -> Date {
-    @Dependency(\.calendar) var calendar
-    guard let result = lhs.subtracting(rhs, in: calendar) else {
-        preconditionFailure("Subtracting date components \(rhs) from \(lhs) produced no date")
-    }
-    return result
+/// `lhs` moved back by `rhs` in the dependency calendar, or `nil` when the
+/// calendar yields no date.
+public func - (lhs: Date, rhs: DateComponents) -> Date? {
+    lhs.subtracting(rhs)
 }
 
 extension Date {
