From 347881513ff95bba9234465fd19624b4e548a172 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Mon, 9 Nov 2026 11:28:19 +0000
Subject: [PATCH 1/2] Loader.Symbol.lookup(name:in:) on Windows throws
 Loader.Error.symbol instead of calling fatalError
 (swift-compositions/swift-loader#10)

---
 Sources/Loader/Loader.Symbol.swift           |  4 +++-
 Tests/Loader Tests/Loader.Symbol Tests.swift | 21 ++++++++++++++++++++
 2 files changed, 24 insertions(+), 1 deletion(-)
 create mode 100644 Tests/Loader Tests/Loader.Symbol Tests.swift

diff --git a/Sources/Loader/Loader.Symbol.swift b/Sources/Loader/Loader.Symbol.swift
index 4dce2ff..28a5ce3 100644
--- a/Sources/Loader/Loader.Symbol.swift
+++ b/Sources/Loader/Loader.Symbol.swift
@@ -8,7 +8,9 @@
             name: UnsafePointer<CChar>,
             in scope: Scope
         ) throws(Loader.Error) -> UnsafeRawPointer {
-            fatalError("Windows Loader.Symbol.lookup not yet implemented")
+            throw .symbol(
+                Loader.Message(ascii: "Loader.Symbol.lookup is not supported on Windows")
+            )
         }
     }
 #endif
diff --git a/Tests/Loader Tests/Loader.Symbol Tests.swift b/Tests/Loader Tests/Loader.Symbol Tests.swift
new file mode 100644
index 0000000..d05c2dd
--- /dev/null
+++ b/Tests/Loader Tests/Loader.Symbol Tests.swift	
@@ -0,0 +1,21 @@
+#if os(Windows)
+    import Loader
+    import Loader_Test_Support
+    import Testing
+
+    enum `Loader.Symbol Tests` {}
+
+    extension `Loader.Symbol Tests` {
+        @Suite struct Tests {
+            @Suite struct Unit {
+                @Test func `lookup on Windows throws instead of trapping`() {
+                    #expect(throws: Loader.Error.self) {
+                        _ = try "main".withCString { name throws(Loader.Error) in
+                            try unsafe Loader.Symbol.lookup(name: name, in: .default)
+                        }
+                    }
+                }
+            }
+        }
+    }
+#endif
