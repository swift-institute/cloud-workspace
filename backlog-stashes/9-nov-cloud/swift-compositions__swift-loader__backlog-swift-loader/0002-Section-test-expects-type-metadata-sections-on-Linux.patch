From 2f1d78d2d0e9c47c7e5b6d43508cfe44646b83df Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Mon, 9 Nov 2026 13:58:48 +0000
Subject: [PATCH 2/2] Section test expects type metadata sections on Linux too,
 which swift-linux-standard#15 now enumerates (coenttb/work#242)

---
 Tests/Loader Tests/Loader.Section Tests.swift | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Tests/Loader Tests/Loader.Section Tests.swift b/Tests/Loader Tests/Loader.Section Tests.swift
index 2dc8f5f..ed82061 100644
--- a/Tests/Loader Tests/Loader.Section Tests.swift	
+++ b/Tests/Loader Tests/Loader.Section Tests.swift	
@@ -10,7 +10,7 @@ extension `Loader.Section Tests` {
             @Test func `type metadata sections are discoverable in the loaded image`() {
                 let bounds = Array(Loader.Section.all(.swiftTypeMetadata))
 
-                #if canImport(Darwin)
+                #if canImport(Darwin) || os(Linux)
                     #expect(
                         bounds.isEmpty == false,
                         "A Swift test binary always carries a type metadata section"
