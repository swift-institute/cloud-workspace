From 1d201434412caaa04dae9da6a016a034e557f736 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Mon, 9 Nov 2026 11:30:54 +0000
Subject: [PATCH 2/2] CSSString escapes every Unicode scalar, so a CR LF
 grapheme no longer loses its line feed (swift-w3c/swift-w3c-cssom#10)

---
 .../W3C CSSOM/Serialization/StringSerialization.swift    | 9 +++------
 Tests/W3C CSSOM Tests/Serialization/String Tests.swift   | 5 +++++
 2 files changed, 8 insertions(+), 6 deletions(-)

diff --git a/Sources/W3C CSSOM/Serialization/StringSerialization.swift b/Sources/W3C CSSOM/Serialization/StringSerialization.swift
index 7cc15d9..bab0e2a 100644
--- a/Sources/W3C CSSOM/Serialization/StringSerialization.swift	
+++ b/Sources/W3C CSSOM/Serialization/StringSerialization.swift	
@@ -1,14 +1,11 @@
 func serializeString(_ string: String) -> String {
     var result = "\""
 
-    for char in string {
-        guard let scalar = char.unicodeScalars.first else {
-            preconditionFailure("A Character always contains at least one Unicode scalar")
-        }
+    for scalar in string.unicodeScalars {
         let value = scalar.value
 
         if value == 0x0000 {
-            result.append("\u{FFFD}")
+            result.unicodeScalars.append("\u{FFFD}")
             continue
         }
 
@@ -27,7 +24,7 @@ func serializeString(_ string: String) -> String {
             continue
         }
 
-        result.append(char)
+        result.unicodeScalars.append(scalar)
     }
 
     result.append("\"")
diff --git a/Tests/W3C CSSOM Tests/Serialization/String Tests.swift b/Tests/W3C CSSOM Tests/Serialization/String Tests.swift
index 944bc23..187a907 100644
--- a/Tests/W3C CSSOM Tests/Serialization/String Tests.swift	
+++ b/Tests/W3C CSSOM Tests/Serialization/String Tests.swift	
@@ -49,6 +49,11 @@ struct `CSSString Tests` {
             #expect(str.description == "\"Line 1\\a Line 2\"")
         }
 
+        @Test func `carriage return and line feed in one grapheme are both escaped`() {
+            let string = CSSString("a\r\nb")
+            #expect(string.description == "\"a\\d \\a b\"")
+        }
+
         @Test func `multiple newlines are escaped`() {
             let str = CSSString("A\nB\nC")
             #expect(str.description == "\"A\\a B\\a C\"")
-- 
2.43.0

