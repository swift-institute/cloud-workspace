From ab1e59befec72caebca0fdee8fcff7fc62fc6d13 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Mon, 9 Nov 2026 11:38:55 +0000
Subject: [PATCH 1/3] Text width measures the WinAnsi bytes showText draws,
 unicodeFallbackMap substitutes included, instead of giving a character
 outside WinAnsi the default width (swift-iso/swift-iso-32000#14)

---
 .../9.8 Font descriptors.swift                | 21 ++++++-------------
 .../ISO_32000.Font Width Tests.swift          | 14 +++++++++++++
 2 files changed, 20 insertions(+), 15 deletions(-)

diff --git a/Sources/ISO 32000 9 Text/9.8 Font descriptors.swift b/Sources/ISO 32000 9 Text/9.8 Font descriptors.swift
index b845862..3a5ba6d 100644
--- a/Sources/ISO 32000 9 Text/9.8 Font descriptors.swift	
+++ b/Sources/ISO 32000 9 Text/9.8 Font descriptors.swift	
@@ -138,25 +138,16 @@ extension ISO_32000.`9`.`8`.Metrics {
         width(of: bytes).scaled(by: fontSize, unitsPerEm: unitsPerEm)
     }
 
+    /// The width of the bytes `showText(_:)` draws for `scalar`: its WinAnsi byte, or the
+    /// ``ISO_32000/unicodeFallbackMap`` substitute when WinAnsi has none.
     public func glyphWidth(for scalar: UnicodeScalar) -> ISO_32000.FontDesign.Width {
-
-        if let byte = ISO_32000.WinAnsiEncoding.encode(scalar) {
-            return width(of: byte)
-        }
-        return defaultWidth
+        width(of: String(scalar))
     }
 
+    /// The width of the bytes `showText(_:)` draws for `text`: WinAnsi, with the
+    /// ``ISO_32000/unicodeFallbackMap`` substitute for a character WinAnsi has no byte for.
     public func width(of text: String) -> ISO_32000.FontDesign.Width {
-        var total = 0
-        for scalar in text.unicodeScalars {
-
-            if let byte = ISO_32000.WinAnsiEncoding.encode(scalar) {
-                total += winAnsiByteWidths[Int(byte.underlying)].underlying
-            } else {
-                total += defaultWidth.underlying
-            }
-        }
-        return ISO_32000.FontDesign.Width(total)
+        width(of: [Byte](winAnsi: text, withFallback: true))
     }
 
     public func width(
diff --git a/Tests/ISO 32000 Tests/ISO_32000.Font Width Tests.swift b/Tests/ISO 32000 Tests/ISO_32000.Font Width Tests.swift
index 9b74811..2a07811 100644
--- a/Tests/ISO 32000 Tests/ISO_32000.Font Width Tests.swift	
+++ b/Tests/ISO 32000 Tests/ISO_32000.Font Width Tests.swift	
@@ -43,6 +43,20 @@ extension `ISO_32000.Font Tests` {
             #expect(ISO_32000.Font.helvetica.winAnsi.width(of: bytes, atSize: 1000).underlying == 1556)
         }
 
+        @Test
+        func `an arrow and a check mark measure the fallback bytes showText draws`() {
+            #expect(ISO_32000.Font.helvetica.width(of: "\u{2192}", atSize: 1000).underlying == 917)
+            #expect(ISO_32000.Font.helvetica.width(of: "\u{2713}", atSize: 1000).underlying == 389)
+            #expect(ISO_32000.Font.helvetica.metrics.bullet.width.underlying == 350)
+
+            let drawn = [Byte](winAnsi: "a\u{2192}\u{2713}", withFallback: true)
+            #expect(drawn == [0x61, 0x2D, 0x3E, 0x2A].map(Byte.init(bitPattern:)))
+            #expect(
+                ISO_32000.Font.helvetica.winAnsi.width(of: drawn, atSize: 1000).underlying
+                    == ISO_32000.Font.helvetica.width(of: "a\u{2192}\u{2713}", atSize: 1000).underlying
+            )
+        }
+
         @Test
         func `width at 12 pt is the AFM sum scaled and quantized to 0.01 user-space units`() {
             #expect(ISO_32000.Font.helvetica.width(of: "Hello World", atSize: 12).underlying == 62.0)
