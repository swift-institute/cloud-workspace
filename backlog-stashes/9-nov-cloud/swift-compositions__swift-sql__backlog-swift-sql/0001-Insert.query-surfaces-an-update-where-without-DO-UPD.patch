From 1f4afc6f4407f4c6fc7c042f87ad91b6753ad228 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Mon, 9 Nov 2026 11:29:53 +0000
Subject: [PATCH] Insert.query surfaces an update where without DO UPDATE
 assignments as an invalid value that fails rendering instead of trapping
 (swift-compositions/swift-sql#17)

---
 Sources/SQL/Statements/Insert.swift | 10 +++++----
 Tests/SQL Tests/Insert Tests.swift  | 32 +++++++++++++++++++++++++++++
 2 files changed, 38 insertions(+), 4 deletions(-)
 create mode 100644 Tests/SQL Tests/Insert Tests.swift

diff --git a/Sources/SQL/Statements/Insert.swift b/Sources/SQL/Statements/Insert.swift
index 3dcef34..e32c6f8 100644
--- a/Sources/SQL/Statements/Insert.swift
+++ b/Sources/SQL/Statements/Insert.swift
@@ -568,10 +568,12 @@ extension Insert: Statement {
         if !returning.isEmpty {
             query.append("\(.newlineOrSpace)RETURNING \(returning.joined(separator: ", "))")
         }
-        precondition(
-            !hasInvalidWhere,
-            "Insert statement has invalid update 'where': \(updateFilter.joined(separator: " AND ").debugDescription)"
-        )
+        if hasInvalidWhere {
+            let failure = ISO_9075.Value.Failure(
+                "Insert statement has an update 'where' without 'DO UPDATE' assignments: \(updateFilter.joined(separator: " AND ").debugDescription)"
+            )
+            query.append(ISO_9075.Fragment(segments: [.value(.invalid(failure))]))
+        }
         return query
     }
 }
diff --git a/Tests/SQL Tests/Insert Tests.swift b/Tests/SQL Tests/Insert Tests.swift
new file mode 100644
index 0000000..36d165b
--- /dev/null
+++ b/Tests/SQL Tests/Insert Tests.swift	
@@ -0,0 +1,32 @@
+import ISO_9075_Foundation
+import SQL
+import SQL_Macros
+import Testing
+
+enum `Insert Tests` {}
+
+extension `Insert Tests` {
+    @Suite struct `An update where without assignments` {
+        @Test func `fails when rendered instead of trapping`() {
+            let insert = Reminder.insert(
+                values: { Reminder.Draft(title: "Groceries") },
+                onConflict: { $0.id },
+                where: { $0.isCompleted.eq(false) },
+                where: { row, _ in row.isCompleted.eq(true) }
+            )
+            #expect(throws: ISO_9075.Value.Failure.self) { try Numbered().render(insert.query) }
+        }
+
+        @Test func `with assignments renders the update where`() throws {
+            let insert = Reminder.insert(
+                values: { Reminder.Draft(title: "Groceries") },
+                onConflict: { $0.id },
+                doUpdate: { row, excluded in row.title = excluded.title },
+                where: { row, _ in row.isCompleted.eq(true) }
+            )
+            let rendering = try Numbered().render(insert.query)
+            #expect(rendering.sql.contains("DO UPDATE SET"))
+            #expect(rendering.sql.contains("\nWHERE "))
+        }
+    }
+}
