From: coenttb <coen@coenttb.com>
Date: Mon, 9 Nov 2026 12:02:27 +0000
Subject: [PATCH] =?UTF-8?q?Lint=20findings=20over=20the=20ratchet=20limit?=
 =?UTF-8?q?=20cleared=20without=20behaviour=20change:=20raw=20value=20acce?=
 =?UTF-8?q?ss=206=E2=86=923=20(coenttb/work#242)?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

---
 Sources/X86 Standard/CPU.X86.Identification.Register.swift | 7 +++++++
 Sources/X86 Standard/CPU.X86.Random.swift                  | 4 ++--
 Sources/X86 Standard/CPU.X86.Timestamp.Read.swift          | 2 +-
 3 files changed, 10 insertions(+), 3 deletions(-)

diff --git a/Sources/X86 Standard/CPU.X86.Identification.Register.swift b/Sources/X86 Standard/CPU.X86.Identification.Register.swift
index 2254b7a..8999eb0 100644
--- a/Sources/X86 Standard/CPU.X86.Identification.Register.swift	
+++ b/Sources/X86 Standard/CPU.X86.Identification.Register.swift	
@@ -32,3 +32,10 @@ extension CPU.X86.Identification.Register {
 }
 
 extension CPU.X86.Identification.Register: Binary.Serializable {}
+
+extension CPU.X86.Identification.Register {
+    @inlinable
+    internal func bit(_ index: UInt32) -> Bool {
+        rawValue & (1 << index) != 0
+    }
+}
diff --git a/Sources/X86 Standard/CPU.X86.Random.swift b/Sources/X86 Standard/CPU.X86.Random.swift
index dd419c8..81e7627 100644
--- a/Sources/X86 Standard/CPU.X86.Random.swift	
+++ b/Sources/X86 Standard/CPU.X86.Random.swift	
@@ -30,8 +30,8 @@ extension CPU.X86.Random {
 
     @usableFromInline
     static let available: (next: Bool, seed: Bool) = (
-        next: CPU.X86.Identification.query(leaf: 1).map { $0.ecx.rawValue & (1 << 30) != 0 } ?? false,
-        seed: CPU.X86.Identification.query(leaf: 7, subleaf: 0).map { $0.ebx.rawValue & (1 << 18) != 0 }
+        next: CPU.X86.Identification.query(leaf: 1).map { $0.ecx.bit(30) } ?? false,
+        seed: CPU.X86.Identification.query(leaf: 7, subleaf: 0).map { $0.ebx.bit(18) }
             ?? false
     )
 }
diff --git a/Sources/X86 Standard/CPU.X86.Timestamp.Read.swift b/Sources/X86 Standard/CPU.X86.Timestamp.Read.swift
index ade7cc2..2cab097 100644
--- a/Sources/X86 Standard/CPU.X86.Timestamp.Read.swift	
+++ b/Sources/X86 Standard/CPU.X86.Timestamp.Read.swift	
@@ -23,5 +23,5 @@ extension CPU.X86.Timestamp.Read {
 
     @usableFromInline
     static let available: Bool =
-        CPU.X86.Identification.query(leaf: 0x8000_0001).map { $0.edx.rawValue & (1 << 27) != 0 } ?? false
+        CPU.X86.Identification.query(leaf: 0x8000_0001).map { $0.edx.bit(27) } ?? false
 }
