From 65f2c21d67e9c30fd03ffcb2294b7bf446640f0b Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Mon, 9 Nov 2026 11:32:47 +0000
Subject: [PATCH] Lint.Driver.configuration refuses a Lint.swift without the
 tools-version header that enables rules, instead of silently dropping them
 (swift-compositions/swift-linter#64)

---
 Sources/Linter Core/Lint.Driver.swift         | 21 ++++++++++++++++--
 .../Linter Core Tests/Lint.Driver Tests.swift | 22 +++++++++++++++++++
 2 files changed, 41 insertions(+), 2 deletions(-)

diff --git a/Sources/Linter Core/Lint.Driver.swift b/Sources/Linter Core/Lint.Driver.swift
index df540c5..0c72f4d 100644
--- a/Sources/Linter Core/Lint.Driver.swift	
+++ b/Sources/Linter Core/Lint.Driver.swift	
@@ -46,15 +46,18 @@ extension Lint.Driver {
                 description: "SWIFT_LINTER_PATH is not set to a valid swift-linter checkout; \(manifestFilename) in \(manifestDirectory) cannot be resolved"
             )
         }
+        var consumerEnabled: Set<Lint.Rule.ID> = []
+        let resolved: Lint.Configuration
         do throws(Manifest_Resolver::Manifest.Resolver<Lint.Manifest, Lint.Configuration>.Error) {
-            return try Manifest_Resolver::Manifest.Resolver<Lint.Manifest, Lint.Configuration>
+            resolved = try Manifest_Resolver::Manifest.Resolver<Lint.Manifest, Lint.Configuration>
                 .resolve(
                     consumerPackageRoot: manifestDirectory,
                     filename: manifestFilename,
                     dependencies: dependencies,
                     defaultConfiguration: defaultConfiguration,
                     buildConfiguration: { manifest, parent in
-                        configuration(from: manifest, parent: parent)
+                        consumerEnabled = manifest.rules.enabled
+                        return configuration(from: manifest, parent: parent)
                     }
                 )
         } catch {
@@ -67,6 +70,8 @@ extension Lint.Driver {
                 Lint.Driver.Error.resolutionFailed(description: "\(error)")
             }
         }
+        try check(enabled: consumerEnabled, in: "\(manifestDirectory)/\(manifestFilename)")
+        return resolved
     }
 }
 
@@ -76,6 +81,18 @@ extension Lint.Driver {
         Lint.Configuration {}
     }
 
+    internal static func check(
+        enabled: Set<Lint.Rule.ID>,
+        in manifest: Swift.String
+    ) throws(Lint.Driver.Error) {
+        guard !enabled.isEmpty else { return }
+        let identifiers = enabled.map(\.underlying).sorted().joined(separator: ", ")
+        throw .resolutionFailed(
+            description: "\(manifest) enables rules (\(identifiers)), which only a Lint.swift with a "
+                + "'\(Lint.File.Single.Detection.header)' header can activate; add the header or remove the enabled rules"
+        )
+    }
+
     internal static func configuration(
         from manifest: Lint.Manifest,
         parent: Lint.Configuration?
diff --git a/Tests/Linter Core Tests/Lint.Driver Tests.swift b/Tests/Linter Core Tests/Lint.Driver Tests.swift
index ff81aff..afd137a 100644
--- a/Tests/Linter Core Tests/Lint.Driver Tests.swift	
+++ b/Tests/Linter Core Tests/Lint.Driver Tests.swift	
@@ -81,3 +81,25 @@ extension `Lint.Driver Tests`.Test.`Configuration From Manifest` {
         #expect(configuration.rules.effective.entries.isEmpty)
     }
 }
+
+extension `Lint.Driver Tests`.Test {
+    @Suite struct `Enabled Rules Without Header` {}
+}
+
+extension `Lint.Driver Tests`.Test.`Enabled Rules Without Header` {
+    @Test
+    func `A manifest without enabled rules passes the check`() throws(Lint.Driver.Error) {
+        try Lint.Driver.check(enabled: [], in: "Lint.swift")
+    }
+
+    @Test
+    func `Enabled rules in a manifest without the tools-version header are refused`() {
+        #expect {
+            try Lint.Driver.check(enabled: ["unchecked_call_site"], in: "Lint.swift")
+        } throws: { error in
+            guard case Lint.Driver.Error.resolutionFailed(let description) = error else { return false }
+            return description.contains("unchecked_call_site")
+                && description.contains(Lint.File.Single.Detection.header)
+        }
+    }
+}
-- 
