 .../RFC 9557/RFC_9557.Suffix.Calendar.swift   | 13 ++++---
 Sources/RFC 9557/RFC_9557.Suffix.Tag.swift    |  4 ++-
 Sources/RFC 9557/RFC_9557.Suffix.swift        | 34 +++++++++++--------
 Sources/RFC 9557/RFC_9557.Timestamp.swift     |  4 +--
 4 files changed, 32 insertions(+), 23 deletions(-)

diff --git a/Sources/RFC 9557/RFC_9557.Suffix.Calendar.swift b/Sources/RFC 9557/RFC_9557.Suffix.Calendar.swift
index bf5ae48..3998cc1 100644
--- a/Sources/RFC 9557/RFC_9557.Suffix.Calendar.swift	
+++ b/Sources/RFC 9557/RFC_9557.Suffix.Calendar.swift	
@@ -17,13 +17,16 @@ extension RFC_9557.Suffix {
             } catch {
                 throw Error.invalidValue(identifier)
             }
-            self.init(__unchecked: (), identifier: identifier, isCritical: false)
+            self.identifier = identifier
+            self.isCritical = false
         }
+    }
+}
 
-        public static func critical(_ identifier: String) throws(Error) -> Self {
-            let elective = try Self(identifier)
-            return Self(__unchecked: (), identifier: elective.identifier, isCritical: true)
-        }
+extension RFC_9557.Suffix.Calendar {
+    public static func critical(_ identifier: String) throws(Error) -> Self {
+        let elective = try Self(identifier)
+        return Self(__unchecked: (), identifier: elective.identifier, isCritical: true)
     }
 }
 
diff --git a/Sources/RFC 9557/RFC_9557.Suffix.Tag.swift b/Sources/RFC 9557/RFC_9557.Suffix.Tag.swift
index 8971f12..2f85473 100644
--- a/Sources/RFC 9557/RFC_9557.Suffix.Tag.swift	
+++ b/Sources/RFC 9557/RFC_9557.Suffix.Tag.swift	
@@ -51,7 +51,9 @@ extension RFC_9557.Suffix {
                 }
             }
 
-            self.init(__unchecked: (), key: key, values: values, critical: critical)
+            self.key = key
+            self.values = values
+            self.critical = critical
         }
     }
 }
diff --git a/Sources/RFC 9557/RFC_9557.Suffix.swift b/Sources/RFC 9557/RFC_9557.Suffix.swift
index c665541..d2bad67 100644
--- a/Sources/RFC 9557/RFC_9557.Suffix.swift	
+++ b/Sources/RFC 9557/RFC_9557.Suffix.swift	
@@ -31,23 +31,27 @@ extension RFC_9557 {
                     throw Error.duplicateKey(tag.key)
                 }
             }
-            self.init(__unchecked: (), timeZone: timeZone, calendar: calendar, tags: tags)
+            self.timeZone = timeZone
+            self.calendar = calendar
+            self.tags = tags
         }
+    }
+}
 
-        private static func validate(_ timeZone: TimeZone) throws(Error) {
-            switch timeZone {
-            case .offset(let offset, _):
-                do throws(RFC_9557.Validation.ValidationError) {
-                    try RFC_9557.Validation.validateTimeZoneOffset(offset)
-                } catch {
-                    throw Error.invalidTimeZoneOffset(offset)
-                }
-            case .iana(let name, _):
-                do throws(RFC_9557.Validation.ValidationError) {
-                    try RFC_9557.Validation.validateTimeZoneName(name)
-                } catch {
-                    throw Error.invalidTimeZoneName(name)
-                }
+extension RFC_9557.Suffix {
+    private static func validate(_ timeZone: TimeZone) throws(Error) {
+        switch timeZone {
+        case .offset(let offset, _):
+            do throws(RFC_9557.Validation.ValidationError) {
+                try RFC_9557.Validation.validateTimeZoneOffset(offset)
+            } catch {
+                throw Error.invalidTimeZoneOffset(offset)
+            }
+        case .iana(let name, _):
+            do throws(RFC_9557.Validation.ValidationError) {
+                try RFC_9557.Validation.validateTimeZoneName(name)
+            } catch {
+                throw Error.invalidTimeZoneName(name)
             }
         }
     }
diff --git a/Sources/RFC 9557/RFC_9557.Timestamp.swift b/Sources/RFC 9557/RFC_9557.Timestamp.swift
index d41c20a..780a579 100644
--- a/Sources/RFC 9557/RFC_9557.Timestamp.swift	
+++ b/Sources/RFC 9557/RFC_9557.Timestamp.swift	
@@ -15,8 +15,8 @@ extension RFC_9557 {
         }
 
         public init(base: RFC_3339.DateTime, suffix: Suffix? = nil) {
-
-            self.init(__unchecked: (), base: base, suffix: suffix)
+            self.base = base
+            self.suffix = suffix
         }
     }
 }
