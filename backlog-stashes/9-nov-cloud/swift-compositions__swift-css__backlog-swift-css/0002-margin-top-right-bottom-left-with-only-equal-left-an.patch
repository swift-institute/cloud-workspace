From 1f12e0f2411bc68d3ac463753be37149a84a19b3 Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Mon, 9 Nov 2026 11:31:24 +0000
Subject: [PATCH 2/3] margin(top:right:bottom:left:) with only equal left and
 right writes margin-left and margin-right instead of a shorthand that reset
 top and bottom to zero (swift-compositions/swift-css#18)

---
 Sources/CSS/Layout/Margin.swift    |  6 ------
 Tests/CSS Tests/Margin Tests.swift | 22 ++++++++++++++++++++++
 2 files changed, 22 insertions(+), 6 deletions(-)
 create mode 100644 Tests/CSS Tests/Margin Tests.swift

diff --git a/Sources/CSS/Layout/Margin.swift b/Sources/CSS/Layout/Margin.swift
index 3a772d6..3769015 100644
--- a/Sources/CSS/Layout/Margin.swift
+++ b/Sources/CSS/Layout/Margin.swift
@@ -44,12 +44,6 @@ extension HTML.CSS {
             }
         }
 
-        else if top == nil && bottom == nil, let right, let left, right == left {
-            base.inlineStyle(
-                Margin.verticalHorizontal(.px(0), right)
-            )
-        }
-
         else {
             base
                 .inlineStyle(top.map { MarginTop.lengthPercentage($0) })
diff --git a/Tests/CSS Tests/Margin Tests.swift b/Tests/CSS Tests/Margin Tests.swift
new file mode 100644
index 0000000..4352455
--- /dev/null
+++ b/Tests/CSS Tests/Margin Tests.swift	
@@ -0,0 +1,22 @@
+import CSS
+import Testing
+
+enum `Margin Tests` {}
+
+extension `Margin Tests` {
+    @Suite
+    struct `Rendering` {
+
+        @Test
+        func `equal left and right margins leave top and bottom untouched`() throws {
+            let html = try String(
+                HTML.Document {
+                    tag("div").css.margin(right: .px(8), left: .px(8))
+                }
+            )
+            #expect(html.contains("margin-right:8px"))
+            #expect(html.contains("margin-left:8px"))
+            #expect(!html.contains("margin:0px"))
+        }
+    }
+}
