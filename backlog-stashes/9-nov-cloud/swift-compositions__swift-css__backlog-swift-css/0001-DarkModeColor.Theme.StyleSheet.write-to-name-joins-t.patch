From 09dd58643eb02d95f2395866936ae460def71eef Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Mon, 9 Nov 2026 11:31:16 +0000
Subject: [PATCH 1/3] DarkModeColor.Theme.StyleSheet.write(to:name:) joins the
 directory and file name with a path separator, so the file lands inside the
 directory (swift-compositions/swift-css#18)

---
 Package.swift                                 |  1 +
 .../DarkModeColor.Theme.StyleSheet.swift      |  4 +++-
 ...DarkModeColor.Theme.StyleSheet Tests.swift | 21 +++++++++++++++++++
 3 files changed, 25 insertions(+), 1 deletion(-)

diff --git a/Package.swift b/Package.swift
index ebe1d94..aeda7f8 100644
--- a/Package.swift
+++ b/Package.swift
@@ -100,6 +100,7 @@ let package = Package(
             dependencies: [
                 .target(name: "CSS"),
                 .target(name: "CSS Theming"),
+                .target(name: "CSS Theming Foundation Integration"),
             ],
             path: "Tests/CSS Tests"
         ),
diff --git a/Sources/CSS Theming Foundation Integration/DarkModeColor.Theme.StyleSheet.swift b/Sources/CSS Theming Foundation Integration/DarkModeColor.Theme.StyleSheet.swift
index 57f6e44..7371b05 100644
--- a/Sources/CSS Theming Foundation Integration/DarkModeColor.Theme.StyleSheet.swift	
+++ b/Sources/CSS Theming Foundation Integration/DarkModeColor.Theme.StyleSheet.swift	
@@ -17,7 +17,9 @@ extension DarkModeColor.Theme.StyleSheet {
             throw .directoryCreationFailed(path: directory, reason: String(describing: error))
         }
 
-        let path = directory + "\(name).css"
+        let path = URL(fileURLWithPath: directory, isDirectory: true)
+            .appendingPathComponent("\(name).css")
+            .path
 
         do {
             try self.description.write(
diff --git a/Tests/CSS Tests/DarkModeColor.Theme.StyleSheet Tests.swift b/Tests/CSS Tests/DarkModeColor.Theme.StyleSheet Tests.swift
index b0c8e91..38c2a0a 100644
--- a/Tests/CSS Tests/DarkModeColor.Theme.StyleSheet Tests.swift	
+++ b/Tests/CSS Tests/DarkModeColor.Theme.StyleSheet Tests.swift	
@@ -1,5 +1,7 @@
 import CSS
 import CSS_Theming
+import CSS_Theming_Foundation_Integration
+import Foundation
 import Testing
 
 enum `DarkModeColor.Theme.StyleSheet Tests` {}
@@ -47,3 +49,22 @@ extension `DarkModeColor.Theme.StyleSheet Tests` {
         }
     }
 }
+
+extension `DarkModeColor.Theme.StyleSheet Tests` {
+    @Suite
+    struct `Writing To A Directory` {
+
+        @Test
+        func `a directory without a trailing slash gets the file inside it`() throws {
+            let directory = FileManager.default.temporaryDirectory
+                .appendingPathComponent("swift-css-\(UUID().uuidString)")
+                .path
+            defer { try? FileManager.default.removeItem(atPath: directory) }
+
+            try DarkModeColor.Theme.default.stylesheet.write(to: directory, name: "theme")
+
+            #expect(FileManager.default.fileExists(atPath: directory + "/theme.css"))
+            #expect(!FileManager.default.fileExists(atPath: directory + "theme.css"))
+        }
+    }
+}
