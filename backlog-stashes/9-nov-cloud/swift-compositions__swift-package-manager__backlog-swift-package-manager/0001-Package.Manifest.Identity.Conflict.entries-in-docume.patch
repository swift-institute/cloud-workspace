From 5c3e3fd64e28a8cd567f915a074b175cf0bd0eec Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Mon, 9 Nov 2026 11:28:45 +0000
Subject: [PATCH 1/4] Package.Manifest.Identity.Conflict.entries(in:document:)
 ignores commented-out .package clauses
 (swift-compositions/swift-package-manager#15)

---
 .../Package.Manifest.Identity.Conflict.swift   |  3 ++-
 ...kage.Manifest.Identity.Conflict Tests.swift | 18 ++++++++++++++++++
 2 files changed, 20 insertions(+), 1 deletion(-)

diff --git a/Sources/Package Manager/Package.Manifest.Identity.Conflict.swift b/Sources/Package Manager/Package.Manifest.Identity.Conflict.swift
index befc040..cca794e 100644
--- a/Sources/Package Manager/Package.Manifest.Identity.Conflict.swift	
+++ b/Sources/Package Manager/Package.Manifest.Identity.Conflict.swift	
@@ -20,7 +20,8 @@ extension Package.Manifest.Identity.Conflict {
         in manifest: Swift.String,
         document: Swift.String
     ) -> [Entry] {
-        Package.Manifest.Clause.all(in: manifest).compactMap { clause in
+        let code = Package.Manifest.Source.code(in: manifest)
+        return Package.Manifest.Clause.all(in: code).compactMap { clause in
             clause.declaredURL.map {
                 Entry(url: $0, document: document, source: .manifest)
             }
diff --git a/Tests/Package Manager Tests/Package.Manifest.Identity.Conflict Tests.swift b/Tests/Package Manager Tests/Package.Manifest.Identity.Conflict Tests.swift
index 4d7893e..0603403 100644
--- a/Tests/Package Manager Tests/Package.Manifest.Identity.Conflict Tests.swift	
+++ b/Tests/Package Manager Tests/Package.Manifest.Identity.Conflict Tests.swift	
@@ -99,4 +99,22 @@ extension `Package.Manifest.Identity.Conflict Tests`.Test.`Edge Case` {
         #expect(entries.count == 1)
         #expect(entries.first?.identity == "swift-alpha")
     }
+
+    @Test
+    func `commented-out package clauses are not manifest entries`() {
+        let source = """
+            dependencies: [
+                // .package(url: "https://github.com/swift-ietf/swift-alpha.git", branch: "main"),
+                /* .package(url: "https://github.com/elsewhere/swift-alpha.git", branch: "main"), */
+                .package(url: "https://github.com/swift-molecules/swift-alpha.git", branch: "main")
+            ]
+            """
+
+        let entries = Package.Manifest.Identity.Conflict.entries(
+            in: source,
+            document: "Package.swift"
+        )
+        #expect(entries.count == 1)
+        #expect(Package.Manifest.Identity.Conflict.findings(in: entries).isEmpty)
+    }
 }
