From 2fb2dc248bc04e238c18787a5394187848406d6e Mon Sep 17 00:00:00 2001
From: coenttb <coen@coenttb.com>
Date: Mon, 9 Nov 2026 11:32:11 +0000
Subject: [PATCH 4/4] Filename (Path.Component) no longer conforms to
 ExpressibleByStringInterpolation, so interpolated text goes through the
 throwing init(_:) instead of the trapping literal initializer
 (swift-iso/swift-iso-9945#93)

---
 README.md                                            |  2 +-
 Sources/ISO 9945 Kernel File/ISO_9945.Filename.swift |  3 ---
 Tests/ISO 9945 Kernel Tests/Path+POSIX Tests.swift   | 11 +++++++----
 3 files changed, 8 insertions(+), 8 deletions(-)

diff --git a/README.md b/README.md
index c5e2dde..ebf5d06 100644
--- a/README.md
+++ b/README.md
@@ -27,7 +27,7 @@ Use this package when you need to make POSIX system calls from Swift on macOS or
 - Only `ISO_9945.Kernel.Socket.Connect.connect(_:address:)` reports `interrupted`, and the connection attempt then goes on in the background. Every other `ISO_9945.Kernel.Socket.Error` is a platform error, an interrupted send or receive included.
 - `ISO_9945.Kernel.Termios.Attributes.withRaw()` turns off echo, canonical input, signal keys and output processing, sets 8-bit characters, and makes a read wait for at least one byte with no timeout.
 - Paths follow the POSIX grammar. Path text may not be empty or contain NUL or control characters. Components skip empty segments, so `a//b` has two. Appending joins with exactly one separator, and appending an absolute path gives that path. The parent of `/a` is `/`, and the root and a single relative component have none. A path relative to itself is `.`, and relative to a base that is not its prefix it is nil. A prefix must match whole components and be absolute or relative like the path.
-- `ISO_9945.Filename` is non-empty and has no `/`, NUL or control character (below 0x20, or 0x7F).
+- `ISO_9945.Filename` is non-empty and has no `/` or NUL. Built from text, it also has no control character (below 0x20, or 0x7F); built from code units with `init(platformNative:)`, as a directory entry hands it back, it keeps them. Only a literal makes a filename without throwing; interpolated text goes through the throwing `init(_:)`.
 - `ISO_9945.Utility.Name` is 2 to 9 characters, each a lowercase ASCII letter or a digit. An option name is one ASCII letter or digit.
 - `ISO_9945.Utility.Invocation.arguments` puts `--` before the operands only when the first operand starts with `-` and is longer than one character. A lone `-` is an operand.
 - `ISO_9945.Utility.Invocation.Coder` expands a grouped run such as `-ab` into one option per character. An option that takes an argument ends the run and takes the rest of the word, or the next word if nothing is left. Options end at `--`, which is dropped, or at the first word that is not an option. Writing an invocation back puts every option argument in its own word.
diff --git a/Sources/ISO 9945 Kernel File/ISO_9945.Filename.swift b/Sources/ISO 9945 Kernel File/ISO_9945.Filename.swift
index fc8f3d7..adff71a 100644
--- a/Sources/ISO 9945 Kernel File/ISO_9945.Filename.swift	
+++ b/Sources/ISO 9945 Kernel File/ISO_9945.Filename.swift	
@@ -143,9 +143,6 @@ extension ISO_9945.Filename: ExpressibleByStringLiteral {
     }
 }
 
-/// Interpolated text is a filename by the same rule as a plain literal.
-extension ISO_9945.Filename: ExpressibleByStringInterpolation {}
-
 extension ISO_9945.Filename: Binary.Serializable {
 
     /// The name's text, as UTF-8.
diff --git a/Tests/ISO 9945 Kernel Tests/Path+POSIX Tests.swift b/Tests/ISO 9945 Kernel Tests/Path+POSIX Tests.swift
index 71f3019..8bb7bdc 100644
--- a/Tests/ISO 9945 Kernel Tests/Path+POSIX Tests.swift	
+++ b/Tests/ISO 9945 Kernel Tests/Path+POSIX Tests.swift	
@@ -20,12 +20,15 @@ extension `Path+POSIX Tests` {
         }
 
         @Test
-        func `an interpolated literal spells a path and a component`() {
+        func `an interpolated literal spells a path, and runtime text a component by throwing`() throws {
             let name = "local"
             let path: Path = "/usr/\(name)/bin"
-            let component: Path.Component = "\(name).txt"
+            let component = try Path.Component("\(name).txt")
             #expect(path == "/usr/local/bin")
             #expect(component == "local.txt")
+            #expect(throws: ISO_9945.Filename.Error.containsPathSeparator) {
+                try Path.Component("\(name)/bin")
+            }
         }
 
         @Test
@@ -113,8 +116,6 @@ extension `Path+POSIX Tests` {
             #expect(name.count == 8)
             #expect(Path.Component.self == ISO_9945.Filename.self)
         }
-    }
-}
 
         @Test
         func `a platform-native filename keeps control characters`() throws {
@@ -131,3 +132,5 @@ extension `Path+POSIX Tests` {
                 #expect(throws: error) { _ = try ISO_9945.Filename(platformNative: codeUnits) }
             }
         }
+    }
+}
