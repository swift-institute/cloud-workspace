diff --git a/Tests/Linux Kernel Standard Tests/Linux.Kernel.File.Clone Tests.swift b/Tests/Linux Kernel Standard Tests/Linux.Kernel.File.Clone Tests.swift
new file mode 100644
index 0000000..37a6224
--- /dev/null
+++ b/Tests/Linux Kernel Standard Tests/Linux.Kernel.File.Clone Tests.swift	
@@ -0,0 +1,110 @@
+#if os(Linux)
+    #if canImport(Glibc)
+        import Glibc
+    #elseif canImport(Musl)
+        import Musl
+    #endif
+    import Error
+    import Testing
+    import ISO_9945_Core
+
+    @testable import Linux_Kernel_File_Standard
+
+    private func temporaryFile(_ contents: [UInt8]) -> Int32 {
+        var template = Array("/dev/shm/linux-standard-clone-XXXXXX".utf8CString)
+        let fd = template.withUnsafeMutableBufferPointer { buffer in
+            unsafe mkstemp(buffer.baseAddress!)
+        }
+        precondition(fd >= 0)
+        template.withUnsafeBufferPointer { buffer in
+            _ = unsafe unlink(buffer.baseAddress!)
+        }
+        let written = contents.withUnsafeBytes { bytes in
+            unsafe write(fd, bytes.baseAddress, bytes.count)
+        }
+        precondition(written == contents.count)
+        return fd
+    }
+
+    private func contents(of fd: Int32) -> [UInt8] {
+        var buffer = [UInt8](repeating: 0, count: 64)
+        let count = buffer.withUnsafeMutableBytes { bytes in
+            unsafe pread(fd, bytes.baseAddress, bytes.count, 0)
+        }
+        return Array(buffer.prefix(max(count, 0)))
+    }
+
+    extension Linux.Kernel.File.Clone {
+        @Suite
+        struct Test {
+            @Suite struct Unit {}
+            @Suite struct Integration {}
+        }
+    }
+
+    extension Linux.Kernel.File.Clone.Test.Unit {
+        @Test
+        func `only Btrfs and XFS report reflink`() {
+            #expect(Linux.Kernel.File.Clone.Capability(kind: .btrfs) == .reflink)
+            #expect(Linux.Kernel.File.Clone.Capability(kind: .xfs) == .reflink)
+            #expect(Linux.Kernel.File.Clone.Capability(kind: .ext4) == .none)
+            #expect(Linux.Kernel.File.Clone.Capability(kind: .tmpfs) == .none)
+            #expect(Linux.Kernel.File.Clone.Capability(kind: .nfs) == .none)
+        }
+    }
+
+    extension Linux.Kernel.File.Clone.Test.Integration {
+        @Test
+        func `FICLONE on tmpfs reports no clone instead of failing`() throws {
+            let source = temporaryFile([1, 2, 3])
+            let destination = temporaryFile([])
+            defer {
+                _ = close(source)
+                _ = close(destination)
+            }
+
+            let cloned = try Linux.Kernel.File.Clone.Ficlone.attempt(
+                sourceFd: source,
+                destinationFd: destination
+            )
+            #expect(cloned == false)
+        }
+
+        @Test
+        func `copy range stops quietly at the end of the source`() throws {
+            let source = temporaryFile([1, 2, 3, 4])
+            let destination = temporaryFile([])
+            defer {
+                _ = close(source)
+                _ = close(destination)
+            }
+
+            try Linux.Kernel.File.Clone.CopyRange.copy(
+                sourceFd: source,
+                destinationFd: destination,
+                length: 32
+            )
+            #expect(contents(of: destination) == [1, 2, 3, 4])
+        }
+
+        @Test
+        func `copy range reports the errno of the failing copy`() {
+            let destination = temporaryFile([])
+            defer { _ = close(destination) }
+
+            #expect {
+                try Linux.Kernel.File.Clone.CopyRange.copy(
+                    sourceFd: -1,
+                    destinationFd: destination,
+                    length: 4
+                )
+            } throws: { error in
+                guard
+                    case Linux.Kernel.File.Clone.Error.Syscall.platform(let code, let operation) = error
+                else { return false }
+                return code == .posix(EBADF) && operation == .copyFileRange
+            }
+        }
+    }
+
+#endif
